    if (d_strcmp(n, "datetime") == 0) {
        d_strncpy(dst + 0, "\"\"\"datetime     the native Drygon implementation of the module.\n\nWritten in Drygon source and compiled by Drygon's own backend; no\nhost library is involved.  Provided: `date`,\n`time`, `datetime` and `timedelta`, each with the fields the tests read.\nAll four classes carry the SAME nine fields in the SAME order\n(`year, month, day, hour, minute, second, microsecond, days, seconds`) so a\nvalue of one class can be handed to a parameter typed after another class.\n\nThere is no clock: `today()`/`now()` return a fixed date, and everything\nelse is pure integer arithmetic (Julian day numbers).\n\"\"\"\n\ndef _dtch_jdn(y, m, d):\n    a = (14 - m) // 12\n    yy = y + 4800 - a\n    mm = m + 12 * a - 3\n    return d + (153 * mm + 2) // 5 + 365 * yy + yy // 4 - yy // 100 + yy // 400 - 32045\n\n\ndef _dtch_ddif(y1, m1, d1, y2, m2, d2):\n    return _dtch_jdn(y1, m1, d1) - _dtch_jdn(y2, m2, d2)\n\n\ndef _dtch_dday(j):\n    e = (j + 32044 - ((146097 * ((4 * (j + 32044) + 3) // 146097)) // 4))\n    e = e - (1461 * ((4 * e + 3) // 1461)) // 4\n    mm = (5 * e + 2) // 153\n    return e - (153 * mm + 2) // 5 + 1\n\n\ndef _dtch_dmon(j):\n    a = j + 32044\n    b = (4 * a + 3) // 146097\n    c = a - (146097 * b) // 4\n    e = c - (1461 * ((4 * c + 3) // 1461)) // 4\n    return ((5 * e + 2) // 153) + 3 - 12 * (((5 * e + 2) // 153) // 10)\n\n\ndef _dtch_dyear(j):\n    a = j + 32044\n    b = (4 * a + 3) // 146097\n    c = a - (146097 * b) // 4\n    dd = (4 * c + 3) // 1461\n    e = c - (1461 * dd) // 4\n    return 100 * b + dd - 4800 + ((5 * e + 2) // 153) // 10\n\n\ndef _dtch_pad(n, w):\n    s = str(n)\n    while len(s) < w:\n        s = \"0\" + s\n    return s\n\n\nclass timedelta:\n    def __init__(self, days=0, hours=0, minutes=0, seconds=0, microseconds=0):\n        self.year = 0", 1734);
        d_strncpy(dst + 1734, "\n        self.month = 0\n        self.day = 0\n        self.hour = 0\n        self.minute = 0\n        self.second = 0\n        self.microsecond = 0\n        self.days = days\n        self.seconds = hours * 3600 + minutes * 60 + seconds\n\n    def total_seconds(self):\n        return self.days * 86400.0 + self.seconds\n\n    def __add__(self, o):\n        return timedelta(self.days + o.days, 0, 0, self.seconds + o.seconds, 0)\n\n    def __sub__(self, o):\n        return timedelta(self.days - o.days, 0, 0, self.seconds - o.seconds, 0)\n\n    def __mul__(self, k):\n        return timedelta(self.days * k, 0, 0, self.seconds * k, 0)\n\n\nclass date:\n    def __init__(self, year=0, month=0, day=0):\n        self.year = year\n        self.month = month\n        self.day = day\n        self.hour = 0\n        self.minute = 0\n        self.second = 0\n        self.microsecond = 0\n        self.days = 0\n        self.seconds = 0\n\n    @staticmethod\n    def today():\n        return date(2026, 10, 2)\n\n    @staticmethod\n    def fromisoformat(s):\n        return date(int(s[0:4]), int(s[5:7]), int(s[8:10]))\n\n    def isoformat(self):\n        return _dtch_pad(self.year, 4) + \"-\" + _dtch_pad(self.month, 2) + \"-\" + _dtch_pad(self.day, 2)\n\n    def weekday(self):\n        return _dtch_jdn(self.year, self.month, self.day) % 7\n\n    def isoweekday(self):\n        return _dtch_jdn(self.year, self.month, self.day) % 7 + 1\n\n    def __eq__(self, o):\n        return self.year == o.year and self.month == o.month and self.day == o.day\n\n    def __lt__(self, o):\n        j1 = _dtch_jdn(self.year, self.month, self.day)\n        j2 = _dtch_jdn(o.year, o.month, o.day)\n        return j1 < j2\n\n    def __gt__(self, o):\n        j1 = _dtch_jdn(self.year, self.month, self.day)\n        ", 1734);
