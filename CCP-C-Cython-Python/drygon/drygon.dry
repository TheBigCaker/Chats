    p[1511] = "char* drygon_dd_get(char* b, char* key) {\nif (!b) return \"\";\nlong long* h = (long long*)b;\nint n = (int)h[0];\nchar** k = (char**)h[1];\nchar** v = (char**)h[2];\nint i = 0;\n";
    p[1512] = "while (i < n) { if (k[i] && drygon_streq(k[i], key)) return v[i] ? v[i] : \"\"; i = i + 1; }\nreturn \"\";\n}\n";
    p[1513] = "char* drygon_dd_setk(char* b, int i, char* k) { long long* h = (long long*)b; ((char**)h[1])[i] = k; return b; }\n";
    p[1514] = "char* drygon_dd_setv(char* b, int i, char* v) { long long* h = (long long*)b; ((char**)h[2])[i] = v; return b; }\n";
    /* ---- `d.keys()` / `d.values()` on a plain python dict ---------------
     * A dict variable is a triple of parallel arrays (`d_k`, `d_v`, `d_n`), so
     * a view is materialised into these shared buffers: an expression position
     * has no array of its own and the raw `d.keys()` call resolved to nothing,
     * which trapped the program (24_collections, 46_weakref).  Callers that
     * need the view to outlive the next call copy out of it immediately. */
