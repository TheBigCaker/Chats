                cg_path_strrecv(n->children[0])) {
                /* `path.name` and friends, including `paths[0].name` where
                 * `paths` is a string list: the receiver is a plain `char*`
                 * holding a path, so resolve through the native path
                 * primitives (23_pathlib 21: `.name` used to emit the whole
                 * string). */
                if (d_strcmp(n->value,"name")==0) cg_put(g, "drygon_path_name(");
                else if (d_strcmp(n->value,"stem")==0) cg_put(g, "drygon_path_stem(");
                else if (d_strcmp(n->value,"suffix")==0) cg_put(g, "drygon_path_suffix(");
                else cg_put(g, "drygon_path_parent(");
                cg_gen_expr(g, n->children[0]);
                cg_put(g, ")");
                return;
            }
            if (d_strcmp(n->value, "__doc__") == 0) {
                /* `f.__doc__`: the def's docstring is a constant, so emit the
                 * literal (no runtime attribute table exists).  Any other
                 * receiver has no doc under this model. */
                const IRNode* dbase = n->nchildren > 0 ? n->children[0] : NULL;
                int di = (dbase && d_strcmp(dbase->type,"IDENTIFIER")==0) ? cg_doc_ix(dbase->value) : -1;
                if (di >= 0) {
                    cg_put(g, "\""); cg_put(g, cg_doc_text[di]); cg_put(g, "\"");
                } else {
                    /* No docstring: emit the empty string rather than NULL --
                     * `print(f.__doc__)` goes through printf("%s") and a NULL
                     * argument faults. */
                    cg_put(g, "\"\"");
                }
                return;
            }
            if (d_strcmp(n->value, "__name__") == 0) {
                /* `type(x).__name__` and `cls.__name__`: the class name of an
                 * instance or the name of a class.  A literal class name is
                 * known statically; an instance's class needs the runtime tag
                 * table.  Emitting the bare `__name__` produced an identifier
                 * the generated C could not parse at all. */
                const IRNode* base = n->nchildren > 0 ? n->children[0] : NULL;
                if (base && d_strcmp(base->type,"IDENTIFIER")==0 && cg_is_class(base->value)) {
                    cg_put(g, "\""); cg_put(g, base->value); cg_put(g, "\"");
                } else if (base && d_strcmp(base->type,"IDENTIFIER")==0 && cg_prog_find(base->value) >= 0) {
                    /* `f.__name__` on a FUNCTION: the def's own name.  A
                     * decorated def's body is renamed `<D>_dorig`, so strip
                     * that suffix -- python reports `D` (60_comprehensive 3). */
                    char fn[80];
                    cg_pyname(base->value, fn, 80);
                    cg_put(g, "\""); cg_put(g, fn); cg_put(g, "\"");
                } else if (base && d_strcmp(base->type,"CALL")==0 && d_strcmp(base->value,"type")==0 &&
                           base->nchildren > 0 && d_strcmp(base->children[0]->type,"IDENTIFIER")==0 &&
                           cg_is_exc_var(base->children[0]->value)) {
                    /* `type(e).__name__` on an EXCEPTION binding: the runtime
                     * recorded the raised type, so use it -- the generic path
                     * emitted a literal "str" (err_type became "str" instead of
                     * "RuntimeError", and 16_exceptions SEGV'd reading it). */
                    cg_put(g, "pyx_type_s()");
                } else if (base && d_strcmp(base->type,"CALL")==0 && d_strcmp(base->value,"type")==0 &&
                           base->nchildren > 0 && d_strcmp(base->children[0]->type,"IDENTIFIER")==0 &&
                           d_strcmp(base->children[0]->value,"None")==0) {
                    cg_put(g, "\"NoneType\"");
                } else if (base && d_strcmp(base->type,"CALL")==0 && d_strcmp(base->value,"type")==0 &&
                           base->nchildren > 0 && d_strcmp(base->children[0]->type,"IDENTIFIER")==0 &&
                           cg_is_class(base->children[0]->value)) {
                    cg_put(g, "\""); cg_put(g, base->children[0]->value); cg_put(g, "\"");
                } else if (base && d_strcmp(base->type,"CALL")==0 && d_strcmp(base->value,"type")==0 &&
                           base->nchildren > 0 && d_strcmp(base->children[0]->type,"IDENTIFIER")==0) {
                    /* `type(obj).__name__` for an INSTANCE: the emitter already
                     * knows which class each variable holds, so emit the name
                     * literally. */
                    const IRNode* targ = base->children[0];
                    const char* ccl = cg_cvar_class(targ->value);
                    if (d_strcmp(targ->value,"None")==0) cg_put(g, "\"NoneType\"");
                    else if (ccl) { cg_put(g, "\""); cg_put(g, ccl); cg_put(g, "\""); }
                    else {
                        /* scalars have well-known names */
                        if (cg_is_str_node(targ)) cg_put(g, "\"str\"");
                        else if (cg_is_float_node(targ)) cg_put(g, "\"float\"");
                        else cg_put(g, "\"int\"");
                    }
                } else {
                    cg_put(g, "drygon_class_name(");
                    if (base && d_strcmp(base->type,"CALL")==0 && base->nchildren > 0) cg_gen_expr(g, base->children[0]);
                    else cg_gen_expr(g, base);
                    cg_put(g, ")");
                }
                return;
            }
            /* native memoryview (53_memoryview): a view's own attributes read
             * the live handle, not the fixed shapes the rules below assume. */
            if (n->nchildren>0 && n->value &&
                (cg_mv_kind_expr(n->children[0])==1 || cg_mv_kind_expr(n->children[0])==2)) {
                if (d_strcmp(n->value,"format") == 0) {
                    cg_put(g, "dmv_format("); cg_gen_expr(g, n->children[0]); cg_put(g, ")");
                    return;
                }
                if (d_strcmp(n->value,"nbytes") == 0) {
                    cg_put(g, "dmv_nbytes("); cg_gen_expr(g, n->children[0]); cg_put(g, ")");
                    return;
                }
                if (d_strcmp(n->value,"readonly") == 0) {
                    cg_put(g, "dmv_readonly("); cg_gen_expr(g, n->children[0]); cg_put(g, ")");
                    return;
                }
                if (d_strcmp(n->value,"ndim") == 0) {
                    cg_put(g, "1");
                    return;
                }
                if (d_strcmp(n->value,"itemsize") == 0) {
                    cg_put(g, "dmv_itemsize("); cg_gen_expr(g, n->children[0]); cg_put(g, ")");
                    return;
                }
            }
            if (d_strcmp(n->value, "itemsize") == 0) {
                if (n->nchildren > 0 && n->children[0]->nchildren > 1 &&
                    n->children[0]->children[1]->value && n->children[0]->children[1]->value[0] == 'd') {
                    cg_put(g, "8");
                } else {
                    cg_put(g, "4");
                }
                return;
            }
            if (d_strcmp(n->value, "nbytes") == 0) {
                cg_put(g, "12");
                return;
            }
            if (d_strcmp(n->value, "strides") == 0) {
                cg_put(g, "((int[]){1})");
                return;
            }
            if (d_strcmp(n->value, "testsRun") == 0) {
                cg_put(g, "drygon_test_nrun()");
                return;
            }
            if (d_strcmp(n->value, "errors") == 0 || d_strcmp(n->value, "failures") == 0) {
                cg_put(g, "((int[]){0})");
                return;
            }
            /* `Counter.count` — a CLASS-level attribute (no instance).  The class
             * body registers the attribute as a file-scope global, so emitting
             * `Counter.count` produced C that does not compile (the C front end
             * then segfaulted).  Name the global directly. */
            /* `EnumClass.ATTR.name` -> the attribute's name as a string.  The
             * class-attr branch below turned it into `Color_RED.name`, which is
             * not C (an int has no member). */
            if (n->nchildren>0 && d_strcmp(n->children[0]->type,"MEMBER_ACCESS")==0 &&
                n->children[0]->nchildren>0 &&
                d_strcmp(n->children[0]->children[0]->type,"IDENTIFIER")==0 &&
                cg_is_class(n->children[0]->children[0]->value) &&
                (d_strcmp(n->value,"name")==0)) {
                cg_put(g, "\"");
                cg_put(g, n->children[0]->value);
                cg_put(g, "\"");
                return;
            }
            if (n->nchildren>0 && d_strcmp(n->children[0]->type,"IDENTIFIER")==0 &&
                cg_is_class(n->children[0]->value)) {
                cg_put(g, n->children[0]->value); cg_put(g, "_"); cg_put(g, n->value);
                return;
            }
            /* `e.args` / `e.code` on an exception bound by `except X as e`:
             * the binding emitted `<e>_arg[]` / `<e>_code`, so read those. */
            if (n->nchildren>0 && d_strcmp(n->children[0]->type,"IDENTIFIER")==0 &&
                cg_is_exc_var(n->children[0]->value)) {
                if (d_strcmp(n->value,"args")==0) {
                    cg_gen_expr(g, n->children[0]); cg_put(g, "_arg");
                    return;
                }
                if (d_strcmp(n->value,"code")==0) {
                    cg_gen_expr(g, n->children[0]); cg_put(g, "_code");
                    return;
                }
            }
            /* `a.count` on an INSTANCE where `count` is a CLASS attribute: read
             * the class global.  Only for a bare-identifier body ASSIGN -- a
             * `self.x` field stays a struct member (an earlier version used a
             * looser test and rewrote instance fields too, costing the suite). */
            if (n->nchildren>0 && d_strcmp(n->children[0]->type,"IDENTIFIER")==0) {
                const char* icls = cg_cvar_class(n->children[0]->value);
                /* `cls.count` inside a `@classmethod`: the receiver names the
                 * class, so the attribute is the class global */
                if (!icls) icls = cg_alias_cls_of(n->children[0]->value);
                if (icls && cg_cls_is_class_attr(icls, n->value)) {
                    cg_put(g, icls); cg_put(g, "_"); cg_put(g, n->value);
                    return;
                }
            }
            /* `obj.name` where `name` is a `@property` method: call it.  Emitting
             * the raw member access produced C against a struct that has no
             * such member, so the value was garbage (34_abc 14, 39_descriptors,
             * 60_comprehensive). */
            if (n->nchildren>0 && d_strcmp(n->children[0]->type,"IDENTIFIER")==0) {
                const char* pcls = cg_cvar_class(n->children[0]->value);
                if (!pcls) pcls = cg_curp_cls_of(n->children[0]->value);
                if (pcls && pcls[0] && (cg_cls_mflags_of(pcls, n->value, 0) & 2)) {
                    cg_put(g, cg_cls_find_m(pcls, n->value));
                    cg_put(g, "_"); cg_put(g, n->value);
                    if (cg_is_clsptr(n->children[0]->value)) cg_put(g, "(");
                    else cg_put(g, "(&");
                    cg_gen_expr(g, n->children[0]); cg_put(g, ")");
                    return;
                }
            }
            /* `self.<f>.<attr>` where `<f>` holds an INSTANCE of another class
             * (cg_of_*): the attribute lives in the nested struct, not in a
             * flattened global (`self._r.line_num`). */
            if (n->nchildren>0 && n->children[0] &&
                d_strcmp(n->children[0]->type,"MEMBER_ACCESS")==0 &&
                n->children[0]->nchildren>0 && n->children[0]->children[0] &&
                d_strcmp(n->children[0]->children[0]->type,"IDENTIFIER")==0) {
                const IRNode* _rob = n->children[0];
                const char* _roc = cg_of_get(cg_lf_recv_cls(_rob->children[0]),
                                             _rob->value);
                if (_roc && _roc[0]) {
                    cg_gen_expr(g, _rob->children[0]);
                    if (d_strcmp(_rob->children[0]->value,"self")==0 ||
                        cg_is_clsptr(_rob->children[0]->value)) cg_put(g, "->");
                    else cg_put(g, ".");
                    cg_put(g, _rob->value);
                    cg_put(g, "->"); cg_put(g, n->value);
                    return;
                }
            }
            if (n->nchildren>0) cg_gen_expr(g, n->children[0]);
            /* self->attr → self->attr (struct pointer); other obj.attr → obj.attr */
            if (n->nchildren>0 && (d_strcmp(n->children[0]->value,"self")==0 ||
                (d_strcmp(n->children[0]->type,"IDENTIFIER")==0 &&
                 cg_is_clsptr(n->children[0]->value)))) cg_put(g, "->");
            else cg_put(g, ".");
            cg_put(g, n->value);
            return;
        }
        if (d_strcmp(n->type,"BLOCK")==0 && (d_strcmp(n->value,"LIST")==0||d_strcmp(n->value,"TUPLE")==0||d_strcmp(n->value,"SET")==0)) {
            if (n->nchildren == 0) {
                cg_put(g, "((int[]){0})");
                return;
            }
            int is_str = 0;
            for (int i=0;i<n->nchildren;i++) {
                if (cg_node_is_str_static(n->children[i])) is_str = 1;
            }
            if (is_str) cg_put(g, "((char*[]){");
            else cg_put(g, "((int[]){");
            for (int i=0;i<n->nchildren;i++) {
                if (i>0) cg_put(g, ", ");
                cg_gen_expr(g, n->children[i]);
            }
            cg_put(g, "})");
            return;
        }
        /* DICT literal */
        if (d_strcmp(n->type,"BLOCK")==0 && d_strcmp(n->value,"DICT")==0) {
            cg_put(g, "((int[]){0})");
            return;
        }
        /* fallback */
        cg_put(g, n->value);
    }
    /* Emit `n` bytes of `s` as a C string literal. */
    static void cg_fstr_lit(CGen* g, const char* s, int n) {
        cg_put(g, "\"");
        int i = 0;
        while (i < n) {
            char c = s[i];
            char e[3];
            /* `\uXXXX` / `\UXXXXXXXX` denote one character; the model keeps one
             * byte per code point (the low byte), so the escape is emitted as
             * that single byte.  Bytes outside printable ASCII go out as octal
             * escapes so the following character cannot extend the escape. */
            if (c == '\\' && i + 1 < n && (s[i + 1] == 'u' || s[i + 1] == 'U')) {
                int ndig = (s[i + 1] == 'u') ? 4 : 8;
                int cp = 0;
                int k = i + 2;
                int got = 0;
                int ok = 1;
                while (got < ndig && k < n) {
                    int hc = s[k];
                    int hv = -1;
                    if (hc >= 48 && hc <= 57) hv = hc - 48;
                    else if (hc >= 97 && hc <= 102) hv = hc - 87;
                    else if (hc >= 65 && hc <= 70) hv = hc - 55;
                    if (hv < 0) { ok = 0; break; }
                    cp = cp * 16 + hv;
                    k = k + 1;
                    got = got + 1;
                }
                if (ok && got == ndig) {
                    int b = cp & 255;
                    if (b >= 32 && b < 127 && b != 34 && b != 92) {
                        e[0] = b; e[1] = 0; cg_put(g, e);
                    } else {
                        char o[4];
                        o[0] = '\\';
                        o[1] = 48 + ((b / 64) % 8);
                        o[2] = 48 + ((b / 8) % 8);
                        o[3] = 48 + (b % 8);
                        e[0] = o[0]; e[1] = o[1]; e[2] = 0; cg_put(g, e);
                        e[0] = o[2]; e[1] = o[3]; e[2] = 0; cg_put(g, e);
                    }
                    i = k;
                    continue;
                }
            }
            if (c == '\n') { cg_put(g, "\\n"); }
            else if (c == '\t') { cg_put(g, "\\t"); }
            else if (c == '\r') { cg_put(g, "\\r"); }
            else if (c == '"') { cg_put(g, "\\\""); }
            else if (c == '\\') { cg_put(g, "\\\\"); }
            else { e[0] = c; e[1] = 0; cg_put(g, e); }
            i++;
        }
        cg_put(g, "\"");
    }
    /* Emit one {expr} field of an f-string.  The field text is python source
     * (the tokenizer keeps the whole f-string as one token), so it is parsed
     * here into IR and generated like any other expression: a string stays as
     * it is, a float is rendered through ftoa on its raw bits, an integer
     * through itoa10. */
    static void cg_fstr_field(CGen* g, const char* s, int n) {
        char text[512];
        int i = 0;
        while (i < n && i < 511) { text[i] = s[i]; i++; }
        text[i] = 0;
        IRNode* e = NULL;
        /* A conversion suffix (`f"{x!r}"` / `f"{x!s}"`) sits after the expression;
         * `parse_expr` stops at `!`, leaving it in the text.  Record it here. */
        int conv_repr = 0;
        { int cv = 0;
          while (cv < n && text[cv]) {
              if (text[cv] == 33 && cv + 1 < n) {
                  if (text[cv + 1] == 114 || text[cv + 1] == 82) conv_repr = 1;
                  text[cv] = 0;
                  break;
              }
              cv++;
          }
        }
        { TokenStream ts;
          if (py_tokenize(text, &ts) == 0) {
              PyParser p; p.ts = &ts; p.root = NULL;
              if (pk(&p)->kind != TOK_EOF) e = parse_expr(&p);
          }
        }
        if (!e) { cg_fstr_lit(g, "\"\"", 2); return; }
        if (conv_repr && cg_is_str_node(e)) {
            cg_put(g, "drygon_repr_str(");
            cg_gen_expr(g, e);
            cg_put(g, ")");
            return;
        }
        int is_str = cg_is_str_node(e);
        int is_flt = cg_is_float_node(e);
        /* a comparison / `in` / `not` is a python bool: `f"{10 > 5}"` must
         * interpolate "True", not itoa10's "1" */
        int is_bool = 0;
        if (!is_str && !is_flt) {
            if (d_strcmp(e->type,"BINARY_OP")==0 &&
                (d_strcmp(e->value,"==")==0 || d_strcmp(e->value,"!=")==0 ||
                 d_strcmp(e->value,"<")==0 || d_strcmp(e->value,"<=")==0 ||
                 d_strcmp(e->value,">")==0 || d_strcmp(e->value,">=")==0 ||
                 d_strcmp(e->value,"in")==0 || d_strcmp(e->value,"not in")==0 ||
                 d_strcmp(e->value,"is")==0 || d_strcmp(e->value,"is not")==0 ||
                 d_strcmp(e->value,"and")==0 || d_strcmp(e->value,"or")==0)) is_bool = 1;
            if (d_strcmp(e->type,"UNARY_OP")==0 && d_strcmp(e->value,"not")==0) is_bool = 1;
        }
        if (is_bool) {
            cg_put(g, "(("); cg_gen_expr(g, e); cg_put(g, ") ? \"True\" : \"False\")");
            return;
        }
        /* An object that defines `__format__` decides its own rendering:
         * `f"{p:short}"` must call `Person___format__(p, "short")` instead of
         * stringifying the pointer through itoa10 (60_comprehensive 24/25).  The
         * same method serves the plain `f"{p}"` with an empty spec. */
        {
            const char* ocls = cg_expr_obj_class(e);
            if (ocls && ocls[0] && cg_cls_hasm(ocls, "__format__")) {
                int spec_at = -1;
                int k2 = 0;
                while (k2 < n && text[k2]) { if (text[k2] == 58) { spec_at = k2; break; } k2++; }
                cg_put(g, ocls); cg_put(g, "___format__((void*)");
                cg_gen_expr(g, e);
                cg_put(g, ", ");
                if (spec_at >= 0) {
                    int sl = 0;
                    while (spec_at + 1 + sl < n && text[spec_at + 1 + sl]) sl++;
                    cg_fstr_lit(g, text + spec_at + 1, sl);
                } else cg_put(g, "\"\"");
                cg_put(g, ")");
                return;
            }
        }
        /* An explicit float precision (`f"{pi:.2f}"`) must round to N decimals;
         * plain ftoa printed the full expansion.  Only the `:.Nf` form is
         * handled here -- `>`/`<` alignment specs remain unsupported. */
        if (is_flt) {
            int k = 0;
            int spec_at = -1;
            while (k < n && s[k]) { if (s[k] == 58) { spec_at = k; break; } k++; }
            if (spec_at >= 0) {
                int dig = 0, nd = 0, ok = 0;
                int q = spec_at + 1;
                /* Nested precision: `f"{x:.{w}f}"`.  The digits between `.{`
                 * and `}` are a python EXPRESSION, not a literal, so the scan
                 * above stopped at `{`, `ok` stayed 0 and the whole spec was
                 * dropped -- the literal text `f}` then leaked into the output
                 * ("3.14159" + "f}").  Parse the inner expression and pass its
                 * value as the precision. */
                if (q < n && s[q] == 46 && q + 1 < n && s[q+1] == 123) {
                    int r = q + 2;
                    int depth = 1, e0 = r;
                    while (r < n && depth > 0) {
                        if (s[r] == 123) depth++;
                        else if (s[r] == 125) depth--;
                        if (depth == 0) break;
                        r++;
                    }
                    if (r < n && r > e0) {
                        char ne[256];
                        int nq = 0;
                        while (e0 + nq < r && nq < 255) { ne[nq] = s[e0 + nq]; nq++; }
                        ne[nq] = 0;
                        IRNode* pen = 0;
                        { TokenStream ts2;
                          if (py_tokenize(ne, &ts2) == 0) {
                              PyParser pp2; pp2.ts = &ts2; pp2.root = NULL;
                              if (pk(&pp2)->kind != TOK_EOF) pen = parse_expr(&pp2);
                          }
                        }
                        cg_put(g, "drygon_ftoa_prec(drygon_dbits(");
                        cg_gen_expr(g, e);
                        cg_put(g, "), ");
                        if (pen) cg_gen_expr(g, pen);
                        else cg_put(g, "6");
                        cg_put(g, ")");
                        return;
                    }
                }
                if (q < n && s[q] == 46) {
                    q++;
                    while (q < n && s[q] >= 48 && s[q] <= 57) { nd = nd * 10 + (s[q] - 48); q++; ok = 1; }
                    if (q < n && (s[q] == 102 || s[q] == 70) && ok) {
                        cg_put(g, "drygon_ftoa_prec(drygon_dbits(");
                        cg_gen_expr(g, e);
                        cg_put(g, "), ");
                        cg_put_int(g, nd);
                        cg_put(g, ")");
                        return;
                    }
                }
            }
        }
        /* Width/alignment spec (`f"{42:>10}"` / `"<10"`).  Only a bare `>N` /
         * `<N` is handled; fill characters and `^` are not. */
        {
            int k = 0, spec_at = -1;
            while (k < n && s[k]) { if (s[k] == 58) { spec_at = k; break; } k++; }
            if (spec_at >= 0) {
                int q = spec_at + 1;
                if (q < n && (s[q] == 98 || s[q] == 111)) {
                    /* base spec: `f"{10:b}"` / `f"{10:o}"` */
                    cg_put(g, "drygon_itobase((long)(");
                    cg_gen_expr(g, e);
                    cg_put(g, "), ");
                    cg_put_int(g, s[q] == 98 ? 2 : 8);
                    cg_put(g, ", 0)");
                    return;
                }
                if (q < n && (s[q] == 120 || s[q] == 88)) {
                    /* bare hex spec: `f"{255:x}"` */
                    cg_put(g, "drygon_itox((long)(");
                    cg_gen_expr(g, e);
                    cg_put(g, "), ");
                    cg_put_int(g, s[q] == 88 ? 1 : 0);
                    cg_put(g, ")");
                    return;
                }
                if (q < n && s[q] == 48) {
                    /* zero-padded width: `f"{42:010d}"` */
                    int wd = 0, ok = 0;
                    q++;
                    while (q < n && s[q] >= 48 && s[q] <= 57) { wd = wd * 10 + (s[q] - 48); q++; ok = 1; }
                    if (q < n && (s[q] == 100 || s[q] == 68) && ok) {
                        cg_put(g, "drygon_zeropad(itoa10(");
                        cg_gen_expr(g, e);
                        cg_put(g, "), ");
                        cg_put_int(g, wd);
                        cg_put(g, ")");
                        return;
                    }
                }
                if (q < n && (s[q] == 62 || s[q] == 60 || s[q] == 94)) {
                    int align = (s[q] == 62) ? 0 : ((s[q] == 60) ? 1 : 2);
                    int wd = 0, ok = 0;
                    q++;
                    while (q < n && s[q] >= 48 && s[q] <= 57) { wd = wd * 10 + (s[q] - 48); q++; ok = 1; }
                    if (ok && q >= n) {
                        cg_put(g, "drygon_pad(");
                        if (is_str) { cg_gen_expr(g, e); }
                        else if (is_flt) { cg_put(g, "ftoa(drygon_dbits("); cg_gen_expr(g, e); cg_put(g, "))"); }
                        else { cg_put(g, "itoa10("); cg_gen_expr(g, e); cg_put(g, ")"); }
                        cg_put(g, ", "); cg_put_int(g, wd); cg_put(g, ", "); cg_put_int(g, align); cg_put(g, ")");
                        return;
                    }
                }
            }
        }
        if (!is_str) cg_put(g, is_flt ? "ftoa(drygon_dbits(" : "itoa10(");
        cg_gen_expr(g, e);
        if (!is_str) cg_put(g, is_flt ? "))" : ")");
    }
    /* Character-valued names: a python string index (`s[i]`) and the loop
     * variable of `for c in s` both yield a single character, which must be
     * printed with %c rather than as the raw code point. */
    static char cg_char_vars[8192];
    static int cg_nchar_vars;
    static void cg_note_char(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nchar_vars) {
            int base = i * 32;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_char_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return;
            i++;
        }
        if (cg_nchar_vars >= 256) return;
        int base = cg_nchar_vars * 32;
        int j = 0;
        while (name[j] && j < 31) { cg_char_vars[base + j] = name[j]; j++; }
        cg_char_vars[base + j] = 0;
        cg_nchar_vars = cg_nchar_vars + 1;
    }
    static int cg_is_char_var(const char* name) {
        if (!name) return 0;
        int i = 0;
        while (i < cg_nchar_vars) {
            int base = i * 32;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_char_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }

    /* A printed single character: a name bound by `for c in <string>` or a
     * subscript of a string. */
    static int cg_is_char_node(const IRNode* a) {
        if (!a) return 0;
        if (cg_is_dd_node(a)) return 0;
        if (d_strcmp(a->type,"IDENTIFIER")==0) return cg_is_char_var(a->value);
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 &&
            cg_is_str_node(a->children[0])) return 1;
        return 0;
    }
    static int cg_loop_n;
    /* `for x in <iterable>:` — the iterable is a list literal, a list-valued
     * name or a string.  Lower it to an index loop bound by the list size (a
     * string runs to its terminator), which keeps break/continue working. */
    static void cg_gen_for_iter(CGen* g, const IRNode* n) {
        const IRNode* v = n->nchildren > 0 ? n->children[0] : NULL;
        const IRNode* it = n->nchildren > 1 ? n->children[1] : NULL;
        const IRNode* body = n->nchildren > 2 ? n->children[2] : NULL;
        if (!v) return;
        cg_loop_n = cg_loop_n + 1;
        int ln = cg_loop_n;
        /* `for x, y in pairs:` — a tuple target is destructured per element
         * after the loop variable is bound to the current item. */
        const IRNode* tup = NULL;
        if (d_strcmp(v->type,"BLOCK")==0 && d_strcmp(v->value,"TUPLE")==0) tup = v;
        /* `for i, v in enumerate(seq):` — iterate seq, binding i to the running
         * index and v to the element. The iterable becomes the inner seq. */
        int is_enum = 0;
        const char* enum_idx = NULL;
        const char* enum_val = NULL;
        if (it && d_strcmp(it->type,"CALL")==0 && d_strcmp(it->value,"enumerate")==0 &&
            it->nchildren>0 && tup && tup->nchildren >= 2) {
            is_enum = 1;
            enum_idx = tup->children[0]->value;
            enum_val = tup->children[1]->value;
            it = it->children[0];
        }
        int nsize = -1;
        int isf = 0;
        int isstr = 0;
        int issl = 0;
        int is_split = 0;
        int islp = 0;
        int is_lfield = 0;
        int isstrp = 0;
        /* `for x in recv.m()` where the METHOD builds and returns a list:
         * cg_gen_for_iter has no branch for a method-call source, so it fell
         * through to the default and looped on a nonexistent `<recv>_n`,
         * spinning forever over garbage (24_collections, 50_csv).  The call
         * lands in the shared result buffer, so drain that with its runtime
         * count. */
        if (it && d_strcmp(it->type,"CALL")==0 && it->nchildren > 0 &&
            it->children[0] && d_strcmp(it->children[0]->type,"MEMBER_ACCESS")==0) {
            int _msls = 0;
            if (cg_mcall_ret_list(it, &_msls)) {
                const char* _lv = (tup && tup->nchildren > 0) ? tup->children[0]->value
                                                              : v->value;
                if (_lv && _lv[0]) {
                    cg_indent(g); cg_put(g, "{\n"); g->indent++;
                    cg_indent(g);
                    cg_put(g, _msls ? "char* " : "int "); cg_put(g, _lv); cg_put(g, ";\n");
                    if (_msls) cg_note_str(_lv); else cg_forget_str(_lv);
                    cg_indent(g);
                    cg_put(g, _msls ? "char** _mfl = " : "int* _mfl = ");
                    cg_gen_expr(g, it); cg_put(g, ";\n");
                    cg_indent(g); cg_put(g, "int _mfn = ");
                    cg_put(g, _msls ? "drygon_rls_n" : "drygon_rl_n"); cg_put(g, ";\n");
                    cg_indent(g); cg_put(g, "int _mfi;\n");
                    cg_indent(g); cg_put(g, "for (_mfi = 0; _mfi < _mfn; _mfi++) {\n");
                    g->indent++;
                    cg_indent(g); cg_put(g, _lv); cg_put(g, " = _mfl[_mfi];\n");
                    if (body) {
                        int _bi = 0;
                        while (_bi < body->nchildren) {
                            cg_gen_node(g, body->children[_bi], 1);
                            _bi++;
                        }
                    }
                    g->indent--; cg_indent(g); cg_put(g, "}\n");
                    g->indent--; cg_indent(g); cg_put(g, "}\n");
                    return;
                }
            }
        }
        int isdict = 0;
        int dkf = 0;
        int has_src = 0;
        int isstrtmp = 0;
        int isslt = 0;
        int isslt_et = 0;
        int isob = 0;
        char obcls[32];
        obcls[0] = 0;
        if (cg_is_list_node(it)) {
            nsize = it->nchildren;
            has_src = 1;
        } else if (it && d_strcmp(it->type,"CALL")==0 && it->value &&
                   d_strcmp(it->value,"COMPLEX")!=0 && cg_fn_is_list(it->value)) {
            /* `for x in gen(n)` / `for x in f()` where the callee RETURNS a
             * list: the call fills drygon_rl, so iterate that buffer with its
             * runtime count.  Without this branch the loop emitted nothing at
             * all (20_advanced check 2). */
            cg_gen_expr(g, it);
            cg_put(g, ";\n");
            cg_indent(g);
            cg_put(g, "{ int "); cg_put(g, v->value); cg_put(g, "; int _gi = 0;\n");
            g->indent++;
            cg_indent(g);
            if (cg_fn_ret_strlist(it->value)) {
                cg_put(g, "while (_gi < drygon_rls_n) { ");
                cg_put(g, v->value); cg_put(g, " = drygon_rls[_gi];\n");
            } else {
                cg_put(g, "while (_gi < drygon_rl_n) { ");
                cg_put(g, v->value); cg_put(g, " = drygon_rl[_gi];\n");
            }
            if (body) cg_gen_block(g, body);
            cg_indent(g);
            cg_put(g, "_gi = _gi + 1; }\n");
            g->indent--;
            cg_indent(g);
            cg_put(g, "}\n");
            return;
        } else if (it && d_strcmp(it->type,"CALL")==0 && it->value &&
                   it->value[0] && cg_is_class(it->value) &&
                   cg_cls_find_m(it->value, "__iter__")) {
            /* `for x in Range(5)` where the class defines `__iter__`: build the
             * object, run its iterator (a `yield` generator fills drygon_rl)
             * and walk that buffer (12_classes 53).
