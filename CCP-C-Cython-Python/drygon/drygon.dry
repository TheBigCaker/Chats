                comp_call_ptr(c, l);
                lex_expect(l, T_SEMI);
                return;
            }
            int dw = 4;
            if (ch_w == 8 || ch_w == 2 || ch_w == 1) dw = ch_w;
            if (c->cmp_op > 0) {
                /* Double member lvalue (`s.d += v`): route the operands
                 * through the d-registers (comp_emit_cmp's isf path does
                 * fadd d0, d1, d0) and store the result with str d. */
                int mf = (ch_f2 != 0 || locf2 || glof2) && dw == 8;
                int sf4 = (ch_f2 != 0 || locf2 || glof2) && dw == 4;
                comp_push_x0(c); /* [probed][addr] */
                if (dw == 8) code_emit(&c->code, a_ldr_x(0, 0, 0));
                else if (dw == 1) code_emit(&c->code, a_ldrb(0, 0, 0));
                else if (dw == 2) code_emit(&c->code, a_ldrh(0, 0, 0));
                else code_emit(&c->code, a_ldr_w(0, 0, 0));
                comp_push_x0(c); /* [probed][addr][old] */
                lex_advance(l);  /* consume the compound operator */
                c->cast_sz_hint = 0;
                comp_ternary(c, l); /* x0 = rhs (stops at comma) */
                if (mf) {
                    if (!c->expr_is_float) code_emit(&c->code, a_scvtf_d_x(0, 0));
                } else if (sf4) {
                    /* 4-byte float member/element: old value is single bits,
                     * rhs either an int (scvtf) or a double (fcvt). */
                    if (!c->expr_is_float) code_emit(&c->code, a_scvtf_s_w(0, 0));
                    else code_emit(&c->code, a_fcvt_s_d(0, 0));
                } else if (c->expr_is_float) {
                    code_emit(&c->code, a_fcvtzu_x_d(0, 0));
                    c->expr_is_float = 0;
                }
                comp_pop_x1(c);  /* x1 = previous value */
                if (mf) code_emit(&c->code, a_fmov_d_x(1, 1));
                else if (sf4) code_emit(&c->code, a_fmov_s_w(1, 1));
                comp_pop_x2(c);  /* x2 = address */
                comp_emit_cmp(c, c->cmp_op, mf ? 1 : (sf4 ? 2 : 0));
                if (mf) code_emit(&c->code, a_str_d(0, 2, 0));
                else if (sf4) code_emit(&c->code, a_str_s(0, 2, 0));
                else if (dw == 8) code_emit(&c->code, a_str_x(0, 2, 0));
                else if (dw == 1) code_emit(&c->code, a_strb(0, 2, 0));
                else if (dw == 2) code_emit(&c->code, a_strh(0, 2, 0));
                else code_emit(&c->code, a_str_w(0, 2, 0));
                code_emit(&c->code, a_addi(31, 31, 16)); /* drop probed value */
            } else if (lex_is(l, T_INC) || lex_is(l, T_DEC)) {
                /* `p->f++` / `a[i]--` as a whole statement: load, step, store
                 * back through the chain address (x0). */
                int is_dec = lex_is(l, T_DEC);
                lex_advance(l);
                comp_push_x0(c); /* [addr] */
                if (dw == 8) code_emit(&c->code, a_ldr_x(0, 0, 0));
                else if (dw == 1) code_emit(&c->code, a_ldrb(0, 0, 0));
                else if (dw == 2) code_emit(&c->code, a_ldrh(0, 0, 0));
                else code_emit(&c->code, a_ldr_w(0, 0, 0));
                int inc = c->lval_stride;
                if (inc <= 0) inc = 1;
                c->lval_stride = 0;
                if (inc <= 4095) {
                    if (is_dec) code_emit(&c->code, a_subi(0, 0, inc));
                    else code_emit(&c->code, a_addi(0, 0, inc));
                } else {
                    comp_load_imm(&c->code, 2, inc);
                    if (is_dec) code_emit(&c->code, a_sub(0, 0, 2));
                    else code_emit(&c->code, a_add(0, 0, 2));
                }
                comp_pop_x1(c); /* x1 = address */
                if (dw == 8) code_emit(&c->code, a_str_x(0, 1, 0));
                else if (dw == 1) code_emit(&c->code, a_strb(0, 1, 0));
                else if (dw == 2) code_emit(&c->code, a_strh(0, 1, 0));
                else code_emit(&c->code, a_str_w(0, 1, 0));
            } else if (lex_is(l, T_ASSIGN)) {
                comp_push_x0(c); /* [addr] */
                lex_advance(l);
                c->cast_sz_hint = 0;
                comp_ternary(c, l); /* x0 = value (stops at comma) */
                if (c->cast_sz_hint == 1) dw = 1;
                else if (c->cast_sz_hint == 2) dw = 2;
                else if (c->cast_sz_hint == 8) dw = 8;
                comp_pop_x1(c); /* x1 = address */
                /* A float value lives in d0, not x0: `t->dval = fv;` used to
                 * store the *destination address* into the member. Same idiom
                 * as the `*p = v;` statement path below. */
                if (c->expr_is_float) {
                    if (dw == 4 && (ch_f2 || locf2 || glof2)) {
                        code_emit(&c->code, a_fcvt_s_d(0, 0));
                        code_emit(&c->code, a_str_s(0, 1, 0));
                    } else code_emit(&c->code, a_str_d(0, 1, 0));
                }
                else if (dw == 4 && (ch_f2 || locf2 || glof2)) {
                    /* int RHS into a float element: convert, then store 4 bytes
                     * (a_str_w used to emit the raw integer bits). */
                    code_emit(&c->code, a_scvtf_s_w(0, 0));
                    code_emit(&c->code, a_str_s(0, 1, 0));
                }
                else if (dw == 8 && (ch_f2 || locf2 || glof2)) {
                    /* int RHS into a double element (dw==8 + flag is
                     * unambiguously a double member/element). */
                    code_emit(&c->code, a_scvtf_d_x(0, 0));
                    code_emit(&c->code, a_str_d(0, 1, 0));
                }
                else if (dw == 8) code_emit(&c->code, a_str_x(0, 1, 0));
                else if (dw == 1) code_emit(&c->code, a_strb(0, 1, 0));
                else if (dw == 2) code_emit(&c->code, a_strh(0, 1, 0));
                else code_emit(&c->code, a_str_w(0, 1, 0));
                lex_expect(l, T_SEMI);
            } else {
                if (lex_is(l, T_SEMI)) { lex_advance(l); return; }
                lex_expect(l, T_SEMI);
                return;
            }
        } else if (lex_is(l, T_LPAREN)) {
            comp_call(c, l, varname);
            lex_expect(l, T_SEMI);
        } else if (lex_is(l, T_ASSIGN) && comp_agg_lval_size(c, varname) > 0) {
            /* aggregate assignment: `dst = src;` (src may be `*p`).
             * comp_is_agg() requires more than 8 bytes, so an exactly 8-byte
             * typedef aggregate (`typedef struct {int x; int y;} Pt;`) used to
             * fall through to the scalar path and store only the source
             * OBJECT's address as an integer (`q = p` printed garbage).  The
             * struct slot check keeps this to real aggregates -- a plain
             * pointer local never reaches here because it is not an array.
             * File-scope aggregate objects (`static date _gcs1;`) take the
             * same path through the global tables, so `_gcs1 = v;` copies the
             * object instead of storing the source address. */
            int dsz = comp_agg_lval_size(c, varname);
            int doff = comp_find_var(c, varname);
            lex_advance(l); /* '=' */
            if (lex_is(l, T_STAR)) lex_advance(l);
            comp_expr(c, l); /* x0 = source address */
            if (doff >= 0) comp_add_off(c, 1, 29, doff);
            else comp_gvar_addr_reg(c, varname, 1);
            comp_emit_struct_copy(c, dsz);
            c->expr_is_float = 0;
            lex_expect(l, T_SEMI);
        } else if (c->cmp_op > 0 && !lex_is(l, T_LBRACKET)) {
            comp_assign_cmp(c, l, varname, c->cmp_op);
            lex_expect(l, T_SEMI);
        } else if (lex_is(l, T_ASSIGN)) {
            comp_assign(c, l, varname);
            lex_expect(l, T_SEMI);
        } else if (lex_is(l, T_INC) || lex_is(l, T_DEC)) {
            /* `varname++;` / `varname--;` as a whole statement: step the lvalue
             * in place. Locals live on the frame (str x0, [x29, #off]), globals
             * in the data section (address first, then store through it). */
            int is_dec = lex_is(l, T_DEC);
            lex_advance(l);
            int off = comp_find_var(c, varname);
            if (off >= 0) {
                comp_ldr_slot(c, 0, off);
                int st = comp_ptr_stride(c, varname);
                if (st <= 0) st = 1;
                if (st <= 4095) {
                    if (is_dec) code_emit(&c->code, a_subi(0, 0, st));
                    else code_emit(&c->code, a_addi(0, 0, st));
                } else {
                    comp_load_imm(&c->code, 2, st);
                    if (is_dec) code_emit(&c->code, a_sub(0, 0, 2));
                    else code_emit(&c->code, a_add(0, 0, 2));
                }
                comp_str_slot(c, 0, off);
            } else if (comp_find_gvar(varname) >= 0) {
                comp_gvar_addr(c, varname); /* x0 = address */
                comp_push_x0(c);
                code_emit(&c->code, a_ldr_x(0, 0, 0));
                int st = comp_ptr_stride(c, varname);
                if (st <= 0) st = 1;
                if (st <= 4095) {
                    if (is_dec) code_emit(&c->code, a_subi(0, 0, st));
                    else code_emit(&c->code, a_addi(0, 0, st));
                } else {
                    comp_load_imm(&c->code, 2, st);
                    if (is_dec) code_emit(&c->code, a_sub(0, 0, 2));
                    else code_emit(&c->code, a_add(0, 0, 2));
                }
                comp_pop_x1(c);
                code_emit(&c->code, a_str_x(0, 1, 0));
            }
            lex_expect(l, T_SEMI);
        } else if (d_strcmp(t->text, "__asm__") == 0) {
            lex_advance(l);
            if (d_strcmp(lex_cur(l)->text, "volatile") == 0) lex_advance(l);
            if (lex_is(l, T_LPAREN)) {
                lex_advance(l);
                if (lex_cur(l)->kind == T_STR) {
                    if (d_strcmp(lex_cur(l)->text, "svc 0") == 0) {
                        code_emit(&c->code, 0xd4000001);
                    } else if (d_strcmp(lex_cur(l)->text, "__syscall") == 0) {
                        code_emit(&c->code, 0xAA0003E8);
                        code_emit(&c->code, 0xAA0103E0);
                        code_emit(&c->code, 0xAA0203E1);
                        code_emit(&c->code, 0xAA0303E2);
                        code_emit(&c->code, 0xAA0403E3);
                        code_emit(&c->code, 0xAA0503E4);
                        code_emit(&c->code, 0xAA0603E5);
                        code_emit(&c->code, 0xd4000001);
                    }
                    lex_advance(l);
                }
                while (!lex_is(l, T_RPAREN) && !lex_is(l, T_EOF)) lex_advance(l);
                if (lex_is(l, T_RPAREN)) lex_advance(l);
            }
            if (lex_is(l, T_SEMI)) lex_advance(l);
        } else {
            /* bare expression statement: rewind to the identifier and compile
             * the whole expression (`p--;`, `s + 1;`, `f()->x;`). */
            *l = l_stmt0;
            comp_expr(c, l);
            lex_expect(l, T_SEMI);
        }
    } else if (t->kind == T_STAR) {
        /* pointer store: `*p = value;` -- and the aggregate form
         * `*p = other;` which copies the bytes of another aggregate. */
        lex_advance(l); /* '*' */
        /* Capture the pointee's floatness before comp_unary consumes the
         * operand: an int RHS stored through `*p` must be converted (raw
         * integer bits used to land in the float slot). Locals only — global
         * pointer pointee sizes are not tracked. */
        int spf = 0;
        int spsz = 0;
        if (lex_kind(l) == T_IDENT) {
            char sn[64];
            d_strncpy(sn, lex_cur(l)->text, 63); sn[63] = 0;
            spf = comp_var_pfloat(c, sn);
            spsz = comp_var_pointee(c, sn);
        }
        comp_unary(c, l); /* x0 = destination address */
        comp_push_x0(c);
        lex_expect(l, T_ASSIGN);
        c->cast_sz_hint = 0;
        int cpy_sz = 0;
        if (lex_kind(l) == T_IDENT) {
            int psz = comp_var_pointee(c, lex_cur(l)->text);
            if (comp_is_agg(psz)) cpy_sz = psz;
        }
        comp_ternary(c, l); /* x0 = value (or source address; stops at comma) */
        comp_pop_x1(c); /* x1 = destination address */
        if (cpy_sz > 0) {
            comp_emit_struct_copy(c, cpy_sz);
        } else if (c->expr_is_float) {
            code_emit(&c->code, a_str_d(0, 1, 0));
        } else if (spf && spsz == 4 && c->cast_sz_hint == 0) {
            code_emit(&c->code, a_scvtf_s_w(0, 0));
            code_emit(&c->code, a_str_s(0, 1, 0));
        } else if (spf && spsz == 8 && c->cast_sz_hint == 0) {
            code_emit(&c->code, a_scvtf_d_x(0, 0));
            code_emit(&c->code, a_str_d(0, 1, 0));
        } else if (c->cast_sz_hint == 1) {
            code_emit(&c->code, a_strb(0, 1, 0));
        } else if (c->cast_sz_hint == 2) {
            code_emit(&c->code, a_strh(0, 1, 0));
        } else if (c->cast_sz_hint == 4) {
            code_emit(&c->code, a_str_w(0, 1, 0));
        } else {
            code_emit(&c->code, a_str_x(0, 1, 0));
        }
        c->expr_is_float = 0;
        lex_expect(l, T_SEMI);
    } else if (t->kind == T_LPAREN) {
        /* parenthesised expression statement, e.g. `(void)foo();` — or a
         * store through a casted pointer: `((T*)p)->field = v;` */
        comp_expr(c, l); /* x0 = value / base address */
        if (lex_is(l, T_ARROW) || lex_is(l, T_DOT)) {
            int mem_w = 4;
            int mem_is_ptr = 0;
            while (lex_is(l, T_ARROW) || lex_is(l, T_DOT)) {
                lex_advance(l);
                DcToken* mem = lex_cur(l);
                if (mem->kind != T_IDENT) {
                    d_puts("direct_compiler: expected identifier\n");
                    sys_exit(1);
                }
                lex_advance(l);
                int gs = -1;
                int gsz = 0;
                int mo = comp_field_offset_any(c, mem->text, &gs, &gsz);
                if (mo < 0 && d_strcmp(mem->text, "words") == 0) { mo = 0; gsz = 4; }
                if (mo > 0) {
                    comp_load_imm(&c->code, 1, mo);
                    code_emit(&c->code, a_add(0, 0, 1));
                }
                if (mo >= 0) {
                    if (gsz == 8) mem_is_ptr = 1;
                    else mem_w = gsz;
                }
            }
            comp_push_x0(c);
            lex_expect(l, T_ASSIGN);
            c->cast_sz_hint = 0;
            comp_ternary(c, l); /* member assign rhs (stops at comma) */
            comp_pop_x1(c);
            if (c->expr_is_float) {
                code_emit(&c->code, a_str_d(0, 1, 0));
            } else if (mem_is_ptr || mem_w == 8) {
                code_emit(&c->code, a_str_x(0, 1, 0));
            } else if (mem_w == 1) {
                code_emit(&c->code, a_strb(0, 1, 0));
            } else if (mem_w == 2) {
                code_emit(&c->code, a_strh(0, 1, 0));
            } else {
                code_emit(&c->code, a_str_w(0, 1, 0));
            }
            c->expr_is_float = 0;
        } else if (lex_is(l, T_LBRACKET)) {
            /* store through a subscripted cast: `((T*)p)[i] = v;` */
            int celem = 4;
            if (c->cast_sz_hint > 0 && c->cast_sz_hint <= 8) celem = c->cast_sz_hint;
            int cw = 0;
            int ce2 = 1;
            int cs2 = -1;
            int cu2 = 0;
            int cwf = 0;
            comp_chain_addr(c, l, 2, -1, 8, celem, 0, -1, &cw, &ce2, &cs2, &cu2, &cwf);
            comp_push_x0(c); /* [addr] */
            lex_expect(l, T_ASSIGN);
            c->cast_sz_hint = 0;
            comp_ternary(c, l); /* subscript assign rhs (stops at comma) */
            comp_pop_x1(c); /* x1 = addr */
            int sdw = 4;
            if (cw == 8 || cw == 2 || cw == 1) sdw = cw;
            if (c->cast_sz_hint == 1) sdw = 1;
            else if (c->cast_sz_hint == 2) sdw = 2;
            else if (c->cast_sz_hint == 8) sdw = 8;
            if (c->expr_is_float) {
                if (sdw == 4 && cwf) {
                    code_emit(&c->code, a_fcvt_s_d(0, 0));
                    code_emit(&c->code, a_str_s(0, 1, 0));
                } else code_emit(&c->code, a_str_d(0, 1, 0));
            }
            else if (sdw == 8) code_emit(&c->code, a_str_x(0, 1, 0));
            else if (sdw == 1) code_emit(&c->code, a_strb(0, 1, 0));
            else if (sdw == 2) code_emit(&c->code, a_strh(0, 1, 0));
            else code_emit(&c->code, a_str_w(0, 1, 0));
            c->expr_is_float = 0;
        }
        lex_expect(l, T_SEMI);
    } else if (t->kind == T_INC || t->kind == T_DEC) {
        /* prefix `++x;` / `--x;` as a whole statement: comp_primary's prefix
         * path steps the lvalue and leaves the new value in x0 (which the
         * statement discards). */
        comp_expr(c, l);
        lex_expect(l, T_SEMI);
    } else {
        /* skip unknown statement */
        lex_advance(l);
    }
}

/* ------ Function compiler --------------------------------------------------------------------------------------------------------------------------------------------------------------- */
/* Emit the function epilogue: restore sp, x29, x30, ret.
 * The `add sp, sp, #frame_size` is emitted as a placeholder (imm=0) and
 * patched after the body compiles, once frame_size is known. */
static void comp_emit_epilogue(Compiler* c) {
    int idx = c->code.nwords;
    code_emit(&c->code, a_addi(31, 31, 0)); /* add sp, sp, #0 (patched) */
    /* Beyond capacity the `add sp, sp, #0` would stay unpatched, silently
     * corrupting the frame on that return path (02_operators, 76 returns). */
    if (c->nret_add < 1024) {
        c->ret_add_idx[c->nret_add] = idx;
        c->nret_add = c->nret_add + 1;
    }
    code_emit(&c->code, a_ldp_x29_x30());
    code_emit(&c->code, a_ret());
}

/* Skip past any remaining type keywords + pointer stars + qualifiers so the
 * next token is the parameter name. Called by comp_function after the type
 * qualifier loop when a typedef name (not a builtin type keyword) leads the
 * parameter list, e.g. `void f(MyType a, MyType* b)`. */
static void comp_skip_type_kws(Lexer* l) {
    while (lex_is(l, T_INT) || lex_is(l, T_CHAR) || lex_is(l, T_VOID) ||
           lex_is(l, T_FLOAT) || lex_is(l, T_DOUBLE) ||
           lex_is(l, T_UNSIGNED) || lex_is(l, T_LONG) ||
           lex_is(l, T_SHORT) || lex_is(l, T_SIGNED) ||
           lex_is(l, T_SIZE_T) || lex_is(l, T_BOOL) ||
           lex_is(l, T_STRUCT) || lex_is(l, T_ENUM) ||
           lex_is(l, T_UNION) || lex_is(l, T_CONST) ||
           lex_is(l, T_VOLATILE) || lex_is(l, T_RESTRICT) ||
           lex_is(l, T_TYPEDEF) || lex_is(l, T_STATIC) ||
           lex_is(l, T_INLINE) || lex_is(l, T_REGISTER) ||
           lex_is(l, T_EXTERN))
        lex_advance(l);
}

/* Consume a declaration's type prefix and report what it was:
 * qualifiers/builtin keywords, an optional typedef or struct/union/enum tag, a
 * nested `struct X` body and the pointer stars. Leaves the lexer at the
 * declarator name (or at whatever is not part of the type). `kw` gets the last
 * type keyword seen (for width selection), `star` counts pointer levels, and
 * `tname` gets the typedef/tag name when one was named.
 * This is the single place that resolves `const MyType* p`, `MyType const* p`,
 * `MyType a`, `MyType* a`, `unsigned long long a`, `struct Foo* a`. */
static void comp_parse_type(Lexer* l, int* kw, int* star, char* tname, int* is_tag, int* uns) {
    *kw = 0;
    *star = 0;
    *is_tag = 0;
    *uns = 0;
    tname[0] = 0;
    while (1) {
        int k = lex_kind(l);
        if (k == T_UNSIGNED || k == T_LONG || k == T_SHORT || k == T_SIGNED ||
            k == T_INT || k == T_CHAR || k == T_FLOAT || k == T_DOUBLE ||
            k == T_VOID || k == T_SIZE_T || k == T_BOOL ||
            k == T_CONST || k == T_VOLATILE || k == T_RESTRICT ||
            k == T_REGISTER || k == T_STATIC || k == T_INLINE ||
            k == T_EXTERN || k == T_TYPEDEF || k == T_NORETURN ||
            k == T_COMPLEX) {
            if (k == T_UNSIGNED || k == T_SIZE_T) *uns = 1;
            *kw = k;
            lex_advance(l);
            continue;
        }
        if (k == T_STRUCT || k == T_UNION || k == T_ENUM) {
            *is_tag = 1;
            lex_advance(l);
            if (lex_is(l, T_IDENT)) {
                d_strncpy(tname, lex_text(l), 63); tname[63] = 0;
                lex_advance(l);
            }
            continue;
        }
        if (k == T_IDENT) {
            /* a name is part of the type when something that can only be a
             * declarator follows it: another name, a star, or a qualifier
             * (i.e. `MyType a`, `MyType* a`, `MyType const* a`). */
            Lexer lc = *l;
            lex_advance(&lc);
            int nk = lex_kind(&lc);
            if (nk == T_IDENT || nk == T_STAR || nk == T_CONST ||
                nk == T_VOLATILE || nk == T_RESTRICT || nk == T_UNSIGNED ||
                nk == T_LONG || nk == T_SHORT || nk == T_SIGNED || nk == T_INT ||
                nk == T_CHAR || nk == T_FLOAT || nk == T_DOUBLE || nk == T_VOID) {
                *is_tag = 0;
                d_strncpy(tname, lex_text(l), 63); tname[63] = 0;
                lex_advance(l);
                continue;
            }
        }
        break;
    }
    while (lex_is(l, T_STAR)) {
        *star = *star + 1;
        lex_advance(l);
        /* post-star qualifiers: `int *restrict p`, `const char *const q` */
        while (lex_is(l, T_CONST) || lex_is(l, T_VOLATILE) || lex_is(l, T_RESTRICT)) lex_advance(l);
    }
}

/* Store an incoming parameter into its frame slot.  AAPCS64 passes the first
 * eight integer arguments in x0..x7 and each later one on the stack, at
 * entry_sp + 8*(pidx-8).  The old code spilled only pidx < 8 and silently
 * dropped the rest, so a function with more than eight parameters -- drygon
 * has exactly two, comp_chain_addr (11) and PimDispatcher_dispatch_gemm (9) --
 * read uninitialised frame memory for them: comp_chain_addr's out-pointers
 * were garbage, so its epilogue writeback stored through them and every
 * drygon-built compiler segfaulted (the stage-2 self-host crash).
 *
 * The incoming stack-argument base is entry sp, which comp_function parks in
 * x15 before the frame is allocated; it is cached in the hidden local
 * __argstk the first time it is needed so it stays addressable for any frame
 * size. */
/* Spill one incoming parameter into its frame slot. `is_float` selects the
 * floating point register file (d0..d7) for an IEEE-754 value. */
static void comp_spill_param(Compiler* c, int pidx, int off, int* stk_base_off, int is_float) {
    if (pidx < 8) {
        if (is_float) comp_str_slot_d(c, pidx, off);
        else comp_str_slot(c, pidx, off);
        return;
    }
    if (*stk_base_off < 0) {
        *stk_base_off = comp_add_var(c, "__argstk");
        comp_str_slot(c, 15, *stk_base_off);
    }
    comp_ldr_slot(c, 9, *stk_base_off);
    comp_add_off(c, 9, 9, 8 * (pidx - 8));
    if (is_float) {
        code_emit(&c->code, a_ldr_d(9, 9, 0));
        comp_str_slot_d(c, 9, off);
    } else {
        code_emit(&c->code, a_ldr_x(9, 9, 0));
        comp_str_slot(c, 9, off);
    }
}

/* Pointee element size for a pointer return type, so postfix chains on a
 * call result (`pick()[0]`, `lex_buf()[2]`) stride and load the right width.
 * star == 0 → 0 (not a pointer). star >= 2 → 8 (pointer to pointer). star == 1
 * → the base scalar size, or the typedef/struct size for `MyType* f()`. */
static int fn_pelem_compute(Compiler* c, int kw, int star, char* tname, int is_tag) {
    if (star >= 2) return 8;
    if (star == 0) return 0;
    int base = 4;
    if (kw == T_CHAR) base = 1;
    else if (kw == T_SHORT) base = 2;
    else if (kw == T_LONG || kw == T_DOUBLE) base = 8;
    else if (kw == T_FLOAT) base = 4;
    if (tname[0]) {
        int td = is_tag ? -1 : comp_find_typedef(c, tname);
        int sz = 0;
        if (td >= 0) sz = c->td_sizes[td];
        if (sz <= 0) {
            int sl = comp_find_struct(c, tname);
            if (sl >= 0) sz = c->su_size[sl];
        }
        if (sz > 0) base = sz;
    }
    return base;
}

/* Register one `#define` directive: function-like macros into the fm_*
 * tables, integer-shaped object-like macros into def_values + fm_*.  Shared
 * by the top-level loop and comp_stmt: a #define inside a function body used
 * to leak `define NAME body` tokens into the statement parser ("expected
 * SEMI got NUM"). */
static void comp_do_define(Lexer* l) {
            /* record integer object-like macro, then skip line.
             * `#define NAME(params) body` (no space before '(') is a
             * function-like macro: record its name, parameter names and raw
             * body text in the fm_* tables; every use site expands it. */
            DcToken* t = lex_cur(l);
            int def_line = t->line;
            lex_advance(l);
            /* The macro name (and parameter names) must stay visible here even
             * when the same name is already defined as an empty macro. */
            pp_no_skip = 1;
            if (lex_is(l, T_IDENT) && lex_line(l) == def_line && ndefs < 1024) {
                DcToken* mn = lex_cur(l);
                /* Function-like?  The '(' must sit directly after the name
                 * (no space): `#define SQ(x)` vs object-like `#define A (1+2)`.
                 * lfm.pos - name_end == 1 confirms adjacency. */
                {
                    Lexer lfm = *l;
                    int name_end = lfm.pos;
                    lex_advance(&lfm);
                    if (lex_is(&lfm, T_LPAREN) && (lfm.pos - name_end) == 1 && fm_n < FM_MAX) {
                        char mname[64];
                        d_strncpy(mname, mn->text, 63); mname[63] = 0;
                        lex_advance(l);            /* the name */
                        lex_advance(l);            /* '(' */
                        int np = 0;
                        while (!lex_is(l, T_EOF) && !lex_is(l, T_RPAREN) && lex_line(l) == def_line && np < 8) {
                            if (lex_is(l, T_IDENT)) {
                                char* dest = fm_params_buf + (fm_n * 8 + np) * 64;
                                d_strncpy(dest, lex_text(l), 63);
                                dest[63] = 0;
                                np = np + 1;
                                lex_advance(l);
                                if (lex_is(l, T_COMMA)) lex_advance(l);
                            } else {
                                lex_advance(l);
                            }
                        }
                        if (lex_is(l, T_RPAREN)) lex_advance(l);
                        /* Raw body span: from here to the end of this source
                         * line.  Scan the raw source rather than comparing
                         * token line numbers: a token's `line` field does not
                         * always agree with the line the #define started on,
                         * and a mismatch let the scan run past the end of the
                         * line and swallow the following declarations into
                         * the macro body (the body text then ended in
                         * `#define` + the next line, and expansion produced
                         * garbage). */
                        int bstart = l->pos;
                        int bend = bstart;
                        while (lfm.src[bend] && lfm.src[bend] != 10) {
                            if (lfm.src[bend] == 92 && lfm.src[bend + 1] == 10) { bend = bend + 2; continue; }
                            bend = bend + 1;
                        }
                        int bl = bend - bstart;
                        if (bl > 500) bl = 500;
                        char* bodyd = fm_body_buf + fm_n * 512;
                        { int z = 0; while (z < bl) { bodyd[z] = lfm.src[bstart + z]; z = z + 1; } }
                        while (bl > 0 && (bodyd[bl - 1] == 32 || bodyd[bl - 1] == 9 || bodyd[bl - 1] == 13)) bl = bl - 1;
                        bodyd[bl] = 0;
                        fm_body_len[fm_n] = bl;
                        fm_nparams[fm_n] = np;
                        { char* nd = fm_names_buf + fm_n * 64;
                          d_strncpy(nd, mname, 63); nd[63] = 0; }
                        fm_n = fm_n + 1;
                        /* leave the main lexer at the end of the line */
                        while (!lex_is(l, T_EOF) && l->pos < bend) lex_advance(l);
                        pp_no_skip = 0;
                        return;
                    }
                }
                /* Raw body span: starts at the first character after the name
                 * (`l->pos` already sits there -- the name token is
                 * materialised and `pos` is just past it) and ends at the
                 * newline.  Read from the raw source rather than from token
                 * line numbers: a token's `line` does not always agree with the
                 * line the #define started on, and an empty body must stay
                 * empty instead of swallowing whatever follows on the next
                 * line (`#define DRYGON_TYPES`). */
                int bstart = l->pos;
                while (l->src[bstart] == 32 || l->src[bstart] == 9) bstart = bstart + 1;
                int bend = bstart;
                while (l->src[bend] && l->src[bend] != 10) {
                    if (l->src[bend] == 92 && l->src[bend + 1] == 10) { bend = bend + 2; continue; }
                    bend = bend + 1;
                }
                int bl = bend - bstart;
                if (bl > 500) bl = 500;
                { int z = 0; while (z < bl) { fm_nestbuf[z] = l->src[bstart + z]; z = z + 1; } }
                while (bl > 0 && (fm_nestbuf[bl - 1] == 32 || fm_nestbuf[bl - 1] == 9 || fm_nestbuf[bl - 1] == 13)) bl = bl - 1;
                fm_nestbuf[bl] = 0;
                lex_advance(l);
                /* Probe the body for the shapes an integer macro can have:
                 * `NUM`, `(NUM)`, `[-]NUM`, `([-]NUM)` and a pointer cast
                 * `((TYPE)[-]NUM)`.  A hit records the folded value in
                 * def_values for the numeric readers (`#if`, array extents);
                 * the *body text* is filed in the fm_* tables as an
                 * object-like macro (zero parameters) either way, so every
                 * use site expands the real body.  Substituting the bare
                 * first number for the body made `MAX_SRC_BYTES
                 * ( 8 * 1024 * 1024)` allocate 8 bytes and `PYR_ARENA_BYTES
                 * (256 * 1024 * 1024)` mmap 256 bytes. */
                int is_int = 1;
                int val = 0;
                if (bl == 0) {
                    /* `#define EMPTY` has no body at all: the name is deleted
                     * where it appears, so it is not the integer 0.  Recording
                     * it as an integer made `EMPTY 5` parse as `EMPTY` then a
                     * stray `5`. */
                    is_int = 0;
                } else {
                    Lexer pb;
                    pb.src = fm_nestbuf;
                    pb.pos = 0;
                    pb.lex_line = def_line;
                    pb.has_tok = 0;
                    pb.rec = 0;
                    pb.errs = 0;
                    pb.brace_depth = 0;
                    pb.pp_sp = 0;
                    pb.pp_emit = 1;
                    { int z = 0; while (z < 16) { pb.pp_taken[z] = 0; z = z + 1; } }
                    if (lex_is(&pb, T_LPAREN)) lex_advance(&pb);
                    if (lex_is(&pb, T_LPAREN)) {
                        /* `((TYPE)NUM)`: the inner balanced group is the cast
                         * and carries no number of its own, so step over it.
                         * `((void*)8)` folds to 8, `((void*)-1)` to -1. */
                        int depth = 0;
                        int saw_num = 0;
                        Lexer la = pb;
                        while (!lex_is(&la, T_EOF) && depth >= 0) {
                            if (lex_is(&la, T_LPAREN)) depth = depth + 1;
                            else if (lex_is(&la, T_RPAREN)) {
                                depth = depth - 1;
                                if (depth == 0) { lex_advance(&la); break; }
                            } else if (lex_is(&la, T_NUM)) saw_num = 1;
                            lex_advance(&la);
                        }
                        if (depth == 0 && saw_num == 0) pb = la;
                    }
                    int neg = 0;
                    if (lex_is(&pb, T_MINUS)) { neg = 1; lex_advance(&pb); }
                    if (lex_is(&pb, T_NUM)) { val = lex_num(&pb); lex_advance(&pb); }
                    else is_int = 0;
                    if (is_int) {
                        if (lex_is(&pb, T_RPAREN)) lex_advance(&pb);
                        if (!lex_is(&pb, T_EOF)) is_int = 0;
                    }
                    if (neg) val = 0 - val;
                }
                /* C99 6.10.3p2: a redefinition REPLACES the previous
                 * definition.  Appending a second row made lookups find the
                 * stale value forever (`#define DBG 0` ... `#define DBG 1`
                 * kept printing 0). */
                int dex = -1;
                { int di = 0; while (di < ndefs) { if (d_strcmp(def_names_buf + di * 64, mn->text) == 0) { dex = di; break; } di = di + 1; } }
                if (dex >= 0) { def_values[dex] = val; def_isint[dex] = is_int; }
                else {
                    d_memcpy(def_names_buf + ndefs * 64, mn->text, 64);
                    def_values[ndefs] = val;
                    def_isint[ndefs] = is_int;
                    ndefs = ndefs + 1;
                }
                /* Every object-like macro with a body is filed in the fm_*
                 * tables as well, including the integer-shaped ones above
                 * (`5`, `(1)`, `-2`, `((T*)0)`).  The fm_* body is the only
                 * place the *spelling* survives, and `#`/`##` read the
                 * spelling: gcc makes `#define E (1)` + `XSTR(E)` the string
                 * `"(1)"` and `#define N 0x10` + `XSTR(N)` the string
                 * `"0x10"`, while substituting the folded number gave `"1"`
                 * and `"16"`.  The def_values/def_isint row stays for the
                 * numeric readers (#if, array extents) that never expand. */
                if (fm_n < FM_MAX) {
                    int fex = -1;
                    { int fi = 0; while (fi < fm_n) { if (d_strcmp(fm_names_buf + fi * 64, mn->text) == 0) { fex = fi; break; } fi = fi + 1; } }
                    int fslot = (fex >= 0) ? fex : fm_n;
                    char* bodyd = fm_body_buf + fslot * 512;
                    { int z = 0; while (z < bl) { bodyd[z] = fm_nestbuf[z]; z = z + 1; } }
                    bodyd[bl] = 0;
                    fm_body_len[fslot] = bl;
                    fm_nparams[fslot] = 0;
                    { char* nd2 = fm_names_buf + fslot * 64;
                      d_strncpy(nd2, mn->text, 63); nd2[63] = 0; }
                    if (fex < 0) fm_n = fm_n + 1;
                }
            }
            while (!lex_is(l, T_EOF) && lex_line(l) == def_line) lex_advance(l);
}

static void comp_function(Compiler* c, Lexer* l, char* name, int ret_float, int ret_ptr, int ret_pelem, int ret_f32) {
    /* signature: int name(params) { body } */
    comp_add_fn(c, name);
    /* one-time init of the aggregate-return scratch name */
    if (!g_agg_ret_init) {
        d_strncpy(g_agg_ret_name, "_dyaggret", 31);
        g_agg_ret_name[31] = 0;
        g_agg_ret_init = 1;
    }
    /* reset per-function state */
    c->nvars = 0;
    c->frame_size = 0;
    c->nloops = 0;
    c->nret_add = 0;
    c->pend_var_has = 0;
    /* Function-local `static` aliases do not outlive the function that
     * declared them, or a later function's `n` would resolve to this one's. */
    lstat_n = 0;
    local_const_n = 0;
    g_cur_fn_ret_float = ret_float;
    g_cur_fn_ret_agg = g_pending_ret_agg;
    char fn_pf[8];
    char fn_pa[8];
    { int fi = 0; while (fi < 8) { fn_pf[fi] = 0; fn_pa[fi] = 0; fi++; } }
    int fn_np = 0;
    /* var_pointee/var_eslot are indexed by variable slot and only written when
     * a name matches, so without clearing them slot k of a fresh function would
     * still hold the element size the *previous* function stored at slot k:
     * that is what gave `char* ptr; ptr[0]` a 4-byte stride and load. */
    { int vr = 0;
      while (vr < 1024) { c->var_pointee[vr] = 0; c->var_eslot[vr] = 0; c->var_pfloat[vr] = 0; vr = vr + 1; } }
    code_label(&c->code, name);
    /* prologue: stp x29,x30,[sp,#-16]! ; sub sp,sp,#frame_size ; mov x29,sp
     * x29 points at the BOTTOM of the frame, so locals at positive offsets
     * from x29 land inside this function's own frame (not the caller's),
     * which is what makes recursion safe. */
    code_emit(&c->code, a_stp_x29_x30());
    /* x15 = entry sp = the base of the incoming stack arguments.  It has to be
     * captured before the frame size is known, and only a_str_x is emitted
     * until the stack parameters are spilled (see comp_spill_param), so x15
     * survives; nothing else in this backend uses x15 but comp_add_off. */
    code_emit(&c->code, a_addi(15, 31, 16));
    /* allocate stack frame: sub sp, sp, #0 (patched after body) */
    c->frame_sub_idx = c->code.nwords;
    code_emit(&c->code, a_subi(31, 31, 0));
    code_emit(&c->code, a_addi(29, 31, 0)); /* mov x29, sp */
    /* params: x0..x7 -> stack */
    lex_expect(l, T_LPAREN);
    int pidx = 0;
    int is_var = 0;
    int stk_base_off = -1;   /* slot holding the incoming stack-arg base */
    if (!lex_is(l, T_RPAREN)) {
        while (1) {
            if (lex_is(l, T_DOTDOTDOT)) { /* variadic */
                is_var = 1;
                lex_advance(l);
                if (lex_is(l, T_COMMA)) { lex_advance(l); continue; }
                break;
            }
            /* param type (may include pointer stars); remember the type name so
             * the parameter's element size and struct slot can be recorded. */
            char ptype[64];
            ptype[0] = 0;
            int p_is_tag = 0;
            int p_star = 0;
            int p_kw = 0;
            int p_uns = 0;
            comp_parse_type(l, &p_kw, &p_star, ptype, &p_is_tag, &p_uns);
            DcToken* pt = lex_cur(l);
            if (pt->kind == T_IDENT) {
                char pname[64];
                d_strncpy(pname, pt->text, 63); pname[63] = 0;
                lex_advance(l);
                int p_is_float = ((p_kw == T_DOUBLE || p_kw == T_FLOAT) && p_star == 0);
                int off = comp_add_var_typed(c, pname, p_is_float);
                if (fn_np < 8) fn_pf[fn_np] = p_is_float;
                fn_np++;
                int peslot = -1;
                /* Element size of the declared base type. `T* p` subscripts
                 * stride by sizeof(T) and `*p` loads sizeof(T) bytes, so the
                 * base width matters: a `char*` must stay 1 byte, while one
                 * pointer level beyond that (the pointee is itself a pointer)
                 * is always 8. */
                int pbase = 4;
                if (p_kw == T_CHAR) pbase = 1;
                else if (p_kw == T_SHORT) pbase = 2;
                else if (p_kw == T_LONG || p_kw == T_DOUBLE) pbase = 8;
                else if (p_kw == T_FLOAT) pbase = 4;
                int psz = pbase;
                if (ptype[0]) {
                    int ptd = p_is_tag ? -1 : comp_find_typedef(c, ptype);
                    if (ptd >= 0) {
                        psz = c->td_sizes[ptd];
                        if (psz <= 0) psz = 4;
                        if (c->td_kinds[ptd] == 1 || c->td_kinds[ptd] == 2)
                            peslot = c->td_slots[ptd] - 1;
                    }
                    if (peslot < 0) peslot = comp_find_struct(c, ptype);
                    if (ptd < 0 && peslot >= 0) psz = c->su_size[peslot];
                    if (psz <= 0) psz = 4;
                    pbase = psz;
                }
                if (p_star >= 2) psz = 8;
                else if (p_star == 1) psz = pbase;
                if (lex_is(l, T_LBRACKET)) {
                    /* array parameter: the name holds a pointer, but its stride
                     * is the element size times the known inner dimensions
                     * (`char names[][64]` strides 64). */
                    int pdims[4];
                    int pnd = comp_array_dims(c, l, pdims, 4);
                    int pstride = psz;
                    int pdi = 1;
                    while (pdi < pnd) {
                        if (pdims[pdi] > 1) pstride = pstride * pdims[pdi];
                        pdi = pdi + 1;
                    }
                    if (pdims[0] > 0) pstride = psz;
                    psz = pstride;
                    if (p_star >= 1) psz = 8;
                }
                comp_set_var_pointee(c, pname, psz);
                if (p_star >= 1) comp_mark_ptr_stride(c, pname, (p_star >= 2) ? 8 : psz);
                if ((p_kw == T_DOUBLE || p_kw == T_FLOAT) && p_star <= 1)
                    comp_set_var_pfloat(c, pname, 1);
                if (p_star == 1 && peslot >= 0) comp_mark_ptr_slot(c, pname, peslot);
                else if (p_star == 0 && peslot >= 0) {
                    comp_set_var_eslot(c, pname, peslot);
                    if (fn_np <= 8 && fn_np > 0) fn_pa[fn_np - 1] = (psz <= 16) ? psz : 0;
                }
                comp_spill_param(c, pidx, off, &stk_base_off, p_is_float);
                pidx++;
            }
            if (lex_is(l, T_LPAREN)) {
                /* function-pointer parameter: `void (*name)(args)`. Passed in a
                 * register like any pointer; the arg list is skipped. */
                lex_advance(l);
                if (lex_is(l, T_STAR)) {
                    lex_advance(l);
                    if (lex_is(l, T_IDENT)) {
                        char fpname[64];
                        d_strncpy(fpname, lex_cur(l)->text, 63); fpname[63] = 0;
                        lex_advance(l);
                        if (lex_is(l, T_RPAREN)) {
                            lex_advance(l);
                            if (lex_is(l, T_LPAREN)) {
                                int foff = comp_add_var(c, fpname);
                                comp_set_var_pointee(c, fpname, 8);
                                comp_set_var_eslot(c, fpname, -1);
                                comp_spill_param(c, pidx, foff, &stk_base_off, 0);
                                pidx++;
                                comp_skip_group(l);  /* (args) */
                            }
                        }
                    }
                }
            }
            if (lex_is(l, T_COMMA)) { lex_advance(l); continue; }
            break;
        }
    }
    if (!lex_expect(l, T_RPAREN)) return;
    fn_sig_add(name, ret_float, fn_np, fn_pf, ret_ptr, ret_pelem, ret_f32);
    fn_sig_set_pagg(name, fn_pa);
    /* variadic: spill the remaining argument registers into consecutive
     * slots so va_start/va_arg can walk them as memory.  Slots are filled in
     * ascending register order, so ascending memory reads x(pidx), x(pidx+1)
     * ... x7 -- the cursor starts at the lowest of those. */
    c->va_base_off = 0;
    c->va_dbl_off = 0;
    if (is_var) {
        int vi = pidx;
        while (vi < 8) {
            char vn[8];
            vn[0] = '_'; vn[1] = '_'; vn[2] = 'v'; vn[3] = 'a';
            vn[4] = (char)('0' + vi); vn[5] = 0;
            int voff = comp_add_var(c, vn);
            if (vi == pidx) c->va_base_off = voff;
            code_emit(&c->code, a_str_x(vi, 29, voff));
            vi++;
        }
        int si = 0;
        while (si < 16) {
            char sn[8];
            sn[0] = '_'; sn[1] = '_'; sn[2] = 'v'; sn[3] = 's';
            sn[4] = (char)('0' + (si / 10)); sn[5] = (char)('0' + (si % 10)); sn[6] = 0;
            int soff = comp_add_var(c, sn);
            code_emit(&c->code, a_ldr_x(16, 15, si * 8));
            code_emit(&c->code, a_str_x(16, 29, soff));
            si++;
        }
        /* spill float registers d0..d7 for variadic double args */
        int di = 0;
        while (di < 8) {
            char dn[8];
            dn[0] = '_'; dn[1] = '_'; dn[2] = 'v'; dn[3] = 'd';
            dn[4] = (char)('0' + di); dn[5] = 0;
            int doff = comp_add_var(c, dn);
            if (di == pidx) c->va_dbl_off = doff;
            code_emit(&c->code, a_str_d(di, 29, doff));
            di++;
        }
    }
    /* body */
    comp_block(c, l);
    /* default return 0 */
    comp_load_imm(&c->code, 0, 0);
    comp_emit_epilogue(c);
    /* patch the frame size into the prologue sub sp and all epilogue add sp.
     * Locals live at +16..+16+8*(nvars-1) from x29.  The saved x29/x30 sit
     * at x29+fs and x29+fs+8 (pushed by stp before the sub), so fs must be
     * strictly greater than the highest local offset (16+frame_size) and
     * 16-byte aligned for the stp alignment requirement. */
    int fs = ((c->frame_size + 32 + 15) / 16) * 16;
    if (fs >= 4096) {
        fs = ((fs + 4095) / 4096) * 4096;
        int imm = fs / 4096;
        c->code.words[c->frame_sub_idx] = a_subi(31, 31, imm) + 4194304;
        { int i = 0; while (i < c->nret_add) { c->code.words[c->ret_add_idx[i]] = a_addi(31, 31, imm) + 4194304; i++; } }
    } else {
        c->code.words[c->frame_sub_idx] = a_subi(31, 31, fs);
        { int i = 0; while (i < c->nret_add) { c->code.words[c->ret_add_idx[i]] = a_addi(31, 31, fs); i++; } }
    }
}

/* ------ printf helper (machine code) ------------------------------------------------------------------------------------------------------------------------------ */
/* x0 = printf vararg #x20 (1-based).  Emits a call to the printf_load_arg
 * helper (defined inside emit_printf) which handles both register varargs
 * (x1..x7) and stack varargs (arg 8 and beyond, passed on the stack by
 * comp_call per AAPCS64). */
static void emit_load_arg(Code* c) {
    int la_idx = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, la_idx, "printf_load_arg", 1, 0, 0);
}
static void emit_printf(Code* c) {
    code_label(c, "printf");
    /* prologue: save x19-x28, x29, x30 (96 bytes), then reserve 64 more
     * below for the arg save area (negative offsets from x29). */
    { int pair = 0; while (pair < 5) { code_emit(c, a_stp_pre(19 + pair*2, 20 + pair*2, 31, -16)); pair++; } }
    code_emit(c, a_stp_x29_x30());
    code_emit(c, a_addi(29, 31, 0));
    code_emit(c, a_subi(31, 31, 64));
    /* save args x1..x7 to [sp, 8*i] (sp = x29 - 64, positive offsets) */
    { int i = 1; while (i < 8) { code_emit(c, a_str_x(i, 31, 8*i)); i++; } }
    /* x19 = fmt */
    code_emit(c, a_mov(19, 0));
    /* x20 = arg index */
    comp_load_imm(c, 20, 1);
    /* x21 = output buffer (static), x22 = len */
    int adr_idx = c->nwords;
    code_emit(c, a_adrp(21, 0));
    code_emit(c, a_addi(21, 21, 0));
    code_patch(c, adr_idx, "printf_buf", 3, 0, 21);
    comp_load_imm(c, 22, 0);
    /* loop */
    code_label(c, "printf_loop");
    code_emit(c, a_ldrb(0, 19, 0));
    code_emit(c, a_cmpi(0, 0));
    int done_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, done_idx, "printf_done", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 37)); /* 37 */
    int plain_idx = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, plain_idx, "printf_plain", 2, CC_NE, 0);
    /* handle % */
    code_emit(c, a_addi(19, 19, 1));
    code_emit(c, a_ldrb(0, 19, 0));
    code_emit(c, a_cmpi(0, 37)); /* %% */
    int pct_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, pct_idx, "printf_pct", 2, CC_EQ, 0);
    /* flags + field width: '-' (left), '0' (zero pad), '+', ' ', '#', digits.
     * x27 = width, x28 = flags (bit0 zero, bit1 left, bit2 plus, bit3 space,
     * bit4 hash).  Applied by printf_wapp and read by printf_pargs for pcvt. */
    comp_load_imm(c, 27, 0);
    comp_load_imm(c, 28, 0);
    code_label(c, "printf_fw");
    code_emit(c, a_cmpi(0, 45));
    int fw_l = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fw_l, "printf_fw_l", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 48));
    int fw_z = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fw_z, "printf_fw_z", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 43));
    int fw_pl = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fw_pl, "printf_fw_plus", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 32));
    int fw_sp = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fw_sp, "printf_fw_space", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 35));
    int fw_hs = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fw_hs, "printf_fw_hash", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 49));
    int fw_d1 = c->nwords;
    code_emit(c, a_bcond(CC_LT, 0));
    code_patch(c, fw_d1, "printf_fw_end", 2, CC_LT, 0);
    code_emit(c, a_cmpi(0, 57));
    int fw_d2 = c->nwords;
    code_emit(c, a_bcond(CC_GT, 0));
    code_patch(c, fw_d2, "printf_fw_end", 2, CC_GT, 0);
    int fw_dig = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_dig, "printf_fw_digit", 0, 0, 0);
    code_label(c, "printf_fw_z");
    code_emit(c, a_cmpi(27, 0));
    int fw_zmid = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, fw_zmid, "printf_fw_digit", 2, CC_NE, 0);
    int fw_zadv = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_zadv, "printf_fw_adv_z", 0, 0, 0);
    code_label(c, "printf_fw_plus");
    comp_load_imm(c, 15, 4);
    code_emit(c, a_orr(28, 28, 15));
    int fw_pl_b = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_pl_b, "printf_fw_adv", 0, 0, 0);
    code_label(c, "printf_fw_space");
    comp_load_imm(c, 15, 8);
    code_emit(c, a_orr(28, 28, 15));
    int fw_sp_b = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_sp_b, "printf_fw_adv", 0, 0, 0);
    code_label(c, "printf_fw_hash");
    comp_load_imm(c, 15, 16);
    code_emit(c, a_orr(28, 28, 15));
    int fw_hs_b = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_hs_b, "printf_fw_adv", 0, 0, 0);
    code_label(c, "printf_fw_l");
    comp_load_imm(c, 15, 2);
    code_emit(c, a_orr(28, 28, 15));
    int fw_l_b = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_l_b, "printf_fw_adv", 0, 0, 0);
    code_label(c, "printf_fw_adv_z");
    comp_load_imm(c, 15, 1);
    code_emit(c, a_orr(28, 28, 15));
    code_label(c, "printf_fw_adv");
    code_emit(c, a_addi(19, 19, 1));
    code_emit(c, a_ldrb(0, 19, 0));
    int fw_back2 = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_back2, "printf_fw", 0, 0, 0);
    code_label(c, "printf_fw_digit");
    /* width digit: x27 = x27*10 + (x0 - '0') */
    code_emit(c, a_subi(15, 0, 48));
    code_emit(c, a_add(26, 27, 27));
    code_emit(c, a_add(26, 26, 26));
    code_emit(c, a_add(26, 26, 26));
    code_emit(c, a_add(26, 26, 27));
    code_emit(c, a_add(26, 26, 27));
    code_emit(c, a_add(27, 26, 15));
    code_emit(c, a_addi(19, 19, 1));
    code_emit(c, a_ldrb(0, 19, 0));
    int fw_back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, fw_back, "printf_fw", 0, 0, 0);
    code_label(c, "printf_fw_end");
    /* x24 = precision of the current conversion, -1 = none.  x24 is
     * callee-saved (saved in the prologue above) and is re-parsed for every
     * %, so leaf helpers that borrow it (itoa uses x24/x25) cannot corrupt a
     * later conversion's precision. */
    comp_load_imm(c, 24, 0 - 1);
    int prec_idx = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, prec_idx, "printf_prec", 0, 0, 0);
    /* optional precision: '.' digits */
    code_label(c, "printf_prec");
    code_emit(c, a_cmpi(0, 46)); /* . */
    int prec_no = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, prec_no, "printf_lenmod", 2, CC_NE, 0);
    code_emit(c, a_addi(19, 19, 1)); /* consume '.' */
    comp_load_imm(c, 24, 0);
    code_label(c, "printf_prec_loop");
    code_emit(c, a_ldrb(0, 19, 0));
    code_emit(c, a_cmpi(0, 48));
    int prec_lt = c->nwords;
    code_emit(c, a_bcond(CC_LT, 0));
    code_patch(c, prec_lt, "printf_lenmod", 2, CC_LT, 0);
    code_emit(c, a_cmpi(0, 57));
    int prec_gt = c->nwords;
    code_emit(c, a_bcond(CC_GT, 0));
    code_patch(c, prec_gt, "printf_lenmod", 2, CC_GT, 0);
    code_emit(c, a_subi(15, 0, 48)); /* digit value (x27 holds width) */
    /* x26 = x24 * 10; x24 = x26 + digit */
    code_emit(c, a_add(26, 24, 24));
    code_emit(c, a_add(26, 26, 26));
    code_emit(c, a_add(26, 26, 24));
    code_emit(c, a_add(26, 26, 26));
    code_emit(c, a_add(24, 26, 15));
    code_emit(c, a_addi(19, 19, 1));
    int prec_back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, prec_back, "printf_prec_loop", 0, 0, 0);
    /* Length modifiers are skipped, not interpreted: %ld/%lu/%lx/%hd all take
     * the same argument slot as their bare form (everything here is already
     * 64-bit).  Without this, "%ld" fell through to the unknown-conversion
     * path, printed no argument and left the vararg cursor one slot behind. */
    code_label(c, "printf_lenmod");
    code_emit(c, a_cmpi(0, 108)); /* l */
    int lm_l = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, lm_l, "printf_lenadv_l", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 104)); /* h */
    int lm_h = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, lm_h, "printf_lenadv", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 122)); /* z */
    int lm_z = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, lm_z, "printf_lenadv", 2, CC_EQ, 0);
    int lm_end = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, lm_end, "printf_lenend", 0, 0, 0);
    code_label(c, "printf_lenadv_l");
    /* bit5 of x28: l modifier seen — l-modified conversions stay 64-bit */
    comp_load_imm(c, 15, 32);
    code_emit(c, a_orr(28, 28, 15));
    code_label(c, "printf_lenadv");
    code_emit(c, a_addi(19, 19, 1));
    code_emit(c, a_ldrb(0, 19, 0));
    int lm_back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, lm_back, "printf_lenmod", 0, 0, 0);
    code_label(c, "printf_lenend");
    code_emit(c, a_cmpi(0, 100)); /* d */
    int d_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, d_idx, "printf_num", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 105)); /* i */
    int ii_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, ii_idx, "printf_num", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 117)); /* u */
    int u_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, u_idx, "printf_num32", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 115)); /* s */
    int s_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, s_idx, "printf_s", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 120)); /* x */
    int x_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, x_idx, "printf_num32", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 88)); /* X */
    int xX_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, xX_idx, "printf_num32", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 111)); /* o */
    int oo_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, oo_idx, "printf_num32", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 102)); /* f */
    int f_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, f_idx, "printf_flt", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 70)); /* F */
    int fF_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fF_idx, "printf_flt", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 101)); /* e */
    int fe_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fe_idx, "printf_flt", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 69)); /* E */
    int fE_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fE_idx, "printf_flt", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 103)); /* g */
    int fg_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fg_idx, "printf_flt", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 71)); /* G */
    int fG_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, fG_idx, "printf_flt", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 99)); /* c */
    int cc_idx = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, cc_idx, "printf_c", 2, CC_EQ, 0);
    /* unknown: skip */
    int skip_idx = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, skip_idx, "printf_next", 0, 0, 0);
    /* pcvt-routed integer conversions: %d %i (signed).  Flags x28 are turned
     * into pcvt's plus/spacef/hash args by printf_pargs; the conversion char
     * is parked in x11 (clobbered only by wapp's internal bookkeeping, which
     * runs after we've consumed it). */
    code_label(c, "printf_num");
    code_emit(c, a_mov(11, 0));
    int pn_pargs = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, pn_pargs, "printf_pargs", 1, 0, 0);
    comp_load_imm(c, 26, 0);
    emit_load_arg(c);
    code_emit(c, a_addi(20, 20, 1));
    code_emit(c, a_mov(2, 0));
    int pn_adr = c->nwords;
    code_emit(c, a_adrp(0, 0));
    code_emit(c, a_addi(0, 0, 0));
    code_patch(c, pn_adr, "cvt_buf", 3, 0, 0);
    code_emit(c, a_mov(1, 11));
    comp_load_imm(c, 3, 0);
    code_emit(c, a_mov(4, 24));
    int pn_pcvt = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, pn_pcvt, "drygon_pcvt", 1, 0, 0);
    int pn_adr2 = c->nwords;
    code_emit(c, a_adrp(0, 0));
    code_emit(c, a_addi(0, 0, 0));
    code_patch(c, pn_adr2, "cvt_buf", 3, 0, 0);
    int pn_app = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, pn_app, "printf_wapp", 1, 0, 0);
    int pn_next = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, pn_next, "printf_next", 0, 0, 0);
    /* pcvt-routed unsigned conversions: %u %x %X %o — the value is
     * zero-extended to 32 bits first (C semantics: unsigned int args). */
    code_label(c, "printf_num32");
    code_emit(c, a_mov(11, 0));
    int p32_pargs = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, p32_pargs, "printf_pargs", 1, 0, 0);
    comp_load_imm(c, 26, 0);
    emit_load_arg(c);
    /* %lu/%lx/%lX/%lo: l modifier seen (x28 bit5) → keep full 64 bits */
    code_emit(c, a_andi_m12(15, 28, 32));
    code_emit(c, a_cmpi(15, 0));
    int p32_l = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_emit(c, a_uxtw_x(0, 0));
    code_patch(c, p32_l, "printf_num32_l", 2, CC_NE, 0);
    code_label(c, "printf_num32_l");
    code_emit(c, a_addi(20, 20, 1));
    code_emit(c, a_mov(2, 0));
    int p32_adr = c->nwords;
    code_emit(c, a_adrp(0, 0));
    code_emit(c, a_addi(0, 0, 0));
    code_patch(c, p32_adr, "cvt_buf", 3, 0, 0);
    code_emit(c, a_mov(1, 11));
    comp_load_imm(c, 3, 0);
    code_emit(c, a_mov(4, 24));
    int p32_pcvt = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, p32_pcvt, "drygon_pcvt", 1, 0, 0);
    int p32_adr2 = c->nwords;
    code_emit(c, a_adrp(0, 0));
    code_emit(c, a_addi(0, 0, 0));
    code_patch(c, p32_adr2, "cvt_buf", 3, 0, 0);
    int p32_app = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, p32_app, "printf_wapp", 1, 0, 0);
    int p32_next = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, p32_next, "printf_next", 0, 0, 0);
    /* pcvt-routed float conversions: %f %F %e %E %g %G.  The arg is the raw
     * IEEE-754 bit pattern; pcvt reinterprets it via drygon_dbits. */
    code_label(c, "printf_flt");
    code_emit(c, a_mov(11, 0));
    int pf_pargs = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, pf_pargs, "printf_pargs", 1, 0, 0);
    emit_load_arg(c);
    code_emit(c, a_addi(20, 20, 1));
    code_emit(c, a_cmpi(24, 0));
    int pf_prec = c->nwords;
    code_emit(c, a_bcond(CC_GE, 0));
    code_patch(c, pf_prec, "printf_flt_have", 2, CC_GE, 0);
    comp_load_imm(c, 24, 6);
    code_label(c, "printf_flt_have");
    code_emit(c, a_mov(2, 0));
    int pf_adr = c->nwords;
    code_emit(c, a_adrp(0, 0));
    code_emit(c, a_addi(0, 0, 0));
    code_patch(c, pf_adr, "cvt_buf", 3, 0, 0);
    code_emit(c, a_mov(1, 11));
    comp_load_imm(c, 3, 1);
    code_emit(c, a_mov(4, 24));
    int pf_pcvt = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, pf_pcvt, "drygon_pcvt", 1, 0, 0);
    int pf_adr2 = c->nwords;
    code_emit(c, a_adrp(0, 0));
    code_emit(c, a_addi(0, 0, 0));
    code_patch(c, pf_adr2, "cvt_buf", 3, 0, 0);
    comp_load_imm(c, 26, 0);
    int pf_app = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, pf_app, "printf_wapp", 1, 0, 0);
    int pf_next = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, pf_next, "printf_next", 0, 0, 0);
    /* %s */
    code_label(c, "printf_s");
    comp_load_imm(c, 26, 1);
    emit_load_arg(c);
    code_emit(c, a_addi(20, 20, 1));
    int appstr_idx = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, appstr_idx, "printf_wapp", 1, 0, 0);
    int next2 = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, next2, "printf_next", 0, 0, 0);
    /* %% */
    code_label(c, "printf_pct");
    comp_load_imm(c, 0, 37);
    int putc_idx = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, putc_idx, "buf_putc", 1, 0, 0);
    int next5 = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, next5, "printf_next", 0, 0, 0);
    /* %c: stash the char into a 2-byte scratch so width padding applies */
    code_label(c, "printf_c");
    comp_load_imm(c, 26, 1);
    emit_load_arg(c);
    code_emit(c, a_addi(20, 20, 1));
    int cb_adr = c->nwords;
    code_emit(c, a_adrp(24, 0));
    code_emit(c, a_addi(24, 24, 0));
    code_patch(c, cb_adr, "itoa_buf", 3, 0, 24);
    code_emit(c, a_strb(0, 24, 0));
    comp_load_imm(c, 0, 0);
    code_emit(c, a_strb(0, 24, 1));
    code_emit(c, a_mov(0, 24));
    int cwapp_idx = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, cwapp_idx, "printf_wapp", 1, 0, 0);
    int next6 = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, next6, "printf_next", 0, 0, 0);
    /* plain */
    code_label(c, "printf_plain");
    int putc2 = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, putc2, "buf_putc", 1, 0, 0);
    /* next */
    code_label(c, "printf_next");
    code_emit(c, a_addi(19, 19, 1));
    int back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, back, "printf_loop", 0, 0, 0);
    /* done: flush */
    code_label(c, "printf_done");
    int flush_idx = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, flush_idx, "buf_flush", 1, 0, 0);
    /* epilogue: restore sp (drop arg area), then saved regs */
    code_emit(c, a_addi(31, 31, 64));
    code_emit(c, a_ldp_x29_x30());
    { int pair = 4; while (pair >= 0) { code_emit(c, a_ldp_post(19 + pair*2, 20 + pair*2, 31, 16)); pair--; } }
    code_emit(c, a_ret());

    /* printf_load_arg: x0 = vararg #x20 (1-based), clobbers x14/x15.
     * x20 = 1..7: the register varargs saved in the arg area at [sp + 8*x20].
     * x20 >= 8: the incoming stack arguments, which the caller left at
     * entry_sp + 8*(x20-8) where entry_sp = sp + 160 here (80 bytes of callee
     * saves + 16 for x29/x30 + 64 for the arg save area), i.e. the value
     * lives at [sp + 96 + 8*x20]. */
    code_label(c, "printf_load_arg");
    code_emit(c, a_cmpi(20, 8));
    int pla_idx = c->nwords;
    code_emit(c, a_bcond(CC_GE, 0));
    code_patch(c, pla_idx, "pla_stack", 2, CC_GE, 0);
    code_emit(c, a_add(14, 20, 20));
    code_emit(c, a_add(14, 14, 14));
    code_emit(c, a_add(14, 14, 14));
    code_emit(c, a_addi(15, 31, 0));
    code_emit(c, a_add(14, 14, 15));
    code_emit(c, a_ldr_x(0, 14, 0));
    int pla_done_idx = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, pla_done_idx, "pla_done", 0, 0, 0);
    code_label(c, "pla_stack");
    code_emit(c, a_add(14, 20, 20));
    code_emit(c, a_add(14, 14, 14));
    code_emit(c, a_add(14, 14, 14));
    code_emit(c, a_addi(15, 31, 96));
    code_emit(c, a_add(14, 14, 15));
    code_emit(c, a_ldr_x(0, 14, 0));
    code_label(c, "pla_done");
    code_emit(c, a_ret());

    /* printf_pargs: x28 flags -> x5 = plus, x6 = spacef, x7 = hash. */
    code_label(c, "printf_pargs");
    code_emit(c, a_andi_m12(15, 28, 4));
    code_emit(c, a_cmpi(15, 0));
    code_emit(c, a_cset(5, CC_NE));
    code_emit(c, a_andi_m12(15, 28, 8));
    code_emit(c, a_cmpi(15, 0));
    code_emit(c, a_cset(6, CC_NE));
    code_emit(c, a_andi_m12(15, 28, 16));
    code_emit(c, a_cmpi(15, 0));
    code_emit(c, a_cset(7, CC_NE));
    code_emit(c, a_ret());

    /* buf_putc: x0 = char */
    code_label(c, "buf_putc");
    code_emit(c, a_strb(0, 21, 0));
    code_emit(c, a_addi(21, 21, 1));
    code_emit(c, a_addi(22, 22, 1));
    code_emit(c, a_ret());

    /* buf_append: x0 = null-terminated string */
    code_label(c, "buf_append");
    code_emit(c, a_mov(23, 0));
    code_label(c, "buf_append_loop");
    code_emit(c, a_ldrb(0, 23, 0));
    code_emit(c, a_cmpi(0, 0));
    int adone = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, adone, "buf_append_done", 2, CC_EQ, 0);
    code_emit(c, a_strb(0, 21, 0));
    code_emit(c, a_addi(21, 21, 1));
    code_emit(c, a_addi(22, 22, 1));
    code_emit(c, a_addi(23, 23, 1));
    int aback = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, aback, "buf_append_loop", 0, 0, 0);
    code_label(c, "buf_append_done");
    code_emit(c, a_ret());

    /* printf_wapp: x0 = converted string; x26 = 1 for non-numeric (%s/%c),
     * x27 = field width, x28 = flags (bit0 zero pad, bit1 left align).
     * Right-pads with the pad char when width exceeds the conversion; the
     * left flag pads with spaces after the conversion instead. */
    code_label(c, "printf_wapp");
    /* internal bl calls clobber LR; keep the caller's return address */
    code_emit(c, a_mov(11, 30));
    code_emit(c, a_cmpi(27, 0));
    int wa_plain = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, wa_plain, "wapp_plain", 2, CC_EQ, 0);
    code_emit(c, a_mov(23, 0));
    comp_load_imm(c, 14, 0);
    code_label(c, "wapp_count");
    code_emit(c, a_ldrb(15, 23, 0));
    code_emit(c, a_cmpi(15, 0));
    int wc_done = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, wc_done, "wapp_count_done", 2, CC_EQ, 0);
    code_emit(c, a_addi(23, 23, 1));
    code_emit(c, a_addi(14, 14, 1));
    int wc_back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wc_back, "wapp_count", 0, 0, 0);
    code_label(c, "wapp_count_done");
    code_emit(c, a_andi_m12(15, 28, 2));
    code_emit(c, a_cmpi(15, 0));
    int wa_left = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, wa_left, "wapp_left", 2, CC_NE, 0);
    code_emit(c, a_sub(15, 27, 14));
    code_emit(c, a_cmpi(15, 0));
    int wa_nopad = c->nwords;
    code_emit(c, a_bcond(CC_LE, 0));
    code_patch(c, wa_nopad, "wapp_plain", 2, CC_LE, 0);
    code_emit(c, a_mov(25, 0));
    comp_load_imm(c, 3, 32);
    code_emit(c, a_cmpi(28, 1));
    int wa_z = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, wa_z, "wapp_have", 2, CC_NE, 0);
    code_emit(c, a_cmpi(26, 0));
    int wa_sp = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, wa_sp, "wapp_have", 2, CC_NE, 0);
    comp_load_imm(c, 3, 48);
    code_label(c, "wapp_have");
    /* zero-pad is sign-aware: a leading '-' or '+' is emitted before the
     * zeros ("%05d", -42 -> "-0042") and the append cursor skips it. */
    code_emit(c, a_cmpi(3, 48));
    int wsign_chk = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, wsign_chk, "wapp_pad_loop", 2, CC_NE, 0);
    code_emit(c, a_ldrb(0, 25, 0));
    code_emit(c, a_cmpi(0, 45));
    int wsign_min = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, wsign_min, "wapp_sign", 2, CC_EQ, 0);
    code_emit(c, a_cmpi(0, 43));
    int wsign_pl = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, wsign_pl, "wapp_sign", 2, CC_EQ, 0);
    int wsign_no = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wsign_no, "wapp_pad_loop", 0, 0, 0);
    code_label(c, "wapp_sign");
    code_emit(c, a_ldrb(0, 25, 0));
    int wsign_pc = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, wsign_pc, "buf_putc", 1, 0, 0);
    code_emit(c, a_addi(25, 25, 1));
    int wsign_b = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wsign_b, "wapp_pad_loop", 0, 0, 0);
    int wpl = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wpl, "wapp_pad_loop", 0, 0, 0);
    code_label(c, "wapp_pad_loop");
    code_emit(c, a_cmpi(15, 0));
    int wp_done = c->nwords;
    code_emit(c, a_bcond(CC_LE, 0));
    code_patch(c, wp_done, "wapp_pad_done", 2, CC_LE, 0);
    code_emit(c, a_mov(0, 3));
    int wpc = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, wpc, "buf_putc", 1, 0, 0);
    code_emit(c, a_subi(15, 15, 1));
    int wp_back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wp_back, "wapp_pad_loop", 0, 0, 0);
    code_label(c, "wapp_pad_done");
    code_emit(c, a_mov(0, 25));
    code_label(c, "wapp_plain");
    int waa = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, waa, "buf_append", 1, 0, 0);
    int wad = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wad, "wapp_done", 0, 0, 0);
    code_label(c, "wapp_left");
    code_emit(c, a_mov(25, 0));
    int wal = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, wal, "buf_append", 1, 0, 0);
    code_emit(c, a_sub(15, 27, 14));
    code_label(c, "wapp_lpad_loop");
    code_emit(c, a_cmpi(15, 0));
    int wl_done = c->nwords;
    code_emit(c, a_bcond(CC_LE, 0));
    code_patch(c, wl_done, "wapp_done", 2, CC_LE, 0);
    comp_load_imm(c, 0, 32);
    int wlpc = c->nwords;
    code_emit(c, a_bl(0));
    code_patch(c, wlpc, "buf_putc", 1, 0, 0);
    code_emit(c, a_subi(15, 15, 1));
    int wl_back = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, wl_back, "wapp_lpad_loop", 0, 0, 0);
    code_label(c, "wapp_done");
    code_emit(c, a_mov(30, 11));
    code_emit(c, a_ret());

    /* itoa: x0 = int -> x0 = string */
    code_label(c, "itoa");
    code_emit(c, a_mov(23, 0)); /* value */
    int itoa_buf_idx = c->nwords;
    code_emit(c, a_adrp(24, 0));
    code_emit(c, a_addi(24, 24, 0));
    code_patch(c, itoa_buf_idx, "itoa_buf", 3, 0, 24);
    code_emit(c, a_addi(24, 24, 31)); /* end of buffer */
    comp_load_imm(c, 25, 0); /* is_negative = 0 */
    code_emit(c, a_cmpi(23, 0));
    int neg_idx = c->nwords;
    code_emit(c, a_bcond(CC_GE, 0));
    code_patch(c, neg_idx, "itoa_pos", 2, CC_GE, 0);
    code_emit(c, a_neg(23, 23));
    comp_load_imm(c, 25, 1); /* is_negative = 1 */
    code_label(c, "itoa_pos");
    code_emit(c, a_strb(31, 24, 0)); /* null terminator */
    code_emit(c, a_subi(24, 24, 1));
    code_label(c, "itoa_loop");
    comp_load_imm(c, 1, 10);
    code_emit(c, a_udiv(2, 23, 1));
    code_emit(c, a_mul(3, 2, 1));
    code_emit(c, a_sub(3, 23, 3)); /* digit */
    code_emit(c, a_addi(3, 3, 48)); /* 48 */
    code_emit(c, a_strb(3, 24, 0));
    code_emit(c, a_subi(24, 24, 1));
    code_emit(c, a_mov(23, 2));
    code_emit(c, a_cmpi(23, 0));
    int iloop = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, iloop, "itoa_loop", 2, CC_NE, 0);
    /* negative sign */
    code_emit(c, a_cmpi(25, 0));
    int isign = c->nwords;
    code_emit(c, a_bcond(CC_EQ, 0));
    code_patch(c, isign, "itoa_nosign", 2, CC_EQ, 0);
    comp_load_imm(c, 3, 45); /* 45 */
    code_emit(c, a_strb(3, 24, 0));
    code_emit(c, a_subi(24, 24, 1));
    code_label(c, "itoa_nosign");
    code_emit(c, a_addi(0, 24, 1)); /* return pointer to first digit */
    code_emit(c, a_ret());

    /* itox: x0 = int -> x0 = hex string */
    code_label(c, "itox");
    code_emit(c, a_mov(23, 0));
    int itox_buf_idx = c->nwords;
    code_emit(c, a_adrp(24, 0));
    code_emit(c, a_addi(24, 24, 0));
    code_patch(c, itox_buf_idx, "itoa_buf", 3, 0, 24);
    code_emit(c, a_addi(24, 24, 31));
    code_emit(c, a_strb(31, 24, 0));
    code_emit(c, a_subi(24, 24, 1));
    code_label(c, "itox_loop");
    comp_load_imm(c, 1, 16);
    code_emit(c, a_udiv(2, 23, 1));
    code_emit(c, a_mul(3, 2, 1));
    code_emit(c, a_sub(3, 23, 3));
    code_emit(c, a_cmpi(3, 10));
    int hex_ge = c->nwords;
    code_emit(c, a_bcond(CC_GE, 0));
    code_patch(c, hex_ge, "itox_letter", 2, CC_GE, 0);
    code_emit(c, a_addi(3, 3, 48));
    int hex_done = c->nwords;
    code_emit(c, a_b(0));
    code_patch(c, hex_done, "itox_store", 0, 0, 0);
    code_label(c, "itox_letter");
    code_emit(c, a_addi(3, 3, 87)); /* 97-10 */
    code_label(c, "itox_store");
    code_emit(c, a_strb(3, 24, 0));
    code_emit(c, a_subi(24, 24, 1));
    code_emit(c, a_mov(23, 2));
    code_emit(c, a_cmpi(23, 0));
    int xloop = c->nwords;
    code_emit(c, a_bcond(CC_NE, 0));
    code_patch(c, xloop, "itox_loop", 2, CC_NE, 0);
    code_emit(c, a_addi(0, 24, 1));
    code_emit(c, a_ret());

    /* ftoa: x0 = double bits -> x0 = string.
     * Implemented in C in the runtime prelude (see dc_runtime_prelude); the
     * `bl ftoa` in the %f handler above resolves to that definition. */

    /* buf_flush: write buffer to stdout */
    code_label(c, "buf_flush");
    comp_load_imm(c, 0, 1); /* fd = stdout */
    code_emit(c, a_sub(1, 21, 22)); /* x1 = buffer start = end - len */
    code_emit(c, a_mov(2, 22));     /* x2 = length */
    comp_load_imm(c, 8, SC_WRITE);
    code_emit(c, a_svc());
    code_emit(c, a_ret());
}

/* ------ .ros writer ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 * Emits a flat binary blob: all machine-code words followed by all data
 * words. The data section is page-aligned (relative to the blob base) so the
 * engine can mprotect code RX and data RW separately. No ELF, no headers, no
 * legacy file format. The blob is the .ros binary payload. */
static void write_ros(long out, Code* code, int data_start) {
    /* code words */
    { int i = 0; while (i < data_start) { buf_word(out, code->words[i]); i++; } }
    /* pad data to a page boundary (4096 bytes) so code/data split cleanly */
    while ((get_int(out + 8) % 4096) != 0) buf_byte(out, 0);
    /* data words */
    { int i = data_start; while (i < code->nwords) { buf_word(out, code->words[i]); i++; } }
}

/* ------ ELF writer helpers --------------------------------------------------------------------------------------------------------------------------------------------------------- */
static void buf_le16(long b, int v) {
    buf_byte(b, v % 256);
    buf_byte(b, (v / 256) % 256);
}
static void buf_le32(long b, int v) {
    buf_byte(b, v % 256);
    buf_byte(b, (v / 256) % 256);
    buf_byte(b, (v / 65536) % 256);
    buf_byte(b, (v / 16777216) % 256);
}
static void buf_le64(long b, int lo, int hi) {
    buf_le32(b, lo);
    buf_le32(b, hi);
}

#define ELF_LOAD_ADDR 65536   /* 0x10000 — Gryz PIE base, Android linker64 compatible */
#define ROS_LOAD_ADDR 268435456  /* 0x10000000 — .ros blob load base, clear of the host image */
#define ROS_MAGIC 5459794        /* "ROS" cache blob magic */
#define ROS_FORMAT_VER 2         /* 32-byte header: magic,nwords,main_off,data_off,src_size,mtime_lo,mtime_hi,ver */
#define ROS_MAX_WORDS 8388608    /* 32 MB blob cap */
/* Code section starts at file offset 4096 (one full page), maps to ELF_LOAD_ADDR.
 * This makes code_vaddr=ELF_LOAD_ADDR match what compile_program resolved to. */
#define ELF_HDR_SIZE  4096

/* ------ write_elf: emit a PIE AArch64 ELF (ET_DYN, Gryz/linker64 compatible) --- */
static void write_elf(long out, Code* code, int data_start, int main_off) {
    int code_bytes = data_start * 4;
    int data_bytes = (code->nwords - data_start) * 4;
    int data_page_off = ((code_bytes + 4095) / 4096) * 4096;
    int entry_vaddr = ELF_LOAD_ADDR;

    /* Tail layout: .dynamic(96) .dynsym(24) .dynstr(45) .gnu.hash(44) .shstrtab(45) pad shdrs(7*64) */
    int tail_base = ELF_HDR_SIZE + code_bytes + data_page_off + data_bytes;
    int dyn_off = tail_base;
    int dynsym_off = dyn_off + 96;
    int dynstr_off = dynsym_off + 24;
    int gnu_hash_off = dynstr_off + 52;   /* .dynstr is 52 bytes */
    int shstrtab_off = gnu_hash_off + 44;
    int shoff = shstrtab_off + 52;        /* .shstrtab is 52 bytes */
    shoff = (shoff + 7) & ~7;
    int shnum = 7;
    int total = shoff + shnum * 64;
    /* Reserve the whole image before writing any of it: the append helpers
     * grow in doublings, which under-reserves a final size that sits between
     * two of them (a 16.78 MB ELF overflowed a 16 MB buffer). */
    buf_reserve(out, total);

    /* .shstrtab = "\0.text\0.dynamic\0.dynsym\0.dynstr\0.gnu.hash\0.shstrtab\0" = 52 bytes */
    /* name offsets: .text=1 .dynamic=7 .dynsym=16 .dynstr=24 .gnu.hash=32 .shstrtab=42 */

    /* === ELF64 header (64 bytes) === */
    buf_byte(out, 127); buf_byte(out, 69); buf_byte(out, 76); buf_byte(out, 70);
    buf_byte(out, 2);    /* 64-bit */
    buf_byte(out, 1);    /* little-endian */
    buf_byte(out, 1);    /* ELF version */
    buf_byte(out, 0);    /* SYSV ABI */
    { int i = 0; while (i < 8) { buf_byte(out, 0); i++; } }
    /* ET_EXEC, not ET_DYN.  This ELF carries no PT_INTERP, so nothing ever
     * applies relocations: under a PIE load bias every ABSOLUTE address stored
     * in .data -- `char*g="hi";`, `struct N a={1,&b};`, function-pointer
     * initialisers -- pointed at the wrong place, so reading through such a
     * pointer segfaulted.  A fixed base makes those stored addresses correct.
     * (Verified against gcc on-device; the code side is unaffected because it
     * addresses everything PC-relatively with adrp/add.) */
    buf_le16(out, 2);          /* e_type: ET_EXEC */
    buf_le16(out, 183);        /* e_machine: EM_AARCH64 */
    buf_le32(out, 1);          /* e_version */
    buf_le64(out, entry_vaddr + (main_off * 4), 0); /* e_entry */
    buf_le64(out, 64, 0);      /* e_phoff */
    buf_le64(out, shoff, 0);   /* e_shoff */
    buf_le32(out, 0);          /* e_flags */
    buf_le16(out, 64);         /* e_ehsize */
    buf_le16(out, 56);         /* e_phentsize */
    buf_le16(out, 5);          /* e_phnum: PHDR + LOAD(code) + LOAD(data) + DYNAMIC + GNU_STACK */
    buf_le16(out, 64);         /* e_shentsize */
    buf_le16(out, shnum);      /* e_shnum */
    buf_le16(out, 6);          /* e_shstrndx: section 6 = .shstrtab */

    /* === PHDR[0]: PT_PHDR === */
    buf_le32(out, 6);          /* p_type: PT_PHDR */
    buf_le32(out, 4);          /* p_flags: PF_R */
    buf_le64(out, 64, 0);      /* p_offset */
    buf_le64(out, ELF_LOAD_ADDR + 64, 0);
    buf_le64(out, ELF_LOAD_ADDR + 64, 0);
    buf_le64(out, 280, 0);     /* 5 * 56 */
    buf_le64(out, 280, 0);
    buf_le64(out, 8, 0);

    /* === PHDR[1]: PT_LOAD (code+headers, RX) === */
    buf_le32(out, 1);
    buf_le32(out, 5);          /* PF_R|PF_X (no write — W^X for Android) */
    buf_le64(out, 0, 0);
    buf_le64(out, ELF_LOAD_ADDR - ELF_HDR_SIZE, 0);
    buf_le64(out, ELF_LOAD_ADDR - ELF_HDR_SIZE, 0);
    buf_le64(out, ELF_HDR_SIZE + data_page_off, 0);  /* covers headers + code */
    buf_le64(out, ELF_HDR_SIZE + data_page_off, 0);
    buf_le64(out, 4096, 0);

    /* === PHDR[2]: PT_LOAD (data+tail, RW) === */
    buf_le32(out, 1);
    buf_le32(out, 6);          /* PF_R|PF_W */
    buf_le64(out, ELF_HDR_SIZE + data_page_off, 0);  /* p_offset: data starts here */
    /* p_vaddr = p_offset + (ELF_LOAD_ADDR - ELF_HDR_SIZE); subtracting ELF_HDR_SIZE
     * a second time made this segment overlap the last page of the code segment,
     * so the kernel mapped zeros over the tail of the code image. */
    buf_le64(out, ELF_LOAD_ADDR + data_page_off, 0);
    buf_le64(out, ELF_LOAD_ADDR + data_page_off, 0);
    buf_le64(out, total - (ELF_HDR_SIZE + data_page_off), 0);  /* data + tail */
    buf_le64(out, total - (ELF_HDR_SIZE + data_page_off), 0);
    buf_le64(out, 4096, 0);

    /* === PHDR[3]: PT_DYNAMIC === */
    buf_le32(out, 2);
    buf_le32(out, 6);          /* PF_R|PF_W */
    buf_le64(out, dyn_off, 0);
    buf_le64(out, ELF_LOAD_ADDR + dyn_off - ELF_HDR_SIZE, 0);
    buf_le64(out, ELF_LOAD_ADDR + dyn_off - ELF_HDR_SIZE, 0);
    buf_le64(out, 96, 0);
    buf_le64(out, 96, 0);
    buf_le64(out, 8, 0);

    /* === PHDR[4]: PT_GNU_STACK === */
    buf_le32(out, 0x6474e551);
    buf_le32(out, 6);
    buf_le64(out, 0, 0);
    buf_le64(out, 0, 0);
    buf_le64(out, 0, 0);
    buf_le64(out, 0, 0);
    buf_le64(out, 0, 0);
    buf_le64(out, 16, 0);

    /* pad to ELF_HDR_SIZE */
    while (get_int(out + 8) < ELF_HDR_SIZE) buf_byte(out, 0);

    /* === Code words === */
    { int i = 0; while (i < data_start) { buf_word(out, code->words[i]); i++; } }

    /* pad to data page */
    while (get_int(out + 8) < ELF_HDR_SIZE + data_page_off) buf_byte(out, 0);

    /* === Data words === */
    { int i = data_start; while (i < code->nwords) { buf_word(out, code->words[i]); i++; } }

    /* === .dynamic (6 entries * 16 = 96 bytes) === */
    buf_le64(out, 5, 0);       /* DT_STRTAB */
    buf_le64(out, ELF_LOAD_ADDR + dynstr_off - ELF_HDR_SIZE, 0);
    buf_le64(out, 6, 0);       /* DT_SYMTAB */
    buf_le64(out, ELF_LOAD_ADDR + dynsym_off - ELF_HDR_SIZE, 0);
    buf_le64(out, 8, 0);       /* DT_STRSZ */
    buf_le64(out, 52, 0);
    buf_le64(out, 11, 0);      /* DT_SYMENT */
    buf_le64(out, 24, 0);
    buf_le64(out, 0x6ffffef5, 0); /* DT_GNU_HASH */
    buf_le64(out, ELF_LOAD_ADDR + gnu_hash_off - ELF_HDR_SIZE, 0);
    buf_le64(out, 0, 0);       /* DT_NULL */
    buf_le64(out, 0, 0);

    /* === .dynsym (1 null entry = 24 bytes) === */
    { int i = 0; while (i < 24) { buf_byte(out, 0); i++; } }

    /* === .dynstr = "\0.text\0.dynamic\0.dynsym\0.dynstr\0.gnu.hash\0.shstrtab\0" = 52 bytes === */
    buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 't'); buf_byte(out, 'e'); buf_byte(out, 'x'); buf_byte(out, 't'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'd'); buf_byte(out, 'y'); buf_byte(out, 'n'); buf_byte(out, 'a'); buf_byte(out, 'm'); buf_byte(out, 'i'); buf_byte(out, 'c'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'd'); buf_byte(out, 'y'); buf_byte(out, 'n'); buf_byte(out, 's'); buf_byte(out, 'y'); buf_byte(out, 'm'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'd'); buf_byte(out, 'y'); buf_byte(out, 'n'); buf_byte(out, 's'); buf_byte(out, 't'); buf_byte(out, 'r'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'g'); buf_byte(out, 'n'); buf_byte(out, 'u'); buf_byte(out, '.'); buf_byte(out, 'h'); buf_byte(out, 'a'); buf_byte(out, 's'); buf_byte(out, 'h'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 's'); buf_byte(out, 'h'); buf_byte(out, 's'); buf_byte(out, 't'); buf_byte(out, 'r'); buf_byte(out, 't'); buf_byte(out, 'a'); buf_byte(out, 'b'); buf_byte(out, 0);

    /* === .gnu.hash (28 bytes for 32-bit bloom, but we need 64-bit = 44 bytes) === */
    buf_le32(out, 1);          /* nbuckets */
    buf_le32(out, 1);          /* symoffset */
    buf_le32(out, 1);          /* bloom_size (1 word) */
    buf_le32(out, 26);         /* bloom_shift */
    buf_le64(out, 0, 0);       /* bloom[0] (64-bit) */
    buf_le32(out, 0);          /* bucket[0] */
    buf_le32(out, 0);          /* chain[0] */
    /* 4+4+4+4+8+4+4 = 32 bytes. Need 44 for 64-bit bloom. Pad 12 more. */
    /* Actually: 4*4=16 header + 8 bloom + 4 bucket + 4 chain = 32. For 64-bit: 4*4=16 + 8 bloom + 4 bucket + 4 chain = 32 */
    /* Hmm, gnu hash for 64-bit: bloom words are 8 bytes each. 1 bloom = 8 bytes. Total = 16+8+4+4 = 32 */
    /* But we allocated 44 bytes above. Let me pad to 44. */
    { int i = 32; while (i < 44) { buf_byte(out, 0); i++; } }

    /* === .shstrtab (same 52 bytes as .dynstr) === */
    buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 't'); buf_byte(out, 'e'); buf_byte(out, 'x'); buf_byte(out, 't'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'd'); buf_byte(out, 'y'); buf_byte(out, 'n'); buf_byte(out, 'a'); buf_byte(out, 'm'); buf_byte(out, 'i'); buf_byte(out, 'c'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'd'); buf_byte(out, 'y'); buf_byte(out, 'n'); buf_byte(out, 's'); buf_byte(out, 'y'); buf_byte(out, 'm'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'd'); buf_byte(out, 'y'); buf_byte(out, 'n'); buf_byte(out, 's'); buf_byte(out, 't'); buf_byte(out, 'r'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 'g'); buf_byte(out, 'n'); buf_byte(out, 'u'); buf_byte(out, '.'); buf_byte(out, 'h'); buf_byte(out, 'a'); buf_byte(out, 's'); buf_byte(out, 'h'); buf_byte(out, 0);
    buf_byte(out, '.'); buf_byte(out, 's'); buf_byte(out, 'h'); buf_byte(out, 's'); buf_byte(out, 't'); buf_byte(out, 'r'); buf_byte(out, 't'); buf_byte(out, 'a'); buf_byte(out, 'b'); buf_byte(out, 0);

    /* pad to shoff */
    while (get_int(out + 8) < shoff) buf_byte(out, 0);

    /* === Section headers (7 * 64 = 448 bytes) === */
    /* [0] SHT_NULL */
    { int i = 0; while (i < 64) { buf_byte(out, 0); i++; } }

    /* [1] .text (name=1) */
    buf_le32(out, 1);          /* sh_name */
    buf_le32(out, 1);          /* SHT_PROGBITS */
    buf_le64(out, 6, 0);       /* SHF_ALLOC|SHF_EXECINSTR */
    buf_le64(out, ELF_LOAD_ADDR, 0);
    buf_le64(out, ELF_HDR_SIZE, 0);
    buf_le64(out, code_bytes, 0);
    buf_le32(out, 0);
    buf_le32(out, 0);
    buf_le64(out, 16, 0);
    buf_le64(out, 0, 0);

    /* [2] .dynamic (name=7) */
    buf_le32(out, 7);
    buf_le32(out, 6);          /* SHT_DYNAMIC */
    buf_le64(out, 3, 0);       /* SHF_ALLOC|SHF_WRITE */
    buf_le64(out, ELF_LOAD_ADDR + dyn_off - ELF_HDR_SIZE, 0);
    buf_le64(out, dyn_off, 0);
    buf_le64(out, 96, 0);
    buf_le32(out, 4);          /* sh_link -> .dynstr */
    buf_le32(out, 0);
    buf_le64(out, 8, 0);
    buf_le64(out, 16, 0);

    /* [3] .dynsym (name=16) */
    buf_le32(out, 16);
    buf_le32(out, 11);         /* SHT_DYNSYM */
    buf_le64(out, 2, 0);       /* SHF_ALLOC */
    buf_le64(out, ELF_LOAD_ADDR + dynsym_off - ELF_HDR_SIZE, 0);
    buf_le64(out, dynsym_off, 0);
    buf_le64(out, 24, 0);
    buf_le32(out, 4);          /* sh_link -> .dynstr */
    buf_le32(out, 1);
    buf_le64(out, 8, 0);
    buf_le64(out, 24, 0);

    /* [4] .dynstr (name=24) */
    buf_le32(out, 24);
    buf_le32(out, 3);          /* SHT_STRTAB */
    buf_le64(out, 2, 0);       /* SHF_ALLOC */
    buf_le64(out, ELF_LOAD_ADDR + dynstr_off - ELF_HDR_SIZE, 0);
    buf_le64(out, dynstr_off, 0);
    buf_le64(out, 52, 0);      /* .dynstr size */
    buf_le32(out, 0);
    buf_le32(out, 0);
    buf_le64(out, 1, 0);
    buf_le64(out, 0, 0);

    /* [5] .gnu.hash (name=32) */
    buf_le32(out, 32);
    buf_le32(out, 0x6ffffff6); /* SHT_GNU_HASH */
    buf_le64(out, 2, 0);
    buf_le64(out, ELF_LOAD_ADDR + gnu_hash_off - ELF_HDR_SIZE, 0);
    buf_le64(out, gnu_hash_off, 0);
    buf_le64(out, 44, 0);
    buf_le32(out, 3);          /* sh_link -> .dynsym */
    buf_le32(out, 1);
    buf_le64(out, 8, 0);
    buf_le64(out, 0, 0);

    /* [6] .shstrtab (name=42) */
    buf_le32(out, 42);
    buf_le32(out, 3);          /* SHT_STRTAB */
    buf_le64(out, 0, 0);
    buf_le64(out, 0, 0);
    buf_le64(out, shstrtab_off, 0);
    buf_le64(out, 52, 0);      /* .shstrtab size */
    buf_le32(out, 0);
    buf_le32(out, 0);
    buf_le64(out, 1, 0);
    buf_le64(out, 0, 0);
}

/* ------ File-scope initializer parsing -----------------------------------------------------
 * `static T g = {...}` / `= const` / `= "str"` at file scope: values are laid
 * out against the declared type (struct fields by offset, array elements by
 * stride) into gvar_init_pool; the data emitter overlays the zero-fill.
 * Unsupported forms fail loudly instead of silently dropping the initializer. */
static void dc_gi_begin(int gv) {
    int n = gvar_sizes[gv];
    if (n > 1048576) n = 1048576; /* positional init support: first 1MB of a global */
    if (gvar_init_used + n > 1048576) {
        d_puts("drygon: initializer pool overflow\n");
        sys_exit(1);
    }
    gvar_init_off[gv] = gvar_init_used;
    gvar_init_used = gvar_init_used + n;
    gvar_init_len[gv] = 0;
}

static void dc_gi_store(int gv, int off, long v, int width) {
    /* An `unsigned` 4-byte global holding a negative folded value (`0u - 1u`)
     * must land as the unsigned pattern, not sign-extended. */
    if (width == 4 && v < 0 && gv >= 0 && gv < 1024 && gvar_uns[gv]) {
        v = (long)(unsigned long)(unsigned int)v;
    }
    if (gvar_init_off[gv] + off + width > 1048576) {
        d_puts("drygon: initializer exceeds pool range\n");
        sys_exit(1);
    }
    int k = 0;
    while (k < width) {
        long b = (v >> (k * 8)) & 0xFF;
        gvar_init_pool[gvar_init_off[gv] + off + k] = (char)b;
        k = k + 1;
    }
    if (off + width > gvar_init_len[gv]) gvar_init_len[gv] = off + width;
}

/* consume one initializer item (balanced braces or a scalar run) */
static void dc_gi_skip_item(Compiler* c, Lexer* l) {
    int depth = 0;
    while (!lex_is(l, T_EOF)) {
        if (lex_is(l, T_LBRACE)) {
            depth = depth + 1;
        } else if (lex_is(l, T_RBRACE)) {
            if (depth == 0) return;
            depth = depth - 1;
        } else if (depth == 0 && lex_is(l, T_COMMA)) {
            return;
        }
        lex_advance(l);
    }
}

static void dc_gi_scalar(Compiler* c, Lexer* l, int gv, int off, int width) {
    if (lex_is(l, T_STR)) {
        /* pointer field initialized by a string literal: record the string;
         * the data word pair is backfilled with its address after resolve */
        if (width != 8) {
            d_puts("drygon: string initializer in non-pointer field\n");
            sys_exit(1);
        }
        int sl = 0;
        char* sbuf = lex_cat_str(l, &sl);
        if (!sbuf) { d_puts("drygon: out of memory collecting string initializer\n"); sys_exit(1); }
        int id = intern_string(sbuf, sl);
        if (id < 0 || ginit_str_n >= 8192) {
            d_puts("drygon: too many initializer strings\n");
            sys_exit(1);
        }
        /* The ELF is ET_DYN and loads at a non-zero base, so an ABSOLUTE address
         * stored in a data word is wrong at run time (it was only ever right for
         * the .ros blob, whose vaddr the compiler fixes).  Record the string id
         * against the global instead, and let the READ of that global build the
         * address PC-relatively with adrp/add -- the same mechanism a local
         * `char* p = "x"` uses, which is why that form always worked. */
        if (gv >= 0 && gv < 1024) gvar_addr_str[gv] = id;
        ginit_str_gv[ginit_str_n] = gv;
        ginit_str_off[ginit_str_n] = off;
        ginit_str_id[ginit_str_n] = id;
        ginit_str_n = ginit_str_n + 1;
        return;
    }
    long v = 0;
    int neg = 0;
    if (lex_is(l, T_MINUS)) { neg = 1; lex_advance(l); }
    /* `&other_global` / `&global[0]`: an address constant in a pointer member
     * (`struct N a = {1, &b};`).  The address is not known until the data
     * section is laid out, so record it like a string initializer and let the
     * resolve pass backfill the word. */
    if (lex_is(l, T_AMP)) {
        Lexer la = *l;
        lex_advance(&la);
        if (lex_is(&la, T_IDENT)) {
            char an[64];
            d_strncpy(an, lex_text(&la), 63); an[63] = 0;
            lex_advance(&la);
            /* allow `&name` and `&name[0]` (the address is the same) */
            int okamp = 1;
            if (lex_is(&la, T_LBRACKET)) {
                lex_advance(&la);
                if (!lex_is(&la, T_NUM) || lex_num(&la) != 0) okamp = 0;
                else { lex_advance(&la); if (lex_is(&la, T_RBRACKET)) lex_advance(&la); else okamp = 0; }
            }
            if (okamp && width == 8) {
                lex_advance(l);            /* '&' */
                lex_advance(l);            /* name */
                while (lex_is(l, T_LBRACKET)) lex_advance(l);
                /* Do NOT intern the name as a string literal: that made
                 * `str_<id>` resolve to a string COPY of the name ("b") and the
                 * pointer member pointed at text, not at the global.  Record the
                 * name itself and let the resolve pass build its gvar_label. */
                if (ginit_str_n < 8192) {
                    int an_i = 0;
                    while (an[an_i] && an_i < 63) { ginit_amp_buf[ginit_str_n * 64 + an_i] = an[an_i]; an_i = an_i + 1; }
                    ginit_amp_buf[ginit_str_n * 64 + an_i] = 0;
                    ginit_amp[ginit_str_n] = 1;
                    ginit_str_gv[ginit_str_n] = gv;
                    ginit_str_off[ginit_str_n] = off;
                    ginit_str_id[ginit_str_n] = 0;
                    ginit_str_n = ginit_str_n + 1;
                    return;
                }
            }
        }
    }
    if (lex_is(l, T_NUM)) {
        /* Float literal (`static double g[3] = {1.5,...}`, `double g = 0.5;`):
         * the raw IEEE-754 bits live in the token's 8-byte value slot, while
         * lex_num's integer view of that slot is only the value's low half
         * (`1.5` stored as 0x40000000, i.e. ~2e-314).  A `-` before the
         * literal flips the sign bit. */
        /* NOTE: `lex_text(l)[0]` (subscript straight onto a call result) is
         * miscompiled by older drygon builds (extra deref), which crashed
         * every freshly built compiler while it parsed its own prelude.
         * Keep the result in a local; the codegen for call-result chains is
         * fixed separately (fn_ret_ptr/fn_ret_pelem). */
        char* fltx = lex_text(l);
        if (width >= 8 && fltx[0] == 70) {
            void* fvp = (char*)lex_cur(l) + 2056;
            long fb = *(long*)fvp;
            if (neg) fb = fb ^ 0x8000000000000000;
            dc_gi_store(gv, off, fb, 8);
            lex_advance(l);
            return;
        }
        v = lex_num(l);
        lex_advance(l);
        if (neg) { v = 0 - v; neg = 0; }
        /* Fold one further `+ N` / `- N` term: `unsigned u = 0u - 1u;` has to
         * become -1 rather than stopping at the first literal, or the store
         * leaves 0 and the whole initializer silently means something else. */
        if (lex_is(l, T_MINUS) || lex_is(l, T_PLUS)) {
            int op2 = lex_kind(l);
            lex_advance(l);
            if (lex_is(l, T_NUM)) {
                long r2 = lex_num(l);
                lex_advance(l);
                if (op2 == T_MINUS) v = v - r2;
                else v = v + r2;
            }
        }
        dc_gi_store(gv, off, v, width);
        return;
    } else if (lex_is(l, T_IDENT)) {
        if (d_strcmp(lex_text(l), "NULL") == 0) {
            v = 0;
            lex_advance(l);
        } else {
            /* object-like macro / enum constant: resolve via the macro table */
            int mi5 = 0;
            int mv = -1;
            while (mi5 < ndefs) {
                if (d_strcmp(def_names_buf + mi5 * 64, lex_text(l)) == 0) mv = def_values[mi5];
                mi5 = mi5 + 1;
            }
            if (mv >= 0) {
                v = mv;
                lex_advance(l);
                dc_gi_store(gv, off, v, width);
                return;
            }
            /* A bare function name (`int (*o[1])(int,int) = {add};`) or an
             * address constant (`&b`) stored in a global pointer/array element
             * is an ADDRESS: it is not known until the data section is laid
             * out, so record it like a string initializer and let the resolve
             * pass backfill the word.  Recording the absolute value here put a
             * link-time address into .data, which the ET_EXEC layout makes
             * correct only for functions the label pass already knows. */
            {
                char iname[64];
                d_strncpy(iname, lex_text(l), 63); iname[63] = 0;
                /* Any identifier initialising an 8-byte global object is a
                 * SYMBOL reference (function name, or `&`-less object used as an
                 * address).  Its address is not known here -- function labels
                 * are not even assigned yet at file-scope parse time -- so
                 * record the name and let the resolve pass, which runs after all
                 * labels exist, backfill the word. */
                if (width == 8 && ginit_str_n < 8192) {
                    int ai = 0;
                    while (iname[ai] && ai < 63) { ginit_amp_buf[ginit_str_n * 64 + ai] = iname[ai]; ai = ai + 1; }
                    ginit_amp_buf[ginit_str_n * 64 + ai] = 0;
                    ginit_amp[ginit_str_n] = 1;
                    ginit_str_gv[ginit_str_n] = gv;
                    ginit_str_off[ginit_str_n] = off;
                    ginit_str_id[ginit_str_n] = 0;
                    ginit_str_n = ginit_str_n + 1;
                    lex_advance(l);
                    return;
                }
            }
            d_puts("drygon: unsupported initializer constant (only integers and strings) [ident=");
            d_puts(lex_text(l));
            d_puts("]\n");
            sys_exit(1);
        }
    } else {
        d_puts("drygon: unsupported initializer constant (only integers and strings) [tok=");
        d_puts(lex_text(l));
        d_puts(" w=");
        d_putdec(width);
        d_puts(" k=");
        d_putdec(lex_kind(l));
        d_puts(" line=");
        d_putdec(lex_line(l));
        d_puts("]\n");
        sys_exit(1);
    }
    if (neg) v = 0 - v;
    dc_gi_store(gv, off, v, width);
}

/* array (or char array) initialized by a string literal: bytes fill the array */
static void dc_gi_strbytes(Compiler* c, Lexer* l, int gv, int off, int cap) {
    char sbuf[512];
    d_strncpy(sbuf, lex_text(l), 500);
    sbuf[500] = 0;
    int sl = d_strlen(sbuf);
    lex_advance(l);
    while (lex_is(l, T_STR) && sl < 500) {
        char* tt = lex_text(l);
        int k2 = 0;
        while (tt[k2] && sl < 500) { sbuf[sl] = tt[k2]; sl = sl + 1; k2 = k2 + 1; }
        sbuf[sl] = 0;
        lex_advance(l);
    }
    if (sl + 1 > cap) sl = cap - 1; /* keep the NUL inside the array */
    int k = 0;
    while (k <= sl) {
        dc_gi_store(gv, off + k, sbuf[k], 1);
        k = k + 1;
    }
}

/* brace list against an array layout: elements at stride esz */
static void dc_gi_array(Compiler* c, Lexer* l, int gv, int off, int esz, int slot) {
    lex_advance(l); /* { */
    int k = 0;
    while (!lex_is(l, T_EOF) && !lex_is(l, T_RBRACE)) {
        int eoff = off + k * esz;
        if (lex_is(l, T_LBRACE)) {
            if (slot >= 0) {
                dc_gi_struct(c, l, gv, eoff, slot);
            } else {
                d_puts("drygon: nested initializer braces on scalar array\n");
                sys_exit(1);
            }
        } else {
            dc_gi_scalar(c, l, gv, eoff, esz >= 8 ? 8 : esz);
        }
        k = k + 1;
        if (lex_is(l, T_COMMA)) lex_advance(l);
    }
    if (lex_is(l, T_RBRACE)) lex_advance(l);
}

/* brace list against a struct/union layout: values map to fields in order */
static void dc_gi_struct(Compiler* c, Lexer* l, int gv, int off, int slot) {
    int is_union = (c->su_kind[slot] == 2);
    lex_advance(l); /* { */
    int fj = 0;
    int warned = 0;
    while (!lex_is(l, T_EOF) && !lex_is(l, T_RBRACE)) {
        int handled = 0;
        if (!is_union || fj == 0) {
            if (fj < c->su_nfields[slot]) {
                int foff = off + c->su_field_off_buf[slot * 128 + fj];
                int fw = c->su_field_size_buf[slot * 128 + fj];
                char fname[64];
                d_strncpy(fname, c->su_fields_buf + (slot * 128 + fj) * 64, 63);
                fname[63] = 0;
                int fe = 0;
                int fes = -1;
                int un = 0;
                int ptr = 0;
                int flt = 0;
                int frowsz = 0;
                if (comp_field_meta(c, slot, fname, &fw, &fe, &fes, &un, &ptr, &frowsz, &flt) < 0) {
                    fes = -1;
                    fe = 0;
                }
                if (lex_is(l, T_LBRACE)) {
                    if (fes >= 0 && fw > c->su_size[fes]) {
                        dc_gi_array(c, l, gv, foff, c->su_size[fes], fes);
                    } else if (fes >= 0) {
                        dc_gi_struct(c, l, gv, foff, fes);
                    } else if (fe > 0 && fw > fe) {
                        dc_gi_array(c, l, gv, foff, fe, -1);
                    } else {
                        d_puts("drygon: cannot lay out nested initializer braces\n");
                        sys_exit(1);
                    }
                } else if (lex_is(l, T_STR) && fe > 0 && fw > fe) {
                    dc_gi_strbytes(c, l, gv, foff, fw);
                } else if (fe > 0 && fw > fe && fes < 0) {
                    /* array field, flat value: fill element 0 */
                    dc_gi_scalar(c, l, gv, foff, fe >= 8 ? 8 : fe);
                } else if (fes >= 0 && c->su_nfields[fes] > 0) {
                    /* struct field, flat value: fill its first member -- unless
                     * the value is an ADDRESS, which for a `struct T*` member
                     * means the pointer itself (8 bytes), not its first member. */
                    if (ptr || lex_is(l, T_AMP)) {
                        int scw2 = fw >= 8 ? 8 : fw;
                        if (scw2 < 8) scw2 = 8;
                        dc_gi_scalar(c, l, gv, foff, scw2);
                    } else {
                        int fo0 = c->su_field_off_buf[fes * 128 + 0];
                        int fw0 = c->su_field_size_buf[fes * 128 + 0];
                        dc_gi_scalar(c, l, gv, foff + fo0, fw0 >= 8 ? 8 : fw0);
                    }
                } else {
                    /* A pointer member is 8 bytes wide even when its recorded
                     * scalar size is smaller: `struct N a = {1, &b};` was passed
                     * width 4 and rejected the address constant.  The recorded
                     * size for a `struct T*` member is the pointee's, not the
                     * pointer's, so an address/string initializer forces 8. */
                    int scw = fw >= 8 ? 8 : fw;
                    if ((ptr || lex_is(l, T_AMP)) && scw < 8) scw = 8;
                    dc_gi_scalar(c, l, gv, foff, scw);
                }
                handled = 1;
            }
        }
        if (!handled) {
            /* union members past the first, or more values than fields */
            if (!warned) {
                d_puts("drygon: warning: extra initializer values ignored\n");
                warned = 1;
            }
            dc_gi_skip_item(c, l);
        }
        fj = fj + 1;
        if (lex_is(l, T_COMMA)) lex_advance(l);
    }
    if (lex_is(l, T_RBRACE)) lex_advance(l);
}

/* `static <scalar|pointer> name [= const];` at statement scope: the object has
 * static storage duration, so it is registered as a global under an internal
 * label (`~<seq>_<name>`; '~' cannot occur in a C identifier, so the label can
 * never collide with a real global, and the sequence number keeps two
 * functions' same-named statics apart) and the source name is aliased to that
 * global for the rest of the enclosing function.  Every existing global
 * read/write path then resolves it through comp_find_gvar/comp_gvar_addr.
 * Returns 1 on success, leaving the lexer on the ';'; 0 means "not this shape"
 * and the caller restores the lexer and declares an ordinary local instead.
 * Arrays, aggregates, function declarators and floating point types are
 * deliberately not handled here -- they keep the historical local behaviour. */
static int lstat_decl(Compiler* c, Lexer* l) {
    if (ngvars >= 1024 || lstat_n >= 64) return 0;
    Lexer save = *l;
    int lastkw = 0;
    int had_star = 0;
    int ftag = 0;
    int had_uns = 0;
    char ftype[64];
    ftype[0] = 0;
    comp_parse_type(l, &lastkw, &had_star, ftype, &ftag, &had_uns);
    if ((lastkw == T_DOUBLE || lastkw == T_FLOAT) && had_star == 0) { *l = save; return 0; }
    if (lastkw == T_VOID && had_star == 0) { *l = save; return 0; }
    /* Aggregates, unions and enums keep the historical stack-local behaviour.
     * The alias table stores one 8-byte cell per static, so registering
     * `static CyTranspiler pre;` as an 8-byte "global" makes `pre.syms` fail
     * with "unknown member offset ... base slot -1" -- the self-host break. */
    if (ftag != 0) { *l = save; return 0; }
    if (ftype[0] != 0) {
        int ftd = comp_find_typedef(c, ftype);
        if (ftd >= 0 && c->td_sizes[ftd] > 8) { *l = save; return 0; }
    }
    if (lex_cur(l)->kind != T_IDENT) { *l = save; return 0; }
    char sname[64];
    d_strncpy(sname, lex_cur(l)->text, 63); sname[63] = 0;
    lex_advance(l);
    if (lex_is(l, T_LBRACKET) || lex_is(l, T_LPAREN)) { *l = save; return 0; }
    if (!lex_is(l, T_ASSIGN) && !lex_is(l, T_SEMI)) { *l = save; return 0; }
    if (lex_is(l, T_ASSIGN)) {
        /* Only the initializer forms dc_gi_scalar understands, and only a
         * single token: `static int x = 1 + 2;` is not our shape, and leaving
         * the lexer stranded mid-declaration would desync the statement loop.
         * The whole declaration is validated before anything is registered. */
        Lexer li = *l;
        lex_advance(&li);
        int ik = lex_cur(&li)->kind;
        int iok = 0;
        if (ik == T_NUM || ik == T_STR) { iok = 1; lex_advance(&li); }
        else if (ik == T_MINUS) {
            lex_advance(&li);
            if (lex_cur(&li)->kind == T_NUM) { iok = 1; lex_advance(&li); }
        } else if (ik == T_IDENT) {
            char ic[64];
            d_strncpy(ic, lex_cur(&li)->text, 63); ic[63] = 0;
            if (d_strcmp(ic, "NULL") == 0 || comp_find_enum_const(c, ic) != -2147483648) {
                iok = 1;
            } else {
                int di = 0;
                while (di < ndefs) {
                    if (d_strcmp(def_names_buf + di * 64, ic) == 0) { iok = 1; break; }
                    di = di + 1;
                }
            }
            if (iok) lex_advance(&li);
        }
        if (!iok || !lex_is(&li, T_SEMI)) { *l = save; return 0; }
    }
    /* register the object as a global under its internal label */
    char mname[64];
    { int mi = 0; while (mi < 64) { mname[mi] = 0; mi = mi + 1; } }
    int mp = 0;
    mname[mp] = 126; mp = mp + 1; /* '~' */
    { int q = lstat_seq;
      char tmp[16];
      int ti = 0;
      if (q == 0) { tmp[ti] = 48; ti = ti + 1; }
      while (q > 0) { tmp[ti] = (char)(48 + (q % 10)); ti = ti + 1; q = q / 10; }
      while (ti > 0) { ti = ti - 1; mname[mp] = tmp[ti]; mp = mp + 1; } }
    mname[mp] = 95; mp = mp + 1; /* '_' */
    { int si = 0; while (sname[si] != 0 && mp < 60) { mname[mp] = sname[si]; mp = mp + 1; si = si + 1; } }
    mname[mp] = 0;
    int gi = ngvars;
    d_memcpy(gvar_names_buf + gi * 64, mname, 64);
    gvar_elems[gi] = 8;
    gvar_sizes[gi] = 8;
    if (had_uns) gvar_uns[gi] = 1;
    ngvars = ngvars + 1;
    d_memcpy(lstat_names_buf + lstat_n * 64, sname, 64);
    lstat_gvar[lstat_n] = gi;
    lstat_n = lstat_n + 1;
    lstat_seq = lstat_seq + 1;
    if (lex_is(l, T_ASSIGN)) {
        lex_advance(l);
        dc_gi_begin(gi);
        dc_gi_scalar(c, l, gi, 0, 8);
    }
    return 1;
}

/* ------ Top-level compile --------------------------------------------------------------------------------------------------------------------------------------------------------------- */
/* Backfill string-pointer (and &global) initializers with absolute addresses.
 * cv2 is the base the code/data will be loaded at: ELF_LOAD_ADDR for the ELF
 * path, ROS_LOAD_ADDR for the direct .ros blob. The RW segment sits at
 * p_vaddr = cv2 + data_page_off (data_page_off = roundup(data_start*4)), so a
 * word at index li lives at cv2 + dpoff2 + (li - data_start)*4. */
static void ginit_str_backfill(Compiler* c, int cv2, int data_start) {
    if (ginit_str_n <= 0) return;
    int dpoff2 = ((data_start * 4 + 4095) / 4096) * 4096;
    int pi = 0;
    while (pi < ginit_str_n) {
        char slbl[32];
        int id2 = ginit_str_id[pi];
        if (ginit_amp[pi]) {
            /* `&global`: use the object's own label, not a string label. */
            int an2 = 0;
            while (an2 < 31) { slbl[an2] = ginit_amp_buf[pi * 64 + an2]; if (!slbl[an2]) break; an2 = an2 + 1; }
            slbl[31] = 0;
        } else {
        char tmp2[16];
        int ti2 = 0;
        if (id2 == 0) { tmp2[ti2] = 48; ti2 = ti2 + 1; }
        while (id2) { tmp2[ti2] = 48 + (id2 % 10); ti2 = ti2 + 1; id2 = id2 / 10; }
        slbl[0] = 115; slbl[1] = 116; slbl[2] = 114; slbl[3] = 95;
        { int k = 0; while (k < ti2) { slbl[4 + k] = tmp2[ti2 - 1 - k]; k++; } }
        slbl[4 + ti2] = 0;
        }
        int li = code_find_label(&c->code, slbl);
        if (li < 0) {
            /* Not a string label: `&global` recorded the global's NAME, so
             * build its label (gvar_label) and use that object's address. */
            int gi2 = comp_find_gvar(slbl);
            if (gi2 < 0) {
                d_puts("drygon: initializer address target not found: ");
                d_puts(slbl);
                d_puts("\n");
                sys_exit(1);
            }
            char glbl2[80];
            gvar_label(glbl2, gvar_names_buf + gi2 * 64);
            li = code_find_label(&c->code, glbl2);
            if (li < 0) {
                d_puts("drygon: initializer address target has no label: ");
                d_puts(slbl);
                d_puts("\n");
                sys_exit(1);
            }
        }
        long addr = 0;
        if (li < data_start) {
            addr = (long)cv2 + (long)li * 4;
        } else {
            /* data/string word index is relative to the whole code stream in
             * the .elf layout only through data_start; both live in the RW
             * segment whose base is ELF_LOAD_ADDR + dpoff2 - 4*data_start */
            addr = (long)cv2 + (long)dpoff2 - (long)data_start * 4 + (long)li * 4;
        }
        c->code.words[ginit_str_w[pi]] = (uint32_t)(addr & 0xFFFFFFFF);
        c->code.words[ginit_str_w[pi] + 1] = (uint32_t)((addr >> 32) & 0xFFFFFFFF);
        /* A pointer member not 8-byte aligned (a `struct T*` after an int:
         * offset 4) shares words with its neighbours, so splice the eight
         * address bytes in at the exact byte offset instead of blasting two
         * whole words over whatever the field before it held. */
        if (ginit_str_sub[pi] != 0) {
            int sub = ginit_str_sub[pi];
            int wi = ginit_str_w[pi];
            int k2 = 0;
            while (k2 < 4 - sub && k2 < 8) {
                uint32_t cur = c->code.words[wi];
                uint32_t sh = (uint32_t)(sub + k2) * 8;
                cur = (cur & ~(((uint32_t)0xFF) << sh)) |
                      (((uint32_t)((addr >> (k2 * 8)) & 0xFF)) << sh);
                c->code.words[wi] = cur;
                k2 = k2 + 1;
            }
            while (k2 < 8) {
                uint32_t cur = c->code.words[wi + 1];
                uint32_t sh = (uint32_t)(k2 + sub - 4) * 8;
                cur = (cur & ~(((uint32_t)0xFF) << sh)) |
                      (((uint32_t)((addr >> (k2 * 8)) & 0xFF)) << sh);
                c->code.words[wi + 1] = cur;
                k2 = k2 + 1;
            }
        }
        pi = pi + 1;
    }
}

static void compile_program(Compiler* c, Lexer* l) {
    c->code.nwords = 0;
    c->code.nlabels = 0;
    c->code.npatches = 0;
    g_patch_nm_used = 0;
    d_memset(c->code.label_hash, 0, 524288 * 4);
    c->lbl_counter = 1;
    c->loop_counter = 1;
    c->addr_of = 0;
    c->in_macro = 0;
    nstrings = 0;
    str_pool_used = 0;
    ndefs = 0;
    fm_n = 0;
    ngvars = 0;
    lstat_n = 0;
    lstat_seq = 0;
    sw_case_seq = 0;
    { int _ri = 0; while (_ri < 1024) { gvar_rowsz[_ri] = 0; _ri = _ri + 1; } }
    gvar_init_used = 0;
    ginit_str_n = 0;
    ginit_fn_n = 0;
    { int _ai = 0; while (_ai < 1024) { gvar_addr_str[_ai] = -1; _ai = _ai + 1; } }
    { int _gi2 = 0; while (_gi2 < 1024) { gvar_init_off[_gi2] = 0; gvar_init_len[_gi2] = 0; _gi2 = _gi2 + 1; } }
    nfnsig = 0;
    comp_register_builtin_types(c);
    /* _start */
    code_label(&c->code, "_start");
    code_emit(&c->code, a_ldr_x(0, 31, 0));       /* x0 = argc (at [sp]) */
    code_emit(&c->code, a_addi(1, 31, 8));        /* x1 = argv (at [sp+8]) */
    code_emit(&c->code, a_subi(31, 31, 16));
    int main_idx = c->code.nwords;
    code_emit(&c->code, a_bl(0));
    code_patch(&c->code, main_idx, "drygon_main", 1, 0, 0);
    code_emit(&c->code, a_addi(31, 31, 16));
    comp_load_imm(&c->code, 8, SC_EXIT);
    code_emit(&c->code, a_svc());


    /* parse top-level: functions and globals.
     * Recovery + a progress guard: a syntax error no longer aborts the run,
     * so one compile reports every front-end error in the file, and a
     * declaration that consumes no token cannot spin forever. */
    l->rec = 1;
    l->errs = 0;
    l->brace_depth = 0;
    l->pp_sp = 0;
    l->pp_emit = 1;
    g_fe_errors = 0;
    int guard_pos = -1;
    int guard_htk = -1;
    while (!lex_is(l, T_EOF)) {
        if (l->pos == guard_pos && l->has_tok == guard_htk) {
            lex_advance(l);
            lex_peek(l);
        }
        guard_pos = l->pos;
        guard_htk = l->has_tok;
        DcToken* t = lex_cur(l);
        fm_decl_try(c, l);
        if (t->kind == T_INCLUDE) {
            /* skip #include <...> or #include "..." to end of line */
            int inc_line = t->line;
            while (!lex_is(l, T_EOF) && lex_line(l) == inc_line) lex_advance(l);
            continue;
        } else if (t->kind == T_DEFINE) {
            comp_do_define(l);
            continue;
        } else if (t->kind == T_TYPEDEF) {
            /* register typedefs / enum constants / aggregate layouts so casts
             * and aggregate-typed locals at file scope resolve. */
            comp_stmt(c, l);
            continue;
        } else if (t->kind == T_STRUCT || t->kind == T_UNION || t->kind == T_ENUM) {
            /* `struct Foo { ... };` registers the layout (comp_stmt).  A
             * body-less spelling can also be a FUNCTION DEFINITION with an
             * aggregate return type (`struct P mk(int a) { ... }`); detect
             * `struct TAG name (` and compile it instead of skipping, which
             * left the function uncompiled and every call to it unresolved. */
            Lexer lk = *l;
            lex_advance(&lk);                       /* struct/union/enum */
            if (lex_is(&lk, T_IDENT)) lex_advance(&lk);
            while (lex_is(&lk, T_STAR)) lex_advance(&lk);
            int agg_fn = 0;
            if (lex_is(&lk, T_IDENT)) {
                lex_advance(&lk);
                if (lex_is(&lk, T_LPAREN)) agg_fn = 1;
            }
            if (agg_fn) {
                int akw = 0, astar = 0, atag = 0, auns = 0;
                char atn[64]; atn[0] = 0;
                comp_parse_type(l, &akw, &astar, atn, &atag, &auns);
                while (lex_is(l, T_STAR)) lex_advance(l);
                if (lex_is(l, T_IDENT)) {
                    char gname[64];
                    d_strncpy(gname, lex_text(l), 63); gname[63] = 0;
                    lex_advance(l);
                    if (lex_is(l, T_LPAREN)) {
                        Lexer lsv = *l;
                        lex_advance(l);
                        int pd = 1;
                        while (!lex_is(l, T_EOF) && pd > 0) {
                            if (lex_is(l, T_LPAREN)) pd = pd + 1;
                            else if (lex_is(l, T_RPAREN)) pd = pd - 1;
                            lex_advance(l);
                        }
                        if (lex_is(l, T_SEMI)) {
                            lex_advance(l);          /* prototype, not a body */
                        } else {
                            *l = lsv;
                            int asz = 0;
                            if (atag && atn[0]) {
                                int sl = comp_find_struct(c, atn);
                                if (sl >= 0 && c->su_size[sl] > 0) asz = c->su_size[sl];
                            }
                            g_pending_ret_agg = asz;
                            comp_function(c, l, gname, 0, astar > 0 ? 1 : 0, fn_pelem_compute(c, akw, astar, atn, atag), 0);
                            g_pending_ret_agg = 0;
                        }
                        continue;
                    }
                }
            }
            Lexer lt = *l;
            int has_body = 0;
            lex_advance(&lt);
            if (lex_is(&lt, T_IDENT)) lex_advance(&lt);
            if (lex_is(&lt, T_LBRACE)) has_body = 1;
            if (has_body) { comp_stmt(c, l); continue; }
            /* `struct P gp;` / `struct P gp = {...};` / `struct P gp[N];` -- a
             * GLOBAL of aggregate type.  The whole declaration used to be
             * skipped here, so the object was never allocated in the data
             * section and `&gp` read back as null while `static struct P gp={..}`
             * (which starts with `static` and takes the scalar-global path)
             * worked.  Register it the same way that path does. */
            {
                Lexer lg = *l;
                lex_advance(&lg);                       /* struct/union/enum */
                if (lex_is(&lg, T_IDENT)) lex_advance(&lg);
                if (lex_is(&lg, T_IDENT)) {
                    lex_advance(&lg);
                    if (lex_is(&lg, T_SEMI) || lex_is(&lg, T_ASSIGN) || lex_is(&lg, T_LBRACKET)) {
                        int gkw = 0, gstar = 0, gtag = 0, guns = 0;
                        char gtn[64]; gtn[0] = 0;
                        comp_parse_type(l, &gkw, &gstar, gtn, &gtag, &guns);
                        if (lex_is(l, T_IDENT)) {
                            char gname[64];
                            d_strncpy(gname, lex_text(l), 63); gname[63] = 0;
                            lex_advance(l);
                            int gslot = comp_find_struct(c, gtn);
                            int esz = (gslot >= 0 && c->su_size[gslot] > 0) ? c->su_size[gslot] : 8;
                            int gvar_arr = 0;
                            int nelem = 1;
                            if (lex_is(l, T_LBRACKET)) {
                                gvar_arr = 1;
                                Lexer lw = *l;
                                lex_advance(&lw);
                                if (lex_is(&lw, T_NUM)) nelem = lex_num(&lw);
                                if (nelem < 1) nelem = 1;
                                int pd = 0;
                                while (!lex_is(l, T_EOF)) {
                                    if (lex_is(l, T_LBRACKET)) pd = pd + 1;
                                    else if (lex_is(l, T_RBRACKET)) { pd = pd - 1; lex_advance(l); if (pd <= 0) break; continue; }
                                    lex_advance(l);
                                }
                            }
                            int gn = ngvars;
                            if (ngvars < 1024) {
                                d_memcpy(gvar_names_buf + ngvars * 64, gname, 64);
                                gvar_elems[ngvars] = (gvar_arr && gslot >= 0) ? esz : 8;
                                gvar_sizes[ngvars] = gvar_arr ? nelem * esz : esz;
                                if (gvar_sizes[ngvars] < 8) gvar_sizes[ngvars] = 8;
                                if (gvar_arr) gvar_is_array[ngvars] = 1;
                                if (gslot >= 0 && gslot < 256) gvar_eslots[ngvars] = gslot + 1;
                                ngvars = ngvars + 1;
                            }
                            while (!lex_is(l, T_EOF) && !lex_is(l, T_SEMI)) {
                                if (lex_is(l, T_ASSIGN)) {
                                    lex_advance(l);
                                    if (gn >= 0 && gn < 1024 && gvar_init_len[gn] == 0) {
                                        dc_gi_begin(gn);
                                        if (lex_is(l, T_LBRACE)) {
                                            if (gvar_arr && gslot >= 0) {
                                                /* an array's brace list maps
                                                 * elements, not fields */
                                                dc_gi_array(c, l, gn, 0, esz, gslot);
                                            } else if (gslot >= 0) {
                                                dc_gi_struct(c, l, gn, 0, gslot);
                                            } else {
                                                dc_gi_skip_item(c, l);
                                            }
                                        } else {
                                            dc_gi_skip_item(c, l);
                                        }
                                    }
                                } else if (lex_is(l, T_LBRACE)) {
                                    dc_gi_skip_item(c, l);
                                } else {
                                    lex_advance(l);
                                }
                            }
                            if (lex_is(l, T_SEMI)) lex_advance(l);
                            continue;
                        }
                    }
                }
            }
            int bdepth = 0;
            while (!lex_is(l, T_EOF)) {
                if (lex_is(l, T_LBRACE)) { bdepth++; lex_advance(l); continue; }
                if (lex_is(l, T_RBRACE)) {
                    bdepth--;
                    lex_advance(l);
                    if (bdepth <= 0) break;
                    continue;
                }
                if (bdepth == 0 && lex_is(l, T_SEMI)) { lex_advance(l); break; }
                lex_advance(l);
            }
            continue;
        } else if (t->kind == T_INT || t->kind == T_VOID || t->kind == T_CHAR ||
                   t->kind == T_FLOAT || t->kind == T_DOUBLE ||
                   t->kind == T_UNSIGNED || t->kind == T_LONG ||
                   t->kind == T_SHORT || t->kind == T_SIGNED || t->kind == T_SIZE_T ||
                   t->kind == T_STATIC || t->kind == T_INLINE || t->kind == T_CONST ||
                   t->kind == T_EXTERN || t->kind == T_VOLATILE ||
                   t->kind == T_REGISTER || t->kind == T_BOOL ||
                   t->kind == T_RESTRICT || t->kind == T_NORETURN ||
                   t->kind == T_COMPLEX ||
                   (t->kind == T_IDENT && comp_find_typedef(c, t->text) >= 0)) {
            /* function or global var: parse the type prefix (keywords, typedef
             * name, struct tag, stars) so `MyType* f(...)` and `MyType x;`
             * resolve the same way `int f(...)` does. */
            int lastkw = 0;
            int had_star = 0;
            int ftag = 0;
            char ftype[64];
            ftype[0] = 0;
            int had_uns = 0;
            comp_parse_type(l, &lastkw, &had_star, ftype, &ftag, &had_uns);
            DcToken* nt = lex_cur(l);
            /* function-pointer declarator at file scope: `(* name)(params)` */
            char fp_name[64];
            fp_name[0] = 0;
            int fp_arr_n = 0;
            if (nt->kind == T_LPAREN) {
                Lexer lf = *l;
                lex_advance(&lf);
                if (lex_is(&lf, T_STAR)) {
                    lex_advance(&lf);
                    if (lex_is(&lf, T_IDENT)) {
                        d_strncpy(fp_name, lex_text(&lf), 63); fp_name[63] = 0;
                        lex_advance(&lf);
                        /* `int (*o[N])(int,int)` -- an ARRAY of function
                         * pointers at file scope.  The `[N]` sits between the
                         * name and the `)`, so the `( * name ) (` shape below
                         * did not match and the ENTIRE declaration was skipped:
                         * the array was never allocated and every read of
                         * `o[i]` took a fault.  Consume the subscript here and
                         * register the object as an N-element array. */
                        if (lex_is(&lf, T_LBRACKET) && fp_arr_n == 0) {
                            Lexer lw2 = lf;
                            lex_advance(&lw2);
                            if (lex_is(&lw2, T_NUM)) {
                                int nn2 = lex_num(&lw2);
                                lex_advance(&lw2);
                                if (lex_is(&lw2, T_RBRACKET)) {
                                    lex_advance(&lw2);
                                    if (lex_is(&lw2, T_RPAREN)) {
                                        lex_advance(&lw2);
                                        if (lex_is(&lw2, T_LPAREN)) {
                                            /* lw2 now sits ON the parameter list's
                                             * '(' -- skip it the same way the
                                             * scalar branch does and commit. */
                                            int fdep3 = 0;
                                            while (!lex_is(&lw2, T_EOF)) {
                                                if (lex_is(&lw2, T_LPAREN)) { fdep3 = fdep3 + 1; }
                                                else if (lex_is(&lw2, T_RPAREN)) {
                                                    fdep3 = fdep3 - 1;
                                                    if (fdep3 == 0) { lex_advance(&lw2); break; }
                                                }
                                                lex_advance(&lw2);
                                            }
                                            fp_arr_n = (nn2 > 0) ? nn2 : 1;
                                            *l = lw2;
                                        }
                                    }
                                }
                            }
                        }
                        if (lex_is(&lf, T_RPAREN)) {
                            lex_advance(&lf);
                            if (lex_is(&lf, T_LPAREN)) {
                                int fdep = 0;
                                while (!lex_is(&lf, T_EOF)) {
                                    if (lex_is(&lf, T_LPAREN)) { fdep = fdep + 1; }
                                    else if (lex_is(&lf, T_RPAREN)) {
                                        fdep = fdep - 1;
                                        if (fdep == 0) { lex_advance(&lf); break; }
                                    }
                                    lex_advance(&lf);
                                }
                                *l = lf;
                            }
                        }
                    }
                }
            }
            if (fp_name[0] != 0) {
                if (ngvars < 1024) {
                    d_memcpy(gvar_names_buf + ngvars * 64, fp_name, 64);
                    gvar_elems[ngvars] = 8;
                    gvar_sizes[ngvars] = fp_arr_n > 0 ? fp_arr_n * 8 : 8;
                    if (fp_arr_n > 0) gvar_is_array[ngvars] = 1;
                    ngvars = ngvars + 1;
                }
                /* An initializer on a function-pointer global must still be laid
                 * out: `= add` on the scalar form `int (*op)(int,int) = add;`
                 * and `= {add}` on the array form.  Only an identifier, a brace
                 * list or a unary `&` is handled; a cast form such as
                 * `= (long (*)(void*))0` (which drygon's own source uses) is
                 * left to the skip-to-';' path, since dc_gi_scalar accepts only
                 * integers, strings and symbol references. */
                if (lex_is(l, T_ASSIGN) && fp_init_ok(l)) {
                    int gv = ngvars - 1;
                    if (gv >= 0) {
                        lex_advance(l);
                        dc_gi_begin(gv);
                        if (lex_is(l, T_LBRACE)) dc_gi_array(c, l, gv, 0, 8, -1);
                        else dc_gi_scalar(c, l, gv, 0, 8);
                    }
                }
                while (!lex_is(l, T_EOF) && !lex_is(l, T_SEMI)) lex_advance(l);
                if (lex_is(l, T_SEMI)) lex_advance(l);
            } else if (nt->kind == T_IDENT) {
                char gvname[64];
                d_strncpy(gvname, nt->text, 63); gvname[63] = 0;
                lex_advance(l);
                if (lex_is(l, T_LPAREN)) {
                    Lexer l_saved = *l;
                    lex_advance(l);
                    int pdepth = 1;
                    while (!lex_is(l, T_EOF) && pdepth > 0) {
                        if (lex_is(l, T_LPAREN)) {
                            pdepth = pdepth + 1;
                        } else if (lex_is(l, T_RPAREN)) {
                            pdepth = pdepth - 1;
                        }
                        lex_advance(l);
                    }
                    if (lex_is(l, T_SEMI)) {
                        /* prototype: register the signature, re-walking the
                         * parameter list to record which params are
                         * double/float.  Registering nparams=0 with zero float
                         * flags let `#include <math.h>`'s `double sqrt(double
                         * x);` append a LAST row (fn_sig_find keeps the last)
                         * that overrode the prelude definition's correct
                         * signature, so sqrt(16) passed 16 as raw int bits and
                         * every math call returned garbage.  A later definition
                         * still re-registers and wins. */
                        int np = 0;
                        char pf[8];
                        { int zi = 0; while (zi < 8) { pf[zi] = 0; zi = zi + 1; } }
                        *l = l_saved;
                        lex_advance(l);   /* '(' */
                        int pdep = 1;
                        while (!lex_is(l, T_EOF) && pdep > 0) {
                            if (lex_is(l, T_LPAREN)) { pdep = pdep + 1; lex_advance(l); continue; }
                            if (lex_is(l, T_RPAREN)) { pdep = pdep - 1; lex_advance(l); continue; }
                            if (pdep == 1) {
                                if (lex_is(l, T_VOID)) { lex_advance(l); continue; }
                                if (lex_is(l, T_DOT)) {
                                    /* `...`: varargs tail -- nothing after it
                                     * is a named parameter */
                                    while (!lex_is(l, T_EOF) && !lex_is(l, T_RPAREN)) lex_advance(l);
                                    continue;
                                }
                                int pkw = 0;
                                int pstar = 0;
                                while (!lex_is(l, T_EOF) && !lex_is(l, T_COMMA) && !lex_is(l, T_RPAREN)) {
                                    int k = lex_cur(l)->kind;
                                    if (k == T_DOUBLE || k == T_FLOAT) pkw = k;
                                    else if (k == T_STAR) pstar = pstar + 1;
                                    lex_advance(l);
                                }
                                if (np < 8) pf[np] = ((pkw == T_DOUBLE || pkw == T_FLOAT) && pstar == 0) ? 1 : 0;
                                np = np + 1;
                                if (lex_is(l, T_COMMA)) lex_advance(l);
                                continue;
                            }
                            lex_advance(l);
                        }
                        if (np > 8) np = 8;
                        /* aggregate return declared through a TYPEDEF name
                         * (`typedef struct {...} V;` then `V f(...);`): the tag
                         * is absent, so register the size the same way the
                         * struct-tag path does.  Without it the call site saw
                         * fn_ret_agg==0, left the result as a value, and a
                         * following `.m` dereferenced the returned ADDRESS.
                         * Save/restore so it cannot leak into the next decl. */
                        int prv_agg = g_pending_ret_agg;
                        if (had_star == 0 && ftype[0]) {
                            int ftd3 = comp_find_typedef(c, ftype);
                            if (ftd3 >= 0 && (c->td_kinds[ftd3] == 1 || c->td_kinds[ftd3] == 2)) {
                                int sl3 = c->td_slots[ftd3] - 1;
                                if (sl3 >= 0 && c->su_size[sl3] > 0) g_pending_ret_agg = c->su_size[sl3];
                            } else if (ftd3 < 0) {
                                int sl3 = comp_find_struct(c, ftype);
                                if (sl3 >= 0 && c->su_size[sl3] > 0) g_pending_ret_agg = c->su_size[sl3];
                            }
                        }
                        fn_sig_add(gvname, (lastkw == T_DOUBLE || lastkw == T_FLOAT) && had_star == 0, np, pf, had_star > 0 ? 1 : 0, fn_pelem_compute(c, lastkw, had_star, ftype, ftag), (lastkw == T_FLOAT) && had_star == 0);
                        g_pending_ret_agg = prv_agg;
                        lex_advance(l);
                    } else {
                        *l = l_saved;
                        if (d_getenv("DRYGON_TRACE") != 0) {
                            d_puts("TRACE fn: "); d_puts(gvname); d_puts(" nw=");
                            d_putdec(c->code.nwords); d_puts("\n");
                        }
                        int rp = had_star > 0 ? 1 : 0;
                        /* Same aggregate-return registration for a DEFINITION
                         * reached through a typedef name: comp_add_fn inside
                         * comp_function records fn_ret_agg from
                         * g_pending_ret_agg, so set it (and restore) around the
                         * call.  Leaving it set leaked into the next function
                         * and broke plain aggregate-typed calls too. */
                        int prv_def_agg = g_pending_ret_agg;
                        if (rp == 0 && ftype[0]) {
                            int ftd4 = comp_find_typedef(c, ftype);
                            if (ftd4 >= 0 && (c->td_kinds[ftd4] == 1 || c->td_kinds[ftd4] == 2)) {
                                int sl4 = c->td_slots[ftd4] - 1;
                                if (sl4 >= 0 && c->su_size[sl4] > 0) g_pending_ret_agg = c->su_size[sl4];
                            } else if (ftd4 < 0) {
                                int sl4 = comp_find_struct(c, ftype);
                                if (sl4 >= 0 && c->su_size[sl4] > 0) g_pending_ret_agg = c->su_size[sl4];
                            }
                        }
                        comp_function(c, l, gvname, (lastkw == T_DOUBLE || lastkw == T_FLOAT) && had_star == 0, rp, fn_pelem_compute(c, lastkw, had_star, ftype, ftag), (lastkw == T_FLOAT) && had_star == 0);
                        g_pending_ret_agg = prv_def_agg;
                    }
                } else {
                    /* global var: register for data-section allocation */
                    if (ngvars < 1024) {
                        d_memcpy(gvar_names_buf + ngvars * 64, gvname, 64);
                        int esz = 8;
                        int gslot = -1;
                        if (lastkw == T_CHAR && had_star == 0) { esz = 1; }
                        else if (lastkw == T_INT && had_star == 0) { esz = 4; }
                        if (ftype[0] && !ftag && had_star == 0) {
                            int ftd = comp_find_typedef(c, ftype);
                            if (ftd >= 0 && c->td_sizes[ftd] > 0) { esz = c->td_sizes[ftd]; }
                        }
                        /* Aggregate type of this global (or, for an array,
                         * of one element) so member access can resolve. */
                        if (ftype[0]) {
                            if (ftag) {
                                gslot = comp_find_struct(c, ftype);
                            } else {
                                int ftd2 = comp_find_typedef(c, ftype);
                                if (ftd2 >= 0 && (c->td_kinds[ftd2] == 1 || c->td_kinds[ftd2] == 2)) {
                                    gslot = c->td_slots[ftd2] - 1;
                                    if (gslot < 0) gslot = comp_find_struct(c, c->td_names_buf + ftd2 * 64);
                                } else if (ftd2 < 0) {
                                    gslot = comp_find_struct(c, ftype);
                                }
                            }
                        }
                        if (gslot >= 0 && had_star == 0 && c->su_size[gslot] > 0 && esz < c->su_size[gslot]) {
                            esz = c->su_size[gslot];
                        }
                        /* NOTE: a global object's bound is deliberately read as
                         * a single literal/macro token here and the rest of the
                         * declaration is skipped below. drygon zero-fills every
                         * global into the data section, which `code_emit` caps
                         * at 2M words (8 MB), so fully evaluating the bound of
                         * e.g. `char _cc_heap[1024*1024*64]` would overflow the
                         * output buffer. The first factor is also exactly what
                         * Baccyn reserves for these arrays, so both compilers
                         * agree on the global object that actually exists --
                         * and on the value `sizeof(<global>)` reports for it. */
                        int nelem = 0;
                        if (lex_is(l, T_LBRACKET)) {
                            Lexer ls = *l;
                            Lexer lw = ls;
                            lex_advance(&lw);
                            nelem = 1;
                            int fbase = 0;
                            if (lex_is(&lw, T_NUM)) {
                                fbase = lex_num(&lw);
                                lex_advance(&lw);
                            } else if (lex_is(&lw, T_IDENT)) {
                                int mi2 = 0;
                                while (mi2 < ndefs) {
                                    if (d_strcmp(def_names_buf + mi2 * 64, lex_text(&lw)) == 0) { fbase = def_values[mi2]; }
                                    mi2 = mi2 + 1;
                                }
                                lex_advance(&lw);
                            }
                            /* A constant product bound (`[1024 * 8]`) is folded,
                             * because the element count is what the write sites
                             * assume.  Only factors that keep the object within
                             * the 2M-word data-section cap are folded: anything
                             * larger (e.g. `char _cc_heap[1024*1024*64]`) keeps
                             * the historical first-factor reservation, which is
                             * also what Baccyn reserves for it. */
                            if (fbase > 0) {
                                nelem = fbase;
                                int prod = fbase;
                                int capped = 0;
                                while (fbase <= 65536 && lex_is(&lw, T_STAR)) {
                                    Lexer lx = lw;
                                    lex_advance(&lx);
                                    if (!lex_is(&lx, T_NUM)) break;
                                    int fct = lex_num(&lx);
                                    if (fct <= 0) break;
                                    if (prod > 4194304 / fct) { capped = 1; break; }
                                    prod = prod * fct;
                                    lex_advance(&lx);
                                    lw = lx;
                                }
                                if (capped) { nelem = fbase; }
                                else if (prod > 0 && prod <= 4194304) { nelem = prod; }
                            }
                            *l = ls;
                        }
                        if (nelem > 0) {
                            gvar_elems[ngvars] = esz;
                            gvar_sizes[ngvars] = nelem * esz;
                            if (gvar_sizes[ngvars] < 8) gvar_sizes[ngvars] = 8;
                            /* A genuine multi-dim tail (`int df[8][4]`) makes
                             * the first subscript stride a whole row and the
                             * object span every dimension, as long as the
                             * total stays inside the 2M-word data cap. The
                             * huge single-factor reservations (`_cc_heap`)
                             * have no tail and keep their historical size. */
                            {
                                Lexer lw2 = *l;
                                int extra_prod = 1;
                                int extra_n = 0;
                                /* skip the primary `[ ... ]` group -- the
                                 * nelem block above restored *l to its `[`,
                                 * so only groups after it are extra dims */
                                if (lex_is(&lw2, T_LBRACKET)) {
                                    int bd2 = 0;
                                    while (!lex_is(&lw2, T_EOF)) {
                                        if (lex_is(&lw2, T_LBRACKET)) {
                                            bd2 = bd2 + 1;
                                        } else if (lex_is(&lw2, T_RBRACKET)) {
                                            bd2 = bd2 - 1;
                                            lex_advance(&lw2);
                                            if (bd2 == 0) break;
                                            continue;
                                        }
                                        lex_advance(&lw2);
                                    }
                                }
                                while (lex_is(&lw2, T_LBRACKET)) {
                                    lex_advance(&lw2);
                                    int eb = 0;
                                    int eb_ok = 0;
                                    if (lex_is(&lw2, T_NUM)) { eb = lex_num(&lw2); lex_advance(&lw2); eb_ok = 1; }
                                    else if (lex_is(&lw2, T_IDENT)) {
                                        int mi3 = 0;
                                        while (mi3 < ndefs) {
                                            if (d_strcmp(def_names_buf + mi3 * 64, lex_text(&lw2)) == 0) { eb = def_values[mi3]; eb_ok = 1; }
                                            mi3 = mi3 + 1;
                                        }
                                        lex_advance(&lw2);
                                    }
                                    if (lex_is(&lw2, T_RBRACKET)) lex_advance(&lw2);
                                    else break;
                                    if (!eb_ok || eb <= 0) { extra_n = 0; break; }
                                    if (extra_prod > 4194304 / eb) { extra_n = 0; break; }
                                    extra_prod = extra_prod * eb;
                                    extra_n = extra_n + 1;
                                }
                                if (extra_n > 0) {
                                    long tot = (long)nelem * (long)extra_prod;
                                    if (tot <= 1048576 && tot * esz <= 8388608) {
                                        gvar_sizes[ngvars] = (int)(tot * esz);
                                        if (gvar_sizes[ngvars] < 8) gvar_sizes[ngvars] = 8;
                                        gvar_rowsz[ngvars] = extra_prod * esz;
                                    }
                                }
                            }
                            /* An array global decays to its address in an
                             * rvalue context; a `double` global would
                             * otherwise be loaded as a scalar value. */
                            gvar_is_array[ngvars] = 1;
                        } else {
                            /* scalar, pointer or whole aggregate object: keep the
                             * declared byte size so the data section reserves
                             * enough room (struct globals were previously
                             * truncated to 8 bytes); the element width stays 8
                             * for the legacy direct-load paths. */
                            gvar_elems[ngvars] = 8;
                            gvar_sizes[ngvars] = esz;
                            if (gvar_sizes[ngvars] < 8) gvar_sizes[ngvars] = 8;
                        }
                        if (gslot >= 0 && gslot < 256) gvar_eslots[ngvars] = gslot + 1;
                        if (had_uns) gvar_uns[ngvars] = 1;
                        if ((lastkw == T_DOUBLE || lastkw == T_FLOAT) && had_star == 0) gvar_is_float[ngvars] = 1;
                        if ((lastkw == T_DOUBLE || lastkw == T_FLOAT) && had_star == 1) gvar_pfloat[ngvars] = 1;
                        ngvars = ngvars + 1;
                        /* file-scope initializer: laid out against the
                         * declared type into gvar_init_pool (brace lists,
                         * strings, scalars, macros); unsupported forms fail
                         * loudly instead of silently zero-filling */
                        while (!lex_is(l, T_EOF) && !lex_is(l, T_SEMI)) {
                            if (lex_is(l, T_ASSIGN)) {
                                lex_advance(l);
                                int gv = ngvars - 1;
                                if (gv < 0) {
                                    d_puts("drygon: initializer with no global variable\n");
                                    sys_exit(1);
                                }
                                if (gvar_init_len[gv] > 0) {
                                    d_puts("drygon: multiple initializers on one global\n");
                                    sys_exit(1);
                                }
                                dc_gi_begin(gv);
                                if (lex_is(l, T_LBRACE)) {
                                    if (gvar_eslots[gv] > 0) {
                                        int slot = gvar_eslots[gv] - 1;
                                        if (gvar_is_array[gv]) {
                                            dc_gi_array(c, l, gv, 0, gvar_elems[gv], slot);
                                        } else {
                                            dc_gi_struct(c, l, gv, 0, slot);
                                        }
                                    } else {
                                        dc_gi_array(c, l, gv, 0, gvar_elems[gv], -1);
                                    }
                                } else if (lex_is(l, T_STR) && gvar_is_array[gv]) {
                                    /* char array initialized by a string literal */
                                    dc_gi_strbytes(c, l, gv, 0, gvar_sizes[gv]);
                                } else {
                                    dc_gi_scalar(c, l, gv, 0, 8);
                                }
                                if (lex_is(l, T_COMMA)) {
                                    d_puts("drygon: multi-declarator global initializers not supported\n");
                                    sys_exit(1);
                                }
                            } else {
                                lex_advance(l);
                            }
                        }
                    }
                    while (!lex_is(l, T_EOF) && !lex_is(l, T_SEMI)) lex_advance(l);
                    if (lex_is(l, T_SEMI)) lex_advance(l);
                }
            }
        } else if (t->kind == T_ENUM) {
            /* enum constants: register into the macro table */
            lex_advance(l);
            if (lex_is(l, T_IDENT)) lex_advance(l);
            if (lex_is(l, T_LBRACE)) {
                lex_advance(l);
                int ev = 0;
                while (!lex_is(l, T_EOF) && !lex_is(l, T_RBRACE)) {
                    if (lex_is(l, T_IDENT)) {
                        DcToken* en = lex_cur(l);
                        char ename[64];
                        d_strncpy(ename, en->text, 63); ename[63] = 0;
                        lex_advance(l);
                        if (lex_is(l, T_ASSIGN)) {
                            lex_advance(l);
                            if (lex_is(l, T_NUM)) { ev = lex_num(l); lex_advance(l); }
                        }
                        if (ndefs < 64) {
                            d_memcpy(def_names_buf + ndefs * 64, ename, 64);
                            def_values[ndefs] = ev;
                            ndefs = ndefs + 1;
                        }
                        ev = ev + 1;
                    } else {
                        lex_advance(l);
                    }
                    if (lex_is(l, T_COMMA)) lex_advance(l);
                }
                if (lex_is(l, T_RBRACE)) lex_advance(l);
                if (lex_is(l, T_SEMI)) lex_advance(l);
            }
            continue;
        } else {
            lex_advance(l);
        }
    }
    g_fe_errors = l->errs;
    if (g_fe_errors > 0) {
        d_puts("direct_compiler: front-end errors=");
        d_putdec(g_fe_errors);
        d_putc(10);
    }

    /* emit printf helper */
    emit_printf(&c->code);

    /* data section: string literals + static buffers */
    int data_start = c->code.nwords;
    /* string literals */
    int i = 0;
    while (i < nstrings) {
        char lbl[32];
        lbl[0] = 115; lbl[1] = 116; lbl[2] = 114; lbl[3] = 95;
        int id = i; char tmp[16]; int ti = 0;
        if (id == 0) { tmp[ti] = 48; ti = ti + 1; }
        while (id) { tmp[ti] = 48 + (id % 10); ti = ti + 1; id = id / 10; }
        { int k = 0; while (k < ti) { lbl[4 + k] = tmp[ti - 1 - k]; k++; } }
        lbl[4 + ti] = 0;
        code_label(&c->code, lbl);
        int len = strings_len[i];
        int padded = ((len + 1 + 3) / 4) * 4;
        char* sbytes = (char*)get_ptr((long)strings_data, i);
        int j = 0;
        while (j < padded) {
            unsigned int w = 0;
            int k = 0;
            while (k < 4) {
                int idx = j + k;
                char b = 0;
                if (idx < len) {
                    b = sbytes[idx];
                } else {
                    b = 0;
                }
                int multiplier = 1;
                if (k == 1) {
                    multiplier = 256;
                } else if (k == 2) {
                    multiplier = 65536;
                } else if (k == 3) {
                    multiplier = 16777216;
                }
                w = w + (((b + 256) % 256) * multiplier);
                k++;
            }
            code_emit(&c->code, w);
            j = j + 4;
        }
        i++;
    }
    /* printf_buf (16 KiB: %05000d-class conversions buffer their whole
     * output before the single flush at printf_done) */
    code_label(&c->code, "printf_buf");
    { int i = 0; while (i < 16384) { code_emit(&c->code, 0); i++; } }
    /* itoa_buf */
    code_label(&c->code, "itoa_buf");
    { int i = 0; while (i < 32) { code_emit(&c->code, 0); i++; } }
    /* cvt_buf: scratch for pcvt-routed machine printf conversions */
    code_label(&c->code, "cvt_buf");
    { int i = 0; while (i < 128) { code_emit(&c->code, 0); i++; } }

    /* global vars: zero-filled data words addressed by gvar_ labels */
    { int gi = 0; while (gi < ngvars) {
        char gvl[80];
        gvar_label(gvl, gvar_names_buf + gi * 64);
        code_label(&c->code, gvl);
        int nkw = (gvar_sizes[gi] + 3) / 4;
        int wbase = c->code.nwords;
        if (gvar_init_len[gi] > 0) {
            int bidx = gvar_init_off[gi];
            int blen = gvar_init_len[gi];
            int wq = 0;
            while (wq < nkw) {
                unsigned int w = 0;
                int k = 0;
                while (k < 4) {
                    int boff = wq * 4 + k;
                    if (boff < blen) {
                        int b = gvar_init_pool[bidx + boff];
                        int mult = 1;
                        if (k == 1) {
                            mult = 256;
                        } else if (k == 2) {
                            mult = 65536;
                        } else if (k == 3) {
                            mult = 16777216;
                        }
                        w = w + (((b + 256) % 256) * mult);
                    }
                    k = k + 1;
                }
                code_emit(&c->code, w);
                wq = wq + 1;
            }
        } else {
            { int kw = 0; while (kw < nkw) { code_emit(&c->code, 0); kw = kw + 1; } }
        }
        { int pi = 0; while (pi < ginit_str_n) {
            if (ginit_str_gv[pi] == gi) {
                /* The backfill writes one word at ginit_str_w[pi]; a pointer at a
                 * 4-byte-but-not-8-byte-aligned offset would span two words, so
                 * require only 4-byte alignment and let the write land on the
                 * exact byte offset within the data block. */
                if (ginit_str_off[pi] % 4 != 0) {
                    d_puts("drygon: misaligned pointer initializer\n");
                    sys_exit(1);
                }
                ginit_str_w[pi] = wbase + (ginit_str_off[pi] / 4);
                ginit_str_sub[pi] = ginit_str_off[pi] % 4;
            }
            pi = pi + 1;
        } }
        gi = gi + 1;
    } }
    /* Flush any remaining pending gotos.  Pending entries are normally
     * resolved when their label is defined; a goto emitted after its label
     * (backward goto) stays pending forever and previously left a raw
     * `b .` behind -- an infinite loop.  Every label exists by now, so
     * queue each leftover for the normal resolve pass. */
    { int gpi = 0;
      while (gpi < c->goto_npending) {
          code_patch(&c->code, c->goto_pending_idx[gpi], c->goto_pending_buf + gpi*64, 0, 0, 0);
          gpi = gpi + 1;
      }
      c->goto_npending = 0;
    }
    /* entry alias: if drygon_main does not exist, check drygon_compile_main then main */
    if (code_find_label(&c->code, "drygon_main") < 0 && c->code.nlabels < MAX_LABELS) {
        int mi = code_find_label(&c->code, "drygon_compile_main");
        if (mi < 0) mi = code_find_label(&c->code, "main");
        if (mi >= 0) {
            code_alias_label(&c->code, "drygon_main", mi);
        }
    }
    /* resolve patches -- .ros vaddrs: code at 0x400000, data page-aligned after */
    {
        int cv = 4194304;
        int cb = data_start * 4;
        int dpoff = ((cb + 4095) / 4096) * 4096;
        int dv = cv + dpoff;
        g_unresolved_patches = 0;
        code_resolve(&c->code, cv, dv, data_start);
        if (g_unresolved_patches > 0) {
            d_puts("drygon: warning: "); d_putdec(g_unresolved_patches);
            d_puts(" unresolved symbol(s) -- program will trap when reached\n");
        }
    }
    /* backfill string-pointer initializers with absolute addresses (ELF
     * base here; the .ros direct-compile path re-runs this at ROS_LOAD_ADDR
     * so the cached blob is executable in place). */
    ginit_str_backfill(c, ELF_LOAD_ADDR, data_start);
    g_data_start = data_start;
    if (g_dc_debug) {
        d_puts("data_start="); d_putdec(data_start);
        d_puts(" nwords="); d_putdec(c->code.nwords);
        d_puts(" npatches="); d_putdec(c->code.npatches); d_putc(10);
    }
}

/* ------ Library entry: compile C source to an in-memory .ros blob ---------------------------------------
 * Compiles a C source string to a flat machine-code blob (code words, then
//  * page-aligned data words). Returns 0 on success and fills:
 *   *out_blob     - mmap'd RW buffer holding the blob (caller mprotects)
 *   *out_nwords   - number of 32-bit words in the blob
 *   *out_main_off - word offset of drygon_main within the blob
 *   *out_data_off - byte offset of the data section (page-aligned)
 * The blob is the .ros binary payload; no ELF, no .so, no gcc. */
/* Preprocess: expand #include "file" directives, skip other # lines.
 * Returns malloc'd buffer with expanded source, or NULL on error. */
/* ------ Runtime prelude -------------------------------------------------------------------------------------------------------------
 * Every compiled program gets this C text prepended by dc_preprocess_includes.
 * It is compiled by this same compiler, so machine-code patches such as `bl ftoa`
 * (emitted by the printf %f handler) and `bl str_concat` (emitted by the Python
 * front end for string +) resolve to these definitions. Each piece of the text is
 * kept short: DcToken.text caps a single string literal at 256 bytes. */
static char* dc_runtime_prelude(void) {
    char* p[1600];
    p[0] = "int errno = 0;\nstatic char drygon_fbuf[512];\nchar* ftoa_fixed(long bits, int prec);\n";
    /* Strings are built by copying: every str_concat/itoa10/ftoa result is a
     * fresh slice of this bump arena.  A single shared static buffer would be
     * clobbered by the inner call of a nested expression such as the
     * str_concat chain an f-string lowers to. */
    p[1] = "static char drygon_arena[1048576];\n";
    p[2] = "static int drygon_apos;\nstatic char* drygon_barena;\nstatic int drygon_bpos;\n";
    p[3] = "int drygon_slen(char* s) {\n";
    p[4] = "int i = 0;\n";
    p[5] = "while (s[i]) i = i + 1;\n";
    p[6] = "return i;\n";
    p[7] = "}\n";
    p[8] = "char* drygon_alloc(int n) {\n";
    p[9] = "if (n <= 0) n = 1;\nif (drygon_apos + n <= 1044480) {\nchar* r = drygon_arena + drygon_apos;\ndrygon_apos = drygon_apos + n;\nreturn r;\n}\n";
    p[10] = "if (n > 1040000) {\nlong g = _raw_syscall(222, 0, n + 16, 3, 34, -1, 0);\nif (g > 0) return (char*)g;\nreturn 0;\n}\n";
    p[11] = "if (drygon_bpos + n > 1044480) {\nlong m = _raw_syscall(222, 0, 1048576, 3, 34, -1, 0);\nif (m <= 0) return 0;\ndrygon_barena = (char*)m;\ndrygon_bpos = 0;\n}\n";
    p[12] = "char* q = drygon_barena + drygon_bpos;\ndrygon_bpos = drygon_bpos + n;\nreturn q;\n";
    p[13] = "}\n";
    p[14] = "char* str_concat(char* a, char* b) {\n";
    p[15] = "int la = drygon_slen(a);\n";
    p[16] = "int lb = drygon_slen(b);\n";
    p[17] = "char* r = drygon_alloc(la + lb + 1);\n";
    p[18] = "int i = 0;\n";
    p[19] = "while (i < la) { r[i] = a[i]; i = i + 1; }\n";
    p[20] = "i = 0;\n";
    p[21] = "while (i < lb) { r[la + i] = b[i]; i = i + 1; }\n";
    p[22] = "r[la + lb] = 0;\n";
    p[23] = "return r;\n";
    p[24] = "}\n";
    /* integer -> decimal string, used by f-string interpolation */
    p[25] = "char* itoa10(long v) {\n";
    p[26] = "char tmp[24];\n";
    p[27] = "int t = 24;\n";
    p[28] = "int neg = 0;\n";
    p[29] = "unsigned long u = (unsigned long)v;\n";
    p[30] = "if (v < 0) { neg = 1; u = 0 - u; }\n";
    p[31] = "if (u == 0) { t = t - 1; tmp[t] = 48; }\n";
    p[32] = "while (u > 0) {\n";
    p[33] = "unsigned long q = u / 10;\n";
    p[34] = "t = t - 1;\n";
    p[35] = "tmp[t] = 48 + (u - q * 10);\n";
    p[36] = "u = q;\n";
    p[37] = "}\n";
    p[38] = "int n = 24 - t + neg;\n";
    p[39] = "char* r = drygon_alloc(n + 1);\n";
    p[40] = "int i = 0;\n";
    p[41] = "if (neg) { r[0] = 45; i = 1; }\n";
    p[42] = "while (t < 24) { r[i] = tmp[t]; i = i + 1; t = t + 1; }\n";
    p[43] = "r[n] = 0;\n";
    p[44] = "return r;\n";
    p[45] = "}\n";
    /* double -> raw IEEE-754 bits, so an f-string can hand a double to ftoa */
    p[46] = "long drygon_dbits(double v) {\n";
    p[47] = "long b = *(long*)&v;\n";
    p[48] = "return b;\n";
    p[49] = "}\n";
    /* ftoa: shortest-roundtrip python repr.  p10t/recon first (C needs
