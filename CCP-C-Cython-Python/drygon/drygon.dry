        "FloatingPointError","IndexError","KeyError","LookupError","AttributeError",
        "ImportError","ModuleNotFoundError","NameError","OSError","IOError",
        "FileNotFoundError","StopIteration","NotImplementedError","KeyboardInterrupt",
        "SystemExit","AssertionError","MemoryError","RecursionError","UnicodeError",
        "UnicodeDecodeError","UnicodeEncodeError","SyntaxError","IndentationError",
        "TabError","PermissionError","ConnectionError","TimeoutError","Warning",
        "DeprecationWarning","UserWarning",0};
    int i = 0;
    while (k[i]) { if (d_strcmp(s, k[i]) == 0) return 1; i++; }
    return 0;
