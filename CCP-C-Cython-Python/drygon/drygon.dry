                                if (d_strcmp(pt,"int")==0) {
                                    const char* oc = cg_cps_obj_get(n->value, c->value, mpidx);
                                    if (!oc) oc = cg_mps_obj_get(n->value, c->value, mpidx);
                                    if (oc && oc[0]) {
                                        if (pemit) cg_put(g, ", ");
                                        cg_put(g, oc); cg_put(g, "* ");
