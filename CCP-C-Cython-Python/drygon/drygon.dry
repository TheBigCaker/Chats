        int k = 0, j = 0;
        while (k < b->nchildren) {
            const IRNode* c = b->children[k];
            if (c && d_strcmp(c->type,"ASSIGN")==0 && c->nchildren > 1 &&
                c->children[0] && d_strcmp(c->children[0]->type,"IDENTIFIER")==0) {
