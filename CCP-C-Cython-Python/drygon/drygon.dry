    /* ── truthiness / operators (dynamic dispatch on kind) ── */
    static int py_truth(PyValue v) {
        if (v.kind == PYV_NONE) return 0;
        if (v.kind == PYV_BOOL) return v.u.b != 0;
        if (v.kind == PYV_INT) return v.u.i != 0;
        if (v.kind == PYV_FLOAT) return v.u.f != 0.0;
        if (v.kind == PYV_STR) return v.u.s->len > 0;
        if (v.kind == PYV_LIST) return v.u.l->len > 0;
        if (v.kind == PYV_TUPLE) return v.u.t->len > 0;
        if (v.kind == PYV_DICT) return v.u.d->len > 0;
