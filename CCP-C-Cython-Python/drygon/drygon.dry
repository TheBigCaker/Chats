    /* splice `rep` over every use of `var` inside `n`, in place: the emitters
     * are stateless walks, so one shared node is safe */
    static void py_comp_subst(IRNode* n, const char* var, IRNode* rep) {
        if (!n) return;
        int i = 0;
        while (i < n->nchildren) {
            IRNode* ch = n->children[i];
            if (ch && d_strcmp(ch->type,"IDENTIFIER")==0 && ch->value &&
                d_strcmp(ch->value, var)==0) n->children[i] = rep;
            else py_comp_subst(ch, var, rep);
            i++;
        }
    }
    /* build `name` from a COMPLIST: reset the count, then the append loop */
    /* one clause of a comprehension that is not the first: it nests INSIDE
     * the loop before it, so the store below runs once per combination of
     * every clause's loop variable (`[x+y for x in a for y in b]`).
     *
     * clause layout -- COMPLIST: [elem, target, iter, cond?, rest?]
     *                   COMPDICT: [key, val, target, iter, cond?, rest?] */
    /* the loop a comprehension clause runs: `for VAR in range(...)` has to take
     * the canonical three-clause form the codegen emits for that builtin, so an
     * inner clause over `range` is lowered the same way the first clause is */
    static IRNode* py_comp_for(IRNode* vtgt, const IRNode* iter) {
        if (vtgt && d_strcmp(vtgt->type,"IDENTIFIER")==0 && vtgt->value &&
            iter && d_strcmp(iter->type,"CALL")==0 && d_strcmp(iter->value,"range")==0)
            return py_comp_range_for(vtgt->value, iter);
        IRNode* f = ir_new("FOR", "", "ANY");
        if (vtgt) ir_add_child(f, vtgt);
        else ir_add_child(f, ir_new("IDENTIFIER", "i", "ANY"));
        if (iter) ir_add_child(f, iter);
        return f;
    }
    /* `d.items()` as a comprehension iterable -- the source dictionary's own
