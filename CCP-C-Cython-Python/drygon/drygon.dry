            if (*f == 104) { len = 2; f = f + 1; if (*f == 104) { len = 1; f = f + 1; } }
            else if (*f == 108) { len = 3; f = f + 1; if (*f == 108) { len = 4; f = f + 1; } }
            else if (*f == 122 || *f == 106 || *f == 116) { len = 5; f = f + 1; }
            else if (*f == 76) { len = 6; f = f + 1; }
            c = *f;
