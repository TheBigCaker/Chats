                       d_strcmp(n->children[1]->type,"IDENTIFIER")==0) {
                /* A STATIC exception hierarchy: `issubclass(A, B)` folds to a
                 * compile-time 0/1.  Previously there was no handling at all,
                 * so it trapped (16_exceptions checks 31-36). */
                cg_put(g, (cg_cls_issub(n->children[0]->value, n->children[1]->value, 0) ||
                           cg_py_issubclass(n->children[0]->value, n->children[1]->value)) ? "1" : "0");
            } else if (d_strcmp(n->value,"isinstance")==0 && n->nchildren==2 &&
