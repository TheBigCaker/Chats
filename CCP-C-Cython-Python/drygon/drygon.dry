/* Base words are the verified AArch64 encodings: fadd d 0x1E602800, fsub d
 * 0x1E603800, fmul d 0x1E600800, fdiv d 0x1E601800. Rm sits at bit 16, Rn at
 * bit 5, Rd at bits 0-4. The earlier constants each carried a stray bit 16,
 * which bumped Rm by one and corrupted every double add/sub/mul/div. */
static uint32_t a_fadd_d(int dd, int dn, int dm) {
    return 0x1E602800 + (dm * 65536) + (dn * 32) + dd;
}
static uint32_t a_fsub_d(int dd, int dn, int dm) {
    return 0x1E603800 + (dm * 65536) + (dn * 32) + dd;
}
static uint32_t a_fmul_d(int dd, int dn, int dm) {
    return 0x1E600800 + (dm * 65536) + (dn * 32) + dd;
}
static uint32_t a_fdiv_d(int dd, int dn, int dm) {
    return 0x1E601800 + (dm * 65536) + (dn * 32) + dd;
}
/* single-precision twins: FADD/FSUB/FMUL/FDIV (Sn), encoding type bit 0x2000 */
static uint32_t a_fadd_s(int sd, int sn, int sm) {
    return 0x1E202800 + (sm * 65536) + (sn * 32) + sd;
}
static uint32_t a_fsub_s(int sd, int sn, int sm) {
    return 0x1E203800 + (sm * 65536) + (sn * 32) + sd;
}
static uint32_t a_fmul_s(int sd, int sn, int sm) {
    return 0x1E200800 + (sm * 65536) + (sn * 32) + sd;
}
static uint32_t a_fdiv_s(int sd, int sn, int sm) {
    return 0x1E201800 + (sm * 65536) + (sn * 32) + sd;
}
static uint32_t a_fcmp_d(int dn, int dm) {
    return 509616128 + (dm * 65536) + (dn * 32);
}
static uint32_t a_fneg_d(int dd, int dn) {
    return 509689856 + (dn * 32) + dd;
}
static uint32_t a_ldr_d(int dt, int rn, int imm) {
    return -46137344 + (((imm/8) % 4096) * 1024) + (rn * 32) + dt;
}
static uint32_t a_str_d(int dt, int rn, int imm) {
    return -50331648 + (((imm/8) % 4096) * 1024) + (rn * 32) + dt;
}
static uint32_t a_ldr_s(int dt, int rn, int imm) {
    return -1119879168 + (((imm/4) % 4096) * 1024) + (rn * 32) + dt;
}
static uint32_t a_str_s(int dt, int rn, int imm) {
    return -1124073472 + (((imm/4) % 4096) * 1024) + (rn * 32) + dt;
}
static uint32_t a_fcvt_d_s(int dd, int dn) {
    return 0x1E22C000 + (dn * 32) + dd;
}
static uint32_t a_fcvt_s_d(int dd, int dn) {
    return 0x1E624000 + (dn * 32) + dd;
}

/* condition codes */
enum { CC_EQ, CC_NE, CC_CS, CC_CC, CC_MI, CC_PL, CC_VS, CC_VC, CC_HI, CC_LS, CC_GE, CC_LT, CC_GT, CC_LE };

/* syscall numbers */
enum { SC_WRITE = 64, SC_EXIT = 93, SC_MMAP = 222, SC_MUNMAP = 215 };
static int g_dc_debug = 0;
/* Front-end error count from the last compile_program() run: nonzero means the
 * source did not parse cleanly (recovery reported each site). */
static int g_fe_errors = 0;
/* #define macro table: integer object-like macros recorded at top level.
 * Declared before the lexer because #if/#ifdef evaluation reads it. */
static char def_names_buf[65536];
static int def_values[1024];
/* 1 when def_values[i] really is the macro's body, i.e. the body is a plain
 * integer literal.  A text body (`#define P ((T*)0)`) leaves a number the
 * recorder happened to see first, so it must not be substituted as a value. */
static int def_isint[1024];
static int ndefs;
/* Function-like macros: `#define SQ(x) ((x)*(x))`.  The body is stored as raw
 * source text (span of the original buffer, NUL-terminated); expansion
 * substitutes parameter names and feeds the result to a sub-lexer. */
#define FM_MAX 512
static char fm_names_buf[FM_MAX * 64];
static int fm_nparams[FM_MAX];
static char fm_params_buf[FM_MAX * 8 * 64];
static char fm_body_buf[FM_MAX * 512];
static int fm_body_len[FM_MAX];
static int fm_n = 0;
/* Enum-constant table (flat globals, not Compiler members, so the struct
 * layout table stays valid). Holds every enumerator seen by the front end. */
static char enum_all_names_buf[65536];
static int enum_all_values[1024];
static int enum_all_n = 0;

/* ------ Code buffer with labels — the `Code` struct itself now lives above,
 * in THE JIT ENGINE section, so that its type name is known before the JIT
 * syscall emitter casts an mmap'd buffer to it. ------------------------------ */

static int hash_str(char* s) {
    int h = 5381;
    int k = 0;
    while (*s) {
        h = h * 33 + *s;
        s = s + 1;
        k = k + 1;
    }
    /* Keep the result inside 31 bits so the value is identical whether the
     * host does 32-bit or 64-bit int arithmetic (the self-hosted build only
     * has 64-bit ops) and always fits the 4-byte int slots hashes live in. */
    return h & 0x7FFFFFFF;
}
static int hash2_str(char* s) {
    /* FNV-1a, independent mixing from djb2; masked to 31 bits like hash_str */
    int h = 2166136261;
    while (*s) {
        h = (h ^ *s) * 16777619;
        s = s + 1;
    }
    return h & 0x7FFFFFFF;
}
static int hash_mem(char* s, int len) {
    int h = 5381;
    int i = 0;
    while (i < len) {
        h = h * 33 + (int)(unsigned char)s[i];
        i = i + 1;
    }
    return h & 0x7FFFFFFF;
}
static void code_emit(Code* c, uint32_t w) {
    if (c->nwords >= 8388608) {
        if (d_getenv("DRYGON_TRACE") != 0) { d_puts("TRACE nw: "); d_putdec(c->nwords); d_puts("\n"); }
        d_puts("words overflow\n"); sys_exit(1); }
    c->words[c->nwords] = w;
    c->nwords = c->nwords + 1;
}
static int code_find_label(Code* c, char* name) {
    int h = hash_str(name);
    int h2 = hash2_str(name);
    int slot = (h & 0x7FFFFFFF) % 524288;
    int start_slot = slot;
    while (c->label_hash[slot] != 0) {
        /* djb2 on 31 bits collides for distinct names; requiring a second,
         * independently mixed hash to agree keeps identity exact. */
        if (c->label_hash[slot] == h && c->label_h2[slot] == h2) {
            return c->label_idx[slot];
        }
        slot = (slot + 1) % 524288;
        if (slot == start_slot) break;
    }
    return -1;
}
static void code_label(Code* c, char* name) {
    if (c->nlabels >= MAX_LABELS) { d_puts("labels overflow\n"); sys_exit(1); }
    int h = hash_str(name);
    int slot = (h & 0x7FFFFFFF) % 524288;
    int start_slot = slot;
    while (c->label_hash[slot] != 0) {
        slot = (slot + 1) % 524288;
        if (slot == start_slot) { d_puts("label hash table full!\n"); sys_exit(1); }
    }
    c->label_hash[slot] = h;
    c->label_idx[slot] = c->nwords;
    c->label_h2[slot] = hash2_str(name);
    c->nlabels = c->nlabels + 1;
}
static void code_alias_label(Code* c, char* name, int idx) {
    if (c->nlabels >= MAX_LABELS) return;
    int h = hash_str(name);
    int slot = (h & 0x7FFFFFFF) % 524288;
    int start_slot = slot;
    while (c->label_hash[slot] != 0) {
        slot = (slot + 1) % 524288;
        if (slot == start_slot) return;
    }
    c->label_hash[slot] = h;
    c->label_idx[slot] = idx;
    c->label_h2[slot] = hash2_str(name);
    c->nlabels = c->nlabels + 1;
}
#define PATCH_NM_ARENA_SZ 1048576
static char g_patch_nm_arena[PATCH_NM_ARENA_SZ];
static int g_patch_nm_used;
static char g_patch_nm_fallback[2];
static void code_patch(Code* c, int idx, char* label, int kind, int cond, int rd) {
    if (c->npatches >= MAX_PATCHES) { d_puts("patches overflow\n"); sys_exit(1); }
    int h = hash_str(label);
    c->patch_idx[c->npatches] = idx;
    c->patch_hash[c->npatches] = h;
    c->patch_kind[c->npatches] = kind;
    c->patch_cond[c->npatches] = cond;
    c->patch_rd[c->npatches] = rd;
    /* code_patch receives stack buffers (gvl[80], lbl[32]); storing the pointer
     * directly left patch_nm dangling by resolve time, so UNRESOLVED prints
     * showed stack garbage instead of the real name. Copy into the arena. */
    if (g_patch_nm_used + 96 <= PATCH_NM_ARENA_SZ) {
        char* dst = g_patch_nm_arena + g_patch_nm_used;
        int ni = 0;
        while (label[ni] != 0 && ni < 94) { dst[ni] = label[ni]; ni = ni + 1; }
        dst[ni] = 0;
        g_patch_nm_used = g_patch_nm_used + ni + 1;
        c->patch_nm[c->npatches] = dst;
    } else {
        g_patch_nm_fallback[0] = 63; g_patch_nm_fallback[1] = 0; /* "?" */
        c->patch_nm[c->npatches] = g_patch_nm_fallback;
    }
    c->npatches = c->npatches + 1;
}
static int g_unresolved_patches;
static void code_resolve(Code* c, int code_vaddr, int data_vaddr, int data_start) {
    int i = 0;
    while (i < c->npatches) {
        int idx = c->patch_idx[i];
        int target = -1;
        int ph = c->patch_hash[i];
        int ph2 = hash2_str(c->patch_nm[i]);
        int slot = (ph & 0x7FFFFFFF) % 524288;
        int start_slot = slot;
        while (c->label_hash[slot] != 0) {
            if (c->label_hash[slot] == ph && c->label_h2[slot] == ph2) {
                target = c->label_idx[slot]; break;
            }
            slot = (slot + 1) % 524288;
            if (slot == start_slot) break;
        }
        if (target < 0) {
            /* No such label. Emitting nothing here used to leave `b .`/`bl .`
             * behind, so an undefined function looked like a program that hung
             * forever. Trap instead: the process dies at the bad call site. */
            if (c->patch_kind[i] != 3) c->words[c->patch_idx[i]] = 0xD4200000; /* brk #0 */
            d_puts("UNRESOLVED: ");
            d_puts(c->patch_nm[i]);
            d_puts(" kind=");
            d_putdec(c->patch_kind[i]);
            d_puts(" widx=");
            d_putdec(c->patch_idx[i]);
            d_puts("\n");
            g_unresolved_patches = g_unresolved_patches + 1;
            i++; continue;
        }
        int pkind = c->patch_kind[i];
        int imm = target - idx;
        if (pkind == 0) {
            c->words[idx] = a_b(imm);
        } else if (pkind == 1) {
            c->words[idx] = a_bl(imm);
        } else if (pkind == 2) {
            c->words[idx] = a_bcond(c->patch_cond[i], imm);
        } else if (pkind == 3) {
            int from = code_vaddr + idx * 4;
            int to = 0;
            if (target < data_start) {
                to = code_vaddr + target * 4;
            } else {
                to = data_vaddr + (target - data_start) * 4;
            }
            int to_off = to % 4096;
            if (to_off < 0) { to_off = to_off + 4096; }
            int from_off = from % 4096;
            if (from_off < 0) { from_off = from_off + 4096; }
            int rd = c->patch_rd[i];
            c->words[idx] = a_adrp(rd, (to - to_off) - (from - from_off));
            c->words[idx + 1] = a_addi(rd, rd, to_off);
        }
        i++;
    }
}

/* ------ String literal pool --------------------------------------------------------------------------------------------------------------------------------------------------------- */
#define MAX_STRINGS 65536
#define STR_POOL_BYTES (4194304) /* 4 MB owned string storage */
static int strings_data[MAX_STRINGS * 2];
static int strings_len[MAX_STRINGS];
static int strings_hash[MAX_STRINGS];
static int nstrings;
static char str_pool[STR_POOL_BYTES];
static int str_pool_used;
static int intern_string(char* s, int len) {
    int h = hash_mem(s, len);
    int i = 0;
    while (i < nstrings) {
        if (strings_hash[i] == h) {
            if (strings_len[i] == len) {
                char* s_data = (char*)get_ptr((long)strings_data, i);
                if (d_memcmp(s_data, s, len) == 0) {
                    return i;
                }
            }
        }
        i++;
    }
    /* copy into owned pool so the lexer's token buffer can be reused */
    if (nstrings >= MAX_STRINGS) return -1;
    if (str_pool_used + len + 1 > STR_POOL_BYTES) return -1;
    char* dst = str_pool + str_pool_used;
    d_memcpy(dst, s, len);
    dst[len] = 0;
    /* advance the pool cursor: without this every literal aliases str_pool+0 */
    str_pool_used = str_pool_used + len + 1;
    long dst_ptr = (long)dst;
    set_ptr((long)strings_data, nstrings, dst_ptr);
    strings_len[nstrings] = len;
    strings_hash[nstrings] = h;
    nstrings = nstrings + 1;
    return nstrings - 1;
}

/* ------ Drygon C tokenizer ------------------------------------------------------------------------------------------------------------------------------------------------------------ */
typedef enum {
    T_EOF, T_IDENT, T_NUM, T_STR, T_LPAREN, T_RPAREN, T_LBRACE, T_RBRACE,
    T_LBRACKET, T_RBRACKET, T_SEMI, T_COMMA, T_PLUS, T_MINUS, T_STAR, T_SLASH,
    T_PERCENT, T_LT, T_GT, T_LE, T_GE, T_EQ, T_NE, T_ASSIGN, T_AND, T_OR, T_NOT,
    T_INT, T_VOID, T_CHAR, T_FLOAT, T_DOUBLE, T_UNSIGNED, T_LONG, T_SHORT, T_SIGNED, T_RETURN, T_IF, T_ELSE, T_WHILE, T_FOR, T_STATIC,
    T_BREAK, T_CONTINUE, T_SIZE_T,
    T_STRUCT, T_TYPEDEF, T_INCLUDE, T_DEFINE, T_AMP, T_DOT, T_ARROW, T_COLON,
    T_QUESTION, T_LSHIFT, T_RSHIFT, T_ANDAND, T_OROR, T_INC, T_DEC, T_PLUSEQ,
    T_MINUSEQ, T_STAREQ, T_SLASHEQ, T_PERCENTEQ, T_AMPAMP, T_PIPEPIPE, T_PIPE,
    T_CARET, T_TILDE,
    /* C99 keywords added for full compliance */
    T_SWITCH, T_CASE, T_DEFAULT, T_DO, T_GOTO,
    T_ENUM, T_UNION, T_SIZEOF, T_CONST, T_VOLATILE, T_RESTRICT,
    T_BOOL, T_COMPLEX, T_IMAGINARY, T_INLINE, T_REGISTER, T_AUTO, T_EXTERN,
    T_THREAD_LOCAL, T_NORETURN, T_STATIC_ASSERT, T_ALIGNAS, T_ALIGNOF,
    T_GENERIC, T_ATOMIC, T_LABEL, T_DOTDOTDOT, T_HASHHASH,
    T_ATTRIBUTE, T_PACKED,
    T_PIPEEQ, T_AMPEQ, T_CARETEQ, T_LSHIFTEQ, T_RSHIFTEQ,
    T_UNKNOWN,
    /* wide string literal `L"..."` -- appended AFTER T_UNKNOWN on purpose:
     * numeric kind comparisons (T_STR==3, T_NUM==2) are load-bearing. */
    T_LSTR
} DcTokKind;

typedef struct DcToken {
    int kind;
    char text[2048];
    int num;
    double dval;
    int line;
    int pad;
    /* Long string literals (the compiler's own prelude slots are tens of KB)
     * used to be SILENTLY CUT at 2047 chars by the `ti < 2047` guard below,
     * which quietly turned a long literal into a different program.  They spill
     * into this heap buffer instead; NULL means "use text".  Declared LAST so
     * the hand-baked `(char*)tok + 2056` dval offsets stay correct. */
    char* big;
} DcToken;

typedef struct Lexer {
    char* src;
    int pos;
    int lex_line;
    DcToken tok;
    int has_tok;
    int rec;   /* error recovery: report + resync instead of aborting */
    int errs;  /* front-end error count for this compile */
    int brace_depth;   /* open { } blocks, tracked for depth-aware recovery */
    int pp_sp;         /* #if nesting depth */
    int pp_emit;       /* 0 while inside a false #if branch */
    int pp_taken[16];  /* one flag per nesting level: did any branch win? */
} Lexer;

static int is_ident_start(char c) {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95;
}
static int is_ident_char(char c) {
    return is_ident_start(c) || (c >= 48 && c <= 57);
}
static int is_digit(char c) { return c >= 48 && c <= 57; }

/* ------ preprocessor ---------------------------------------------------------
 * drygon.dry mixes Python-style `#` comment lines into its C region and guards
 * code with #ifdef/#ifndef/#if defined(...). `#define`/`#include` are handed to
 * the tokenizer unchanged (so the macro registry keeps working); every other
 * directive is consumed line-wise here, and a false branch is skipped
 * wholesale so the parser never sees its contents. The builtins mirror what a
 * seed compiler reports for the target (aarch64 Linux/Android, no NEON, no
 * SHA2 crypto extension) so that a bootstrap round is self-consistent. */
static int pp_is_word(char* s, char* w) {
    int i = 0;
    while (w[i]) {
        if (s[i] != w[i]) return 0;
        i = i + 1;
    }
    if (is_ident_char(s[i])) return 0;
    return 1;
}
/* true when position p is the first non-blank character of its line */
static int pp_line_start(char* s, int p) {
    int k = p - 1;
    while (k >= 0 && (s[k] == 32 || s[k] == 9)) k = k - 1;
    if (k < 0) return 1;
    return s[k] == 10;
}
/* first position past the logical line at p (honours backslash-continuation) */
static int pp_eol(char* s, int p) {
    while (s[p]) {
        if (s[p] == 10) {
            if (p > 0 && s[p - 1] == 92) { p = p + 1; continue; }
            return p + 1;
        }
        p = p + 1;
    }
    return p;
}
/* start of the directive word on the `#` line at p */
static int pp_word(char* s, int p) {
    int q = p + 1;
    while (s[q] == 32 || s[q] == 9) q = q + 1;
    return q;
}
/* move to absolute position t, keeping the line counter correct */
static int pp_goto(Lexer* l, int p, int t) {
    while (p < t) {
        if (l->src[p] == 10) l->lex_line = l->lex_line + 1;
        p = p + 1;
    }
    return p;
}
static int pp_builtin(char* n, int* val) {
    *val = 0;
    if (d_strcmp(n, "__aarch64__") == 0) { *val = 1; return 1; }
    if (d_strcmp(n, "__linux__") == 0) { *val = 1; return 1; }
    if (d_strcmp(n, "__ANDROID__") == 0) { *val = 1; return 1; }
    if (d_strcmp(n, "__LP64__") == 0) { *val = 1; return 1; }
    return 0;
}
static int pp_lookup(char* n, int* val) {
    int i = 0;
    *val = 0;
    while (i < ndefs) {
        if (d_strcmp(def_names_buf + i * 64, n) == 0) { *val = def_values[i]; return 1; }
        i = i + 1;
    }
    return 0;
}
static int pp_defined(char* n) {
    int v = 0;
    if (pp_lookup(n, &v)) return 1;
    if (pp_builtin(n, &v)) return 1;
    return 0;
}
static int pp_value(char* n) {
    int v = 0;
    if (pp_lookup(n, &v)) return v;
    if (pp_builtin(n, &v)) return v;
    return 0;
}
/* evaluate `defined(NAME)` / `defined NAME` at position p */
/* #undef NAME: remove the row from both the integer table (def_*) and the
 * body table (fm_*) by shift-down compaction — both are linearly scanned, so
 * a tombstone would still expand. */
static void pp_undef(char* n) {
    int i = 0;
    while (i < ndefs) {
        if (d_strcmp(def_names_buf + i * 64, n) == 0) {
            int k = i;
            while (k < ndefs - 1) {
                d_memcpy(def_names_buf + k * 64, def_names_buf + (k + 1) * 64, 64);
                def_values[k] = def_values[k + 1];
                def_isint[k] = def_isint[k + 1];
                k = k + 1;
            }
            ndefs = ndefs - 1;
            break;
        }
        i = i + 1;
    }
    i = 0;
    while (i < fm_n) {
        if (d_strcmp(fm_names_buf + i * 64, n) == 0) {
            int k = i;
            while (k < fm_n - 1) {
                d_memcpy(fm_names_buf + k * 64, fm_names_buf + (k + 1) * 64, 64);
                d_memcpy(fm_body_buf + k * 512, fm_body_buf + (k + 1) * 512, 512);
                fm_nparams[k] = fm_nparams[k + 1];
                fm_body_len[k] = fm_body_len[k + 1];
                k = k + 1;
            }
            fm_n = fm_n - 1;
            break;
        }
        i = i + 1;
    }
}
static void pp_undef_at(char* s, int p) {
    char nm[64];
    int n = 0;
    while (s[p] == 32 || s[p] == 9) p = p + 1;
    while (is_ident_char(s[p]) && n < 63) { nm[n] = s[p]; n = n + 1; p = p + 1; }
    nm[n] = 0;
    if (n) pp_undef(nm);
}
static int pp_defined_at(char* s, int p) {
    char nm[64];
    int n = 0;
    while (s[p] == 32 || s[p] == 9) p = p + 1;
    while (is_ident_char(s[p]) && n < 63) { nm[n] = s[p]; n = n + 1; p = p + 1; }
    nm[n] = 0;
    return pp_defined(nm);
}
static int pp_prim(Lexer* l, char* s, int* pp);
static int pp_unary(Lexer* l, char* s, int* pp);
static int pp_mul(Lexer* l, char* s, int* pp);
static int pp_add(Lexer* l, char* s, int* pp);
static int pp_shift(Lexer* l, char* s, int* pp);
static int pp_rel(Lexer* l, char* s, int* pp);
static int pp_eq(Lexer* l, char* s, int* pp);
static int pp_bit_and(Lexer* l, char* s, int* pp);
static int pp_bit_xor(Lexer* l, char* s, int* pp);
static int pp_bit_or(Lexer* l, char* s, int* pp);
static int pp_and(Lexer* l, char* s, int* pp);
static int pp_or(Lexer* l, char* s, int* pp);

static int pp_prim(Lexer* l, char* s, int* pp) {
    int p = *pp;
    while (s[p] == 32 || s[p] == 9) p = p + 1;
    if (s[p] == 40) {
        p = p + 1;
        *pp = p;
        int v = pp_or(l, s, pp);
        p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 41) p = p + 1;
        *pp = p;
        return v;
    }
    if (s[p] == 39) {
        p = p + 1;
        int ch = 0;
        if (s[p] == 92) {
            p = p + 1;
            if (s[p] == 110) ch = 10;
            else if (s[p] == 116) ch = 9;
            else if (s[p] == 114) ch = 13;
            else if (s[p] == 48) ch = 0;
            else ch = (unsigned char)s[p];
            p = p + 1;
        } else {
            ch = (unsigned char)s[p];
            p = p + 1;
        }
        if (s[p] == 39) p = p + 1;
        *pp = p;
        return ch;
    }
    if (s[p] == 48 && (s[p + 1] == 120 || s[p + 1] == 88)) {
        p = p + 2;
        int v = 0;
        while ((s[p] >= 48 && s[p] <= 57) || (s[p] >= 97 && s[p] <= 102) || (s[p] >= 65 && s[p] <= 70)) {
            int d = 0;
            if (s[p] >= 48 && s[p] <= 57) d = s[p] - 48;
            else if (s[p] >= 97 && s[p] <= 102) d = s[p] - 97 + 10;
            else d = s[p] - 65 + 10;
            v = v * 16 + d;
            p = p + 1;
        }
        *pp = p;
        return v;
    }
    if (is_digit(s[p])) {
        int v = 0;
        while (is_digit(s[p])) { v = v * 10 + (s[p] - 48); p = p + 1; }
        *pp = p;
        return v;
    }
    if (is_ident_start(s[p])) {
        char nm[64];
        int n = 0;
        while (is_ident_char(s[p]) && n < 63) { nm[n] = s[p]; n = n + 1; p = p + 1; }
        while (is_ident_char(s[p])) p = p + 1;
        nm[n] = 0;
        if (d_strcmp(nm, "defined") == 0) {
            int paren = 0;
            while (s[p] == 32 || s[p] == 9) p = p + 1;
            if (s[p] == 40) { paren = 1; p = p + 1; }
            int v = pp_defined_at(s, p);
            while (s[p] == 32 || s[p] == 9) p = p + 1;
            while (is_ident_char(s[p])) p = p + 1;
            while (s[p] == 32 || s[p] == 9) p = p + 1;
            if (paren && s[p] == 41) p = p + 1;
            *pp = p;
            return v;
        }
        *pp = p;
        return pp_value(nm);
    }
    *pp = p;
    return 0;
}
static int pp_unary(Lexer* l, char* s, int* pp) {
    int p = *pp;
    while (s[p] == 32 || s[p] == 9) p = p + 1;
    if (s[p] == 33) {
        p = p + 1;
        *pp = p;
        if (pp_unary(l, s, pp) != 0) return 0;
        return 1;
    }
    if (s[p] == 126) {
        p = p + 1;
        *pp = p;
        return ~pp_unary(l, s, pp);
    }
    if (s[p] == 43) {
        p = p + 1;
        *pp = p;
        return pp_unary(l, s, pp);
    }
    if (s[p] == 45) {
        p = p + 1;
        *pp = p;
        return 0 - pp_unary(l, s, pp);
    }
    *pp = p;
    return pp_prim(l, s, pp);
}
static int pp_mul(Lexer* l, char* s, int* pp) {
    int v = pp_unary(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 42) {
            *pp = p + 1;
            int r = pp_unary(l, s, pp);
            v = v * r;
        } else if (s[p] == 47) {
            *pp = p + 1;
            int r = pp_unary(l, s, pp);
            if (r != 0) v = v / r; else v = 0;
        } else if (s[p] == 37) {
            *pp = p + 1;
            int r = pp_unary(l, s, pp);
            if (r != 0) v = v % r; else v = 0;
        } else {
            break;
        }
    }
    return v;
}
static int pp_add(Lexer* l, char* s, int* pp) {
    int v = pp_mul(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 43) {
            *pp = p + 1;
            int r = pp_mul(l, s, pp);
            v = v + r;
        } else if (s[p] == 45) {
            *pp = p + 1;
            int r = pp_mul(l, s, pp);
            v = v - r;
        } else {
            break;
        }
    }
    return v;
}
static int pp_shift(Lexer* l, char* s, int* pp) {
    int v = pp_add(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 60 && s[p + 1] == 60) {
            *pp = p + 2;
            int r = pp_add(l, s, pp);
            v = v << r;
        } else if (s[p] == 62 && s[p + 1] == 62) {
            *pp = p + 2;
            int r = pp_add(l, s, pp);
            v = v >> r;
        } else {
            break;
        }
    }
    return v;
}
static int pp_rel(Lexer* l, char* s, int* pp) {
    int v = pp_shift(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 60 && s[p + 1] == 61) {
            *pp = p + 2;
            int r = pp_shift(l, s, pp);
            if (v <= r) v = 1; else v = 0;
        } else if (s[p] == 62 && s[p + 1] == 61) {
            *pp = p + 2;
            int r = pp_shift(l, s, pp);
            if (v >= r) v = 1; else v = 0;
        } else if (s[p] == 60 && s[p + 1] != 60) {
            *pp = p + 1;
            int r = pp_shift(l, s, pp);
            if (v < r) v = 1; else v = 0;
        } else if (s[p] == 62 && s[p + 1] != 62) {
            *pp = p + 1;
            int r = pp_shift(l, s, pp);
            if (v > r) v = 1; else v = 0;
        } else {
            break;
        }
    }
    return v;
}
static int pp_eq(Lexer* l, char* s, int* pp) {
    int v = pp_rel(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 61 && s[p + 1] == 61) {
            *pp = p + 2;
            int r = pp_rel(l, s, pp);
            if (v == r) v = 1; else v = 0;
        } else if (s[p] == 33 && s[p + 1] == 61) {
            *pp = p + 2;
            int r = pp_rel(l, s, pp);
            if (v != r) v = 1; else v = 0;
        } else {
            break;
        }
    }
    return v;
}
static int pp_bit_and(Lexer* l, char* s, int* pp) {
    int v = pp_eq(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 38 && s[p + 1] != 38) {
            *pp = p + 1;
            int r = pp_eq(l, s, pp);
            v = v & r;
        } else {
            break;
        }
    }
    return v;
}
static int pp_bit_xor(Lexer* l, char* s, int* pp) {
    int v = pp_bit_and(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 94) {
            *pp = p + 1;
            int r = pp_bit_and(l, s, pp);
            v = v ^ r;
        } else {
            break;
        }
    }
    return v;
}
static int pp_bit_or(Lexer* l, char* s, int* pp) {
    int v = pp_bit_xor(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (s[p] == 124 && s[p + 1] != 124) {
            *pp = p + 1;
            int r = pp_bit_xor(l, s, pp);
            v = v | r;
        } else {
            break;
        }
    }
    return v;
}
static int pp_and(Lexer* l, char* s, int* pp) {
    int v = pp_bit_or(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (!(s[p] == 38 && s[p + 1] == 38)) break;
        *pp = p + 2;
        int r = pp_bit_or(l, s, pp);
        if (v != 0 && r != 0) v = 1; else v = 0;
    }
    return v;
}
static int pp_or(Lexer* l, char* s, int* pp) {
    int v = pp_and(l, s, pp);
    while (1) {
        int p = *pp;
        while (s[p] == 32 || s[p] == 9) p = p + 1;
        if (!(s[p] == 124 && s[p + 1] == 124)) break;
        *pp = p + 2;
        int r = pp_and(l, s, pp);
        if (v != 0 || r != 0) v = 1; else v = 0;
    }
    return v;
}
/* Skip an inactive branch line-wise up to the matching #else/#elif (returned
 * unconsumed so the caller re-evaluates it) or past its #endif. Nested
 * conditionals are counted so an inner #endif cannot end the outer region. */
static int pp_skip_to_branch(Lexer* l, char* s, int p, int depth) {
    int level = depth;
    while (s[p]) {
        int k = p;
        while (s[k] == 32 || s[k] == 9) k = k + 1;
        if (s[k] == 35) {
            int w = pp_word(s, k);
            if (pp_is_word(s + w, "if") || pp_is_word(s + w, "ifdef") || pp_is_word(s + w, "ifndef")) {
                level = level + 1;
            } else if (pp_is_word(s + w, "endif")) {
                level = level - 1;
                if (level < depth) {
                    l->pp_sp = level;
                    l->pp_emit = 1;
                    return pp_eol(s, p);
                }
            } else if (level == depth) {
                if (pp_is_word(s + w, "else") || pp_is_word(s + w, "elif")) return p;
            }
        }
        p = pp_eol(s, p);
    }
    return p;
}

/* Power of ten by binary exponentiation. Identical code exists in the
 * runtime prelude (drygon_pow10) so literal parsing and the float
 * roundtrip check share one rounding chain. Callers split |k| > 308. */
static double d_pow10(int k) {
    double r = 1.0;
    double b = 10.0;
    while (k > 0) {
        if (k % 2 == 1) { r = r * b; }
        if (b < 1.0e150) { b = b * b; }
        k = k / 2;
    }
    return r;
}
/* Double-double core multiply (Dekker/Knuth two-product + two-sum).
 * The identical body is emitted in the runtime prelude as drygon_dd_core. */
static void d_dd_core(double ah, double al, double bh, double bl, double* oh, double* ol) {
    /* prescale: split products a1*b1 can round up past DBL_MAX even when the
     * true product is finite (split error ~2^-27 rel); scale by exact 1/2 so
     * every internal product stays far below overflow, unscale by 4 at end */
    double us = 1.0;
    double p = ah * bh;
    if (p > 1.0e308 || p < -1.0e308) {
        us = 4.0;
        ah = ah * 0.5; al = al * 0.5;
        bh = bh * 0.5; bl = bl * 0.5;
        p = ah * bh;
    }
    double sp = 134217729.0;
    double g1 = sp * ah;
    double a1 = g1 - (g1 - ah);
    double a0 = ah - a1;
    double g2 = sp * bh;
    double b1 = g2 - (g2 - bh);
    double b0 = bh - b1;
    double e = ((a1 * b1 - p) + a1 * b0 + a0 * b1) + a0 * b0;
    e = e + ah * bl + al * bh;
    double s = p + e;
    if (s != s) { *oh = 1.0e308 * 10.0; *ol = 0.0; return; }
    if (s > 1.0e308 || s < -1.0e308) { *oh = s * us; *ol = 0.0; return; }
    *ol = (e - (s - p)) * us;
    *oh = s * us;
}
/* dd multiply with subnormal rescaling: products in the subnormal band are
 * computed at x2^600 scale and divided back, so the two-sum terms stay
 * representable. Emitted as drygon_dd_mul in the prelude. */
static void d_dd_mul(double ah, double al, double bh, double bl, double* oh, double* ol) {
    double p = ah * bh;
    if (p != 0.0 && p > -2.2250738585072014e-308 && p < 2.2250738585072014e-308) {
        double sc = 2.0;
        sc = sc * sc; sc = sc * sc; sc = sc * sc; sc = sc * sc;
        sc = sc * sc; sc = sc * sc; sc = sc * sc; sc = sc * sc;
        sc = sc * 17592186044416.0;
        double f2 = sc * sc;
        double t1; double t2;
        d_dd_core(ah * sc, al * sc, bh * sc, bl * sc, &t1, &t2);
        *oh = t1 / f2;
        *ol = t2 / f2;
        return;
    }
    d_dd_core(ah, al, bh, bl, oh, ol);
}
/* dd power of ten by binary exponentiation; k < 0 uses the exact 1/10
 * pair (bh, bl). Emitted as drygon_pow10_dd in the prelude. */
static void d_pow10_dd(int k, double* oh, double* ol) {
    double rh = 1.0;
    double rl = 0.0;
    double bh = 10.0;
    double bl = 0.0;
    if (k < 0) {
        k = 0 - k;
        bh = 1.0 / 10.0;
        bl = ((1.0 - 8.0 * bh) - 2.0 * bh) / 10.0;
    }
    while (k > 0) {
        if (k % 2 == 1) { double th; double tl; d_dd_mul(rh, rl, bh, bl, &th, &tl); rh = th; rl = tl; }
        if (bh < 1.0e150) { double th; double tl; d_dd_mul(bh, bl, bh, bl, &th, &tl); bh = th; bl = tl; }
        k = k / 2;
    }
    *oh = rh;
    *ol = rl;
}
/* dd-precision literal tail parser: scans fraction + exponent from p and
 * converts mv * 10^E exactly the way the validated reference d_parse does,
 * including the tie-corrected scaled branch for the subnormal band. */
static void d_lexnum(long v64, char* s, int p, int iskip, int* pout, double* fvout, int* isfout) {
    long mv = v64;
    int fd = 0;
    int skip = 0;
    int en = 0;
    int eneg = 0;
    int isf = 0;
    if (s[p] == 46) {
        isf = 1;
        p++;
        while (s[p] >= 48 && s[p] <= 57) {
            fd = fd + 1;
            if (mv < 100000000000000000) { mv = mv * 10 + (s[p] - 48); } else { skip = skip + 1; }
            p++;
        }
    }
    if (s[p] == 101 || s[p] == 69) {
        int j = p + 1;
        int eok = 0;
        if (s[j] >= 48 && s[j] <= 57) eok = 1;
        else if ((s[j] == 43 || s[j] == 45) && s[j + 1] >= 48 && s[j + 1] <= 57) eok = 1;
        if (eok) {
            isf = 1;
            if (s[j] == 45) eneg = 1;
            p = j;
            if (s[p] == 43 || s[p] == 45) { p = p + 1; }
            while (s[p] >= 48 && s[p] <= 57) { en = en * 10 + (s[p] - 48); p++; }
        }
    }
    *pout = p;
    *isfout = isf;
    if (!isf) { *fvout = (double)v64; return; }
    int E;
    if (eneg) { E = 0 - en - fd + skip + iskip; } else { E = en - fd + skip + iskip; }
    if (E > 308) { *fvout = 1.0e308 * 10.0; return; }
    double mh = (double)mv;
    double ml = (double)(mv - (long)mh);
    int h2 = E / 2;
    int l2 = E - h2;
    double ph1 = 1.0; double pl1 = 0.0;
    double ph2 = 1.0; double pl2 = 0.0;
    double ih = 0.0; double il = 0.0;
    double oh = 0.0; double ol = 0.0;
    d_pow10_dd(h2, &ph1, &pl1);
    d_pow10_dd(l2, &ph2, &pl2);
    d_dd_mul(mh, ml, ph1, pl1, &ih, &il);
    double p2 = ih * ph2;
    if (p2 != 0.0 && p2 > -4.4501477170144023e-308 && p2 < 4.4501477170144023e-308) {
        double sc = 2.0;
        sc = sc * sc; sc = sc * sc; sc = sc * sc; sc = sc * sc;
        sc = sc * sc; sc = sc * sc; sc = sc * sc; sc = sc * sc;
        sc = sc * 17592186044416.0;
        double f2 = sc * sc;
        d_dd_core(ih * sc, il * sc, ph2 * sc, pl2 * sc, &oh, &ol);
        double q = oh / f2;
        *fvout = q + (oh - q * f2 + ol) / f2;
        return;
    }
    d_dd_mul(ih, il, ph2, pl2, &oh, &ol);
    *fvout = oh + ol;
}
static void lex_next(Lexer* l) {
    char* s = l->src;
    int p = l->pos;
    /* skip whitespace and comments */
    while (1) {
        while (s[p] == 32 || s[p] == 9 || s[p] == 10 || s[p] == 13) {
            if (s[p] == 10) l->lex_line = l->lex_line + 1;
            p++;
        }
        if (s[p] == 92 && (s[p + 1] == 10 || (s[p + 1] == 13 && s[p + 2] == 10))) {
            p++;
            continue;
        }
        if (s[p] == 35 && pp_line_start(s, p)) {
            int w = pp_word(s, p);
            if (pp_is_word(s + w, "define") || pp_is_word(s + w, "include")) {
                if (l->pp_emit) { p = p + 1; continue; }   /* tokenize as before */
                p = pp_goto(l, p, pp_eol(s, p));
                continue;
            }
            if (pp_is_word(s + w, "if") || pp_is_word(s + w, "ifdef") || pp_is_word(s + w, "ifndef")) {
                int act = 0;
                if (l->pp_emit) {
                    if (pp_is_word(s + w, "ifdef")) {
                        act = pp_defined_at(s, w + 5);
                    } else if (pp_is_word(s + w, "ifndef")) {
                        act = pp_defined_at(s, w + 6);
                        if (act) act = 0; else act = 1;
                    } else {
                        int q = w + 2;
                        act = pp_or(l, s, &q);
                    }
                }
                if (l->pp_sp < 16) {
                    if (act) l->pp_taken[l->pp_sp] = 1; else l->pp_taken[l->pp_sp] = 0;
                }
                l->pp_sp = l->pp_sp + 1;
                if (act == 0) l->pp_emit = 0;
                p = pp_eol(s, p);
                if (l->pp_emit == 0) p = pp_goto(l, p, pp_skip_to_branch(l, s, p, l->pp_sp));
                continue;
            }
            if (pp_is_word(s + w, "else") || pp_is_word(s + w, "elif")) {
                int act = 0;
                if (l->pp_sp > 0) {
                    int lvl = l->pp_sp - 1;
                    if (l->pp_taken[lvl] == 0) {
                        if (pp_is_word(s + w, "else")) {
                            act = 1;
                        } else {
                            int q = w + 4;
                            act = pp_or(l, s, &q);
                        }
                        if (act) { l->pp_taken[lvl] = 1; l->pp_emit = 1; }
                    }
                }
                if (act == 0) l->pp_emit = 0;
                p = pp_eol(s, p);
                if (act == 0) p = pp_goto(l, p, pp_skip_to_branch(l, s, p, l->pp_sp));
                continue;
            }
            if (pp_is_word(s + w, "endif")) {
                if (l->pp_sp > 0) l->pp_sp = l->pp_sp - 1;
                l->pp_emit = 1;
                p = pp_goto(l, p, pp_eol(s, p));
                continue;
            }
            if (pp_is_word(s + w, "undef")) {
                if (l->pp_emit) pp_undef_at(s, w + 5);
                p = pp_goto(l, p, pp_eol(s, p));
                continue;
            }
            /* `#` comment line (# note, #pragma, #error, ...) */
            p = pp_goto(l, p, pp_eol(s, p));
            continue;
        }
        if (s[p] == 47 && s[p+1] == 47) {
            while (s[p] && s[p] != 10) p++;
            continue;
        }
        if (s[p] == 47 && s[p+1] == 42) {
            p = p + 2;
            while (s[p] && !(s[p] == 42 && s[p+1] == 47)) {
                if (s[p] == 10) l->lex_line = l->lex_line + 1;
                p++;
            }
            if (s[p]) p = p + 2;
            continue;
        }
        break;
    }
    l->pos = p;
    DcToken* t = &l->tok;
    t->line = l->lex_line;
    t->text[0] = 0;
    t->num = 0;
    t->big = 0;
    char c = s[p];
    if (c == 0) { t->kind = T_EOF; return; }
    if (is_ident_start(c)) {
        int start = p;
        while (is_ident_char(s[p])) p++;
        int len = p - start;
        if (len > 2047) len = 2047;   /* t->text is 2048 bytes including the NUL */
        d_memcpy(t->text, s + start, len);
        t->text[len] = 0;
        l->pos = p;
        /* wide literal prefix: `L'x'` / `L"..."`. For the ASCII range the
         * value is identical to the narrow form. A wide STRING keeps its own
         * kind (T_LSTR) so comp_primary can widen each element to 4 bytes;
         * a wide CHAR just re-lexes to the narrow value. */
        if (len == 1 && t->text[0] == 76 && (s[p] == 39 || s[p] == 34)) {
            int lq = s[p];
            lex_next(l);
            /* l->has_tok is still 0 here, so lex_cur would lex the NEXT token
             * and clobber the just-parsed literal; inspect l->tok directly. */
            if (lq == 34 && l->tok.kind == T_STR) l->tok.kind = T_LSTR;
            return;
        }
        if (d_strcmp(t->text, "int") == 0) t->kind = T_INT;
        else if (d_strcmp(t->text, "void") == 0) t->kind = T_VOID;
        else if (d_strcmp(t->text, "char") == 0) t->kind = T_CHAR;
        else if (d_strcmp(t->text, "float") == 0) t->kind = T_FLOAT;
        else if (d_strcmp(t->text, "double") == 0) t->kind = T_DOUBLE;
        else if (d_strcmp(t->text, "unsigned") == 0) t->kind = T_UNSIGNED;
        else if (d_strcmp(t->text, "long") == 0) t->kind = T_LONG;
        else if (d_strcmp(t->text, "short") == 0) t->kind = T_SHORT;
        else if (d_strcmp(t->text, "signed") == 0) t->kind = T_SIGNED;
        else if (d_strcmp(t->text, "size_t") == 0) t->kind = T_SIZE_T;
        else if (d_strcmp(t->text, "return") == 0) t->kind = T_RETURN;
        else if (d_strcmp(t->text, "if") == 0) t->kind = T_IF;
        else if (d_strcmp(t->text, "else") == 0) t->kind = T_ELSE;
        else if (d_strcmp(t->text, "while") == 0) t->kind = T_WHILE;
        else if (d_strcmp(t->text, "for") == 0) t->kind = T_FOR;
        else if (d_strcmp(t->text, "static") == 0) t->kind = T_STATIC;
        else if (d_strcmp(t->text, "struct") == 0) t->kind = T_STRUCT;
        else if (d_strcmp(t->text, "typedef") == 0) t->kind = T_TYPEDEF;
        else if (d_strcmp(t->text, "switch") == 0) t->kind = T_SWITCH;
        else if (d_strcmp(t->text, "case") == 0) t->kind = T_CASE;
