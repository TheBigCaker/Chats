                                    if (dv && d_strcmp(dv,"staticmethod")==0) mfl = mfl | 16;
                                    if (dv && d_strcmp(dv,"classmethod")==0) mfl = mfl | 32;
                                    /* `@value.setter` / `@value.deleter` rebind
