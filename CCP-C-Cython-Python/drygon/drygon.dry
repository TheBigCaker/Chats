            }
            cg_indent(g); cg_put(g, "drygon_rl_n = 0;\n");
            cg_indent(g); cg_put(g, itm); cg_put(g, "___iter__(&");
            cg_put(g, itn); cg_put(g, ");\n");
            cg_indent(g);
            cg_put(g, "int "); cg_put(g, v->value); cg_put(g, "; int _gi = 0;\n");
            g->indent++;
            cg_indent(g);
            cg_put(g, "while (_gi < drygon_rl_n) { ");
            cg_put(g, v->value); cg_put(g, " = drygon_rl[_gi];\n");
            if (body) cg_gen_block(g, body);
            cg_indent(g);
            cg_put(g, "_gi = _gi + 1; }\n");
            g->indent--;
            cg_indent(g);
            cg_put(g, "}\n");
