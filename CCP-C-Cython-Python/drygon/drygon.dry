                    cg_put_int(g, xr); cg_put(g, " = ");
                    cg_gen_expr(g, arhs);
                    cg_put(g, "; int _xk"); cg_put_int(g, xr);
                    cg_put(g, " = 0; while (_xk"); cg_put_int(g, xr);
                    cg_put(g, " < ");
