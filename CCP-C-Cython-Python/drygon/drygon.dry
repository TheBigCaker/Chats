                                    mbody0->nchildren==1 &&
                                    d_strcmp(mbody0->children[0]->type,"RETURN")==0 &&
                                    mbody0->children[0]->nchildren==1) {
                                    const IRNode* rv2 = mbody0->children[0]->children[0];
                                    if (rv2 && d_strcmp(rv2->type,"CALL")==0 && rv2->value &&
                                        rv2->value[0] &&
                                        d_strcmp(rv2->value,"COMPLEX")!=0 &&
