                                if (it->nchildren == 0) { cg_put(g, "\"\""); return; }
                                if (it->nchildren == 1) { cg_gen_expr(g, it->children[0]); return; }
                                { int z = 1; while (z < it->nchildren) { cg_put(g, "str_concat(str_concat("); z++; } }
                                cg_gen_expr(g, it->children[0]);
                                int k = 1;
                                while (k < it->nchildren) {
                                    cg_put(g, ", ");
                                    cg_gen_expr(g, target->children[0]);
                                    cg_put(g, "), ");
                                    cg_gen_expr(g, it->children[k]);
                                    cg_put(g, ")");
                                    k++;
                                }
                                return;
                            }
                            {   /* sep.join("abc") iterates the characters of the
                                 * string, not a list */
                                if (it && cg_is_str_node(it)) {
                                    cg_put(g, "drygon_join_chars(");
                                    cg_gen_expr(g, target->children[0]);
                                    cg_put(g, ", ");
                                    cg_gen_expr(g, it);
                                    cg_put(g, ")");
                                    return;
                                }
                                /* anything else: fall back to a runtime join over
