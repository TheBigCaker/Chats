                            int mj = cg_cls_nmeth[ci];
                            d_strncpy(cg_cls_methnames[ci*48 + mj], c->value, 31); cg_cls_methnames[ci*48 + mj][31] = 0;
                            cg_cls_mret[ci][mj] = mdt;
                            /* the decorators of this def sit immediately before
