        d_strncpy(dst + 0, "import io\n\n\"\"\"logging     a small Drygon-native implementation of the logging module.\n\nImplements the subset the completeness suite exercises.  Inheritance is used\nonly so `isinstance(x, Handler)` holds: every method is re-declared in the\nsubclass because a backend-inlined subclass does not dispatch to a module\nbase-class method (it reads a garbage slot instead).\n\"\"\"\n\nDEBUG = 10\nINFO = 20\nWARNING = 30\nERROR = 40\nCRITICAL = 50\nNOTSET = 0\n\n_disable_level = 0\n\n\nclass Formatter:\n    def __init__(self, fmt=\"%(message)s\"):\n        self._fmt = fmt\n\n    def format(self, levelname, message):\n        s = self._fmt\n        s = s.replace(\"%(levelname)s\", levelname)\n        s = s.replace(\"%(message)s\", message)\n        s = s.replace(\"%(name)s\", \"\")\n        s = s.replace(\"%(levelno)s\", \"\")\n        return s\n\n\nclass Handler:\n    def __init__(self):\n        self.formatter = Formatter(\"%(message)s\")\n        self.stream = 0\n        self._closed = 0\n        self._buf = \"\"\n\n    def setFormatter(self, f):\n        self.formatter = f\n        return 0\n\n    def close(self):\n        self._closed = 1\n        return 0\n\n    def emit(self, levelname, message):\n        return 0\n\n\nclass StreamHandler(Handler):\n    def __init__(self, stream=0):\n        self.formatter = Formatter(\"%(message)s\")\n        self.stream = stream\n        self._closed = 0\n        self._buf = \"\"\n\n    def setFormatter(self, f):\n        self.formatter = f\n        return 0\n\n    def close(self):\n        self._closed = 1\n        return 0\n\n    def emit(self, levelname, message):\n        if self.stream != 0:\n            s = self.formatter.format(levelname, message)\n            self.stream.write(s + \"\\n\")\n        return 0\n\n\nclass FileHandl", 1700);
