                    int isfpart = 0;
                    if (node && d_strcmp(node->type,"MEMBER_ACCESS")==0 &&
                        d_strcmp(node->value,"partial")==0 && node->nchildren > 0 &&
                        node->children[0] && d_strcmp(node->children[0]->type,"IDENTIFIER")==0 &&
                        d_strcmp(node->children[0]->value,"functools")==0) isfpart = 1;
                    /* `fib.cache_clear()` / `fib.cache_info()` on a memoized
                     * function: the memo table is a set of globals, so the
                     * method reads them directly. */
                    int lsl = -1;
                    if (node && d_strcmp(node->type,"MEMBER_ACCESS")==0 && node->nchildren > 0 &&
                        node->children[0] && d_strcmp(node->children[0]->type,"IDENTIFIER")==0)
                        lsl = py_lru_index(node->children[0]->value);
                    if (isfpart) {
                        IRNode* call2 = ir_new("CALL", "COMPLEX", "ANY");
                        ir_add_child(call2, node);
                        parse_arg_list(p, call2, TOK_RPAREN);
                        IRNode* pp = ir_new("CALL", "drygon_partial", "ANY");
                        int pi3 = 1;
                        while (pi3 < call2->nchildren) { ir_add_child(pp, call2->children[pi3]); pi3++; }
                        node = pp;
                    } else if (lsl >= 0 && d_strcmp(node->value,"cache_clear")==0) {
                        IRNode* cc = ir_new("CALL", "drygon_lru_clear", "ANY");
                        ir_add_child(cc, ir_new("CONSTANT", py_int_const(lsl), "INT"));
                        while (pk(p)->kind != TOK_RPAREN && pk(p)->kind != TOK_NEWLINE &&
                               pk(p)->kind != TOK_EOF) advance(p);
                        if (pk(p)->kind == TOK_RPAREN) advance(p);
                        node = cc;
                    } else if (lsl >= 0 && d_strcmp(node->value,"cache_info")==0) {
                        IRNode* ci = ir_new("CALL", "drygon_lru_hits", "ANY");
                        ir_add_child(ci, ir_new("CONSTANT", py_int_const(lsl), "INT"));
                        while (pk(p)->kind != TOK_RPAREN && pk(p)->kind != TOK_NEWLINE &&
                               pk(p)->kind != TOK_EOF) advance(p);
                        if (pk(p)->kind == TOK_RPAREN) advance(p);
                        node = ci;
                    } else {
                    IRNode* call = ir_new("CALL", "COMPLEX", "ANY");
                    ir_add_child(call, node);
                    parse_arg_list(p, call, TOK_RPAREN);
                    node = call;
                    }
                }
            } else if (pk(p)->kind == TOK_LBRACK) {
                advance(p);
                /* slice: s[i:j] / s[i:] / s[:j] / s[i:j:k] */
                IRNode* sl_start = NULL;
                if (pk(p)->kind != TOK_COLON) sl_start = parse_expr(p);
                if (pk(p)->kind == TOK_COLON) {
                    advance(p);
                    IRNode* sl_stop = NULL;
                    /* an empty field (`s[::k]`) leaves the next colon to the step */
                    if (pk(p)->kind != TOK_COLON && pk(p)->kind != TOK_RBRACK &&
                        pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_NEWLINE)
                        sl_stop = parse_expr(p);
                    IRNode* sl_step = NULL;
                    if (pk(p)->kind == TOK_COLON) {
                        advance(p);
                        if (pk(p)->kind != TOK_RBRACK && pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_NEWLINE)
                            sl_step = parse_expr(p);
                    }
                    if (pk(p)->kind == TOK_RBRACK) advance(p);
                    IRNode* sl = ir_new("SLICE", "", "STR");
                    ir_add_child(sl, node);
                    ir_add_child(sl, sl_start ? sl_start : ir_new("CONSTANT","0","INT"));
                    ir_add_child(sl, sl_stop ? sl_stop : ir_new("CONSTANT","2147483647","INT"));
                    /* with a step the omitted bounds are sign dependent, so the
                     * helper is told which of them the source actually wrote */
                    if (sl_step) {
                        ir_add_child(sl, sl_step);
                        ir_add_child(sl, ir_new("CONSTANT", sl_start ? "1" : "0", "INT"));
                        ir_add_child(sl, ir_new("CONSTANT", sl_stop ? "1" : "0", "INT"));
                    }
                    node = sl;
                } else {
                    IRNode* acc = ir_new("ARRAY_ACCESS", "", "ANY");
                    ir_add_child(acc, node);
                    if (sl_start) ir_add_child(acc, sl_start);
                    if (pk(p)->kind == TOK_RBRACK) advance(p);
                    node = acc;
                }
            } else if (pk(p)->kind == TOK_DOT) {
                advance(p);
                if (pk(p)->kind == TOK_NAME) {
                    /* `info.hits` where `info` holds a cache_info() snapshot:
                     * the four counters live in their own globals. */
                    const char* sfd = py_snap_field(node, pk(p)->text);
                    if (sfd) {
                        IRNode* si = ir_new("IDENTIFIER", sfd, "ANY");
                        advance(p);
                        node = si;
                    } else {
                    IRNode* ma = ir_new("MEMBER_ACCESS", pk(p)->text, ".");
                    ir_add_child(ma, node);
                    advance(p);
                    node = ma;
                    }
                } else {
                    break;
                }
            } else {
                break;
            }
        }
