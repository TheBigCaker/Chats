    p[1463] = "if (i > 0 && s[i - 1] == 10) return n;\nreturn n + 1;\n}\n";
    p[1464] = "char* drygon_sl_get(char* s, int k) {\nint i = 0;\nint c = 0;\nint j = 0;\nchar* r = drygon_rbuf();\nwhile (s[i] && c < k) { if (s[i] == 10) c = c + 1; i = i + 1; }\n";
