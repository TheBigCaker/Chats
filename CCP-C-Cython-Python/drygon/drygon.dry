                else if (cg_is_float_node(a)) { cg_put(g, "(int)("); cg_gen_expr(g, a); cg_put(g, ")"); }
                else cg_gen_expr(g, a);
            } else if (d_strcmp(n->value,"type")==0 && n->nchildren==1) {
                /* `type(x)`: a small integer tag per python type, so
