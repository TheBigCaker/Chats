                        cg_put(g, f_is_str ? "char* " : "int ");
                        cg_put(g, c->children[0]->value); cg_put(g, ";\n");
                    }
                }
                /* `self.<f> = ...` writes inside methods define instance
                 * fields; infer the type from the right-hand side */
