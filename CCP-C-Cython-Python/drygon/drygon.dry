                            cg_gen_expr(g, a0);
                            cg_put(g, ")");
                            return;
                        }
                        if (d_strcmp(m,"remove")==0 && a0 && !a1) {
                            cg_put(g, nm); cg_put(g, "_n = drygon_lremove_"); cg_put(g, sfx);
                            cg_put(g, "(");
                            cg_put(g, nm); cg_put(g, ", "); cg_put(g, nm); cg_put(g, "_n, ");
                            cg_gen_expr(g, a0);
                            cg_put(g, ")");
                            return;
                        }
                        if (d_strcmp(m,"insert")==0 && a0 && a1) {
                            cg_put(g, "drygon_lins_"); cg_put(g, sfx); cg_put(g, "(");
                            cg_put(g, nm); cg_put(g, ", "); cg_put(g, nm); cg_put(g, "_n, ");
                            cg_gen_expr(g, a0);
                            cg_put(g, ", ");
                            cg_gen_expr(g, a1);
                            cg_put(g, ")");
                            cg_put(g, ";\n");
                            cg_indent(g);
                            cg_put(g, nm); cg_put(g, "_n = "); cg_put(g, nm); cg_put(g, "_n + 1");
                            return;
                        }
                        if (d_strcmp(m,"add")==0 && a0 && !a1) {
                            cg_put(g, "if (drygon_lindex_"); cg_put(g, sfx); cg_put(g, "(");
                            cg_put(g, nm); cg_put(g, ", "); cg_put(g, nm); cg_put(g, "_n, ");
                            cg_gen_expr(g, a0);
                            cg_put(g, ") < 0) { ");
                            cg_put(g, nm); cg_put(g, "["); cg_put(g, nm); cg_put(g, "_n] = ");
                            if (lt == 2 && !cg_node_is_str_static(a0)) cg_strify(g, a0);
                            else cg_gen_expr(g, a0);
                            cg_put(g, "; ");
                            cg_put(g, nm); cg_put(g, "_n = "); cg_put(g, nm); cg_put(g, "_n + 1; }");
                            return;
                        }
                        if (d_strcmp(m,"discard")==0 && a0 && !a1) {
                            cg_put(g, nm); cg_put(g, "_n = drygon_lremove_"); cg_put(g, sfx);
                            cg_put(g, "(");
                            cg_put(g, nm); cg_put(g, ", "); cg_put(g, nm); cg_put(g, "_n, ");
                            cg_gen_expr(g, a0);
                            cg_put(g, ")");
