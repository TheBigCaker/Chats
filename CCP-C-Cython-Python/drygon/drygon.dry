    static int py_gt(PyValue a, PyValue b) { return py_lt(b, a); }
    static int py_le(PyValue a, PyValue b) { return !py_gt(a, b); }
    static int py_ge(PyValue a, PyValue b) { return !py_lt(a, b); }
    /* ── repr / str / print ── */
    static char _py_repr_buf[4096];
    static char* py_repr(PyValue v) {
        if (v.kind == PYV_NONE) { d_strcpy(_py_repr_buf, "None"); return _py_repr_buf; }
        if (v.kind == PYV_BOOL) { d_strcpy(_py_repr_buf, v.u.b ? "True" : "False"); return _py_repr_buf; }
        if (v.kind == PYV_INT) {
            long long x = v.u.i; int neg = x < 0; unsigned long long ux = neg ? -x : x;
            char tmp[32]; int ti = 0, ri = 0;
            if (neg) _py_repr_buf[ri++] = '-';
            if (ux == 0) _py_repr_buf[ri++] = '0';
            while (ux > 0) { _py_repr_buf[ri++] = (char)('0' + (ux % 10)); ux /= 10; }
            _py_repr_buf[ri] = 0;
            /* reverse digits after '-' */
            int s2 = neg ? 1 : 0, e2 = ri - 1;
            while (s2 < e2) { char t = _py_repr_buf[s2]; _py_repr_buf[s2] = _py_repr_buf[e2]; _py_repr_buf[e2] = t; s2++; e2--; }
            return _py_repr_buf;
        }
        if (v.kind == PYV_FLOAT) {
            d_snprintf(_py_repr_buf, sizeof(_py_repr_buf), "%g", v.u.f);
            return _py_repr_buf;
        }
        if (v.kind == PYV_STR) return v.u.s->data;
        if (v.kind == PYV_LIST) {
            long long i;
            _py_repr_buf[0] = '['; int rp = 1;
            for (i = 0; i < v.u.l->len; i++) {
                if (i > 0) _py_repr_buf[rp++] = ',';
                char* part = py_repr(v.u.l->items[i]);
                long long pl = d_strlen(part);
                if (rp + pl + 2 < (long long)sizeof(_py_repr_buf)) { cymap_copy(_py_repr_buf + rp, part, pl); rp += pl; }
            }
            _py_repr_buf[rp++] = ']'; _py_repr_buf[rp] = 0;
            return _py_repr_buf;
        }
        if (v.kind == PYV_DICT) { d_strcpy(_py_repr_buf, "{...}"); return _py_repr_buf; }
        d_strcpy(_py_repr_buf, "<object>");
        return _py_repr_buf;
    }
    /* print(*values) — newline-terminated, native output */
    static void py_print(PyValue v) {
        printf("%s\n", py_repr(v));
    }
    static void py_print_nolf(PyValue v) {
        printf("%s", py_repr(v));
    }
    /* ── dynamic method dispatch: obj.method(...) ──
     * args is a caller-built PyValue array; returns PyValue.
     * Unknown method on known type → returns None (surfaced by the
     * exception layer once wired into the generator). */
    static PyValue py_method_call(PyValue self, const char* name, int nargs, PyValue* args) {
        if (self.kind == PYV_LIST) {
            PyList* l = self.u.l;
            if (d_strcmp(name, "append") == 0) { py_list_append(l, args[0]); return pyv_none(); }
            if (d_strcmp(name, "pop") == 0) return py_list_pop(l, nargs > 0 && args[0].kind == PYV_INT ? args[0].u.i : -1);
            if (d_strcmp(name, "insert") == 0) { py_list_insert(l, args[0].u.i, args[1]); return pyv_none(); }
            if (d_strcmp(name, "remove") == 0) { py_list_remove(l, args[0]); return pyv_none(); }
            if (d_strcmp(name, "index") == 0) return pyv_int(py_list_find(l, args[0]));
            if (d_strcmp(name, "count") == 0) {
                long long c = 0, i;
                for (i = 0; i < l->len; i++) if (py_eq(l->items[i], args[0])) c++;
                return pyv_int(c);
            }
            if (d_strcmp(name, "reverse") == 0) { py_list_reverse(l); return pyv_none(); }
            if (d_strcmp(name, "clear") == 0) { l->len = 0; return pyv_none(); }
            if (d_strcmp(name, "copy") == 0) {
                PyList* r = py_list_new(); long long i;
                for (i = 0; i < l->len; i++) py_list_append(r, l->items[i]);
                return pyv_list(r);
            }
            if (d_strcmp(name, "extend") == 0 && args[0].kind == PYV_LIST) {
                long long i;
                for (i = 0; i < args[0].u.l->len; i++) py_list_append(l, args[0].u.l->items[i]);
                return pyv_none();
            }
        }
        if (self.kind == PYV_STR) {
            PyStr* s = self.u.s;
            if (d_strcmp(name, "upper") == 0) return pyv_str(py_str_upper(s));
            if (d_strcmp(name, "lower") == 0) return pyv_str(py_str_lower(s));
            if (d_strcmp(name, "strip") == 0) return pyv_str(py_str_strip(s));
            if (d_strcmp(name, "replace") == 0) return pyv_str(py_str_replace(s, args[0].u.s, args[1].u.s));
            if (d_strcmp(name, "find") == 0) return pyv_int(py_str_find(s, args[0].u.s));
            if (d_strcmp(name, "split") == 0) return pyv_list(py_str_split(s, nargs > 0 ? args[0].u.s : py_str_new(" ", 1)));
            if (d_strcmp(name, "join") == 0) return pyv_str(py_str_join(s, args[0].u.l));
            if (d_strcmp(name, "startswith") == 0) return pyv_bool(py_str_find(s, args[0].u.s) == 0);
            if (d_strcmp(name, "endswith") == 0) {
                long long pos = s->len - args[0].u.s->len;
                if (pos < 0) return pyv_bool(0);
                int m = 1; long long i;
                for (i = 0; i < args[0].u.s->len; i++)
                    if (s->data[pos+i] != args[0].u.s->data[i]) { m = 0; break; }
                return pyv_bool(m);
            }
        }
        if (self.kind == PYV_DICT) {
            PyDict* d = self.u.d;
            if (d_strcmp(name, "get") == 0) return py_dict_get(d, args[0], nargs > 1 ? args[1] : pyv_none());
            if (d_strcmp(name, "keys") == 0) return pyv_list(py_dict_keys(d));
            if (d_strcmp(name, "values") == 0) return pyv_list(py_dict_values(d));
            if (d_strcmp(name, "pop") == 0) {
                PyValue v = py_dict_get(d, args[0], nargs > 1 ? args[1] : pyv_none());
                py_dict_del(d, args[0]);
                return v;
            }
            if (d_strcmp(name, "update") == 0 && args[0].kind == PYV_DICT) {
                PyDict* o = args[0].u.d; long long i;
                for (i = 0; i < o->cap; i++)
                    if (o->slots[i].used) py_dict_set(d, o->slots[i].key, o->slots[i].val);
                return pyv_none();
            }
            if (d_strcmp(name, "clear") == 0) {
                d->len = 0; long long i;
                for (i = 0; i < d->cap; i++) {
                    PyEntry* slot = &d->slots[i];
                    slot->used = 0;
                }
                return pyv_none();
            }
            /* set methods (a set is a PyDict with unused val slots) */
            if (d_strcmp(name, "add") == 0) { py_dict_set(d, args[0], pyv_none()); return pyv_none(); }
            if (d_strcmp(name, "remove") == 0) { py_dict_del(d, args[0]); return pyv_none(); }
            if (d_strcmp(name, "discard") == 0) { py_dict_del(d, args[0]); return pyv_none(); }
            if (d_strcmp(name, "__contains__") == 0) return pyv_bool(py_dict_has(d, args[0]));
        }
        return pyv_none();
    }
    /* ── EXCEPTIONS — pending-flag model (no setjmp: pure C, portable to
