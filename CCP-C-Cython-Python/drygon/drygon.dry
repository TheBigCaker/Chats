            if (alhs && d_strcmp(alhs->type,"IDENTIFIER")==0 && arhs &&
                d_strcmp(arhs->type,"CALL")==0 && d_strcmp(arhs->value,"COMPLEX")!=0 &&
                cg_is_class(arhs->value)) {
                const char* cn = arhs->value;
                /* REBINDING: `a = Animal(...)` then later `a = Counter()` must
