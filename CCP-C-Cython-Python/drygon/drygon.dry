         * The flattened row store is `NAME_back[NAME_off[i] + j]`, so the cell
         * is a string exactly when the row element kind is. */
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 &&
            a->children[0] && d_strcmp(a->children[0]->type,"ARRAY_ACCESS")==0 &&
            a->children[0]->nchildren>0 && a->children[0]->children[0] &&
            d_strcmp(a->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            cg_list_twod_kind(a->children[0]->children[0]->value) == 1)
            return 1;
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0) {
            const IRNode* b = a->children[0];
            if (b && d_strcmp(b->type,"CALL")==0 && d_strcmp(b->value,"COMPLEX")==0 &&
                b->nchildren>0 && d_strcmp(b->children[0]->type,"MEMBER_ACCESS")==0)
                return 1;
            /* `e.args[i]` and `<name>[i]` for a split/exception string list are
