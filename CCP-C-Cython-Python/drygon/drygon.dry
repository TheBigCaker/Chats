     * `b_n` all resolve to `a`'s storage and an append through either name is
     * seen through the other (29_copy check 5).  The view name itself is never
     * declared (see the list declaration loop). */
    static const char* cg_list_view_of(const char* name); /* fwd decl */
    static const char* cg_dict_view_of(const char* name); /* fwd decl */
    static void cg_put(CGen* g, const char* s) {
        { const char* _vs = cg_list_view_of(s); if (_vs) s = _vs; }
        { const char* _vd = cg_dict_view_of(s); if (_vd) s = _vd; }
        size_t l = d_strlen(s);
        if (g->pos + l + 1 > g->cap) {
            size_t ncap = g->cap ? g->cap*2 : 4096;
            while (g->pos + l + 1 > ncap) ncap *= 2;
            char* nb = (char*)d_alloc(ncap);
            if (g->buf) d_memcpy(nb, g->buf, g->pos);
            g->buf = nb; g->cap = ncap;
        }
        d_memcpy(g->buf + g->pos, s, l);
        g->pos += l;
        g->buf[g->pos] = '\0';
    }
    static void cg_indent(CGen* g) {
        for (int i=0;i<g->indent;i++) cg_put(g, "    ");
    }
