                        else if (d_strcmp(m,"format")==0) {
                            /* "{} {1}".format(...) → runtime placeholder fill */
                            cg_put(g, "drygon_fmt(");
                            cg_gen_expr(g, target->children[0]);
                            for (int i=1;i<=6;i++) {
                                cg_put(g, ", ");
                                if (i < n->nchildren) {
                                    const IRNode* fa = n->children[i];
                                    if (fa && d_strcmp(fa->type,"KWARG")==0 && fa->nchildren > 0)
                                        cg_strify(g, fa->children[0]);
                                    else
                                        cg_strify(g, fa);
                                } else cg_put(g, "0");
                            }
                            cg_put(g, ")");
                            return;
                        }
                        else if (d_strcmp(m,"format_map")==0) {
