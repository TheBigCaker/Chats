                        IRNode* pc = ir_new("CALL", pfn, "ANY");
                        int pb = 0;
                        while (pb < pnb) {
                            const IRNode* ba = py_partial_bound(node->value, pb);
                            if (ba && d_strcmp(ba->type,"KWARG")==0) break;
                            if (ba) ir_add_child(pc, ir_clone(ba));
                            pb++;
                        }
                        int pk2 = 0;
                        while (pk2 < call->nchildren) { ir_add_child(pc, call->children[pk2]); pk2++; }
                        while (pb < pnb) {
                            const IRNode* ba = py_partial_bound(node->value, pb);
                            if (ba) ir_add_child(pc, ir_clone(ba));
                            pb++;
                        }
                        node = pc;
                    } else if (d_strcmp(node->value,"partial")==0 && call->nchildren >= 2 &&
                        call->children[0] && d_strcmp(call->children[0]->type,"IDENTIFIER")==0) {
                        /* `partial(f, a, ...)`: hold the pieces for the
                         * assignment that names the result. */
                        IRNode* pp = ir_new("CALL", "drygon_partial", "ANY");
                        int pi2 = 0;
                        while (pi2 < call->nchildren) { ir_add_child(pp, call->children[pi2]); pi2++; }
                        node = pp;
                    } else if (d_strcmp(node->value,"sorted")==0 && call->nchildren==2 &&
                        call->children[1]->type && d_strcmp(call->children[1]->type,"KWARG")==0 &&
                        d_strcmp(call->children[1]->value,"reverse")==0 &&
                        call->children[1]->nchildren==1 &&
                        call->children[1]->children[0]->type &&
                        d_strcmp(call->children[1]->children[0]->type,"CONSTANT")==0 &&
                        d_strcmp(call->children[1]->children[0]->data_type,"BOOL")==0) {
                        /* reverse=False keeps the plain sorted() call */
                        int rev = d_strcmp(call->children[1]->children[0]->value,"0")!=0;
                        IRNode* r2 = ir_new("CALL", rev ? "sorted_r" : "sorted", "ANY");
                        ir_add_child(r2, call->children[0]);
                        node = r2;
                    } else if (d_strcmp(node->value,"sorted")==0 && call->nchildren==2 &&
                        call->children[1]->type && d_strcmp(call->children[1]->type,"KWARG")==0 &&
                        d_strcmp(call->children[1]->value,"key")==0 &&
                        call->children[1]->nchildren==1 && cg_cmpk_fn(call->children[1]->children[0])) {
                        /* `sorted(xs, key=cmp_to_key(f))`: keep the comparator
                         * name so the statement lowering can sort with it. */
                        IRNode* r4 = ir_new("CALL", "sorted_cmpk", "ANY");
                        ir_add_child(r4, call->children[0]);
                        ir_add_child(r4, ir_new("IDENTIFIER",
                            cg_cmpk_fn(call->children[1]->children[0]), "ANY"));
                        node = r4;
                    } else if (d_strcmp(node->value,"sorted")==0 && call->nchildren==2 &&
                        call->children[1]->type && d_strcmp(call->children[1]->type,"KWARG")==0 &&
                        d_strcmp(call->children[1]->value,"key")==0 &&
                        call->children[1]->nchildren==1 &&
                        call->children[1]->children[0]->type &&
                        d_strcmp(call->children[1]->children[0]->type,"UNARY_OP")==0 &&
