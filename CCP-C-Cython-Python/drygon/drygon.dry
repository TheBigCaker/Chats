                        break;
                    }
                    advance(p);
                }
            }
            if (has_type) {
                IRNode* vd = NULL;
                if (is_array) {
                    vd = ir_new("ARRAY_DECL", lhs, dt);
                    if (arr_sz[0]) ir_add_child(vd, ir_new("CONSTANT", arr_sz, "INT"));
                } else {
                    vd = ir_new("VAR_DECL", lhs, dt);
                }
                if (pk(p)->kind == TOK_EQ) {
                    advance(p);
                    IRNode* val = parse_expr(p);
                    if (val) ir_add_child(vd, val);
                }
                return vd;
            }
            if (pk(p)->kind == TOK_EQ) {
                advance(p);
                /* chained assignment `a = b = 5` stores the value into every
                 * target; python allows it and C's assignment expression is
                 * not handled by the direct compiler, so emit one store per
                 * name in sequence. */
                IRNode* chain = NULL;
                while (pk(p)->kind == TOK_NAME && pk2(p)->kind == TOK_EQ) {
                    if (!chain) chain = ir_new("BLOCK","SEQ","ANY");
                    ir_add_child(chain, ir_new("IDENTIFIER", pk(p)->text, "ANY"));
                    advance(p);
                    advance(p);
                }
                IRNode* val = parse_expr(p);
                if (pk(p)->kind == TOK_COMMA) {
                    IRNode* tup = ir_new("BLOCK", "TUPLE", "ANY");
                    if (val) ir_add_child(tup, val);
                    while (pk(p)->kind == TOK_COMMA) {
                        advance(p);
                        if (pk(p)->kind == TOK_EOF || pk(p)->kind == TOK_NEWLINE) break;
                        IRNode* x = parse_expr(p);
                        if (x) ir_add_child(tup, x);
                    }
                    val = tup;
                }
                if (chain) {
                    IRNode* blk = ir_new("BLOCK","SEQ","ANY");
                    int ci = 0;
                    while (ci < chain->nchildren) {
                        IRNode* ac = ir_new("ASSIGN","=","ANY");
                        ir_add_child(ac, chain->children[ci]);
                        if (val) ir_add_child(ac, val);
                        ir_add_child(blk, ac);
                        ci++;
                    }
                    IRNode* af = ir_new("ASSIGN","=","ANY");
                    ir_add_child(af, target);
                    if (val) ir_add_child(af, val);
                    ir_add_child(blk, af);
                    return blk;
                }
                if (val && target && d_strcmp(target->type,"IDENTIFIER")==0) {
                    if (d_strcmp(val->type,"CALL")==0 &&
                        d_strcmp(val->value,"drygon_partial")==0 && val->nchildren >= 2) {
                        /* `p = partial(f, ...)`: there are no function values
                         * here, so the binding is recorded and every later
                         * `p(...)` is expanded into a plain `f(...)` call.
                         * The name itself only needs to exist. */
                        py_partial_bind(target->value, val->children[0]->value,
                                        val->children, val->nchildren);
                        val = ir_new("CONSTANT", "0", "INT");
                    } else if (d_strcmp(val->type,"CALL")==0 &&
                               d_strcmp(val->value,"drygon_lru_hits")==0 &&
                               val->nchildren >= 1) {
                        /* `info = fib.cache_info()`: copy the four counters out
                         * of the memo table now, so a later cache_clear() does
                         * not rewrite the snapshot (26_functools 17). */
                        py_snap_add(target->value);
                        IRNode* blk = ir_new("BLOCK","SEQ","ANY");
                        int sf = 0;
                        while (sf < 4) {
                            const char* fld = "hits";
                            const char* cfn = "drygon_lru_hits";
                            if (sf == 1) { fld = "misses"; cfn = "drygon_lru_misses"; }
                            if (sf == 2) { fld = "size"; cfn = "drygon_lru_size"; }
                            if (sf == 3) { fld = "maxsize"; cfn = "drygon_lru_maxsize"; }
                            IRNode* as = ir_new("ASSIGN","=","ANY");
                            ir_add_child(as, ir_new("IDENTIFIER",
                                py_snap_name(target->value, fld), "ANY"));
                            IRNode* cv = ir_new("CALL", cfn, "ANY");
                            ir_add_child(cv, ir_clone(val->children[0]));
                            ir_add_child(as, cv);
                            ir_add_child(blk, as);
                            sf++;
                        }
                        return blk;
                    }
                }
                IRNode* a = ir_new("ASSIGN", "=", "ANY");
                ir_add_child(a, target);
                if (val) ir_add_child(a, val);
                return a;
            }
            /* compound assignment += -= etc. */
            if (pk(p)->kind == TOK_OP && (d_strstr(pk(p)->text,"=")!=NULL && d_strcmp(pk(p)->text,"==")!=0 && d_strcmp(pk(p)->text,"!=")!=0 && d_strcmp(pk(p)->text,"<=")!=0 && d_strcmp(pk(p)->text,">=")!=0)) {
                char op[8]; d_strncpy(op, pk(p)->text, 7); op[7]='\0';
                advance(p);
                IRNode* val = parse_expr(p);
                IRNode* a = ir_new("ASSIGN", op, "ANY");
                /* Use the already-parsed `target`, not a fresh IDENTIFIER: a
                 * subscript target (`counts[word] += 1`) would otherwise be
                 * flattened to its base name, emitting a scalar `counts += 1`
                 * whose address never resolves. */
                ir_add_child(a, target);
                if (val) ir_add_child(a, val);
                return a;
            }
            /* !an assignment — expression statement */
            p->ts->pos = save;
            IRNode* e = parse_expr(p);
            IRNode* es = ir_new("EXPR_STMT", "", "ANY");
            if (e) ir_add_child(es, e);
            return es;
        }
        /* expression statement (call, etc.) */
        IRNode* e = parse_expr(p);
        IRNode* es = ir_new("EXPR_STMT", "", "ANY");
        if (e) ir_add_child(es, e);
        return es;
    }
    /* Parse a full Python module into an IR PROGRAM. */
    /* Nested-function naming state.  C has a single flat namespace, so two
     * nested `def inner` in different outers collided -- the later definition
     * replaced the earlier one (57_nonlocal_global check 4).  A nested def is
     * renamed `outer_inner`, and CALL nodes to it are rewritten in the
     * ENCLOSING body afterwards.  A name is only mangled when the SAME
     * function name is defined more than once in the file, which keeps every
     * other test byte-identical. */
    /* how many FUNCTION_DEFs in the whole program carry this name */
    static int py_fdef_count(const IRNode* n, const char* nm) {
        int c = 0, i = 0;
        if (!n) return 0;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 && d_strcmp(n->value, nm)==0) c++;
        while (i < n->nchildren) { c += py_fdef_count(n->children[i], nm); i++; }
        return c;
    }
    /* Names carried by more than one FUNCTION_DEF anywhere in the program,
     * captured BEFORE any mangling.  Counting live hid the second of two
     * same-named nested defs: renaming the first dropped the count back to one,
     * so `make_counter`'s `inc` stayed a plain `inc` while the alias at the
     * call site reached the other body -- the two counters shared one `count`
     * cell and checks 54-56 of 11_functions read a list address (1704040). */
    static char py_dup_names[64][64];
    static int py_ndup_names;
    static int py_dupname_has(const char* nm) {
        int i = 0;
        while (i < py_ndup_names) { if (d_strcmp(py_dup_names[i], nm)==0) return 1; i++; }
        return 0;
    }
    static void py_dupname_scan(const IRNode* n, const IRNode* prog) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 && n->value && n->value[0] &&
            py_fdef_count(prog, n->value) > 1 && !py_dupname_has(n->value) &&
            py_ndup_names < 64) {
            d_strncpy(py_dup_names[py_ndup_names], n->value, 63);
            py_dup_names[py_ndup_names][63] = 0;
            py_ndup_names++;
        }
        i = 0;
        while (i < n->nchildren) { py_dupname_scan(n->children[i], prog); i++; }
    }
    static void py_rename_calls(IRNode* n, const char* from, const char* to, int depth) {
        int i = 0;
        if (!n) return;
        /* a nested FUNCTION_DEF of the same name shadows: stop descending */
        if (depth > 0 && d_strcmp(n->type,"FUNCTION_DEF")==0 && d_strcmp(n->value, from)==0) return;
        if (d_strcmp(n->type,"CALL")==0 && d_strcmp(n->value, from) == 0) {
            d_strncpy(n->value, to, 63); n->value[63] = 0;
        }
        while (i < n->nchildren) { py_rename_calls(n->children[i], from, to, depth+1); i++; }
    }
    /* `outer` is the enclosing function's (possibly already mangled) name */
    static void py_fix_nested(IRNode* body, const char* outer, const IRNode* prog) {
        int i = 0;
        if (!body) return;
        while (i < body->nchildren) {
            IRNode* c = body->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && py_dupname_has(c->value)) {
                char nn[128]; int nl = 0, ri = 0;
                while (outer && outer[nl] && nl < 110) { nn[nl] = outer[nl]; nl++; }
                if (nl < 118) nn[nl++] = 95;
                while (c->value[ri] && nl < 126) { nn[nl++] = c->value[ri]; ri++; }
                nn[nl] = 0;
                char oldn[64]; d_strncpy(oldn, c->value, 63); oldn[63] = 0;
                d_strncpy(c->value, nn, 63); c->value[63] = 0;
                /* rewrite calls in the ENCLOSING body (not inside a same-named
                 * nested def, which shadows it) */
                py_rename_calls(body, oldn, c->value, 0);
                /* descend: this def becomes the outer for ITS nested defs */
                if (c->nchildren > 0) py_fix_nested(c->children[c->nchildren-1], c->value, prog);
            } else if (c && d_strcmp(c->type,"FUNCTION_DEF")==0) {
                if (c->nchildren > 0) py_fix_nested(c->children[c->nchildren-1], c->value, prog);
            }
            i++;
        }
    }
    /* ── python-local variable isolation ─────────────────────────────────────
     * C has a single flat file-scope namespace, so a function-local assignment
     * to a name that also exists at module scope collides with the module
     * binding (10_control: module `result = "big"` vs `fizzbuzz`'s list
     * `result` share one declaration).  When a function-local name collides
     * with a module-level binding we rename the local to `_<fn>_<name>`.  The
     * rewrite only fires for names that really collide, keeping every other
     * program byte-identical. */
    static char py_mnames[512][64];
    static int py_nmnames;
    static char py_lcl[256][64];
    static int py_nlcl;
    static char py_gbl[64][64];
    static int py_ngbl;
    /* every local that `py_fix_locals` actually renamed, so the
     * read-before-assignment pass below can recognise them after the rewrite */
    static char py_ub_fn[256][64];
    static char py_ub_pretty[256][64];
    static char py_ub_to[256][128];
    static int py_nub;
    static int py_mname_find(const char* nm) {
        int i = 0;
        while (i < py_nmnames) { if (d_strcmp(py_mnames[i], nm) == 0) return 1; i++; }
        return 0;
    }
    static void py_mname_add(const char* nm) {
        if (!nm || !nm[0]) return;
        if (py_mname_find(nm)) return;
        if (py_nmnames < 512) { d_strncpy(py_mnames[py_nmnames], nm, 63); py_mnames[py_nmnames][63] = 0; py_nmnames++; }
    }
    static int py_lcl_has(const char* nm) {
        int i = 0;
        while (i < py_nlcl) { if (d_strcmp(py_lcl[i], nm) == 0) return 1; i++; }
        return 0;
    }
    static void py_lcl_add(const char* nm) {
        if (!nm || !nm[0]) return;
        if (py_lcl_has(nm)) return;
        if (py_nlcl < 256) { d_strncpy(py_lcl[py_nlcl], nm, 63); py_lcl[py_nlcl][63] = 0; py_nlcl++; }
    }
    static int py_gbl_has(const char* nm) {
        int i = 0;
        while (i < py_ngbl) { if (d_strcmp(py_gbl[i], nm) == 0) return 1; i++; }
        return 0;
    }
    /* module-scope bindings: assigned names reachable without entering a def */
    static void py_mod_collect(const IRNode* n) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"GLOBAL_DECL")==0) {
            for (i=0;i<n->nchildren;i++) py_mname_add(n->children[i]->value);
            return;
        }
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren>0) {
            const IRNode* lhs = n->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) py_mname_add(lhs->value);
        }
        if (d_strcmp(n->type,"FOR")==0 && n->nchildren>0) {
            const IRNode* it = n->children[0];
            if (it && d_strcmp(it->type,"IDENTIFIER")==0) py_mname_add(it->value);
        }
        if (d_strcmp(n->type,"WITH")==0) py_mname_add(n->value);
        for (i=0;i<n->nchildren;i++) py_mod_collect(n->children[i]);
    }
    static int py_has_nested_def(const IRNode* n) {
        int i = 0;
        if (!n) return 0;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return 1;
        for (i=0;i<n->nchildren;i++) if (py_has_nested_def(n->children[i])) return 1;
        return 0;
    }
    /* `global`-declared names inside one function */
    static void py_fn_globals(const IRNode* n) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"GLOBAL_DECL")==0) {
            for (i=0;i<n->nchildren;i++) {
                if (py_ngbl < 64 && !py_gbl_has(n->children[i]->value)) {
                    d_strncpy(py_gbl[py_ngbl], n->children[i]->value, 63);
                    py_gbl[py_ngbl][63] = 0; py_ngbl++;
                }
            }
            return;
        }
        for (i=0;i<n->nchildren;i++) py_fn_globals(n->children[i]);
    }
    /* names one function assigns (ASSIGN lhs / FOR iterator) */
    static void py_fn_locals(const IRNode* n) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"GLOBAL_DECL")==0) return;
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren>0) {
            const IRNode* lhs = n->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) py_lcl_add(lhs->value);
        }
        if (d_strcmp(n->type,"FOR")==0 && n->nchildren>0) {
            const IRNode* it = n->children[0];
            if (it && d_strcmp(it->type,"IDENTIFIER")==0) py_lcl_add(it->value);
        }
        for (i=0;i<n->nchildren;i++) py_fn_locals(n->children[i]);
    }
    static int py_namech(char c) {
        return (c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_';
    }
    /* f-strings keep their source text, so an interpolation `{x}` is not an
     * IDENTIFIER node and every rename pass walked straight past it: the local
     * became `_f_x` while the f-string still rendered `x`, which was then
     * either undeclared or a stale global (36_match checks 8-10 read the wrong
     * value).  Splice `to` over the field name in place; `{{` is Python's
     * escaped brace and is left alone. */
    static void py_fstr_replace(char* v, const char* from, const char* to) {
        int fl, tl, i = 0;
        if (!v || !from || !to) return;
        fl = d_strlen(from); tl = d_strlen(to);
        if (fl <= 0 || tl <= 0) return;
        while (v[i]) {
            if (v[i] != '{') { i++; continue; }
            if (v[i+1] == '{') { i += 2; continue; }
            int s = i + 1, e = s;
            while (v[e] && py_namech(v[e])) e++;
            if (e - s == fl && d_strncmp(v + s, (char*)from, fl) == 0 &&
                (v[e]=='\0' || v[e]=='}' || v[e]==':' || v[e]=='!' ||
                 v[e]=='.' || v[e]=='[')) {
                int d = tl - fl;
                if (d != 0) {
                    int l = d_strlen(v);
                    if (l + d >= IR_MAX_NAME) { i = e; continue; }
                    int k = l;
                    while (k >= e) { v[k + d] = v[k]; k--; }
                }
                int q = 0;
                while (q < tl) { v[s + q] = to[q]; q++; }
                i = s + tl;
            } else {
                i = e;
            }
        }
    }
    static void py_rename_idents(IRNode* n, const char* from, const char* to) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"IDENTIFIER")==0 && d_strcmp(n->value, from)==0) {
            d_strncpy(n->value, to, IR_MAX_NAME-1); n->value[IR_MAX_NAME-1] = 0;
            return;
        }
        if (d_strcmp(n->type,"CONSTANT")==0 && d_strcmp(n->data_type,"FSTR")==0)
            py_fstr_replace(n->value, from, to);
        for (i=0;i<n->nchildren;i++) py_rename_idents(n->children[i], from, to);
    }
    static void py_fix_locals(IRNode* body, const char* fn) {
        int i = 0;
        if (!body || py_has_nested_def(body)) return;
        py_ngbl = 0;
        py_nlcl = 0;
        py_fn_globals(body);
        py_fn_locals(body);
        for (i = 0; i < py_nlcl; i++) {
            char from[64]; char to[128]; int k = 0, q = 0;
            d_strncpy(from, py_lcl[i], 63); from[63] = 0;
            if (!from[0]) continue;
            if (py_gbl_has(from)) continue;
            if (!py_mname_find(from)) continue;
            to[k++] = '_';
            q = 0; while (fn[q] && k < 110) { to[k++] = fn[q++]; }
            if (k < 118) to[k++] = '_';
            q = 0; while (from[q] && k < 126) { to[k++] = from[q++]; }
            to[k] = 0;
            if (py_nub < 256) {
                int u = 0, v = 0;
                while (fn[u] && u < 63) { py_ub_fn[py_nub][u] = fn[u]; u++; }
                py_ub_fn[py_nub][u] = 0;
                u = 0;
                while (from[u] && u < 63) { py_ub_pretty[py_nub][u] = from[u]; u++; }
                py_ub_pretty[py_nub][u] = 0;
                while (to[v] && v < 127) { py_ub_to[py_nub][v] = to[v]; v++; }
                py_ub_to[py_nub][v] = 0;
                py_nub++;
            }
            py_rename_idents(body, from, to);
        }
    }

    /* ── read-before-assignment (UnboundLocalError) ──────────────────────────
     * Python decides "local" from the whole function body: a name assigned
     * anywhere in the function -- and not declared `global` -- is local for
     * every line, so a read that runs before the first assignment raises
     * UnboundLocalError instead of falling back to the module global.  The
     * renamed local is just a zeroed C variable, so
     *      y = "global_y"
     *      def f():
     *          try:
     *              return y        # python: UnboundLocalError
     *              y = "local"
     *          except UnboundLocalError:
     *              return "unbound"
     * returned a null char* and the print SEGV'd (57_nonlocal_global check 28).
     * Walk each block in statement order, remembering which renamed locals have
     * been bound so far, and splice `raise UnboundLocalError` in front of the
     * first statement that reads one that has not been bound yet.  The inserted
     * raise is a real IR statement, so the try-body pending-flag guard right
     * after it transfers control to the matching `except` clause. */
    static int py_ub_lookup(char nm[][128], int n, const char* v) {
        int i = 0;
        while (i < n) { if (d_strcmp(nm[i], v) == 0) return i; i++; }
        return -1;
    }
    /* index of the first not-yet-bound local this EXPRESSION reads, or -1.
     * Nested statement blocks are deliberately not entered: their own
     * assignments run first and the block walker reaches them in order. */
    static int py_ub_read(IRNode* n, char nm[][128], int nnm, int* defs) {
        int i = 0, k = 0;
        if (!n) return -1;
        if (d_strcmp(n->type,"IDENTIFIER")==0) {
            k = py_ub_lookup(nm, nnm, n->value);
            if (k >= 0 && defs[k] == 0) return k;
            return -1;
        }
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren>0) {
            /* the bare-identifier LHS is a write, not a read */
            if (d_strcmp(n->children[0]->type,"IDENTIFIER")!=0) {
                k = py_ub_read(n->children[0], nm, nnm, defs);
                if (k >= 0) return k;
            }
            for (i=1;i<n->nchildren;i++) {
                k = py_ub_read(n->children[i], nm, nnm, defs);
                if (k >= 0) return k;
            }
            return -1;
        }
        if (d_strcmp(n->type,"FOR")==0 && n->nchildren>0) {
            if (d_strcmp(n->children[0]->type,"IDENTIFIER")!=0) {
                k = py_ub_read(n->children[0], nm, nnm, defs);
                if (k >= 0) return k;
            }
            for (i=1;i<n->nchildren;i++) {
                k = py_ub_read(n->children[i], nm, nnm, defs);
                if (k >= 0) return k;
            }
            return -1;
        }
        if (d_strcmp(n->type,"BLOCK")==0 || d_strcmp(n->type,"ELSE_BLOCK")==0 ||
            d_strcmp(n->type,"IF")==0 || d_strcmp(n->type,"WHILE")==0 ||
            d_strcmp(n->type,"TRY")==0 || d_strcmp(n->type,"WITH")==0 ||
            d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0 ||
            d_strcmp(n->type,"LAMBDA")==0 || d_strcmp(n->type,"DECORATOR")==0)
            return -1;
        for (i=0;i<n->nchildren;i++) {
            k = py_ub_read(n->children[i], nm, nnm, defs);
            if (k >= 0) return k;
        }
        return -1;
    }
    /* record the bindings one statement performs */
    static void py_ub_mark(IRNode* s, char nm[][128], int nnm, int* defs) {
        int k = 0, j = 0;
        if (!s) return;
        if (d_strcmp(s->type,"ASSIGN")==0 && s->nchildren>0) {
            if (d_strcmp(s->children[0]->type,"IDENTIFIER")==0) {
                k = py_ub_lookup(nm, nnm, s->children[0]->value);
                if (k >= 0) defs[k] = 1;
            } else if (d_strcmp(s->children[0]->type,"BLOCK")==0 ||
                       d_strcmp(s->children[0]->type,"TUPLE")==0) {
                /* `a, b = ...` destructuring */
                while (j < s->children[0]->nchildren) {
                    IRNode* e = s->children[0]->children[j];
                    if (e && d_strcmp(e->type,"IDENTIFIER")==0) {
                        k = py_ub_lookup(nm, nnm, e->value);
                        if (k >= 0) defs[k] = 1;
                    }
                    j++;
                }
            }
        }
        if (d_strcmp(s->type,"FOR")==0 && s->nchildren>0 &&
            d_strcmp(s->children[0]->type,"IDENTIFIER")==0) {
            k = py_ub_lookup(nm, nnm, s->children[0]->value);
            if (k >= 0) defs[k] = 1;
        }
        if (d_strcmp(s->type,"WITH")==0 && s->value[0]) {
            k = py_ub_lookup(nm, nnm, s->value);
            if (k >= 0) defs[k] = 1;
        }
    }
    /* splice `raise UnboundLocalError("...")` in front of blk->children[idx] */
    static void py_ub_raise(IRNode* blk, int idx, const char* nm) {
        const char* pre = "cannot access local variable '";
        const char* post = "' where it is not associated with a value";
        char m[300]; char lit[320];
        int k = 0, q = 0, z = 0;
        if (!blk || idx < 0 || idx > blk->nchildren ||
            blk->nchildren >= IR_MAX_CHILDREN) return;
        /* the message should name the python variable, not the mangled local */
        { int u = 0;
          while (u < py_nub) {
              if (d_strcmp(py_ub_to[u], nm) == 0) { nm = py_ub_pretty[u]; break; }
              u++;
          }
        }
        while (pre[k]) { m[k] = pre[k]; k++; }
        q = 0; while (nm && nm[q] && k < 250) { m[k] = nm[q]; k++; q++; }
        q = 0; while (post[q] && k < 290) { m[k] = post[q]; k++; q++; }
        m[k] = 0;
        lit[z++] = '"';
        q = 0; while (m[q] && z < 300) { lit[z++] = m[q++]; }
        lit[z++] = '"'; lit[z] = 0;
        {
            IRNode* r = ir_new("RAISE","","ANY");
            IRNode* c = ir_new("CALL","UnboundLocalError","ANY");
            ir_add_child(c, ir_new("CONSTANT", lit, "STR"));
            ir_add_child(r, c);
            k = blk->nchildren;
            while (k > idx) { blk->children[k] = blk->children[k-1]; k--; }
            blk->children[idx] = r;
            blk->nchildren = blk->nchildren + 1;
        }
    }
    static void py_ub_block(IRNode* blk, char nm[][128], int nnm, int* defs) {
        int i = 0;
        if (!blk) return;
        for (i = 0; i < blk->nchildren; i++) {
            IRNode* s = blk->children[i];
            int k = 0;
            if (!s) continue;
            if (d_strcmp(s->type,"FUNCTION_DEF")==0 || d_strcmp(s->type,"CLASS_DEF")==0) continue;
            if (d_strcmp(s->type,"IF")==0) {
                k = py_ub_read(s->nchildren>0?s->children[0]:NULL, nm, nnm, defs);
                if (k >= 0) { py_ub_raise(blk, i, nm[k]); return; }
                if (s->nchildren>1) py_ub_block(s->children[1], nm, nnm, defs);
                if (s->nchildren>2 && d_strcmp(s->children[2]->type,"ELSE_BLOCK")==0 &&
                    s->children[2]->nchildren>0)
                    py_ub_block(s->children[2]->children[0], nm, nnm, defs);
                continue;
            }
            if (d_strcmp(s->type,"WHILE")==0) {
                k = py_ub_read(s->nchildren>0?s->children[0]:NULL, nm, nnm, defs);
                if (k >= 0) { py_ub_raise(blk, i, nm[k]); return; }
                if (s->nchildren>1) py_ub_block(s->children[1], nm, nnm, defs);
                continue;
            }
            if (d_strcmp(s->type,"FOR")==0) {
                if (s->nchildren>1) {
                    k = py_ub_read(s->children[1], nm, nnm, defs);
                    if (k >= 0) { py_ub_raise(blk, i, nm[k]); return; }
                }
                py_ub_mark(s, nm, nnm, defs);
                if (s->nchildren>2) py_ub_block(s->children[2], nm, nnm, defs);
                continue;
            }
            if (d_strcmp(s->type,"TRY")==0) {
                if (s->nchildren>0) py_ub_block(s->children[0], nm, nnm, defs);
                { int j = 1;
                  while (j < s->nchildren) {
                      IRNode* h = s->children[j];
                      if (h && h->data_type[0] && d_strcmp(h->data_type,"ANY")!=0) {
                          k = py_ub_lookup(nm, nnm, h->data_type);
                          if (k >= 0) defs[k] = 1;
                      }
                      py_ub_block(h, nm, nnm, defs);
                      j++;
                  }
                }
                continue;
            }
            if (d_strcmp(s->type,"WITH")==0) {
                int j = 0;
                py_ub_mark(s, nm, nnm, defs);
                while (j < s->nchildren) { py_ub_block(s->children[j], nm, nnm, defs); j++; }
                continue;
            }
            k = py_ub_read(s, nm, nnm, defs);
            if (k >= 0) { py_ub_raise(blk, i, nm[k]); return; }
            py_ub_mark(s, nm, nnm, defs);
        }
    }
    static void py_unbound_fix(IRNode* body, const char* fn) {
        char nm[64][128];
        int defs[64];
        int n = 0, i = 0;
        if (!body) return;
        while (i < py_nub && n < 64) {
            if (d_strcmp(py_ub_fn[i], fn) == 0) {
                int q = 0;
                while (py_ub_to[i][q] && q < 127) { nm[n][q] = py_ub_to[i][q]; q++; }
                nm[n][q] = 0;
                defs[n] = 0;
                n++;
            }
            i++;
        }
        if (n == 0) return;
        py_ub_block(body, nm, n, defs);
    }

    /* ── a method is a function ───────────────────────────────────────────────
     * A CLASS_DEF owns a single body BLOCK and each `def` in it is a
     * FUNCTION_DEF.  The local-name isolation and the read-before-assignment
     * passes only ever ran on TOP-LEVEL defs, so a method kept Python's
     * file-scope fallback: `d = {}` inside `csv.DictReader.__next__` bound the
     * module-level `d` an importing program had declared, and printing that
     * global produced the method's dictionary.  Walk the class body (and any
     * nested block, so `if`-guarded methods are covered too) and give every
     * method the same two passes.  `mode` 0 is py_fix_locals, 1 is
     * py_unbound_fix. */
    static void py_class_members(IRNode* n, int mode, const char* cls) {
        int i = 0;
        char here[192];
        if (!n) return;
        /* the driver hands in the CLASS_DEF itself */
        if (d_strcmp(n->type,"CLASS_DEF")==0 && n->value && n->value[0]) {
            py_fns_mkname(here, cls, n->value);
            cls = here;
        }
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && c->nchildren > 1) {
                /* the local-name isolation has to use the same name the backend
                 * emits for the method (`<class>_<method>`), or two `__next__`
                 * methods rename their locals onto one cell (see py_fnsq) */
                char qn[192];
                py_fns_mkname(qn, cls, c->value ? c->value : "");
                if (mode == 0) py_fix_locals(c->children[1], qn);
                else py_unbound_fix(c->children[1], qn);
            } else if (c && d_strcmp(c->type,"CLASS_DEF")==0 && c->value && c->value[0]) {
                char sub[192];
                py_fns_mkname(sub, cls, c->value);
                py_class_members(c, mode, sub);
            } else {
                py_class_members(c, mode, cls);
            }
            i++;
        }
    }

    /* ── locals shared by two outers ─────────────────────────────────────────
     * `py_fix_locals` cannot touch a body that contains a nested def (renaming
     * an enclosing name would hide it from the nested def, which reaches the
     * same cell through the flat namespace).  So `counter`'s `count = [0]` and
     * `make_counter`'s `count = 0` met on one `int count[64]` and the scalar
     * counter did pointer arithmetic.  A local name bound by two different
     * top-level defs is renamed `_<outer>_<name>` across the WHOLE subtree, so
     * an outer and its nested defs still share exactly one cell.  A parameter
     * is left alone: nested defs reach those through the capture slots. */
    static char py_subseen[256][64];
    static int py_nsubseen;
    static char py_subshared[256][64];
    static int py_nsubshared;
    static int py_subseen_has(const char* nm) {
        int i = 0;
        while (i < py_nsubseen) { if (d_strcmp(py_subseen[i], nm)==0) return 1; i++; }
        return 0;
    }
    static void py_subseen_add(const char* nm) {
        int i = 0;
        if (!nm || !nm[0]) return;
        while (i < py_nsubseen) { if (d_strcmp(py_subseen[i], nm)==0) return; i++; }
        if (py_nsubseen < 256) {
            d_strncpy(py_subseen[py_nsubseen], nm, 63); py_subseen[py_nsubseen][63] = 0;
            py_nsubseen++;
        }
    }
    static int py_subshared_has(const char* nm) {
        int i = 0;
        while (i < py_nsubshared) { if (d_strcmp(py_subshared[i], nm)==0) return 1; i++; }
        return 0;
    }
    static void py_subshared_add(const char* nm) {
        int i = 0;
        if (!nm || !nm[0]) return;
        while (i < py_nsubshared) { if (d_strcmp(py_subshared[i], nm)==0) return; i++; }
        if (py_nsubshared < 256) {
            d_strncpy(py_subshared[py_nsubshared], nm, 63); py_subshared[py_nsubshared][63] = 0;
            py_nsubshared++;
        }
    }
    /* assignment targets of a whole subtree, nested defs included */
    static void py_sub_binds(const IRNode* n) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"GLOBAL_DECL")==0) return;
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren>0) {
            const IRNode* lhs = n->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) py_lcl_add(lhs->value);
        }
        if (d_strcmp(n->type,"FOR")==0 && n->nchildren>0) {
            const IRNode* it = n->children[0];
            if (it && d_strcmp(it->type,"IDENTIFIER")==0) py_lcl_add(it->value);
        }
        for (i=0;i<n->nchildren;i++) py_sub_binds(n->children[i]);
    }
    /* `global`-declared names of a whole subtree: those bind module scope, so
     * they must never be renamed as if they were function locals. */
    static char py_sgbl[64][64];
    static int py_nsgbl;
    static int py_sgbl_has(const char* nm) {
        int i = 0;
        while (i < py_nsgbl) { if (d_strcmp(py_sgbl[i], nm)==0) return 1; i++; }
        return 0;
    }
    static void py_sgbl_add(const char* nm) {
        int i = 0;
        if (!nm || !nm[0]) return;
        while (i < py_nsgbl) { if (d_strcmp(py_sgbl[i], nm)==0) return; i++; }
        if (py_nsgbl < 64) {
            d_strncpy(py_sgbl[py_nsgbl], nm, 63); py_sgbl[py_nsgbl][63] = 0;
            py_nsgbl++;
        }
    }
    static void py_sub_globals(const IRNode* n) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"GLOBAL_DECL")==0) {
            /* `nonlocal x` is not a module binding: treating it as one blocked
             * the shared-local rename for the whole outer function, so a
             * nested `nonlocal count` left `make_counter` writing the
             * module-scope list `count` set up by an unrelated `counter`
             * (11_functions checks 54-56). */
            if (d_strcmp(n->data_type,"NONLOCAL")==0) return;
            for (i=0;i<n->nchildren;i++) py_sgbl_add(n->children[i]->value);
            return;
        }
        for (i=0;i<n->nchildren;i++) py_sub_globals(n->children[i]);
    }
    static void py_rename_subtree(IRNode* n, const char* from, const char* to) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"IDENTIFIER")==0 && d_strcmp(n->value, from)==0) {
            d_strncpy(n->value, to, IR_MAX_NAME-1); n->value[IR_MAX_NAME-1] = 0;
            return;
        }
        if (d_strcmp(n->type,"CONSTANT")==0 && d_strcmp(n->data_type,"FSTR")==0)
            py_fstr_replace(n->value, from, to);
        for (i=0;i<n->nchildren;i++) py_rename_subtree(n->children[i], from, to);
    }
    static int py_param_has(const IRNode* params, const char* nm) {
        int i = 0;
        if (!params) return 0;
        while (i < params->nchildren) {
            if (params->children[i] && d_strcmp(params->children[i]->value, nm)==0) return 1;
            i++;
        }
        return 0;
    }
    static int py_nested_def_named(const IRNode* n, const char* nm) {
        int i = 0;
        if (!n) return 0;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 && d_strcmp(n->value, nm)==0) return 1;
        if (d_strcmp(n->type,"CLASS_DEF")==0) return 0;
        while (i < n->nchildren) {
            if (py_nested_def_named(n->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    /* Every function that owns a flat C body: top-level defs AND the methods of
     * every class.  A method's locals live in the same file-scope namespace as a
     * module function's, so `io.StringIO.read`'s `r` (a string accumulator) and
     * `csv.DictReader.__next__`'s `r` (the row list from the wrapped reader) met
     * on one `char* r[64]`; the list kind won and `StringIO_read`
     * returned `char**`/`drygon_rls`, so `csv.reader(...)` read an empty buffer
     * for every program that did not happen to declare a module-level `r` (the
     * collision that used to mask it).  Nested defs are reached through their
     * outer's subtree, exactly as before. */
    static IRNode* py_fns[512];
    /* the name the C backend gives the function: a method is emitted as
     * `<class>_<method>`, so the renamed local has to carry the same prefix.
     * Two `__next__` methods in different classes otherwise still renamed their
     * `out` to one `___next___out` cell, and whichever class noted its element
     * type last decided the array kind for both (the `char* out[64]` of
     * `csv.reader` degenerated to `int`, so `50_csv` read empty rows). */
    static char py_fnsq[512][28];
    static int py_nfns;
    static void py_fns_mkname(char* dst, const char* cls, const char* nm) {
        int k = 0, q = 0;
        if (cls && cls[0]) {
            while (cls[q] && k < 26) { dst[k] = cls[q]; k++; q++; }
            if (k < 27) dst[k++] = '_';
        }
        q = 0;
        while (nm[q] && k < 27) { dst[k] = nm[q]; k++; q++; }
        dst[k] = 0;
    }
    static void py_fns_collect(IRNode* n, const char* cls) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0) {
            if (n->nchildren > 1 && py_nfns < 512) {
                py_fns[py_nfns] = n;
                py_fns_mkname(py_fnsq[py_nfns], cls, n->value ? n->value : "");
                py_nfns++;
            }
            return;
        }
        if (d_strcmp(n->type,"CLASS_DEF")==0 && n->value && n->value[0]) {
            char sub[192];
            py_fns_mkname(sub, cls, n->value);
            while (i < n->nchildren) { py_fns_collect(n->children[i], sub); i++; }
            return;
        }
        while (i < n->nchildren) { py_fns_collect(n->children[i], cls); i++; }
    }
    static void py_fix_shared_locals(IRNode* prog) {
        int i = 0;
        if (!prog) return;
        py_nsubseen = 0;
        py_nsubshared = 0;
        py_nfns = 0;
        py_fns_collect(prog, NULL);
        i = 0;
        while (i < py_nfns) {
            IRNode* f = py_fns[i];
            {
                int j = 0;
                py_nlcl = 0;
                py_nsgbl = 0;
                py_sub_binds(f->children[1]);
                py_sub_globals(f->children[1]);
                j = 0;
                while (j < py_nlcl) {
                    if (py_sgbl_has(py_lcl[j])) { j++; continue; }
                    if (py_subseen_has(py_lcl[j])) py_subshared_add(py_lcl[j]);
                    else py_subseen_add(py_lcl[j]);
                    j++;
                }
            }
            i++;
        }
        if (py_nsubshared == 0) return;
        i = 0;
        while (i < py_nfns) {
            IRNode* f = py_fns[i];
            {
                int j = 0;
                py_nlcl = 0;
                py_nsgbl = 0;
                py_sub_binds(f->children[1]);
                py_sub_globals(f->children[1]);
                j = 0;
                while (j < py_nlcl) {
                    char from[64]; char to[128]; int k = 0, q = 0;
                    d_strncpy(from, py_lcl[j], 63); from[63] = 0;
                    j++;
                    if (!from[0]) continue;
                    if (py_sgbl_has(from)) continue;
                    if (!py_subshared_has(from)) continue;
                    if (py_param_has(f->children[0], from)) continue;
                    if (py_nested_def_named(f->children[1], from)) continue;
                    to[k++] = '_';
                    q = 0; while (py_fnsq[i][q] && k < 110) { to[k++] = py_fnsq[i][q]; q++; }
                    if (k < 118) to[k++] = '_';
                    q = 0; while (from[q] && k < 126) { to[k++] = from[q++]; }
                    to[k] = 0;
                    py_rename_subtree(f->children[1], from, to);
                }
            }
            i++;
        }
    }

    /* Copy `src`'s statements into `dst`, splicing inlined module PROGRAMs so
     * that the result has no nested program levels. */
    static void py_flatten_prog(IRNode* dst, IRNode* src) {
        int i = 0;
        if (!dst || !src) return;
        while (i < src->nchildren) {
            IRNode* c = src->children[i];
            if (c && d_strcmp(c->type,"PROGRAM")==0) py_flatten_prog(dst, c);
            else ir_add_child(dst, c);
            i++;
        }
    }

    /* `mod.member` for a module inlined from `<mod>.py`: the member now lives
     * at file scope as a plain name (`add`, `Box`, `QUOTE_ALL`), so the dotted
     * form compiled to a member of nothing and trapped at run time.  Rewriting
     * the node -- rather than special-casing each emitter -- means every
     * downstream rule (class constructors, `isinstance(x, mod.C)`, ...) sees
     * the plain identifier it already knows how to lower. */
    /* `datetime.now()` / `datetime.combine(...)` where the head name is BOTH an
     * imported module and a class the module defines (`from datetime import
     * datetime`): the dotted form is a class-static call, not a module
     * attribute.  Folding it to the bare `now()` lost the receiver and called an
     * undefined function.  A class name therefore suppresses the rewrite. */
    static IRNode* py_modattr_root;
    static int py_root_has_class_depth(IRNode* n, const char* nm, int depth) {
        int i = 0;
        if (!n || depth > 32) return 0;
        if (d_strcmp(n->type,"CLASS_DEF")==0 && d_strcmp(n->value, nm)==0) return 1;
        while (i < n->nchildren) {
            if (py_root_has_class_depth(n->children[i], nm, depth + 1)) return 1;
            i++;
        }
        return 0;
    }
    static int py_root_has_class(const char* nm) {
        if (!py_modattr_root || !nm || !nm[0]) return 0;
        return py_root_has_class_depth(py_modattr_root, nm, 0);
    }

    static void py_modattr_rewrite(IRNode* n) {
        int i = 0;
        if (!n) return;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            /* `mod.f(a, b)`: the parser builds a method call (value "COMPLEX",
             * child 0 = `mod.f`).  Left as-is the class-constructor rule in the
             * assignment path never sees `Box(...)` -- it needs a plain call --
             * and the generic emitter dropped the dotted target, calling the
             * undefined symbol `Box`.  Normalise to the plain call `f(a, b)`. */
            if (c && d_strcmp(c->type,"CALL")==0 && d_strcmp(c->value,"COMPLEX")==0 &&
                c->nchildren>0 && c->children[0] &&
                d_strcmp(c->children[0]->type,"MEMBER_ACCESS")==0 &&
                c->children[0]->nchildren>0 && c->children[0]->children[0] &&
                d_strcmp(c->children[0]->children[0]->type,"IDENTIFIER")==0 &&
                cg_mod_is_loaded(c->children[0]->children[0]->value) &&
                !py_root_has_class(c->children[0]->children[0]->value)) {
                d_strcpy(c->value, c->children[0]->value);
                int j = 0;
                while (j + 1 < c->nchildren) { c->children[j] = c->children[j+1]; j++; }
                c->nchildren = c->nchildren - 1;
                py_modattr_rewrite(c);
            } else if (c && d_strcmp(c->type,"MEMBER_ACCESS")==0 && c->nchildren>0 &&
                c->children[0] && d_strcmp(c->children[0]->type,"IDENTIFIER")==0 &&
                cg_mod_is_loaded(c->children[0]->value) &&
                !py_root_has_class(c->children[0]->value)) {
                n->children[i] = ir_new("IDENTIFIER", c->value, c->data_type);
            } else {
                py_modattr_rewrite(c);
            }
            i++;
        }
    }

    static IRNode* parse_py_to_ir_c(const char* src) {        TokenStream ts;
        if (py_tokenize(src, &ts) != 0) return NULL;
        PyParser p; p.ts = &ts; p.root = NULL;
        IRNode* prog = ir_new("PROGRAM", "", "ANY");
        while (pk(&p)->kind != TOK_EOF) {
            if (pk(&p)->kind == TOK_NEWLINE) { advance(&p); continue; }
            if (pk(&p)->kind == TOK_INDENT) { advance(&p); continue; }
            if (pk(&p)->kind == TOK_DEDENT) { advance(&p); continue; }
            int last_pos = p.ts->pos;
            IRNode* s = py_comp_stmt(parse_stmt(&p));
            if (s) ir_add_child(prog, s);
            if (p.ts->pos <= last_pos) {
                advance(&p);
            }
            while (pk(&p)->kind == TOK_NEWLINE) advance(&p);
        }
        /* An inlined module (`import csv` -> the parsed csv.py) arrives as a
         * nested PROGRAM child.  Left nested, every later prepass -- function
         * hoisting, local-name isolation, duplicate-def renaming -- which walks
         * the top level of the program never sees the module's defs, so they
         * kept the parameter names unresolved and every call trapped.  Splice
         * such children (recursively) into a flat program. */
        {
            IRNode* _flat = ir_new("PROGRAM","","ANY");
            py_flatten_prog(_flat, prog);
            prog = _flat;
            py_modattr_root = prog;
            py_modattr_rewrite(prog);
        }
        /* rename nested functions that collide by name */
        {
            int _pi = 0;
            py_ndup_names = 0;
            py_dupname_scan(prog, prog);
            while (_pi < prog->nchildren) {
                IRNode* _f = prog->children[_pi];
                if (_f && d_strcmp(_f->type,"FUNCTION_DEF")==0 && _f->nchildren > 0)
                    py_fix_nested(_f->children[_f->nchildren-1], _f->value, prog);
                _pi++;
            }
        }
        /* isolate function locals that collide with module-scope names */
        {
            int _mi = 0;
            py_nmnames = 0;
            py_mod_collect(prog);
            py_nub = 0;
            while (_mi < prog->nchildren) {
                IRNode* _g = prog->children[_mi];
                if (_g && d_strcmp(_g->type,"FUNCTION_DEF")==0 && _g->nchildren > 1)
                    py_fix_locals(_g->children[1], _g->value);
                /* A method is a function too: without this, `d = {}` inside
                 * csv.DictReader.__next__ bound the module-level `d` that the
                 * importing program declared, and the spliced module's locals
                 * clobbered the caller's globals. */
                if (_g && d_strcmp(_g->type,"CLASS_DEF")==0)
                    py_class_members(_g, 0, NULL);
                _mi++;
            }
            py_fix_shared_locals(prog);
            /* read-before-assignment over the locals just renamed */
            _mi = 0;
            while (_mi < prog->nchildren) {
                IRNode* _g = prog->children[_mi];
                if (_g && d_strcmp(_g->type,"FUNCTION_DEF")==0 && _g->nchildren > 1)
                    py_unbound_fix(_g->children[1], _g->value);
                if (_g && d_strcmp(_g->type,"CLASS_DEF")==0)
                    py_class_members(_g, 1, NULL);
                _mi++;
            }
        }
        py_lparam_fixup(prog);
        py_dupdef_fixup(prog);
        return prog;
    }
    /* ── superseded module-level defs ────────────────────────────────────────
     * Python binds the module-level name to the LAST `def N` that ran, so a
     * call made after a redefinition must reach the new body.  Emitting every
     * version under one C name left the earlier signature in charge (11_functions
     * checks 39-41 called a 4-parameter `f` as `f(1, 2)`), so rename each
     * superseded def to `N__dv<k>` and rewrite the module-level statements that
     * run between it and the next def of the same name.  The bodies of other
     * defs/classes keep the plain name: their lookups happen at call time and
     * must see the surviving last version, exactly as Python does. */
    static int py_dup_next(IRNode* prog, int from, const char* nm) {
        int i = from + 1;
        while (i < prog->nchildren) {
            IRNode* c = prog->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && d_strcmp(c->value,nm)==0) return i;
            i++;
        }
        return -1;
    }
    static void py_dup_rw(IRNode* n, const char* from, const char* to) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"IDENTIFIER")==0 && d_strcmp(n->value, from)==0) {
            d_strncpy(n->value, to, IR_MAX_NAME-1); n->value[IR_MAX_NAME-1] = 0;
        } else if (d_strcmp(n->type,"CALL")==0 && d_strcmp(n->value, from)==0) {
            d_strncpy(n->value, to, IR_MAX_NAME-1); n->value[IR_MAX_NAME-1] = 0;
        } else if (d_strcmp(n->type,"CONSTANT")==0 && d_strcmp(n->data_type,"FSTR")==0) {
            py_fstr_replace(n->value, from, to);
        }
        for (i = 0; i < n->nchildren; i++) py_dup_rw(n->children[i], from, to);
    }
    static void py_dupdef_fixup(IRNode* prog) {
        int i = 0;
        if (!prog) return;
        while (i < prog->nchildren) {
            IRNode* d = prog->children[i];
            if (d && d_strcmp(d->type,"FUNCTION_DEF")==0 && d->value && d->value[0] &&
                d->nchildren > 0) {
                int nxt = py_dup_next(prog, i, d->value);
                if (nxt >= 0) {
                    char nn[IR_MAX_NAME];
                    char dig[16];
                    int k = 0, q = 0, nd = 0, v = i;
                    while (d->value[q] && k < 4000) { nn[k++] = d->value[q++]; }
                    nn[k++]='_'; nn[k++]='_'; nn[k++]='d'; nn[k++]='v';
                    if (v == 0) dig[nd++] = '0';
                    while (v > 0) { dig[nd++] = '0' + (v % 10); v = v / 10; }
                    while (nd > 0) nn[k++] = dig[--nd];
                    nn[k] = 0;
                    {   /* statements between this def and the next one of that name */
                        int j = i + 1;
                        while (j < nxt) { py_dup_rw(prog->children[j], d->value, nn); j++; }
                    }
                    d_strncpy(d->value, nn, IR_MAX_NAME-1); d->value[IR_MAX_NAME-1] = 0;
                }
            }
            i++;
        }
    }
    /* ── a parameter the body rebinds to a fresh list ────────────────────────
     * Python lists lower to FILE-SCOPE storage (`int xs[64]; int xs_n;`), so
     * `def append_to(lst=None): ... lst = []` named that storage after the
     * variable -- and the C parameter of the same name SHADOWED it.  `lst[...]`
     * then stored through the scalar parameter, which is 0 whenever the caller
     * used the default, so the program died with a SIGSEGV instead of building
     * the list (11_functions checks 46-47).  Rename the PARAMETER -- and the
     * `is None` tests that read the default -- so the old name reaches the list
     * storage while the "was it passed?" check still sees the incoming value. */
    static int py_lp_nonecmp(const IRNode* n) {
        int i = 0;
        if (!n || d_strcmp(n->type,"BINARY_OP")!=0) return 0;
        if (!(d_strcmp(n->value,"is")==0 || d_strcmp(n->value,"is not")==0 ||
              d_strcmp(n->value,"==")==0 || d_strcmp(n->value,"!=")==0)) return 0;
        while (i < n->nchildren) {
            const IRNode* c = n->children[i];
            if (c && d_strcmp(c->type,"IDENTIFIER")==0 && d_strcmp(c->value,"None")==0) return 1;
            if (c && d_strcmp(c->type,"CONSTANT")==0 &&
                (d_strcmp(c->value,"None")==0 || d_strcmp(c->value,"False")==0)) return 1;
            i++;
        }
        return 0;
    }
    static void py_lp_rw(IRNode* n, const char* from, const char* to) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"IDENTIFIER")==0 && d_strcmp(n->value, from)==0) {
            d_strncpy(n->value, to, IR_MAX_NAME-1); n->value[IR_MAX_NAME-1] = 0;
            return;
        }
        if (d_strcmp(n->type,"CONSTANT")==0 && d_strcmp(n->data_type,"FSTR")==0)
            py_fstr_replace(n->value, from, to);
        while (i < n->nchildren) { py_lp_rw(n->children[i], from, to); i++; }
    }
    static void py_lp_tests(IRNode* n, const char* from, const char* to) {
        int i = 0;
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (py_lp_nonecmp(n)) {
            while (i < n->nchildren) { py_lp_rw(n->children[i], from, to); i++; }
            return;
        }
        while (i < n->nchildren) { py_lp_tests(n->children[i], from, to); i++; }
    }
    static int py_lp_rebind(IRNode* n, const char* nm) {
        int i = 0;
        if (!n) return 0;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return 0;
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren > 1 &&
            n->children[0] && d_strcmp(n->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(n->children[0]->value, nm)==0 &&
            n->children[1] && d_strcmp(n->children[1]->type,"BLOCK")==0 &&
            d_strcmp(n->children[1]->value,"LIST")==0) return 1;
        while (i < n->nchildren) { if (py_lp_rebind(n->children[i], nm)) return 1; i++; }
        return 0;
    }
    static void py_lparam_fixup(IRNode* prog) {
        int i = 0;
        if (!prog) return;
        while (i < prog->nchildren) {
            IRNode* f = prog->children[i];
            if (f && d_strcmp(f->type,"FUNCTION_DEF")==0 && f->nchildren > 1) {
                IRNode* params = f->children[0];
                IRNode* body = f->children[1];
                int p = 0;
                while (params && p < params->nchildren) {
                    IRNode* pn = params->children[p];
                    if (pn && pn->value[0] && d_strcmp(pn->data_type,"ANY")==0 &&
                        py_lp_rebind(body, pn->value)) {
                        char nn[IR_MAX_NAME];
                        char dig[16];
                        int k = 0, q = 0, nd = 0, v = i;
                        nn[k++]='_'; nn[k++]='l'; nn[k++]='p';
                        if (v == 0) dig[nd++] = '0';
                        while (v > 0 && nd < 15) { dig[nd++] = '0' + (v % 10); v = v / 10; }
                        while (nd > 0 && k < 4000) nn[k++] = dig[--nd];
                        if (k < 4000) nn[k++] = '_';
                        while (pn->value[q] && k < 4000) nn[k++] = pn->value[q++];
                        nn[k] = 0;
                        py_lp_tests(body, pn->value, nn);
                        d_strncpy(pn->value, nn, IR_MAX_NAME-1);
                        pn->value[IR_MAX_NAME-1] = 0;
                    }
                    p++;
                }
            }
            i++;
        }
    }
/* native C tokenizer + recursive-descent parser → IR.
     * Pure C, no pycparser. Produces the same IR shape as the old CIRTranslator.
     */
    /* ── C tokenizer ───────────────────────────────────────────────────────── */
    typedef enum {
        CT_EOF, CT_IDENT, CT_NUMBER, CT_STRING, CT_CHAR,
        CT_LPAREN, CT_RPAREN, CT_LBRACE, CT_RBRACE, CT_LBRACK, CT_RBRACK,
        CT_SEMI, CT_COMMA, CT_DOT, CT_ARROW, CT_OP, CT_STAR, CT_AMP
    } CTokKind;
    typedef struct {
        CTokKind kind;
        char text[256];
        /* String literals longer than the 256-byte inline text (the compiler's
         * own prelude slot strings are tens of KB) used to be SILENTLY
         * TRUNCATED here, which quietly corrupted every long literal.  They
         * spill into this heap buffer instead; NULL means "use text". */
        char* big;
    } CToken;
    #define MAX_CTOKENS 65536
    typedef struct {
        CToken toks[MAX_CTOKENS];
        int n;
        int pos;
    } CTokStream;
    static int c_tokenize(const char* src, CTokStream* ts) {
        ts->n=0; ts->pos=0;
        const char* p=src;
        while (*p) {
            if (d_isspace(*p)) { p++; continue; }
            if (*p=='/' && p[1]=='/') { while (*p && *p!='\n') p++; continue; }
            if (*p=='/' && p[1]=='*') { p+=2; while (*p && !(*p=='*'&&p[1]=='/')) p++; if (*p) p+=2; continue; }
            if (*p=='#' ) { while (*p && *p!='\n') p++; continue; }
            if (d_isalpha(*p)||*p=='_') {
                char b[128]; int bi=0;
                while ((d_isalnum(*p)||*p=='_')&&bi<127) b[bi++]=*p++;
                b[bi]='\0';
                if (ts->n<MAX_CTOKENS) { ts->toks[ts->n].kind=CT_IDENT; d_strncpy(ts->toks[ts->n].text,b,255); ts->n++; }
                continue;
            }
            if (d_isdigit(*p)) {
                char b[64]; int bi=0;
                while ((d_isalnum(*p)||*p=='.'||*p=='_')&&bi<63) b[bi++]=*p++;
                b[bi]='\0';
                if (ts->n<MAX_CTOKENS) { ts->toks[ts->n].kind=CT_NUMBER; d_strncpy(ts->toks[ts->n].text,b,255); ts->n++; }
                continue;
            }
            if (*p=='"') {
                char b[256]; int bi=0; p++;
                /* Long literals spill to the heap instead of being cut at 250
                 * chars: a truncated literal silently became a different
                 * program (e.g. a 33 KB runtime prelude collapsed to 2 KB). */
                char* big = NULL; int bigcap = 0; int bigi = 0;
                while (*p && *p!='"') {
                    int need = (*p=='\\' && p[1]) ? 2 : 1;
                    if (big == NULL && bi + need + 1 > 250) {
                        bigcap = 8192;
                        big = (char*)d_alloc((size_t)bigcap);
                        if (!big) { d_puts("c_tokenize: long literal alloc failed\n"); return; }
                        { int q = 0; while (q < bi) { big[q] = b[q]; q++; } bigi = bi; }
                    }
                    if (big) {
                        if (bigi + need + 2 > bigcap) {
                            int ncap = bigcap + bigcap;
                            char* nb = (char*)d_alloc((size_t)ncap);
                            if (!nb) { d_puts("c_tokenize: long literal grow failed\n"); return; }
                            { int q = 0; while (q < bigi) { nb[q] = big[q]; q++; } }
                            big = nb; bigcap = ncap;
                        }
                        if (need == 2) { big[bigi++]='\\'; big[bigi++]=p[1]; p+=2; }
                        else big[bigi++]=*p++;
                    } else {
                        if (need == 2) { b[bi++]='\\'; b[bi++]=p[1]; p+=2; }
                        else b[bi++]=*p++;
                    }
                }
                if (*p=='"') p++;
                if (ts->n<MAX_CTOKENS) {
                    ts->toks[ts->n].kind=CT_STRING;
                    if (big) { big[bigi]='\0'; ts->toks[ts->n].text[0]='\0'; ts->toks[ts->n].big=big; }
                    else { b[bi]='\0'; d_strncpy(ts->toks[ts->n].text,b,255); ts->toks[ts->n].big=0; }
                    ts->n++;
                }
                continue;
            }
            if (*p=='\'') {
                char b[16]; int bi=0; p++;
                while (*p && *p!='\'' && bi<14) b[bi++]=*p++;
                if (*p=='\'') p++;
                b[bi]='\0';
                if (ts->n<MAX_CTOKENS) { ts->toks[ts->n].kind=CT_CHAR; d_strncpy(ts->toks[ts->n].text,b,255); ts->n++; }
                continue;
            }
            {
                char two[3]={*p,0,0};
                if (p[1]) { two[1]=p[1]; two[2]='\0'; }
                CTokKind k=CT_OP;
                if (*p=='(') k=CT_LPAREN; else if (*p==')') k=CT_RPAREN;
                else if (*p=='{') k=CT_LBRACE; else if (*p=='}') k=CT_RBRACE;
                else if (*p=='[') k=CT_LBRACK; else if (*p==']') k=CT_RBRACK;
                else if (*p==';') k=CT_SEMI; else if (*p==',') k=CT_COMMA;
                else if (*p=='.') k=CT_DOT; else if (*p=='*') k=CT_STAR; else if (*p=='&') k=CT_AMP;
                else if (d_strcmp(two,"->")==0) k=CT_ARROW;
                else if (d_strcmp(two,"==")==0||d_strcmp(two,"!=")==0||d_strcmp(two,"<=")==0||
                         d_strcmp(two,">=")==0||d_strcmp(two,"&&")==0||d_strcmp(two,"||")==0||
                         d_strcmp(two,"++")==0||d_strcmp(two,"--")==0||d_strcmp(two,"+=")==0||
                         d_strcmp(two,"-=")==0||d_strcmp(two,"*=")==0||d_strcmp(two,"/=")==0||
                         d_strcmp(two,"<<")==0||d_strcmp(two,">>")==0) k=CT_OP;
                if (k==CT_OP && (d_strcmp(two,"==")==0||d_strcmp(two,"!=")==0||d_strcmp(two,"<=")==0||
                    d_strcmp(two,">=")==0||d_strcmp(two,"&&")==0||d_strcmp(two,"||")==0||d_strcmp(two,"++")==0||
                    d_strcmp(two,"--")==0||d_strcmp(two,"+=")==0||d_strcmp(two,"-=")==0||d_strcmp(two,"*=")==0||
                    d_strcmp(two,"/=")==0||d_strcmp(two,"<<")==0||d_strcmp(two,">>")==0)) {
                    if (ts->n<MAX_CTOKENS) { ts->toks[ts->n].kind=CT_OP; d_strncpy(ts->toks[ts->n].text,two,255); ts->n++; }
                    p+=2; continue;
                }
                if (ts->n<MAX_CTOKENS) { ts->toks[ts->n].kind=k; ts->toks[ts->n].text[0]=*p; ts->toks[ts->n].text[1]='\0'; ts->n++; }
                p++; continue;
            }
        }
        if (ts->n<MAX_CTOKENS) { ts->toks[ts->n].kind=CT_EOF; ts->toks[ts->n].text[0]='\0'; ts->n++; }
        return 0;
    }
    /* ── C parser ─────────────────────────────────────────────────────────── */
    typedef struct { CTokStream* ts; } CParser;
    static CToken* ck(CParser* p) { return &p->ts->toks[p->ts->pos]; }
    static void cadv(CParser* p) { if (p->ts->pos < p->ts->n-1) p->ts->pos++; }
    static int cis(CParser* p, CTokKind k) { return ck(p)->kind==k; }
    static int cis_op(CParser* p, const char* op) { return ck(p)->kind==CT_OP && d_strcmp(ck(p)->text,op)==0; }
    static IRNode* parse_c_expr(CParser* p);
    static IRNode* parse_c_stmt(CParser* p);
    /* Parse a C type name (int, char*, double, etc.) → IR data_type string. */
    static const char* parse_c_type(CParser* p) {
        static char dt[16];
        dt[0]='\0';
        if (cis(p,CT_IDENT)) {
            const char* t = ck(p)->text;
            if (d_strcmp(t,"int")==0||d_strcmp(t,"long")==0||d_strcmp(t,"short")==0) d_strcpy(dt,"INT");
            else if (d_strcmp(t,"float")==0||d_strcmp(t,"double")==0) d_strcpy(dt,"FLOAT");
            else if (d_strcmp(t,"char")==0) d_strcpy(dt,"CHAR");
            else if (d_strcmp(t,"void")==0) d_strcpy(dt,"VOID");
            else if (d_strcmp(t,"bool")==0||d_strcmp(t,"_Bool")==0) d_strcpy(dt,"BOOL");
            else d_strcpy(dt,"ANY");
            cadv(p);
        }
        /* pointer */
        if (cis(p,CT_STAR)) { cadv(p); if (d_strcmp(dt,"CHAR")==0) d_strcpy(dt,"STR"); }
        return dt;
    }
    /* Parse a primary expression. */
    static IRNode* parse_c_primary(CParser* p) {
        CToken* t = ck(p);
        if (t->kind==CT_NUMBER) {
            char num[64]; d_strncpy(num,t->text,63); num[63]='\0';
            cadv(p);
            /* `1e-05` / `1E+20` have no dot but are floats, not ints */
            return ir_new("CONSTANT", num, (d_strchr(num,'.') || d_strchr(num,'e') || d_strchr(num,'E'))?"FLOAT":"INT");
        }
        if (t->kind==CT_STRING) {
            /* honor the long-literal spill: `text` is empty for any literal
             * that did not fit the inline 256 bytes */
            const char* sv = t->big ? t->big : t->text;
            cadv(p);
            return ir_new("CONSTANT", sv, "STR");
        }
        if (t->kind==CT_CHAR) {
            char s[16]; d_strncpy(s,t->text,15); s[15]='\0';
            cadv(p);
            return ir_new("CONSTANT", s, "CHAR");
        }
        if (t->kind==CT_IDENT) {
            char name[128]; d_strncpy(name,t->text,127); name[127]='\0';
            cadv(p);
            IRNode* node = ir_new("IDENTIFIER", name, "ANY");
            /* call */
            if (cis(p,CT_LPAREN)) {
                cadv(p);
                IRNode* call = ir_new("CALL", name, "ANY");
                while (!cis(p,CT_RPAREN) && !cis(p,CT_EOF)) {
                    IRNode* a = parse_c_expr(p);
                    if (a) ir_add_child(call, a);
                    if (cis(p,CT_COMMA)) cadv(p);
                    else break;
                }
                if (cis(p,CT_RPAREN)) cadv(p);
                return call;
            }
            /* array access */
            while (cis(p,CT_LBRACK)) {
                cadv(p);
                IRNode* acc = ir_new("ARRAY_ACCESS","","ANY");
                ir_add_child(acc, node);
                IRNode* idx = parse_c_expr(p);
                if (idx) ir_add_child(acc, idx);
                if (cis(p,CT_RBRACK)) cadv(p);
                node = acc;
            }
            /* member access . || -> */
            while (cis(p,CT_DOT)||cis(p,CT_ARROW)) {
                int arrow = cis(p,CT_ARROW);
                cadv(p);
                if (cis(p,CT_IDENT)) {
                    IRNode* ma = ir_new("MEMBER_ACCESS", ck(p)->text, arrow?"->":".");
                    ir_add_child(ma, node);
                    cadv(p);
                    node = ma;
                    if (cis(p,CT_LPAREN)) {
                        cadv(p);
                        IRNode* call = ir_new("CALL","COMPLEX","ANY");
                        ir_add_child(call, node);
                        while (!cis(p,CT_RPAREN) && !cis(p,CT_EOF)) {
                            IRNode* a = parse_c_expr(p);
                            if (a) ir_add_child(call, a);
                            if (cis(p,CT_COMMA)) cadv(p);
                            else break;
                        }
                        if (cis(p,CT_RPAREN)) cadv(p);
                        node = call;
                    }
                }
            }
            return node;
        }
        if (cis(p,CT_LPAREN)) {
            cadv(p);
            IRNode* e = parse_c_expr(p);
            if (cis(p,CT_RPAREN)) cadv(p);
            return e;
        }
        if (cis_op(p,"-")||cis_op(p,"+")||cis_op(p,"!")) {
            char op[8]; d_strncpy(op,ck(p)->text,7); op[7]='\0';
            cadv(p);
            IRNode* u = ir_new("UNARY_OP", op, "ANY");
            IRNode* e = parse_c_primary(p);
            if (e) ir_add_child(u, e);
            return u;
        }
        return NULL;
    }
    /* Parse a binary expression. */
    static IRNode* parse_c_binop(CParser* p) {
        IRNode* left = parse_c_primary(p);
        if (!left) return NULL;
        for (;;) {
            CToken* t = ck(p);
            const char* op = NULL;
            if (t->kind==CT_OP) op = t->text;
            else if (t->kind==CT_STAR) op = "*";
            else if (t->kind==CT_AMP) op = "&";
            if (!op) break;
            if (d_strcmp(op,"+")==0||d_strcmp(op,"-")==0||d_strcmp(op,"*")==0||d_strcmp(op,"/")==0||
                d_strcmp(op,"%")==0||d_strcmp(op,"==")==0||d_strcmp(op,"!=")==0||d_strcmp(op,"<")==0||
                d_strcmp(op,"<=")==0||d_strcmp(op,">")==0||d_strcmp(op,">=")==0||d_strcmp(op,"&&")==0||
                d_strcmp(op,"||")==0||d_strcmp(op,"&")==0||d_strcmp(op,"|")==0||d_strcmp(op,"^")==0||
                d_strcmp(op,"<<")==0||d_strcmp(op,">>")==0) {
                cadv(p);
                IRNode* right = parse_c_primary(p);
                if (!right) break;
                IRNode* b = ir_new("BINARY_OP", op, "ANY");
                ir_add_child(b, left);
                ir_add_child(b, right);
                left = b;
                continue;
            }
            break;
        }
        return left;
    }
    static IRNode* parse_c_expr(CParser* p) { return parse_c_binop(p); }
    /* Parse a statement. */
    static IRNode* parse_c_stmt(CParser* p) {
        CToken* t = ck(p);
        /* block */
        if (t->kind==CT_LBRACE) {
            cadv(p);
            IRNode* block = ir_new("BLOCK","","ANY");
            while (!cis(p,CT_RBRACE) && !cis(p,CT_EOF)) {
                IRNode* s = parse_c_stmt(p);
                if (s) ir_add_child(block, s);
            }
            if (cis(p,CT_RBRACE)) cadv(p);
            return block;
        }
        /* return expr; */
        if (t->kind==CT_IDENT && d_strcmp(t->text,"return")==0) {
            cadv(p);
            IRNode* r = ir_new("RETURN","","ANY");
            if (!cis(p,CT_SEMI)) {
                IRNode* e = parse_c_expr(p);
                if (e) ir_add_child(r, e);
            }
            if (cis(p,CT_SEMI)) cadv(p);
            return r;
        }
        if (t->kind==CT_IDENT && d_strcmp(t->text,"break")==0) { cadv(p); if (cis(p,CT_SEMI)) cadv(p); return ir_new("BREAK","","ANY"); }
        if (t->kind==CT_IDENT && d_strcmp(t->text,"continue")==0) { cadv(p); if (cis(p,CT_SEMI)) cadv(p); return ir_new("CONTINUE","","ANY"); }
        /* if (cond) stmt [else stmt] */
        if (t->kind==CT_IDENT && d_strcmp(t->text,"if")==0) {
            cadv(p);
            if (cis(p,CT_LPAREN)) cadv(p);
            IRNode* cond = parse_c_expr(p);
            if (cis(p,CT_RPAREN)) cadv(p);
            IRNode* ifn = ir_new("IF","","ANY");
            if (cond) ir_add_child(ifn, cond);
            IRNode* body = parse_c_stmt(p);
            if (body) ir_add_child(ifn, body);
            if (cis(p,CT_IDENT) && d_strcmp(ck(p)->text,"else")==0) {
                cadv(p);
                IRNode* eb = ir_new("ELSE_BLOCK","","ANY");
                IRNode* ebody = parse_c_stmt(p);
                if (ebody) ir_add_child(eb, ebody);
                ir_add_child(ifn, eb);
            }
            return ifn;
        }
        if (t->kind==CT_IDENT && d_strcmp(t->text,"while")==0) {
            cadv(p);
            if (cis(p,CT_LPAREN)) cadv(p);
            IRNode* cond = parse_c_expr(p);
            if (cis(p,CT_RPAREN)) cadv(p);
            IRNode* w = ir_new("WHILE","","ANY");
            if (cond) ir_add_child(w, cond);
            IRNode* body = parse_c_stmt(p);
            if (body) ir_add_child(w, body);
            return w;
        }
        if (t->kind==CT_IDENT && d_strcmp(t->text,"for")==0) {
            cadv(p);
            if (cis(p,CT_LPAREN)) cadv(p);
            IRNode* f = ir_new("FOR","","ANY");
            /* init */
            IRNode* init = parse_c_stmt(p);
            if (init) ir_add_child(f, init); else ir_add_child(f, ir_new("BLOCK","EMPTY_INIT","ANY"));
            /* cond */
            IRNode* cond = parse_c_expr(p);
            if (cond) ir_add_child(f, cond); else ir_add_child(f, ir_new("BLOCK","EMPTY_COND","ANY"));
            if (cis(p,CT_SEMI)) cadv(p);
            /* next */
            IRNode* nxt = parse_c_expr(p);
            if (nxt) ir_add_child(f, nxt); else ir_add_child(f, ir_new("BLOCK","EMPTY_NEXT","ANY"));
            if (cis(p,CT_RPAREN)) cadv(p);
            IRNode* body = parse_c_stmt(p);
            if (body) ir_add_child(f, body);
            return f;
        }
        /* variable declaration: type name [= expr]; */
        if (t->kind==CT_IDENT) {
            const char* dt = parse_c_type(p);
            if (cis(p,CT_IDENT)) {
                char name[128]; d_strncpy(name,ck(p)->text,127); name[127]='\0';
                cadv(p);
                /* array decl */
                if (cis(p,CT_LBRACK)) {
                    cadv(p);
                    IRNode* ad = ir_new("ARRAY_DECL", name, dt);
                    if (!cis(p,CT_RBRACK)) { IRNode* sz = parse_c_expr(p); if (sz) ir_add_child(ad, sz); }
                    if (cis(p,CT_RBRACK)) cadv(p);
                    if (cis(p,CT_SEMI)) cadv(p);
                    return ad;
                }
                IRNode* vd = ir_new("VAR_DECL", name, dt);
                if (cis_op(p,"=")) {
                    cadv(p);
                    IRNode* init = parse_c_expr(p);
                    if (init) ir_add_child(vd, init);
                }
                if (cis(p,CT_SEMI)) cadv(p);
                return vd;
            }
            /* expression statement */
            IRNode* e = parse_c_expr(p);
            IRNode* es = ir_new("EXPR_STMT","","ANY");
            if (e) ir_add_child(es, e);
            if (cis(p,CT_SEMI)) cadv(p);
            return es;
        }
        /* expression statement */
        IRNode* e = parse_c_expr(p);
        IRNode* es = ir_new("EXPR_STMT","","ANY");
        if (e) ir_add_child(es, e);
        if (cis(p,CT_SEMI)) cadv(p);
        return es;
    }
    /* Parse a full C source into an IR PROGRAM. */
    static IRNode* parse_c_to_ir_c(const char* src) {
        CTokStream* ts = (CTokStream*)d_alloc(sizeof(CTokStream));
        if (!ts) return NULL;
        if (c_tokenize(src, ts) != 0) { d_dealloc(ts); return NULL; }
        CParser p; p.ts = ts;
        IRNode* prog = ir_new("PROGRAM","","ANY");
        while (!cis(&p,CT_EOF)) {
            /* function definition: type name(params) { body } */
            if (cis(&p,CT_IDENT)) {
                const char* dt = parse_c_type(&p);
                if (cis(&p,CT_IDENT)) {
                    char fname[128]; d_strncpy(fname,ck(&p)->text,127); fname[127]='\0';
                    cadv(&p);
                    if (cis(&p,CT_LPAREN)) {
                        cadv(&p);
                        IRNode* fn = ir_new("FUNCTION_DEF", fname, dt);
                        IRNode* params = ir_new("BLOCK","PARAMS","ANY");
                        while (!cis(&p,CT_RPAREN) && !cis(&p,CT_EOF)) {
                            const char* pdt = parse_c_type(&p);
                            if (cis(&p,CT_IDENT)) {
                                char pname[128]; d_strncpy(pname,ck(&p)->text,127); pname[127]='\0';
                                cadv(&p);
                                ir_add_child(params, ir_new("PARAM_DECL", pname, pdt));
                            }
                            if (cis(&p,CT_COMMA)) cadv(&p);
                            else break;
                        }
                        if (cis(&p,CT_RPAREN)) cadv(&p);
                        ir_add_child(fn, params);
                        /* body */
                        if (cis(&p,CT_LBRACE)) {
                            IRNode* body = parse_c_stmt(&p);
                            if (body) ir_add_child(fn, body);
                        } else if (cis(&p,CT_SEMI)) {
                            cadv(&p); /* forward decl */
                        }
                        ir_add_child(prog, fn);
                        continue;
                    }
                    /* !a function — rewind && parse as statement */
                    p.ts->pos -= 2;
                    IRNode* s = parse_c_stmt(&p);
                    if (s) ir_add_child(prog, s);
                    continue;
                }
            }
            IRNode* s = parse_c_stmt(&p);
            if (s) ir_add_child(prog, s);
        }
        d_dealloc(ts);
        return prog;
    }
/* IR → C code generator, pure C.
     * Consumes the IR produced by py_parser/c_parser && emits C source.
     */
    /* Map IR data_type → C type. */
    static const char* ir_to_c_type(const char* dt) {
        if (!dt || !dt[0]) return "int";
        if (d_strcmp(dt,"INT")==0) return "int";
        if (d_strcmp(dt,"FLOAT")==0) return "double";
        if (d_strcmp(dt,"STR")==0) return "char*";
        if (d_strcmp(dt,"BOOL")==0) return "int";
        if (d_strcmp(dt,"VOID")==0) return "void";
        if (d_strcmp(dt,"CHAR")==0) return "char";

        /* Native C && system type mappings */
        if (d_strcmp(dt,"void_p")==0) return "void*";
        if (d_strcmp(dt,"void_pp")==0) return "void**";
        if (d_strcmp(dt,"float_p")==0) return "float*";
        if (d_strcmp(dt,"char_p")==0) return "char*";
        if (d_strcmp(dt,"int_p")==0) return "int*";
        if (d_strcmp(dt,"uintptr_t")==0) return "uintptr_t";
        if (d_strcmp(dt,"size_t")==0) return "size_t";
        if (d_strcmp(dt,"float")==0) return "float";
        if (d_strcmp(dt,"double")==0) return "double";

        return dt; /* Return custom class types verbatim */
    }
    /* Emit a node to a growing output buffer. */
    typedef struct {
        char* buf;
        size_t cap;
        size_t pos;
        int indent;
        const IRNode* prog;
    } CGen;
    static const IRNode* cg_find_fn_node(const IRNode* prog, const char* name) {
        if (!prog || !name) return NULL;
        for (int i = 0; i < prog->nchildren; i++) {
            const IRNode* c = prog->children[i];
            if (d_strcmp(c->type, "FUNCTION_DEF") == 0 && d_strcmp(c->value, name) == 0)
                return c;
        }
        return NULL;
    }
    /* Every occurrence of a shallow-copy VIEW name (`b = copy.copy(a)` on a 2D
