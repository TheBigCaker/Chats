                 * work, built per element from the column arrays. */
                isob = 1;
                has_src = 1;
                d_strncpy(obcls, cg_ob_lcls[cg_ob_lookup(it->value)], 31);
                obcls[31] = 0;
                if (obcls[0]) cg_note_cvar(v->value, obcls);
                else isob = 0;
            }
            else if ((nsize = cg_list_size(it->value)) >= 0) { isf = cg_list_is_float(it->value); isstrp = cg_list_is_str(it->value); islp = 1; has_src = 1; }
            else if (cg_is_dict(it->value)) { isdict = 1; dkf = cg_dict_kf(it->value); has_src = 1; }
            else if (cg_sl_index(it->value) >= 0) { issl = 1; has_src = 1; }
            else if (cg_is_str_node(it)) { isstr = 1; has_src = 1; }
        } else if (it && d_strcmp(it->type,"MEMBER_ACCESS")==0 && it->value &&
                   it->nchildren>0 && it->children[0] &&
                   cg_lf_recv_field(it->children[0], it->value)) {
            /* `for x in self.f` over a counted list FIELD: the live count is the
             * companion `_n` member and the elements are the instance's own
             * inline array.  The `islp` fallthrough emitted `<field>_n` with the
             * RECEIVER MISSING, so it named an undeclared variable. */
            is_lfield = 1;
            has_src = 1;
            if (cg_cur_cls_i >= 0 && cg_cur_cls_i < cg_cls_n) {
