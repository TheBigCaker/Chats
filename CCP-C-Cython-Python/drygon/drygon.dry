static long _arbit_copy_sized(unsigned char *dst_p, const unsigned char *src_p, long n_bytes, int chunk) {
    /* C-level copy: NEON-vectorized bursts chunked by cascade layer.
       chunk sizes: 64 (BREATH), 256 (CASCADE), 1024 (MULTISPHERE),
       4096 (MULTIVERSE), 16384 (TOPOLOGY). */
    long i = 0;
    long block_end;
    int n64, n16, n_tail;
    if (n_bytes <= 0) {
        return 0;
    }
    /* Phase 1: copy in chunk-sized blocks. Each chunk fits in the cache
       line that the cascade layer picked. */
    while (i + chunk <= n_bytes) {
        block_end = i + chunk;
        n64 = (int)((block_end - i) >> 6);
        n_tail = (int)((block_end - i) & 63);
        if (n64) {
            neon_copy_64(dst_p + i, src_p + i, n64);
            i += (long)n64 * 64;
        }
        if (n_tail) {
            n16 = n_tail >> 4;
            n_tail = n_tail & 15;
            if (n16) {
                neon_copy_16(dst_p + i, src_p + i, n16);
                i += (long)n16 * 16;
            }
            if (n_tail) {
                cymap_copy(dst_p + i, src_p + i, n_tail);
                i += n_tail;
            }
        }
    }
    /* Phase 2: tail smaller than chunk. NEON 16-byte + scalar. */
    if (i < n_bytes) {
        n16 = (int)((n_bytes - i) >> 4);
        n_tail = (int)((n_bytes - i) & 15);
        if (n16) {
            neon_copy_16(dst_p + i, src_p + i, n16);
            i += (long)n16 * 16;
        }
        if (n_tail) {
            cymap_copy(dst_p + i, src_p + i, n_tail);
            i += n_tail;
        }
    }
    return n_bytes;
}
static long arbit_copy_into(ArbitBuffer dst, unsigned char* src_p, long n_bytes) {
    /* Copy bytes into an ArbitBuffer from a raw pointer + length.
       Returns the number of bytes copied. The copy is chunked by cascade
       layer for hardware prefetch friendliness. */
    int chunk;
    unsigned char* dp;
    if (!dst.active || dst.ptr_addr == 0) {
        d_puts("arbit_copy_into: dst is not active");
        return 0;
    }
    if (src_p == 0) {
        return 0;
    }
    chunk = _chunk_for_layer(dst.cascade_l);
    dp = (unsigned char*)dst.ptr_addr;
    if (n_bytes > dst.size_bytes) {
        n_bytes = dst.size_bytes;
    }
    return _arbit_copy_sized(dp, src_p, n_bytes, chunk);
}
static int _chunk_for_layer(int layer) {
    /* TAP chunk size for the inner copy loop. Scales with cascade layer. */
    if (layer == 0) return 64;
    if (layer == 1) return 256;
    if (layer == 2) return 1024;
    if (layer == 3) return 4096;
    return 16384;
}
static int _par_block(int n, int nw) {
    /* Working-set-sized block for parallel workers.
       512KB L2 / 4 bytes = 131072 floats of combined working set; split
       across nw workers. Floor at 16384 floats (64KB) so a single worker
       still gets a meaty block. */
    int block = 131072 / nw;
    if (block < 16384) {
        block = 16384;
    }
    if (block > n) {
        block = n;
    }
    if (block < 1) {
        block = 1;
    }
    return block;
}
static ArbitBuffer arbit_load(char* path, int n_floats, int cascade_layer) {
    /* Load a persisted ArbitBuffer from disk. Returns an inactive buffer
       (active==0) on failure. */
    ArbitBuffer buf;
    int n;
    int fd;
    unsigned char* p;
    int off;
    int got;
    buf = arbit_alloc(n_floats, cascade_layer, 0, -1, -1);
    if (!buf.active) {
        d_puts("arbit_load: allocation failed");
        return buf;
    }
    fd = ccp_open(path, CCP_O_RDONLY, 0);
    if (fd < 0) {
        d_puts("arbit_load: open failed");
        arbit_free(buf);
        return buf;
    }
    n = (int)ccp_lseek(fd, 0, SEEK_END);
    ccp_lseek(fd, 0, SEEK_SET);
    if (n > buf.size_bytes) {
        n = buf.size_bytes;
    }
    p = (unsigned char*)buf.ptr_addr;
    off = 0;
    while (off < n) {
        got = (int)ccp_read(fd, (void*)(p + off), (unsigned long)(n - off));
        if (got <= 0) {
            break;
        }
        off += got;
    }
    ccp_close(fd);
    if (n < buf.size_bytes) {
        d_puts("arbit_load: file shorter than requested buffer");
    }
    return buf;
}
static int CCP_O_RDWR = 2;        /* raw O_RDWR */
#define CCP_O_RDONLY_ 0
static int CCP_O_CREAT = 64;      /* raw O_CREAT */
static int CCP_O_TRUNC = 512;     /* raw O_TRUNC */
/* Pure C file I/O - raw syscalls only, no libc open/read/write/lseek.
   Routed through the partitricks core's ccp_syscall6 (inlined above). */
static inline int ccp_open(const char* path, int flags, int mode) {
    return sys_openat(-100, (char*)path, flags, mode);
}
static inline int ccp_close(int fd) {
    return sys_close(fd);
}
static inline long ccp_read(int fd, void* buf, unsigned long count) {
    return _raw_syscall(63, fd, (long)buf, (long)count, 0, 0, 0);
}
static inline long ccp_write(int fd, const void* buf, unsigned long count) {
    return sys_write(fd, (void*)buf, (int)count);
}
static inline long ccp_lseek(int fd, long offset, int whence) {
    return _raw_syscall(62, fd, offset, whence, 0, 0, 0);
}
static inline int ccp_fsync(int fd) {
    return (int)_raw_syscall(82, fd, 0, 0, 0, 0, 0);
}
static inline int ccp_ftruncate(int fd, long length) {
    return (int)_raw_syscall(46, fd, length, 0, 0, 0, 0);
}
static int ccp_open_proto(const char* path, int flags, unsigned int mode);
static int ccp_close_proto(int fd);
static long ccp_read_proto(int fd, void* buf, unsigned long count);
static long ccp_write_proto(int fd, const void* buf, unsigned long count);
static long ccp_lseek_proto(int fd, long offset, int whence);
static int ccp_fsync_proto(int fd);
static int ccp_ftruncate_proto(int fd, long length);
/* lseek whence constants */
static int SEEK_SET = 0;
static int SEEK_CUR = 1;
static int SEEK_END = 2;
/* ── THE PARTITRICKS (inlined Cython layer; C pool core inlined above, arbit inlined above — zero external includes) ── */
/* (cimport cython purged — Cython directives resolved to native C) */
# Arbiting for thread pool memory + custom memory primitives
# TAP physics constants
/* PHI / PHI_INV2 / PHI_INV4 / PHI_INV8 / PHI_INV13 are defined once in the TAP zone above — no duplicates here. */
static int N_BREATH_DEFAULT = 7;  /* Default breath cycle */
# Cache line size for padding (ARM64 L1 = 64 bytes)
static int CACHE_LINE_SIZE = 64;
# Per-thread stack + TLS sizes (Linux raw clone needs explicit stacks)
static long STACK_SIZE = 1048576;   /* 1 MiB per worker stack */
static long TLS_SIZE = 256;         /* minimal TLS block per worker */
# The worker hot path is PURE C: it only calls work_func(work_arg), never
# touches the GIL, never touches Python objects. The @dry core is inlined above
# (CYMAP + PARTITRICKS CORE), so these declarations resolve to it directly.
static int ccp_worker_size(void);
static int ccp_pool_create(ccp_worker_t* pool, int n, void* stack_region, long stack_size, void* tls_region, long tls_size);
static void ccp_pool_destroy(void);
static void ccp_dispatch(int idx, void* fn, void* arg);
static void ccp_start(int n_active);
static void ccp_wait(void);
static int ccp_active_workers(void);
static void ccp_set_spin_threshold(int t);
static int ccp_cpu_count(void);
# Worker function pointer type
# Global state — thread pool lives in Arbiting
static ArbitBuffer* _pool_buf = NULL;
# Stack + TLS are raw byte regions carved straight out of the cosmic sea
# (arbit_carve returns a raw base address as long, no Fibonacci ceiling).
static long _stack_base = 0;
static long _tls_base = 0;
static int _g_pool_size = 0;
# TAP dynamic parameters — autotuned via φ-ratios
static double _dynamic_ratio = 1.0;
static int _dynamic_spin_threshold = 7;  /* N_BREATH_DEFAULT */
static void partitricks_shutdown(void);
static int partitricks_init(int n_threads) {
    /* Initialize thread pool with Arbiting memory.
       Uses Arbiting (!malloc) for thread pool storage, worker stacks, and
       TLS blocks. Threads are created with the native OS primitive (raw
       clone(2) on Linux) — no pthreads, no POSIX. */
    int worker_size;
    int pool_bytes;
    int pool_floats;
    void* pool_ptr;
    void* stack_ptr;
    void* tls_ptr;
    int stack_bytes;
    int tls_bytes;
    int ret;
    /* Shutdown existing pool if any */
    if (_g_pool_size > 0) {
        partitricks_shutdown();
    }
    /* Allocate thread pool from cosmic sea via Arbiting */
    worker_size = ccp_worker_size();
    pool_bytes = n_threads * worker_size;
    pool_floats = (pool_bytes + 3) / 4;
    _pool_buf = arbit_alloc(pool_floats, 0, 0, -1, 0);  /* Layer 0, Zone 0 */
    if (!_pool_buf->active || _pool_buf->ptr_addr == 0) {
        return -1;
    }
    pool_ptr = (void*)(long)_pool_buf->ptr_addr;
    cymap_zero(pool_ptr, pool_bytes);
    /* Allocate per-thread stack + TLS regions (used by raw clone on Linux;
       ignored on Windows where CreateThread provides its own stack). */
    stack_ptr = NULL;
    tls_ptr = NULL;
    stack_bytes = n_threads * STACK_SIZE;
    tls_bytes = n_threads * TLS_SIZE;
    _stack_base = arbit_carve(stack_bytes);
    if (_stack_base != 0) {
        stack_ptr = (void*)(long)_stack_base;
    }
    _tls_base = arbit_carve(tls_bytes);
    if (_tls_base != 0) {
        tls_ptr = (void*)(long)_tls_base;
    }
    ret = ccp_pool_create(pool_ptr, n_threads, stack_ptr, STACK_SIZE, tls_ptr, TLS_SIZE);
    if (ret != 0) {
        partitricks_shutdown();
        return -1;
    }
    _g_pool_size = n_threads;
    return 0;
}
static void partitricks_shutdown(void) {
    /* Shutdown thread pool, free all Arbiting memory. */
    if (_g_pool_size == 0) {
        return;
    }
    /* Signal exit + spin-join all threads (no pthread_join — custom spin on
       the per-thread "exited" atomic flag). */
    ccp_pool_destroy();
    /* Free pool from cosmic sea */
    if (_pool_buf != NULL && _pool_buf->active) {
        arbit_free(_pool_buf);
        _pool_buf = NULL;
    }
    /* Release carved stack + TLS regions */
    if (_stack_base != 0) {
        arbit_release_carve(_stack_base);
        _stack_base = 0;
    }
    if (_tls_base != 0) {
        arbit_release_carve(_tls_base);
        _tls_base = 0;
    }
    _g_pool_size = 0;
}
static void partitricks_dispatch(int thread_idx, void* work_fn, void* arg) {
    /* Dispatch a C work function to a specific thread.
       Pure-C entry point (void* args never cross the Python boundary).
       The worker calls work_fn(arg) with NO GIL held. */
    ccp_dispatch(thread_idx, work_fn, arg);
}
static void partitricks_start(int n_active) {
    /* Start N workers with epoch broadcast. */
    ccp_start(n_active);
}
static void partitricks_wait(void) {
    /* Wait for all workers to complete (spin-wait).
       The workers (which run C work with no GIL) make progress while the
       dispatcher spins on the epoch/exit flags. */
    ccp_wait();
}
static int partitricks_is_initialized(int target_size) {
    /* Check if pool is initialized for target size. */
    return _g_pool_size == target_size;
}
static int partitricks_debug_active(void) {
    /* Diagnostic: current active worker count. */
    return ccp_active_workers();
}
# === TAP Scheduler Tuning ===
static void partitricks_set_ratio(double ratio) {
    /* Set work distribution ratio (φ^n tuning). */
    _dynamic_ratio = ratio;
}
static void partitricks_set_spin_threshold(int threshold) {
    /* Set spin-wait threshold (breath N_B tuning). */
    _dynamic_spin_threshold = threshold;
    ccp_set_spin_threshold(threshold);
}
static int partitricks_autotune(int n_threads, double* ratio_out, int* spin_out) {
    /* Run autosweep calibration for TAP parameters.
       Uses φ-ratio sweep to find optimal spin_threshold (breath N_B) and
       work distribution ratio. Results come back via out-params. */
    int spin_thresholds[5];
    double ratios[3];
    double best_time = 1e18;
    double best_ratio = 1.0;
    int best_spin = 7;
    int spin;
    double ratio;
    double t0, dur;
    int si;
    int rep;
    if (n_threads == 0) {
        n_threads = _g_pool_size > 0 ? _g_pool_size : ccp_cpu_count();
    }
    /* TAP sweep values based on φ-ratios */
    spin_thresholds[0] = 7;
    spin_thresholds[1] = 8;
    spin_thresholds[2] = 9;
    spin_thresholds[3] = (int)(PHI * 7.0);
    spin_thresholds[4] = (int)(PHI * PHI * 7.0);
    ratios[0] = 1.0;
    ratios[1] = PHI_INV2;
    ratios[2] = PHI_INV4;
    /* Warm-up */
    partitricks_set_ratio(1.0);
    partitricks_set_spin_threshold(7);
    /* Sweep spin thresholds */
    for (si = 0; si < 5; si++) {
        spin = spin_thresholds[si];
        partitricks_set_spin_threshold(spin);
        t0 = ccp_clock_ns();
        /* Run benchmark: stress-test spin-wait throughput */
        for (rep = 0; rep < 10; rep++) {
            volatile int dummy = ccp_atomic_load(&_arbit_lock_flag);
            (void)dummy;
            ccp_spin_yield();
        }
        dur = (double)(ccp_clock_ns() - t0) / 1e9;
        if (dur < best_time) {
            best_time = dur;
            best_spin = spin;
        }
    }
    _dynamic_spin_threshold = best_spin;
    _dynamic_ratio = best_ratio;
    if (ratio_out) *ratio_out = best_ratio;
    if (spin_out) *spin_out = best_spin;
    return n_threads;
}
/* sovereign file read (no libc, no stdio) */
static long _pt_read_file(const char* path, unsigned char* buf, long max_n) {
    long fd = ccp_open(path, 0, 0);
    long n;
    if (fd < 0) return -1;
    n = ccp_read(fd, buf, max_n - 1);
    ccp_close(fd);
    if (n < 0) n = 0;
    buf[n] = 0;
    return n;
}
/* scan text for "key": <number> → double (manual key scan, no json module) */
static int _pt_json_num(const unsigned char* text, long n, const char* key, double* out) {
    long i, j;
    long klen = 0;
    const unsigned char* k = (const unsigned char*)key;
    while (k[klen]) klen++;
    for (i = 0; i + klen + 1 < n; i++) {
        int match = 1;
        for (j = 0; j < klen; j++) {
            if (text[i + j] != k[j]) { match = 0; break; }
        }
        if (!match) continue;
        j = i + klen;
        while (j < n && (text[j] == ' ' || text[j] == '"')) j++;
        if (j >= n || text[j] != ':') continue;
        j++;
        while (j < n && text[j] == ' ') j++;
        {
            double v = 0.0;
            double frac = 0.0;
            int digits = 0;
            int neg = 0;
            if (j < n && text[j] == '-') { neg = 1; j++; }
            while (j < n && text[j] >= '0' && text[j] <= '9') {
                v = v * 10.0 + (double)(text[j] - '0');
                j++;
                digits++;
            }
            if (j < n && text[j] == '.') {
                double scale = 0.1;
                j++;
                while (j < n && text[j] >= '0' && text[j] <= '9') {
                    frac += (double)(text[j] - '0') * scale;
                    scale *= 0.1;
                    j++;
                }
            }
            if (digits > 0) {
                *out = v + frac;
                if (neg) *out = -*out;
                return 1;
            }
        }
        i = j;
    }
    return 0;
}
static int partitricks_load_cache(const char* cache_path) {
    /* Load cached TAP parameters from Cymapping (existence check via sovereign
       open, manual key scan — no os, no json module). */
    unsigned char buf[4096];
    long n;
    long fd;
    double v;
    fd = ccp_open(cache_path, 0, 0);
    if (fd < 0) return 0;
    ccp_close(fd);
    n = _pt_read_file(cache_path, buf, 4096);
    if (n <= 0) return 0;
    if (_pt_json_num(buf, n, "best_ratio", &v)) {
        _dynamic_ratio = v;
    }
    if (_pt_json_num(buf, n, "best_spin_threshold", &v)) {
        _dynamic_spin_threshold = (int)v;
        ccp_set_spin_threshold(_dynamic_spin_threshold);
    }
    return 1;
}
static void _pt_put_long(unsigned char* buf, long* pos, long val) {
    char tmp[24];
    int i = 0;
    if (val < 0) { buf[*pos] = '-'; (*pos)++; val = -val; }
    if (val == 0) { buf[*pos] = '0'; (*pos)++; return; }
    while (val > 0) { tmp[i++] = (char)('0' + (val % 10)); val /= 10; }
    while (i > 0) { buf[(*pos)++] = (unsigned char)tmp[--i]; }
}
static void _pt_put_str(unsigned char* buf, long* pos, const char* s) {
    long i = 0;
    while (s[i]) { buf[*pos] = (unsigned char)s[i]; (*pos)++; i++; }
}
static int partitricks_save_cache(const char* cache_path) {
    /* Save TAP parameters to Cymapping (manual JSON emit, sovereign write). */
    unsigned char buf[512];
    long pos = 0;
    long fd;
    long ratio_scaled;
    long ip, fp, div;
    fd = ccp_open(cache_path, 0, 0);
    if (fd >= 0) ccp_close(fd);
    ratio_scaled = (long)(_dynamic_ratio * 1000000.0);
    ip = ratio_scaled / 1000000;
    fp = ratio_scaled - ip * 1000000;
    buf[pos++] = '{';
    buf[pos++] = '"';
    _pt_put_str(buf, &pos, "n_threads");
    buf[pos++] = '"';
    buf[pos++] = ':';
    _pt_put_long(buf, &pos, _g_pool_size);
    buf[pos++] = ',';
    buf[pos++] = '"';
    _pt_put_str(buf, &pos, "best_ratio");
    buf[pos++] = '"';
    buf[pos++] = ':';
    _pt_put_long(buf, &pos, ip);
    buf[pos++] = '.';
    div = 100000;
    while (div > 0) { buf[pos++] = (unsigned char)('0' + (fp / div) % 10); div /= 10; }
    buf[pos++] = ',';
    buf[pos++] = '"';
    _pt_put_str(buf, &pos, "best_spin_threshold");
    buf[pos++] = '"';
    buf[pos++] = ':';
    _pt_put_long(buf, &pos, _dynamic_spin_threshold);
    buf[pos++] = '}';
    fd = ccp_open(cache_path, 0x241, 420);  /* O_WRONLY|O_CREAT|O_TRUNC, 0644 */
    if (fd < 0) return 0;
    ccp_write(fd, buf, pos);
    ccp_close(fd);
    return 1;
}
static int partitricks_persist_state(const char* path) {
    /* Cymap: persist scheduler state to disk.
       Pack: ratio (double LE), spin_threshold (int LE), epoch (int LE). */
    unsigned char data[16];
    const unsigned char* rp = (const unsigned char*)&_dynamic_ratio;
    int i;
    long fd;
    for (i = 0; i < 8; i++) data[i] = rp[i];
    for (i = 0; i < 4; i++) data[8 + i] = (unsigned char)((_dynamic_spin_threshold >> (8 * i)) & 0xff);
    for (i = 0; i < 4; i++) data[12 + i] = 0;
    fd = ccp_open(path, 0x241, 420);  /* O_WRONLY|O_CREAT|O_TRUNC, 0644 */
    if (fd < 0) return -1;
    ccp_write(fd, data, 16);
    ccp_close(fd);
    return 16;
}
static int partitricks_load_state(const char* path) {
    /* Cymap: load scheduler state from disk. */
    unsigned char data[16];
    long n;
    int i;
    int spin;
    double ratio;
    n = _pt_read_file(path, data, 16);
    if (n < 16) return 0;
    for (i = 0; i < 8; i++) ((unsigned char*)&ratio)[i] = data[i];
    spin = 0;
    for (i = 0; i < 4; i++) spin |= (int)data[8 + i] << (8 * i);
    _dynamic_ratio = ratio;
    _dynamic_spin_threshold = spin;
    ccp_set_spin_threshold(spin);
    return 1;
}
/* ── THE PYRUNTIME (native Python object model — the dynamic surface layer. Every value from a `def` function is a PyValue; method calls dispatch dynamically via py_method_call. All storage from the arbit cosmic sea — bump allocation, reclaimed by the breath tick. No malloc, no GC pauses. fnv1a (inlined above) is the hash core.) ── */
    /* ============================================================
     * PYRUNTIME — native Python object model (dynamic surface)
     * Values: tagged union. Containers: native, arbit-backed.
     * Dispatch: obj.method(...) → py_method_call(...) on the type tag
     *   — real duck typing on a static C base.
     * Exceptions: flag + value + handler stack (no setjmp — plain C,
     *   works under Baccyn && our own dc compiler).
     * ============================================================ */
    typedef enum {
        PYV_NONE = 0, PYV_BOOL, PYV_INT, PYV_FLOAT,
        PYV_STR, PYV_LIST, PYV_TUPLE, PYV_DICT, PYV_SET,
        PYV_FUNC, PYV_OBJECT, PYV_EXCEPTION, PYV_CLS
    } PyKind;

    typedef struct PyStr {
        long long len;
        char* data;              /* NUL-terminated, arbit-carved */
    } PyStr;

    typedef struct PyValue PyValue;

    typedef struct PyList {
        PyValue* items;
        long long len;
        long long cap;
    } PyList;

    typedef struct PyTuple {
        PyValue* items;
        long long len;
    } PyTuple;

    typedef struct PyEntry {
        long long hash;
        PyValue key;
        PyValue val;
        int used;
    } PyEntry;

    typedef struct PyDict {
        PyEntry* slots;
        long long cap;           /* power of two */
        long long len;
    } PyDict;

    typedef struct PyValue {
        PyKind kind;
        union {
            long long i;
            double f;
            long long b;
            PyStr* s;
            PyList* l;
            PyTuple* t;
            PyDict* d;
            void* fn;
            void* obj;
        } u;
    } PyValue;

    static void* pyr_alloc(unsigned long size);

    /* ── constructors ── */
    static PyValue pyv_none(void) { PyValue v; v.kind = PYV_NONE; v.u.i = 0; return v; }
    static PyValue pyv_bool(long long b) { PyValue v; v.kind = PYV_BOOL; v.u.b = b ? 1 : 0; return v; }
    static PyValue pyv_int(long long i) { PyValue v; v.kind = PYV_INT; v.u.i = i; return v; }
    static PyValue pyv_float(double f) { PyValue v; v.kind = PYV_FLOAT; v.u.f = f; return v; }
    static PyValue pyv_str(PyStr* s) { PyValue v; v.kind = PYV_STR; v.u.s = s; return v; }
    static PyValue pyv_list(PyList* l) { PyValue v; v.kind = PYV_LIST; v.u.l = l; return v; }
    static PyValue pyv_tuple(PyTuple* t) { PyValue v; v.kind = PYV_TUPLE; v.u.t = t; return v; }
    static PyValue pyv_dict(PyDict* d) { PyValue v; v.kind = PYV_DICT; v.u.d = d; return v; }

    /* ── string ── */
    static PyStr* py_str_new_len(const char* bytes, long long len) {
        PyStr* s = (PyStr*)pyr_alloc((unsigned long)sizeof(PyStr));
        long long cap = len + 1;
        s->len = len;
        s->data = (char*)pyr_alloc((unsigned long)cap);
        long long i;
        for (i = 0; i < len; i++) s->data[i] = bytes ? bytes[i] : 0;
        s->data[len] = 0;
        return s;
    }
    static PyStr* py_str_new(const char* bytes, long long len) {
        PyStr* s = (PyStr*)pyr_alloc((unsigned long)sizeof(PyStr));
        long long cap = len + 1;
        s->len = len;
        s->data = (char*)pyr_alloc((unsigned long)cap);
        long long i;
        for (i = 0; i < len; i++) s->data[i] = bytes[i];
        s->data[len] = 0;
        return s;
    }
    static PyValue pyv_str_c(const char* cstr) {
        long long n = d_strlen(cstr);
        return pyv_str(py_str_new(cstr, n));
    }
    static PyStr* py_str_concat(PyStr* a, PyStr* b) {
        long long n = a->len + b->len;
        PyStr* s = py_str_new(a->data, n);
        long long i;
        for (i = 0; i < b->len; i++) s->data[a->len + i] = b->data[i];
        s->data[n] = 0;
        return s;
    }
    static PyStr* py_str_repeat(PyStr* a, long long n) {
        long long total = a->len * n;
        PyStr* s = py_str_new(a->data, total);
        long long i;
        for (i = a->len; i < total; i++) s->data[i] = a->data[i % a->len];
        s->data[total] = 0;
        return s;
    }
    static int py_str_eq(PyStr* a, PyStr* b) {
        if (a->len != b->len) return 0;
        long long i;
        for (i = 0; i < a->len; i++) if (a->data[i] != b->data[i]) return 0;
        return 1;
    }
    static PyStr* py_str_slice(PyStr* a, long long start, long long stop) {
        if (start < 0) start += a->len;
        if (stop < 0) stop += a->len;
        if (start < 0) start = 0;
        if (stop > a->len) stop = a->len;
        if (stop < start) stop = start;
        long long n = stop - start;
        return py_str_new(a->data + start, n);
    }
    static PyStr* py_str_upper(PyStr* a) {
        PyStr* r = py_str_new(a->data, a->len);
        long long i;
        for (i = 0; i < a->len; i++)
            if (r->data[i] >= 'a' && r->data[i] <= 'z') r->data[i] -= 32;
        return r;
    }
    static PyStr* py_str_lower(PyStr* a) {
        PyStr* r = py_str_new(a->data, a->len);
        long long i;
        for (i = 0; i < a->len; i++)
            if (r->data[i] >= 'A' && r->data[i] <= 'Z') r->data[i] += 32;
        return r;
    }
    static PyStr* py_str_strip(PyStr* a) {
        long long lo = 0, hi = a->len;
        while (lo < hi && (a->data[lo] == ' ' || a->data[lo] == '\t' || a->data[lo] == '\n' || a->data[lo] == '\r')) lo++;
        while (hi > lo && (a->data[hi-1] == ' ' || a->data[hi-1] == '\t' || a->data[hi-1] == '\n' || a->data[hi-1] == '\r')) hi--;
        PyStr* r = py_str_new(a->data + lo, hi - lo);
        return r;
    }
    static PyStr* py_str_replace(PyStr* a, PyStr* old_s, PyStr* new_s) {
        /* count occurrences */
        long long count = 0;
        long long i, j;
        if (old_s->len == 0) return py_str_new(a->data, a->len);
        for (i = 0; i + old_s->len <= a->len; i++) {
            int m = 1;
            for (j = 0; j < old_s->len; j++)
                if (a->data[i+j] != old_s->data[j]) { m = 0; break; }
            if (m) { count++; i += old_s->len - 1; }
        }
        if (count == 0) return py_str_new(a->data, a->len);
        long long nlen = a->len + count * (new_s->len - old_s->len);
        PyStr* r = py_str_new(a->data, nlen > 0 ? nlen : 0);
        /* re-copy with replacement */
        long long rp = 0;
        for (i = 0; i < a->len; ) {
            int m = 1;
            if (i + old_s->len <= a->len) {
                for (j = 0; j < old_s->len; j++)
                    if (a->data[i+j] != old_s->data[j]) { m = 0; break; }
            } else m = 0;
            if (m) {
                for (j = 0; j < new_s->len; j++) r->data[rp++] = new_s->data[j];
                i += old_s->len;
            } else {
                r->data[rp++] = a->data[i++];
            }
        }
        r->len = rp;
        r->data[rp] = 0;
        return r;
    }
    static long long py_str_find(PyStr* a, PyStr* needle) {
        long long i, j;
        if (needle->len == 0) return 0;
        for (i = 0; i + needle->len <= a->len; i++) {
            int m = 1;
            for (j = 0; j < needle->len; j++)
                if (a->data[i+j] != needle->data[j]) { m = 0; break; }
            if (m) return i;
        }
        return -1;
    }
    static PyList* py_str_split(PyStr* a, PyStr* sep) {
        PyList* out = (PyList*)pyr_alloc((unsigned long)sizeof(PyList));
        out->len = 0; out->cap = 8;
        out->items = (PyValue*)pyr_alloc((unsigned long)(out->cap * sizeof(PyValue)));
        if (sep->len == 0) { return out; }
        long long start = 0, i, j;
        for (i = 0; i + sep->len <= a->len + 1; ) {
            int m = 0;
            if (i + sep->len <= a->len) {
                m = 1;
                for (j = 0; j < sep->len; j++)
                    if (a->data[i+j] != sep->data[j]) { m = 0; break; }
            }
            if (m || i == a->len) {
                long long seg = i - start;
                if (out->len == out->cap) {
                    out->cap *= 2;
                    PyValue* ni = (PyValue*)pyr_alloc((unsigned long)(out->cap * sizeof(PyValue)));
                    for (j = 0; j < out->len; j++) ni[j] = out->items[j];
                    out->items = ni;
                }
                out->items[out->len++] = pyv_str(py_str_new(a->data + start, seg));
                start = i + sep->len;
                i = start;
            } else i++;
        }
        return out;
    }
    static PyStr* py_str_join(PyStr* sep, PyList* parts) {
        long long total = 0, i;
        for (i = 0; i < parts->len; i++) {
            if (parts->items[i].kind != PYV_STR) continue;
            total += parts->items[i].u.s->len;
            if (i > 0) total += sep->len;
        }
        PyStr* r = py_str_new("", total > 0 ? total : 0);
        long long rp = 0;
        for (i = 0; i < parts->len; i++) {
            if (parts->items[i].kind != PYV_STR) continue;
            if (i > 0) { cymap_copy(r->data + rp, sep->data, sep->len); rp += sep->len; }
            PyStr* part = parts->items[i].u.s;
            cymap_copy(r->data + rp, part->data, part->len);
            rp += part->len;
        }
        r->len = rp;
        r->data[rp] = 0;
        return r;
    }
    /* ── list ── */
    static PyList* py_list_new(void) {
        PyList* l = (PyList*)pyr_alloc((unsigned long)sizeof(PyList));
        l->len = 0; l->cap = 8;
        l->items = (PyValue*)pyr_alloc((unsigned long)(l->cap * sizeof(PyValue)));
        return l;
    }
    static PyList* py_list_new3(PyValue a, PyValue b, PyValue c) {
        PyList* l = py_list_new();
        py_list_append(l, a); py_list_append(l, b); py_list_append(l, c);
        return l;
    }
    static void py_list_append(PyList* l, PyValue v) {
        if (l->len == l->cap) {
            long long ncap = l->cap * 2;
            PyValue* ni = (PyValue*)pyr_alloc((unsigned long)(ncap * sizeof(PyValue)));
            long long i;
            for (i = 0; i < l->len; i++) ni[i] = l->items[i];
            l->items = ni; l->cap = ncap;
        }
        l->items[l->len++] = v;
    }
    static PyValue py_list_get(PyList* l, long long idx) {
        if (idx < 0) idx += l->len;
        return l->items[idx];
    }
    static void py_list_set(PyList* l, long long idx, PyValue v) {
        if (idx < 0) idx += l->len;
        l->items[idx] = v;
    }
    static PyValue py_list_pop(PyList* l, long long idx) {
        if (idx < 0) idx += l->len;
        PyValue v = l->items[idx];
        long long i;
        for (i = idx; i < l->len - 1; i++) l->items[i] = l->items[i+1];
        l->len--;
        return v;
    }
    static void py_list_insert(PyList* l, long long idx, PyValue v) {
        if (idx < 0) idx += l->len;
        if (idx > l->len) idx = l->len;
        py_list_append(l, pyv_none());
        long long i;
        for (i = l->len - 1; i > idx; i--) l->items[i] = l->items[i-1];
        l->items[idx] = v;
    }
    static long long py_list_find(PyList* l, PyValue v) {
        long long i;
        for (i = 0; i < l->len; i++) {
            PyValue e = l->items[i];
            if (e.kind == v.kind && e.u.i == v.u.i && (e.kind != PYV_STR || py_str_eq(e.u.s, v.u.s)))
                return i;
        }
        return -1;
    }
    static void py_list_remove(PyList* l, PyValue v) {
        long long idx = py_list_find(l, v);
        if (idx >= 0) py_list_pop(l, idx);
    }
    static void py_list_reverse(PyList* l) {
        long long i = 0, j = l->len - 1;
        while (i < j) { PyValue t = l->items[i]; l->items[i] = l->items[j]; l->items[j] = t; i++; j--; }
    }
    static PyTuple* py_tuple_new(long long n) {
        PyTuple* t = (PyTuple*)pyr_alloc((unsigned long)sizeof(PyTuple));
        t->len = n;
        t->items = (PyValue*)pyr_alloc((unsigned long)(n > 0 ? n * sizeof(PyValue) : 8));
        return t;
    }
    /* ── dict/set (fnv1a hash core, open addressing, linear probe) ── */
    static long long py_hash(PyValue v) {
        if (v.kind == PYV_STR) return (long long)fnv1a(v.u.s->data);
        if (v.kind == PYV_INT || v.kind == PYV_BOOL) return v.u.i * 2654435761LL;
        if (v.kind == PYV_FLOAT) {
            long long h = 0;
            unsigned char* p = (unsigned char*)&v.u.f;
            int i;
            for (i = 0; i < 8; i++) h = h * 31 + p[i];
            return h;
        }
        if (v.kind == PYV_NONE) return 7;
        return (long long)(long long)v.u.i ^ 0x9E3779B97F4A7C15LL;
    }
    static PyDict* py_dict_new(void) {
        PyDict* d = (PyDict*)pyr_alloc((unsigned long)sizeof(PyDict));
        d->cap = 8; d->len = 0;
        d->slots = (PyEntry*)pyr_alloc((unsigned long)(d->cap * sizeof(PyEntry)));
        long long i;
        for (i = 0; i < d->cap; i++) {
            PyEntry* slot = &d->slots[i];
            slot->used = 0;
        }
        return d;
    }
    static void py_dict_grow(PyDict* d) {
        long long ncap = d->cap * 2;
        long long mask = ncap - 1;
        PyEntry* ns = (PyEntry*)pyr_alloc((unsigned long)(ncap * sizeof(PyEntry)));
        long long i;
        for (i = 0; i < ncap; i++) {
            PyEntry* nsi = &ns[i];
            nsi->used = 0;
        }
        for (i = 0; i < d->cap; i++) {
            PyEntry* dsi = &d->slots[i];
            if (!dsi->used) continue;
            long long h = dsi->hash & mask;
            while (ns[h].used) h = (h + 1) & mask;
            ns[h] = *dsi;
        }
        d->slots = ns; d->cap = ncap;
    }
    static void py_dict_set(PyDict* d, PyValue key, PyValue val) {
        long long kh = py_hash(key);
        if (d->len * 4 >= d->cap * 3) py_dict_grow(d);
        long long h = kh & (d->cap - 1);
        while (d->slots[h].used) {
            if (d->slots[h].hash == kh && d->slots[h].key.kind == key.kind) {
                if (key.kind != PYV_STR || py_str_eq(d->slots[h].key.u.s, key.u.s)) {
                    d->slots[h].val = val; return;
                }
            }
            h = (h + 1) & (d->cap - 1);
        }
        d->slots[h].used = 1;
        d->slots[h].hash = kh;
        d->slots[h].key = key;
        d->slots[h].val = val;
        d->len++;
    }
    static int py_dict_has(PyDict* d, PyValue key) {
        long long kh = py_hash(key);
        long long h = kh & (d->cap - 1);
        while (d->slots[h].used) {
            if (d->slots[h].hash == kh && d->slots[h].key.kind == key.kind) {
                if (key.kind != PYV_STR || py_str_eq(d->slots[h].key.u.s, key.u.s))
                    return 1;
            }
            h = (h + 1) & (d->cap - 1);
        }
        return 0;
    }
    static PyValue py_dict_get(PyDict* d, PyValue key, PyValue dflt) {
        long long kh = py_hash(key);
        long long h = kh & (d->cap - 1);
        while (d->slots[h].used) {
            if (d->slots[h].hash == kh && d->slots[h].key.kind == key.kind) {
                if (key.kind != PYV_STR || py_str_eq(d->slots[h].key.u.s, key.u.s))
                    return d->slots[h].val;
            }
            h = (h + 1) & (d->cap - 1);
        }
        return dflt;
    }
    static PyList* py_dict_keys(PyDict* d) {
        PyList* out = py_list_new();
        long long i;
        for (i = 0; i < d->cap; i++)
            if (d->slots[i].used) py_list_append(out, d->slots[i].key);
        return out;
    }
    static PyList* py_dict_values(PyDict* d) {
        PyList* out = py_list_new();
        long long i;
        for (i = 0; i < d->cap; i++)
            if (d->slots[i].used) py_list_append(out, d->slots[i].val);
        return out;
    }
    static void py_dict_del(PyDict* d, PyValue key) {
        long long h = py_hash(key) & (d->cap - 1);
        while (d->slots[h].used) {
            if (d->slots[h].hash == py_hash(key) && d->slots[h].key.kind == key.kind) {
                if (key.kind != PYV_STR || py_str_eq(d->slots[h].key.u.s, key.u.s)) {
                    d->slots[h].used = 0; d->len--; return;
                }
            }
            h = (h + 1) & (d->cap - 1);
        }
    }
    /* set: dict with unused val slot */
    static PyDict* py_set_new(void) { return py_dict_new(); }
    static void py_set_add(PyDict* s, PyValue key) { py_dict_set(s, key, pyv_none()); }
    static int py_set_has(PyDict* s, PyValue key) { return py_dict_has(s, key); }
    static void py_set_remove(PyDict* s, PyValue key) { py_dict_del(s, key); }
    /* ── iteration protocol: for x in it ── index-based over any container ── */
    static long long py_iter_len(PyValue it) {
        if (it.kind == PYV_LIST) return it.u.l->len;
        if (it.kind == PYV_TUPLE) return it.u.t->len;
        if (it.kind == PYV_STR) return it.u.s->len;
        if (it.kind == PYV_DICT) return it.u.d->len;
        return 0;
    }
    static PyValue py_iter_get(PyValue it, long long idx) {
        if (it.kind == PYV_LIST) return py_list_get(it.u.l, idx);
        if (it.kind == PYV_TUPLE) return it.u.t->items[idx];
        if (it.kind == PYV_STR) return pyv_str(py_str_new(it.u.s->data + idx, 1));
        if (it.kind == PYV_DICT) {
