    p[1517] = "int* drygon_dvy_keys_i(int* k, int n) { int i = 0; while (i < n && i < 1024) { drygon_dvy_i[i] = k[i]; i = i + 1; } drygon_dvy_n = n; return drygon_dvy_i; }\n";
    p[1518] = "int* drygon_dvy_vals_i(int* v, int n) { int i = 0; while (i < n && i < 1024) { drygon_dvy_i[i] = v[i]; i = i + 1; } drygon_dvy_n = n; return drygon_dvy_i; }\n";
    p[1519] = "double* drygon_dvy_vals_d(double* v, int n) { int i = 0; while (i < n && i < 1024) { drygon_dvy_d[i] = v[i]; i = i + 1; } drygon_dvy_n = n; return drygon_dvy_d; }\n";
    p[1520] = "char** drygon_dvy_vals_s(char** v, int n) { int i = 0; while (i < n && i < 1024) { drygon_dvy_s[i] = v[i]; i = i + 1; } drygon_dvy_n = n; return drygon_dvy_s; }\n";
