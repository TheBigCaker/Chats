                                        if (dl > 7 && d_strcmp(dv + dl - 7, ".setter")==0) mfl = mfl | 4;
                                        if (dl > 8 && d_strcmp(dv + dl - 8, ".deleter")==0) mfl = mfl | 8;
                                    }
