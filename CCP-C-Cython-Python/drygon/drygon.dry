                if (d_strcmp(dacc->type,"BLOCK")==0 && dacc->nchildren == 1) dacc = dacc->children[0];
                if (dacc && d_strcmp(dacc->type,"ARRAY_ACCESS")==0 && dacc->nchildren > 1 &&
                    d_strcmp(dacc->children[0]->type,"IDENTIFIER")==0 &&
                    d_strcmp(dacc->children[1]->type,"CONSTANT")==0 &&
                    cg_list_is_trow(dacc->children[0]->value)) {
