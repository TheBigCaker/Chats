                             * is a key/value/count triple, so resolve the
                             * {name} placeholders against it at run time.
                             * Any other receiver keeps the placeholders as a
                             * plain format rather than leaving `format_map`
                             * as an unresolved symbol (54_string_adv 18). */
                            const IRNode* _fmd = (n->nchildren > 1) ? n->children[1] : 0;
                            if (_fmd && d_strcmp(_fmd->type,"IDENTIFIER")==0 && _fmd->value &&
                                cg_dict_index(_fmd->value) >= 0 && cg_dict_kf(_fmd->value) == 1 &&
                                cg_dict_vf(_fmd->value) == 2) {
                                cg_put(g, "drygon_fmt_map(");
                                cg_gen_expr(g, target->children[0]);
                                cg_put(g, ", ");
                                cg_put(g, _fmd->value); cg_put(g, "_k, ");
                                cg_put(g, _fmd->value); cg_put(g, "_v, ");
                                cg_put(g, _fmd->value); cg_put(g, "_n)");
                                return;
                            }
                            cg_put(g, "drygon_fmt(");
                            cg_gen_expr(g, target->children[0]);
                            cg_put(g, ", 0, 0, 0, 0, 0, 0)");
                            return;
                        }
                        else if (d_strcmp(m,"split")==0 || d_strcmp(m,"rsplit")==0) {
