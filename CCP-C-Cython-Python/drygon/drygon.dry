                    /* `len(x[i])` where `x` is a flattened 2D list: the row
                     * length is recorded in the companion `_ln` table.  The
                     * fallthrough below measured the row as a C string and
                     * always returned 0. */
                    cg_put(g, a->children[0]->value); cg_put(g, "_ln[");
                    cg_gen_expr(g, a->children[1]); cg_put(g, "]");
                }
                else if (a && cg_is_list_node(cg_eval_tuple_expr(a))) {
