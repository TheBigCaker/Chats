            d_strcmp(a->children[0]->value,"concat")==0)
            return cg_is_str_node(a->children[1]);
        /* a slice of a string is a string */
        if (cg_mv_isstrofs(a)) return 1;
        if (cg_mv_isviewslice(a)) return 0;
        if (cg_mv_isshapeof(a)) return 0;
        if (d_strcmp(a->type,"SLICE")==0) return 1;
        /* a dict read is a string when the dict holds strings */
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 &&
            a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
            cg_is_dict(a->children[0]->value))
            return cg_dict_vf(a->children[0]->value) == 2;
        /* A cell of a `list(DictReader)` row holds a string: `rows2[0]["name"]`
         * -- and the same read through a name bound to one row -- compared as
