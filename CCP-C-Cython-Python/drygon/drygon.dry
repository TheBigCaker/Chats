                else if (cg_is_list_node(a)) cg_put(g, "5");
                /* `type(v) == list` on a VARIABLE was compared against the int
                 * tag 2 -- only the literal check above consulted the node
                 * shape.  A list/dict BINDING keeps its kind in the emitter's
                 * own tables (the ones `len(v)` uses), so consult them here:
                 * 36_match's `case list():` arm matched an int list. */
                else if (a && d_strcmp(a->type,"IDENTIFIER")==0 && cg_is_dyn_list(a->value))
