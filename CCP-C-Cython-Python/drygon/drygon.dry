        }
        /* string + string / string + value concatenates; "ab" * 3 repeats */
        if (d_strcmp(a->type,"BINARY_OP")==0 && a->nchildren>1 &&
            (d_strcmp(a->value,"+")==0 || d_strcmp(a->value,"*")==0)) {
            if (cg_is_str_node(a->children[0]) || cg_is_str_node(a->children[1])) return 1;
        }
        /* printf-style "fmt % args" yields a string */
        if (d_strcmp(a->type,"BINARY_OP")==0 && d_strcmp(a->value,"%")==0 &&
            a->nchildren>0 && cg_is_str_node(a->children[0])) return 1;
        /* a ternary whose branches are both strings is a string */
        if (d_strcmp(a->type,"IFEXP")==0 && a->nchildren>2)
            return cg_is_str_node(a->children[1]) && cg_is_str_node(a->children[2]);
        if (d_strcmp(a->type,"MEMBER_ACCESS")==0 &&
            (d_strcmp(a->value,"__name__")==0 || d_strcmp(a->value,"__doc__")==0)) return 1;
        /* `operator.concat(a, b)` yields a string when `a` is one (55_operator_mod
         * check 26: the `==` was comparing POINTERS). */
        if (d_strcmp(a->type,"CALL")==0 && a->nchildren>1 &&
