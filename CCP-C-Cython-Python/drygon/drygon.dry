            cg_indent(g);
            cg_put(g, dst); cg_put(g, "_n = 0;\n");
            cg_indent(g);
            cg_put(g, "int _ti = _ts; while (_ti < _te) { "); cg_put(g, dst);
            cg_put(g, "_lx["); cg_put(g, dst); cg_put(g, "_n] = "); cg_put(g, src);
            cg_put(g, "_lx[_ti]; "); cg_put(g, dst); cg_put(g, "["); cg_put(g, dst);
            cg_put(g, "_n] = _ti; ");
