/* --- permute ------------------------------------------------------------ */
static inline uint8x16_t vrev32q_u8(uint8x16_t a) {
    uint8x16_t r; int i, k;
    for (i = 0; i < 4; i++)
        for (k = 0; k < 4; k++)
            r.v[i * 4 + k] = a.v[i * 4 + (3 - k)];
    return r;
}
static inline uint8x16_t vrev64q_u8(uint8x16_t a) {
    uint8x16_t r; int i, k;
    for (i = 0; i < 2; i++)
        for (k = 0; k < 8; k++)
            r.v[i * 8 + k] = a.v[i * 8 + (7 - k)];
    return r;
}

/* --- SHA-256 crypto extension ------------------------------------------- */
static inline void __neon_sha256_rounds(uint32x4_t abcd, uint32x4_t efgh,
                                        uint32x4_t wk, uint32x4_t *oa,
                                        uint32x4_t *oe) {
    unsigned int a = abcd.v[0], b = abcd.v[1], c = abcd.v[2], d = abcd.v[3];
    unsigned int e = efgh.v[0], f = efgh.v[1], g = efgh.v[2], h = efgh.v[3];
    int i;
    for (i = 0; i < 4; i++) {
        unsigned int t1 = h + __neon_bsig1(e) + __neon_ch(e, f, g) + wk.v[i];
        unsigned int t2 = __neon_bsig0(a) + __neon_maj(a, b, c);
        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    oa->v[0] = a; oa->v[1] = b; oa->v[2] = c; oa->v[3] = d;
    oe->v[0] = e; oe->v[1] = f; oe->v[2] = g; oe->v[3] = h;
}
static inline uint32x4_t vsha256hq_u32(uint32x4_t abcd, uint32x4_t efgh,
                                       uint32x4_t wk) {
    uint32x4_t oa, oe;
    __neon_sha256_rounds(abcd, efgh, wk, &oa, &oe);
    return oa;
}
static inline uint32x4_t vsha256h2q_u32(uint32x4_t efgh, uint32x4_t abcd,
                                        uint32x4_t wk) {
    uint32x4_t oa, oe;
    __neon_sha256_rounds(abcd, efgh, wk, &oa, &oe);
    return oe;
}
static inline uint32x4_t vsha256su0q_u32(uint32x4_t w0, uint32x4_t w1) {
    uint32x4_t r;
    r.v[0] = w0.v[0] + __neon_ssig0(w0.v[1]);
    r.v[1] = w0.v[1] + __neon_ssig0(w0.v[2]);
    r.v[2] = w0.v[2] + __neon_ssig0(w0.v[3]);
    r.v[3] = w0.v[3] + __neon_ssig0(w1.v[0]);
    return r;
}
static inline uint32x4_t vsha256su1q_u32(uint32x4_t d, uint32x4_t n,
                                         uint32x4_t m) {
    uint32x4_t r;
    r.v[0] = __neon_ssig1(m.v[2]) + d.v[0] + n.v[1];
    r.v[1] = __neon_ssig1(m.v[3]) + d.v[1] + n.v[2];
    r.v[2] = __neon_ssig1(r.v[0]) + d.v[2] + n.v[3];
    r.v[3] = __neon_ssig1(r.v[1]) + d.v[3] + m.v[0];
    return r;
}

