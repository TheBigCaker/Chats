             * through: it is a plain rebinding, not a declaration. */
            if (alhs && d_strcmp(alhs->type,"IDENTIFIER")==0 && arhs &&
                (d_strcmp(arhs->type,"BINARY_OP")==0 ||
                 (d_strcmp(arhs->type,"CALL")==0 && arhs->value && arhs->value[0] &&
                  !cg_is_class(arhs->value))) &&
                !cg_cvar_class(alhs->value)) {
