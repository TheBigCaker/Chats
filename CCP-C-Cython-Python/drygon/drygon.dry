                             * for a list-returning method (DictReader.__next__). */
                            int _mdkf = 0;
                            int _mdvf = 0;
                            if (mbody0 && cg_ret_dict_scan(mbody0, &_mdkf, &_mdvf)) {
                                cg_mrd_add(c->value, _mdvf, _mdkf);
