                                if (d_strcmp(pt,"ANY")==0) pt = "int";
                                /* a dict parameter of a METHOD carries the same
                                 * parallel arrays a dict variable lives in, so
                                 * `rowdict[k]` works inside the body.  The
                                 * method has no top-level function record, so
                                 * the parameter is looked up in the method/dict
                                 * registry the hoisting pass filled. */
                                {
                                    const char* _mdp = cg_mpd_get(n->value, c->value, mpidx);
                                    if (_mdp && _mdp[0]) {
                                        if (pemit) cg_put(g, ", ");
