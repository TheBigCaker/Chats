            /* repr(instance) renders through the class' own __repr__ */
            if (d_strcmp(a->value,"repr")==0 && a->nchildren==1) {
                const IRNode* crr = a->children[0];
                if (crr && d_strcmp(crr->type,"IDENTIFIER")==0) {
                    const char* cvr = cg_cvar_class(crr->value);
                    if (!cvr && cg_is_class(crr->value)) cvr = crr->value;
