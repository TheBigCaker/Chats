            if (alhs && arhs && cg_is_list_node(alhs) &&
                d_strcmp(arhs->type,"IDENTIFIER")==0 &&
                cg_is_dyn_list(arhs->value)) {
                const char* src = arhs->value;
                int k = 0;
                while (k < alhs->nchildren) {
                    const IRNode* t = alhs->children[k];
                    if (k > 0) cg_indent(g);
                    cg_gen_expr(g, t);
                    cg_put(g, " = ");
                    cg_put(g, src); cg_put(g, "[");
