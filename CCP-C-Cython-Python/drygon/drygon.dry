}

/* --- float32x4 arithmetic ---------------------------------------------- */
static inline float32x4_t vaddq_f32(float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] + b.v[i];
    return r;
}
static inline float32x4_t vsubq_f32(float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] - b.v[i];
    return r;
}
static inline float32x4_t vmulq_f32(float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] * b.v[i];
    return r;
}
static inline float32x4_t vdivq_f32(float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] / b.v[i];
    return r;
}
static inline float32x4_t vmlaq_f32(float32x4_t a, float32x4_t b, float32x4_t c) {
    return vaddq_f32(a, vmulq_f32(b, c));
}
static inline float32x4_t vmlsq_f32(float32x4_t a, float32x4_t b, float32x4_t c) {
    return vsubq_f32(a, vmulq_f32(b, c));
}
static inline float32x4_t vmaxq_f32(float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] > b.v[i] ? a.v[i] : b.v[i];
    return r;
}
static inline float32x4_t vminq_f32(float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] < b.v[i] ? a.v[i] : b.v[i];
    return r;
}
static inline float32x4_t vabsq_f32(float32x4_t a) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] < 0.0f ? -a.v[i] : a.v[i];
    return r;
}
static inline float32x4_t vnegq_f32(float32x4_t a) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = -a.v[i];
    return r;
}

/* --- integer / bitwise -------------------------------------------------- */
static inline uint32x4_t vaddq_u32(uint32x4_t a, uint32x4_t b) {
    uint32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] + b.v[i];
    return r;
}
static inline uint32x4_t vsubq_u32(uint32x4_t a, uint32x4_t b) {
    uint32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] - b.v[i];
    return r;
}
static inline int32x4_t vshlq_n_s32(int32x4_t a, const int n) {
    int32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = a.v[i] << n;
    return r;
}
static inline uint32x4_t vceqq_f32(float32x4_t a, float32x4_t b) {
    uint32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = (a.v[i] == b.v[i]) ? 0xFFFFFFFFu : 0u;
    return r;
}
static inline uint32x4_t vcltq_f32(float32x4_t a, float32x4_t b) {
    uint32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = (a.v[i] < b.v[i]) ? 0xFFFFFFFFu : 0u;
    return r;
}
static inline float32x4_t vbslq_f32(uint32x4_t m, float32x4_t a, float32x4_t b) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) {
        unsigned int ab = __neon_fbits(a.v[i]);
        unsigned int bb = __neon_fbits(b.v[i]);
        __neon_putbits(&r.v[i], (m.v[i] & ab) | ((0xFFFFFFFFu ^ m.v[i]) & bb));
    }
    return r;
}

/* --- conversions -------------------------------------------------------- */
static inline int32x4_t vcvtmq_s32_f32(float32x4_t a) {
    int32x4_t r; int i;
    for (i = 0; i < 4; i++) {
        float x = a.v[i];
        int t = (int)x;
        if ((float)t > x) t = t - 1;
        r.v[i] = t;
    }
    return r;
}
static inline int32x4_t vcvtq_s32_f32(float32x4_t a) {
    int32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = (int)a.v[i];
    return r;
}
static inline float32x4_t vcvtq_f32_s32(int32x4_t a) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = (float)a.v[i];
    return r;
}
static inline uint32x4_t vreinterpretq_u32_f32(float32x4_t a) {
    uint32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = __neon_fbits(a.v[i]);
