    static char cg_fn_float[16384];
    static int cg_nfn_float;
    static int cg_fn_is_float(const char* name) {
        if (!name || !name[0]) return 0;
        int i = 0;
        while (i < cg_nfn_float) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_fn_float[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static void cg_note_fn_float(const char* name) {
        if (!name || !name[0]) return;
        if (cg_fn_is_float(name)) return;
        if (cg_nfn_float >= 256) return;
        int base = cg_nfn_float * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_fn_float[base + j] = name[j]; j++; }
        cg_fn_float[base + j] = 0;
        cg_nfn_float = cg_nfn_float + 1;
    }
    /* Does this subtree force floating point?  A float literal, python's true
