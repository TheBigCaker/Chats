                    cg_put(g, a->nchildren != 0 ? "1" : "0");
                }
                else if (a && d_strcmp(a->type,"CALL")==0 && (d_strcmp(a->value,"set")==0 || d_strcmp(a->value,"dict")==0 || d_strcmp(a->value,"list")==0 || d_strcmp(a->value,"tuple")==0)) {
