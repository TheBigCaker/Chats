}
static inline float32x4_t vreinterpretq_f32_u32(uint32x4_t a) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) __neon_putbits(&r.v[i], a.v[i]);
    return r;
}
static inline float32x4_t vreinterpretq_f32_s32(int32x4_t a) {
