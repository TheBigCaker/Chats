                        cg_put(g, "_n; }\n");
                        return;
                    }
                }
                /* `items = list(Path(".").iterdir())`: the argument is a method
                 * call that builds a list, so the drain is the same as the
                 * plain-assignment form -- copy what the method published into
                 * the shared str-list buffer (23_pathlib checks 15/16/20-23). */
                if (src && d_strcmp(src->type,"CALL")==0 && cg_mcx_meth(src)) {
                    int _lsls = 0;
                    if (cg_mcall_ret_list(src, &_lsls)) {
                        cg_note_list(alhs->value, 512, _lsls ? 2 : 0);
                        if (_lsls) cg_note_strlist(alhs->value);
                        cg_put(g, _lsls ? "{ char** _lcp = " : "{ int* _lcp = ");
                        cg_gen_expr(g, src);
                        cg_put(g, "; int _lcn = ");
                        cg_put(g, _lsls ? "drygon_rls_n" : "drygon_rl_n");
                        cg_put(g, "; if (_lcn > 1024) _lcn = 1024; int _lci; for (_lci = 0; _lci < _lcn; _lci++) ");
                        cg_put(g, alhs->value); cg_put(g, "[_lci] = _lcp[_lci]; ");
                        cg_put(g, alhs->value); cg_put(g, "_n = _lcn; }\n");
                        return;
                    }
                }
                if (cg_node_is_str_static(src) && d_strcmp(src->type,"CONSTANT")==0) {
                    const char* sv = src->value;
                    int slen = (int)d_strlen(sv);
                    if (slen >= 2 && (sv[0]=='\''||sv[0]=='"') && (sv[slen-1]=='\''||sv[slen-1]=='"')) {
                        sv++; slen -= 2;
                    }
                    int k = 0;
                    while (k < slen) {
                        cg_put(g, alhs->value); cg_put(g, "["); cg_put_int(g, k); cg_put(g, "] = \"");
                        char sc[2] = { sv[k], 0 };
                        cg_put(g, sc); cg_put(g, "\";\n");
                        cg_indent(g);
                        k++;
                    }
                    cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put_int(g, slen); cg_put(g, ";\n");
                    return;
                }
                if (d_strcmp(src->type,"IDENTIFIER")==0 && cg_is_dyn_list(src->value)) {
                    cg_put(g, "for (int _cpi = 0; _cpi < "); cg_put(g, src->value); cg_put(g, "_n; _cpi++) { ");
                    cg_put(g, alhs->value); cg_put(g, "[_cpi] = "); cg_put(g, src->value); cg_put(g, "[_cpi]; }\n");
                    cg_indent(g);
                    cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put(g, src->value); cg_put(g, "_n;\n");
                    return;
                }
                if (d_strcmp(src->type,"CALL")==0 && d_strcmp(src->value,"range")==0 && src->nchildren == 1) {
                    cg_put(g, "for (int _ri = 0; _ri < "); cg_gen_expr(g, src->children[0]); cg_put(g, "; _ri++) { ");
                    cg_put(g, alhs->value); cg_put(g, "[_ri] = _ri; }\n");
                    cg_indent(g);
                    cg_put(g, alhs->value); cg_put(g, "_n = "); cg_gen_expr(g, src->children[0]); cg_put(g, ";\n");
                    return;
                }
                if (d_strcmp(src->type,"CALL")==0 && d_strcmp(src->value,"zip")==0 && src->nchildren == 2) {
                    const IRNode* za = src->children[0];
                    const IRNode* zb = src->children[1];
                    if (cg_is_list_node(za) && cg_is_list_node(zb) && za->nchildren == zb->nchildren) {
                        int zn = za->nchildren;
                        int zi = 0;
                        while (zi < zn) {
                            cg_put(g, alhs->value); cg_put(g, "_back["); cg_put_int(g, zi * 2); cg_put(g, "] = ");
                            cg_gen_expr(g, za->children[zi]); cg_put(g, "; ");
                            cg_put(g, alhs->value); cg_put(g, "_back["); cg_put_int(g, zi * 2 + 1); cg_put(g, "] = ");
                            cg_gen_expr(g, zb->children[zi]); cg_put(g, "; ");
                            cg_put(g, alhs->value); cg_put(g, "_off["); cg_put_int(g, zi); cg_put(g, "] = ");
                            cg_put_int(g, zi * 2); cg_put(g, "; ");
                            cg_put(g, alhs->value); cg_put(g, "_ln["); cg_put_int(g, zi); cg_put(g, "] = 2;\n");
                            cg_indent(g);
                            zi++;
                        }
                        cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put_int(g, zn); cg_put(g, ";\n");
                        cg_note_twod(alhs->value);
                        return;
                    }
                }
            }
            /* `c = MyClass.create()` — a `@classmethod` that returns `cls()`
             * hands back an instance, so the target is declared as that class
             * (12_classes 37).  The statement itself takes the usual path. */
            if (alhs && d_strcmp(alhs->type,"IDENTIFIER")==0 && arhs &&
                d_strcmp(arhs->type,"CALL")==0 && arhs->value &&
                d_strcmp(arhs->value,"COMPLEX")==0 && arhs->nchildren>0 &&
                d_strcmp(arhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                arhs->children[0]->nchildren>0 &&
                d_strcmp(arhs->children[0]->children[0]->type,"IDENTIFIER")==0) {
                const char* fcn = arhs->children[0]->children[0]->value;
                int fci = cg_cls_index(fcn);
                if (fci >= 0) {
                    int is_factory = 0;
                    int fj = 0;
