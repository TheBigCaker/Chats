                    }
                    int ft = cg_cls_ftype(body, cfn + fi2*64);
                    if (!ft) ft = cg_if_field_ftype(cg_cls_names[cg_cls_n - 1], cfn + fi2*64);
                    if (!ft) {
                        int bqi = 0;
                        while (bqi < cg_cls_nab[cg_cls_n - 1]) {
                            ft = cg_cls_ftype_of(cg_cls_ab + ((cg_cls_n - 1)*4 + bqi)*64, cfn + fi2*64, 0);
                            if (ft) break;
