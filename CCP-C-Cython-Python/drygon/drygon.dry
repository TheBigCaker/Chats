    p[1492] = "char* drygon_template(char* s, char* n0, char* v0, char* n1, char* v1, char* n2, char* v2, int safe) {\nchar* names[3];\nchar* vals[3];\nnames[0] = n0;\nnames[1] = n1;\nnames[2] = n2;\nvals[0] = v0;\nvals[1] = v1;\nvals[2] = v2;\nint need = drygon_slen(s) + 256;\nint q = 0;\nwhile (q < 3) { if (vals[q]) need = need + drygon_slen(vals[q]) * 4; q = q + 1; }\nchar* r = drygon_alloc(need);\nint i = 0;\nint m = 0;\nwhile (s[i]) {\nint c = s[i];\nif (c == 36 && s[i + 1] == 36) { r[m] = 36; m = m + 1; i = i + 2; }\nelse if (c == 36 && s[i + 1] == 123) {\nint j = i + 2;\nint e = j;\nwhile (s[e] != 0 && s[e] != 125) e = e + 1;\nint t = 0;\nint idx = -1;\nwhile (t < 3) { if (names[t] && drygon_fm_keysame(names[t], s, j, e)) { idx = t; break; } t = t + 1; }\nif (idx >= 0) { char* vv = vals[idx]; int w = 0; while (vv[w] != 0) { r[m] = vv[w]; m = m + 1; w = w + 1; } i = e + 1; }\nelse if (safe) { int z = i; while (z <= e) { r[m] = s[z]; m = m + 1; z = z + 1; } i = e + 1; }\nelse { py_raise_str(\"KeyError\", \"template\"); i = e + 1; }\n}\nelse if (c == 36 && drygon_tpl_id(s[i + 1])) {\nint j = i + 1;\nint e = j;\nwhile (drygon_tpl_id(s[e])) e = e + 1;\nint t = 0;\nint idx = -1;\nwhile (t < 3) { if (names[t] && drygon_fm_keysame(names[t], s, j, e)) { idx = t; break; } t = t + 1; }\nif (idx >= 0) { char* vv = vals[idx]; int w = 0; while (vv[w] != 0) { r[m] = vv[w]; m = m + 1; w = w + 1; } i = e; }\nelse if (safe) { int z = i; while (z < e) { r[m] = s[z]; m = m + 1; z = z + 1; } i = e; }\nelse { py_raise_str(\"KeyError\", \"template\"); i = e; }\n}\nelse { r[m] = c; m = m + 1; i = i + 1; }\n}\nr[m] = 0;\nreturn r;\n}\n";
    p[1493] = "int drygon_isident(char* s) {\nint n = drygon_slen(s);\nif (n <= 0) return 0;\nint c = s[0];\nif (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95)) return 0;\nint i = 1;\nwhile (i < n) {\nc = s[i];\nif (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)) return 0;\ni = i + 1;\n}\nreturn 1;\n}\n";
    p[1494] = "int drygon_chreq(int c, char* s) {\nif (s[1] != 0) return 0;\nreturn ((unsigned char)(c & 255)) == ((unsigned char)s[0]);\n}\n";
    /* hash objects: `h = hashlib.sha256()` keeps an accumulator whose bytes
     * are fed by `h.update(...)` and digested by `h.hexdigest()`.  The object
     * is an index into a flat static table (a 2D array is not something the C
     * backend lowers reliably). */
    p[1495] = "static char* _hsh_algo[32];\nstatic char _hsh_buf[8192];\nstatic int _hsh_dn[32];\nstatic int _hsh_n;\nint drygon_hnew(char* a) {\nint i = _hsh_n;\nif (i > 31) i = 31;\n_hsh_algo[i] = a;\n_hsh_buf[i * 256] = 0;\n_hsh_dn[i] = 0;\nif (i == _hsh_n) _hsh_n = _hsh_n + 1;\nreturn i;\n}\nint drygon_hupdate(int id, char* d) {\nif (id < 0 || id > 31) return 0;\nint n = drygon_bytes_len(d);\nint j = 0;\nwhile (j < n && _hsh_dn[id] < 250) { _hsh_buf[id * 256 + _hsh_dn[id]] = d[j]; _hsh_dn[id] = _hsh_dn[id] + 1; j = j + 1; }\n_hsh_buf[id * 256 + _hsh_dn[id]] = 0;\nreturn 0;\n}\nint drygon_hnewd(char* a, char* d) {\nint id = drygon_hnew(a);\ndrygon_hupdate(id, d);\nreturn id;\n}\nchar* drygon_hdigest(int id, int hx) {\nif (id < 0 || id > 31) return drygon_hash(\"sha256\", \"\", hx);\nreturn drygon_hash(_hsh_algo[id], _hsh_buf + id * 256, hx);\n}\n";
