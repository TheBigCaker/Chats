            /* `xs *= n` on a python LIST: repeat its elements n times in place.
             * The generic path emitted `lst *= 2` on the backing ARRAY, which is
             * not C. */
            if (alhs && arhs && d_strcmp(alhs->type,"IDENTIFIER")==0 &&
                d_strcmp(n->value,"*=")==0 && !cg_is_list_node(alhs) &&
                (cg_list_size(alhs->value) >= 0 || cg_is_dyn_list(alhs->value))) {
