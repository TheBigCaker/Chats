int drygon_gryz_enabled = 1;
static long drygon_jit_syscall(long num, long a, long b, long c, long d, long e, long f);
/* Gryz scaffolding — declared here because the syscall emitter (below)
 * runs long before THE JIT ENGINE defines the mmap helpers, and sys_chmod
 * (THE CORE COMPILER) calls Gryz's chmod piece before it is defined. */
static void* drygon_mmap_exec_alloc(size_t size);
static void drygon_mmap_free(void* ptr, size_t size);
static int gryz_chmod(const char* path, int mode);
/* The JIT syscall scratch buffer is mmap'd rather than a stack local (the full
 * Code struct is ~30 MB, far past the 8 MB stack), so these must be declared
 * before the emitter that uses them -- they are defined with the assembler. */
static long sys_mmap(long addr, int len, int prot, int flags, int fd, int off);
static int sys_munmap(void* addr, int len);
/* _raw_syscall is provided by baccyn's embedded libc when compiled by baccyn.
 * When compiled by drygon itself, use the __asm__ volatile version. */
#ifndef __BACCYN__
static long _raw_syscall(long num, long a, long b, long c, long d, long e, long f) {
    __asm__ volatile("__syscall");
}
#endif

/* ── THE CORE COMPILER (wrapped in @dry) ── */
/* self-contained Drygon C compiler --- AArch64 ELF emitter.
 * ZERO external deps: no libc, no gcc, no clang, no binutils.
 * Uses raw Linux syscalls for all I/O. Emits a standalone AArch64 ELF binary
 * that runs directly on the kernel.
 *
 * Input:  the unified C source produced by the Drygon engine (build_c_from_dry).
 * Output: a native AArch64 ELF executable (drynary).
 *
//  * Supported C features (exactly what the engine's code_convertor generates) {
 *   int func(int a, int b) { ... }        - function definitions
 *   int x = expr;                         - local declarations
 *   if ((cond)) { } else { }              - conditionals
 *   while ((cond)) { }                    - loops
 *   for(int i=0; i<n; i++) { }            - range loops
 *   return expr;                          - returns
 *   printf("fmt", args...)                - formatted output
 *   arithmetic: + - * / %  comparisons < > <= >= == !=  logical && || !
 *   recursion (direct function calls)
 */

// typedef char      uint8_t;
// typedef short     uint16_t;
// typedef int       uint32_t;
// typedef long      uint64_t;
// typedef char        int8_t;
typedef short       int16_t;
typedef int         int32_t;
typedef long        int64_t;
// typedef long      uintptr_t;
typedef long        intptr_t;
typedef unsigned long size_t;

/* ── instruction-cache maintenance ───────────────────────────────────────────
 * aarch64 does NOT snoop the I-cache against stores made through the D-cache,
 * so machine code synthesized into an anonymous RWX page can be fetched STALE
 * and trap with SIGILL (reproduced: 4000-page churn traps without this, passes
 * 4000/4000 with it). Real JITs use __builtin___clear_cache or inline asm;
 * baccyn provides neither (inline __asm__ is a syntax error), so the
 * maintenance sequence is synthesized by this compiler itself:
 *
 *     dc cvau, x0 ; dsb ish ; ic ivau, x0 ; dsb ish ; isb ; ret
 *
 * and bootstrapped out of a FILE-BACKED exec page: bytes that reach the page
 * cache through the kernel's write() path are coherent by construction, so the
 * flusher needs no flushing of its own. Once resident it maintains every
 * anonymous JIT page, one call per 64-byte cache line. */
static long (*drygon_icache_flush_fn)(void*) = (long (*)(void*))0;
static void (*drygon_barrier_fn)(void) = (void (*)(void))0;
static void (*drygon_yield_fn)(void) = (void (*)(void))0;

/* Instruction words synthesized into the file-backed exec page.  FILE SCOPE ON
 * PURPOSE -- see baccyn bug #9: a function-local `static` array with an
 * initializer list loses its initializer at codegen and the emitted object
 * faults on first use.  As a local, boot_code was all zeros here, so the kernel
 * received a 40-byte NUL write and the first indirect call through the page
 * took a PC-alignment SIGBUS.  File-scope statics with initializers are correct. */
static unsigned int boot_code[10] = {
    0xd50b7b20u,  /* dc cvau, x0 */
    0xd5033b9fu,  /* dsb ish     */
    0xd50b7520u,  /* ic ivau, x0 */
    0xd5033b9fu,  /* dsb ish     */
    0xd5033fdfu,  /* isb         */
    0xd65f03c0u,  /* ret         */
    0xd5033bbfu,  /* dmb ish     -- full barrier, at +24 */
    0xd65f03c0u,  /* ret         */
    0xd503203fu,  /* yield       -- spin hint,    at +32 */
    0xd65f03c0u   /* ret         */
};

static void drygon_icache_flush(void* addr, size_t len) {
    if (drygon_icache_flush_fn == (long (*)(void*))0) {
        const char* boot = ".drygon_icache_flush.bin";
        long fd = _raw_syscall(56, -100, (long)boot, 578, 420, 0, 0);
        if (fd >= 0) {
            _raw_syscall(46, fd, 40, 0, 0, 0, 0);                        /* ftruncate */
            _raw_syscall(64, fd, (long)boot_code, 40, 0, 0, 0);          /* write      */
            long page = _raw_syscall(222, 0, 40, 5, 2, fd, 0);           /* PROT_READ|PROT_EXEC */
            _raw_syscall(57, fd, 0, 0, 0, 0, 0);                         /* close      */
            _raw_syscall(35, -100, (long)boot, 0, 0, 0, 0);              /* unlink     */
            if (page > 0) {
                drygon_icache_flush_fn = (long (*)(void*))page;
                drygon_barrier_fn = (void (*)(void))(page + 24);
                drygon_yield_fn = (void (*)(void))(page + 32);
            }
        }
    }
    if (drygon_icache_flush_fn == (long (*)(void*))0 || len == 0) return;
    char* p = (char*)(((unsigned long)addr) & ~((unsigned long)63));
    char* end = (char*)addr + len;
    while (p < end) {
        drygon_icache_flush_fn(p);
        p = p + 64;
    }
}

/* ── full memory barrier (dmb ish) ───────────────────────────────────────────
 * The spliced worker pool lost every memory-ordering primitive it had in
 * cygemm/partitricks_h.dry: __atomic_load_n(p, ACQUIRE) became `return *p`,
 * __atomic_store_n(p, RELEASE) became `*p = v`, and ccp_wait's
 * __atomic_thread_fence(__ATOMIC_SEQ_CST) was deleted outright. baccyn has
 * neither the atomic nor the sync builtins, and no inline asm, so those
 * accesses ended up genuinely unordered -- the pool could publish
 * a work item before its work_func/work_arg, and a dispatcher could read a
 * worker's plain output writes before they were visible.
 *
 * The barrier is the same trick as the flusher: a `dmb ish; ret` pair
 * synthesized at +24 of the bootstrapped page. A dmb is a full barrier, so
 * the canonical C11 fence translations apply:
 *     acquire load  ->  v = *p;     barrier();
 *     release store ->  barrier();  *p = v;                                     */
static void drygon_barrier(void) {
    if (drygon_barrier_fn != (void (*)(void))0) {
        drygon_barrier_fn();
        return;
    }
    /* Bootstrap page unavailable (e.g. read-only cwd): a real syscall is an
     * opaque extern call -- a compiler barrier -- and the trap is a hardware
     * ordering point, so this is still correct, just slower. */
    (void)_raw_syscall(172, 0, 0, 0, 0, 0, 0);
}

/* ── spin hint (yield) ───────────────────────────────────────────────────────
 * The spliced pool lost ccp_spin_yield's __asm__ volatile("yield" ::: "memory")
 * and was left with an empty body, turning every backing-off spin loop into a
 * pure busy-wait. Same page, at +32. Falls back to sched_yield (arm64 nr 124),
 * which also carries the compiler barrier the clobber list used to provide.   */
static void drygon_spin_yield(void) {
    if (drygon_yield_fn != (void (*)(void))0) {
        drygon_yield_fn();
        return;
    }
    (void)_raw_syscall(124, 0, 0, 0, 0, 0, 0);
}

/* ------ Raw syscalls (no libc) ------------------------------------------------------------------------------------------------------------------------------------------------ */
// #define SYS_READ   63
// #define SYS_WRITE  64
// #define SYS_OPENAT 56
// #define SYS_CLOSE  57
// #define SYS_EXIT   94
// #define SYS_MMAP   222
// #define SYS_MUNMAP 215
// #define SYS_LSEEK  62

// #define AT_FDCWD   -100
// #define O_RDONLY   0
// #define O_WRONLY   1
// #define O_CREAT    64
// #define O_TRUNC    512

// #define PROT_READ  1
// #define PROT_WRITE 2
// #define PROT_EXEC  4
// #define MAP_PRIVATE 2
// #define MAP_ANONYMOUS 32

long get_addr(long p) {
    return p;
}
long get_ptr(long words, int idx) {
    int* w = (int*)words;
    unsigned long low = (unsigned int)w[idx * 2];
    unsigned long high = (unsigned int)w[idx * 2 + 1];
    return (high << 32) | low;
}
static long get_ptr_64(char** arr, int idx) {
    long* p = (long*)arr;
    return p[idx];
}
static int get_char(char* arr, int idx) {
    char* ptr = arr + idx;
    return ptr[0];
}
static void set_char(char* arr, int idx, int val) {
    char* ptr = arr + idx;
    ptr[0] = val;
}
static void set_ptr(long words, int idx, long val) {
    int* w = (int*)words;
    w[idx * 2] = (unsigned int)(val & 0xFFFFFFFF);
    w[idx * 2 + 1] = (unsigned int)((val >> 32) & 0xFFFFFFFF);
}
static void set_uint(long words, int idx, unsigned int val) {
    int* w = (int*)words;
    w[idx] = val;
}
static int get_int(long words) {
    int* w = (int*)words;
    return w[0];
}

/* ------ Code buffer with labels ---------------------------------------------------------------------------------------------------------------------------------------------
 * Hoisted above THE JIT ENGINE on purpose: `Code` has to be a known type name
 * by the time drygon_jit_syscall_impl casts its mmap'd scratch buffer to it,
 * because baccyn rejects a cast to a type name it has not seen yet. */
#define MAX_LABELS 524288
#define MAX_PATCHES 524288
typedef struct Code {
    uint32_t words[8388608];
    int nwords;
    /* labels: name hash -> word index */
    int label_hash[MAX_LABELS];
    int label_idx[MAX_LABELS];
    int label_h2[MAX_LABELS]; /* second hash: djb2 collides on distinct names */
    int nlabels;
    /* patches: (word_index, label_hash, kind, cond) */
    int patch_idx[MAX_PATCHES];
    int patch_hash[MAX_PATCHES];
    int patch_kind[MAX_PATCHES]; /* 0=b,1=bl,2=bcond,3=adr */
    int patch_cond[MAX_PATCHES];
    int patch_rd[MAX_PATCHES];
    char* patch_nm[MAX_PATCHES];
    int npatches;
} Code;

/* Baccyn libc provides _raw_syscall(num,a,b,c,d,e,f) -> svc 0 with x8=num.
 * _raw_syscall is defined above as a compiler built-in primitive. */
/* emit_mov64 — emit movz+movk sequence to load a 64-bit value into register rd */
static void emit_mov64(Code* code, int rd, long value) {
    code_emit(code, a_movz(rd, value & 0xFFFF, 0));
    if (((value >> 16) & 0xFFFF)) code_emit(code, a_movk(rd, (value >> 16) & 0xFFFF, 16));
    if (((value >> 32) & 0xFFFF)) code_emit(code, a_movk(rd, (value >> 32) & 0xFFFF, 32));
    if (((value >> 48) & 0xFFFF)) code_emit(code, a_movk(rd, (value >> 48) & 0xFFFF, 48));
}
/* Size of the mmap'd Compiler mapping.  sizeof(Compiler) is ~40 MB (it embeds
 * the whole Code struct: a 16 MB word array plus label and patch tables), and
 * the compile writes the whole data section into that same mapping.  The old
 * 64 MB constant left only ~23 MB of headroom, so a program whose data section
 * was larger than ~45 KB wrote past the end of the mapping and the compiler
 * segfaulted while compiling VALID input (`static char big[50000];`).  Size the
 * mapping from the struct plus a full-size data allowance instead. */
#define DRYGON_COMPILER_BYTES (384 * 1024 * 1024)
/* Size of the mmap'd JIT syscall scratch buffer. Code is words[4194304]
 * (16 MB) + label_hash/label_idx (2 MB each) + 5 patch tables (2 MB each),
 * i.e. ~30 MB; 32 MB covers it. */
#define DRYGON_JIT_CODE_BYTES 100663296
static long drygon_jit_syscall_impl(long num, long a, long b, long c, long d, long e, long f) {
    /* Code is ~30 MB, far past the 8 MB stack, so the scratch buffer is mmap'd
     * the way Compiler is -- and mmap is lazy, so only the few pages actually
     * touched (the first word block, and the nwords/nlabels/npatches words)
     * are ever faulted in. */
    long raw = sys_mmap(0, DRYGON_JIT_CODE_BYTES, 3, 34, -1, 0);
    if (raw <= 0) {
        return _raw_syscall(num, a, b, c, d, e, f);
    }
    Code* jit_code = (Code*)raw;
    jit_code->nwords = 0;
    jit_code->nlabels = 0;
    jit_code->npatches = 0;
    emit_mov64(jit_code, 0, a);
    emit_mov64(jit_code, 1, b);
    emit_mov64(jit_code, 2, c);
    emit_mov64(jit_code, 3, d);
    emit_mov64(jit_code, 4, e);
    emit_mov64(jit_code, 5, f);
    emit_mov64(jit_code, 8, num);
    code_emit(jit_code, a_svc());
    code_emit(jit_code, a_ret());
    void *mem = drygon_mmap_exec_alloc(jit_code->nwords * 4);
    if (!mem) {
        sys_munmap(jit_code, DRYGON_JIT_CODE_BYTES);
        return _raw_syscall(num, a, b, c, d, e, f);
    }
    d_memcpy(mem, jit_code->words, jit_code->nwords * 4);
    drygon_icache_flush(mem, jit_code->nwords * 4);
    typedef long (*syscall_fn)(long, long, long, long, long, long, long);
    syscall_fn fn = (syscall_fn)mem;
    long result = fn(num, a, b, c, d, e, f);
    drygon_mmap_free(mem, jit_code->nwords * 4);
    sys_munmap(jit_code, DRYGON_JIT_CODE_BYTES);
    return result;
}

/* Gryz syscall entry point — synthesize mov xN + svc 0 + ret into an exec
 * page and call it in-process. No fork, no on-disk ELF, no external binary.
 * Gated by drygon_gryz_enabled; falls back to _raw_syscall (the native
 * compiler built-in primitive). */
static long drygon_jit_syscall(long num, long a, long b, long c, long d, long e, long f) {
    if (drygon_gryz_enabled) {
        return drygon_jit_syscall_impl(num, a, b, c, d, e, f);
    }
    return _raw_syscall(num, a, b, c, d, e, f);
}


static long sys_read(int fd, void* buf, int n) {
    return _raw_syscall(63, fd, buf, n, 0, 0, 0);
}
static long sys_write(int fd, void* buf, int n) {
    return _raw_syscall(64, fd, buf, n, 0, 0, 0);
}
static long sys_openat(int dirfd, char* path, int flags, int mode) {
    return _raw_syscall(56, dirfd, path, flags, mode, 0, 0);
}
static int sys_close(int fd) {
    return _raw_syscall(57, fd, 0, 0, 0, 0, 0);
}
static void sys_exit(int code) {
    _raw_syscall(93, code, 0, 0, 0, 0, 0);
    while (1) {}
}
static long sys_mmap(long addr, int len, int prot, int flags, int fd, int off) {
    return _raw_syscall(222, addr, len, prot, flags, fd, off);
}
static int sys_munmap(void* addr, int len) {
    return _raw_syscall(215, addr, len, 0, 0, 0, 0);
}

/* ============================================================
 * FREESTANDING POSIX LAYER
 * baccyn's embedded libc supplies openat/read/write/close/malloc/
 * free/getc/ungetc/fopen/fclose/fread/fwrite/printf but not
 * sscanf/fgets/rewind/getcwd/stat.  The five below are complete
 * implementations over _raw_syscall, matching the FILE ABI that
 * fdopen() establishes: 16 bytes, [0]=fd, [8]=pushback char,
 * [12]=pushback flag.
 * ============================================================ */
typedef char* va_list;

/* aarch64 kernel ABI: struct stat is exactly 128 bytes. */
struct stat {
    unsigned long st_dev;
    unsigned long st_ino;
    unsigned int  st_mode;
    unsigned int  st_nlink;
    unsigned int  st_uid;
    unsigned int  st_gid;
    unsigned long st_rdev;
    unsigned long st_spare0;
    long          st_size;
    int           st_blksize;
    int           st_spare1;
    long          st_blocks;
    long          st_atime;
    unsigned long st_atime_nsec;
    long          st_mtime;
    unsigned long st_mtime_nsec;
    long          st_ctime;
    unsigned long st_ctime_nsec;
    unsigned int  st_spare2;
    unsigned int  st_spare3;
};

/* aarch64 kernel ABI: struct timespec is two 64-bit fields. The direct
 * compiler has no header search path, so the few kernel structs it needs are
 * spelled out here, exactly like struct stat above. */
struct timespec {
    long tv_sec;
    long tv_nsec;
};

/* SEEK_SET=0, AT_FDCWD=-100 (native AArch64 Linux values) */
static long sys_lseek(int fd, long off, int whence) {
    return _raw_syscall(62, fd, off, whence, 0, 0, 0);
}
static int d_stat(const char* path, struct stat* buf) {
    long r = _raw_syscall(79, -100, path, buf, 0, 0, 0);
    if (r < 0) return -1;
    return 0;
}
static char* d_getcwd(char* buf, unsigned long size) {
    long r;
    if (!buf || size == 0) return 0;
    r = _raw_syscall(17, buf, size, 0, 0, 0, 0);
    if (r < 0) return 0;
    return buf;
}
static void d_rewind(void* stream) {
    int* fi;
    if (!stream) return;
    fi = (int*)stream;
    sys_lseek(fi[0], 0, 0);
    fi[3] = 0;
}
static char* d_fgets(char* str, int num, void* stream) {
    int* fi;
    int i = 0;
    if (!str || num <= 0 || !stream) return 0;
    fi = (int*)stream;
    while (i < num - 1) {
        int c;
        if (fi[3]) {
            c = fi[2];
            fi[3] = 0;
        } else {
            /* int chi = 0; sys_read(fi, &chi, 1); c = chi & 255; -- a 1-byte
             * scalar slot's upper bytes can hold stale stack garbage, so read
             * into a zeroed int and mask instead of casting a byte slot. */
            int chi = 0;
            long r = sys_read(fi[0], &chi, 1);
            if (r <= 0) break;
            c = chi & 255;
        }
        str[i] = (char)c;
        i = i + 1;
        if (c == 10) break;
    }
    if (i == 0) { str[0] = 0; return 0; }
    str[i] = 0;
    return str;
}

/* ------ freestanding string/file shims ------------------------------------
 * The polyglot transpiler region (cy_* helpers, build_c_from_dry) spells
 * plain libc names (strcmp/snprintf/fopen/...).  The direct compiler's
 * builtin table only knows printf/_raw_syscall/va_start/va_arg, so without
 * these definitions every call compiled to an unresolved trap stub and the
 * whole region crashed the moment it ran.  Self-contained: only raw syscalls
 * and pointer loops, no d_* / d_alloc dependency.  FILE layout must match
 * the fgets/rewind shims above: int[4], [0]=fd, [2]=pushback, [3]=flag. */
typedef int DFile;
static int d_files[64][4];
static int d_file_open[64];
static void* d_fopen(const char* path, const char* mode) {
    int i;
    for (i = 0; i < 64; i++) if (!d_file_open[i]) break;
    if (i == 64) return 0;
    int flags = 0;
    if (mode[0] == 'w') flags = 1 | 64 | 512;      /* O_WRONLY|O_CREAT|O_TRUNC */
    else if (mode[0] == 'a') flags = 1 | 64 | 1024; /* O_WRONLY|O_CREAT|O_APPEND */
    else flags = 0;                                 /* O_RDONLY */
    long fd = sys_openat(-100, (char*)path, flags, 420);
    if (fd < 0) return 0;
    d_file_open[i] = 1;
    d_files[i][0] = (int)fd;
    d_files[i][1] = 0;
    d_files[i][2] = 0;
    d_files[i][3] = 0;
    return (void*)d_files[i];
}
static int d_fclose(void* stream) {
    int* fi;
    int i;
    if (!stream) return -1;
    fi = (int*)stream;
    _raw_syscall(57, fi[0], 0, 0, 0, 0, 0);
    /* Match the FILE slot by its fd, not by pointer difference: the compiler
     * miscompiles `ptr - array` (element value, not address) and unmarked
     * pointer differences come out as raw byte gaps -- the old expression
     * indexed d_file_open with a wild number and segfaulted on the first
     * polyglot fold.  Among OPEN slots fds are unique, and closed slots
     * already have d_file_open[i]==0, so an fd match is exact. */
    for (i = 0; i < 64; i++) if (d_files[i][0] == fi[0]) d_file_open[i] = 0;
    return 0;
}
/* strlen/strcpy/strncpy/strcmp/strncmp/strstr — d_* versions defined below in monolith core */
static char* d_strcat(char* dst, const char* src) {
    int n = d_strlen(dst);
    int i = 0;
    while (src[i]) { dst[n + i] = src[i]; i++; }
    dst[n + i] = 0;
    return dst;
}
static char* d_strncat(char* dst, const char* src, int n) {
    int dl = d_strlen(dst);
    int i = 0;
    while (i < n && src[i]) { dst[dl + i] = src[i]; i++; }
    dst[dl + i] = 0;
    return dst;
}
static char drygon_fbuf[64];
static void drygon_dd_core(double ah, double al, double bh, double bl, double* oh, double* ol) {
    double us = 1.0;
    double p = ah * bh;
    if (p > 1.0e308 || p < -1.0e308) { us = 4.0; ah = ah * 0.5; al = al * 0.5; bh = bh * 0.5; bl = bl * 0.5; p = ah * bh; }
    double sp = 134217729.0;
    double g1 = sp * ah;
    double a1 = g1 - (g1 - ah);
    double a0 = ah - a1;
    double g2 = sp * bh;
    double b1 = g2 - (g2 - bh);
    double b0 = bh - b1;
    double e = ((a1 * b1 - p) + a1 * b0 + a0 * b1) + a0 * b0;
    e = e + ah * bl + al * bh;
    double s = p + e;
    if (s != s) { *oh = 1.0e308 * 10.0; *ol = 0.0; return; }
    if (s > 1.0e308 || s < -1.0e308) { *oh = s * us; *ol = 0.0; return; }
    *ol = (e - (s - p)) * us;
    *oh = s * us;
}
static void drygon_dd_mul(double ah, double al, double bh, double bl, double* oh, double* ol) {
    double p = ah * bh;
    if (p != 0.0 && p > -2.2250738585072014e-308 && p < 2.2250738585072014e-308) {
        double sc = 2.0;
        sc = sc * sc; sc = sc * sc; sc = sc * sc; sc = sc * sc;
        sc = sc * sc; sc = sc * sc; sc = sc * sc; sc = sc * sc;
        sc = sc * 17592186044416.0;
        double f2 = sc * sc;
        double t1; double t2;
        drygon_dd_core(ah * sc, al * sc, bh * sc, bl * sc, &t1, &t2);
        *oh = t1 / f2;
        *ol = t2 / f2;
        return;
    }
    drygon_dd_core(ah, al, bh, bl, oh, ol);
}
static void drygon_pow10_dd(int k, double* oh, double* ol) {
    double rh = 1.0;
    double rl = 0.0;
    double bh = 10.0;
    double bl = 0.0;
    if (k < 0) {
        k = 0 - k;
        bh = 1.0 / 10.0;
        bl = ((1.0 - 8.0 * bh) - 2.0 * bh) / 10.0;
    }
    while (k > 0) {
        if (k % 2 == 1) { double th; double tl; drygon_dd_mul(rh, rl, bh, bl, &th, &tl); rh = th; rl = tl; }
        if (bh < 1.0e150) { double th; double tl; drygon_dd_mul(bh, bl, bh, bl, &th, &tl); bh = th; bl = tl; }
        k = k / 2;
    }
    *oh = rh;
    *ol = rl;
}
double drygon_recon(long mant, int k) {
    double mh = (double)mant;
    double ml = (double)(mant - (long)mh);
    int h2 = k / 2;
    int l2 = k - h2;
    double ph1 = 1.0; double pl1 = 0.0;
    double ph2 = 1.0; double pl2 = 0.0;
    double ih = 0.0; double il = 0.0;
    double oh = 0.0; double ol = 0.0;
    drygon_pow10_dd(h2, &ph1, &pl1);
    drygon_pow10_dd(l2, &ph2, &pl2);
    drygon_dd_mul(mh, ml, ph1, pl1, &ih, &il);
    drygon_dd_mul(ih, il, ph2, pl2, &oh, &ol);
    return oh + ol;
}
char* ftoa(long bits) {
    double hh, ll;
    long bl = bits;
    double av = *(double*)&bl;
    long fx = (bl >> 52) & 2047;
    long fm = bl & 4503599627370495;
    int i = 0;
    if (av == 0.0) { drygon_fbuf[i] = 48; drygon_fbuf[i + 1] = 46; drygon_fbuf[i + 2] = 48; drygon_fbuf[i + 3] = 0; return drygon_fbuf; }
    if (fx == 2047 && fm != 0) { drygon_fbuf[0] = 110; drygon_fbuf[1] = 97; drygon_fbuf[2] = 110; drygon_fbuf[3] = 0; return drygon_fbuf; }
    if (av < 0.0) { drygon_fbuf[0] = 45; i = 1; av = 0.0 - av; }
    if (fx == 2047 && fm == 0) { drygon_fbuf[i] = 105; drygon_fbuf[i + 1] = 110; drygon_fbuf[i + 2] = 102; drygon_fbuf[i + 3] = 0; return drygon_fbuf; }
    int e10 = 0;
    hh = av;
    ll = 0.0;
    int dg[24];
    int di = 0;
    while (hh >= 10.0) {
        double q1 = hh / 10.0;
        double p8 = q1 * 8.0;
        double p2 = q1 + q1;
        double a1 = p8 + p2;
        double ae = (p8 - a1) + p2;
        double r1 = (hh - a1) + ll;
        double r2 = r1 - ae;
        double q2 = r2 / 10.0;
        double s9 = q1 + q2;
        ll = (q1 - s9) + q2;
        hh = s9;
        e10 = e10 + 1;
    }
    while (hh < 1.0) {
        double w = hh * 8.0;
        double x = hh + hh;
        double y = w + x;
        double z = (w - y) + x;
        double g = ll * 10.0;
        double c1 = y + g;
        double c2 = (y - c1) + g;
        hh = c1 + z;
        ll = (c1 - hh) + z + c2;
        e10 = e10 - 1;
    }
    while (di < 19) {
        int ddi = (int)hh;
        if (ddi > 9) ddi = 9;
        if (ddi < 0) ddi = 0;
        dg[di] = ddi;
        hh = hh - (double)ddi;
        double w = hh * 8.0;
        double x = hh + hh;
        double y = w + x;
        double z = (w - y) + x;
        double g = ll * 10.0;
        double c1 = y + g;
        double c2 = (y - c1) + g;
        hh = c1 + z;
        ll = (c1 - hh) + z + c2;
        di = di + 1;
    }
    int best = 17;
    int pp = 1;
    int kk = 0;
    while (pp <= 17) {
        long mant = 0;
        int k = 0;
        while (k < pp) { mant = mant * 10 + dg[k]; k = k + 1; }
        if (dg[pp] >= 5) mant = mant + 1;
        kk = e10 - (pp - 1);
        double rc = drygon_recon(mant, kk);
        if (rc == av) { best = pp; break; }
        pp = pp + 1;
    }
    long mant = 0;
    int k = 0;
    while (k < best) { mant = mant * 10 + dg[k]; k = k + 1; }
    if (dg[best] >= 5) mant = mant + 1;
    char md[24];
    int mn = 0;
    long m2 = mant;
    while (m2 > 0) { int q = m2 / 10; md[mn] = 48 + (m2 - q * 10); mn = mn + 1; m2 = q; }
    if (mant2 == 0) { md[0] = 48; mn = 1; }
    long m3 = mant2;
    int drop = 0;
    while (m3 > 9) { long tq = m3 / 10; if (m3 - tq * 10 != 0) break; m3 = tq; drop = drop + 1; }
    int d3 = mn - drop;
    int ne = e10 - best + drop + d3;
    if (ne >= 16 || ne < -4) {
        drygon_fbuf[i] = md[d3 - 1 + drop]; i = i + 1;
        if (d3 > 1) { drygon_fbuf[i] = 46; i = i + 1; int t2 = d3 - 2; while (t2 >= 0) { drygon_fbuf[i] = md[t2 + drop]; i = i + 1; t2 = t2 - 1; } }
        drygon_fbuf[i] = 101; i = i + 1;
        if (ne < 0) { drygon_fbuf[i] = 45; i = i + 1; ne = 0 - ne; } else { drygon_fbuf[i] = 43; i = i + 1; }
        if (ne >= 100) { drygon_fbuf[i] = 48 + ne / 100; i = i + 1; ne = ne - (ne / 100) * 100; }
        drygon_fbuf[i] = 48 + ne / 10; i = i + 1;
        drygon_fbuf[i] = 48 + (ne - (ne / 10) * 10); i = i + 1;
        drygon_fbuf[i] = 0;
        return drygon_fbuf;
    }
    if (ne >= 0) {
        if (ne + 1 >= d3) {
            int t2 = d3 - 1;
            while (t2 >= 0) { drygon_fbuf[i] = md[t2 + drop]; i = i + 1; t2 = t2 - 1; }
            int zp = ne + 1 - d3;
            while (zp > 0) { drygon_fbuf[i] = 48; i = i + 1; zp = zp - 1; }
            drygon_fbuf[i] = 46; i = i + 1; drygon_fbuf[i] = 48; i = i + 1;
        } else {
            int t2 = d3 - 1;
            while (t2 >= d3 - 1 - ne) { drygon_fbuf[i] = md[t2 + drop]; i = i + 1; t2 = t2 - 1; }
            drygon_fbuf[i] = 46; i = i + 1;
            t2 = d3 - 2 - ne;
            while (t2 >= 0) { drygon_fbuf[i] = md[t2 + drop]; i = i + 1; t2 = t2 - 1; }
        }
    } else {
        drygon_fbuf[i] = 48; i = i + 1; drygon_fbuf[i] = 46; i = i + 1;
        int zp = 0 - ne - 1;
        while (zp > 0) { drygon_fbuf[i] = 48; i = i + 1; zp = zp - 1; }
        int t2 = d3 - 1;
        while (t2 >= 0) { drygon_fbuf[i] = md[t2 + drop]; i = i + 1; t2 = t2 - 1; }
    }
    while (i > 1 && drygon_fbuf[i - 1] == 48 && drygon_fbuf[i - 2] != 46) i = i - 1;
    drygon_fbuf[i] = 0;
    return drygon_fbuf;
}
/* ftoa_fixed -- C-style %.*f formatting: exactly `prec` decimals with a
 * zero-padded fraction (and no decimal point when prec == 0).  Scaling is
 * done on the double and rounded half-up; the digits are then rendered from
 * the scaled integer so the fraction is always exactly prec characters. */
char* ftoa_fixed(long bits, int prec) {
    long bl = bits;
    double av = *(double*)&bl;
    long fx = (bl >> 52) & 2047;
    long fm = bl & 4503599627370495;
    int i = 0;
    if (prec < 0) prec = 0;
    if (prec > 17) prec = 17;
    if (fx == 2047 && fm != 0) { drygon_fbuf[0] = 110; drygon_fbuf[1] = 97; drygon_fbuf[2] = 110; drygon_fbuf[3] = 0; return drygon_fbuf; }
    if (av < 0.0) { drygon_fbuf[0] = 45; i = 1; av = 0.0 - av; }
    if (fx == 2047 && fm == 0) { drygon_fbuf[i] = 105; drygon_fbuf[i + 1] = 110; drygon_fbuf[i + 2] = 102; drygon_fbuf[i + 3] = 0; return drygon_fbuf; }
    double sc = 1.0;
    int t = 0;
    while (t < prec) { sc = sc * 10.0; t = t + 1; }
    double sh = av * sc;
    if (sh >= 9.0e18) sh = 9.0e18; /* keep the long cast in range */
    long base = (long)sh;
    double frac = sh - (double)base;
    long scaled = base;
    if (frac > 0.5) { scaled = base + 1; } else if (frac == 0.5) { if (base - (base / 2) * 2 != 0) { scaled = base + 1; } }
    char md[32];
    int mn = 0;
    long m2 = scaled;
    while (m2 > 0) { int q = (int)(m2 / 10); md[mn] = 48 + (int)(m2 - q * 10); mn = mn + 1; m2 = q; }
    if (scaled == 0) { md[0] = 48; mn = 1; }
    /* integer digits: md[mn-1] .. md[prec]; fraction: md[prec-1] .. md[0] */
    if (mn <= prec) {
        drygon_fbuf[i] = 48; i = i + 1;
    } else {
        int id = mn - 1;
        while (id >= prec) { drygon_fbuf[i] = md[id]; i = i + 1; id = id - 1; }
    }
    if (prec > 0) {
        drygon_fbuf[i] = 46; i = i + 1;
        int fd = prec - 1;
        while (fd >= 0) {
            if (fd >= mn) drygon_fbuf[i] = 48; else drygon_fbuf[i] = md[fd];
            i = i + 1; fd = fd - 1;
        }
    }
    drygon_fbuf[i] = 0;
    return drygon_fbuf;
}
/* strcmp/strncmp/strchr/strstr — d_* versions defined below in monolith core */
static int d_snprintf(char* out, int sz, const char* fmt, ...) {
    va_list ap;
    va_start(ap, fmt);
    int o = 0, f = 0;
    while (fmt[f] && o < sz - 1) {
        if (fmt[f] != '%') { out[o++] = fmt[f++]; continue; }
        f++;
        if (fmt[f] == '%') { out[o++] = '%'; f++; continue; }
        if (fmt[f] == 's') {
            char* sv = va_arg(ap, char*);
            int k = 0;
            while (sv[k] && o < sz - 1) out[o++] = sv[k++];
            f++;
            continue;
        }
        if (fmt[f] == 'd') {
            int v = va_arg(ap, int);
            if (v < 0) {
                if (o < sz - 1) out[o++] = '-';
                if (v == -2147483648) {
                    const char* min = "2147483648";
                    int k = 0;
                    while (min[k] && o < sz - 1) out[o++] = min[k++];
                    f++;
                    continue;
                }
                v = -v;
            }
            if (v == 0) { if (o < sz - 1) out[o++] = '0'; f++; continue; }
            char tmp[16]; int ti = 0;
            while (v > 0 && ti < 16) { tmp[ti++] = '0' + (v % 10); v /= 10; }
            while (ti > 0 && o < sz - 1) out[o++] = tmp[--ti];
            f++;
            continue;
        }
        if (fmt[f] == 'l' && fmt[f+1] == 'd') {
            long v = va_arg(ap, long);
            if (v < 0) {
                if (o < sz - 1) out[o++] = '-';
                v = -v;
            }
            if (v == 0) { if (o < sz - 1) out[o++] = '0'; f += 2; continue; }
            char tmp[24]; int ti = 0;
            while (v > 0 && ti < 24) { tmp[ti++] = '0' + (int)(v % 10); v /= 10; }
            while (ti > 0 && o < sz - 1) out[o++] = tmp[--ti];
            f += 2;
            continue;
        }
        if (fmt[f] == 'x') {
            unsigned int v = va_arg(ap, unsigned int);
            if (v == 0) { if (o < sz - 1) out[o++] = '0'; f++; continue; }
            char tmp[12]; int ti = 0;
            while (v > 0 && ti < 12) {
                int d = v & 0xF;
                tmp[ti++] = (d < 10) ? ('0' + d) : ('a' + d - 10);
                v >>= 4;
            }
            while (ti > 0 && o < sz - 1) out[o++] = tmp[--ti];
            f++;
            continue;
        }
        if (fmt[f] == 'g') {
            double v = va_arg(ap, double);
            /* Use the existing ftoa for %g — convert via drygon_dbits */
            long bits = *(long*)&v;
            char* fstr = ftoa(bits);
            int k = 0;
            while (fstr[k] && o < sz - 1) out[o++] = fstr[k++];
            f++;
            continue;
        }
        /* Unknown specifier: emit literally */
        out[o++] = '%';
        if (o < sz - 1 && fmt[f]) out[o++] = fmt[f++];
    }
    out[o] = 0;
    va_end(ap);
    return o;
}

/* strrchr: rightmost occurrence of c in s, or NULL. Full implementation. */
char* d_strrchr(const char* s, int c) {
    const char* last = 0;
    int i = 0;
    while (s[i]) {
        if (s[i] == (char)c) last = s + i;
        i = i + 1;
    }
    if (c == 0) last = s + i;
    return (char*)last;
}

/* getenv: sovereign environ read via /proc/self/environ (no libc envp).
 * Returns a pointer to the value bytes of a static buffer, or NULL. */
static char d_environ_buf[65536];
static int d_environ_loaded;
char* d_getenv(const char* name) {
    if (!d_environ_loaded) {
        d_environ_loaded = 1;
        long fd = sys_openat(-100, "/proc/self/environ", 0, 0);
        if (fd >= 0) {
            long r = sys_read(fd, d_environ_buf, 65535);
            if (r > 65535) r = 65535;
            if (r >= 0) d_environ_buf[r > 0 ? r : 0] = 0;
            else d_environ_buf[0] = 0;
            sys_close(fd);
        } else {
            d_environ_buf[0] = 0;
        }
    }
    int nl = 0;
    while (name[nl]) nl = nl + 1;
    int i = 0;
    while (i < 65536) {
        /* each entry: NAME=VALUE\0 */
        int j = 0;
        while (i + j < 65536 && d_environ_buf[i + j] != 0 && d_environ_buf[i + j] != 61 && j < nl && d_environ_buf[i + j] == name[j]) j = j + 1;
        if (j == nl && d_environ_buf[i + j] == 61) {
            return d_environ_buf + i + j + 1;
        }
        while (i < 65536 && d_environ_buf[i] != 0) i = i + 1;
        if (i >= 65536) break;
        i = i + 1;
        if (i < 65536 && d_environ_buf[i] == 0) break;
    }
    return 0;
}

/* ------ sscanf: full scanf engine (width, '*', length modifiers, all
 * conversions incl. `%[...]` sets with ranges and `%n`) ------------------ */
static int d_sc_space(int c) { return c == 32 || (c >= 9 && c <= 13); }
static int d_sc_digit(int c) { return c >= 48 && c <= 57; }
static int d_sc_xdigit(int c) { return d_sc_digit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70); }
static int d_sc_dval(int c) {
    if (c >= 48 && c <= 57) return c - 48;
    if (c >= 97 && c <= 122) return c - 97 + 10;
    if (c >= 65 && c <= 90) return c - 65 + 10;
    return -1;
}
static void d_sc_skipsp(const char** pp) {
    const char* p = *pp;
    while (d_sc_space(*p)) p = p + 1;
    *pp = p;
}
static int d_sc_sint(const char** pp, int width, int base, long* out) {
    const char* s = *pp;
    int used = 0;
    int neg = 0;
    int any = 0;
    int b = base;
    long acc = 0;
    if (width > 0 && used >= width) return 0;
    if (*s == 45 || *s == 43) {
        if (*s == 45) neg = 1;
        s = s + 1; used = used + 1;
    }
    if (b == 0) {
        b = 10;
        if (*s == 48) {
            if ((*(s + 1) == 120 || *(s + 1) == 88) && d_sc_xdigit(*(s + 2))) {
                b = 16; s = s + 2; used = used + 2; any = 1;
            } else {
                b = 8; s = s + 1; used = used + 1; any = 1;
            }
        }
    } else if (b == 16) {
        if (*s == 48 && (*(s + 1) == 120 || *(s + 1) == 88) && d_sc_xdigit(*(s + 2))) {
            s = s + 2; used = used + 2;
        }
    }
    while (*s) {
        int dv;
        if (width > 0 && used >= width) break;
        dv = d_sc_dval(*s);
        if (dv < 0 || dv >= b) break;
        acc = acc * (long)b + (long)dv;
        s = s + 1; used = used + 1; any = 1;
    }
    if (!any) return 0;
    if (neg) acc = 0 - acc;
    *out = acc;
    *pp = s;
    return 1;
}
static int d_sc_dbl(const char** pp, int width, double* out) {
    const char* s = *pp;
    int used = 0;
    int neg = 0;
    int any = 0;
    int eany = 0;
    int eneg = 0;
    int exp = 0;
    int i;
    double val = 0.0;
    double frac = 0.1;
    if (*s == 45 || *s == 43) {
        if (*s == 45) neg = 1;
        s = s + 1; used = used + 1;
    }
    while (*s && (width <= 0 || used < width) && d_sc_digit(*s)) {
        val = val * 10.0 + (double)(*s - 48);
        s = s + 1; used = used + 1; any = 1;
    }
    if (*s == 46 && (width <= 0 || used < width)) {
        s = s + 1; used = used + 1;
        while (*s && (width <= 0 || used < width) && d_sc_digit(*s)) {
            val = val + (double)(*s - 48) * frac;
            frac = frac * 0.1;
            s = s + 1; used = used + 1; any = 1;
        }
    }
    if (!any) return 0;
    if ((*s == 101 || *s == 69) && (width <= 0 || used < width)) {
        const char* save = s;
        int savel = used;
        s = s + 1; used = used + 1;
        if (*s == 45 || *s == 43) {
            if (*s == 45) eneg = 1;
            s = s + 1; used = used + 1;
        }
        while (*s && (width <= 0 || used < width) && d_sc_digit(*s)) {
            exp = exp * 10 + (*s - 48);
            s = s + 1; used = used + 1; eany = 1;
        }
        if (!eany) { s = save; used = savel; exp = 0; }
    }
    i = 0;
    while (i < exp) {
        if (eneg) val = val / 10.0; else val = val * 10.0;
        i = i + 1;
    }
    if (neg) val = 0.0 - val;
    *out = val;
    *pp = s;
    return 1;
}
static int d_sscanf(const char* str, const char* fmt, ...) {
    va_list ap;
