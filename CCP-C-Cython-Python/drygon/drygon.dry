    static char cg_prog_pcls[65536];
    static char cg_prog_retstr[256];
    static int cg_pstr_changed;
    static char cg_prog_variant[256];  /* has a string argument somewhere   */
    static char cg_prog_retlist[256]; /* ...or returns a python list literal */
    /* ...and that list holds strings, so the shared result buffer for it is the
