    static void py_raise(PyValue v, const char* tname) {
        py_cur_exc = v;
        py_cur_exc_type = tname;
        py_exc_pending = 1;
    }
    static void py_raise_str(const char* tname, const char* msg) {
        py_raise(pyv_str_c(msg), tname);
    }
    static int py_exc_pending_c(void) { return py_exc_pending; }
    static void py_exc_clear(void) { py_exc_pending = 0; }
    static int py_exc_is(const char* tname) {
        return py_exc_pending && d_strcmp(py_cur_exc_type, tname) == 0;
    }
    static void py_exc_reraise(void) { py_exc_pending = 1; }
    static const char* py_exc_type(void) { return py_cur_exc_type; }
    static char* py_exc_repr(void) { return py_repr(py_cur_exc); }
    /* ── PER-WORKER ARENAS — lock-free allocation discipline ──
     * The pyruntime's own arena: 16 MB static buffer with an ATOMIC bump
     * pointer. No mutex, no GIL-by-another-name. Under concurrent
     * allocation, the CAS loop is lock-free. Per-worker sub-arenas extend
     * the same pattern (partitricks carves per-worker stacks/TLS — the
     * same discipline applies to allocation slabs). The breath tick
     * reconciles on the main thread. */
    #define PYR_ARENA_BYTES (256 * 1024 * 1024)
    static unsigned char* _pyr_arena = 0;
    static volatile long long _pyr_pos = 0;
    static volatile int _pyr_lock = 0;
    static void* pyr_alloc(unsigned long size) {
        if (!_pyr_arena) {
            _pyr_arena = (unsigned char*)sys_mmap(0, PYR_ARENA_BYTES, 3, 34, -1, 0);
            if (!_pyr_arena) return NULL;
        }
        unsigned long aligned = (size + 15) & ~(unsigned long)15;
        long long old, new_c;
        /* Simple spinlock — works on single-core; multi-core needs futex */
        while (_pyr_lock) { /* spin */ }
        _pyr_lock = 1;
        old = _pyr_pos;
        new_c = old + (long long)aligned;
        if (new_c > (long long)PYR_ARENA_BYTES) { _pyr_lock = 0; return NULL; }
        _pyr_pos = new_c;
        _pyr_lock = 0;
        return _pyr_arena + old;
    }
    static void pyr_arena_reset(void) { _pyr_pos = 0; }
