                    cg_lf_put(g, lrecv, lfx); cg_put(g, "_n] = _lcp");
                    cg_put_int(g, xr); cg_put(g, "[_xk"); cg_put_int(g, xr); cg_put(g, "]; ");
                    cg_lf_put(g, lrecv, lfx); cg_put(g, "_n = ");
                    cg_lf_put(g, lrecv, lfx); cg_put(g, "_n + 1; _xk");
                    cg_put_int(g, xr); cg_put(g, " = _xk"); cg_put_int(g, xr);
                    cg_put(g, " + 1; } }\n");
