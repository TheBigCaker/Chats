    p[1394] = "int drygon_ig_get(int* v, int n) { if (drygon_ig_n < 1) return 0; int i = drygon_ig[0]; if (i < 0) i = i + n; if (i < 0 || i >= n) return 0; return v[i]; }\n";
    /* `str.index`/`str.rindex` raise ValueError when the substring is
     * missing, unlike `find`/`rfind` which return -1 (14_methods check 8). */
    p[1395] = "int drygon_index(char* h, char* nd) { int r = drygon_find(h, nd); if (r < 0) py_raise_str(\"ValueError\", \"substring not found\"); return r; }\n";
    p[1396] = "int drygon_index_from(char* h, char* nd, int start) { int r = drygon_find_from(h, nd, start); if (r < 0) py_raise_str(\"ValueError\", \"substring not found\"); return r; }\n";
