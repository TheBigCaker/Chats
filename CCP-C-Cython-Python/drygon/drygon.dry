                                advance(p);
                            }
                        }
                        /* default = value: carried as a PARAM_DECL child so
                         * a signature variant without that argument can
                         * initialise the parameter from it */
                        IRNode* pdn = ir_new("PARAM_DECL", pname, ptype);
                        if (pk(p)->kind == TOK_EQ) {
                            advance(p);
                            IRNode* dv = parse_expr(p);
                            if (dv) ir_add_child(pdn, dv);
                        }
                        ir_add_child(params, pdn);
                    } else if (pk(p)->kind == TOK_OP && (d_strcmp(pk(p)->text,"*")==0||d_strcmp(pk(p)->text,"**")==0)) {
