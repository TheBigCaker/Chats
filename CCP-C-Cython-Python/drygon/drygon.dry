    /* Names known to hold floats (assigned a float literal or a float
     * expression). Used to pick %f instead of %d when printing. */
    static char cg_float_vars[16384];
    static int cg_nfloat_vars;
    static void cg_note_float(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nfloat_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_float_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return;
            i++;
        }
        if (cg_nfloat_vars < 256) {
            int base = cg_nfloat_vars * 64;
            int j = 0;
            while (name[j] && j < 63) { cg_float_vars[base + j] = name[j]; j++; }
            cg_float_vars[base + j] = 0;
            cg_nfloat_vars = cg_nfloat_vars + 1;
        }
    }
    static char cg_dptr_vars[2048];
    static int cg_ndptr_vars;
    static void cg_note_dptr(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_ndptr_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_dptr_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return;
            i++;
        }
        if (cg_ndptr_vars < 32) {
            int base = cg_ndptr_vars * 64;
            int j = 0;
            while (name[j] && j < 63) { cg_dptr_vars[base + j] = name[j]; j++; }
            cg_dptr_vars[base + j] = 0;
            cg_ndptr_vars++;
        }
    }
    static int cg_name_is_dptr(const char* name) {
        if (!name || !name[0]) return 0;
        int i = 0;
        while (i < cg_ndptr_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_dptr_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static int cg_name_is_str(const char* name) {
        if (!name || !name[0]) return 0;
        int i = 0;
        while (i < cg_nstr_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_str_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static int cg_name_is_float(const char* name) {
        int i = 0;
        while (i < cg_nfloat_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_float_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    /* math.<name>() results: python 3 hands back a float for everything except
     * floor/ceil/trunc/round, which are integers. */
    static int cg_math_ret_float(const char* m) {
        if (!m) return 0;
        if (!cg_math_fn(m)) return 0;
        if (d_strcmp(m,"floor")==0) return 0;
        if (d_strcmp(m,"ceil")==0) return 0;
        if (d_strcmp(m,"trunc")==0) return 0;
        if (d_strcmp(m,"round")==0) return 0;
        return 1;
    }
    static int cg_agg_case(const IRNode* a);
    static int cg_agg_ctype(const IRNode* a);
    static int cg_is_float_node(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CONSTANT")==0) return d_strcmp(a->data_type,"FLOAT")==0;
        if (d_strcmp(a->type,"IDENTIFIER")==0) return cg_name_is_float(a->value);
        /* an element of a float list (or of a dict with float values) is a double */
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 &&
            d_strcmp(a->children[0]->type,"IDENTIFIER")==0) {
            const char* nm = a->children[0]->value;
            /* A list parameter is named by the *signature variant* being
             * compiled, not by whatever a same-named script variable holds:
             * `def total(xs)` must not read the element type off a module-level
             * `xs = [1.5, 2.5]`. */
            if (cg_is_lparam(nm)) return cg_is_lparam_float(nm);
            return cg_list_is_float(nm) || cg_dict_vf(nm) == 1;
        }
        if (d_strcmp(a->type,"BINARY_OP")==0) {
            const char* op = a->value;
            if (d_strcmp(op,"==")==0 || d_strcmp(op,"!=")==0 ||
                d_strcmp(op,"<")==0 || d_strcmp(op,">")==0 ||
                d_strcmp(op,"<=")==0 || d_strcmp(op,">=")==0 ||
                d_strcmp(op,"in")==0 || d_strcmp(op,"not in")==0 ||
                d_strcmp(op,"is")==0 || d_strcmp(op,"is not")==0) return 0;
            /* python `/` is true division: always float */
            if (d_strcmp(op,"/")==0) return 1;
            if (a->nchildren>0 && cg_is_float_node(a->children[0])) return 1;
            if (a->nchildren>1 && cg_is_float_node(a->children[1])) return 1;
            return 0;
        }
        if (d_strcmp(a->type,"IFEXP")==0 && a->nchildren>2)
            return cg_is_float_node(a->children[1]) && cg_is_float_node(a->children[2]);
        if (d_strcmp(a->type,"UNARY_OP")==0 && a->nchildren>0) return cg_is_float_node(a->children[0]);
        /* an instance attribute whose class body stores a double */
        if (d_strcmp(a->type,"MEMBER_ACCESS")==0 && a->nchildren>0) {
            int ft = cg_member_ftype(a->children[0], a->value);
            if (ft == 3) return 1;
            if (ft == 2) return 0;
        }
        /* math.pi / math.e / math.tau / math.inf / math.nan are doubles */
        if (d_strcmp(a->type,"MEMBER_ACCESS")==0 && a->nchildren>0 &&
            d_strcmp(a->children[0]->value,"math")==0) {
            if (d_strcmp(a->value,"pi")==0) return 1;
            if (d_strcmp(a->value,"e")==0) return 1;
            if (d_strcmp(a->value,"tau")==0) return 1;
            if (d_strcmp(a->value,"inf")==0) return 1;
            if (d_strcmp(a->value,"nan")==0) return 1;
            return 0;
        }
        /* `scale(1.5)` is a float expression when scale returns a double. */
        if (d_strcmp(a->type,"CALL")==0) {
            if (d_strcmp(a->value,"float")==0) return 1;
            /* round() returns a double in Python; round(x, n) is always a float,
             * so treating the call as float keeps print from dumping raw IEEE
             * bits instead of the value. */
            if (d_strcmp(a->value,"round")==0) {
                if (a->nchildren==2) return 1;
                return (a->nchildren==1) ? cg_is_float_node(a->children[0]) : 0;
            }
            /* sum/min/max over a float list is a double */
            if ((d_strcmp(a->value,"sum")==0 || d_strcmp(a->value,"min")==0 ||
                 d_strcmp(a->value,"max")==0) && a->nchildren==1 && cg_agg_ctype(a->children[0]) == 1)
                return 1;
            if (d_strcmp(a->value,"COMPLEX")==0) {
                if (a->nchildren>0 && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0) {
                    if (cg_math_ret_float(a->children[0]->value)) return 1;
                    /* the `time` clocks return a python float */
                    const IRNode* _tv = a->children[0];
                    if (_tv->nchildren>0 && _tv->children[0] &&
                        _tv->children[0]->value &&
                        d_strcmp(_tv->children[0]->value,"time")==0 &&
                        (d_strcmp(_tv->value,"time")==0 ||
                         d_strcmp(_tv->value,"monotonic")==0 ||
                         d_strcmp(_tv->value,"perf_counter")==0 ||
                         d_strcmp(_tv->value,"process_time")==0))
                        return 1;
                }
                return 0;
            }
            /* `f(2.5)` reaches a body whose parameter is a `double`; when that
             * body returns the float, the call is a float expression */
            if (cg_call_ret_float(a)) return 1;
            return cg_fn_is_float(a->value);
        }
        return 0;
    }
    /* Names of Python functions that must be generated as `double f(double)`
