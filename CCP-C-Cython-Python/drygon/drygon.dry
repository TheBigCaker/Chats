                         * guard below used to reject.  `csv.DictReader`'s
                         * `fieldnames` therefore came out as a scalar
                         * `char* fieldnames;` while the methods wrote
                         * `self->fieldnames[i]` and `self->fieldnames_n`
                         * through the uninitialised pointer (50_csv segfaulted
                         * as soon as the write checks passed). */
                        if (cg_lf_is(cg_cls_names[cg_cls_n - 1], cfn + fi2*64)) ft = 4;
                        else if (ft != 2 && cg_cls_field_is_ptr_m(body, cfn + fi2*64)) ft = 4;
                        cg_indent(g);
                        if (ft == 2) cg_put(g, "char* ");
                        else if (ft == 3) cg_put(g, "double ");
                        else if (ft == 4) {
                            int _lk = cg_lf_kind(cg_cls_names[cg_cls_n - 1], cfn + fi2*64);
                            const char* _oec = cg_oe_get(cg_cls_names[cg_cls_n - 1], cfn + fi2*64);
                            if (_oec && _oec[0]) { cg_put(g, _oec); cg_put(g, "* "); }
                            else if (_lk == 2) cg_put(g, "char* ");
                            else if (_lk == 1) cg_put(g, "double ");
                            else cg_put(g, "int ");
                        }
                        else cg_put(g, "int ");
                        cg_put(g, cfn + fi2*64);
                        /* a list field is an INLINE array, so the instance owns
                         * its elements (a pointer member left the constructor
                         * literal dangling and the count unwritten) */
                        if (ft == 4) cg_put(g, "[64]");
                        cg_put(g, ";\n");
                        if (ft == 4) {
                            /* a list field carries its element count */
                            cg_lf_add(cg_cls_names[cg_cls_n - 1], cfn + fi2*64);
                            cg_indent(g);
                            cg_put(g, "int "); cg_put(g, cfn + fi2*64); cg_put(g, "_n;\n");
                        }
                    }
                    fi2++;
                }
            }
            g->indent--;
            cg_indent(g); cg_put(g, "} "); cg_put(g, n->value); cg_put(g, ";\n");
            /* The struct is complete for the first time right here, and every
             * method of every later class may need this class' scratch object
             * (`self._r = reader(...)`), so its declaration belongs here --
             * after the typedef, before any body. */
            { int _sgi = cg_scratch_find(n->value); if (_sgi >= 0) cg_scratch_emit(g, _sgi); }
            /* methods as functions taking the struct pointer */
            if (body) {
                for (int i=0;i<body->nchildren;i++) {
                    const IRNode* c = body->children[i];
                    if (d_strcmp(c->type,"FUNCTION_DEF")==0) {
                        int ci = cg_cls_n - 1;
                        const IRNode* mbody0 = c->nchildren>1 ? c->children[1] : NULL;
                        int mdt = cg_infer_mret(mbody0, g, 0);
                        /* A method that builds and returns a python list must be
                         * declared `int*` / `char**`, not `int`: the array pointer
                         * was truncated into the return word and the caller read
                         * garbage (`od.keys()`, `reader.__next__()`).  Methods are
                         * not in the `cg_prog_*` tables, so ask the body. */
                        int mlist = 0;
                        int msls = 0;
                        if (mbody0 &&
                            (cg_ret_list_scan(mbody0) || cg_ret_name_list_scan(mbody0, mbody0))) {
                            mlist = 1;
                            if (cg_ret_strlist_of(mbody0)) msls = 1;
                        }
                        {
                            /* A method that builds and returns a python dict
                             * publishes the triple through the shared buffer
                             * instead of the return word: record its shape for
