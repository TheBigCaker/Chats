                            /* `RED = auto()` inside an Enum: a sequential ordinal.
                             * Emitting the call produced `static int X = auto();`
                             * and the C front end rejected the initializer. */
                            if (d_strcmp(rhs->type,"CALL")==0 && rhs->value &&
                                (d_strcmp(rhs->value,"auto")==0 || d_strcmp(rhs->value,"COMPLEX")==0)) {
                                if (d_strcmp(rhs->value,"auto")==0 ||
                                    (rhs->nchildren>0 && rhs->children[0]->value &&
                                     d_strcmp(rhs->children[0]->value,"auto")==0)) {
                                    auto_n = auto_n + 1;
                                    cg_put_int(g, auto_n);
                                    emitted = 1;
                                }
                            }
                            if (!emitted) {
                                /* only a literal initializer is valid at file
