                        cg_put(g, "if (_rpr"); cg_put_int(g, i); cg_put(g, "_d > 0) {\n");
                        g->indent++;
                        cg_indent(g);
                        cg_put(g, "while (_rpr"); cg_put_int(g, i); cg_put(g, "_v < _rpr"); cg_put_int(g, i); cg_put(g, "_h) {\n");
                        g->indent++;
                        cg_indent(g);
                        cg_put(g, "_rpr"); cg_put_int(g, i); cg_put(g, "[_rpr"); cg_put_int(g, i); cg_put(g, "_n] = _rpr"); cg_put_int(g, i); cg_put(g, "_v;\n");
                        cg_indent(g);
                        cg_put(g, "_rpr"); cg_put_int(g, i); cg_put(g, "_n = _rpr"); cg_put_int(g, i); cg_put(g, "_n + 1;\n");
                        cg_indent(g);
                        cg_put(g, "_rpr"); cg_put_int(g, i); cg_put(g, "_v = _rpr"); cg_put_int(g, i); cg_put(g, "_v + _rpr"); cg_put_int(g, i); cg_put(g, "_d;\n");
                        g->indent--;
                        cg_indent(g); cg_put(g, "}\n");
                        g->indent--;
                        cg_indent(g); cg_put(g, "}\n");
                        cg_indent(g);
                        cg_put(g, "if (_rpr"); cg_put_int(g, i); cg_put(g, "_d < 0) {\n");
                        g->indent++;
                        cg_indent(g);
                        cg_put(g, "while (_rpr"); cg_put_int(g, i); cg_put(g, "_v > _rpr"); cg_put_int(g, i); cg_put(g, "_h) {\n");
                        g->indent++;
                        cg_indent(g);
                        cg_put(g, "_rpr"); cg_put_int(g, i); cg_put(g, "[_rpr"); cg_put_int(g, i); cg_put(g, "_n] = _rpr"); cg_put_int(g, i); cg_put(g, "_v;\n");
                        cg_indent(g);
                        cg_put(g, "_rpr"); cg_put_int(g, i); cg_put(g, "_n = _rpr"); cg_put_int(g, i); cg_put(g, "_n + 1;\n");
                        cg_indent(g);
                        cg_put(g, "_rpr"); cg_put_int(g, i); cg_put(g, "_v = _rpr"); cg_put_int(g, i); cg_put(g, "_v + _rpr"); cg_put_int(g, i); cg_put(g, "_d;\n");
                        g->indent--;
                        cg_indent(g); cg_put(g, "}\n");
                        g->indent--;
                        cg_indent(g); cg_put(g, "}\n");
