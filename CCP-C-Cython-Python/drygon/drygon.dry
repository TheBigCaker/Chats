    p[1430] = "if (align == 1) l = pad;\nelse if (align == 2) l = (pad + 1) / 2;\nchar* r = drygon_alloc(width + 1);\nint k = 0;\nwhile (k < l) { r[k] = fc; k = k + 1; }\nint i = 0;\n";
