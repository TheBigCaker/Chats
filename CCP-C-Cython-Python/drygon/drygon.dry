    p[1489] = "char* drygon_fmt_map(char* s, char** k, char** v, int n) {\nint ns = drygon_slen(s);\nint need = ns + 64;\nint q = 0;\nwhile (q < n) { need = need + drygon_slen(v[q]); q = q + 1; }\nchar* r = drygon_alloc(need);\nint i = 0;\nint m = 0;\nwhile (s[i]) {\nint c = s[i];\nif (c == 123) {\nif (s[i + 1] == 123) { r[m] = 123; m = m + 1; i = i + 2; }\nelse {\nint j = i + 1;\nint e = j;\nwhile (s[e] != 0 && s[e] != 125 && s[e] != 58 && s[e] != 33) e = e + 1;\nint z = e;\nwhile (s[z] != 0 && s[z] != 125) z = z + 1;\nint t = 0;\nint idx = -1;\nwhile (t < n) { if (drygon_fm_keysame(k[t], s, j, e)) { idx = t; break; } t = t + 1; }\nif (idx >= 0) { char* vv = v[idx]; int w = 0; while (vv[w] != 0) { r[m] = vv[w]; m = m + 1; w = w + 1; } }\nelse { py_raise_str(\"KeyError\", \"format_map\"); }\ni = z;\nif (s[z] == 125) i = z + 1;\n}\n}\nelse if (c == 125) { if (s[i + 1] == 125) { r[m] = 125; m = m + 1; i = i + 2; } else { i = i + 1; } }\nelse { r[m] = c; m = m + 1; i = i + 1; }\n}\nr[m] = 0;\nreturn r;\n}\n";
    p[1490] = "char** drygon_splitlines_k(char* s) {\nint i = 0;\nint start = 0;\ndrygon_nlines_ = 0;\nwhile (1) {\nchar c = s[i];\nif (c == 10 || c == 13 || c == 0) {\nint e = i;\nif (c != 0) { e = i + 1; if (c == 13 && s[i + 1] == 10) e = i + 2; }\nif (e > start) { if (drygon_nlines_ < 1024) { drygon_slines_[drygon_nlines_] = drygon_substr(s, start, e); drygon_nlines_ = drygon_nlines_ + 1; } }\nif (c == 0) break;\ni = e;\nstart = e;\n}\nelse { i = i + 1; }\n}\nreturn drygon_slines_;\n}\n";
    p[1491] = "int drygon_tpl_id(int c) {\nreturn (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;\n}\n";
    /* `string.Template.substitute`/`safe_substitute`: `$name` and `${name}`
