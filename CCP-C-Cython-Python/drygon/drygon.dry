                        }
                    }
                    if (negate) { if (hit) hit = 0; else hit = 1; }
                    if (!hit) break;
                    if (dp) dp[n] = *s;
                    s = s + 1; n = n + 1;
                }
                ok = (n > 0);
                if (ok && !suppress) {
                    assigned = assigned + 1;
                    dp[n] = 0;
                }
            } else {
                ok = 0;                       /* unknown conversion */
            }
            if (!ok) { if (*s == 0) eof = 1; break; }
        }
    }
    va_end(ap);
    if (assigned == 0 && eof) return -1;
    return assigned;
}

/* ------ Minimal string helpers (no libc) ------------------------------------------------------------------------------------------------------------------ */
static char* d_strstr(char* h, char* n) {
    if (!*n) return h;
    char* p = 0;
    for (p = h; *p; p++) {
        char* a = p; char* b = n;
        while (*a && *b && *a == *b) { a++; b++; }
        if (!*b) return p;
    }
    return 0;
}
static int d_strlen(char* s) {
    int n = 0;
    while (s[n]) n++;
    return n;
}
static int d_strcmp(char* a, char* b) {
    while (*a && *a == *b) { a++; b++; }
    return *a - *b;
}
static void d_strcpy(char* dest, char* src) {
    int i = 0;
    while (src[i]) { dest[i] = src[i]; i++; }
    dest[i] = 0;
}
static int d_strncmp(char* a, char* b, int n) {
    while (n && *a && *a == *b) { a++; b++; n--; }
    if (n == 0) return 0;
    return *a - *b;
}
static void d_strncpy(char* dst, char* src, int n) {
    int i = 0;
    while (i < n && src[i]) { dst[i] = src[i]; i = i + 1; }
    while (i < n) { dst[i] = 0; i = i + 1; }
}
static void d_memcpy(void* dst, void* src, int n) {
    char* d = dst;
    char* s = src;
    { int i = 0; while (i < n) { d[i] = s[i]; i++; } }
}
static int d_memcmp(void* a, void* b, int n) {
    char* s1 = a;
    char* s2 = b;
    int i = 0;
    while (i < n) {
        if (s1[i] != s2[i]) return ((unsigned char)s1[i] < (unsigned char)s2[i]) ? -1 : 1;
        i++;
    }
    return 0;
}
static void d_memset(void* dst, int c, int n) {
    char* d = dst;
    { int i = 0; while (i < n) { d[i] = c; i++; } }
}
static void d_memmove(void* dst, void* src, int n) {
    char* d = dst;
    char* s = src;
    if (d == s || n <= 0) return;
    if (d < s) { int i = 0; while (i < n) { d[i] = s[i]; i++; } }
    else { int i = n - 1; while (i >= 0) { d[i] = s[i]; i--; } }
}

/* ============================================================
 * SPOOF LAYER -- the standard names, served by drygon itself
 * libc's allocator and memory primitives are banned in drygon.  These
 * definitions hand the standard names to drygon's own implementations so
 * that any program linked with the drygon binary -- including the embedded system's
 * libc, whose fopen/getline call malloc/free/realloc internally -- is
 * served by drygon and never by libc.  baccyn's linker gives an object's
 * own definition precedence over a library's, which is what makes the
 * spoof possible at all.
 *
 * The allocator must be a real allocator, not a bump arena: libc's
 * internals free and realloc the blocks it takes from here.  Small
 * requests come from size-class free lists carved out of mmap'd chunks;
 * free returns a block to its class list; large blocks are unmapped
 * directly.  A 16-byte header holds the block size.
 * ============================================================ */
typedef struct d_heap_block {
    unsigned long size;
    struct d_heap_block* next;
} d_heap_block;
static d_heap_block* d_heap_free[65];
static unsigned char* d_heap_cur;
static unsigned long d_heap_left;

static void* d_alloc(unsigned long n) {
    unsigned long need = n + 16;
    if (n == 0) return (void*)0;
    if (need <= 1024) {
        unsigned long cls = (need + 15) >> 4;
        if (d_heap_free[cls] != 0) {
            d_heap_block* b = d_heap_free[cls];
            d_heap_free[cls] = b->next;
            return (void*)((unsigned char*)b + 16);
        }
        if (d_heap_left < need) {
            unsigned long cap = 262144;
            unsigned char* fresh;
            if (cap < need) cap = ((need + 4095) / 4096) * 4096;
            fresh = (unsigned char*)sys_mmap(0, (int)cap, 3, 34, -1, 0);
            if (fresh == (unsigned char*)0) return (void*)0;
            d_heap_cur = fresh;
            d_heap_left = cap;
        }
        {
            d_heap_block* b = (d_heap_block*)d_heap_cur;
            unsigned long sz = cls << 4;
            b->size = sz - 16;
            b->next = 0;
            d_heap_cur = d_heap_cur + sz;
            d_heap_left = d_heap_left - sz;
            return (void*)((unsigned char*)b + 16);
        }
    }
    {
        unsigned long pages = ((need + 4095) / 4096) * 4096;
        unsigned char* p = (unsigned char*)sys_mmap(0, (int)pages, 3, 34, -1, 0);
        if (p == (unsigned char*)0) return (void*)0;
        ((d_heap_block*)p)->size = pages - 16;
        ((d_heap_block*)p)->next = 0;
        return (void*)(p + 16);
    }
}
static void d_dealloc(void* p) {
    d_heap_block* b;
    if (p == 0) return;
    b = (d_heap_block*)((unsigned char*)p - 16);
    if (b->size + 16 > 1024) { sys_munmap(b, (int)(b->size + 16)); return; }
    {
        unsigned long cls = (b->size + 16) >> 4;
        b->next = d_heap_free[cls];
        d_heap_free[cls] = b;
    }
}
static void* d_realloc_impl(void* p, unsigned long n) {
    d_heap_block* b;
    void* np;
    unsigned long c;
    if (p == 0) return d_alloc(n);
    b = (d_heap_block*)((unsigned char*)p - 16);
    if (n <= b->size && n > (b->size >> 1)) return p;
    np = d_alloc(n);
    if (np == 0) return (void*)0;
    c = b->size < n ? b->size : n;
    d_memcpy(np, p, (int)c);
    d_dealloc(p);
    return np;
}

/* Spoof layer removed — all callers use drygon-native names directly:
 * d_alloc / d_dealloc / d_realloc_impl / d_memcpy / d_memmove / d_memset.
 * No libc names (malloc/free/calloc/realloc/memcpy/memmove/memset). */

static void d_puts(char* s) {
    sys_write(1, s, d_strlen(s));
}
static void d_putc(char c) {
    sys_write(1, &c, 1);
}
static void d_puthex(int v) {
    char buf[20]; int i = 0;
    if (v == 0) { d_putc(48); return; }
    while (v) {
        int d = v % 16;
        if (d < 10) {
            buf[i] = 48 + d;
        } else {
            buf[i] = 97 + d - 10;
        }
        i = i + 1;
        v = v / 16;
    }
    while (i) {
        i = i - 1;
        d_putc(buf[i]);
    }
}
static void d_putdec(int v) {
    char buf[24]; int i = 0;
    if (v < 0) {
        d_putc(45);
        if (v == -2147483648) {
            /* INT_MIN: negation overflows, handle specially */
            d_puts("2147483648");
            return;
        }
        v = -v;
    }
    if (v == 0) { d_putc(48); return; }
    while (v) {
        buf[i] = 48 + (v % 10);
        i = i + 1;
        v = v / 10;
    }
    while (i) {
        i = i - 1;
        d_putc(buf[i]);
    }
}

/* ------ Growable byte buffer ------------------------------------------------------------------------------------------------------------------------------------------------------ */
static void buf_init(long b) {
    long data = sys_mmap(0, 16777216, 3, 34, -1, 0);
    set_uint(b, 0, (unsigned int)data);
    set_uint(b, 1, (unsigned int)((data >> 32) & 0xFFFFFFFF));
    set_uint(b, 2, 0);
    set_uint(b, 4, 16777216);
}
/* Reserve room for `need` more bytes now.  buf_ensure grows in whole
 * doublings from a 16 MB floor, so a writer that appends one word at a time
 * can run past the end whenever the final size lands between two doublings:
 * an ELF whose exact total was 16,782,152 bytes overflowed a 16,777,216-byte
 * buffer by 4,936 bytes and the compiler segfaulted compiling valid input.
 * Callers that know their final size reserve it up front. */
static void buf_reserve(long b, int need) {
    int len = get_int(b + 8);
    int cap = get_int(b + 16);
    if (cap <= 0) { cap = 16777216; set_uint(b + 16, 0, cap); }
    if (need <= 0 || len + need <= cap) return;
    int ncap = cap;
    while (len + need > ncap) ncap = ncap + ncap;
    long data = get_ptr(b, 0);
    long nd = _raw_syscall(216, data, cap, ncap, 1, 0, 0);
    if (nd < 0 || nd > -4096) {
        nd = sys_mmap(0, ncap, 3, 34, -1, 0);
        d_memcpy(nd, data, len);
        sys_munmap(data, cap);
    }
    set_uint(b, 0, (unsigned int)nd);
    set_uint(b, 1, (unsigned int)((nd >> 32) & 0xFFFFFFFF));
    set_uint(b, 4, ncap);
}
static void buf_ensure(long b, int extra) {
    int len = get_int(b + 8);
    int cap = get_int(b + 16);
    if (cap <= 0) cap = 16777216;
    if (len + extra <= cap) return;
    int ncap = cap * 2;
    while (len + extra > ncap) ncap = ncap * 2;
    long data = get_ptr(b, 0);
    /* sys_mremap(old_address, old_size, new_size, flags=MREMAP_MAYMOVE=1) -> syscall 216 */
    long nd = _raw_syscall(216, data, cap, ncap, 1, 0, 0);
    if (nd < 0 || nd > -4096) {
        nd = sys_mmap(0, ncap, 3, 34, -1, 0);
        d_memcpy(nd, data, len);
        sys_munmap(data, cap);
    }
    set_uint(b, 0, (unsigned int)nd);
    set_uint(b, 1, (unsigned int)((nd >> 32) & 0xFFFFFFFF));
    set_uint(b, 4, ncap);
}
static void buf_byte(long b, char c) {
    buf_ensure(b, 1);
    long data = get_ptr(b, 0);
    int len = get_int(b + 8);
    set_char(data, len, c);
    set_uint(b + 8, 0, len + 1);
}
static void buf_word(long b, uint32_t w) {
    buf_ensure(b, 4);
    long data = get_ptr(b, 0);
    int len = get_int(b + 8);
    long uw = w;
    if (uw < 0) {
        uw = uw + 65536 * 65536;
    }
    set_char(data, len, uw % 256);
    set_char(data, len + 1, (uw / 256) % 256);
    set_char(data, len + 2, (uw / 65536) % 256);
    set_char(data, len + 3, (uw / 16777216) % 256);
    set_uint(b + 8, 0, len + 4);
}
static void buf_bytes(long b, void* src, int n) {
    buf_ensure(b, n);
    long data = get_ptr(b, 0);
    int len = get_int(b + 8);
    d_memcpy(data + len, src, n);
    set_uint(b + 8, 0, len + n);
}

/* ------ AArch64 instruction emitters ------------------------------------------------------------------------------------------------------------------------------ */
static uint32_t a_movz(int rd, uint32_t imm, int shift) {
    int imm_mask = imm % 65536; if (imm_mask < 0) { imm_mask = imm_mask + 65536; }
    return -763363328 + ((shift/16) * 2097152) + (imm_mask * 32) + rd;
}
static uint32_t a_movk(int rd, uint32_t imm, int shift) {
    int imm_mask = imm % 65536; if (imm_mask < 0) { imm_mask = imm_mask + 65536; }
    return -226492416 + ((shift/16) * 2097152) + (imm_mask * 32) + rd;
}
static uint32_t a_mov(int rd, int rn) {
    return -1442839584 + (rn * 65536) + rd;
}
static uint32_t a_add(int rd, int rn, int rm) {
    return -1962934272 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_sub(int rd, int rn, int rm) {
    return -889192448 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_addi(int rd, int rn, int imm) {
    return -1862270976 + ((imm % 4096) * 1024) + (rn * 32) + rd;
}
static uint32_t a_subi(int rd, int rn, int imm) {
    return -788529152 + ((imm % 4096) * 1024) + (rn * 32) + rd;
}
static uint32_t a_mul(int rd, int rn, int rm) {
    return -1694467072 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_sdiv(int rd, int rn, int rm) {
    return -1698690048 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_cmp(int rn, int rm) {
    return -352321505 + (rm * 65536) + (rn * 32);
}
static uint32_t a_cmpi(int rn, int imm) {
    return -251658209 + ((imm % 4096) * 1024) + (rn * 32);
}
static uint32_t a_bcond(int cond, int imm19) {
    int m = imm19 % 524288;
    if (m < 0) { m = m + 524288; }
    return 1409286144 + (m * 32) + cond;
}
static uint32_t a_b(int imm26) {
    int m = imm26 % 67108864;
    if (m < 0) { m = m + 67108864; }
    return 335544320 + m;
}
static uint32_t a_bl(int imm26) {
    int m = imm26 % 67108864;
    if (m < 0) { m = m + 67108864; }
    return -1811939328 + m;
}
static uint32_t a_ret(void) {
    return -698416192;
}
static uint32_t a_blr(int rn) {
    return 0xD63F0000 + (rn * 32);
}
static uint32_t a_ldr_x(int rt, int rn, int imm) {
    return -113246208 + (((imm/8) % 4096) * 1024) + (rn * 32) + rt;
}
static uint32_t a_str_x(int rt, int rn, int imm) {
    return -117440512 + (((imm/8) % 4096) * 1024) + (rn * 32) + rt;
}
static uint32_t a_ldr_w(int rt, int rn, int imm) {
    return -1186988032 + (((imm/4) % 4096) * 1024) + (rn * 32) + rt;
}
static uint32_t a_str_w(int rt, int rn, int imm) {
    return -1191182336 + (((imm/4) % 4096) * 1024) + (rn * 32) + rt;
}
static uint32_t a_ldrb(int rt, int rn, int imm) {
    return 960495616 + ((imm % 4096) * 1024) + (rn * 32) + rt;
}
static uint32_t a_strb(int rt, int rn, int imm) {
    return 956301312 + ((imm % 4096) * 1024) + (rn * 32) + rt;
}
static uint32_t a_strh(int rt, int rn, int imm) {
    int imm_shift = (imm / 2) % 4096;
    return 2030043136 + (imm_shift * 1024) + (rn * 32) + rt;
}
static uint32_t a_ldrh(int rt, int rn, int imm) {
    int imm_shift = (imm / 2) % 4096;
    return 2034237440 + (imm_shift * 1024) + (rn * 32) + rt;
}
static uint32_t a_ldrsb(int rt, int rn, int imm) {
    int val = imm % 512;
    if (val < 0) { val = val + 512; }
    return 947912704 + (val * 4096) + (rn * 32) + rt;
}
static uint32_t a_ldrsh(int rt, int rn, int imm) {
    int val = imm % 512;
    if (val < 0) { val = val + 512; }
    return 2021654528 + (val * 4096) + (rn * 32) + rt;
}
static uint32_t a_ldrsw(int rt, int rn, int imm) {
    int val = (imm / 4) % 4096;
    if (val < 0) { val = val + 4096; }
    return -1182793728 + (val * 1024) + (rn * 32) + rt;
}
static uint32_t a_adr(int rd, int imm) {
    int immlo = imm % 4;
    if (immlo < 0) { immlo = immlo + 4; }
    int immhi = ((imm - immlo) / 4) % 524288;
    if (immhi < 0) { immhi = immhi + 524288; }
    return 268435456 + (immlo << 29) + (immhi << 5) + rd;
}
static uint32_t a_adrp(int rd, int imm) {
    /* PC-relative page address. `imm` is page(target) - page(PC), always a
     * multiple of 4096. Paired with a following `add rd, rd, #page_off` it
     * reaches data that sits megabytes away from the code, where a plain ADR
     * silently wraps past its +/-1 MB reach. */
    int pages = imm / 4096;
    int immlo = pages % 4;
    if (immlo < 0) { immlo = immlo + 4; }
    int immhi = ((pages - immlo) / 4) % 524288;
    if (immhi < 0) { immhi = immhi + 524288; }
    return -1879048192 + (immlo << 29) + (immhi << 5) + rd;
}
static uint32_t a_svc(void) {
    return -738197503;
}
static uint32_t a_stp_x29_x30(void) {
    return -1447068675;
}
static uint32_t a_ldp_x29_x30(void) {
    return -1463714819;
}
static uint32_t a_stp_pre(int rt1, int rt2, int rn, int imm) {
    int imm7 = (imm/8) & 127;
    return -1451229184 + (imm7 * 32768) + (rt2 * 1024) + (rn * 32) + rt1;
}
static uint32_t a_ldp_post(int rt1, int rt2, int rn, int imm) {
    int imm7 = (imm/8) % 128;
    return -1463812096 + (imm7 * 32768) + (rt2 * 1024) + (rn * 32) + rt1;
}
static uint32_t a_nop(void) {
    return -721215457;
}
static uint32_t a_neg(int rd, int rn) {
    /* sub rd, xzr, rn — the negated register is the *second source* (Rm at
     * bits 16-20), not Rn: encoding it into the Rn field overflowed into the
     * shift field as soon as rn != 0 (sub x23, x22, x0, lsl #1). */
    return -889191456 + (rn * 65536) + rd;
}
static uint32_t a_madd(int rd, int rn, int rm, int ra) {
    return -1694498816 + (rm * 65536) + (ra * 1024) + (rn * 32) + rd;
}
static uint32_t a_udiv(int rd, int rn, int rm) {
    return -1698691072 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_lsl(int rd, int rn, int rm) {
    return -1698684928 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_mrs_tpidr(void) {
    return -717500352;
}
static uint32_t a_csneg(int rd, int rn, int rm, int cond) {
    return -1702884352 + (rm * 65536) + (cond * 4096) + (rn * 32) + rd;
}
static uint32_t a_csel(int rd, int rn, int rm, int cond) {
    return 0x9A800000 + (rm * 65536) + (cond * 4096) + (rn * 32) + rd;
}
static uint32_t a_cset(int rd, int cond) {
    int inv = 0;
    if (cond % 2 == 0) {
        inv = cond + 1;
    } else {
        inv = cond - 1;
    }
    return -1700853792 + (inv * 4096) + rd;
}
static uint32_t a_and(int rd, int rn, int rm) {
    return 0x8A000000 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_orr(int rd, int rn, int rm) {
    return 0xAA000000 + (rm * 65536) + (rn * 32) + rd;
}
/* andi xd, xn, #mask — imm12 is a single-bit mask value (2..32); encodes
 * N=1, imms=0, immr=64-k so the immediate is exactly that bit set. */
static uint32_t a_andi_m12(int rd, int rn, int imm12) {
    int k = 0;
    while (((imm12 >> k) & 1) == 0) { k = k + 1; }
    int immr = 64 - k;
    if (immr == 64) { immr = 63; }
    return 0x92400000 + (immr * 65536) + (rn * 32) + rd;
}
/* eor xd, xn, xm and mvn xd, xm (= orn xd, xzr, xm); encodings verified with
 * clang + llvm-objdump. Used by the bitwise expression levels and by unary '~'. */
static uint32_t a_eor(int rd, int rn, int rm) {
    return 0xCA000000 + (rm * 65536) + (rn * 32) + rd;
}
static uint32_t a_mvn(int rd, int rm) {
    return 0xAA2003E0 + (rm * 65536) + rd;
}
