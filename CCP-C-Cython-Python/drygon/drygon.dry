                const char* _ac = cg_cvar_class(n->children[0]->value);
                int _aci = _ac ? cg_cls_index(_ac) : -1;
                const IRNode* _ab = (_aci>=0) ? cg_cls_body[_aci] : 0;
                int _tup = (d_strcmp(n->value,"astuple")==0);
                if (_ab) {
                    IRNode* _lit = ir_new("BLOCK", _tup ? "TUPLE" : "DICT", "ANY");
                    int _j = 0;
                    while (_j < _ab->nchildren) {
                        const IRNode* _fc = _ab->children[_j];
                        if (_fc && d_strcmp(_fc->type,"VAR_DECL")==0 && _fc->value && _fc->value[0]) {
                            if (!_tup) {
                                char _kb[96]; int _kz = 0;
                                _kb[_kz++]='"';
                                { int _q=0; while (_fc->value[_q] && _kz<80) _kb[_kz++]=_fc->value[_q++]; }
                                _kb[_kz++]='"'; _kb[_kz]=0;
