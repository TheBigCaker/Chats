                const IRNode* aa = n->children[0];
                int act = cg_agg_ctype(aa);
                cg_put(g, "drygon_");
                cg_put(g, d_strcmp(n->value,"all")==0 ? "all_" : "any_");
                cg_put(g, act == 1 ? "dbl" : (act == 2 ? "str" : "int"));
                cg_put(g, "(");
                cg_agg_operand(g, aa);
                cg_put(g, ")");
            } else if ((d_strcmp(n->value,"sum")==0 || d_strcmp(n->value,"min")==0 ||
                        d_strcmp(n->value,"max")==0) &&
                       (n->nchildren == 1 ||
                        (d_strcmp(n->value,"sum")==0 && n->nchildren == 2)) &&
                       cg_agg_case(n->children[0]) != 0 &&
                       !(d_strcmp(n->value,"sum")==0 && cg_agg_ctype(n->children[0]) == 2)) {
                /* whole-list aggregation; a list is array + element count */
                const IRNode* la = n->children[0];
                int lct = cg_agg_ctype(la);
                if (n->nchildren == 2) cg_put(g, "(");
                cg_put(g, "drygon_");
                if (d_strcmp(n->value,"sum")==0) cg_put(g, lct == 1 ? "sum_dbl" : "sum_int");
                else {
                    cg_put(g, d_strcmp(n->value,"max")==0 ? "lmax_" : "lmin_");
                    cg_put(g, lct == 1 ? "dbl" : (lct == 2 ? "str" : "int"));
                }
                cg_put(g, "(");
                cg_agg_operand(g, la);
                cg_put(g, ")");
                /* `sum(xs, start)` adds the start value (check 70/71). */
                if (n->nchildren == 2) {
                    cg_put(g, " + ");
                    cg_gen_expr(g, n->children[1]);
                    cg_put(g, ")");
                }
            } else if ((d_strcmp(n->value,"min")==0 || d_strcmp(n->value,"max")==0) &&
                       n->nchildren >= 2 && !cg_is_list_node(n->children[0]) &&
                       cg_agg_case(n->children[0]) == 0) {
                /* N-arity min/max over SCALARS: fold left-to-right with the
                 * ternary.  Only the 2-arg form existed, so `min(3, 1, 2)` fell
                 * through to the generic call and emitted an unresolved symbol
                 * (09_operators checks 92/93). */
                const char* op = d_strcmp(n->value,"min")==0 ? " < " : " > ";
                cg_emit_minmax(g, n, 0, op);
            } else if (d_strcmp(n->value,"sorted_cmpk")==0 && cg_slx_index(n) >= 0) {
                /* `sorted(xs, key=cmp_to_key(f))`: the statement temp holds the
                 * copy sorted by f (see cg_sl_copy); the value is the temp. */
                cg_sl_put_name(g, cg_slx_index(n));
            } else if ((d_strcmp(n->value,"sorted")==0 || d_strcmp(n->value,"sorted_r")==0) &&
                       n->nchildren==1 && cg_sl_islice(n)) {
                /* `sorted(xs)`: the statement temp holds a copy of xs, sorted
                 * in place right after the copy (see cg_sl_copy). */
                int k = cg_slx_index(n);
                if (k < 0) k = cg_sl_add(n, cg_sl_base_et(n));
                if (k >= 0) cg_sl_put_name(g, k);
                else cg_put(g, "0");
            } else if (d_strcmp(n->value,"reversed")==0 && n->nchildren==1 && cg_sl_islice(n)) {
                /* `reversed(xs)`: the statement temp holds a copy of xs reversed
                 * in place right after the copy (see cg_sl_copy). */
                int krv = cg_slx_index(n);
                if (krv < 0) krv = cg_sl_add(n, cg_sl_base_et(n));
                if (krv >= 0) cg_sl_put_name(g, krv);
                else cg_put(g, "0");
            } else if ((d_strcmp(n->value,"sorted")==0 || d_strcmp(n->value,"sorted_r")==0) &&
                       cg_slx_index(n) >= 0) {
                /* `sorted(d)`: the key-copy + insertion sort was emitted at
                 * statement level by cg_dict_sort_emit, which also registered
                 * this call node's temp in the slice table.  The expression is
                 * the temp's name -- falling through to the plain-call path
                 * emitted `sorted(...)`, an undefined symbol. */
                cg_sl_put_name(g, cg_slx_index(n));
            } else if (cg_call_has_kwargs(n, g->prog)) {
                /* A call that passes ALL of its arguments by keyword
                 * (`f(c=3, b=2, a=1)`).  Python matches them by NAME; C has
                 * only positions, so emit them in parameter order.  The old
                 * path skipped the KWARG children entirely and emitted a bare
                 * `f(3, 2, 1)`.  Only the all-keyword form is handled here --
                 * a mixed call keeps the old (still keyword-dropping) path so
                 * no previously-working call changes shape. */
                cg_emit_kwcall(g, n);
            } else if (n->value && n->nchildren > 0 && cg_ag_lookup(n->value) >= 0) {
                /* `g(x)` where g was bound to `operator.attrgetter("a")`: the
                 * name is not a real function (it was bound to 0), so read the
                 * matching attribute of x instead of calling address 0
                 * (55_operator_mod check 31 SEGV'd).  When x is an element of
                 * an OBJECT list the value lives in the per-attribute column
                 * array; otherwise x is an instance and `.a` is a real field. */
                int _ai = cg_ag_lookup(n->value);
                const IRNode* _ax = n->children[0];
                int _alx = (_ax && d_strcmp(_ax->type,"ARRAY_ACCESS")==0 && _ax->nchildren>1 &&
                    d_strcmp(_ax->children[0]->type,"IDENTIFIER")==0) ?
                    cg_ob_lookup(_ax->children[0]->value) : -1;
                int _acx = _alx >= 0 ? cg_ob_col(_ax->children[0]->value, cg_ag_attr[_ai]) : -1;
                if (_acx >= 0) {
                    cg_put(g, cg_ob_lcn[_alx*8 + _acx]);
                    cg_put(g, "[drygon_lidx(");
                    cg_gen_expr(g, _ax->children[1]);
                    cg_put(g, ", "); cg_put(g, _ax->children[0]->value); cg_put(g, "_n)]");
                } else {
                    cg_gen_expr(g, _ax);
                    cg_put(g, "."); cg_put(g, cg_ag_attr[_ai]);
                }
            } else if (n->value && n->nchildren > 0 && cg_mc_lookup(n->value) >= 0 &&
                       cg_mc_helper(cg_mc_meth[cg_mc_lookup(n->value)])) {
                /* `m(x)` where m was bound to `operator.methodcaller("upper")`:
                 * call the matching string helper on x. */
                cg_put(g, cg_mc_helper(cg_mc_meth[cg_mc_lookup(n->value)]));
                cg_put(g, "(");
                cg_gen_expr(g, n->children[0]);
                cg_put(g, ")");
            } else if (cg_ig_lookup(n->value) >= 0 && n->nchildren > 0) {
                /* `g(x)` where g was bound to `operator.itemgetter(...)`: not a
                 * real function, so read the recorded indices out of x.  The
                 * name was bound to 0 and the call dereferenced address 0. */
                int _bn = cg_ig_lookup(n->value);
                const IRNode* _ga = n->children[0];
                if (d_strcmp(n->value,"COMPLEX")==0 && d_strcmp(n->children[0]->type,"IDENTIFIER")==0)
                    _ga = n->nchildren>1 ? n->children[1] : NULL;
                if (cg_ig_n_[_bn] == 1) {
                    int _ci = cg_ig_idx[_bn][0];
                    cg_ig_emit_elem(g, _ga, _ci);
                } else {
                    /* multi-index: fill a shared runtime buffer so the value is
                     * a real array.  `(a, b)` would be a C comma expression
                     * (which evaluates to just `b`).  The helper takes two
                     * values; more than that falls back to the first index. */
                    if (cg_ig_n_[_bn] == 2) {
                        cg_put(g, "drygon_igv(");
                        cg_ig_emit_elem(g, _ga, cg_ig_idx[_bn][0]);
                        cg_put(g, ", ");
                        cg_ig_emit_elem(g, _ga, cg_ig_idx[_bn][1]);
                        cg_put(g, ", 2)");
                    } else {
                        cg_ig_emit_elem(g, _ga, cg_ig_idx[_bn][0]);
                    }
                }
            } else if (d_strcmp(n->value,"COMPLEX")!=0 && n->value &&
                       cg_cvar_class(n->value) &&
                       cg_cls_find_m(cg_cvar_class(n->value), "__call__")) {
                /* `obj(args)` where obj's class defines `__call__`: calling an
                 * instance is a method call on it (12_classes 60/61). */
                const char* cc = cg_cvar_class(n->value);
                const char* cm = cg_cls_find_m(cc, "__call__");
                cg_put(g, cm); cg_put(g, "___call__(&"); cg_put(g, n->value);
                int ci2 = 0;
                while (ci2 < n->nchildren) {
                    if (d_strcmp(n->children[ci2]->type,"STAR_ARG")!=0) {
                        cg_put(g, ", "); cg_gen_expr(g, n->children[ci2]);
                    }
                    ci2++;
                }
                cg_put(g, ")");
            } else {
                /* plain call: the callee name lives in n->value.  Only the
                 * VARIABLE alias table is consulted -- cg_fnalias maps a
                 * function to the nested def it returns, so using it here
                 * rewrote a genuine `make_adder(5)` call into `adder(5)`. */
                const char* callee_name = cg_als_wrap_of(n->value);
                if (!callee_name) callee_name = cg_fna_of(n->value);
                if (!callee_name) callee_name = n->value;
                cg_put(g, cg_safe_fn_name(callee_name));
                int mk = cg_call_mask_live(n);
                int fmv = cg_call_fmask(n);
                if ((mk != cg_fn_base_mask(callee_name) || fmv != 0) && cg_has_mask2(callee_name, mk, fmv)) {
                    cg_put(g, "__"); cg_put_int(g, mk);
                    if (fmv) { cg_put(g, "_"); cg_put_int(g, fmv); }
                }
                cg_put(g, "(");
                /* `f(1, 2, 3)` where `f` is `def f(*args)`: the collected
                 * arguments are packed into a temp array and handed over with
                 * its element count, matching the `int* args, int args_n`
                 * signature.  Emitting the arguments positionally left the
                 * callee's `args` empty, so `sum_all(1, 2, 3)` returned 0
                 * (11_functions check 8).  A call that unpacks (`f(*xs)`) keeps
                 * the existing path below. */
                {
                    int vsimple = 1;
                    for (int vq=0;vq<n->nchildren;vq++) {
                        if (!n->children[vq]) continue;
                        if (d_strcmp(n->children[vq]->type,"STAR_ARG")==0) vsimple = 0;
                        if (d_strcmp(n->children[vq]->type,"DSTAR_KW")==0) vsimple = 0;
                    }
                    if (vsimple && cg_fn_is_variadic(callee_name) &&
                        cg_fn_vararg_fixed(callee_name) >= 0 &&
                        n->nchildren >= cg_fn_vararg_fixed(callee_name)) {
                        int vfixed = cg_fn_vararg_fixed(callee_name);
                        int vi;
                        for (vi = 0; vi < n->nchildren && vi < vfixed; vi++) {
                            if (vi) cg_put(g, ", ");
                            cg_gen_expr(g, n->children[vi]);
                        }
                        if (vfixed) cg_put(g, ", ");
                        cg_put(g, "(int[]){");
                        {
                            int vk = 0;
                            for (vi = vfixed; vi < n->nchildren; vi++) {
                                const IRNode* vc = n->children[vi];
                                if (!vc) continue;
                                if (d_strcmp(vc->type,"KWARG")==0) continue;
                                if (vk) cg_put(g, ", ");
                                cg_gen_expr(g, vc);
                                vk++;
                            }
                            if (vk == 0) cg_put(g, "0");
                        }
                        cg_put(g, "}, ");
                        cg_put_int(g, n->nchildren > vfixed ? n->nchildren - vfixed : 0);
                        cg_put(g, ")");
                        return;
                    }
                }
                /* `f(1, 2, 3, x=10, y=20)` where `f` declares `**kwargs` (and
                 * maybe `*args`): the leading parameters go over positionally,
                 * the rest are packed into an array with its count, and the
                 * keywords are handed over as the hoisted temp dict's three
                 * arrays (cg_hoist_kw_dicts).  Letting this fall through emitted
                 * the keyword names as bare identifiers, which did not resolve
                 * (11_functions checks 42/43). */
                {
                    int cAr = 0, cKw = 0;
                    int cfixed = cg_fn_collect_shape(callee_name, &cAr, &cKw);
                    int cok = (cfixed >= 0 && cKw);
                    for (int cq=0;cok && cq<n->nchildren;cq++) {
                        const IRNode* cc3 = n->children[cq];
                        if (!cc3) continue;
                        if (d_strcmp(cc3->type,"KWARG")==0) cok = 0;
                        if (d_strcmp(cc3->type,"STAR_ARG")==0) cok = 0;
                        if (d_strcmp(cc3->type,"DSTAR_KW")==0 &&
                            !(cc3->value && d_strcmp(cc3->value,"KW")==0)) cok = 0;
                    }
                    if (cok) {
                        const char* kwsrc = NULL;
                        for (int cq=0;cq<n->nchildren;cq++) {
                            const IRNode* cc3 = n->children[cq];
                            if (cc3 && d_strcmp(cc3->type,"DSTAR_KW")==0 &&
                                cc3->nchildren>0 && cc3->children[0] &&
                                d_strcmp(cc3->children[0]->type,"IDENTIFIER")==0)
                                kwsrc = cc3->children[0]->value;
                        }
                        int firstc = 1;
                        int vi;
                        int cvk = 0;
                        for (vi = 0; vi < n->nchildren && vi < cfixed; vi++) {
                            if (!firstc) cg_put(g, ", ");
                            cg_gen_expr(g, n->children[vi]);
                            firstc = 0;
                        }
                        if (cAr) {
                            if (!firstc) cg_put(g, ", ");
                            cg_put(g, "(int[]){");
                            {
                                /* the DSTAR_KW marker is a child of the call
                                 * node but not an argument, so the packed
                                 * count has to skip it (11_functions 42/43) */
                                for (vi = cfixed; vi < n->nchildren; vi++) {
                                    const IRNode* vc = n->children[vi];
                                    if (!vc) continue;
                                    if (d_strcmp(vc->type,"DSTAR_KW")==0) continue;
                                    if (cvk) cg_put(g, ", ");
                                    cg_gen_expr(g, vc);
                                    cvk++;
                                }
                                if (cvk == 0) cg_put(g, "0");
                            }
                            cg_put(g, "}, ");
                            cg_put_int(g, cvk);
                            firstc = 0;
                        }
                        if (!firstc) cg_put(g, ", ");
                        if (kwsrc) {
                            cg_put(g, kwsrc); cg_put(g, "_k, ");
                            cg_put(g, kwsrc); cg_put(g, "_v, ");
                            cg_put(g, kwsrc); cg_put(g, "_n");
                        } else {
                            cg_put(g, "(char**)0, (int*)0, 0");
                        }
                        cg_put(g, ")");
                        return;
                    }
                }
                /* `f(**d)`: expand the dict's VALUES positionally.  Without
                 * this the node fell into the list-parameter branch below and
                 * emitted a bare `, 0`, so `g(**kwargs)` became the invalid
                 * `g(, 0)` and the generated C did not parse. */
                {
                    int has_ds = 0;
                    for (int dq=0;dq<n->nchildren;dq++) {
                        if (!n->children[dq]) continue;
                        if (d_strcmp(n->children[dq]->type,"DSTAR_KW")==0) has_ds = 1;
                        if (d_strcmp(n->children[dq]->type,"STAR_ARG")==0) has_ds = 1;
                    }
                    if (has_ds) {
                        int firsta = 1;
                        for (int dq=0;dq<n->nchildren;dq++) {
                            const IRNode* dc2 = n->children[dq];
                            if (!dc2) continue;
                            /* `f(*args)`: pass the list's elements POSITIONALLY.
                             * A list literal is unrolled; a NAME with a known
                             * compile-time size reads its backing array (which
                             * the caller filled).  A variadic PARAMETER (`*args`
                             * inside a wrapper) has no backing array, so nothing
                             * is passed for it -- emitting an empty argument
                             * produced unparseable `func(, ...)`. */
                            if (d_strcmp(dc2->type,"STAR_ARG")==0) {
                                const IRNode* sa = dc2->nchildren>0 ? dc2->children[0] : NULL;
                                if (sa && cg_is_list_node(sa)) {
                                    int sk = 0;
                                    while (sk < sa->nchildren) {
                                        if (!firsta) cg_put(g, ", ");
                                        cg_gen_expr(g, sa->children[sk]);
                                        firsta = 0; sk++;
                                    }
                                } else if (sa && d_strcmp(sa->type,"IDENTIFIER")==0 &&
                                           cg_list_size(sa->value) >= 0 &&
                                           !cg_is_lparam(sa->value)) {
                                    int sk = 0;
                                    int sn = cg_list_size(sa->value);
                                    while (sk < sn) {
                                        if (!firsta) cg_put(g, ", ");
                                        cg_put(g, sa->value); cg_put(g, "[");
                                        cg_put_int(g, sk); cg_put(g, "]");
                                        firsta = 0; sk++;
                                    }
                                } else if (sa && d_strcmp(sa->type,"IDENTIFIER")==0 &&
                                           cg_is_vparam(sa->value)) {
                                    /* `g(*args)` inside `def f(*args)`: the
                                     * collector has no backing array of its own
                                     * -- it IS the argument array the caller
                                     * packed, so its elements are handed over
                                     * one by one, guarded by the live count.
                                     * Passing nothing left the callee's
                                     * parameters uninitialised (functools'
                                     * `wrapper(*args, **kwargs)` returned
                                     * garbage). */
                                    int vf2 = cg_fn_vararg_fixed(callee_name);
                                    int nf2 = cg_fn_nfixed(callee_name);
                                    if (vf2 >= 0) {
                                        int q2 = 0;
                                        while (q2 < vf2) {
                                            if (!firsta) cg_put(g, ", ");
                                            cg_put(g, "("); cg_put(g, sa->value);
                                            cg_put(g, "_n > "); cg_put_int(g, q2);
                                            cg_put(g, " ? "); cg_put(g, sa->value);
                                            cg_put(g, "["); cg_put_int(g, q2);
                                            cg_put(g, "] : 0)");
                                            firsta = 0; q2++;
                                        }
                                        if (!firsta) cg_put(g, ", ");
                                        cg_put(g, sa->value);
                                        cg_put(g, " + "); cg_put_int(g, vf2);
                                        cg_put(g, ", (");
                                        cg_put(g, sa->value); cg_put(g, "_n > ");
                                        cg_put_int(g, vf2);
                                        cg_put(g, " ? "); cg_put(g, sa->value);
                                        cg_put(g, "_n - "); cg_put_int(g, vf2);
                                        cg_put(g, " : 0)");
                                        firsta = 0;
                                    } else if (nf2 >= 0) {
                                        int q3 = 0;
                                        while (q3 < nf2) {
                                            if (!firsta) cg_put(g, ", ");
                                            cg_put(g, "("); cg_put(g, sa->value);
                                            cg_put(g, "_n > "); cg_put_int(g, q3);
                                            cg_put(g, " ? "); cg_put(g, sa->value);
                                            cg_put(g, "["); cg_put_int(g, q3);
                                            cg_put(g, "] : 0)");
                                            firsta = 0; q3++;
                                        }
                                    }
                                }
                                continue;
                            }
                            if (d_strcmp(dc2->type,"DSTAR_KW")==0 && dc2->nchildren>0) {
                                const IRNode* ds2 = dc2->children[0];
                                if (ds2 && d_strcmp(ds2->type,"IDENTIFIER")==0 && cg_is_dict(ds2->value)) {
                                    int q2 = 0;
                                    while (q2 < 3) {
                                        if (!firsta) cg_put(g, ", ");
                                        cg_put(g, ds2->value); cg_put(g, "_v[");
                                        cg_put_int(g, q2); cg_put(g, "]");
                                        firsta = 0; q2++;
                                    }
                                } else if (ds2 && d_strcmp(ds2->type,"BLOCK")==0 &&
                                           d_strcmp(ds2->value,"DICT")==0) {
                                    int k2 = 0;
                                    while (k2 < ds2->nchildren) {
                                        if (!firsta) cg_put(g, ", ");
                                        cg_gen_expr(g, ds2->children[k2+1]);
                                        firsta = 0; k2 = k2 + 2;
                                    }
                                }
                            } else {
                                if (!firsta) cg_put(g, ", ");
                                cg_gen_expr(g, dc2);
                                firsta = 0;
                            }
                        }
                        cg_put(g, ")");
                        return;
                    }
                }
                /* the signature the pre-pass picked for this call site: which
                 * parameters are lists, and of what element type */
                int lm = (mk >> 8) & 0xFF;
                /* KWARG children are NOT positional arguments: emitting one
                 * put its NAME (`key`, `func`, ...) into the argument list as a
                 * bare C identifier, which then failed to resolve -- the
                 * `UNRESOLVED: key` that blocked 26_functools / 20_advanced /
                 * 60_comprehensive.  The keyword is matched to its parameter by
                 * the keyword-aware path above; here it is simply skipped. */
                {
                    int emitted_any = 0;
                    for (int i=0;i<n->nchildren;i++) {
                    const IRNode* c = n->children[i];
                    if (d_strcmp(c->type,"KWARG")==0) continue;
                    if (emitted_any) cg_put(g, ", ");
                    emitted_any = 1;
                    if (d_strcmp(c->type,"DSTAR_KW")==0 || d_strcmp(c->type,"STAR_ARG")==0) { cg_put(g, "0"); continue; }
                    {
                        /* a dict parameter is handed over as its key array, its
                         * value array and its entry count */
                        const char* dpn = cg_fn_param_dname(callee_name, i);
                        if (dpn) {
                            int dkf = cg_dict_kf(dpn);
                            int dvf = cg_dict_vf(dpn);
                            const char* vt = dvf == 2 ? "char**" : (dvf == 1 ? "double*" : "int*");
                            if (c && d_strcmp(c->type,"IDENTIFIER")==0 && cg_is_dict(c->value)) {
                                cg_put(g, c->value); cg_put(g, "_k, ");
                                cg_put(g, c->value); cg_put(g, "_v, ");
                                cg_put(g, c->value); cg_put(g, "_n");
                            } else {
                                /* a dict LITERAL argument never reaches here: the
                                 * pre-pass hoists it into a temp dict variable
                                 * (cg_hoist_dict_args).  Two compound-literal
                                 * arrays cannot be built in the argument list --
                                 * drygon reads their elements with the wrong
                                 * width, so the callee got a null key and
                                 * trapped. */
                                cg_put(g, "("); cg_put(g, dkf ? "char**" : "int*"); cg_put(g, ")0, (");
                                cg_put(g, vt); cg_put(g, "*)0, 0");
                            }
                            continue;
                        }
                    }
                    if (lm & (1 << i)) {
                        /* a python list parameter takes the backing array and
                         * its element count */
                        if (c && d_strcmp(c->type,"IDENTIFIER")==0 && cg_is_lparam(c->value)) {
                            cg_put(g, c->value); cg_put(g, ", "); cg_put(g, c->value); cg_put(g, "_n");
                        } else if (c && d_strcmp(c->type,"IDENTIFIER")==0 && cg_list_size(c->value) >= 0) {
                            cg_put(g, c->value); cg_put(g, ", "); cg_put(g, c->value); cg_put(g, "_n");
                        } else if (c && d_strcmp(c->type,"IDENTIFIER")==0 && cg_sl_index(c->value) >= 0) {
                            cg_put(g, c->value); cg_put(g, ", "); cg_put(g, c->value); cg_put(g, "_n");
                        } else if (cg_sl_islice(c)) {
                            cg_gen_expr(g, c); cg_put(g, ", "); cg_gen_expr(g, c); cg_put(g, "_n");
                        } else if (cg_is_list_node(c)) {
                            int kk = cg_lit_index(c);
                            if (kk < 0) kk = 0;
                            cg_lit_put_name(g, kk);
                            cg_put(g, ", "); cg_put_int(g, c->nchildren);
                        } else {
                            int t = cg_mask_ltype(mk, i);
