                    cg_put(g, a->value); cg_put(g, "\"");
                }
                else { cg_put(g, "itoa10("); cg_gen_expr(g, a); cg_put(g, ")"); }
            } else if ((d_strcmp(n->value,"asdict")==0 || d_strcmp(n->value,"astuple")==0) &&
