    }
    /* Parse a primary expression: name, constant, call, subscript, attribute. */
    static IRNode* parse_primary(PyParser* p) {
        Token* t = pk(p);
        /* `lambda args: expr` in an expression/argument position, e.g.
         * `list(map(lambda x: x * 2, [1, 2, 3]))`. The assignment form
         * (`f = lambda ...`) never reaches here — the statement parser
         * desugars it into a def. */
        if (t->kind == TOK_KEYWORD && d_strcmp(t->text,"lambda") == 0) {
            advance(p);
            IRNode* lam = ir_new("LAMBDA","","ANY");
            IRNode* params = ir_new("BLOCK","LPARAMS","ANY");
            ir_add_child(lam, params);
            while (pk(p)->kind == TOK_NAME) {
                IRNode* pd = ir_new("PARAM_DECL", pk(p)->text, "ANY");
                ir_add_child(params, pd);
                advance(p);
                if (pk(p)->kind == TOK_EQ) {
                    /* Keep the default.  `lambda x=i: x` binds `i` when the
                     * lambda object is created, so the lifting pass has to
                     * see the expression to snapshot it into the closure. */
                    advance(p);
                    IRNode* dv = parse_expr(p);
                    if (dv) ir_add_child(pd, dv);
                }
                if (pk(p)->kind == TOK_COMMA) { advance(p); continue; }
                break;
            }
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* body = parse_expr(p);
            if (body) ir_add_child(lam, body);
            return lam;
        }
        if ((t->kind == TOK_NAME || t->kind == TOK_KEYWORD) && !is_kw(p,"not")) {
            char name[128]; d_strncpy(name, t->text, 127); name[127]='\0';
            advance(p);
            /* True/False/None constants */
            if (d_strcmp(name,"True")==0) return ir_new("CONSTANT","1","BOOL");
            if (d_strcmp(name,"False")==0) return ir_new("CONSTANT","0","BOOL");
            if (d_strcmp(name,"None")==0) return ir_new("CONSTANT","None","VOID");
            IRNode* node = ir_new("IDENTIFIER", name, "ANY");
            return parse_postfix(p, node);
        }
        if (t->kind == TOK_NUMBER) {
            char num[64]; d_strncpy(num, t->text, 63); num[63]='\0';
            advance(p);
            /* `1e-05` / `1E+20` have no dot but are floats, not ints */
            const char* dt = (d_strchr(num,'.') || d_strchr(num,'e') || d_strchr(num,'E')) ? "FLOAT" : "INT";
            return parse_postfix(p, ir_new("CONSTANT", num, dt));
        }
        if (t->kind == TOK_STRING) {
            /* `big` holds the whole literal for anything over the inline 256
             * bytes; copying it through a 4 KB stack buffer silently cut long
             * literals (the runtime prelude is 33 KB) down to 4095 chars, so
             * the IR carried a truncated program.  Use the heap text directly. */
            const char* s = t->big ? t->big : t->text;
            int is_f = t->is_fstring;
            advance(p);
            return parse_postfix(p, ir_new("CONSTANT", s, is_f ? "FSTR" : "STR"));
        }
        if (t->kind == TOK_LPAREN) {
            advance(p);
            if (pk(p)->kind == TOK_RPAREN) {
                advance(p);
                return parse_postfix(p, ir_new("BLOCK", "TUPLE", "ANY"));
            }
            IRNode* e = parse_expr(p);
            /* `(EXPR for ...)` -- a GENERATOR EXPRESSION.  Without this case the
             * element parsed and the `for` clause was left unconsumed, so
             * `list(x * 2 for x in range(5))` collapsed to `(x * 2)` and
             * produced an empty list (20_advanced check 3). */
            if (is_kw(p,"for") || is_kw(p,"if")) {
                IRNode* comp = py_comp_new(e, p);
                if (pk(p)->kind == TOK_RPAREN) advance(p);
                return parse_postfix(p, comp);
            }
            /* `(...)` around a comma list is a tuple literal */
            if (pk(p)->kind == TOK_COMMA) {
                IRNode* tup = ir_new("BLOCK", "TUPLE", "ANY");
                if (e) ir_add_child(tup, e);
                while (pk(p)->kind == TOK_COMMA) {
                    advance(p);
                    if (pk(p)->kind == TOK_RPAREN) break;
                    IRNode* x = parse_expr(p);
                    if (x) ir_add_child(tup, x);
                }
                if (pk(p)->kind == TOK_RPAREN) advance(p);
                return parse_postfix(p, tup);
            }
            if (pk(p)->kind == TOK_RPAREN) advance(p);
            return parse_postfix(p, e);
        }
        if (t->kind == TOK_LBRACK) {
            advance(p);
            IRNode* list = ir_new("BLOCK", "LIST", "ANY");
            while (pk(p)->kind != TOK_RBRACK && pk(p)->kind != TOK_EOF) {
                IRNode* e = parse_expr(p);
                /* `[EXPR for ...]` / `[EXPR if ...]` is a comprehension, not a
                 * literal: hand it to the COMPLIST path (see py_comp_new). */
                if (is_kw(p,"for") || is_kw(p,"if")) {
                    IRNode* comp = py_comp_new(e, p);
                    if (pk(p)->kind == TOK_RBRACK) advance(p);
                    return parse_postfix(p, comp);
                }
                if (e) ir_add_child(list, e);
                if (pk(p)->kind == TOK_COMMA) advance(p);
                else break;
            }
            if (pk(p)->kind == TOK_RBRACK) advance(p);
            return parse_postfix(p, list);
        }
        if (t->kind == TOK_LBRACE) {
            advance(p);
            if (pk(p)->kind == TOK_RBRACE) {
                advance(p);
                return parse_postfix(p, ir_new("BLOCK", "DICT", "ANY"));
            }
            IRNode* first = parse_expr(p);
            if (pk(p)->kind == TOK_COLON) {
                advance(p);
                IRNode* dict_node = ir_new("BLOCK", "DICT", "ANY");
                IRNode* v = parse_expr(p);
                if (is_kw(p,"for")) {
                    /* `{k: v for ...}` — a dict COMPREHENSION built into a real
                     * dictionary (the literal above would leave the clause
                     * unconsumed and index garbage) */
                    IRNode* comp = py_comp_clause(v, first, p, 1);
                    if (pk(p)->kind == TOK_RBRACE) advance(p);
                    return parse_postfix(p, comp);
                }
                if (first && v) { ir_add_child(dict_node, first); ir_add_child(dict_node, v); }
                while (pk(p)->kind == TOK_COMMA) {
                    advance(p);
                    if (pk(p)->kind == TOK_RBRACE) break;
                    IRNode* k = parse_expr(p);
                    if (pk(p)->kind == TOK_COLON) advance(p);
                    IRNode* v2 = parse_expr(p);
                    if (k && v2) { ir_add_child(dict_node, k); ir_add_child(dict_node, v2); }
                }
                if (pk(p)->kind == TOK_RBRACE) advance(p);
                return parse_postfix(p, dict_node);
            } else {
                IRNode* set_node = ir_new("BLOCK", "SET", "ANY");
                if (first) ir_add_child(set_node, first);
                while (pk(p)->kind == TOK_COMMA) {
                    advance(p);
                    if (pk(p)->kind == TOK_RBRACE) break;
                    IRNode* item = parse_expr(p);
                    if (item) ir_add_child(set_node, item);
                }
                if (pk(p)->kind == TOK_RBRACE) advance(p);
                return parse_postfix(p, set_node);
            }
        }
        /* unary minus/plus/not/address-of/dereference */
        if (is_op(p,"-")||is_op(p,"+")||is_op(p,"&")||is_op(p,"*")||is_op(p,"~")||is_kw(p,"not")) {
            char op[8]; d_strncpy(op, pk(p)->text, 7); op[7]='\0';
            advance(p);
            IRNode* u = ir_new("UNARY_OP", op, "ANY");
            IRNode* e = parse_primary(p);
            if (e) ir_add_child(u, e);
            return u;
        }
        return NULL;
    }
    /* power binds tighter than `*` and is right associative */
    static IRNode* parse_pow(PyParser* p) {
        IRNode* left = parse_primary(p);
        if (!left) return NULL;
        Token* t = pk(p);
        if (t->kind == TOK_OP && d_strcmp(t->text,"**")==0) {
            advance(p);
            IRNode* right = parse_pow(p);
            if (!right) return left;
            IRNode* b = ir_new("BINARY_OP", "**", "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            return b;
        }
        return left;
    }
    static IRNode* parse_mul_div(PyParser* p) {
        IRNode* left = parse_pow(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP) {
                if (d_strcmp(t->text,"*")==0||d_strcmp(t->text,"/")==0||d_strcmp(t->text,"%")==0||
                    d_strcmp(t->text,"//")==0) {
                    op = t->text;
                }
            }
            if (!op) break;
            advance(p);
            IRNode* right = parse_pow(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_add_sub(PyParser* p) {
        IRNode* left = parse_mul_div(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP) {
                if (d_strcmp(t->text,"+")==0||d_strcmp(t->text,"-")==0) {
                    op = t->text;
                }
            }
            if (!op) break;
            advance(p);
            IRNode* right = parse_mul_div(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_shift(PyParser* p) {
        IRNode* left = parse_add_sub(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP) {
                if (d_strcmp(t->text,"<<")==0||d_strcmp(t->text,">>")==0) {
                    op = t->text;
                }
            }
            if (!op) break;
            advance(p);
            IRNode* right = parse_add_sub(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_bitwise_and(PyParser* p) {
        IRNode* left = parse_shift(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP && d_strcmp(t->text,"&")==0) op = t->text;
            if (!op) break;
            advance(p);
            IRNode* right = parse_shift(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_bitwise_xor(PyParser* p) {
        IRNode* left = parse_bitwise_and(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP && d_strcmp(t->text,"^")==0) op = t->text;
            if (!op) break;
            advance(p);
            IRNode* right = parse_bitwise_and(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_bitwise_or(PyParser* p) {
        IRNode* left = parse_bitwise_xor(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP && d_strcmp(t->text,"|")==0) op = t->text;
            if (!op) break;
            advance(p);
            IRNode* right = parse_bitwise_xor(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_comparison(PyParser* p) {
        IRNode* left = parse_bitwise_or(p);
        if (!left) return NULL;
        int chained = 0;
        IRNode* prev = left;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_OP) {
                if (d_strcmp(t->text,"==")==0||d_strcmp(t->text,"!=")==0||d_strcmp(t->text,"<")==0||
                    d_strcmp(t->text,"<=")==0||d_strcmp(t->text,">")==0||d_strcmp(t->text,">=")==0) {
                    op = t->text;
                }
            } else if (t->kind == TOK_KEYWORD) {
                if (d_strcmp(t->text,"in")==0) {
                    op = "in";
                } else if (d_strcmp(t->text,"is")==0) {
                    /* `is` / `is not` stay DISTINCT so the emitter applies
                     * python identity for lists/dicts and falls back to
                     * equality for scalars (see cg_gen_expr's BINARY_OP). */
                    if (pk2(p) && pk2(p)->kind == TOK_KEYWORD && d_strcmp(pk2(p)->text,"not")==0) {
                        advance(p);
                        op = "is not";
                    } else {
                        op = "is";
                    }
                } else if (d_strcmp(t->text,"not")==0 && pk2(p) &&
                           pk2(p)->kind == TOK_KEYWORD && d_strcmp(pk2(p)->text,"in")==0) {
                    /* `not in` is one comparison operator */
                    advance(p);
                    op = "not in";
                }
            }
            if (!op) break;
            advance(p);
            IRNode* right = parse_bitwise_or(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, chained ? prev : left);
            ir_add_child(b, right);
            /* CHAINED comparison: `a < b > c` means `(a < b) and (b > c)` in
             * python, NOT `((a < b) > c)`.  Folding left-associatively made
             * `1 < 3 > 2` false.  `left` becomes the conjunction while `prev`
             * carries the operand the NEXT comparison starts from. */
            if (chained) {
                IRNode* an = ir_new("BINARY_OP", "and", "ANY");
                ir_add_child(an, left);
                ir_add_child(an, b);
                left = an;
            } else {
                left = b;
                chained = 1;
            }
            prev = right;
        }
        return left;
    }
    static IRNode* parse_and(PyParser* p) {
        IRNode* left = parse_comparison(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_KEYWORD && d_strcmp(t->text,"and")==0) op = t->text;
            if (!op) break;
            advance(p);
            IRNode* right = parse_comparison(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    /* `not` binds tighter than `and`/`or` but looser than a comparison, so it
     * gets its own level: `not a == b` must read as `not (a == b)`. */
    static IRNode* parse_not(PyParser* p) {
        if (is_kw(p,"not")) {
            Token* t2 = pk2(p);
            /* `a not in b` is a comparison operator, not a unary not */
            if (t2 && t2->kind == TOK_KEYWORD && d_strcmp(t2->text,"in")==0) return parse_and(p);
            advance(p);
            IRNode* e = parse_not(p);
            IRNode* u = ir_new("UNARY_OP", "not", "ANY");
            if (e) ir_add_child(u, e);
            return u;
        }
        return parse_and(p);
    }
    static IRNode* parse_or(PyParser* p) {
        IRNode* left = parse_not(p);
        if (!left) return NULL;
        for (;;) {
            Token* t = pk(p);
            const char* op = NULL;
            if (t->kind == TOK_KEYWORD && d_strcmp(t->text,"or")==0) op = t->text;
            if (!op) break;
            advance(p);
            IRNode* right = parse_not(p);
            if (!right) break;
            IRNode* b = ir_new("BINARY_OP", op, "ANY");
            ir_add_child(b, left);
            ir_add_child(b, right);
            left = b;
        }
        return left;
    }
    static IRNode* parse_binop(PyParser* p) {
        return parse_or(p);
    }
    static IRNode* parse_ternary(PyParser* p) {
        IRNode* a = parse_binop(p);
        /* Walrus `(name := expr)`: the TARGET is the name on the LEFT of `:=`
         * and the value is on the right.  The old code passed them the wrong way
         * round AND never consumed the parentheses, so `(n := 10) > 5` emitted
         * `if (n) { ; } ; 10; ;` with `n` unresolved. */
        if (a && pk(p)->kind == TOK_OP && d_strcmp(pk(p)->text, ":=") == 0) {
            advance(p);
            /* the walrus VALUE can itself be a ternary
             * (`(v := a if c else b)`), so parse at ternary level */
            IRNode* rhs = parse_ternary(p);
            IRNode* tgt = a;
            /* accept a postfix-wrapped target (`x[0] := ...` is not python, but
             * `f()` / attribute forms must not silently drop the assignment).
             * Only a plain non-assignable node is rejected. */
            if (tgt && d_strcmp(tgt->type,"IDENTIFIER")!=0 &&
                d_strcmp(tgt->type,"ARRAY_ACCESS")!=0) return a;
            IRNode* assign = ir_new("ASSIGN", "=", "ANY");
            ir_add_child(assign, tgt);
            ir_add_child(assign, rhs);
            /* Do NOT consume a `)` here: the closer belongs to whichever
             * construct opened the paren (`parse_primary`'s LPAREN branch, or a
             * `while (...)` header).  Consuming it swallowed the while's paren
             * and orphaned the `!= 0` comparison. */
            return assign;
        }
        if (a && is_kw(p,"if")) {
            int save = p->ts->pos;
            advance(p);
            IRNode* cond = parse_binop(p);
            if (is_kw(p,"else")) {
                advance(p);
                IRNode* b = parse_ternary(p);
                IRNode* t = ir_new("IFEXP", "", "ANY");
                if (cond) ir_add_child(t, cond);
                if (a) ir_add_child(t, a);
                if (b) ir_add_child(t, b);
                return t;
            }
            /* no `else`: not a ternary after all (comprehension filter
             * `[x for x in y if c]` reaches parse_expr) — rewind */
            p->ts->pos = save;
        }
        return a;
    }
    static IRNode* parse_expr(PyParser* p) { return parse_ternary(p); }
    /* ── structural-pattern capture ──────────────────────────────────────────
     * `case (x, 0):` is a match *and* a binding: the arm has to run whenever the
     * sequence has that shape, with `x` bound to the first element.  The match
     * lowering compares `mval` against the pattern element-wise, so a bare name
     * in a pattern position came out as an undeclared `point[0] == x`
     * (36_match check 8 segfaulted on exactly that).  A name element is
     * rewritten to the very element it matches (`point[0] == point[0]`, i.e. a
     * shape-only test, `_` semantics) and an assignment binding the name to
     * that element is put at the front of the arm's body. */
    static int py_pat_plain_name(const IRNode* el) {
        if (!el || d_strcmp(el->type,"IDENTIFIER") != 0) return 0;
        const char* v = el->value;
        if (!v || !v[0] || d_strcmp(v,"_") == 0) return 0;
        /* None/True/False are values, not captures */
        if (d_strcmp(v,"None") == 0 || d_strcmp(v,"True") == 0 ||
            d_strcmp(v,"False") == 0) return 0;
        return 1;
    }
    static void py_body_prepend(IRNode* body, IRNode* st) {
        if (!body || !st || body->nchildren >= IR_MAX_CHILDREN) return;
        int z = body->nchildren;
        while (z > 0) { body->children[z] = body->children[z-1]; z--; }
        body->children[0] = st;
        body->nchildren = body->nchildren + 1;
    }
    static void py_pat_bind(IRNode* el, const IRNode* mval, int idx,
                            IRNode* body) {
        IRNode* lhs = ir_new("IDENTIFIER", el->value, "ANY");
        IRNode* rhs = NULL;
        if (idx < 0) {
            /* `case n:` binds the whole subject */
            rhs = ir_clone((IRNode*)mval);
        } else {
            IRNode* acc = ir_new("ARRAY_ACCESS", "", "ANY");
            ir_add_child(acc, ir_clone((IRNode*)mval));
            char b[16];
            int v = idx, z = 0, k = 0;
            char d[16];
            if (v == 0) { b[z] = '0'; z++; }
            while (v > 0) { b[z] = (char)('0' + v % 10); z++; v = v / 10; }
            while (z > 0) { z--; d[k] = b[z]; k++; }
            d[k] = 0;
            ir_add_child(acc, ir_new("CONSTANT", d, "INT"));
            rhs = acc;
        }
        IRNode* asg = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(asg, lhs);
        ir_add_child(asg, rhs);
        py_body_prepend(body, asg);
    }
    static void py_pat_bind_rhs(const char* name, IRNode* rhs, IRNode* body) {
        IRNode* asg = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(asg, ir_new("IDENTIFIER", name, "ANY"));
        ir_add_child(asg, rhs);
        py_body_prepend(body, asg);
    }
    /* `case Point(x=0, y=0):` -- a class pattern.  The CALL pattern was
     * compared as a plain value, so the emitter took its "constructor in
     * expression position" fallback and every arm tested `p == ((void*)1)`
     * (36_match check 11).  Lower it to per-attribute tests on the subject and
     * bind the captured names, exactly like a sequence pattern does.  Returns
     * the arm condition, or NULL when `pat` is not a class pattern. */
    static IRNode* py_pat_class_cond(IRNode* pat, const IRNode* mval,
                                     IRNode* body) {
        if (!pat || d_strcmp(pat->type,"CALL") != 0) return NULL;
        const char* cn = pat->value;
        if (!cn || !cn[0]) return NULL;
        /* `case int():` / `case str():` are type tests, not class patterns */
        if (d_strcmp(cn,"int")==0 || d_strcmp(cn,"str")==0 ||
            d_strcmp(cn,"float")==0 || d_strcmp(cn,"list")==0 ||
            d_strcmp(cn,"tuple")==0 || d_strcmp(cn,"dict")==0 ||
            d_strcmp(cn,"bool")==0 || d_strcmp(cn,"set")==0 ||
            d_strcmp(cn,"bytes")==0) return NULL;
        if (pat->nchildren == 0) return NULL;
        /* only the keyword form is lowered; `Point(0, 0)` would need the
         * class' `__match_args__` and is left alone */
        int i = 0;
        while (i < pat->nchildren) {
            if (!pat->children[i] || d_strcmp(pat->children[i]->type,"KWARG") != 0)
                return NULL;
            i++;
        }
        IRNode* cond = NULL;
        i = 0;
        while (i < pat->nchildren) {
            IRNode* kw = pat->children[i];
            IRNode* ma = ir_new("MEMBER_ACCESS", kw->value, ".");
            ir_add_child(ma, ir_clone((IRNode*)mval));
            const IRNode* pv = kw->nchildren > 0 ? kw->children[0] : NULL;
            if (py_pat_plain_name(pv)) {
                /* `Point(x=n)` captures the attribute; a name matches any value */
                py_pat_bind_rhs(pv->value, ma, body);
            } else {
                IRNode* t = ir_new("BINARY_OP", "==", "BOOL");
                ir_add_child(t, ma);
                ir_add_child(t, ir_clone((IRNode*)pv));
                if (!cond) cond = t;
                else {
                    IRNode* an = ir_new("BINARY_OP", "and", "ANY");
                    ir_add_child(an, cond);
                    ir_add_child(an, t);
                    cond = an;
                }
            }
            i++;
        }
        /* all attributes captured: the pattern accepts any instance */
        if (!cond) {
            cond = ir_new("BINARY_OP", "==", "BOOL");
            ir_add_child(cond, ir_clone((IRNode*)mval));
            ir_add_child(cond, ir_clone((IRNode*)mval));
        }
        return cond;
    }
    /* `mval[idx]` as an ARRAY_ACCESS node with an integer-constant index. */
    static IRNode* py_pat_elem_node(const IRNode* mval, int idx) {
        IRNode* acc = ir_new("ARRAY_ACCESS", "", "ANY");
        ir_add_child(acc, ir_clone((IRNode*)mval));
        char b[16];
        int v = idx, z = 0, k = 0;
        char d[16];
        if (v == 0) { b[z] = '0'; z++; }
        while (v > 0) { b[z] = (char)('0' + v % 10); z++; v = v / 10; }
        while (z > 0) { z--; d[k] = b[z]; k++; }
        d[k] = 0;
        ir_add_child(acc, ir_new("CONSTANT", d, "INT"));
        return acc;
    }
    /* Set by `py_pat_capture` when a `case [x, *rest]:` arm needed its own
     * condition (the generic equality cannot express a variadic pattern). */
    static IRNode* py_pat_star_cond;
    /* Rewrite `pat` in place: name elements become the matched element itself
     * (shape test) plus a binding into `body`.  Returns 1 if a bare-name
     * pattern made the whole arm unconditional (a capture matches anything). */
    static int py_pat_capture(IRNode* pat, const IRNode* mval, IRNode* body) {
        if (!pat) return 0;
        int is_seq = (d_strcmp(pat->type,"BLOCK")==0 &&
                      (d_strcmp(pat->value,"TUPLE")==0 || d_strcmp(pat->value,"LIST")==0));
        if (is_seq) {
            /* `case [first, *rest]:` -- the star element matches the TAIL of the
             * sequence.  The generic equality compared the element at the
             * star's index against the pattern text itself (`lst[1] == (* rest)`
             * -- an unresolved symbol) and also demanded the sequence be
             * exactly as long as the pattern, so `[1, 2, 3]` never matched it
             * (36_match checks 20-21).  Match `len >= fixed_count` and bind the
             * star name to the tail slice instead. */
            int star_i = -1;
            int si = 0;
            if (d_strcmp(pat->value,"LIST")==0 && mval &&
                d_strcmp(mval->type,"IDENTIFIER")==0) {
                while (si < pat->nchildren) {
                    const IRNode* sel = pat->children[si];
                    if (sel && d_strcmp(sel->type,"UNARY_OP")==0 && sel->value &&
                        d_strcmp(sel->value,"*")==0 && sel->nchildren>0 &&
                        sel->children[0] &&
                        d_strcmp(sel->children[0]->type,"IDENTIFIER")==0) {
                        star_i = si;
                        break;
                    }
                    si++;
                }
            }
            if (star_i >= 0) {
                char nb[16];
                cg_cfi_itoa(star_i, nb);
                /* the arm condition: at least the fixed elements are present */
                IRNode* cnd = ir_new("BINARY_OP", ">=", "BOOL");
                char cn[80];
                int cl = 0;
                while (mval->value[cl] && cl < 62) { cn[cl] = mval->value[cl]; cl++; }
                cn[cl] = '_'; cl++;
                cn[cl] = 'n'; cl++;
                cn[cl] = 0;
                ir_add_child(cnd, ir_new("IDENTIFIER", cn, "INT"));
                ir_add_child(cnd, ir_new("CONSTANT", nb, "INT"));
                /* literal elements of the pattern still have to match */
                si = 0;
                while (si < pat->nchildren) {
                    IRNode* el = pat->children[si];
                    if (si != star_i && el && !py_pat_plain_name(el)) {
                        IRNode* eq = ir_new("BINARY_OP", "==", "BOOL");
                        ir_add_child(eq, py_pat_elem_node(mval, si));
                        ir_add_child(eq, ir_clone(el));
                        IRNode* an = ir_new("BINARY_OP", "and", "ANY");
                        ir_add_child(an, cnd);
                        ir_add_child(an, eq);
                        cnd = an;
                    }
                    si++;
                }
                /* bindings: the fixed names, then the tail slice */
                si = 0;
                while (si < pat->nchildren) {
                    if (si != star_i && py_pat_plain_name(pat->children[si]))
                        py_pat_bind(pat->children[si], mval, si, body);
                    si++;
                }
                IRNode* sl = ir_new("SLICE", "", "STR");
                ir_add_child(sl, ir_clone((IRNode*)mval));
                ir_add_child(sl, ir_new("CONSTANT", nb, "INT"));
                ir_add_child(sl, ir_new("CONSTANT", "2147483647", "INT"));
                py_pat_bind_rhs(pat->children[star_i]->children[0]->value, sl, body);
                py_pat_star_cond = cnd;
                return 0;
            }
            int i = 0;
            while (i < pat->nchildren) {
                IRNode* el = pat->children[i];
                if (py_pat_plain_name(el)) {
                    py_pat_bind(el, mval, i, body);
                    /* the comparison itself becomes `mval[i] == mval[i]`, i.e.
                     * a shape-only test; the binding is what carries the value */
                    IRNode* acc = ir_new("ARRAY_ACCESS", "", "ANY");
                    ir_add_child(acc, ir_clone((IRNode*)mval));
                    char b[16];
                    int v = i, z = 0, k = 0;
                    char d[16];
                    if (v == 0) { b[z] = '0'; z++; }
                    while (v > 0) { b[z] = (char)('0' + v % 10); z++; v = v / 10; }
                    while (z > 0) { z--; d[k] = b[z]; k++; }
                    d[k] = 0;
                    ir_add_child(acc, ir_new("CONSTANT", d, "INT"));
                    pat->children[i] = acc;
                }
                i++;
            }
            return 0;
        }
        if (py_pat_plain_name(pat)) {
            py_pat_bind(pat, mval, -1, body);
            return 1;
        }
        return 0;
    }
    /* `case int():` -- a builtin TYPE pattern (`int()`, `str()`, `float()`,
     * `list()`, ...).  `py_pat_class_cond` deliberately rejects these, so the
     * generic path emitted `x == py_int()` (an undefined symbol -> the arm
     * TRAPPED) or, for a string subject, `drygon_streq(x, str())`.  The
     * emitter already lowers `type(x)` to a small integer tag per python type
     * and `== int` to the matching tag, so the pattern becomes exactly that
     * comparison and the per-argument-type function specializations evaluate it
     * statically.  Returns NULL when `a` is not a builtin type pattern. */
    static IRNode* py_pat_type_cond(IRNode* a, const IRNode* mval) {
        if (!a || d_strcmp(a->type,"CALL") != 0 || !a->value) return NULL;
        const char* cn = a->value;
        if (d_strcmp(cn,"int")!=0 && d_strcmp(cn,"str")!=0 &&
            d_strcmp(cn,"float")!=0 && d_strcmp(cn,"bool")!=0 &&
            d_strcmp(cn,"list")!=0 && d_strcmp(cn,"tuple")!=0 &&
            d_strcmp(cn,"dict")!=0 && d_strcmp(cn,"set")!=0) return NULL;
        /* `case int(0):` would need `__match_args__` on the builtin */
        if (a->nchildren != 0) return NULL;
        IRNode* tc = ir_new("CALL", "type", "ANY");
        ir_add_child(tc, ir_clone((IRNode*)mval));
        IRNode* cond = ir_new("BINARY_OP", "==", "BOOL");
        ir_add_child(cond, tc);
        ir_add_child(cond, ir_new("IDENTIFIER", cn, "ANY"));
        return cond;
    }
    /* `case int() | str():` -- an OR pattern: the arm matches when ANY of the
     * alternatives matches.  `|` parses as a BINARY_OP, so the generic path
     * compared `x == (py_int() | str())` (undefined symbols), and for literal
     * alternatives it compared against the bitwise OR of the values
     * (`case 1 | 2:` matched only 3).  Flatten the left-nested `|` spine and
     * lower each alternative on its own, joining the tests with `or`.  Returns
     * NULL when `pat` is not an or-pattern, so the caller keeps its own path. */
    static IRNode* py_pat_or_cond(IRNode* pat, const IRNode* mval, IRNode* body) {
        if (!pat || d_strcmp(pat->type,"BINARY_OP") != 0 ||
            d_strcmp(pat->value,"|") != 0) return NULL;
        IRNode* alts[32];
        int na = 0;
        IRNode* cur = pat;
        while (cur && d_strcmp(cur->type,"BINARY_OP")==0 &&
               d_strcmp(cur->value,"|")==0 && cur->nchildren == 2) {
            if (na >= 30) return NULL;
            alts[na] = cur->children[1];
            na = na + 1;
            cur = cur->children[0];
        }
        if (!cur || na >= 32) return NULL;
        alts[na] = cur;
        na = na + 1;
        IRNode* cond = NULL;
        int i = na - 1;
        while (i >= 0) {
            IRNode* a = alts[i];
            IRNode* c = py_pat_type_cond(a, mval);
            if (!c) c = py_pat_class_cond(a, mval, body);
            if (!c) {
                c = ir_new("BINARY_OP", "==", "BOOL");
                ir_add_child(c, ir_clone((IRNode*)mval));
                ir_add_child(c, ir_clone(a));
            }
            if (!cond) cond = c;
            else {
                IRNode* an = ir_new("BINARY_OP", "or", "ANY");
                ir_add_child(an, cond);
                ir_add_child(an, c);
                cond = an;
            }
            i--;
        }
        return cond;
    }
    /* `case {"key": value}:` -- a MAPPING pattern.  The dict model carries no
     * runtime type tag to test, so the subject has to be a NAME: the prepass
     * registers it as a dict (it keys on the "MAP" marker stamped here) so the
     * arm's condition lowers through the existing dict-versus-literal
     * comparison (`d_n == keys && dhas(d_k, d_n, "key") && dget(...) == ...`).
     * A captured value is replaced in the pattern by the very lookup that
     * produced it, so its comparison is a tautology -- the name is still
     * unbound while the condition runs -- and the real value is bound into the
     * arm body from the same `d["key"]` lookup. */
    static IRNode* py_pat_map_cond(IRNode* a, const IRNode* mval, IRNode* body) {
        if (!a || d_strcmp(a->type,"BLOCK") != 0 ||
            d_strcmp(a->value,"DICT") != 0) return NULL;
        if (!mval || d_strcmp(mval->type,"IDENTIFIER") != 0 || !mval->value)
            return NULL;
        d_strcpy(a->data_type, "MAP");
        int i = 0;
        while (i + 1 < a->nchildren) {
            IRNode* vp = a->children[i+1];
            if (py_pat_plain_name(vp)) {
                IRNode* gv = ir_new("ARRAY_ACCESS", "", "ANY");
                ir_add_child(gv, ir_clone((IRNode*)mval));
                ir_add_child(gv, ir_clone(a->children[i]));
                py_pat_bind_rhs(vp->value, gv, body);
                IRNode* gv2 = ir_new("ARRAY_ACCESS", "", "ANY");
                ir_add_child(gv2, ir_clone((IRNode*)mval));
                ir_add_child(gv2, ir_clone(a->children[i]));
                a->children[i+1] = gv2;
            }
            i = i + 2;
        }
        IRNode* cond = ir_new("BINARY_OP", "==", "BOOL");
        ir_add_child(cond, ir_clone((IRNode*)mval));
        ir_add_child(cond, ir_clone(a));
        return cond;
    }
    /* Parse a statement. */
    static IRNode* parse_stmt(PyParser* p) {
        Token* t = pk(p);
        /* `yield [expr]` inside a def.  Full generator semantics (resume,
         * send, close) are not modelled; the statement is recorded so the
         * emitter can accumulate the yielded values into the function's
         * result list instead of emitting a bare `yield;` (an undefined
         * symbol that trapped at runtime). */
        if (is_kw(p,"yield")) {
            advance(p);
            IRNode* y = ir_new("YIELD", "", "ANY");
            /* `yield from ITER` -- take the iterable as the operand.  The
             * statement is tagged so the emitter EXTENDS the result list with
             * the operand's elements instead of appending the operand itself
             * (60_comprehensive 2). */
            if (is_kw(p,"from")) { d_strcpy(y->data_type, "FROM"); advance(p); }
            if (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_SEMI) {
                IRNode* e = parse_expr(p);
                if (e) ir_add_child(y, e);
            }
            while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) advance(p);
            if (pk(p)->kind == TOK_NEWLINE) advance(p);
            return y;
        }
        /* decorator: @name(...) → recorded as a DECORATOR node carrying the
         * decorator's name so the class emitter can tell `@abstractmethod` and
         * `@property` apart (34_abc, 39_descriptors) */
        if (t->kind == TOK_AT) {
            advance(p);
            char dname[64]; dname[0] = '\0';
            if (pk(p)->kind == TOK_NAME || pk(p)->kind == TOK_KEYWORD) {
                d_strncpy(dname, pk(p)->text, 63); dname[63] = '\0';
                advance(p);
                /* `@value.setter` / `@value.deleter`: keep the suffix so the
                 * class emitter can tell a rebinding of a property apart from
                 * the original `@property` getter (20_advanced) */
                int dn = d_strlen(dname);
                while (pk(p)->kind == TOK_DOT && dn < 48) {
                    advance(p);
                    if (pk(p)->kind != TOK_NAME) break;
                    dname[dn] = '.'; dn++;
                    int dp = 0;
                    while (pk(p)->text[dp] && dn < 60) { dname[dn] = pk(p)->text[dp]; dn++; dp++; }
                    dname[dn] = '\0';
                    advance(p);
                }
            }
            if (py_lru_is(dname)) {
                /* lru_cache bound */
                py_lru_pending = 1;
                py_lru_pend_max = 128;
                if (pk(p)->kind == TOK_LPAREN) {
                    int depth2 = 0;
                    while (pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_NEWLINE) {
                        if (pk(p)->kind == TOK_LPAREN) depth2++;
                        if (pk(p)->kind == TOK_RPAREN) { depth2--; if (depth2 <= 0) { advance(p); break; } }
                        if (pk(p)->kind == TOK_NAME && d_strcmp(pk(p)->text,"maxsize")==0 &&
                            pk2(p)->kind == TOK_EQ) {
                            advance(p); advance(p);
                            if (pk(p)->kind == TOK_NUMBER) {
                                py_lru_pend_max = py_dec_int(pk(p)->text);
                                advance(p);
                            }
                            continue;
                        }
                        advance(p);
                    }
                    if (pk(p)->kind == TOK_RPAREN) advance(p);
                }
            }
            int dc_frozen = 0, dc_order = 0;
            {
                int _de = d_strlen(dname);
                if ((d_strcmp(dname,"dataclass")==0 ||
                     (_de>=9 && d_strcmp(dname+_de-9,"dataclass")==0)) &&
                    pk(p)->kind == TOK_LPAREN) {
                    advance(p);
                    int dd = 0;
                    while (pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_NEWLINE) {
                        if (pk(p)->kind == TOK_LPAREN || pk(p)->kind == TOK_LBRACK) dd++;
                        else if (pk(p)->kind == TOK_RPAREN || pk(p)->kind == TOK_RBRACK) {
                            if (dd == 0) { advance(p); break; }
                            dd--;
                        } else if (dd == 0 &&
                                   (pk(p)->kind == TOK_NAME || pk(p)->kind == TOK_KEYWORD) &&
                                   pk2(p)->kind == TOK_EQ) {
                            if (d_strcmp(pk(p)->text,"frozen")==0) dc_frozen = 1;
                            if (d_strcmp(pk(p)->text,"order")==0) dc_order = 1;
                        }
                        advance(p);
                    }
                }
            }
            while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) advance(p);
            {
                IRNode* dcn = ir_new("DECORATOR", dname, "ANY");
                if (dc_frozen && dc_order) d_strncpy(dcn->data_type, "FO", 63);
                else if (dc_frozen) d_strncpy(dcn->data_type, "F", 63);
                else if (dc_order) d_strncpy(dcn->data_type, "O", 63);
                return dcn;
            }
        }
        /* def name(params) -> ret_type: */
        if (is_kw(p,"def")) {
            advance(p);
            char fname[128]; d_strncpy(fname, pk(p)->text, 127); fname[127]='\0';
            advance(p);
            IRNode* fn = ir_new("FUNCTION_DEF", fname, "VOID");
            if (py_lru_pending) {
                py_lru_register(fname, py_lru_pend_max);
                py_lru_pending = 0;
                py_lru_pend_max = 0;
            }
            IRNode* params = ir_new("BLOCK", "PARAMS", "ANY");
            if (pk(p)->kind == TOK_LPAREN) {
                advance(p);
                while (pk(p)->kind != TOK_RPAREN && pk(p)->kind != TOK_EOF) {
                    if (pk(p)->kind == TOK_NAME) {
                        char pname[128]; d_strncpy(pname, pk(p)->text, 127); pname[127]='\0';
                        advance(p);
                        char ptype[64] = "ANY";
                        /* annotation : type */
                        if (pk(p)->kind == TOK_COLON) {
                            advance(p);
                            if (pk(p)->kind == TOK_NAME) {
                                d_strncpy(ptype, pk(p)->text, 63); ptype[63] = '\0';
                                advance(p);
                            }
                            int depth = 0;
                            while (pk(p)->kind != TOK_EOF) {
                                if (pk(p)->kind == TOK_LBRACK || pk(p)->kind == TOK_LPAREN) depth++;
                                else if (pk(p)->kind == TOK_RBRACK || pk(p)->kind == TOK_RPAREN) {
                                    if (depth == 0) break;
                                    depth--;
                                } else if (depth == 0 && (pk(p)->kind == TOK_COMMA || pk(p)->kind == TOK_EQ)) {
