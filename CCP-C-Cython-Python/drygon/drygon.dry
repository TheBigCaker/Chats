            /* tuple target: `a, b = 1, 2` (the value side pairs element-wise) */
            if (pk(p)->kind == TOK_COMMA) {
                IRNode* tup = ir_new("BLOCK","TUPLE","ANY");
                ir_add_child(tup, target);
                while (pk(p)->kind == TOK_COMMA) {
                    advance(p);
                    int item_star = 0;
                    if (pk(p)->kind == TOK_OP && d_strcmp(pk(p)->text, "*") == 0) {
                        advance(p);
                        item_star = 1;
                    }
                    if (pk(p)->kind != TOK_NAME) { tup = NULL; break; }
                    ir_add_child(tup, ir_new("IDENTIFIER", pk(p)->text, item_star ? "STAR" : "ANY"));
                    advance(p);
                }
                if (tup && pk(p)->kind == TOK_EQ) {
                    advance(p);
                    IRNode* vals = ir_new("BLOCK","TUPLE","ANY");
                    while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) {
                        IRNode* e = parse_expr(p);
                        if (e) ir_add_child(vals, e);
                        if (pk(p)->kind == TOK_COMMA) { advance(p); continue; }
                        break;
                    }
                    IRNode* a = ir_new("ASSIGN","=","ANY");
                    ir_add_child(a, tup);
                    ir_add_child(a, vals);
                    return a;
                }
                p->ts->pos = save;
                IRNode* e2 = parse_expr(p);
                IRNode* es2 = ir_new("EXPR_STMT","","ANY");
                if (e2) ir_add_child(es2, e2);
                return es2;
            }
            /* annotated: name: type = ... */
            char dt[64] = "ANY";
            int has_type = 0;
            int is_array = 0;
            char arr_sz[32] = "";
            if (pk(p)->kind == TOK_COLON) {
                advance(p);
                if (pk(p)->kind == TOK_NAME) {
                    d_strncpy(dt, pk(p)->text, 63); dt[63] = '\0';
                    has_type = 1;
                    advance(p);
                }
                if (pk(p)->kind == TOK_LBRACK) {
                    advance(p);
                    if (pk(p)->kind == TOK_NAME || pk(p)->kind == TOK_NUMBER) {
                        d_strncpy(arr_sz, pk(p)->text, 31); arr_sz[31] = '\0';
                        is_array = 1;
                        advance(p);
                    }
                    if (pk(p)->kind == TOK_RBRACK) advance(p);
                }
                int depth = 0;
                while (pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_NEWLINE) {
                    if (pk(p)->kind == TOK_LBRACK || pk(p)->kind == TOK_LPAREN) depth++;
                    else if (pk(p)->kind == TOK_RBRACK || pk(p)->kind == TOK_RPAREN) {
