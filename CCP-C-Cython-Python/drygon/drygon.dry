                     * below rejects, so its two substitute forms need their
                     * own arm before the generic member call (which dropped
                     * every keyword argument). */
                    if (d_strcmp(target->type,"MEMBER_ACCESS")==0 && target->nchildren>0 &&
                        (d_strcmp(target->value,"substitute")==0 ||
                         d_strcmp(target->value,"safe_substitute")==0) &&
                        target->children[0] &&
                        d_strcmp(target->children[0]->type,"IDENTIFIER")==0) {
                        const char* tpt = cg_template_node(target->children[0]->value);
                        if (tpt) {
                            cg_put(g, "drygon_template(");
                            cg_put_cstr(g, tpt);
                            int pk = 0;
                            int ci = 1;
                            while (ci < n->nchildren && pk < 3) {
                                if (n->children[ci] && d_strcmp(n->children[ci]->type,"KWARG")==0) {
                                    cg_put(g, ", ");
                                    cg_put_cstr(g, n->children[ci]->value);
                                    cg_put(g, ", ");
                                    if (n->children[ci]->nchildren > 0)
                                        cg_strify(g, n->children[ci]->children[0]);
                                    else cg_put(g, "\"\"");
                                    pk = pk + 1;
                                }
                                ci = ci + 1;
                            }
                            while (pk < 3) { cg_put(g, ", 0, 0"); pk = pk + 1; }
                            cg_put(g, ", ");
                            cg_put(g, (d_strcmp(target->value,"safe_substitute")==0) ? "1" : "0");
                            cg_put(g, ")");
                            return;
                        }
                    }
                    /* string methods lower to runtime helpers: python strings
                     * are C char* here and carry no method table. */
                    if (d_strcmp(target->type,"MEMBER_ACCESS")==0 && target->nchildren>0 &&
                        cg_is_str_node(target->children[0])) {
                        const char* m = target->value;
                        const char* h = NULL;
                        int na = 0;
                        if (d_strcmp(m,"upper")==0) { h = "drygon_upper"; na = 0; }
                        else if (d_strcmp(m,"lower")==0 || d_strcmp(m,"casefold")==0) { h = "drygon_lower"; na = 0; }
                        else if (d_strcmp(m,"strip")==0) {
                            if (n->nchildren > 1) { h = "drygon_strip_chars"; na = 1; }
                            else { h = "drygon_strip"; na = 0; }
                        }
                        else if (d_strcmp(m,"title")==0) { h = "drygon_title"; na = 0; }
                        else if (d_strcmp(m,"isdigit")==0 || d_strcmp(m,"isnumeric")==0) { h = "drygon_isdigit"; na = 0; }
                        else if (d_strcmp(m,"find")==0 || d_strcmp(m,"index")==0) {
                            int is_ix = d_strcmp(m,"index")==0;
                            if (n->nchildren > 2) { h = is_ix ? "drygon_index_from" : "drygon_find_from"; na = 2; }
                            else { h = is_ix ? "drygon_index" : "drygon_find"; na = 1; }
                        }
                        else if (d_strcmp(m,"splitlines")==0) {
                            /* `s.splitlines()` fell through to the raw member
