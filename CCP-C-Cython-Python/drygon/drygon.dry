        if (!cls || !cls[0]) return -1;
        int i = 0;
        while (i < cg_gt_n) { if (d_strcmp(cg_gt_cls[i], cls)==0) return i; i++; }
        if (cg_gt_n >= 128) return -1;
        d_strncpy(cg_gt_cls[cg_gt_n], cls, 31);
