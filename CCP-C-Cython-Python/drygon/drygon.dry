}
    static int cg_pyx_label;
    static int cg_sw_serial;
    /* non-zero while emitting a loop body that has an `else:` clause: makes
     * `break` record that it fired, so the else body can be skipped. */
    static int cg_loop_break_flag;
    static int cg_in_main;
    /* non-zero while emitting a generator body: a `raise` there must be handed
     * to the deferred `next()` path instead of firing at creation time. */
    static int cg_in_gen;
    /* serial for the per-loop iterator objects `for x in Range(5)` needs */
    static int cg_it_serial;
    /* `yield from` extension temporaries */
    static int cg_yf_serial;
    static int cg_is_class(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_cls_n) { if (d_strcmp(cg_cls_names[i], nm) == 0) return 1; i++; }
        return 0;
    }
    /* Index of the class whose method is currently being emitted, or -1.
     * Declared here (before cg_member_ftype) so every use sees the same
     * storage: a use that precedes the definition left an unresolved
     * relocation and read whatever lived at address 0. */
    static int cg_cur_cls_i = -1;
    static const char* cg_cvar_class(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_cvar_n) { if (d_strcmp(cg_cvar_names[i], nm) == 0) return cg_cvar_cls[i]; i++; }
        return 0;
    }
    /* record that `name` holds an instance of `cls`, so member reads resolve
     * to the struct's fields */
    static void cg_note_cvar(const char* name, const char* cls) {
        if (!name || !name[0] || !cls || !cls[0]) return;
        int i = 0;
        while (i < cg_cvar_n) {
            if (d_strcmp(cg_cvar_names[i], name) == 0) {
                d_strncpy(cg_cvar_cls[i], cls, 31);
                cg_cvar_cls[i][31] = 0;
                return;
            }
            i++;
        }
        if (cg_cvar_n >= 512) return;
        d_strncpy(cg_cvar_names[cg_cvar_n], name, 31);
        cg_cvar_names[cg_cvar_n][31] = 0;
        d_strncpy(cg_cvar_cls[cg_cvar_n], cls, 31);
        cg_cvar_cls[cg_cvar_n][31] = 0;
        cg_cvar_n++;
    }
    /* Inferred python type of `obj.field`: looks through the class that the
     * variable holds into the class body's `self.field = ...` assignments.
     * Returns 2 for str, 1 for float, 0 for int/unknown.  Emitting an f-string
     * interpolation or a comparison of a string attribute with the integer
     * helpers produced numbers where text was expected. */
    /* Is `field` a CLASS attribute (a bare-identifier ASSIGN in the class body)
     * rather than an instance field (`self.field = ...`)?  `a.count` where count
     * is a class attribute must read the class global: the struct has no such
     * field, so emitting `a.count` is not valid C. */
    static int cg_cls_is_class_attr(const char* cls, const char* field) {
        if (!cls || !field) return 0;
        int i = 0;
        while (i < cg_cls_n) {
            if (d_strcmp(cg_cls_names[i], cls) == 0 && cg_cls_body[i]) {
                const IRNode* b = cg_cls_body[i];
                int j = 0;
                while (j < b->nchildren) {
                    const IRNode* m = b->children[j];
                    if (m && d_strcmp(m->type,"ASSIGN")==0 && m->nchildren>0 &&
                        m->children[0] && d_strcmp(m->children[0]->type,"IDENTIFIER")==0 &&
                        d_strcmp(m->children[0]->value, field)==0) return 1;
                    j++;
                }
                return 0;
            }
            i++;
        }
        return 0;
    }
    static int cg_member_ftype(const IRNode* base, const char* field) {
        if (!base || !field) return 0;
        if (d_strcmp(base->type,"IDENTIFIER")!=0) return 0;
        /* `self.f` inside a method body is a field of the class being laid out
         * (during cg_infer_mret) or emitted (cg_cur_cls_i).  Without this the
         * field lookup never resolved, so `return self.data` came out `int`
         * and a string field printed as a decimal pointer. */
        if (d_strcmp(base->value,"self")==0) {
            if (cg_cur_cls_i >= 0 && cg_cur_cls_i < cg_cls_n)
                return cg_cls_ftype_of(cg_cls_names[cg_cur_cls_i], field, 0);
            if (cg_cls_n > 0) return cg_cls_ftype_of(cg_cls_names[cg_cls_n - 1], field, 0);
            return 0;
        }
        const char* cv = cg_cvar_class(base->value);
        if (!cv) cv = cg_is_class(base->value) ? base->value : 0;
        if (!cv) return 0;
        return cg_cls_ftype_of(cv, field, 0);
    }
    static int cg_cls_hasm(const char* cls, const char* m) {
        int ci = -1;
        int i = 0;
        while (i < cg_cls_n) { if (d_strcmp(cg_cls_names[i], cls) == 0) { ci = i; break; } i++; }
        if (ci < 0) return 0;
        int j = 0;
        while (j < cg_cls_nmeth[ci]) { if (d_strcmp(cg_cls_methnames[ci*48 + j], m) == 0) return 1; j++; }
        return 0;
    }
    /* Class that declares method `m`, without knowing the receiver's class.
     * `writer = csv.writer(output)` puts an instance of a *module function's*
     * return value in a variable; the receiver's class is only recorded while
     * the body is emitted, which is after the signature scan has run, so the
     * scan had no class to key the list parameter under and `writer.writerow`
     * kept an int-width `row` (50_csv).  Declaration order is the module
     * order, so the first class that declares the name is the module's own. */
    static const char* cg_cls_find_m_any(const char* m) {
        if (!m || !m[0]) return 0;
        int i = 0;
        while (i < cg_cls_n) {
            int j = 0;
            while (j < cg_cls_nmeth[i]) {
                if (d_strcmp(cg_cls_methnames[i*48 + j], m) == 0) return cg_cls_names[i];
                j++;
            }
            i++;
        }
        return 0;
    }
    static const char* cg_cls_find_m(const char* cls, const char* m) {
        if (!cls || !cls[0]) return 0;
        int ci = -1;
        int i = 0;
        while (i < cg_cls_n) { if (d_strcmp(cg_cls_names[i], cls) == 0) { ci = i; break; } i++; }
        if (ci < 0) return 0;
        int j = 0;
        while (j < cg_cls_nmeth[ci]) { if (d_strcmp(cg_cls_methnames[ci*48 + j], m) == 0) return cg_cls_names[ci]; j++; }
        i = 0;
        while (i < cg_cls_nab[ci]) {
            const char* br = cg_cls_find_m(cg_cls_ab + (ci*4 + i)*64, m);
            if (br) return br;
            i++;
        }
        return 0;
    }
    static const IRNode* cg_call_root(const IRNode* call) {
        if (!call) return 0;
        if (d_strcmp(call->type, "IDENTIFIER") == 0) return call;
        if (d_strcmp(call->type, "CALL") == 0) {
            if (call->nchildren == 0) return 0;
            const IRNode* ma = call->children[0];
            if (!ma || d_strcmp(ma->type, "MEMBER_ACCESS") != 0 || ma->nchildren == 0) return 0;
            return cg_call_root(ma->children[0]);
        }
        return 0;
    }
    static const char* cg_safe_fn_name(const char* name) {
        if (!name) return "";
        if (d_strcmp(name, "double") == 0) return "py_double";
        if (d_strcmp(name, "float") == 0) return "py_float";
        if (d_strcmp(name, "int") == 0) return "py_int";
        if (d_strcmp(name, "char") == 0) return "py_char";
        if (d_strcmp(name, "short") == 0) return "py_short";
        if (d_strcmp(name, "long") == 0) return "py_long";
        if (d_strcmp(name, "void") == 0) return "py_void";
        if (d_strcmp(name, "case") == 0) return "py_case";
        if (d_strcmp(name, "default") == 0) return "py_default";
        if (d_strcmp(name, "switch") == 0) return "py_switch";
        if (d_strcmp(name, "return") == 0) return "py_return";
        if (d_strcmp(name, "struct") == 0) return "py_struct";
        if (d_strcmp(name, "union") == 0) return "py_union";
        if (d_strcmp(name, "enum") == 0) return "py_enum";
        return name;
    }
    /* `self.<f> = ...` writes inside method bodies define the instance
     * fields; the type is inferred from the right-hand side */
    static void cg_cls_collect(const IRNode* nn, char* names, int* nf, int maxf) {
        if (!nn) return;
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>0 &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->nchildren>0 &&
            d_strcmp(nn->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,"self")==0) {
            const char* f = nn->children[0]->value;
            int j = 0, dup = 0;
            while (j < *nf) { if (d_strcmp(names + j*64, f) == 0) { dup = 1; break; } j++; }
            if (!dup && *nf < 32) { d_strncpy(names + (*nf)*64, f, 63); names[(*nf)*64+63] = 0; *nf = *nf + 1; }
        }
        int i = 0;
        while (i < nn->nchildren) { cg_cls_collect(nn->children[i], names, nf, maxf); i++; }
    }
    /* A struct field is emitted ONCE, however many descriptions of it the class
     * body carries: a dataclass annotates `x: int` (VAR_DECL) AND synthesises
     * `self.x = x` (cfn), so both loops emitted the member and the typedef came
     * out as `struct Point { int x; int y; int x; int y; }`.  The doubled
     * aggregate was passed by value as a garbage-sized object and every member
     * read through it was misaligned (37_dataclasses).  Returns 1 when `nm` was
     * already emitted (the caller skips it), 0 otherwise. */
    static char cg_mem_names[64*64];
    static int cg_mem_n = 0;
    static void cg_mem_reset(void) { cg_mem_n = 0; }
    static int cg_mem_seen(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_mem_n) { if (d_strcmp(cg_mem_names + i*64, nm) == 0) return 1; i++; }
        if (cg_mem_n < 64) {
            d_strncpy(cg_mem_names + cg_mem_n*64, nm, 63);
            cg_mem_names[cg_mem_n*64 + 63] = 0;
            cg_mem_n = cg_mem_n + 1;
        }
        return 0;
    }
    /* Calls whose result is always a string.  Used by the field-type
     * inference below so `self.error = str(exc_val)` makes `error` a
     * `char*` field instead of an `int` (16_exceptions check 38). */
    /* Native path/filesystem primitives (the prelude block) that return a
     * `char*`.  A call to one of these used to be typed `int`, so the result
     * was printed and compared as a number instead of as a string. */
    static int cg_native_strfn(const char* fn) {
        if (!fn) return 0;
        if (d_strcmp(fn,"drygon_fs_getcwd")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_listdir")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_glob")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_rglob")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_read")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_tempdir")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_mkdtemp")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_mkdtemp_in")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_mktemp")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_mktemp_in")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_which")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_fdread")==0) return 1;
        if (d_strcmp(fn,"drygon_fs_readlink")==0) return 1;
        if (d_strcmp(fn,"drygon_path_sub")==0) return 1;
        if (d_strcmp(fn,"drygon_path_normalize")==0) return 1;
        if (d_strcmp(fn,"drygon_path_name")==0) return 1;
        if (d_strcmp(fn,"drygon_path_parent")==0) return 1;
        if (d_strcmp(fn,"drygon_path_join")==0) return 1;
        if (d_strcmp(fn,"drygon_path_stem")==0) return 1;
        if (d_strcmp(fn,"drygon_path_suffix")==0) return 1;
        if (d_strcmp(fn,"drygon_path_seg")==0) return 1;
        if (d_strcmp(fn,"drygon_path_with_suffix")==0) return 1;
        if (d_strcmp(fn,"drygon_path_with_name")==0) return 1;
        if (d_strcmp(fn,"drygon_path_part")==0) return 1;
        return 0;
    }
    static int cg_is_str_call_node(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CALL")!=0 || !a->value) return 0;
        if (cg_native_strfn(a->value)) return 1;
        if (d_strcmp(a->value,"str")==0) return 1;
        if (d_strcmp(a->value,"repr")==0) return 1;
        if (d_strcmp(a->value,"chr")==0) return 1;
        if (d_strcmp(a->value,"oct")==0) return 1;
        if (d_strcmp(a->value,"hex")==0) return 1;
        if (d_strcmp(a->value,"format")==0) return 1;
        if (d_strcmp(a->value,"input")==0) return 1;
        if (d_strcmp(a->value,"drygon_fread")==0) return 1;
        /* `"...".join(xs)` and `"...".format(...)` */
        if (d_strcmp(a->value,"join")==0) return 1;
        /* `self._r.__next__()`: a method whose body builds a list of strings
         * hands back the shared string array, so its result is a `char*`.  The
         * method registry is filled from the source by `cg_scan_meth_shapes`
         * before any of this runs; without the rule `self.fieldnames =
         * self._r.__next__()` stayed an `int` array (50_csv). */
        if (d_strcmp(a->value,"COMPLEX")==0 && a->nchildren>0 &&
            a->children[0] && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0) {
            int sls = 0;
            if (cg_mcall_ret_list(a, &sls) && sls == 1) return 1;
        }
        return 0;
    }
    /* Defined far below, but the instance-field type inference needs it to
     * recognise a float-valued right-hand side (`self.elapsed = time.time() -
     * self.start` was an `int` field, so the elapsed seconds were truncated to
     * 0 and `hasattr(t,"elapsed")` never saw a float). */
    static int cg_is_float_node(const IRNode* a);
    /* `mode` 0 reports the FIRST assignment seen (the historical behaviour);
     * mode 1 ignores the "some other assignment to this field is an int"
     * fallback, so a `self.x = str(v)` in one method can outvote a
     * `self.x = None` in `__init__` -- the field is `char*` as soon as ANY
     * assignment stores a string (16_exceptions check 38). */
    static int cg_cls_ftype_m(const IRNode* nn, const char* f, int mode) {
        if (!nn) return 0;
        /* plain class attribute: `class Obj: name = "test"`.  The body's ASSIGN
         * has a bare IDENTIFIER target, and the value's type decides the field
         * type -- without this `f"{o.name}"` rendered the string through
         * itoa10 (a number) because the field looked like an int. */
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>0 &&
            d_strcmp(nn->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->value,f)==0) {
            const IRNode* rhs = nn->nchildren>1 ? nn->children[1] : NULL;
            if (rhs && d_strcmp(rhs->type,"CONSTANT")==0) {
                if (d_strcmp(rhs->data_type,"STR")==0 || d_strcmp(rhs->data_type,"FSTR")==0) return 2;
                if (d_strcmp(rhs->data_type,"FLOAT")==0) return 3;
            }
            if (rhs && cg_is_str_node(rhs)) return 2;
            if (rhs && cg_is_str_call_node(rhs)) return 2;
            /* a parameter carrying a string default (`def f(self, s="")`) is a
             * char* even when the call site omits the argument */
            if (rhs && d_strcmp(rhs->type,"IDENTIFIER")==0 &&
                cg_is_strdef_param(rhs->value)) return 2;
            if (rhs && cg_is_float_node(rhs)) return 3;
            return mode ? 0 : 1;
        }
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>0 &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->nchildren>0 &&
            d_strcmp(nn->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,"self")==0 &&
            d_strcmp(nn->children[0]->value,f)==0) {
            const IRNode* rhs = nn->nchildren>1 ? nn->children[1] : NULL;
            if (rhs && d_strcmp(rhs->type,"CONSTANT")==0) {
                if (d_strcmp(rhs->data_type,"STR")==0 || d_strcmp(rhs->data_type,"FSTR")==0) return 2;
                if (d_strcmp(rhs->data_type,"FLOAT")==0) return 3;
            }
            if (rhs && cg_is_str_node(rhs)) return 2;
            if (rhs && cg_is_str_call_node(rhs)) return 2;
            /* a parameter carrying a string default (`def f(self, s="")`) is a
             * char* even when the call site omits the argument */
            if (rhs && d_strcmp(rhs->type,"IDENTIFIER")==0 &&
                cg_is_strdef_param(rhs->value)) return 2;
            /* a parameter this class body feeds to a runtime string/path
             * primitive (`self.path = path` next to `drygon_fread(path)`) */
            if (rhs && d_strcmp(rhs->type,"IDENTIFIER")==0 &&
                cg_param_needs_str(nn, rhs->value)) return 2;
            if (rhs && cg_is_float_node(rhs)) return 3;
            return mode ? 0 : 1;
        }
        int i = 0;
        while (i < nn->nchildren) {
            int t = cg_cls_ftype_m(nn->children[i], f, mode);
            if (t) return t;
            i++;
        }
        return 0;
    }
    static int cg_cls_ftype(const IRNode* nn, const char* f) {
        int t = cg_cls_ftype_m(nn, f, 1);
        if (t) return t;
        return cg_cls_ftype_m(nn, f, 0);
    }
    /* The field may be declared by a BASE class body: `Circle` only assigns
     * `self.radius`, so `c.name` (used by `describe`) had no type at all and
     * the comparison ran as a pointer compare (12_classes checks 13/14). */
        static char cg_cf_stack[16][64];
    static int  cg_cf_top;
static int cg_cls_ftype_of(const char* cls, const char* field, int depth) {
        if (!cls || !cls[0] || depth > 4) return 0;
        /* Re-entrancy guard: inferring `self.f` walks the class body, which can
         * ask about `f` again (`self.f = self.f + s`).  Only the depth-0 entry
         * (the one a field lookup starts) pushes, so the base-class walk --
         * which passes depth+1 -- still sees the field's type.  The fields
         * currently in flight have to be remembered as a STACK: `self.pos =
         * self.data` asks about `data` while `pos` is still being inferred, and
         * a single slot was overwritten by that inner query, so the cycle
         * `pos -> data -> pos -> data ...` never terminated and ran the
         * compiler out of stack. */
        int _cfpushed = 0;
        if (depth == 0) {
            int _cfk = 0;
            while (_cfk < cg_cf_top) {
                if (d_strcmp(cg_cf_stack[_cfk], field) == 0) return 0;
                _cfk++;
            }
            if (cg_cf_top >= 16) return 0;
            d_strncpy(cg_cf_stack[cg_cf_top], field, 63);
            cg_cf_stack[cg_cf_top][63] = 0;
            cg_cf_top = cg_cf_top + 1;
            _cfpushed = 1;
        }
        int _cfres = 0;
        int i = 0;
        while (i < cg_cls_n) {
            if (d_strcmp(cg_cls_names[i], cls) == 0) {
                if (cg_cls_body[i]) {
                    int ft = cg_cls_ftype(cg_cls_body[i], field);
                    if (ft) { _cfres = ft; break; }
                }
                int bk = 0;
                while (bk < cg_cls_nab[i]) {
                    int bf = cg_cls_ftype_of(cg_cls_ab + (i*4 + bk)*64, field, depth + 1);
                    if (bf) { _cfres = bf; break; }
                    bk++;
                }
                /* an attribute created OUTSIDE the class body: `o.f = 1` at
                 * module scope or `setattr(o,"f",1)` */
                if (!_cfres) _cfres = cg_if_field_ftype(cls, field);
                break;
            }
            i++;
        }
        if (depth == 0 && _cfpushed) cg_cf_top = cg_cf_top - 1;
        return _cfres;
    }
    /* ── attributes declared outside the class body ───────────────────────     * `o.name = "test"` on a module-level instance -- and `setattr(o,"f",v)` --
     * creates an attribute exactly as `self.name = ...` inside a method does,
     * but no class body ever sees the assignment.  The struct emission and the
     * hasattr/getattr/setattr lowerings need their own table for those
     * (12_classes checks 45-48). */
    static char cg_if_vname[16384];
    static char cg_if_vcls[16384];
    static int cg_if_vn;
    static char cg_if_fcls[32768];
    static char cg_if_fname[32768];
    static int cg_if_ftype[512];
    static int cg_if_fn;
    static void cg_if_note_var(const char* nv, const char* cls) {
        if (!nv || !nv[0] || !cls || !cls[0]) return;
        int i = 0;
        while (i < cg_if_vn) {
            if (d_strcmp(cg_if_vname + i*64, nv) == 0) {
                d_strncpy(cg_if_vcls + i*64, cls, 63); cg_if_vcls[i*64 + 63] = 0;
                return;
            }
            i++;
        }
        if (cg_if_vn < 256) {
            d_strncpy(cg_if_vname + cg_if_vn*64, nv, 63); cg_if_vname[cg_if_vn*64 + 63] = 0;
            d_strncpy(cg_if_vcls + cg_if_vn*64, cls, 63); cg_if_vcls[cg_if_vn*64 + 63] = 0;
            cg_if_vn = cg_if_vn + 1;
        }
    }
    static const char* cg_if_var_cls(const char* nv) {
        if (!nv || !nv[0]) return 0;
        int i = 0;
        while (i < cg_if_vn) {
            if (d_strcmp(cg_if_vname + i*64, nv) == 0) return cg_if_vcls + i*64;
            i++;
        }
        return 0;
    }
    static void cg_if_note_field(const char* cls, const char* f, int ft) {
        if (!cls || !cls[0] || !f || !f[0]) return;
        int i = 0;
        while (i < cg_if_fn) {
            if (d_strcmp(cg_if_fcls + i*64, cls) == 0 && d_strcmp(cg_if_fname + i*64, f) == 0) {
                if (ft) cg_if_ftype[i] = ft;
                return;
            }
            i++;
        }
        if (cg_if_fn < 512) {
            d_strncpy(cg_if_fcls + cg_if_fn*64, cls, 63); cg_if_fcls[cg_if_fn*64 + 63] = 0;
            d_strncpy(cg_if_fname + cg_if_fn*64, f, 63); cg_if_fname[cg_if_fn*64 + 63] = 0;
            cg_if_ftype[cg_if_fn] = ft;
            cg_if_fn = cg_if_fn + 1;
        }
    }
    static int cg_if_field_ftype(const char* cls, const char* f) {
        if (!cls || !f) return 0;
        int i = 0;
        while (i < cg_if_fn) {
            if (d_strcmp(cg_if_fcls + i*64, cls) == 0 && d_strcmp(cg_if_fname + i*64, f) == 0)
                return cg_if_ftype[i];
            i++;
        }
        return 0;
    }
    /* the attribute names in dir/getattr/setattr are string LITERALS and the
     * IR keeps them quoted; the field tables want the bare text */
    static void cg_strlit_copy(const char* s, char* out, int max) {
        if (!out || max < 2) return;
        out[0] = 0;
        if (!s) return;
        int i = 0;
        if (s[0]=='"' || s[0]=='\'') i = 1;
        int k = 0;
        while (s[i] && s[i] != '"' && s[i] != '\'' && k < max-1) { out[k] = s[i]; i++; k++; }
        out[k] = 0;
    }
    /* the class an attribute receiver belongs to: `o` (an instance) or `Obj` */
    static const char* cg_dir_cls_of(const IRNode* rc) {
        if (!rc || d_strcmp(rc->type,"IDENTIFIER")!=0) return 0;
        const char* c = cg_if_var_cls(rc->value);
        if (!c) c = cg_cvar_class(rc->value);
        if (!c && cg_is_class(rc->value)) c = rc->value;
        return c;
    }
    static int cg_if_cls_has_field(const char* cls, const char* f);
    static void cg_if_scan(const IRNode* a);
    static void cg_dir_reg(const IRNode* a);
    static void cg_dir_fill(const char* cls, char* out, int* n, int max, int depth);
    static void cg_scan_twod_names(const IRNode* n);
    /* The scan runs BEFORE any CLASS_DEF is emitted, so the main class registry
     * (filled during emission) is still empty: collect the declared names here
     * so `x = Cls()` can be recognised as an instantiation. */
    static char cg_if_cnames[8192];
    static int cg_if_cn;
    static void cg_if_clsreg(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->value && a->value[0]) {
            int i = 0;
            int dup = 0;
            while (i < cg_if_cn) { if (d_strcmp(cg_if_cnames + i*32, a->value)==0) { dup = 1; break; } i++; }
            if (!dup && cg_if_cn < 256) {
                d_strncpy(cg_if_cnames + cg_if_cn*32, a->value, 31);
                cg_if_cnames[cg_if_cn*32 + 31] = 0;
                cg_if_cn = cg_if_cn + 1;
            }
        }
        int j = 0;
        while (j < a->nchildren) { cg_if_clsreg(a->children[j]); j++; }
    }
    static int cg_if_is_cls(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_if_cn) { if (d_strcmp(cg_if_cnames + i*32, nm)==0) return 1; i++; }
        return cg_is_class(nm);
    }
    static int cg_is_list_node(const IRNode* a);
    static int cg_is_dyn_list(const char* nm);
    static int cg_fn_is_list(const char* name);
    static int cg_list_size(const char* name);
    static const char* cg_curp_cls_of(const char* nm);
    static int cg_lf_method(const char* m) {
        if (!m) return 0;
        return d_strcmp(m,"append")==0 || d_strcmp(m,"extend")==0 ||
               d_strcmp(m,"clear")==0 || d_strcmp(m,"pop")==0 ||
               d_strcmp(m,"insert")==0 || d_strcmp(m,"remove")==0 ||
               d_strcmp(m,"sort")==0 || d_strcmp(m,"reverse")==0 ||
               d_strcmp(m,"index")==0 || d_strcmp(m,"count")==0;
    }
    /* `self.f = [1,2]` / `self.f.append(x)` name a field the same way a
     * subscript or `len()` does: the field holds a LIST, so it needs the
     * inline array plus the `<f>_n` counter. */
    /* Names a method binds as parameters.  The program-wide list registry keys
     * on the bare name only, so `self.pos = p` inside `StringIO.seek(self, p)`
     * resolved `p` through that registry and marked the integer field `pos` as
     * a LIST: the struct came out `char* pos[64]; int pos_n;`, every
     * `self.pos = self.pos + 1` was emitted as `self->pos_n = 0;` (the count of
     * a list-literal assignment) and the field was never incremented, so every
     * read through `io.StringIO` returned the wrong slice.  A parameter of the
     * method being scanned shadows any module-level variable of the same name,
     * so the inference has to know which names those are. */
    static char cg_mparam[16384];
    static int cg_nmparam;
    static void cg_mparam_clear(void) { cg_nmparam = 0; }
    static void cg_mparam_add(const char* n) {
        if (!n || !n[0]) return;
        if (cg_nmparam >= 256) return;
        d_strncpy(cg_mparam + cg_nmparam*64, n, 63);
        cg_mparam[cg_nmparam*64 + 63] = 0;
        cg_nmparam = cg_nmparam + 1;
    }
    static int cg_mparam_has(const char* n) {
        int i = 0;
        if (!n) return 0;
        while (i < cg_nmparam) {
            if (d_strcmp(cg_mparam + i*64, n) == 0) return 1;
            i++;
        }
        return 0;
    }
    static void cg_mparam_of(const IRNode* fn) {
        cg_mparam_clear();
        if (!fn || fn->nchildren < 1) return;
        const IRNode* ps = fn->children[0];
        if (!ps) return;
        int j = 0;
        while (j < ps->nchildren) {
            const IRNode* pn = ps->children[j];
            if (pn) cg_mparam_add(pn->value);
            j++;
        }
    }
    static int cg_cls_field_is_lf_use(const IRNode* nn, const char* f) {
        if (!nn) return 0;
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>1) {
            const IRNode* t = nn->children[0];
            if (t && d_strcmp(t->type,"MEMBER_ACCESS")==0 && d_strcmp(t->value,f)==0) {
                const IRNode* r2 = nn->children[1];
                if (cg_is_list_node(r2)) return 1;
                /* `self.f = f()` where `f` RETURNS a list: the field holds the
                 * returned elements, so it needs the inline array plus the
                 * `<f>_n` counter exactly like a list literal.  Without this the
                 * member was declared `int f;` and the returned array was
                 * truncated to an int (csv 50: `self._rows = _csv_parse(...)`). */
                if (r2 && r2->value && d_strcmp(r2->type,"CALL")==0 &&
                    d_strcmp(r2->value,"COMPLEX")!=0 && cg_fn_is_list(r2->value)) return 1;
                /* `self.f = xs` where `xs` is already a list.  A parameter of
                 * the enclosing method shadows any such variable. */
                if (r2 && d_strcmp(r2->type,"IDENTIFIER")==0 && r2->value &&
                    !cg_mparam_has(r2->value) &&
                    (cg_is_dyn_list(r2->value) || cg_list_size(r2->value) >= 0)) return 1;
            }
        }
        if (d_strcmp(nn->type,"CALL")==0 && nn->nchildren>0 && nn->children[0] &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            cg_lf_method(nn->children[0]->value) && nn->children[0]->nchildren>0) {
            const IRNode* o = nn->children[0]->children[0];
            if (o && d_strcmp(o->type,"MEMBER_ACCESS")==0 && d_strcmp(o->value,f)==0) return 1;
        }
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_cls_field_is_lf_use(nn->children[i], f)) return 1;
            i++;
        }
        return 0;
    }
    /* A field used as a subscript (`self.d[i]`) or passed to `len()` holds a
     * LIST: declaring it `int` truncated the array pointer and the program
     * segfaulted (12_classes check 23).  Such a field is `int*`. */
    static int cg_cls_field_is_ptr(const IRNode* nn, const char* f) {
        if (!nn) return 0;
        if (d_strcmp(nn->type,"ARRAY_ACCESS")==0 && nn->nchildren>0) {
            const IRNode* b = nn->children[0];
            if (b && d_strcmp(b->type,"MEMBER_ACCESS")==0 && d_strcmp(b->value,f)==0) return 1;
        }
        if (d_strcmp(nn->type,"CALL")==0 && nn->value && d_strcmp(nn->value,"len")==0 &&
            nn->nchildren==1) {
            const IRNode* b = nn->children[0];
            if (b && d_strcmp(b->type,"MEMBER_ACCESS")==0 && d_strcmp(b->value,f)==0) return 1;
        }
        if (cg_cls_field_is_lf_use(nn, f)) return 1;
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_cls_field_is_ptr(nn->children[i], f)) return 1;
            i++;
        }
        return 0;
    }
    /* Same question, asked one method at a time so that each method's own
     * parameters shadow the program-wide variable tables (see cg_mparam). */
    static int cg_cls_field_is_ptr_m(const IRNode* body, const char* f) {
        if (!body) return 0;
        int mi = 0;
        while (mi < body->nchildren) {
            const IRNode* m = body->children[mi];
            if (m && d_strcmp(m->type,"FUNCTION_DEF")==0) {
                cg_mparam_of(m);
                if (cg_cls_field_is_ptr(m, f)) { cg_mparam_clear(); return 1; }
            }
            mi++;
        }
        cg_mparam_clear();
        return 0;
    }

    /* A method parameter the body dereferences with `.field`, e.g. `other.x`
     * in `Vector.__eq__(self, other)`, is a POINTER to an instance of the
     * enclosing class: declaring it `int` made `other.x` a member access on an
     * integer (12_classes 27). */
    /* (class, field) pairs whose struct member is a LIST pointer.  Such a
     * field gets a companion `<field>_n` member holding the element count,
     * which is what makes `len(self.f)` and a negative `self.f[i]` work
     * (12_classes 23/26).  The struct definition records them here, so the
     * method signature, the constructor call and the two lowerings can never
     * disagree about which fields have a count. */
    static char cg_lf_names[256][32];
    static char cg_lf_cls[256][32];
    static int cg_lf_n = 0;
    static void cg_lf_add(const char* cls, const char* f) {
        if (!cls || !f || !cls[0] || !f[0]) return;
        int i = 0;
        while (i < cg_lf_n) {
            if (d_strcmp(cg_lf_names[i], f) == 0 && d_strcmp(cg_lf_cls[i], cls) == 0) return;
            i++;
        }
        if (cg_lf_n >= 256) return;
        d_strncpy(cg_lf_names[cg_lf_n], f, 31); cg_lf_names[cg_lf_n][31] = 0;
        d_strncpy(cg_lf_cls[cg_lf_n], cls, 31); cg_lf_cls[cg_lf_n][31] = 0;
        cg_lf_n++;
    }
    static int cg_lf_is(const char* cls, const char* f) {
        if (!cls || !f) return 0;
        int i = 0;
        while (i < cg_lf_n) {
            if (d_strcmp(cg_lf_names[i], f) == 0 && d_strcmp(cg_lf_cls[i], cls) == 0) return 1;
            i++;
        }
        return 0;
    }
    /* (owning class, field) pairs whose struct member holds an INSTANCE of
     * another class -- `csv.writer.f` is a StringIO, `Outer.i` an Inner.  The
     * field type is otherwise inferred from the assignment alone and came out
     * `char*`/`int`, so `self.f.write(x)` never reached the class-method
     * lowering: it was emitted verbatim as `self->f.write(x)`, which the
     * backend turned into a jump through garbage (50_csv segfaulted inside
     * writer_writerow).  The class is known from the method-parameter tables,
     * which already type the parameter as `Cls*`. */
    static char cg_of_cls[128][32];
    static char cg_of_fld[128][32];
    static char cg_of_tgt[128][32];
    static int cg_of_n = 0;
    static const char* cg_of_get(const char* cls, const char* f) {
        if (!cls || !f || !cls[0] || !f[0]) return "";
        int i = 0;
        while (i < cg_of_n) {
            if (d_strcmp(cg_of_cls[i], cls) == 0 && d_strcmp(cg_of_fld[i], f) == 0)
                return cg_of_tgt[i];
            i++;
        }
        return "";
    }
    static void cg_of_add(const char* cls, const char* f, const char* t) {
        if (!cls || !f || !t || !cls[0] || !f[0] || !t[0]) return;
        const char* e = cg_of_get(cls, f);
        if (e && e[0]) return;
        if (cg_of_n >= 128) return;
        d_strncpy(cg_of_cls[cg_of_n], cls, 31); cg_of_cls[cg_of_n][31] = 0;
        d_strncpy(cg_of_fld[cg_of_n], f, 31);   cg_of_fld[cg_of_n][31] = 0;
        d_strncpy(cg_of_tgt[cg_of_n], t, 31);   cg_of_tgt[cg_of_n][31] = 0;
        cg_of_n = cg_of_n + 1;
    }
    /* (owning class, list field) pairs whose ELEMENTS are instances of another
     * class: `logging.Logger.handlers` collects StreamHandler objects.  A
     * counted list field can only hold int/double/char* elements, so the
     * appended object was stored as an int and the member call
     * `self.handlers[i].emit(...)` was emitted verbatim -- not C, and the
     * backend jumped through the stored word (51_logging segfaulted inside
     * _log).  The struct declares the element `Cls*` and the call lowering
     * goes through the class method on the stored pointer. */
    static char cg_oe_cls[64][32];
    static char cg_oe_fld[64][32];
    static char cg_oe_tgt[64][32];
    static int cg_oe_n = 0;
    static const char* cg_oe_get(const char* cls, const char* f) {
        if (!cls || !f || !cls[0] || !f[0]) return "";
        int i = 0;
        while (i < cg_oe_n) {
            if (d_strcmp(cg_oe_cls[i], cls) == 0 && d_strcmp(cg_oe_fld[i], f) == 0)
                return cg_oe_tgt[i];
            i++;
        }
        return "";
    }
    static void cg_oe_add(const char* cls, const char* f, const char* t) {
        if (!cls || !f || !t || !cls[0] || !f[0] || !t[0]) return;
        const char* e = cg_oe_get(cls, f);
        if (e && e[0]) return;
        if (cg_oe_n >= 64) return;
        d_strncpy(cg_oe_cls[cg_oe_n], cls, 31); cg_oe_cls[cg_oe_n][31] = 0;
        d_strncpy(cg_oe_fld[cg_oe_n], f, 31);   cg_oe_fld[cg_oe_n][31] = 0;
        d_strncpy(cg_oe_tgt[cg_oe_n], t, 31);   cg_oe_tgt[cg_oe_n][31] = 0;
        cg_oe_n = cg_oe_n + 1;
    }
    /* is `f` a list field of `obj`'s class whose elements are objects? */
    static int cg_oe_recv_field(const IRNode* obj, const char* f) {
        if (!obj || !f || !f[0]) return 0;
        const char* e = cg_oe_get(cg_lf_recv_cls(obj), f);
        return (e && e[0]) ? 1 : 0;
    }
    /* True when `f` is a counted list field of the class whose methods are
     * being emitted right now. */
    static int cg_is_cur_listfield(const char* f) {
        if (cg_cur_cls_i < 0 || cg_cur_cls_i >= cg_cls_n) return 0;
        return cg_lf_is(cg_cls_names[cg_cur_cls_i], f);
    }
    /* The class that the receiver of a member access belongs to, or "" when it
     * cannot be resolved.  `self` is the class being emitted, a named variable
     * is whatever its declaration said. */
    static const char* cg_lf_recv_cls(const IRNode* obj) {
        if (!obj) return "";
        if (obj->value && d_strcmp(obj->value,"self")==0) {
            if (cg_cur_cls_i >= 0 && cg_cur_cls_i < cg_cls_n) return cg_cls_names[cg_cur_cls_i];
            return "";
        }
        if (obj->type && d_strcmp(obj->type,"IDENTIFIER")==0 && obj->value && obj->value[0]) {
            const char* cl = cg_cvar_class(obj->value);
            if (!cl || !cl[0]) cl = cg_curp_cls_of(obj->value);
            if (cl && cl[0]) return cl;
        }
        return "";
    }
    /* Is `f` a counted list field of the receiver's class?  cg_is_cur_listfield
     * only answers for the class whose methods are being emitted; this works
     * from module code too (`c.items == [7, 9]`). */
    static int cg_lf_recv_field(const IRNode* obj, const char* f) {
        if (!obj || !f || !f[0]) return 0;
        return cg_lf_is(cg_lf_recv_cls(obj), f);
    }
    /* The name of the i-th parameter (0-based, `self` excluded) of a class'
     * `__init__`, used to line constructor arguments up with fields. */
    static const char* cg_cls_init_param(const IRNode* clsbody, int i) {
        if (!clsbody) return (const char*)0;
        int k = 0;
        while (k < clsbody->nchildren) {
            const IRNode* c = clsbody->children[k];
            if (d_strcmp(c->type,"FUNCTION_DEF")==0 &&
                d_strcmp(c->value,"__init__")==0 && c->nchildren>0) {
                const IRNode* ps = c->children[0];
                if (!ps) return (const char*)0;
                int seen = 0;
                int j = 0;
                while (j < ps->nchildren) {
                    const IRNode* p = ps->children[j];
                    if (d_strcmp(p->value,"self")!=0) {
                        if (seen == i) return p->value;
                        seen++;
                    }
                    j++;
                }
                return (const char*)0;
            }
            k++;
        }
        return (const char*)0;
    }
    /* The default expression of the i-th non-receiver `__init__` parameter, or
     * 0 when the parameter has none.  Python binds that default at the call
     * site, and a call that omitted it (a constructor reached through another
     * module, where the per-unit call-site rewrite cannot see the class) left
     * the parameter as stack garbage. */
    static const IRNode* cg_cls_init_default(const IRNode* clsbody, int i) {
        if (!clsbody) return (IRNode*)0;
        int k = 0;
        while (k < clsbody->nchildren) {
            const IRNode* c = clsbody->children[k];
            if (d_strcmp(c->type,"FUNCTION_DEF")==0 &&
                d_strcmp(c->value,"__init__")==0 && c->nchildren>0) {
                const IRNode* ps = c->children[0];
                if (!ps) return (IRNode*)0;
                int seen = 0;
                int j = 0;
                while (j < ps->nchildren) {
                    const IRNode* p = ps->children[j];
                    if (d_strcmp(p->value,"self")!=0) {
                        if (seen == i)
                            return p->nchildren>0 ? p->children[0] : (IRNode*)0;
                        seen++;
                    }
                    j++;
                }
                return (IRNode*)0;
            }
            k++;
        }
        return (IRNode*)0;
    }
    /* Same as cg_cls_init_default, but for an arbitrary method name: the
     * default expression of the i-th non-receiver parameter of `mname`.  A
     * method call that omits a trailing defaulted argument (`s.seek(0)` for
     * `seek(self, pos, whence=0)`) otherwise passed stack garbage. */
    static const IRNode* cg_cls_m_default(const IRNode* clsbody, const char* mname, int i) {
        if (!clsbody || !mname) return (IRNode*)0;
        int k = 0;
        while (k < clsbody->nchildren) {
            const IRNode* c = clsbody->children[k];
            if (d_strcmp(c->type,"FUNCTION_DEF")==0 &&
                d_strcmp(c->value, mname)==0 && c->nchildren>0) {
                const IRNode* ps = c->children[0];
                if (!ps) return (IRNode*)0;
                int seen = 0;
                int j = 0;
                while (j < ps->nchildren) {
                    const IRNode* p = ps->children[j];
                    if (d_strcmp(p->value,"self")!=0 && d_strcmp(p->value,"cls")!=0) {
                        if (seen == i)
                            return p->nchildren>0 ? p->children[0] : (IRNode*)0;
                        seen++;
                    }
                    j++;
                }
                return (IRNode*)0;
            }
            k++;
        }
        return (IRNode*)0;
    }
    /* ── method-parameter defaults collected BEFORE emission ────────────────
     * A method call whose callee's class has not been emitted yet (csv.py's
     * `reader.__init__` calls `io.StringIO.read()`, and io is inlined after
     * csv) found no class body in cg_cls_body, so the parameter that the call
     * omitted was passed NOTHING: `f.read()` inside `reader.__init__` left
     * `size` holding whatever happened to be in that register.  When it was a
     * small non-negative value `StringIO.read` copied zero characters, so
     * `csv.reader` saw an empty stream and 50_csv check 2 segfaulted reading
     * the empty first field.  Record every (class, method, parameter-index) ->
     * default node in the pre-emission scan so any call site can fill the gap
     * no matter what order the classes were emitted in. */
    static const IRNode* cg_md_node[1024];
    static char cg_md_cls[32768];
    static char cg_md_mth[32768];
    static int cg_md_idx[1024];
    static int cg_md_nf;
    static void cg_md_note(const char* cls, const char* m, int idx, const IRNode* dv) {
        int k = 0;
        if (!cls || !m) return;
        while (k < cg_md_nf) {
            if (cg_md_idx[k] == idx && d_strcmp(cg_md_cls + k*32, cls) == 0 &&
                d_strcmp(cg_md_mth + k*32, m) == 0) return;
            k++;
        }
        if (cg_md_nf >= 1024) return;
        d_strncpy(cg_md_cls + cg_md_nf*32, cls, 31);
        d_strncpy(cg_md_mth + cg_md_nf*32, m, 31);
        cg_md_idx[cg_md_nf] = idx;
        cg_md_node[cg_md_nf] = dv;
        cg_md_nf = cg_md_nf + 1;
    }
    static const IRNode* cg_md_get(const char* cls, const char* m, int idx) {
        int k = 0;
        if (!cls || !m || idx < 0) return (IRNode*)0;
        while (k < cg_md_nf) {
            if (cg_md_idx[k] == idx && d_strcmp(cg_md_cls + k*32, cls) == 0 &&
                d_strcmp(cg_md_mth + k*32, m) == 0) return cg_md_node[k];
            k++;
        }
        return (IRNode*)0;
    }
    static void cg_md_scan(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->value && a->nchildren > 0) {
            const IRNode* body = a->children[0];
            int k = 0;
            while (body && k < body->nchildren) {
                const IRNode* m = body->children[k];
                if (d_strcmp(m->type,"FUNCTION_DEF")==0 && m->value && m->nchildren > 0 &&
                    m->children[0] && d_strcmp(m->children[0]->value,"PARAMS")==0) {
                    const IRNode* ps = m->children[0];
                    int seen = 0;
                    int j = 0;
                    while (j < ps->nchildren) {
                        const IRNode* p = ps->children[j];
                        if (d_strcmp(p->value,"self")!=0 && d_strcmp(p->value,"cls")!=0) {
                            if (p->nchildren > 0 && p->children[0])
                                cg_md_note(a->value, m->value, seen, p->children[0]);
                            seen++;
                        }
                        j++;
                    }
                }
                k++;
            }
        }
        { int i = 0;
          while (i < a->nchildren) { cg_md_scan(a->children[i]); i++; } }
    }
    /* `x = Cls([...])` passes a LIST to a constructor parameter.  When the
     * `__init__` stores that parameter into `self.f`, the field holds an
     * element pointer plus a count, so the struct member has to be `int*`
     * together with `f_n` -- otherwise `item in self.items` had no array to
     * search and folded to 0 (12_classes 51/52).  The struct emission reads
     * this table, so the scan must run before it. */
    static const IRNode* cg_lf_root;
    static int cg_lf_listy(const IRNode* av) {
        if (!av) return 0;
        if (d_strcmp(av->type,"BLOCK")==0 &&
            (d_strcmp(av->value,"LIST")==0 || d_strcmp(av->value,"TUPLE")==0)) return 1;
        return 0;
    }
    static int cg_lf_listy_arg(const IRNode* nn, const char* cls, int idx) {
        if (!nn || !cls) return 0;
        if (d_strcmp(nn->type,"CALL")==0 && nn->value) {
            /* `Mod.Cls(target=f, args=(42,))`: accept the member-access form
             * and look through a KWARG to its value, so the field fed by the
             * list argument is registered as a counted list (45_threading). */
            const char* cname = nn->value;
            int base = 0;
            if (d_strcmp(cname,"COMPLEX")==0 && nn->nchildren>0 && nn->children[0] &&
                d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0) {
                cname = nn->children[0]->value;
                base = 1;
            }
            if (d_strcmp(cname, cls)==0 && idx + base < nn->nchildren) {
                const IRNode* av = nn->children[idx + base];
                if (av && d_strcmp(av->type,"KWARG")==0 && av->nchildren>0)
                    av = av->children[0];
                if (cg_lf_listy(av)) return 1;
            }
        }
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_lf_listy_arg(nn->children[i], cls, idx)) return 1;
            i++;
        }
        return 0;
    }
    static void cg_lf_find_field(const IRNode* nn, const char* pn, char* out) {
        if (!nn || !pn || !pn[0] || out[0]) return;
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>1 &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->nchildren>0 &&
            d_strcmp(nn->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,"self")==0 &&
            d_strcmp(nn->children[1]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[1]->value, pn)==0) {
            d_strncpy(out, nn->children[0]->value, 31); out[31] = 0;
            return;
        }
        int i = 0;
        while (i < nn->nchildren) {
            cg_lf_find_field(nn->children[i], pn, out);
            if (out[0]) return;
            i++;
        }
    }
    static void cg_lf_scan(const IRNode* a) {
        if (!a) return;
        if (!cg_lf_root) cg_lf_root = a;
        int i = 0;
        while (i < a->nchildren) { cg_lf_scan(a->children[i]); i++; }
        if (d_strcmp(a->type,"CLASS_DEF")!=0 || !a->value || !a->value[0] ||
            !a->nchildren) return;
        const IRNode* body = a->children[0];
        int p = 0;
        const char* pn = cg_cls_init_param(body, p);
        while (pn) {
            int listy = cg_lf_listy_arg(cg_lf_root, a->value, p);
            if (!listy) {
                /* a `field(default_factory=list)` parameter arrives with an
                 * empty-list default: treat the field it feeds as a list. */
                const IRNode* ps = 0;
                int bi = 0;
                while (bi < body->nchildren) {
                    const IRNode* fc = body->children[bi];
                    if (fc && d_strcmp(fc->type,"FUNCTION_DEF")==0 && fc->value &&
                        d_strcmp(fc->value,"__init__")==0 && fc->nchildren>0) { ps = fc->children[0]; break; }
                    bi++;
                }
                int seen = 0;
                int pi2 = 0;
                while (ps && pi2 < ps->nchildren) {
                    const IRNode* pnode = ps->children[pi2];
                    if (d_strcmp(pnode->value,"self")!=0) {
                        if (seen == p && pnode->nchildren>0 && pnode->children[0] &&
                            d_strcmp(pnode->children[0]->type,"BLOCK")==0 &&
                            (d_strcmp(pnode->children[0]->value,"LIST")==0 ||
                             d_strcmp(pnode->children[0]->value,"TUPLE")==0)) listy = 1;
                        seen++;
                    }
                    pi2++;
                }
            }
            if (listy) {
                char fld[32];
                fld[0] = 0;
                cg_lf_find_field(body, pn, fld);
                if (fld[0]) cg_lf_add(a->value, fld);
            }
            p++;
            pn = cg_cls_init_param(body, p);
        }
    }
    static int cg_body_param_member(const IRNode* nn, const char* nm,
                                    const IRNode* cbody) {
        if (!nn || d_strcmp(nm,"self")==0) return 0;
        if (d_strcmp(nn->type,"MEMBER_ACCESS")==0 && nn->nchildren>0 &&
            d_strcmp(nn->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->value, nm)==0 &&
            cg_cls_ftype(cbody, nn->value)) return 1;
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_body_param_member(nn->children[i], nm, cbody)) return 1;
            i++;
        }
        return 0;
    }
    /* Parameters currently typed as `<Class>*`: `a.x` on one of them is a
     * POINTER dereference, so the member access must emit `->` not `.`. */
    static char cg_clsptr_names[2048];
    static int cg_clsptr_n = 0;
    static void cg_clsptr_reset(void) { cg_clsptr_n = 0; }
    static void cg_note_clsptr(const char* nm) {
        if (!nm || !nm[0] || cg_clsptr_n >= 64) return;
        d_strncpy(cg_clsptr_names + cg_clsptr_n*32, nm, 31);
        cg_clsptr_names[cg_clsptr_n*32 + 31] = 0;
        cg_clsptr_n++;
    }
    static int cg_is_clsptr(const char* nm) {
        if (!nm) return 0;
        int i = 0;
        while (i < cg_clsptr_n) {
            if (d_strcmp(cg_clsptr_names + i*32, nm)==0) return 1;
            i++;
        }
        return 0;
    }
    /* A `@classmethod`'s first parameter names the CLASS, not an instance:
     * `cls.count` reads the class attribute global (12_classes 36). */
    static char cg_alias_names[2048];
    static char cg_alias_cls[2048];
    static int cg_alias_n = 0;
    static void cg_alias_reset(void) { cg_alias_n = 0; }
    static void cg_note_alias(const char* nm, const char* cls) {
        if (!nm || !nm[0] || !cls || cg_alias_n >= 64) return;
        d_strncpy(cg_alias_names + cg_alias_n*32, nm, 31);
        cg_alias_names[cg_alias_n*32 + 31] = 0;
        d_strncpy(cg_alias_cls + cg_alias_n*32, cls, 31);
        cg_alias_cls[cg_alias_n*32 + 31] = 0;
        cg_alias_n++;
    }
    static const char* cg_alias_cls_of(const char* nm) {
        if (!nm) return 0;
        int i = 0;
        while (i < cg_alias_n) {
            if (d_strcmp(cg_alias_names + i*32, nm)==0) return cg_alias_cls + i*32;
            i++;
        }
        return 0;
    }
    /* Return type of a class's method, -1 when the class has no such method.
     * Walks the base chain like cg_cls_find_m so an inherited method still
     * reports its own return type. */
    static int cg_cls_mret_find(const char* cls, const char* m, int depth) {
        if (!cls || !cls[0] || depth > 4) return -1;
        int ci = -1;
        int i = 0;
        while (i < cg_cls_n) { if (d_strcmp(cg_cls_names[i], cls) == 0) { ci = i; break; } i++; }
        if (ci < 0) return -1;
        int j = 0;
        while (j < cg_cls_nmeth[ci]) {
            if (d_strcmp(cg_cls_methnames[ci*48 + j], m) == 0) return cg_cls_mret[ci][j];
            j++;
        }
        j = 0;
        while (j < cg_cls_nab[ci]) {
            int mr = cg_cls_mret_find(cg_cls_ab + (ci*4 + j)*64, m, depth + 1);
            if (mr >= 0) return mr;
            j++;
        }
        return -1;
    }
    static void cg_gen_node(CGen* g, const IRNode* n, int stmt);
    static void cg_gen_expr(CGen* g, const IRNode* n);
    static void cg_emit_function(CGen* g, const IRNode* n, int mask);
    static void cg_emit_function2(CGen* g, const IRNode* n, int mask, int fm);
    static int cg_call_ret_float(const IRNode* a);
    /* The C front end silently mis-handles an assignment used as a for-step
     * (`for (i = 0; i < n; i = (i + 1))` never loops), so the canonical
     * `var = var <op> k` shape is emitted as the compound form `var <op>= k`. */
    static void cg_gen_for_step(CGen* g, const IRNode* n) {
        if (n && d_strcmp(n->type,"ASSIGN")==0 && n->nchildren>1) {
            const IRNode* lhs = n->children[0];
            const IRNode* rhs = n->children[1];
            if (lhs && rhs && rhs->nchildren>1 && d_strcmp(rhs->type,"BINARY_OP")==0 &&
                d_strcmp(rhs->children[0]->type,"IDENTIFIER")==0 &&
                d_strcmp(rhs->children[0]->value, lhs->value)==0 &&
                (d_strcmp(rhs->value,"+")==0 || d_strcmp(rhs->value,"-")==0 ||
                 d_strcmp(rhs->value,"*")==0 || d_strcmp(rhs->value,"/")==0)) {
                cg_gen_expr(g, lhs);
                cg_put(g, " ");
                cg_put(g, rhs->value);
                cg_put(g, "= ");
                cg_gen_expr(g, rhs->children[1]);
                return;
            }
        }
        cg_gen_expr(g, n);
    }
    /* Emit a block body (children) with braces. */
    static void cg_gen_block(CGen* g, const IRNode* block) {
        cg_put(g, "{\n");
        g->indent++;
        for (int i=0;i<block->nchildren;i++)
            cg_gen_node(g, block->children[i], 1);
        g->indent--;
        cg_indent(g);
        cg_put(g, "}\n");
    }
    /* Same as cg_gen_block, but the python `range()` loop step runs as the
     * first statement of the body.  python leaves the LAST value of the range
     * in the loop variable, while a C `for (i = 0; i < n; i++)` walks one step
     * past it, so a closure reading `i` after the loop saw the bound instead of
     * the last element (57_nonlocal_global checks 17-18). */
    static void cg_gen_block_step(CGen* g, const IRNode* block, const char* v, const IRNode* step) {
        cg_put(g, "{\n");
        g->indent++;
        cg_indent(g);
        cg_put(g, v);
        cg_put(g, " = ");
        cg_put(g, v);
        cg_put(g, " + ");
        cg_gen_expr(g, step);
        cg_put(g, ";\n");
        for (int i=0;i<block->nchildren;i++)
            cg_gen_node(g, block->children[i], 1);
        g->indent--;
        cg_indent(g);
        cg_put(g, "}\n");
    }
