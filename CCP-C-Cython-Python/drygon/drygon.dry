                            if (mlist) cg_put(g, msls ? "char**" : "int*");
                            else if (mretc && mretc[0]) { cg_put(g, mretc); cg_put(g, " "); }
                            else cg_put(g, mdt==2 ? "char*" : (mdt==3 ? "double" : (mdt==1 ? "void" : "int")));
                        }
                        cg_put(g, " ");
                        cg_put(g, n->value); cg_put(g, "_"); cg_put(g, c->value);
                        /* a `@x.setter` / `@x.deleter` rebinds `x`, so it must
                         * not collide with the getter emitted above */
                        if (ci >= 0 && cg_cls_nmeth[ci] > 0) {
                            int mfl2 = (int)cg_cls_mflags[ci*48 + (cg_cls_nmeth[ci]-1)];
                            if (mfl2 & 4) cg_put(g, "__set");
                            if (mfl2 & 8) cg_put(g, "__del");
