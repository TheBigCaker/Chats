                            cg_put(g, "drygon_splitlines(");
                            cg_gen_expr(g, target->children[0]);
                            cg_put(g, ")");
                            return;
                        }
                        else if (d_strcmp(m,"translate")==0) {
                            /* `s.translate(table)`: the table comes from
                             * str.maketrans, which is pure compile-time data,
                             * so the mapping is inlined as two char tables. */
                            const IRNode* _mta = (n->nchildren > 1) ? n->children[1] : 0;
                            const IRNode* _mtc = 0;
                            if (_mta && d_strcmp(_mta->type,"IDENTIFIER")==0) _mtc = cg_maketrans_node(_mta->value);
                            else if (cg_is_maketrans_call(_mta)) _mtc = _mta;
                            if (_mtc) {
                                cg_mt_fill(_mtc, cg_mt_from, cg_mt_to);
                                if (cg_mt_del[0]) {
                                    /* deletechars: rebuild the 256-byte table
                                     * so the deleted characters drop out. */
                                    cg_put(g, "drygon_translate(");
                                    cg_gen_expr(g, target->children[0]);
                                    cg_put(g, ", drygon_maketrans3(");
                                    cg_put_cstr(g, cg_mt_from);
                                    cg_put(g, ", ");
                                    cg_put_cstr(g, cg_mt_to);
                                    cg_put(g, ", ");
                                    cg_put_cstr(g, cg_mt_del);
                                    cg_put(g, "))");
                                    return;
                                }
                                cg_put(g, "drygon_translate2(");
                                cg_gen_expr(g, target->children[0]);
                                cg_put(g, ", ");
                                cg_put_cstr(g, cg_mt_from);
                                cg_put(g, ", ");
                                cg_put_cstr(g, cg_mt_to);
                                cg_put(g, ")");
                                return;
                            }
                            if (_mta && d_strcmp(_mta->type,"BLOCK")==0 && d_strcmp(_mta->value,"DICT")==0) {
                                cg_put(g, "drygon_translate2(");
                                cg_gen_expr(g, target->children[0]);
                                cg_put(g, ", \"\", \"\")");
                                return;
                            }
                            cg_put(g, "drygon_translate(");
                            cg_gen_expr(g, target->children[0]);
                            cg_put(g, ", ");
                            if (n->nchildren > 1) cg_gen_expr(g, n->children[1]); else cg_put(g, "0");
                            cg_put(g, ")");
                            return;
                        }
                        else if (d_strcmp(m,"count")==0) { h = "drygon_count"; na = 1; }
                        else if (d_strcmp(m,"startswith")==0) { h = "drygon_startswith"; na = 1; }
                        else if (d_strcmp(m,"endswith")==0) { h = "drygon_endswith"; na = 1; }
                        else if (d_strcmp(m,"replace")==0) { if (n->nchildren > 3) { h = "drygon_replace_n"; na = 3; } else { h = "drygon_replace"; na = 2; } }
                        else if (d_strcmp(m,"lstrip")==0) {
                            if (n->nchildren > 1) { h = "drygon_lstrip_chars"; na = 1; }
                            else { h = "drygon_lstrip"; na = 0; }
                        }
                        else if (d_strcmp(m,"rstrip")==0) {
                            if (n->nchildren > 1) { h = "drygon_rstrip_chars"; na = 1; }
                            else { h = "drygon_rstrip"; na = 0; }
                        }
                        else if (d_strcmp(m,"isalpha")==0) { h = "drygon_isalpha"; na = 0; }
                        else if (d_strcmp(m,"isalnum")==0) { h = "drygon_isalnum"; na = 0; }
                        else if (d_strcmp(m,"isspace")==0) { h = "drygon_isspace"; na = 0; }
                        else if (d_strcmp(m,"isupper")==0) { h = "drygon_isupper"; na = 0; }
                        else if (d_strcmp(m,"islower")==0) { h = "drygon_islower"; na = 0; }
                        else if (d_strcmp(m,"isidentifier")==0) { h = "drygon_isident"; na = 0; }
                        else if (d_strcmp(m,"isdecimal")==0) { h = "drygon_isdigit"; na = 0; }
                        else if (d_strcmp(m,"capitalize")==0) { h = "drygon_capitalize"; na = 0; }
                        else if (d_strcmp(m,"swapcase")==0) { h = "drygon_swapcase"; na = 0; }
                        else if (d_strcmp(m,"center")==0 || d_strcmp(m,"ljust")==0 || d_strcmp(m,"rjust")==0) {
                            if (n->nchildren > 2) {
                                /* explicit fill character: Python fills with
                                 * fill[0], ljust pads right, rjust left. */
                                cg_put(g, "drygon_padc(");
                                cg_gen_expr(g, target->children[0]);
                                cg_put(g, ", ");
                                cg_gen_expr(g, n->children[1]);
                                cg_put(g, ", ");
                                cg_put_int(g, d_strcmp(m,"center")==0 ? 2 : (d_strcmp(m,"rjust")==0 ? 1 : 0));
                                cg_put(g, ", ");
                                cg_gen_expr(g, n->children[2]);
                                cg_put(g, ")");
                                return;
                            }
                            h = d_strcmp(m,"center")==0 ? "drygon_center" : (d_strcmp(m,"ljust")==0 ? "drygon_ljust" : "drygon_rjust");
                            na = 1;
                        }
                        else if (d_strcmp(m,"zfill")==0) { h = "drygon_zfill"; na = 1; }
                        else if (d_strcmp(m,"encode")==0 || d_strcmp(m,"decode")==0) {
                            cg_gen_expr(g, target->children[0]);
                            return;
                        }
                        else if (d_strcmp(m,"rfind")==0 || d_strcmp(m,"rindex")==0) { h = d_strcmp(m,"rindex")==0 ? "drygon_rindex" : "drygon_rfind"; na = 1; }
                        else if (d_strcmp(m,"join")==0 && n->nchildren==2) {
                            /* sep.join(list) — the separator is the receiver */
                            const IRNode* it = n->children[1];
                            if (it && d_strcmp(it->type,"IDENTIFIER")==0 && cg_sl_index(it->value) >= 0 &&
                                cg_list_size(it->value) < 0) {
                                cg_put(g, "drygon_join(");
                                cg_gen_expr(g, target->children[0]);
                                cg_put(g, ", ");
                                cg_gen_expr(g, it);
                                cg_put(g, ", ");
                                cg_gen_expr(g, it);
                                cg_put(g, "_n)");
                                return;
                            }
                            if (it && d_strcmp(it->type,"IDENTIFIER")==0 && cg_list_size(it->value) >= 0 &&
                                cg_list_is_str(it->value)) {
                                /* a list literal of strings: the count is known */
                                cg_put(g, "drygon_join(");
                                cg_gen_expr(g, target->children[0]);
                                cg_put(g, ", ");
                                cg_gen_expr(g, it);
                                cg_put(g, ", ");
                                cg_put_int(g, cg_list_size(it->value));
                                cg_put(g, ")");
                                return;
                            }
                            if (it && cg_is_list_node(it)) {
                                /* literal list of strings → concat chain with the
