                int mvnq = (d_strcmp(n->value,"!=")==0);
                const IRNode* mva = cg_mv_tolist_recv(bl);
                const IRNode* mvb = cg_mv_tolist_recv(br);
                const IRNode* mvlst = 0;
                const IRNode* mvre = 0;
