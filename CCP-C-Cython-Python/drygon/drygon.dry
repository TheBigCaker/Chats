                             * range(5) compute cnt=0 and fold to `0`). */
                            int nc = rn->nchildren;
                            if (!cg_num_lit(rn->children[0], &c0)) rng_side = -1;
                            rlo_n = rn->children[0];
                            if (rng_side == 0 && nc >= 2) {
