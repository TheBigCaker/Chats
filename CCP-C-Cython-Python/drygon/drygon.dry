            isslt_et = et;
            has_src = 1;
        } else if (cg_is_str_node(it)) {
            isstr = 1;
            isstrtmp = 1;
            has_src = 1;
        } else if (it && d_strcmp(it->type,"CALL")==0 && d_strcmp(it->value,"COMPLEX")==0 &&
                   it->nchildren>0 && d_strcmp(it->children[0]->type,"MEMBER_ACCESS")==0 &&
                   (d_strcmp(it->children[0]->value,"split")==0 ||
                    d_strcmp(it->children[0]->value,"rsplit")==0)) {
            is_split = 1;
            has_src = 1;
        }
        int is_rsplit = (it && is_split && it->nchildren>0 &&
                         d_strcmp(it->children[0]->value,"rsplit")==0);
        int is_dict_items = 0;
        const char* d_items_name = NULL;
        if (it && d_strcmp(it->type, "CALL") == 0 && it->nchildren > 0 &&
            d_strcmp(it->children[0]->type, "MEMBER_ACCESS") == 0 &&
            d_strcmp(it->children[0]->value, "items") == 0) {
            is_dict_items = 1;
            has_src = 1;
            const IRNode* dt = it->children[0]->nchildren > 0 ? it->children[0]->children[0] : NULL;
            if (dt && d_strcmp(dt->type, "IDENTIFIER") == 0) d_items_name = dt->value;
        }
        int is_call_iter = 0;
        if (!has_src && it && d_strcmp(it->type, "CALL") == 0) {
            is_call_iter = 1;
            has_src = 1;
        }
        if (!has_src) {
            islp = 1;
            has_src = 1;
        }
        /* `for x, y in [(1,2),(3,4)]:` destructures each item, so each tuple
         * slot gets its own array and the loop body copies the slots into the
         * component variables. */
        int istup = (tup != NULL) && cg_is_list_node(it) && !is_enum;
        int is_trow_loop = (tup != NULL) && it && d_strcmp(it->type, "IDENTIFIER") == 0 && cg_list_is_trow(it->value) && !is_enum;
        /* `for row in matrix` over a flattened 2D list: each element is itself a
         * list, so the loop variable is a copy of that row (a list in its own
         * right, which lets the body index it or iterate it again) */
        int is_twod_loop = (tup == NULL) && it && d_strcmp(it->type, "IDENTIFIER") == 0 &&
                           !is_enum && cg_list_is_twod(it->value);
        int trow_bits = is_trow_loop ? cg_list_kybits(it->value) : 0;
        int istupv = 0;
        int tk = 0;
        int ttype[8];
        char tname[512];
        int tbase[8];
        if (istup) {
            tk = tup->nchildren > 8 ? 8 : tup->nchildren;
            int j = 0;
            while (j < tk) {
                const char* cv = tup->children[j] ? tup->children[j]->value : NULL;
                int b = j * 64;
                int q = 0;
                if (cv) while (cv[q] && q < 63) { tname[b + q] = cv[q]; q++; }
                tname[b + q] = 0;
                ttype[j] = 0;
                tbase[j] = b;
                j++;
            }
            int ei = 0;
            while (ei < it->nchildren) {
                const IRNode* el = it->children[ei];
                if (el && d_strcmp(el->type,"BLOCK")==0 && d_strcmp(el->value,"TUPLE")==0) {
                    j = 0;
                    while (j < tk && j < el->nchildren) {
                        int t = 0;
                        if (cg_is_str_node(el->children[j])) t = 2;
                        else if (cg_is_float_node(el->children[j])) t = 1;
                        if (t > ttype[j]) ttype[j] = t;
                        j++;
                    }
                }
                ei++;
            }
        }
        cg_put(g, "{\n");
        g->indent++;
        if (is_split) {
            cg_indent(g); cg_put(g, "char* _dysl"); cg_put_int(g, ln); cg_put(g, "[64];\n");
            cg_indent(g); cg_put(g, "int _dysn"); cg_put_int(g, ln); cg_put(g, " = ");
            if (is_rsplit && it->nchildren>2) { cg_put(g, "drygon_rsplit(_dysl"); cg_put_int(g, ln); cg_put(g, ", "); }
            else { cg_put(g, "drygon_split(_dysl"); cg_put_int(g, ln); cg_put(g, ", "); }
            cg_gen_expr(g, it->children[0]->nchildren>0 ? it->children[0]->children[0] : NULL);
            cg_put(g, ", ");
            if (it->nchildren>1) cg_gen_expr(g, it->children[1]);
            else cg_put(g, "\"\"");
            if (is_rsplit && it->nchildren>2) { cg_put(g, ", "); cg_gen_expr(g, it->children[2]); }
            cg_put(g, ", 64);\n");
        }
        if (istup) {
            int j = 0;
            while (j < tk) {
                cg_indent(g); cg_put(g, ttype[j] == 2 ? "char* " : (ttype[j] == 1 ? "double " : "int "));
                cg_put(g, "_dyt"); cg_put_int(g, ln); cg_put(g, "_"); cg_put_int(g, j);
                cg_put(g, "["); cg_put_int(g, nsize > 0 ? nsize : 1); cg_put(g, "];\n");
                j++;
            }
            int ei = 0;
            while (ei < it->nchildren) {
                const IRNode* el = it->children[ei];
                if (el && d_strcmp(el->type,"BLOCK")==0 && d_strcmp(el->value,"TUPLE")==0) {
                    j = 0;
                    while (j < tk && j < el->nchildren) {
                        cg_indent(g);
                        cg_put(g, "_dyt"); cg_put_int(g, ln); cg_put(g, "_"); cg_put_int(g, j);
                        cg_put(g, "["); cg_put_int(g, ei); cg_put(g, "] = ");
                        cg_gen_expr(g, el->children[j]);
                        cg_put(g, ";\n");
                        j++;
                    }
                }
                ei++;
            }
        } else if (cg_is_list_node(it)) {
            int k = 0;
            int liststr = 0;
            while (k < nsize) {
                if (cg_is_float_node(it->children[k])) isf = 1;
                if (cg_node_is_str_static(it->children[k])) liststr = 1;
                if (it->children[k] && d_strcmp(it->children[k]->type,"BLOCK")==0 &&
                    d_strcmp(it->children[k]->value,"TUPLE")==0) istupv = 1;
                k++;
            }
            /* a literal list of strings needs a char* backing array and a
             * char* loop variable, exactly like a named string list */
            if (liststr) isstrp = 1;
            if (istupv) {
                /* a single variable over a list of tuples: each row is a tuple
                 * value with its own runtime length.  Rows live in one flat
                 * array with a stride of 64 (2D arrays are not lowered), and
                 * the loop copies one row into the variable's tuple buffer. */
                cg_indent(g); cg_put(g, "int _dyl"); cg_put_int(g, ln);
                cg_put(g, "["); cg_put_int(g, (nsize > 0 ? nsize : 1) * 64); cg_put(g, "];\n");
                cg_indent(g); cg_put(g, "int _dyl"); cg_put_int(g, ln);
                cg_put(g, "_n["); cg_put_int(g, nsize > 0 ? nsize : 1); cg_put(g, "];\n");
                k = 0;
                while (k < nsize) {
                    const IRNode* el = it->children[k];
                    cg_indent(g); cg_put(g, "_dyl"); cg_put_int(g, ln); cg_put(g, "_n[");
                    cg_put_int(g, k); cg_put(g, "] = ");
                    cg_put_int(g, el ? el->nchildren : 0); cg_put(g, ";\n");
                    int j = 0;
                    while (el && j < el->nchildren) {
                        cg_indent(g); cg_put(g, "_dyl"); cg_put_int(g, ln); cg_put(g, "[");
                        cg_put_int(g, k * 64 + j); cg_put(g, "] = ");
                        cg_gen_expr(g, el->children[j]); cg_put(g, ";\n");
                        j++;
                    }
                    k++;
                }
            } else {
            cg_indent(g); cg_put(g, isstrp ? "char* " : (isf ? "double " : "int ")); cg_put(g, "_dyl"); cg_put_int(g, ln);
            cg_put(g, "["); cg_put_int(g, nsize > 0 ? nsize : 1); cg_put(g, "];\n");
            k = 0;
            while (k < nsize) {
                cg_indent(g); cg_put(g, "_dyl"); cg_put_int(g, ln); cg_put(g, "[");
                cg_put_int(g, k); cg_put(g, "] = ");
                cg_gen_expr(g, it->children[k]); cg_put(g, ";\n");
                k++;
            }
            }
        }
        if (isstrtmp) {
            cg_indent(g); cg_put(g, "char* _dyst"); cg_put_int(g, ln); cg_put(g, " = ");
            cg_gen_expr(g, it); cg_put(g, ";\n");
        }
        cg_indent(g);
        if (is_trow_loop) {
            int j = 0;
            while (j < tup->nchildren && j < 2) {
                int is_str_col = (trow_bits & (1 << (j + 2))) != 0;
                cg_put(g, is_str_col ? "char* " : "int ");
                cg_put(g, tup->children[j]->value);
                if (is_str_col) cg_note_str(tup->children[j]->value);
                else cg_forget_str(tup->children[j]->value);
                cg_put(g, " = 0;\n");
                cg_indent(g);
                j++;
            }
        } else if (istup) {
            int j = 0;
            while (j < tk) {
                cg_put(g, ttype[j] == 2 ? "char* " : (ttype[j] == 1 ? "double " : "int "));
                cg_put(g, tname + tbase[j]);
                if (ttype[j] == 2) cg_note_str(tname + tbase[j]);
                else if (ttype[j] == 1) cg_note_float(tname + tbase[j]);
                else cg_forget_str(tname + tbase[j]);
                cg_put(g, " = 0;\n");
                cg_indent(g);
                j++;
            }
        } else if (isdict) {
            if (dkf) { cg_put(g, "char* "); cg_note_str(v->value); }
            /* the name may have been a string loop variable in an earlier
             * loop, so a non-string dict key resets it */
            else { cg_put(g, "int "); cg_forget_str(v->value); }
        }
        else if (isslt) {
            /* the loop variable holds one element of the slice temp */
            if (isslt_et == 2) { cg_put(g, "char* "); cg_note_str(v->value); }
            else if (isslt_et == 1) { cg_put(g, "double "); cg_forget_str(v->value); cg_note_float(v->value); }
            else { cg_put(g, "int "); cg_forget_str(v->value); }
        }
        else if (isob) { cg_put(g, obcls); cg_put(g, " "); }
        else if (is_twod_loop) {
            int _wk = cg_list_twod_kind(it->value);
            cg_put(g, _wk == 2 ? "char* " : (_wk == 1 ? "double " : "int "));
            cg_put(g, v->value); cg_put(g, "[64]; int ");
            cg_put(g, v->value); cg_put(g, "_n;\n");
            cg_note_list(v->value, 0, _wk);
            cg_forget_str(v->value);
        }
        else if (issl || is_split || isstrp || isstr) { cg_put(g, "char* "); cg_note_str(is_enum ? enum_val : v->value); }
        else if (istupv) {
            /* the variable is a tuple value: buffer + runtime length, and
             * print() must see it as a tuple list */
            cg_put(g, "int ");
            cg_put(g, v->value); cg_put(g, "[64]; int ");
            cg_put(g, v->value); cg_put(g, "_n;\n");
            cg_note_list(v->value, 0, 0);
            cg_note_tuple(v->value);
            cg_forget_str(v->value);
        }
        else if (is_twod_loop) {
            int _wk2 = cg_list_twod_kind(it->value);
            cg_put(g, _wk2 == 2 ? "char* " : (_wk2 == 1 ? "double " : "int "));
            cg_put(g, v->value); cg_put(g, "[64]; int ");
            cg_put(g, v->value); cg_put(g, "_n;\n");
            cg_note_list(v->value, 0, _wk2);
            cg_forget_str(v->value);
        }
        else if (!(tup && !is_enum)) {
            /* a tuple target declares each of its own names in the loop
             * header below: emitting a bare type here too used to produce
             * declarations like `int char* k;` */
            cg_put(g, isstr ? "char " : (isf ? "double " : "int "));
            if (isstr) cg_note_char(is_enum ? enum_val : v->value);
            /* the loop variable holds a double for the rest of the body, so
             * `print(v)` and `s = s + v` have to see it as a float */
            if (isf) cg_note_float(is_enum ? enum_val : v->value);
        }
        if (tup && !is_enum) {
            int ti = 0;
            /* `for k, v in d.items()`: the column types follow the dict's own
             * key/value flags, and a dict of lists keeps each value in a
             * flattened row, so that variable is a list in its own right. */
            int _tkf = 0;
            int _tvf = 0;
            int _tdl = 0;
            if (is_dict_items && d_items_name) {
                int _di = cg_dict_index(d_items_name);
                if (_di >= 0) { _tkf = cg_dict_kfs[_di]; _tvf = cg_dict_vfs[_di]; }
                _tdl = cg_dl_on(d_items_name);
            }
            while (ti < tup->nchildren) {
                /* Column type of a tuple target: a dict's own key/value
                 * flags, the slots of a known sequence of tuples
                 * (`for i, v in enumerate(["a"])` builds `(idx, "a")` rows),
                 * or -- when neither is known -- the historical `char*`,
                 * left unregistered so an int column still prints as one. */
                int _tstr = 1;
                int _tklass = 0;
                if (is_dict_items) { _tstr = (ti == 0) ? (_tkf != 0) : (_tvf == 2); _tklass = 1; }
                else {
                    const IRNode* _seq = it;
                    if (_seq && d_strcmp(_seq->type, "CALL") == 0 && _seq->value &&
                        d_strcmp(_seq->value, "enumerate") == 0 && _seq->nchildren > 0)
                        _seq = _seq->children[0];
                    if (_seq && cg_is_list_node(_seq)) {
                        _tklass = 1;
                        _tstr = 0;
                        int _ei = 0;
                        while (_ei < _seq->nchildren) {
                            const IRNode* _el = _seq->children[_ei];
                            if (_el && d_strcmp(_el->type, "BLOCK") == 0 &&
                                d_strcmp(_el->value, "TUPLE") == 0 && ti < _el->nchildren &&
                                cg_is_str_node(_el->children[ti])) { _tstr = 1; break; }
                            _ei++;
                        }
                    }
                }
                if (is_dict_items && _tdl && ti == 1) {
                    cg_put(g, "int "); cg_put(g, tup->children[ti]->value); cg_put(g, "[64]; int ");
                    cg_put(g, tup->children[ti]->value); cg_put(g, "_n;\n");
                    cg_note_list(tup->children[ti]->value, 0, 0);
                    cg_forget_str(tup->children[ti]->value);
                } else {
                    cg_put(g, _tstr ? "char* " : "int ");
                    cg_put(g, tup->children[ti]->value); cg_put(g, ";\n");
                    if (_tklass) {
                        if (_tstr) cg_note_str(tup->children[ti]->value);
                        else cg_forget_str(tup->children[ti]->value);
                    }
                }
                cg_indent(g);
                ti++;
            }
        } else if (!istupv && !is_trow_loop) { cg_put(g, is_enum ? enum_val : v->value); cg_put(g, ";\n"); }
        if (is_enum) { cg_indent(g); cg_put(g, "int "); cg_put(g, enum_idx); cg_put(g, ";\n"); }
        cg_indent(g); cg_put(g, "int _dyi"); cg_put_int(g, ln); cg_put(g, " = 0;\n");
        cg_indent(g); cg_put(g, "while (");
        if (isstrtmp) {
            cg_put(g, "_dyst"); cg_put_int(g, ln); cg_put(g, "[_dyi"); cg_put_int(g, ln); cg_put(g, "] != 0");
        } else if (isstr) {
            cg_put(g, it->value); cg_put(g, "[_dyi"); cg_put_int(g, ln); cg_put(g, "] != 0");
        } else if (issl) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < ");
            cg_gen_expr(g, it); cg_put(g, "_n");
        } else if (isslt) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < ");
            cg_gen_expr(g, it); cg_put(g, "_n");
        } else if (is_split) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < _dysn"); cg_put_int(g, ln);
        } else if (is_dict_items) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < ");
            if (d_items_name) { cg_put(g, d_items_name); cg_put(g, "_n"); }
            else { cg_put(g, "0"); }
        } else if (is_call_iter) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < 0");
        } else if (is_lfield) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < ");
            cg_lf_put(g, it->children[0], it->value); cg_put(g, "_n");
        } else if (islp) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < "); cg_put(g, it->value); cg_put(g, "_n");
        } else if (isdict) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < "); cg_put(g, it->value); cg_put(g, "_n");
        } else if (isob) {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < "); cg_put(g, it->value); cg_put(g, "_n");
        } else {
            cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " < "); cg_put_int(g, nsize);
        }
        cg_put(g, ") {\n");
        g->indent++;
        if (is_trow_loop) {
            int j = 0;
            while (j < tup->nchildren && j < 2) {
                cg_indent(g);
                cg_put(g, tup->children[j]->value);
                cg_put(g, " = ");
                cg_put(g, it->value);
                int is_str_col = (trow_bits & (1 << (j + 2))) != 0;
                if (is_str_col) cg_put(g, j == 0 ? "_s0[" : "_s1[");
                else cg_put(g, j == 0 ? "_k0[" : "_k1[");
                cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
                j++;
            }
        } else if (istupv) {
            /* copy row <_dyi> of the 2D backing store into the variable's
             * tuple buffer: p_n first, then the elements */
            cg_indent(g); cg_put(g, v->value); cg_put(g, "_n = _dyl");
            cg_put_int(g, ln); cg_put(g, "_n[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
            cg_indent(g); cg_put(g, "int _dyj"); cg_put_int(g, ln); cg_put(g, " = 0;\n");
            cg_indent(g); cg_put(g, "while (_dyj"); cg_put_int(g, ln);
            cg_put(g, " < _dyl"); cg_put_int(g, ln); cg_put(g, "_n[_dyi"); cg_put_int(g, ln);
            cg_put(g, "]) { "); cg_put(g, v->value); cg_put(g, "[_dyj"); cg_put_int(g, ln);
            cg_put(g, "] = _dyl"); cg_put_int(g, ln); cg_put(g, "[_dyi"); cg_put_int(g, ln);
            cg_put(g, " * 64 + _dyj"); cg_put_int(g, ln); cg_put(g, "]; _dyj"); cg_put_int(g, ln);
            cg_put(g, " = _dyj"); cg_put_int(g, ln); cg_put(g, " + 1; }\n");
        } else if (is_dict_items) {
            if (tup && tup->nchildren >= 2 && d_items_name) {
                cg_indent(g); cg_put(g, tup->children[0]->value); cg_put(g, " = ");
                cg_put(g, d_items_name); cg_put(g, "_k[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
                if (cg_dl_on(d_items_name)) {
                    /* the value lives in the flattened pool: copy this entry's
                     * row into the list variable so `sum(v)` and `for x in v`
                     * see real elements */
                    const char* dvv = tup->children[1]->value;
                    cg_indent(g); cg_put(g, dvv); cg_put(g, "_n = ");
                    cg_put(g, d_items_name); cg_put(g, "_ln[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
                    cg_indent(g); cg_put(g, "int _dyj"); cg_put_int(g, ln); cg_put(g, " = 0;\n");
                    cg_indent(g); cg_put(g, "while (_dyj"); cg_put_int(g, ln); cg_put(g, " < ");
                    cg_put(g, dvv); cg_put(g, "_n) { "); cg_put(g, dvv); cg_put(g, "[_dyj");
                    cg_put_int(g, ln); cg_put(g, "] = ");
                    cg_put(g, d_items_name); cg_put(g, "_back[");
                    cg_put(g, d_items_name); cg_put(g, "_off[_dyi"); cg_put_int(g, ln); cg_put(g, "] + _dyj");
                    cg_put_int(g, ln); cg_put(g, "]; _dyj"); cg_put_int(g, ln); cg_put(g, " = _dyj");
                    cg_put_int(g, ln); cg_put(g, " + 1; }\n");
                } else {
                    cg_indent(g); cg_put(g, tup->children[1]->value); cg_put(g, " = ");
                    cg_put(g, d_items_name); cg_put(g, "_v[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
                }
            }
        } else if (is_call_iter || isob) {
            /* no-op (an object list copies its columns below) */
        } else {
        if (is_enum) {
            cg_indent(g); cg_put(g, enum_idx); cg_put(g, " = _dyi"); cg_put_int(g, ln); cg_put(g, ";\n");
            cg_indent(g); cg_put(g, enum_val);
        } else if (is_twod_loop) {
            /* copy row <_dyi> of the flattened 2D source into the variable: the
             * loop variable is a list in its own right, so the body may index it
             * or iterate it again (`[x for row in matrix for x in row]`) */
            cg_indent(g); cg_put(g, v->value); cg_put(g, "_n = ");
            cg_put(g, it->value); cg_put(g, "_ln[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
            cg_indent(g); cg_put(g, "int _dyj"); cg_put_int(g, ln); cg_put(g, " = 0;\n");
            cg_indent(g); cg_put(g, "while (_dyj"); cg_put_int(g, ln); cg_put(g, " < ");
            cg_put(g, v->value); cg_put(g, "_n) { ");
            cg_put(g, v->value); cg_put(g, "[_dyj"); cg_put_int(g, ln); cg_put(g, "] = ");
            cg_put(g, it->value); cg_put(g, "_back[");
            cg_put(g, it->value); cg_put(g, "_off[_dyi"); cg_put_int(g, ln); cg_put(g, "] + _dyj");
            cg_put_int(g, ln); cg_put(g, "]; _dyj"); cg_put_int(g, ln);
            cg_put(g, " = _dyj"); cg_put_int(g, ln); cg_put(g, " + 1; }\n");
        } else {
            cg_indent(g); cg_put(g, v->value);
        }
        if (!is_twod_loop) {
        cg_put(g, " = ");
        if (isstrtmp || isstr) {
            cg_put(g, "drygon_substr(");
            if (isstrtmp) { cg_put(g, "_dyst"); cg_put_int(g, ln); }
            else { cg_put(g, it->value); }
            cg_put(g, ", _dyi"); cg_put_int(g, ln);
            cg_put(g, ", _dyi"); cg_put_int(g, ln); cg_put(g, " + 1);\n");
        } else {
            if (is_split) { cg_put(g, "_dysl"); cg_put_int(g, ln); }
            else if (isdict) { cg_put(g, it->value); cg_put(g, "_k"); }
            else if (istup) { cg_put(g, "_dyt"); cg_put_int(g, ln); cg_put(g, "_0"); }
            else if (cg_is_list_node(it)) { cg_put(g, "_dyl"); cg_put_int(g, ln); }
            else { cg_gen_expr(g, it); }
            cg_put(g, "[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
        }
        }
        }
        if (istup) {
            int j = 0;
            while (j < tk) {
                cg_indent(g); cg_put(g, tname + tbase[j]); cg_put(g, " = _dyt");
                cg_put_int(g, ln); cg_put(g, "_"); cg_put_int(g, j);
                cg_put(g, "[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
                j++;
            }
        }
        if (isob) {
            /* build the element struct from the per-attribute columns */
            int _oli = cg_ob_lookup(it->value);
            int _oc = 0;
            while (_oc < cg_ob_lncol[_oli]) {
                cg_indent(g);
                cg_put(g, v->value); cg_put(g, ".");
                cg_put(g, cg_ob_lcol[_oli*8 + _oc]);
                cg_put(g, " = "); cg_put(g, cg_ob_lcn[_oli*8 + _oc]);
                cg_put(g, "[_dyi"); cg_put_int(g, ln); cg_put(g, "];\n");
                _oc++;
            }
        }
        if (body) {
            int i = 0;
            while (i < body->nchildren) { cg_gen_node(g, body->children[i], 1); i++; }
        }
        cg_indent(g); cg_put(g, "_dyi"); cg_put_int(g, ln); cg_put(g, " = _dyi"); cg_put_int(g, ln);
        cg_put(g, " + 1;\n");
        g->indent--;
        cg_indent(g); cg_put(g, "}\n");
        g->indent--;
        cg_indent(g); cg_put(g, "}\n");
    }
    /* Emit one function.  `strvariant` generates the all-`char*` twin of a
     * function that is called both with and without strings. */
    static void cg_emit_function2(CGen* g, const IRNode* n, int mask, int fm) {
        cg_lit_reset_done();
        /* each body generation (base + mask specializations) fills its own
         * statement fills: the seen-guard below must not leak across them */
        cg_sl_filled_n = 0;
        int isf = cg_fn_is_float(n->value);
        int base = cg_fn_base_mask(n->value);
        int isvar = (mask != base || fm != 0);
        const IRNode* params = n->nchildren>0 ? n->children[0] : NULL;
        const IRNode* body = n->nchildren>1 ? n->children[1] : NULL;
        int save_nstr = cg_nstr_vars;
        int save_nchar = cg_nchar_vars;
        int save_nlp = cg_nlp_vars;
        int save_nfl = cg_nfloat_vars;
        int fret = 0;
        int retstr;
        int mretlist = 0;
        int mretsls = 0;
        if (isvar) retstr = cg_mask_retstr(n->value, mask);
        else retstr = cg_fn_is_str(n->value);
        int retlist = (!isvar) ? cg_fn_is_list(n->value) : 0;
        /* A METHOD is not in the `cg_prog_*` tables (those key on plain
         * function names), so its list-ness was invisible here and a method
         * that builds and returns a list was declared `int`: the array pointer
         * was truncated and the caller read garbage (24_collections
         * `OrderedDict.keys()`, 50_csv `reader.__next__`).  The body is right
         * here, so ask it. */
        if (!retlist && cg_prog_find(n->value) < 0 && body &&
            (cg_ret_list_scan(body) || cg_ret_name_list_scan(body, body))) mretlist = 1;
        if (mretlist && cg_ret_strlist_of(body)) mretsls = 1;
        if (isvar && fm) fret = cg_mask_fret(n->value, mask, fm);
        else if (isvar) fret = cg_mask_fret(n->value, mask, fm);
        else {
            int bfi = cg_prog_find(n->value);
            fret = bfi >= 0 ? cg_prog_basefret[bfi] : 0;
        }
        /* the signature tells which parameters take a list and of what element
         * type: bits 8..15 say "a list", 16..23 "double", 24..31 "char*" */
        int lmask = (mask >> 8) & 0xFF;
        int i;
        /* an object parameter noted below emits `->` on its member accesses;
         * the note must not leak into the next function's parameters */
        cg_clsptr_reset();
        cg_curp_reset();
        int pfi = cg_prog_find(n->value);
        for (i=0;params && i<params->nchildren;i++) {
            const IRNode* pn = params->children[i];
            /* a parameter that receives a python object is a POINTER to it, so
             * its members are reached through `->` */
            {
                const char* pcls = cg_param_cls(pfi, i);
                if (pcls) { cg_note_clsptr(pn->value); cg_note_curp(pn->value, pcls); }
            }
            /* `*args` / `**kwargs` take a SEQUENCE, not a scalar.  Without this
             * registration the body read the raw parameter (`args;` in the
             * emitted C) and `len(args)` / `for x in args` did the wrong thing.
             * The name is only noted, never counted in the C signature, because
             * cg_fn_sig skips data_type VARGS. */
            if (d_strcmp(pn->data_type,"LIST")==0 || d_strcmp(pn->data_type,"VARGS")==0) {
                if (d_strcmp(pn->data_type,"VARGS")==0) cg_note_vparam(pn->value);
                cg_note_lparam(pn->value, 0); continue;
            }
            if (d_strcmp(pn->data_type,"DICT")==0) { continue; }
            if (fm & (1 << i)) cg_note_float(pn->value);
            else if (lmask & (1 << i)) cg_note_lparam(pn->value, cg_mask_ltype(mask, i));
            else if (mask & (1 << i)) cg_note_str(pn->value);
            else if (pn->nchildren>0) {
                /* an uncovered parameter keeps a default from the def site */
                const IRNode* dv = pn->children[0];
                if (d_strcmp(dv->type,"CONSTANT")==0) {
                    if (d_strcmp(dv->data_type,"STR")==0 || d_strcmp(dv->data_type,"FSTR")==0)
                        cg_note_str(pn->value);
                    else if (d_strcmp(dv->data_type,"FLOAT")==0 || d_strcmp(dv->data_type,"DOUBLE")==0)
                        cg_note_float(pn->value);
                }
            }
        }
        const char* ret;
        /* a function whose list elements are strings hands back a `char**`:
         * declaring it `int*` truncated the pointee and the caller read the
         * array out of the wrong word size (10_control check 37) */
        int retsli = (retlist && cg_fn_ret_strlist(n->value)) || mretsls;
        if (retsli) ret = "char**";
        else if (retlist || mretlist) ret = "int*";
        else if (retstr) ret = "char*";
        else if (isf || fret) ret = "double";
        else ret = ir_to_c_type(n->data_type);
        /* an unannotated `def` that returns a value is an int function, not a
         * void one (string/list/float are handled above) */
        if (d_strcmp(ret,"void")==0 && cg_ret_value_scan(body)) ret = "int";
        cg_indent(g);
        cg_put(g, ret); cg_put(g, " "); cg_put(g, cg_safe_fn_name(n->value));
        if (isvar) {
            cg_put(g, "__"); cg_put_int(g, mask);
            if (fm) { cg_put(g, "_"); cg_put_int(g, fm); }
        }
        cg_put(g, "(");
        int first=1;
        if (params) {
            for (i=0;i<params->nchildren;i++) {
                const IRNode* p = params->children[i];
                /* a dict parameter carries the same parallel arrays a dict
                 * variable lives in, so `d["k"]` works inside the body */
                if (cg_is_dict_param(p)) {
                    if (!first) cg_put(g, ", ");
                    cg_put(g, cg_dict_kf(p->value) ? "char** " : "int* ");
                    cg_put(g, p->value); cg_put(g, "_k, ");
                    int dvf = cg_dict_vf(p->value);
                    if (dvf == 2) cg_put(g, "char** ");
                    else if (dvf == 1) cg_put(g, "double* ");
                    else cg_put(g, "int* ");
                    cg_put(g, p->value); cg_put(g, "_v, int ");
                    cg_put(g, p->value); cg_put(g, "_n");
                    first=0;
                    continue;
                }
                /* a parameter that is handed a python object takes a POINTER
                 * to it, and the call site hands it `&` */
                {
                    const char* pcls = cg_param_cls(pfi, i);
                    if (pcls) {
                        if (!first) cg_put(g, ", ");
                        cg_put(g, pcls); cg_put(g, "* "); cg_put(g, p->value);
                        cg_note_clsptr(p->value);
                        first=0;
                        continue;
                    }
                }
                /* a float function takes float parameters, a function that is
                 * handed strings takes `char*`; a python argument list carries
                 * no type information, so both are inferred.  A python list
                 * arrives as its element pointer plus a companion count.
                 * A defaulted parameter that this variant does not receive is
                 * omitted from the signature and initialised in the body. */
                if (d_strcmp(p->data_type,"VARGS")==0 || d_strcmp(p->data_type,"LIST")==0) {
                    /* `def f(*args)`: the collected arguments arrive as a
                     * backing array plus its count, so `args[i]` and `len(args)`
                     * work in the body.  Emitting a scalar `int args` left the
                     * body reading `args_n`, which was never a parameter
                     * (11_functions check 8). */
                    if (!first) cg_put(g, ", ");
                    cg_put(g, "int* "); cg_put(g, p->value);
                    cg_put(g, ", int "); cg_put(g, p->value); cg_put(g, "_n");
                    first=0;
                } else if (fm & (1 << i)) {
                    if (!first) cg_put(g, ", ");
                    cg_put(g, "double "); cg_put(g, p->value);
                    first=0;
                } else if (lmask & (1 << i)) {
                    if (!first) cg_put(g, ", ");
                    int t = cg_mask_ltype(mask, i);
                    if (t == 1) cg_put(g, "double* ");
                    else if (t == 2) cg_put(g, "char** ");
                    else cg_put(g, "int* ");
                    cg_put(g, p->value);
                    cg_put(g, ", int "); cg_put(g, p->value); cg_put(g, "_n");
                    first=0;
                } else if (mask & (1 << i)) {
                    if (!first) cg_put(g, ", ");
                    cg_put(g, "char* "); cg_put(g, p->value);
                    first=0;
                } else {
                    if (!first) cg_put(g, ", ");
                    cg_put(g, isf ? "double " : "int ");
                    cg_put(g, p->value);
                    first=0;
                }
            }
        }
        if (first) cg_put(g, "void");
        cg_put(g, ") ");
        if (body) {
            /* a GENERATOR body (contains `yield`) accumulates into drygon_rl and
             * hands the list back; reset the cursor at entry and return it at
             * the end.  The `list(gen(n))` / `for x in gen(n)` consumers read it
             * through the usual retlist machinery. */
            int _yld = cg_yield_scan(body);
            if (_yld) {
                cg_put(g, " {\n"); g->indent++;
                cg_indent(g); cg_put(g, "drygon_rl_n = 0;\n");
                int _sgv = cg_in_gen; cg_in_gen = 1;
                cg_gen_block(g, body);
                cg_in_gen = _sgv;
                cg_indent(g); cg_put(g, "return drygon_rl;\n");
                g->indent--; cg_indent(g); cg_put(g, "}\n");
            } else
            cg_gen_block(g, body);
        }
        else cg_put(g, ";\n");
        cg_nstr_vars = save_nstr;
        cg_nchar_vars = save_nchar;
        cg_nlp_vars = save_nlp;
        /* a `double` parameter is only known inside its own variant */
        if (fm) cg_nfloat_vars = save_nfl;
    }
    static void cg_emit_function(CGen* g, const IRNode* n, int mask) {
        cg_emit_function2(g, n, mask, 0);
    }
    /* The element kind of a counted list FIELD: 0 int, 1 double, 2 char*.
     * Inferred from the class body -- the literal it is assigned, the values
     * appended to it, or the kind of the list variable its `__init__` parameter
     * receives.  Without the kind a float list truncated and a string list put
     * a pointer in an int slot. */
    static int cg_lf_kind_scan(const IRNode* nn, const char* f) {
        if (!nn) return -1;
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>1 && nn->children[0] &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            d_strcmp(nn->children[0]->value,f)==0) {
            const IRNode* r = nn->children[1];
            if (r && d_strcmp(r->type,"BLOCK")==0) {
                if (r->nchildren == 0) return -1;
                int k = 0;
                while (k < r->nchildren) {
                    if (cg_node_is_str_static(r->children[k]) ||
                        cg_is_str_node(r->children[k])) return 2;
                    if (d_strcmp(r->children[k]->type,"CONSTANT")==0 &&
                        d_strcmp(r->children[k]->data_type,"FLOAT")==0) return 1;
                    k++;
                }
                return 0;
            }
            if (r && d_strcmp(r->type,"IDENTIFIER")==0) {
                int t = cg_list_flags_prescan_at(r->value);
                if (t == 2) return 2;
                if (t == 1) return 1;
                return -1;
            }
            /* `self.fieldnames = self._r.__next__()`: the field is filled from
             * the list a METHOD hands back.  There was no CALL arm at all, so
             * the statement fell through to the generic scan, which found
             * nothing, and the field kept the 0 that means "int list"
             * (50_csv). */
            if (r && d_strcmp(r->type,"CALL")==0 && cg_call_yields_list(r))
                return cg_call_yields_strlist(r) ? 2 : 0;
        }
        if (d_strcmp(nn->type,"CALL")==0 && nn->nchildren>1 && nn->children[0] &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            cg_lf_method(nn->children[0]->value) && nn->children[0]->nchildren>0 &&
            nn->children[0]->children[0] &&
            d_strcmp(nn->children[0]->children[0]->type,"MEMBER_ACCESS")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,f)==0) {
            const IRNode* r = nn->children[1];
            if (r && d_strcmp(r->type,"BLOCK")==0 && r->nchildren>0) r = r->children[0];
            if (r && (cg_node_is_str_static(r) || cg_is_str_node(r))) return 2;
            if (r && d_strcmp(r->type,"CONSTANT")==0 &&
                d_strcmp(r->data_type,"FLOAT")==0) return 1;
            return -1;
        }
        int i = 0;
        while (i < nn->nchildren) {
            int k = cg_lf_kind_scan(nn->children[i], f);
            if (k >= 0) return k;
            i++;
        }
        return -1;
    }
    static int cg_lf_kind(const char* cls, const char* f) {
        int ci = cg_cls_index(cls);
        const IRNode* body = (ci >= 0) ? cg_cls_body[ci] : NULL;
        if (body) {
            int p = 0;
            const char* pn = cg_cls_init_param(body, p);
            while (pn) {
                if (d_strcmp(pn,f)==0) {
                    /* Only a note that EXISTS may answer for the field.  An
                     * unnoted parameter (a defaulted `fieldnames=[]`) means
                     * "ask the body", not "an int list": returning 0 here typed
                     * every column name as an int (50_csv). */
                    /* The list-argument scan recorded the kind of every
                     * `__init__` parameter it saw a list at, keyed by
                     * (class, method, position).  That key is far more precise
                     * than the name-keyed parameter table, which is shared by
                     * every class: a `fieldnames` parameter noted as an INT
                     * list somewhere else made DictWriter.fieldnames
                     * `int[64]` and truncated every column name, while the
                     * signature emitter -- which asks the same (class, method,
                     * position) table -- declared the parameter `char**`
                     * (50_csv).  The struct type must agree with the emitted
                     * signature, so ask the positional table first. */
                    int mk = cg_mps_lk_get(cls, "__init__", p);
                    if (mk == 3) return 2;
                    if (mk == 2) return 1;
                    if (mk == 1) return 0;
                    if (cg_lparam_known(pn)) {
                        int t = cg_lparam_type(pn);
                        if (t == 2) return 2;
                        if (t == 1) return 1;
                        return 0;
                    }
                    break;
                }
                p++;
                pn = cg_cls_init_param(body, p);
            }
            int k = cg_lf_kind_scan(body, f);
            if (k >= 0) return k;
        }
        return 0;
    }
    /* `for x in it:` where `it` is a NAME bound to an instance of a class that
     * drives the iterator protocol itself (`__iter__` returns `self`,
     * `__next__` hands out the values and raises StopIteration).  Only a CALL
     * to the class constructor was recognised, so an instance that had been
     * stored in a variable first fell through to the plain-list path and the
     * loop never finished (24_collections, 45_threading). */
    static int cg_iter_var_ok(const IRNode* it) {
        if (!it || d_strcmp(it->type,"IDENTIFIER")!=0) return 0;
        if (!it->value || !it->value[0]) return 0;
        /* A NAME that spells a class is only the CLASS when no variable of that
         * name is bound to an instance: `reader = reader()` shadows the class,
         * and bailing out on the class test alone made `list(reader)` copy the
         * object itself (csv 50).  The live instance table decides. */
        const char* vc = cg_cvar_class(it->value);
        if (cg_is_class(it->value) && (!vc || !vc[0])) return 0;
        if (!vc || !vc[0]) return 0;
        return (cg_cls_find_m(vc, "__next__") != 0);
    }
    static void cg_emit_iterfor(CGen* g, const IRNode* it, const IRNode* v,
                                 const IRNode* body) {
        const char* icl = cg_cvar_class(it->value);
        const char* itx = cg_cls_find_m(icl, "__next__");
        char ivb[32]; char ivn[32]; char ivt[32]; char ivg[32];
        cg_iter_names(cg_it_serial, ivb, ivn, ivt, ivg, ivg);
        cg_it_serial = cg_it_serial + 1;
        cg_put(g, "{\n"); g->indent++;
        cg_iter_fill(g, itx, it->value, ivb, ivn, ivt);
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, v->value); cg_put(g, "; int ");
        cg_put(g, ivg); cg_put(g, " = 0;\n");
        g->indent++;
        cg_indent(g);
        cg_put(g, "while ("); cg_put(g, ivg); cg_put(g, " < ");
        cg_put(g, ivn); cg_put(g, ") { ");
        cg_put(g, v->value); cg_put(g, " = ");
        cg_put(g, ivb); cg_put(g, "["); cg_put(g, ivg); cg_put(g, "];\n");
        if (body) cg_gen_block(g, body);
        cg_indent(g);
        cg_put(g, ivg); cg_put(g, " = "); cg_put(g, ivg);
        cg_put(g, " + 1; }\n");
        g->indent--;
        cg_indent(g);
        cg_put(g, "}\n");
    }
    /* `rows = list(reader)`: the operand is a NAME bound to an instance of a
     * class running the iterator protocol, not a fresh constructor call, so it
     * has to be drained the same way `for x in reader` is.  Only the CALL form
     * was handled, and the target list of the NAME form stayed as it was. */
    static void cg_emit_iterlist(CGen* g, const IRNode* alhs, const IRNode* src) {
        const char* vcn = cg_cvar_class(src->value);
        const char* vnx = cg_cls_find_m(vcn, "__next__");
        int vmk = cg_cls_mret_find(vcn, "__next__", 0);
        int vkf = (vmk == 2) ? 2 : ((vmk == 3) ? 1 : 0);
        char vvb[32]; char vvn[32]; char vvt[32]; char vvg[32]; char vvj[32];
        cg_iter_names(cg_it_serial, vvb, vvn, vvt, vvg, vvj);
        cg_it_serial = cg_it_serial + 1;
        /* A `__next__` that hands back a python LIST yields a ROW per step, so
         * the drained name is a flattened 2-D list (`rows = list(reader)`).
         * The old branch typed the name `int` and read the `char**` return
         * through it, which left 50_csv reading garbage rows. */
        if (vmk == 4 && cg_mrd_findc(vcn, "__next__") >= 0) {
            /* a dict-returning `__next__`: one dict row per step, copied out of
             * the shared buffer as (key, string value) pairs */
            cg_note_list(alhs->value, 64, 2);
            cg_drl_note(alhs->value);
            cg_put(g, "{\n"); g->indent++;
            cg_indent(g);
            cg_put(g, "int "); cg_put(g, vvn); cg_put(g, " = 0; int ");
            cg_put(g, vvg); cg_put(g, " = 0;\n");
            cg_indent(g);
            cg_put(g, "while (!pyx_pendq()) { pyx_clear(); int _drn = ");
            cg_put(g, vnx); cg_put(g, "___next__(&"); cg_put(g, src->value);
            cg_put(g, "); if (pyx_pendq()) { pyx_clear(); break; } ");
            cg_put(g, alhs->value); cg_put(g, "_ro["); cg_put(g, vvn);
            cg_put(g, "] = "); cg_put(g, vvg); cg_put(g, "; ");
            cg_put(g, alhs->value); cg_put(g, "_rn["); cg_put(g, vvn);
            cg_put(g, "] = drygon_rdn; { int "); cg_put(g, vvj);
            cg_put(g, " = 0; while ("); cg_put(g, vvj);
            cg_put(g, " < drygon_rdn) { "); cg_put(g, alhs->value);
            cg_put(g, "_k["); cg_put(g, vvg); cg_put(g, " + "); cg_put(g, vvj);
            cg_put(g, "] = drygon_rdk["); cg_put(g, vvj); cg_put(g, "]; ");
            cg_put(g, alhs->value); cg_put(g, "_v["); cg_put(g, vvg);
            cg_put(g, " + "); cg_put(g, vvj); cg_put(g, "] = drygon_rdvsk[");
            cg_put(g, vvj); cg_put(g, "]; "); cg_put(g, vvj); cg_put(g, "++; } ");
            cg_put(g, vvg); cg_put(g, " = "); cg_put(g, vvg);
            cg_put(g, " + drygon_rdn; } ");
            cg_put(g, vvn); cg_put(g, " = ");
            cg_put(g, vvn); cg_put(g, " + 1; }\n");
            cg_indent(g);
            cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put(g, vvn); cg_put(g, ";\n");
            g->indent--;
            cg_indent(g);
            cg_put(g, "}\n");
            return;
        }
        if (vmk == 4) {
            int v2k = 0;
            int vmli = (vcn && vcn[0]) ? cg_mrl_findc(vcn, "__next__") : -1;
            if (vmli >= 0) v2k = cg_mrl_slsc[vmli] ? 1 : 0;
            else { vmli = cg_mrl_find("__next__"); if (vmli >= 0 && cg_mrl_sls[vmli]) v2k = 1; }
            cg_note_list(alhs->value, 64, v2k);
            cg_note_twod_k(alhs->value, v2k);
            cg_put(g, "{\n"); g->indent++;
            cg_indent(g);
            cg_put(g, "int "); cg_put(g, vvn); cg_put(g, " = 0; int ");
            cg_put(g, vvg); cg_put(g, " = 0;\n");
            cg_indent(g);
            cg_put(g, "while (!pyx_pendq()) { pyx_clear(); char** ");
            cg_put(g, vvt); cg_put(g, " = ");  cg_put(g, vnx);
            cg_put(g, "___next__(&"); cg_put(g, src->value);
            cg_put(g, "); if (pyx_pendq()) { pyx_clear(); break; } ");
            cg_put(g, alhs->value); cg_put(g, "_off[");
            cg_put(g, vvn); cg_put(g, "] = "); cg_put(g, vvg); cg_put(g, "; ");
            cg_put(g, alhs->value); cg_put(g, "_ln["); cg_put(g, vvn);
            cg_put(g, "] = drygon_rls_n; { int "); cg_put(g, vvj);
            cg_put(g, " = 0; while ("); cg_put(g, vvj);
            cg_put(g, " < drygon_rls_n) { "); cg_put(g, alhs->value);
            cg_put(g, "_back["); cg_put(g, vvg); cg_put(g, " + ");
            cg_put(g, vvj); cg_put(g, "] = "); cg_put(g, vvt);
            cg_put(g, "["); cg_put(g, vvj); cg_put(g, "]; ");
            cg_put(g, vvj); cg_put(g, "++; } ");
            /* The row cursor must advance by the WHOLE row once the copy is
             * done.  Incrementing it inside the copy loop moved it twice as
             * fast as the element index, so `rows = list(reader)` wrote row i
             * at `rows_back[2*off]` and every row read back interleaved
             * neighbours (50_csv check 2). */
            cg_put(g, vvg); cg_put(g, " = "); cg_put(g, vvg);
            cg_put(g, " + drygon_rls_n; } ");
            cg_put(g, vvn); cg_put(g, " = ");
            cg_put(g, vvn); cg_put(g, " + 1; }\n");
            cg_indent(g);
            cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put(g, vvn); cg_put(g, ";\n");
            g->indent--;
            cg_indent(g);
            cg_put(g, "}\n");
            return;
        }
        cg_note_list(alhs->value, 64, vkf);
        cg_put(g, "{\n"); g->indent++;
        cg_iter_fill(g, vnx, src->value, vvb, vvn, vvt);
        cg_indent(g);
        cg_put(g, "for (int "); cg_put(g, vvj); cg_put(g, " = 0; ");
        cg_put(g, vvj); cg_put(g, " < "); cg_put(g, vvn);
        cg_put(g, "; "); cg_put(g, vvj); cg_put(g, "++) { ");
        cg_put(g, alhs->value); cg_put(g, "["); cg_put(g, vvj);
        cg_put(g, "] = "); cg_put(g, vvb); cg_put(g, "[");
        cg_put(g, vvj); cg_put(g, "]; }\n");
        cg_indent(g);
        cg_put(g, alhs->value); cg_put(g, "_n = ");
        cg_put(g, vvn); cg_put(g, ";\n");
        g->indent--;
        cg_indent(g);
        cg_put(g, "}\n");
    }
    /* ── functools.reduce ─────────────────────────────────────────────────
     * `reduce(f, xs[, init])`.  There are no function values in this backend,
     * so the fold cannot be a call: the lambda pass has already replaced `f`
     * with the name of a file-scope function, and the fold is emitted here as
     * a real loop over the sequence's backing array.  All four uses in
     * 26_functools (a literal list, with and without an initial value) take
     * this path. */
    static char cg_rd_acc[32];
    static int cg_rd_seq;
    static int cg_rd_is(const IRNode* n) {
        if (!n) return 0;
        if (d_strcmp(n->type,"CALL")!=0) return 0;
        if (d_strcmp(n->value,"reduce")!=0) return 0;
        if (n->nchildren < 2) return 0;
        const IRNode* f = n->children[0];
        if (!f) return 0;
        if (d_strcmp(f->type,"IDENTIFIER")!=0) return 0;
        if (!f->value) return 0;
        if (!f->value[0]) return 0;
        return 1;
    }
    static void cg_rd_emit(CGen* g, const IRNode* n) {
        const IRNode* f = n->children[0];
        const IRNode* xs = n->children[1];
        const IRNode* iv = 0;
        if (n->nchildren > 2) iv = n->children[2];
        cg_rd_seq = cg_rd_seq + 1;
        char num[16];
        char jn[24];
        cg_cfi_itoa(cg_rd_seq, num);
        int k = 3;
        int z = 0;
        cg_rd_acc[0] = '_'; cg_rd_acc[1] = 'r'; cg_rd_acc[2] = 'd';
        while (num[z] && k < 20) { cg_rd_acc[k] = num[z]; k++; z++; }
        cg_rd_acc[k] = 0;
        jn[0] = '_'; jn[1] = 'r'; jn[2] = 'd'; jn[3] = 'j';
        k = 4;
        z = 0;
        while (num[z] && k < 20) { jn[k] = num[z]; k++; z++; }
        jn[k] = 0;
        int lk = cg_lit_add(xs);
        cg_lit_fill_one(g, xs, lk);
        int litn = -1;
        if (lk >= 0) litn = cg_lit_sizes[lk];
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, cg_rd_acc); cg_put(g, " = ");
        if (iv) cg_gen_expr(g, iv);
        else {
            if (lk >= 0) cg_lit_put_name(g, lk);
            else cg_dyn_put_name(g, xs);
            cg_put(g, "[0]");
        }
        cg_put(g, ";\n");
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, jn); cg_put(g, " = ");
        if (iv) cg_put_int(g, 0);
        else cg_put_int(g, 1);
        cg_put(g, ";\n");
        cg_indent(g);
        cg_put(g, "while ("); cg_put(g, jn); cg_put(g, " < ");
        if (litn >= 0) cg_put_int(g, litn);
        else {
            cg_dyn_put_name(g, xs);
            cg_put(g, "_n");
        }
        cg_put(g, ") { "); cg_put(g, cg_rd_acc); cg_put(g, " = ");
        cg_put(g, f->value); cg_put(g, "("); cg_put(g, cg_rd_acc); cg_put(g, ", ");
        if (lk >= 0) cg_lit_put_name(g, lk);
        else cg_dyn_put_name(g, xs);
        cg_put(g, "["); cg_put(g, jn); cg_put(g, "]); ");
        cg_put(g, jn); cg_put(g, " = "); cg_put(g, jn); cg_put(g, " + 1; }\n");
    }
    /* Record every `self.<f> = <param>` inside a method whose parameter the
