    static PyValue py_bitwise_or(PyValue a, PyValue b) {
        if (a.kind == PYV_INT && b.kind == PYV_INT) return pyv_int(a.u.i | b.u.i);
        return pyv_none();
    }
    static PyValue py_bitwise_xor(PyValue a, PyValue b) {
