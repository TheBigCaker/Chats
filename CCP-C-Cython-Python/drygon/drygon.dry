                             * expression position the count is produced. */
                            int _erm = (d_strcmp(m,"rsplit")==0) && n->nchildren>2;
                            if (_erm) cg_put(g, "drygon_rsplit_len_m(");
                            else cg_put(g, "drygon_split_len(");
                            cg_gen_expr(g, target->children[0]);
                            cg_put(g, ", ");
                            if (n->nchildren>1) cg_gen_expr(g, n->children[1]);
                            else cg_put(g, "\"\"");
                            if (_erm) { cg_put(g, ", "); cg_gen_expr(g, n->children[2]); }
                            cg_put(g, ")");
                            return;
                        }
                        if (h && n->nchildren >= na + 1) {
                            cg_put(g, h);
                            cg_put(g, "(");
                            cg_gen_expr(g, target->children[0]);
                            for (int i=0;i<na;i++) {
