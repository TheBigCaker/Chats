                if ((rk == 1 || rk == 2) && rcls && rcls[0]) oc = rcls;
            }
            if (oc && oc[0]) cg_of_add(cls, nn->children[0]->value, oc);
        }
        int i = 0;
        while (i < nn->nchildren) { cg_of_walk(cls, meth, ps, nn->children[i]); i++; }
    }
    static void cg_of_scan(const char* cls, const IRNode* body) {
        if (!cls || !cls[0] || !body) return;
        int mi = 0;
