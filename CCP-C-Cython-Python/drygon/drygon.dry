                       n->children[1]->value &&
                       (d_strcmp(n->children[1]->value,"int")==0 ||
                        d_strcmp(n->children[1]->value,"float")==0 ||
                        d_strcmp(n->children[1]->value,"str")==0 ||
                        d_strcmp(n->children[1]->value,"bytes")==0 ||
                        d_strcmp(n->children[1]->value,"bool")==0 ||
                        d_strcmp(n->children[1]->value,"list")==0 ||
                        d_strcmp(n->children[1]->value,"dict")==0 ||
                        d_strcmp(n->children[1]->value,"set")==0 ||
                        d_strcmp(n->children[1]->value,"tuple")==0)) {
