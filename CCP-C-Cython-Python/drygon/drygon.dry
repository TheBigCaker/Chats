static int cg_py_issubclass(const char* a, const char* b) {
    static const char* pairs[] = {
        "ValueError:Exception","TypeError:Exception","RuntimeError:Exception",
        "ZeroDivisionError:Exception","ZeroDivisionError:ArithmeticError",
        "ArithmeticError:Exception","OverflowError:ArithmeticError",
        "FloatingPointError:ArithmeticError","IndexError:LookupError","KeyError:LookupError",
        "LookupError:Exception","AttributeError:Exception","ImportError:Exception",
        "ModuleNotFoundError:ImportError","NameError:Exception","OSError:Exception",
        "IOError:OSError","FileNotFoundError:OSError","StopIteration:Exception",
        "NotImplementedError:RuntimeError","StopAsyncIteration:Exception",
        "Exception:BaseException","KeyboardInterrupt:BaseException","SystemExit:BaseException",
        "AssertionError:Exception","MemoryError:Exception","RecursionError:RuntimeError",
        "UnicodeError:ValueError","UnicodeDecodeError:UnicodeError","UnicodeEncodeError:UnicodeError",
        "SyntaxError:Exception","IndentationError:SyntaxError","TabError:IndentationError",
        "PermissionError:OSError","ConnectionError:OSError","TimeoutError:OSError",
        "Warning:Exception","DeprecationWarning:Warning","UserWarning:Warning",
        "bool:int","int:object","float:object","complex:object","str:object",
        "bytes:object","list:object","dict:object","set:object","frozenset:object",
        "tuple:object","bool:object","type:object","int:numbers.Number",
        "float:numbers.Number","bool:numbers.Number",0};
    char buf[128]; int i = 0, j = 0;
    while (a[i] && i < 60) { buf[i] = a[i]; i++; }
    buf[i] = 58; j = i + 1; i = 0;
    while (b[i] && j < 124) { buf[j] = b[i]; j++; i++; }
    buf[j] = 0;
    i = 0;
    while (pairs[i]) { if (d_strcmp(buf, pairs[i]) == 0) return 1; i++; }
    if (d_strcmp(a, b) == 0) return 1;
