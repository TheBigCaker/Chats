                    int k = 0;
                    while (k < pfx) {
                        if (k > 0) cg_indent(g);
                        cg_gen_expr(g, alhs->children[k]);
                        cg_put(g, " = ");
                        cg_put(g, src); cg_put(g, "["); cg_put_int(g, k); cg_put(g, "];\n");
                        k++;
                    }
                    if (k > 0) cg_indent(g);
                    cg_put(g, "int _sl_"); cg_put(g, sname); cg_put(g, " = ");
                    cg_put(g, src); cg_put(g, "_n - "); cg_put_int(g, pfx + sfx); cg_put(g, ";\n");
                    cg_indent(g);
                    cg_put(g, "if (_sl_"); cg_put(g, sname); cg_put(g, " < 0) _sl_"); cg_put(g, sname); cg_put(g, " = 0;\n");
                    cg_indent(g);
                    cg_put(g, "for (int _si = 0; _si < _sl_"); cg_put(g, sname); cg_put(g, "; _si++) { ");
                    cg_put(g, sname); cg_put(g, "[_si] = "); cg_put(g, src); cg_put(g, "["); cg_put_int(g, pfx); cg_put(g, " + _si]; }\n");
                    cg_indent(g);
                    cg_put(g, sname); cg_put(g, "_n = _sl_"); cg_put(g, sname); cg_put(g, ";\n");
                    int sk = 0;
                    while (sk < sfx) {
                        cg_indent(g);
                        cg_gen_expr(g, alhs->children[star_idx + 1 + sk]);
                        cg_put(g, " = ");
                        cg_put(g, src); cg_put(g, "["); cg_put(g, src); cg_put(g, "_n - "); cg_put_int(g, sfx - sk); cg_put(g, "];\n");
                        sk++;
