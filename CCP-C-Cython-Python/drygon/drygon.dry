                     * constant 0 (13_builtins check 8).  Fold a constant range
                     * into per-index comparisons. */
                    int rng_side = 0;
                    const IRNode* rlo_n = 0;
                    const IRNode* rstep_n = 0;
                    long rlo = 0, rhi = 0, rstep = 1;
                    { const IRNode* cr[2]; cr[0] = bl; cr[1] = br; int ci;
                      /* detect on the ORIGINAL operands: cg_eval_tuple_expr turns
                       * `list(range(5))` into something without CALL children,
