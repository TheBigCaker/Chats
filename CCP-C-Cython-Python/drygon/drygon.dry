    static int cg_cls_issub(const char* a, const char* b, int depth) {
        if (!a || !b || !a[0] || !b[0] || depth > 8) return 0;
        if (d_strcmp(a, b) == 0) return 1;
        int i = cg_cls_index(a);
        if (i < 0) return 0;
        int k = 0;
        while (k < cg_cls_nab[i]) {
            const char* br = cg_cls_ab + (i*4 + k)*64;
            if (d_strcmp(br, b) == 0) return 1;
            if (cg_cls_issub(br, b, depth + 1)) return 1;
