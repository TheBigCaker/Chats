                char* dp = 0;
                int n = 0;
                int want = (width > 0) ? width : 1;
                if (!suppress) dp = va_arg(ap, char*);
                while (n < want && *s) {
                    if (dp) {
                        if (len == 3) { int* wp = (int*)dp; wp[n] = (int)*s; }
