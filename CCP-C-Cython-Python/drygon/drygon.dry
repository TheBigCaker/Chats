/* the value expression of `kw=<expr>`, or NULL */
static const IRNode* cg_sp_kwnode(const IRNode* c, const char* kw) {
    int i = 0;
    if (!c) return 0;
    while (i < c->nchildren) {
        const IRNode* a = c->children[i];
        if (a && d_strcmp(a->type,"KWARG")==0 && a->value && d_strcmp(a->value,kw)==0)
