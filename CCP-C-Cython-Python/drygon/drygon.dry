                                    cg_gen_expr(g, rhs); emitted = 1;
                                } else {
                                    cg_put(g, c_is_str ? "\"\"" : "0"); emitted = 1;
                                }
                            }
                        }
                        if (!emitted) cg_put(g, c_is_str ? "\"\"" : "0");
                        cg_put(g, ";\n");
                    }
                }
            }
            cg_put(g, "typedef struct "); cg_put(g, n->value); cg_put(g, " {\n");
            g->indent++;
            cg_mem_reset();
            if (body) {
                for (int i=0;i<body->nchildren;i++) {
                    const IRNode* c = body->children[i];
                    if (d_strcmp(c->type,"VAR_DECL")==0) {
                        if (cg_lf_is(n->value, c->value)) continue; /* list field emitted by cg_lf */
                        if (cg_mem_seen(c->value)) continue;
                        /* `address: Address` is a POINTER: the constructor stores
                         * the sub-object's address and reads go through `->`.
                         * By value the flat asdict() handed the raw member to a
                         * `char*` slot and a nested read dereferenced the struct
                         * bytes (37_dataclasses check 30). */
                        char _fdb[64];
                        const char* _fdn = c->data_type[0] ? cg_strip_q(c->data_type, _fdb, 63) : "";
                        cg_indent(g);
                        if (_fdn[0] && cg_is_class(_fdn)) {
                            cg_put(g, _fdn); cg_put(g, "* ");
                        } else {
                            cg_put(g, ir_to_c_type(c->data_type)); cg_put(g, " ");
                        }
                        cg_put(g, c->value); cg_put(g, ";\n");
                    } else if (d_strcmp(c->type,"ARRAY_DECL")==0) {
                        if (cg_lf_is(n->value, c->value)) continue;
                        if (cg_mem_seen(c->value)) continue;
                        cg_indent(g); cg_put(g, ir_to_c_type(c->data_type)); cg_put(g, " "); cg_put(g, c->value); cg_put(g, "[");
                        if (c->nchildren>0) cg_gen_expr(g, c->children[0]);
                        cg_put(g, "];\n");
                    } else if (d_strcmp(c->type,"ASSIGN")==0 && c->nchildren>0 && d_strcmp(c->children[0]->type,"IDENTIFIER")==0) {
                        if (cg_mem_seen(c->children[0]->value)) continue;
                        /* A string-valued class attribute is a `char*` FIELD as
                         * well: `typedef struct Obj { int name; }` made
                         * `o.name` an integer, so `f"{o.name}"` printed a
                         * number. */
                        int f_is_str = 0;
                        if (c->nchildren>1 && d_strcmp(c->children[1]->type,"CONSTANT")==0 &&
                            (d_strcmp(c->children[1]->data_type,"STR")==0 ||
                             d_strcmp(c->children[1]->data_type,"FSTR")==0))
                            f_is_str = 1;
