    if (d_strcmp(n, "pathlib") == 0) {
        d_strncpy(dst + 0, "# pathlib -- pure path objects over the drygon-native FS layer.\n#\n# The native layer publishes the raw syscall work (drygon_path_*, drygon_fs_*)\n# and this module shapes it into the python API.  Everything is expressed with\n# operations the compiler already lowers: counted str lists built by append,\n# `splitlines()` for the newline-separated native results, and one-line\n# `@property` getters that hand a native string back.\n\n\nclass Path:\n    def __init__(self, s):\n        if s == \"\":\n            self._s = \".\"\n        else:\n            self._s = s\n\n    def __str__(self):\n        return self._s\n\n    def __repr__(self):\n        return self._s\n\n    def __fspath__(self):\n        return self._s\n\n    def __hash__(self):\n        return drygon_path_len(self._s)\n\n    def __eq__(self, o):\n        return drygon_streq(self._s, o._s)\n\n    def __ne__(self, o):\n        return drygon_streq(self._s, o._s) == 0\n\n    def __truediv__(self, o):\n        return Path(drygon_path_join(self._s, o))\n\n    def __rtruediv__(self, o):\n        return Path(drygon_path_join(o, self._s))\n\n    @property\n    def name(self):\n        return drygon_path_name(self._s)\n\n    @property\n    def stem(self):\n        return drygon_path_stem(self._s)\n\n    @property\n    def suffix(self):\n        return drygon_path_suffix(self._s)\n\n    @property\n    def suffixes(self):\n        out = []\n        nm = self._s\n        n = drygon_path_len(drygon_path_name(nm))\n        dot = 0 - 1\n        i = 1\n        while i < n:\n            if dot < 0:\n                if drygon_path_charis(drygon_path_name(nm), i, 46):\n                    dot = i\n            i = i + 1\n        if dot >= 0:\n            start = dot\n            i = dot + 1\n            while i <= n:\n         ", 1728);
