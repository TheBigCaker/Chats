            cg_put(g, "int _tr = 0; int _th = "); cg_put(g, dst); cg_put(g, "_n - 1;\n");
            cg_indent(g);
            cg_put(g, "while (_tr < _th) {\n");
            g->indent++;
            cg_indent(g);
            cg_put(g, "char* _tc = "); cg_put(g, dst); cg_put(g, "_lx[_tr];\n");
            cg_indent(g);
            cg_put(g, dst); cg_put(g, "_lx[_tr] = "); cg_put(g, dst); cg_put(g, "_lx[_th];\n");
