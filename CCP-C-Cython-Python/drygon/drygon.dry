                }
                cg_of_scan(cg_cls_names[cg_cls_n - 1], body);
                cg_oe_scan(cg_cls_names[cg_cls_n - 1], body);
                int fi2 = 0;
                while (fi2 < cnf) {
                    /* a field holding an INSTANCE of another class is a POINTER
                     * to that class' struct, not a `char*`/`int` (cg_of_*) */
                    const char* _oft = cg_of_get(cg_cls_names[cg_cls_n - 1], cfn + fi2*64);
                    /* the body already emitted this member (annotation or class
                     * attribute): the member list must not repeat it */
                    if (cg_mem_seen(cfn + fi2*64)) { fi2++; continue; }
                    if (_oft && _oft[0]) {
                        cg_indent(g);
                        cg_put(g, _oft); cg_put(g, "* "); cg_put(g, cfn + fi2*64);
                        cg_put(g, ";\n");
                        fi2++;
