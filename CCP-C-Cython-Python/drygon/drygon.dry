        for (; i < n; i++) dst[i] = (b[i] != 0.0f) ? (a[i] / b[i]) : 0.0f;
        #endif
    }
    static inline void neon_neg(float *dst, const float *a, int n) {
        #ifdef __ARM_NEON
        int i = 0;
        for (; i <= n - 4; i += 4) vst1q_f32(dst + i, vnegq_f32(vld1q_f32(a + i)));
        for (; i < n; i++) dst[i] = -a[i];
        #endif
    }
    static inline void neon_abs(float *dst, const float *a, int n) {
        #ifdef __ARM_NEON
        int i = 0;
        for (; i <= n - 4; i += 4) vst1q_f32(dst + i, vabsq_f32(vld1q_f32(a + i)));
        for (; i < n; i++) dst[i] = (a[i] < 0.0f) ? -a[i] : a[i];
        #endif
    }
    static inline void neon_zero(float *dst, int n) {
        #ifdef __ARM_NEON
        float32x4_t z = vdupq_n_f32(0.0f);
        int i = 0;
        for (; i <= n - 4; i += 4) vst1q_f32(dst + i, z);
        for (; i < n; i++) dst[i] = 0.0f;
        #endif
    }
    static inline void neon_range(float *dst, float start, float step, int n) {
        #ifdef __ARM_NEON
        float32x4_t four = vdupq_n_f32(4.0f * step);
        float base[4] = {start, start + step, start + 2.0f * step, start + 3.0f * step};
        float32x4_t v = vld1q_f32(base);
        int i = 0;
        for (; i <= n - 4; i += 4) {
            vst1q_f32(dst + i, v);
            v = vaddq_f32(v, four);
        }
        for (; i < n; i++) dst[i] = start + step * i;
        #endif
