static inline float32x4_t vld1q_f32(const float *p) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = p[i];
    return r;
}
static inline uint32x4_t vld1q_u32(const unsigned int *p) {
