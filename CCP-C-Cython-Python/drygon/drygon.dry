                else if (a && d_strcmp(a->type,"IDENTIFIER")==0 && cg_is_dict(a->value))
                    cg_put(g, "6");
                else cg_put(g, "2");
            } else if (d_strcmp(n->value,"float")==0 && n->nchildren==1) {
