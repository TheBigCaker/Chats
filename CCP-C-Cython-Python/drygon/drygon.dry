                 * entered its `except TypeError` (34_abc 1/4/7/15). */
                if (cg_cls_is_abstract(cn, 0)) {
                    cg_indent(g);
                    cg_put(g, "py_raise_str(\"TypeError\", \"Can't instantiate abstract class ");
                    cg_put(g, cn);
                    cg_put(g, "\");\n");
                }
                cg_put(g, cn); cg_put(g, " "); cg_put(g, alhs->value); cg_put(g, ";\n");
                cg_lf_zero_ctor(g, cn, alhs->value, ".");
                if (cg_cls_hasm(cn, "__init__")) {
                    cg_indent(g);
                    cg_put(g, cn); cg_put(g, "___init__(&"); cg_put(g, alhs->value);
                    {
                        int cbi = cg_cls_index(cn);
                        const IRNode* cbb = (cbi >= 0) ? cg_cls_body[cbi] : NULL;
                        int ai = 0;
                        while (ai < arhs->nchildren) {
                            cg_put(g, ", ");
                            const IRNode* av = arhs->children[ai];
                            /* `Point(x=3, y=4)`: the argument is the KWARG's
                             * value, not its name. */
                            if (av && d_strcmp(av->type,"KWARG")==0 && av->nchildren>0)
                                av = av->children[0];
                            if (!cg_emit_obj_arg(g, cn, "__init__", ai, av))
