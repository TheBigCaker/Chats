                advance(p);
                IRNode* fn = ir_new("FUNCTION_DEF", lhs, "VOID");
                IRNode* params = ir_new("BLOCK", "PARAMS", "ANY");
                while (pk(p)->kind == TOK_NAME) {
                    ir_add_child(params, ir_new("PARAM_DECL", pk(p)->text, "ANY"));
                    advance(p);
                    if (pk(p)->kind == TOK_COMMA) { advance(p); continue; }
                    break;
                }
                ir_add_child(fn, params);
                if (pk(p)->kind == TOK_COLON) advance(p);
                IRNode* body = ir_new("BLOCK", "", "ANY");
                IRNode* ret = ir_new("RETURN", "", "ANY");
                IRNode* ex = parse_expr(p);
                if (ex) {
                    /* infer the return kind so call sites pick the format */
                    if (d_strcmp(ex->data_type,"STR")==0 || d_strcmp(ex->data_type,"FSTR")==0) d_strncpy(fn->data_type,"STR",15);
                    else if (d_strcmp(ex->data_type,"FLOAT")==0) d_strncpy(fn->data_type,"FLOAT",15);
                    else d_strncpy(fn->data_type,"INT",15);
                    ir_add_child(ret, ex);
