        d_strncpy(dst + 3459, "        return out\n\n    def rglob(self, pat):\n        out = []\n        parts = drygon_fs_rglob(self._s, pat).splitlines()\n        i = 0\n        while i < len(parts):\n            out.append(drygon_path_join(\"\", parts[i]))\n            i = i + 1\n        return out\n\n    def mkdir(self):\n        return drygon_fs_mkdir(self._s)\n\n    def mkdirp(self):\n        return drygon_fs_mkdirp(self._s)\n\n    def rmdir(self):\n        return drygon_fs_rmdir(self._s)\n\n    def unlink(self):\n        return drygon_fs_unlink(self._s)\n\n    def touch(self):\n        return drygon_fs_write(self._s, \"\")\n\n    def rename(self, o):\n        return drygon_fs_rename(self._s, o)\n\n    def stat_size(self):\n        return drygon_fs_size(self._s)\n\n    def write_text(self, data):\n        return drygon_fs_write(self._s, data)\n\n    def write_bytes(self, data):\n        return drygon_fs_write(self._s, data)\n\n    def read_text(self):\n        return drygon_fs_read(self._s)\n\n    def read_bytes(self):\n        return drygon_fs_read(self._s)\n\n    def with_suffix(self, sfx):\n        return Path(drygon_path_with_suffix(self._s, sfx))\n\n    def with_name(self, nm):\n        return Path(drygon_path_with_name(self._s, nm))\n\n    def joinpath(self, a, b=\"\"):\n        return Path(drygon_path_join(drygon_path_join(self._s, a), b))\n\n", 1289);
