                while (k < arhs->nchildren) {
                    if (d_strcmp(arhs->children[k]->type,"KWARG")==0 &&
                        arhs->children[k]->nchildren>0) {
                        const IRNode* kv = arhs->children[k];
                        if (nk > 0) cg_indent(g);
                        cg_put(g, alhs->value); cg_put(g, "_k[");
                        cg_put_int(g, nk); cg_put(g, "] = \"");
                        cg_put(g, kv->value);
                        cg_put(g, "\";\n");
                        cg_indent(g);
                        cg_put(g, alhs->value); cg_put(g, "_v[");
                        cg_put_int(g, nk); cg_put(g, "] = ");
                        if (vf == 2 && !cg_node_is_str_static(kv->children[0]))
                            cg_strify(g, kv->children[0]);
                        else cg_gen_expr(g, kv->children[0]);
                        cg_put(g, ";\n");
                        nk++;
                    }
                    k++;
                }
                /* a keyword argument whose key is only known at run time rides
                 * in a hoisted temp dict (`cg_hoist_kw_dicts`), which collapses
                 * the keywords into one DSTAR_KW marker -- so the literal case
                 * above finds no KWARG children and must copy the temp instead
                 * (11_functions check 11). */
                if (nk == 0) {
                    const char* ksrc = NULL;
                    k = 0;
                    while (k < arhs->nchildren) {
                        if (d_strcmp(arhs->children[k]->type,"DSTAR_KW")==0 &&
                            arhs->children[k]->value && d_strcmp(arhs->children[k]->value,"KW")==0 &&
                            arhs->children[k]->nchildren > 0 && arhs->children[k]->children[0] &&
                            d_strcmp(arhs->children[k]->children[0]->type,"IDENTIFIER")==0)
                            ksrc = arhs->children[k]->children[0]->value;
                        k++;
                    }
                    if (ksrc) {
                        cg_indent(g);
                        cg_put(g, "{ int _dci = 0; while (_dci < ");
                        cg_put(g, ksrc); cg_put(g, "_n) { ");
                        cg_put(g, alhs->value); cg_put(g, "_k[_dci] = ");
                        cg_put(g, ksrc); cg_put(g, "_k[_dci]; ");
                        cg_put(g, alhs->value); cg_put(g, "_v[_dci] = ");
                        cg_put(g, ksrc);
                        cg_put(g, vf == 2 ? "_s[_dci]" : (vf == 1 ? "_d[_dci]" : "_v[_dci]"));
                        cg_put(g, "; _dci = _dci + 1; } }\n");
                        cg_indent(g);
                        cg_put(g, alhs->value); cg_put(g, "_n = ");
                        cg_put(g, ksrc); cg_put(g, "_n;\n");
                        return;
                    }
                }
                cg_indent(g);
                cg_put(g, alhs->value); cg_put(g, "_n = ");
                cg_put_int(g, nk);
                cg_put(g, ";\n");
                return;
            }
            /* `obj[k] = v` on a user class dispatches to the class' __setitem__,
             * exactly as the read side dispatches to __getitem__.  Only the
             * method existed before: `d["a"] = 1` on such a class fell through
             * to the dict store.  This is deliberately checked BEFORE the dict
             * branch below and without consulting cg_is_dict: the dict prescan
             * registers any name subscripted with a literal string key, so the
             * instance name is in that table too and the dispatch would never
             * run.  An instance with __setitem__ is by definition not a dict. */
            if (alhs && arhs && d_strcmp(n->value,"=")==0 &&
                d_strcmp(alhs->type,"ARRAY_ACCESS")==0 && alhs->nchildren>1 &&
                alhs->children[0] && d_strcmp(alhs->children[0]->type,"IDENTIFIER")==0) {
                const char* _soc = cg_cvar_class(alhs->children[0]->value);
                const char* _som = (_soc && _soc[0]) ? cg_cls_find_m(_soc, "__setitem__") : 0;
                if (_som && _som[0]) {
                    cg_put(g, _som); cg_put(g, "___setitem__(&");
                    cg_put(g, alhs->children[0]->value);
                    cg_put(g, ", ");
                    cg_gen_expr(g, alhs->children[1]);
                    cg_put(g, ", ");
                    cg_gen_expr(g, arhs);
                    cg_put(g, ");\n");
                    return;
                }
            }
            /* `d[k] = v` on a dict: store in place, appending when the key is
             * new.  The helper returns the new count, so no address-of.
             * Only the plain store: an augmented assignment has to read the
             * old value first and is handled below (this branch used to
             * swallow `d[k] += 1` and store the operand as the new value, so
             * the counter pattern never counted past one). */
            if (alhs && arhs && d_strcmp(n->value,"=")==0 &&
                d_strcmp(alhs->type,"ARRAY_ACCESS")==0 &&
                alhs->nchildren>1 && d_strcmp(alhs->children[0]->type,"IDENTIFIER")==0 &&
                cg_is_dict(alhs->children[0]->value)) {
                const char* dn = alhs->children[0]->value;
                int vf = cg_dict_vf(dn);
                cg_put(g, dn); cg_put(g, "_n = drygon_dset_");
                cg_put(g, vf == 2 ? "s" : (vf == 1 ? "d" : "i"));
                cg_put(g, cg_dict_kf(dn) ? "s(" : "i(");
                cg_put(g, dn); cg_put(g, "_k, "); cg_put(g, dn); cg_put(g, "_v, ");
                cg_put(g, dn); cg_put(g, "_n, ");
                cg_gen_dict_key(g, alhs->children[1]);
                cg_put(g, ", ");
                if (vf == 2 && !cg_node_is_str_static(arhs)) cg_strify(g, arhs);
                else cg_gen_expr(g, arhs);
                cg_put(g, ");\n");
                return;
            }
            /* `ys = xs[a:b]` — python slicing builds a new list; the slice
             * helper copies the selection straight into `ys` (see cg_sl_fill,
             * which emits that copy just before this statement). */
            if (cg_sl_assign_target(n)) return;
            /* `m = [[1, 2], [3, 4]]` and `t = [1, [2, 3], 4]` — a nested list
             * literal needs per-row backing arrays (or a compile-time repr
             * array for the mixed shape); the flat path below would try to
             * store a list literal into an int slot. */
            if (alhs && arhs && d_strcmp(alhs->type,"IDENTIFIER")==0 && cg_is_list_node(arhs)) {
                int k = 0;
                int hasnest = 0;
                int allnest = arhs->nchildren > 0;
                int anytrow = 0;
                while (k < arhs->nchildren) {
                    const IRNode* el = arhs->children[k];
                    if (cg_is_list_node(el)) hasnest = 1;
                    else allnest = 0;
                    if (el && d_strcmp(el->type,"BLOCK")==0 && d_strcmp(el->value,"TUPLE")==0)
                        anytrow = 1;
                    k++;
                }
                if (anytrow) {
                    /* tuple rows: rows keep their compile-time repr (parens),
                     * their row node for destructuring, and the first two
                     * elements in the key tables; non-tuple elements still
                     * live in the int slots so the mixed repr can show them */
                    int alltrow = 1;
                    k = 0;
                    while (k < arhs->nchildren) {
                        const IRNode* el = arhs->children[k];
                        if (!el || d_strcmp(el->type,"BLOCK")!=0 ||
                            d_strcmp(el->value,"TUPLE")!=0) alltrow = 0;
                        k++;
                    }
                    cg_note_list(alhs->value, arhs->nchildren, 0);
                    cg_note_lx(alhs->value);
                    if (alltrow) cg_note_trow(alhs->value);
                    k = 0;
                    while (k < arhs->nchildren) {
                        const IRNode* el = arhs->children[k];
                        int isrow = el && d_strcmp(el->type,"BLOCK")==0 &&
                            d_strcmp(el->value,"TUPLE")==0;
                        cg_indent(g);
                        cg_gen_expr(g, alhs);
                        cg_put(g, "[");
                        cg_put_int(g, k);
                        cg_put(g, "] = ");
                        if (isrow) cg_put(g, "0");
                        else cg_gen_expr(g, el);
                        cg_put(g, ";\n");
                        cg_indent(g);
                        cg_gen_expr(g, alhs);
                        cg_put(g, "_lx[");
                        cg_put_int(g, k);
                        cg_put(g, "] = \"");
                        if (isrow) {
                            cg_lit_repr_emit(g, el);
                            cg_put(g, "\";\n");
                            cg_note_row(alhs->value, k, el);
                            int j = 0;
                            while (j < el->nchildren && j < 2) {
                                const IRNode* ke = el->children[j];
                                int isstr = cg_node_is_str_static(ke);
                                cg_indent(g);
                                cg_gen_expr(g, alhs);
                                cg_put(g, isstr ? (j == 0 ? "_s0[" : "_s1[") :
                                                 (j == 0 ? "_k0[" : "_k1["));
                                cg_put_int(g, k);
                                cg_put(g, "] = ");
                                cg_gen_expr(g, ke);
                                cg_put(g, ";\n");
                                cg_note_rowkey(alhs->value,
                                    isstr ? (j == 0 ? 4 : 8) : (j == 0 ? 1 : 2));
                                j++;
                            }
                            k++;
                            continue;
                        }
                        cg_put(g, "\";\n");;
                        if (el) {
                            if (cg_is_str_node(el)) {
                                cg_forget_str(alhs->value);
                            }
                        }
                        cg_put(g, ";\n");
                        k++;
                    }
                    cg_indent(g);
                    cg_gen_expr(g, alhs);
                    cg_put(g, "_n = ");
                    cg_put_int(g, arhs->nchildren);
                    cg_put(g, ";\n");
                    return;
                }
                if (hasnest && allnest) {
                    /* homogeneous 2D: rows flatten into NAME_back with per-row
                     * offsets and lengths (no pointers: the direct compiler
                     * miscompiles arrays of int*).  The backing store's element
                     * type has to match the row elements: a text row written
                     * into an `int` store lost the upper half of every field
                     * pointer. */
                    int _tk = 0;
                    int _allstr = 1;
                    int _allflt = 1;
                    k = 0;
                    while (k < arhs->nchildren) {
                        int j = 0;
                        while (j < arhs->children[k]->nchildren) {
                            const IRNode* _el = arhs->children[k]->children[j];
                            if (!cg_node_is_str_static(_el)) _allstr = 0;
                            if (!cg_is_float_node(_el)) _allflt = 0;
                            j++;
                        }
                        k++;
                    }
                    if (_allstr) _tk = 1;
                    else if (_allflt) _tk = 2;
                    cg_note_list(alhs->value, 0, 0);
                    cg_note_twod_k(alhs->value, _tk);
                    int cur = 0;
                    k = 0;
                    while (k < arhs->nchildren) {
                        const IRNode* row = arhs->children[k];
                        cg_indent(g);
                        cg_put(g, alhs->value);
                        cg_put(g, "_off[");
                        cg_put_int(g, k);
                        cg_put(g, "] = ");
                        cg_put_int(g, cur);
                        cg_put(g, ";\n");
                        int col_idx = 0;
                        while (col_idx < row->nchildren) {
                            cg_indent(g);
                            cg_put(g, alhs->value);
                            cg_put(g, "_back[");
                            cg_put_int(g, cur + col_idx);
                            cg_put(g, "] = ");
                            cg_gen_expr(g, row->children[col_idx]);
                            cg_put(g, ";\n");
                            col_idx++;
                        }
                        cg_indent(g);
                        cg_put(g, alhs->value);
                        cg_put(g, "_ln[");
                        cg_put_int(g, k);
                        cg_put(g, "] = ");
                        cg_put_int(g, row->nchildren);
                        cg_put(g, ";\n");
                        cur = cur + row->nchildren;
                        k++;
                    }
                    cg_indent(g);
                    cg_put(g, alhs->value);
                    cg_put(g, "_n = ");
                    cg_put_int(g, arhs->nchildren);
                    cg_put(g, ";\n");
                    return;
                }
                if (hasnest) {
                    /* mixed shape: int slots keep placeholder zeros and the
                     * compile-time repr of each list row lands in NAME_lx */
                    cg_note_list(alhs->value, arhs->nchildren, 0);
                    cg_note_lx(alhs->value);
                    k = 0;
                    while (k < arhs->nchildren) {
                        const IRNode* el = arhs->children[k];
                        int isrow = cg_is_list_node(el) ||
                            (el && d_strcmp(el->type,"BLOCK")==0 &&
                             d_strcmp(el->value,"TUPLE")==0);
                        cg_indent(g);
                        cg_gen_expr(g, alhs);
                        cg_put(g, "[");
                        cg_put_int(g, k);
                        cg_put(g, "] = ");
                        if (isrow) cg_put(g, "0");
                        else cg_gen_expr(g, el);
                        cg_put(g, ";\n");
                        if (isrow) {
                            cg_indent(g);
                            cg_gen_expr(g, alhs);
                            cg_put(g, "_lx[");
                            cg_put_int(g, k);
                            cg_put(g, "] = \"");
                            cg_lit_repr_emit(g, el);
                            cg_put(g, "\";\n");
                            if (el && d_strcmp(el->type,"BLOCK")==0 &&
                                d_strcmp(el->value,"TUPLE")==0) {
                                cg_note_row(alhs->value, k, el);
                                int j = 0;
                                while (j < el->nchildren && j < 2) {
                                    const IRNode* ke = el->children[j];
                                    int isstr = cg_node_is_str_static(ke);
                                    cg_indent(g);
                                    cg_gen_expr(g, alhs);
                                    cg_put(g, isstr ? (j == 0 ? "_s0[" : "_s1[") :
                                                     (j == 0 ? "_k0[" : "_k1["));
                                    cg_put_int(g, k);
                                    cg_put(g, "] = ");
                                    cg_gen_expr(g, ke);
                                    cg_put(g, ";\n");
                                    cg_note_rowkey(alhs->value,
                                        isstr ? (j == 0 ? 4 : 8) : (j == 0 ? 1 : 2));
                                    j++;
                                }
                            }
                        }
                        k++;
                    }
                    cg_indent(g);
                    cg_gen_expr(g, alhs);
                    cg_put(g, "_n = ");
                    cg_put_int(g, arhs->nchildren);
                    cg_put(g, ";\n");
                    return;
                }
            }
            /* object list literal: `objs = [Obj("b", 2), Obj("a", 1)]` -- the
             * element slots are sentinels, so the constructor arguments are
             * stored into the per-attribute column arrays instead. */
            if (alhs && arhs && d_strcmp(alhs->type,"IDENTIFIER")==0 &&
                d_strcmp(arhs->type,"CALL")!=0 && cg_is_list_node(arhs) &&
                cg_ob_lookup(alhs->value) >= 0) {
                int _oi = cg_ob_lookup(alhs->value);
                int _ost = 0;
                int _occ = 0;
                while (_occ < cg_ob_lncol[_oi]) {
                    int _ok2 = 0;
                    while (_ok2 < arhs->nchildren) {
                        const IRNode* _oe = arhs->children[_ok2];
                        if (_oe && _oe->nchildren > _occ) {
                            if (_ost > 0) cg_indent(g);
                            _ost++;
                            cg_put(g, cg_ob_lcn[_oi*8 + _occ]);
                            cg_put(g, "[");
                            cg_put_int(g, _ok2);
                            cg_put(g, "] = ");
                            if (cg_ob_lkind[_oi*8 + _occ] == 2) cg_strify(g, _oe->children[_occ]);
                            else cg_gen_expr(g, _oe->children[_occ]);
                            cg_put(g, ";\n");
                        }
                        _ok2++;
                    }
                    _occ++;
                }
                cg_indent(g);
                cg_put(g, alhs->value); cg_put(g, "_n = ");
                cg_put_int(g, arhs->nchildren);
                cg_put(g, ";\n");
                return;
            }
            /* `xs = [1, 2, 3]` — a python list literal becomes a file-scope C
             * array (declared in the generated header) plus one store per
             * element.  Emitting `xs = {1, 2, 3};` is not C. */
            if (alhs && arhs && d_strcmp(alhs->type,"IDENTIFIER")==0 && cg_is_list_node(arhs)) {
                int isf = 0;
                int k = 0;
                int hf = 0;
                int hs = 0;
                int hall = 1;
                while (k < arhs->nchildren) {
                    if (cg_is_float_node(arhs->children[k])) hf = 1;
                    if (cg_node_is_str_static(arhs->children[k])) hs = 1;
                    else hall = 0;
                    k++;
                }
                if (hs) isf = 2;
                else if (hf) isf = 1;
                cg_note_list(alhs->value, arhs->nchildren, isf);
                if (d_strcmp(arhs->value,"TUPLE")==0) cg_note_tuple(alhs->value);
                else cg_forget_tuple(alhs->value);
                isf = cg_list_flags_at(alhs->value);
                if (isf == 2 && !hall) cg_note_mixed(alhs->value);
                cg_forget_str(alhs->value);
                k = 0;
                while (k < arhs->nchildren) {
                    cg_gen_expr(g, alhs);
                    cg_put(g, "[");
                    cg_put_int(g, k);
                    cg_put(g, "] = ");
                    if (isf == 2 && !cg_node_is_str_static(arhs->children[k]))
                        cg_strify(g, arhs->children[k]);
                    else if (isf == 1 && !cg_is_float_node(arhs->children[k]) &&
                             !cg_node_is_str_static(arhs->children[k])) {
                        /* int into a double slot: force the conversion, the
                         * raw int bits would land in the array otherwise */
                        cg_put(g, "(");
                        cg_gen_expr(g, arhs->children[k]);
                        cg_put(g, ") + 0.0");
                    }
                    else cg_gen_expr(g, arhs->children[k]);
                    cg_put(g, ";\n");
                    k++;
                    if (k < arhs->nchildren) cg_indent(g);
                }
                if (cg_list_is_mixed(alhs->value)) {
                    k = 0;
                    while (k < arhs->nchildren) {
                        cg_indent(g);
                        cg_gen_expr(g, alhs);
                        cg_put(g, "_t[");
                        cg_put_int(g, k);
                        cg_put(g, "] = ");
                        cg_put_int(g, cg_node_is_str_static(arhs->children[k]) ? 1 : 0);
                        cg_put(g, ";\n");
                        k++;
                    }
                }
                cg_indent(g);
                cg_gen_expr(g, alhs);
                cg_put(g, "_n = ");
                cg_put_int(g, arhs->nchildren);
                cg_put(g, ";\n");
                return;
            }
            if (alhs && arhs && d_strcmp(alhs->type,"IDENTIFIER")==0) {
                /* `s += t` on a string concatenates (python); in C it would be
                 * pointer arithmetic. The name stays string-valued. */
                if (d_strcmp(n->value,"+=")==0 && cg_is_str_node(alhs)) {
                    /* python raises TypeError when the right side is not a
                     * string: never silently stringify a numeric constant */
                    if (d_strcmp(arhs->type,"CONSTANT")==0 &&
                        d_strcmp(arhs->data_type,"STR")!=0 &&
                        d_strcmp(arhs->data_type,"FSTR")!=0) {
                        cg_put(g, "py_raise_str(\"TypeError\", \"can only concatenate str (not \\\"");
                        cg_put(g, d_strcmp(arhs->data_type,"FLOAT")==0 ? "float" : "int");
                        cg_put(g, "\\\") to str\");\n");
                        if (cg_in_main && cg_try_depth == 0) {
                            cg_put(g, "printf(\"%s: %s\\n\", pyx_type_s(), pyx_repr());\n");
                            cg_put(g, "return 1;\n");
                        }
                        return;
                    }
                    cg_put(g, alhs->value);
                    cg_put(g, " = str_concat(");
                    cg_put(g, alhs->value);
                    cg_put(g, ", ");
                    cg_strify(g, arhs);
                    cg_put(g, ");\n");
                    return;
                }
                /* `parts = s.split(sep)` — python's split yields a list of
                 * strings.  Backed by a file-scope char* array plus a runtime
                 * element count, so len()/indexing/iteration all work. */
                if (d_strcmp(arhs->type,"CALL")==0 && d_strcmp(arhs->value,"COMPLEX")==0 &&
                    arhs->nchildren>0 && d_strcmp(arhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                    (d_strcmp(arhs->children[0]->value,"split")==0 ||
                     d_strcmp(arhs->children[0]->value,"rsplit")==0) &&
                    arhs->children[0]->nchildren>0 &&
                    cg_is_str_node(arhs->children[0]->children[0])) {
                    const IRNode* b = arhs->children[0]->children[0];
                    int arm = (d_strcmp(arhs->children[0]->value,"rsplit")==0) && arhs->nchildren>2;
                    cg_note_strlist(alhs->value);
                    cg_forget_str(alhs->value);
                    cg_put(g, alhs->value); cg_put(g, "_n = ");
                    cg_put(g, arm ? "drygon_rsplit(" : "drygon_split(");
                    cg_put(g, alhs->value);
                    cg_put(g, ", ");
                    cg_gen_expr(g, b);
                    cg_put(g, ", ");
                    if (arhs->nchildren>1) cg_gen_expr(g, arhs->children[1]);
                    else cg_put(g, "\"\"");
                    if (arm) { cg_put(g, ", "); cg_gen_expr(g, arhs->children[2]); }
                    cg_put(g, ", 64);\n");
                    return;
                }
                /* `b = a.copy()` — a C array cannot be assigned, so duplicate
                 * the elements and the runtime length.  For a dict both the
                 * key and value arrays are duplicated. */
                if (d_strcmp(arhs->type,"CALL")==0 && d_strcmp(arhs->value,"COMPLEX")==0 &&
                    arhs->nchildren>0 && d_strcmp(arhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                    d_strcmp(arhs->children[0]->value,"copy")==0 &&
                    arhs->children[0]->nchildren>0 &&
                    d_strcmp(arhs->children[0]->children[0]->type,"IDENTIFIER")==0 &&
                    (cg_list_index(arhs->children[0]->children[0]->value) >= 0 ||
                     cg_is_dict(arhs->children[0]->children[0]->value))) {
                    const char* csrc = arhs->children[0]->children[0]->value;
                    cg_sw_serial = cg_sw_serial + 1;
                    if (cg_is_dict(csrc)) {
                        cg_put(g, "{ int _dc"); cg_put_int(g, cg_sw_serial);
                        cg_put(g, " = 0; while (_dc"); cg_put_int(g, cg_sw_serial);
                        cg_put(g, " < "); cg_put(g, csrc); cg_put(g, "_n) { ");
                        cg_put(g, alhs->value); cg_put(g, "_k[_dc"); cg_put_int(g, cg_sw_serial);
                        cg_put(g, "] = "); cg_put(g, csrc); cg_put(g, "_k[_dc");
                        cg_put_int(g, cg_sw_serial); cg_put(g, "]; ");
                        cg_put(g, alhs->value); cg_put(g, "_v[_dc"); cg_put_int(g, cg_sw_serial);
                        cg_put(g, "] = "); cg_put(g, csrc); cg_put(g, "_v[_dc");
                        cg_put_int(g, cg_sw_serial); cg_put(g, "]; _dc"); cg_put_int(g, cg_sw_serial);
                        cg_put(g, " = _dc"); cg_put_int(g, cg_sw_serial);
                        cg_put(g, " + 1; } }\n");
                        cg_indent(g);
                        cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put(g, csrc); cg_put(g, "_n;\n");
                        return;
                    }
                    cg_put(g, "{ int _cp"); cg_put_int(g, cg_sw_serial);
                    cg_put(g, " = 0; while (_cp"); cg_put_int(g, cg_sw_serial);
                    cg_put(g, " < "); cg_put(g, csrc); cg_put(g, "_n) { ");
