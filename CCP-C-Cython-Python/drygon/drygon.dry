     * holds (cg_of_*). */
    static void cg_of_walk(const char* cls, const char* meth, const IRNode* ps,
                           const IRNode* nn) {
        if (!nn) return;
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>1 && nn->children[1] &&
            nn->children[0] &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->nchildren>0 && nn->children[0]->children[0] &&
            d_strcmp(nn->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,"self")==0 &&
            nn->children[0]->value && nn->children[0]->value[0]) {
            const IRNode* orhs = nn->children[1];
            const char* oc = 0;
            /* RHS is one of this method's own class-typed PARAMETERS */
            if (d_strcmp(orhs->type,"IDENTIFIER")==0 && orhs->value &&
                orhs->value[0]) {
                int idx = 0;
                int found = 0;
                int j = 0;
                if (ps) {
                    while (j < ps->nchildren) {
                        const IRNode* p = ps->children[j];
                        if (p && p->value && d_strcmp(p->value,"self")!=0 &&
                            d_strcmp(p->value,"cls")!=0) {
                            if (d_strcmp(p->value, orhs->value)==0) { found = 1; break; }
                            idx++;
                        }
                        j++;
