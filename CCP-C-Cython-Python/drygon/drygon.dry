                    if (cmr2 >= 0) return cmr2 == 2;
                }
                return 0;
            }
            if (d_strcmp(a->value,"COMPLEX")==0) {
                if (a->nchildren>0 && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0) {
                    /* `obj.method()` on a known class -> the method's own
                     * return type (an inherited `describe` returning a string
                     * otherwise compared as a pointer) */
                    const IRNode* crc = a->children[0]->nchildren>0 ? a->children[0]->children[0] : NULL;
                    if (crc && d_strcmp(crc->type,"IDENTIFIER")==0) {
                        const char* cv2 = cg_cvar_class(crc->value);
                        if (!cv2 && cg_is_class(crc->value)) cv2 = crc->value;
                        if (cv2) {
                            int cmt = cg_cls_mret_find(cv2, a->children[0]->value, 0);
                            if (cmt >= 0) return cmt == 2;
