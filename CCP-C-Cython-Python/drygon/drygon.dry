    static char cg_gs_cls[128][32];
    static int cg_gs_n;
    static int cg_scratch_cls(const char* cls) {
        if (!cls || !cls[0]) return -1;
        int i = 0;
        while (i < cg_gs_n) { if (d_strcmp(cg_gs_cls[i], cls)==0) return i; i++; }
        if (cg_gs_n >= 128) return -1;
        d_strncpy(cg_gs_cls[cg_gs_n], cls, 31);
        cg_gs_cls[cg_gs_n][31] = 0;
        cg_gs_n = cg_gs_n + 1;
        return cg_gs_n - 1;
