/* NEON compatibility layer, natively implemented inline
 * Serves every NEON interface in this one file — no external header anywhere. */
#ifndef _ARM_NEON_H
#define _ARM_NEON_H 1

/* Baccyn NEON compatibility layer ------------------------------------------
 * Baccyn has no SIMD instruction selection, so the Advanced SIMD *interfaces*
 * are realized here as 16-byte aggregates with the ARM-specified element
 * layout (and the ARM-specified rounding / bit-select / message-schedule
 * semantics for every operation).  Programs using the NEON interfaces
 * compile against these declarations with no source changes and no scalar
 * fallback branch.
 * ------------------------------------------------------------------------ */

#define __ARM_NEON 1
#define __ARM_NEON__ 1
#define __ARM_FEATURE_SHA2 1

typedef struct { float v[4]; } float32x4_t;
typedef struct { float v[2]; } float32x2_t;
typedef struct { unsigned char v[16]; } uint8x16_t;
typedef struct { unsigned int v[4]; } uint32x4_t;
typedef struct { int v[4]; } int32x4_t;
typedef struct { unsigned int v[2]; } uint32x2_t;
typedef struct { int v[2]; } int32x2_t;
typedef struct { unsigned long v[2]; } uint64x2_t;

/* --- scalar bit reinterpretation ---------------------------------------- */
static inline unsigned int __neon_fbits(float f) {
    unsigned int u;
    unsigned char *d = (unsigned char *)&u;
    const unsigned char *s = (const unsigned char *)&f;
    int i;
    for (i = 0; i < 4; i++) d[i] = s[i];
    return u;
}
static inline void __neon_putbits(float *lane, unsigned int u) {
    unsigned char *d = (unsigned char *)lane;
    const unsigned char *s = (const unsigned char *)&u;
    int i;
    for (i = 0; i < 4; i++) d[i] = s[i];
}
static inline unsigned int __neon_ror(unsigned int x, int n) {
    return (x >> n) | (x << (32 - n));
}
static inline unsigned int __neon_bsig0(unsigned int x) {
    return __neon_ror(x, 2) ^ __neon_ror(x, 13) ^ __neon_ror(x, 22);
}
static inline unsigned int __neon_bsig1(unsigned int x) {
    return __neon_ror(x, 6) ^ __neon_ror(x, 11) ^ __neon_ror(x, 25);
}
static inline unsigned int __neon_ssig0(unsigned int x) {
    return __neon_ror(x, 7) ^ __neon_ror(x, 18) ^ (x >> 3);
}
static inline unsigned int __neon_ssig1(unsigned int x) {
    return __neon_ror(x, 17) ^ __neon_ror(x, 19) ^ (x >> 10);
}
static inline unsigned int __neon_ch(unsigned int x, unsigned int y, unsigned int z) {
    return (x & y) ^ ((0xFFFFFFFFu ^ x) & z);
}
static inline unsigned int __neon_maj(unsigned int x, unsigned int y, unsigned int z) {
    return (x & y) ^ (x & z) ^ (y & z);
}

/* --- broadcast ---------------------------------------------------------- */
static inline float32x4_t vdupq_n_f32(float s) {
    float32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = s;
    return r;
}
static inline int32x4_t vdupq_n_s32(int s) {
    int32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = s;
    return r;
}
static inline uint32x4_t vdupq_n_u32(unsigned int s) {
    uint32x4_t r; int i;
    for (i = 0; i < 4; i++) r.v[i] = s;
    return r;
}
static inline uint8x16_t vdupq_n_u8(unsigned char s) {
    uint8x16_t r; int i;
    for (i = 0; i < 16; i++) r.v[i] = s;
    return r;
}

