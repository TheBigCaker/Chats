                                    mbody0->children[0]->nchildren==1) {
                                    const IRNode* rv = mbody0->children[0]->children[0];
                                    if (rv && d_strcmp(rv->type,"CALL")==0 && rv->value &&
                                        d_strcmp(rv->value,"cls")==0 &&
                                        cg_cls_hasm(n->value, "__init__")) {
                                        d_strncpy(cg_cls_mret_cls[ci*48 + mj], n->value, 31);
                                        cg_cls_mret_cls[ci*48 + mj][31] = 0;
                                        cg_cls_mret[ci][mj] = 4;
                                    }
                                }
