                    /* `len(lines)` after `lines = s.splitlines()`: the lines table
                     * has a RUNTIME count, and the fallthrough read the C string
                     * length of the char** (3 for a 4-line string). */
                    if (cg_lines_name(a->value)) cg_put(g, "drygon_nlines_");
                    else { cg_put(g, a->value); cg_put(g, "_n"); }
                }
                else if (cg_sl_islice(a)) {
                    /* len(xs[a:b]) is the slice's own element count */
                    cg_gen_expr(g, a); cg_put(g, "_n");
                }
                else if (a && d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"COMPLEX")==0 &&
                         a->nchildren>0 && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
                         (d_strcmp(a->children[0]->value,"split")==0 ||
                          d_strcmp(a->children[0]->value,"rsplit")==0)) {
                    if (d_strcmp(a->children[0]->value,"rsplit")==0 && a->nchildren>2) {
                        cg_put(g, "drygon_rsplit_len_m(");
                    } else {
                        cg_put(g, "drygon_split_len(");
                    }
                    cg_gen_expr(g, a->children[0]->nchildren>0 ? a->children[0]->children[0] : NULL);
                    cg_put(g, ", ");
                    if (a->nchildren>1) cg_gen_expr(g, a->children[1]);
                    else cg_put(g, "\"\"");
                    if (d_strcmp(a->children[0]->value,"rsplit")==0 && a->nchildren>2) {
                        cg_put(g, ", ");
                        cg_gen_expr(g, a->children[2]);
                    }
                    cg_put(g, ")");
                }
                else if (a && d_strcmp(a->type,"MEMBER_ACCESS")==0 &&
                         d_strcmp(a->value,"args")==0 && a->nchildren>0 &&
                         d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
                         cg_is_exc_var(a->children[0]->value)) {
                    /* `len(e.args)`: the binding recorded the argument count
                     * in `<e>_arg_n`. */
                    cg_put(g, a->children[0]->value); cg_put(g, "_arg_n");
                }
                else if (ls >= 0) { cg_put(g, "("); cg_put_int(g, ls); cg_put(g, ")"); }
                else if (a && d_strcmp(a->type,"IDENTIFIER")==0 && cg_is_lparam(a->value)) {
                    cg_put(g, a->value); cg_put(g, "_n");
                }
                else if (a && d_strcmp(a->type,"CALL")==0 && a->value &&
                         (d_strcmp(a->value,"list")==0 || d_strcmp(a->value,"tuple")==0) &&
                         a->nchildren>0 && a->children[0] &&
                         d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
                         cg_cls_is_enum(a->children[0]->value) &&
                         cg_cls_member_n(a->children[0]->value) > 0) {
                    /* `len(list(Color))` is the member count; the fallthrough
                     * below measured the class name as a C string (48_enum 30). */
                    cg_put_int(g, cg_cls_member_n(a->children[0]->value));
                }
                else if (a && d_strcmp(a->type,"CALL")==0 && a->value &&
                         (d_strcmp(a->value,"list")==0 || d_strcmp(a->value,"tuple")==0) &&
                         a->nchildren>0 && a->children[0] &&
                         d_strcmp(a->children[0]->type,"BLOCK")==0) {
                    /* `len(list((1,2,3)))`: the element count.  The fallthrough
                     * below used the C string length, which read garbage off an
                     * int array (it returned 1 for a 3-element list). */
                    cg_put_int(g, a->children[0]->nchildren);
                }
                else if (a && d_strcmp(a->type,"CALL")==0 && a->value &&
                         d_strcmp(a->value,"COMPLEX")!=0 && cg_fn_is_list(a->value)) {
                    /* `len(f())` where `f` RETURNS a list: the count lives in the
                     * shared result buffer's companion (`drygon_rl_n`), because
                     * the call itself yields a plain array pointer. */
                    cg_put(g, "((void)"); cg_gen_expr(g, a); cg_put(g, ", ");
                    cg_put(g, cg_fn_ret_strlist(a->value) ? "drygon_rls_n)" : "drygon_rl_n)");
                }
                else if (a && d_strcmp(a->type,"CALL")==0 && a->value &&
                         (d_strcmp(a->value,"list")==0 || d_strcmp(a->value,"tuple")==0) &&
