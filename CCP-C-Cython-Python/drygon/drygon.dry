    static const char* py_comp_items_src(const IRNode* it) {
        if (!it || d_strcmp(it->type,"CALL") != 0 || it->nchildren < 1) return NULL;
        const IRNode* m = it->children[0];
        if (!m || d_strcmp(m->type,"MEMBER_ACCESS") != 0) return NULL;
        if (d_strcmp(m->value,"items") != 0 || m->nchildren < 1) return NULL;
        const IRNode* d = m->children[0];
        if (!d || d_strcmp(d->type,"IDENTIFIER") != 0) return NULL;
        return d->value;
    }
    /* A dict comprehension is built while its source is still being parsed,
     * but the key type follows tables that the source scans only finish
     * filling later -- `{k: v for k, v in d.items()}` has string keys exactly
     * when `d` does.  Remember the clause to ask about and settle it once the
     * tables are complete. */
    static int cg_compkey_n = 0;
    static char cg_compkey_dst[128 * 32];
    static IRNode* cg_compkey_iter[128];
    static void cg_compkey_note(const char* dst, const IRNode* it) {
        if (cg_compkey_n >= 128 || !dst) return;
        int i = 0;
        while (dst[i] && i < 31) { cg_compkey_dst[cg_compkey_n * 32 + i] = dst[i]; i++; }
        cg_compkey_dst[cg_compkey_n * 32 + i] = 0;
        cg_compkey_iter[cg_compkey_n] = (IRNode*)it;
        cg_compkey_n = cg_compkey_n + 1;
    }
    static void cg_compkey_resolve(void) {
        int i = 0;
        while (i < cg_compkey_n) {
            const IRNode* it = cg_compkey_iter[i];
            int kf = 0;
            const char* isn = py_comp_items_src(it);
            if (isn) {
                if (cg_dict_kf(isn)) kf = 1;
            } else if (cg_node_is_str_static(it)) kf = 1;
            if (kf) cg_note_dict(cg_compkey_dst + i * 32, 0, 1);
            i++;
        }

    }
    static IRNode* py_comp_store(const char* name, const IRNode* elem, int isdict,
                                 const IRNode* key) {
        /* a comprehension whose element is the backing list of another
         * comprehension is a 2-D list: the finished row is appended whole, and
         * the 2-D append path copies it element-wise into the flattening
         * backing array (`[[i * j for j ...] for i ...]`) */
        if (!isdict && elem && d_strcmp(elem->type,"IDENTIFIER")==0 &&
            elem->value && cg_pyc_find(elem->value) >= 0) {
            IRNode* rowbody = ir_new("BLOCK", "", "ANY");
            IRNode* rma = ir_new("MEMBER_ACCESS", "append", ".");
            ir_add_child(rma, ir_new("IDENTIFIER", name, "ANY"));
            IRNode* rap = ir_new("CALL", "COMPLEX", "ANY");
            ir_add_child(rap, rma);
            ir_add_child(rap, elem);
            IRNode* res = ir_new("EXPR_STMT", "", "ANY");
            ir_add_child(res, rap);
            ir_add_child(rowbody, res);
            return rowbody;
        }
        IRNode* body = ir_new("BLOCK", "", "ANY");
        IRNode* acc = ir_new("ARRAY_ACCESS", "", "ANY");
        ir_add_child(acc, ir_new("IDENTIFIER", name, "ANY"));
        if (isdict) {
            if (key) ir_add_child(acc, key);
        } else {
            char cn[128];
            cg_pyc_count_name(cn, name);
            ir_add_child(acc, ir_new("IDENTIFIER", cn, "ANY"));
        }
        IRNode* ai = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(ai, acc);
        if (elem) ir_add_child(ai, elem);
        ir_add_child(body, ai);
        if (!isdict) {
            char cn[128];
            cg_pyc_count_name(cn, name);
            IRNode* an = ir_new("ASSIGN", "=", "ANY");
            ir_add_child(an, ir_new("IDENTIFIER", cn, "ANY"));
            IRNode* plus = ir_new("BINARY_OP", "+", "ANY");
            ir_add_child(plus, ir_new("IDENTIFIER", cn, "ANY"));
            ir_add_child(plus, ir_new("CONSTANT", "1", "INT"));
            ir_add_child(an, plus);
            ir_add_child(body, an);
        }
        return body;
    }
    static IRNode* py_comp_nest(const char* name, const IRNode* c) {
        if (!c) return NULL;
        int isdict = d_strcmp(c->type, "COMPDICT") == 0;
        int b = isdict ? 2 : 1;
        const IRNode* key = (isdict && c->nchildren > 0) ? c->children[0] : NULL;
        const IRNode* elem = c->nchildren > (isdict ? 1 : 0) ? c->children[isdict ? 1 : 0] : NULL;
        IRNode* vtgt = c->nchildren > b ? c->children[b] : NULL;
        const IRNode* iter = c->nchildren > b + 1 ? c->children[b + 1] : NULL;
        const IRNode* cond = c->nchildren > b + 2 ? c->children[b + 2] : NULL;
        const IRNode* rest = c->nchildren > b + 3 ? c->children[b + 3] : NULL;
        IRNode* f = py_comp_for(vtgt, iter);
        IRNode* body = ir_new("BLOCK", "", "ANY");
        if (rest) ir_add_child(body, py_comp_nest(name, rest));
        else ir_add_child(body, py_comp_store(name, elem, isdict, key));
        if (cond) {
            IRNode* iff = ir_new("IF", "", "ANY");
            ir_add_child(iff, cond);
            ir_add_child(iff, body);
            IRNode* ib = ir_new("BLOCK", "", "ANY");
            ir_add_child(ib, iff);
            ir_add_child(f, ib);
        } else ir_add_child(f, body);
        return f;
    }
    /* build `name` from a COMPDICT: an empty dictionary, then the keyed store
     * loops.  Unlike a list comprehension there is no counter to reset, so the
     * clauses nest directly and the value array is typed from the item. */
    static IRNode* py_comp_fill_dict(const char* name, const IRNode* c) {
        const IRNode* key = c->nchildren > 0 ? c->children[0] : NULL;
        const IRNode* val = c->nchildren > 1 ? c->children[1] : NULL;
        IRNode* vtgt = c->nchildren > 2 ? c->children[2] : NULL;
        const IRNode* iter = c->nchildren > 3 ? c->children[3] : NULL;
        const IRNode* cond = c->nchildren > 4 ? c->children[4] : NULL;
        const IRNode* rest = c->nchildren > 5 ? c->children[5] : NULL;
        int _kf = cg_node_is_str_static(key) ? 1 : 0;
        if (!_kf) cg_compkey_note(name, iter);
        cg_note_dict(name, cg_dict_vflag(val), _kf);
        IRNode* seq = ir_new("BLOCK", "SEQ", "ANY");
        IRNode* ini = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(ini, ir_new("IDENTIFIER", name, "ANY"));
        ir_add_child(ini, ir_new("BLOCK", "DICT", "ANY"));
        ir_add_child(seq, ini);
        IRNode* f = py_comp_for(vtgt, iter);
        IRNode* body = ir_new("BLOCK", "", "ANY");
        if (rest) ir_add_child(body, py_comp_nest(name, rest));
        else ir_add_child(body, py_comp_store(name, val, 1, key));
        if (cond) {
            IRNode* iff = ir_new("IF", "", "ANY");
            ir_add_child(iff, cond);
            ir_add_child(iff, body);
            IRNode* ib = ir_new("BLOCK", "", "ANY");
            ir_add_child(ib, iff);
            ir_add_child(f, ib);
        } else ir_add_child(f, body);
        ir_add_child(seq, f);
        return seq;
    }
    static IRNode* py_comp_fill_p(const char* name, const IRNode* c, IRNode* pre) {
        const IRNode* elem = c->nchildren > 0 ? c->children[0] : NULL;
        IRNode* vtgt = c->nchildren > 1 ? c->children[1] : NULL;
        const char* var = (vtgt && d_strcmp(vtgt->type,"IDENTIFIER")==0) ? vtgt->value : "i";
        const IRNode* iter = c->nchildren > 2 ? c->children[2] : NULL;
        const IRNode* cond = c->nchildren > 3 ? c->children[3] : NULL;
        /* `[c for c in "ab"]` yields python strings: iterating a string binds
         * the loop var as a scalar char (an int code when stored), so rewrite
         * to an index loop whose element is a fresh 1-char slice instead */
        IRNode* elem2 = NULL;
        IRNode* rng = NULL;
        int striter = iter && d_strcmp(iter->type,"CONSTANT")==0 &&
                      d_strcmp(iter->data_type,"STR")==0;
        if (striter && elem) {
            int plain = d_strcmp(elem->type,"IDENTIFIER")==0 && elem->value &&
                var[0] && d_strcmp(elem->value, var)==0;
            int svl = 0;
            while (iter->value[svl]) svl++;
            /* the constant keeps its quotes: "ab" is 4 chars of value text */
            int slen = svl;
            if (svl >= 2 && (iter->value[0]==39 || iter->value[0]==34) &&
                (iter->value[svl-1]==39 || iter->value[svl-1]==34)) slen = svl - 2;
            char sd[16];
            int sdg = 0;
            if (slen == 0) { sd[sdg] = '0'; sdg++; }
            while (slen > 0) { sd[sdg] = (char)(48 + (slen - (slen / 10) * 10)); sdg++; slen = slen / 10; }
            sd[sdg] = 0;
            char sdr[16];
            int j2 = 0;
            while (j2 < sdg) { sdr[j2] = sd[sdg - 1 - j2]; j2++; }
            sdr[sdg] = 0;
            IRNode* rng2 = ir_new("CALL", "range", "ANY");
            ir_add_child(rng2, ir_new("CONSTANT", "0", "INT"));
            ir_add_child(rng2, ir_new("CONSTANT", sdr, "INT"));
            rng = rng2;
            IRNode* sl = ir_new("SLICE", "", "STR");
            ir_add_child(sl, iter);
            ir_add_child(sl, ir_new("IDENTIFIER", var, "INT"));
            IRNode* one = ir_new("BINARY_OP", "+", "ANY");
            ir_add_child(one, ir_new("IDENTIFIER", var, "INT"));
            ir_add_child(one, ir_new("CONSTANT", "1", "INT"));
            ir_add_child(sl, one);
            if (plain) elem2 = sl;
            else {
                /* any other element shape keeps the element but splices the
                 * 1-char slice over every use of the loop var, so method
                 * calls like `c.upper()` see a string, not a char code */
                elem2 = elem;
                py_comp_subst(elem2, var, sl);
            }
            /* the registry recorded the raw element: a string comprehension
             * fills the list with 1-char slices, so it must type as a string
             * list (decl emits char* from cg_list_flags) */
            int pi = cg_pyc_find(name);
            if (pi >= 0) cg_pyc_elems[pi] = elem2;
        }
        char cn[128];
        cg_pyc_count_name(cn, name);
        IRNode* f;
        if (striter && elem2 && rng) f = py_comp_range_for(var, rng);
        else if (var[0] && iter && d_strcmp(iter->type,"CALL")==0 && d_strcmp(iter->value,"range")==0)
            f = py_comp_range_for(var, iter);
        else {
            f = ir_new("FOR", "", "ANY");
            /* a tuple target is destructured by the codegen; everything else is
             * a plain loop variable */
            if (vtgt) ir_add_child(f, vtgt);
            else ir_add_child(f, ir_new("IDENTIFIER", "i", "ANY"));
            if (iter) ir_add_child(f, iter);
        }
        IRNode* body = ir_new("BLOCK", "", "ANY");
        /* statements that must run once per iteration of this loop, before the
         * element is stored: a nested comprehension in the element
         * (`[[x for x in r] for r in m]`) is built here, not once up front, so
         * its loop sees the current value of this loop's variable */
        if (pre) { int _pi = 0; while (_pi < pre->nchildren) { ir_add_child(body, pre->children[_pi]); _pi = _pi + 1; } }
        /* `[x for a in A for b in B]` and `{k: v for a in A for b in B}`: the
         * clauses after the first nest inside this loop, so the store below
         * runs once per combination of the loop variables */
        const IRNode* rest = c->nchildren > 4 ? c->children[4] : NULL;
        const IRNode* storee = elem2 ? elem2 : elem;
        if (rest) ir_add_child(body, py_comp_nest(name, rest));
        else if (storee && d_strcmp(storee->type,"IDENTIFIER")==0 && storee->value &&
                 cg_pyc_find(storee->value) >= 0) {
        /* the element is the backing list of an inner comprehension: this
         * target holds list rows, so the finished row is appended whole and
         * the 2-D append path copies it in row by row.  Assigning it would
         * truncate the pointer into one int slot (60_comprehensive check 45:
         * `[[i * j for j in range(1, 4)] for i in range(1, 4)]`). */
        IRNode* rma = ir_new("MEMBER_ACCESS", "append", ".");
        ir_add_child(rma, ir_new("IDENTIFIER", name, "ANY"));
        IRNode* rap = ir_new("CALL", "COMPLEX", "ANY");
        ir_add_child(rap, rma);
        ir_add_child(rap, storee);
        IRNode* res = ir_new("EXPR_STMT", "", "ANY");
        ir_add_child(res, rap);
        ir_add_child(body, res);
        } else {
        IRNode* acc = ir_new("ARRAY_ACCESS", "", "ANY");
        ir_add_child(acc, ir_new("IDENTIFIER", name, "ANY"));
        ir_add_child(acc, ir_new("IDENTIFIER", cn, "ANY"));
        IRNode* ai = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(ai, acc);
        if (elem2) ir_add_child(ai, elem2);
        else if (elem) ir_add_child(ai, elem);
        ir_add_child(body, ai);
        IRNode* an = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(an, ir_new("IDENTIFIER", cn, "ANY"));
        IRNode* plus = ir_new("BINARY_OP", "+", "ANY");
        ir_add_child(plus, ir_new("IDENTIFIER", cn, "ANY"));
        ir_add_child(plus, ir_new("CONSTANT", "1", "INT"));
        ir_add_child(an, plus);
        ir_add_child(body, an);
        }
        if (cond) {
            IRNode* iff = ir_new("IF", "", "ANY");
            ir_add_child(iff, cond);
            ir_add_child(iff, body);
            /* the loop body slot is emitted as a block of statements, so the
             * `if` has to be wrapped in one */
            IRNode* ib = ir_new("BLOCK", "", "ANY");
            ir_add_child(ib, iff);
            ir_add_child(f, ib);
        } else ir_add_child(f, body);
        IRNode* seq = ir_new("BLOCK", "SEQ", "ANY");
        IRNode* rst = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(rst, ir_new("IDENTIFIER", cn, "ANY"));
        ir_add_child(rst, ir_new("CONSTANT", "0", "INT"));
        ir_add_child(seq, rst);
        ir_add_child(seq, f);
        return seq;
    }
    /* comprehension fill with nothing to run before the store */
    static IRNode* py_comp_fill(const char* name, const IRNode* c) {
        return py_comp_fill_p(name, c, NULL);
    }
    /* replace every comprehension inside a statement with the name of the
     * array that holds it, collecting the loops that build those arrays */
    static void py_comp_hoist(IRNode* n, IRNode** seq) {
        if (!n) return;
        /* a comprehension's trailing clause slot holds another clause node,
         * not a value: it must stay in place for py_comp_nest to walk (`rest`),
         * so hide it from the hoist loop and recurse into it afterwards */
        int keepslot = -1;
        IRNode* keep = NULL;
        if (py_is_comp(n)) {
            keepslot = (d_strcmp(n->type,"COMPDICT")==0) ? 5 : 4;
            if (n->nchildren > keepslot && py_is_comp(n->children[keepslot])) {
                keep = n->children[keepslot];
                n->children[keepslot] = NULL;
            }
        }
        int i = 0;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (py_is_comp(c)) {
                /* a comprehension nested inside this one is rebuilt on every
                 * iteration of this one, so its loops are handed to the fill
                 * below as a prelude instead of running once, up front */
                IRNode* cseq = NULL;
                py_comp_hoist(c, &cseq);
                char nm[64];
                cg_pyc_fresh(nm);
                int cdict = d_strcmp(c->type, "COMPDICT") == 0;
                /* a dict comprehension is not an array: it is registered as a
                 * dictionary by py_comp_fill_dict, not as a backing list. */
                if (!cdict) cg_pyc_note(nm, c->nchildren > 0 ? c->children[0] : NULL);
                if (!*seq) *seq = ir_new("BLOCK", "SEQ", "ANY");
                ir_add_child(*seq, cdict ? py_comp_fill_dict(nm, c) : py_comp_fill_p(nm, c, cseq));
                n->children[i] = ir_new("IDENTIFIER", nm, "ANY");
            } else py_comp_hoist(c, seq);
            i++;
        }
        if (keep) {
            n->children[keepslot] = keep;
            py_comp_hoist(keep, seq);
        }
    }
    /* a statement mentioning a comprehension becomes its append loop followed
     * by the original statement; `xs = [ ... ]` becomes only the loop, since
     * the loop fills `xs` itself */
    static IRNode* py_comp_stmt(IRNode* s) {
        if (!s) return s;
        if (d_strcmp(s->type,"ASSIGN")==0 && s->nchildren == 2 &&
            d_strcmp(s->children[0]->type,"IDENTIFIER")==0 &&
            py_is_comp(s->children[1])) {
            const char* nm = s->children[0]->value;
            /* a comprehension nested in the element (`[[x for x in a] for i in b]`)
             * has to be built first, then referenced by name */
            IRNode* pseq = NULL;
            py_comp_hoist(s->children[1], &pseq);
            if (d_strcmp(s->children[1]->type,"COMPDICT")==0) {
                IRNode* df = py_comp_fill_dict(nm, s->children[1]);
                if (!pseq) return df;
                ir_add_child(pseq, df);
                return pseq;
            }
            cg_pyc_note(nm, s->children[1]->nchildren > 0 ? s->children[1]->children[0] : NULL);
            /* the hoisted loops belong inside this comprehension's loop body,
             * not before it: they read its loop variable */
            IRNode* lf = py_comp_fill_p(nm, s->children[1], pseq);
            return lf;
        }
        IRNode* seq = NULL;
        py_comp_hoist(s, &seq);
        if (!seq) return s;
        ir_add_child(seq, s);
        return seq;
    }
    /* One `for VAR in ITER [if COND]` clause, plus every clause chained after
     * it: `[x for a in A for b in B if c]` is one COMPLIST whose tail clauses
     * hang off the first, so the whole comprehension is parsed in one pass.
     *
     * COMPLIST keeps `elem` first; a dict comprehension keeps `key` and `val`
     * first instead (see py_comp_nest for the layout).  A clause followed by
     * more clauses but carrying no `if` gets a constant-true condition, so the
     * nesting code always finds the condition in the same slot. */
    static IRNode* py_comp_clause(const IRNode* elem, const IRNode* key, PyParser* p, int isdict) {
        IRNode* c = ir_new(isdict ? "COMPDICT" : "COMPLIST", "", "ANY");
        if (isdict) {
            if (key) ir_add_child(c, key);
            if (elem) ir_add_child(c, elem);
        } else if (elem) ir_add_child(c, elem);
        if (is_kw(p,"for")) advance(p);
        char vn[128];
        if (pk(p)->kind == TOK_NAME) { d_strncpy(vn, pk(p)->text, 127); vn[127] = '\0'; advance(p); }
        else { vn[0]='i'; vn[1]=0; }
        IRNode* vt = ir_new("IDENTIFIER", vn, "ANY");
        if (pk(p)->kind == TOK_COMMA) {
            /* `[EXPR for x, y in pairs]` — tuple target, destructured per item */
            IRNode* tup = ir_new("BLOCK","TUPLE","ANY");
            ir_add_child(tup, vt);
            while (pk(p)->kind == TOK_COMMA) {
                advance(p);
                if (pk(p)->kind != TOK_NAME) break;
                ir_add_child(tup, ir_new("IDENTIFIER", pk(p)->text, "ANY"));
                advance(p);
            }
            vt = tup;
        }
        ir_add_child(c, vt);
        if (is_kw(p,"in")) advance(p);
        IRNode* iter = parse_expr(p);
        if (iter) ir_add_child(c, iter);
        int hascond = 0;
        if (is_kw(p,"if")) {
            hascond = 1;
            advance(p);
            IRNode* cond = parse_expr(p);
            if (cond) ir_add_child(c, cond);
        }
        if (is_kw(p,"for")) {
            if (!hascond) ir_add_child(c, ir_new("CONSTANT", "1", "INT"));
            IRNode* rest = py_comp_clause(elem, key, p, isdict);
            if (rest) ir_add_child(c, rest);
        }
        return c;
    }
    /* `for VAR in ITER [if COND]` following a comprehension element */
    static IRNode* py_comp_new(const IRNode* elem, PyParser* p) {
        return py_comp_clause(elem, NULL, p, 0);
    }
    /* Parse a block of statements until a DEDENT || EOF. */
    static void parse_block(PyParser* p, IRNode* block) {
        while (pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_DEDENT) {
            if (pk(p)->kind == TOK_NEWLINE) { advance(p); continue; }
            int last_pos = p->ts->pos;
            IRNode* s = py_comp_stmt(parse_stmt(p));
            if (s) ir_add_child(block, s);
            if (p->ts->pos <= last_pos) {
                advance(p);
            }
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
        }
        if (pk(p)->kind == TOK_DEDENT) advance(p);
    }
    /* A one-line suite (`def f(): return x`, `class C: pass`, `case _: y`)
     * has neither a NEWLINE nor an INDENT before its body, so plain
     * parse_block kept consuming every statement after the header -- a
     * `def f(): pass` at module level swallowed the rest of the file.  Parse
     * just the header's own line in that case; the indented form still goes
     * through parse_block. */
    static void parse_suite(PyParser* p, IRNode* block) {
        if (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_INDENT &&
            pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_DEDENT) {
            while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF &&
                   pk(p)->kind != TOK_DEDENT) {
                int last_pos = p->ts->pos;
                IRNode* s = py_comp_stmt(parse_stmt(p));
                if (s) ir_add_child(block, s);
                if (p->ts->pos <= last_pos) advance(p);
            }
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
            return;
        }
        while (pk(p)->kind == TOK_NEWLINE) advance(p);
        if (pk(p)->kind == TOK_INDENT) advance(p);
        parse_block(p, block);
    }
    /* Postfix operators: calls, subscripts, slices and attribute access.
     * These bind to *any* primary (`"{}".format(x)`, `f()[0]`, `(a+b).m()`),
     * not just to a bare name. */
    /* `cmp_to_key(f)` (bare name or `functools.cmp_to_key(f)` member form) ->
     * the comparator's name, else 0.  `sorted(xs, key=cmp_to_key(f))` needs the
     * name at lowering time to sort by that comparator. */
    static const char* cg_cmpk_fn(const IRNode* k) {
        if (!k || d_strcmp(k->type,"CALL")!=0) return 0;
        if (d_strcmp(k->value,"cmp_to_key")==0) {
            if (k->nchildren > 0 && k->children[0] &&
                d_strcmp(k->children[0]->type,"IDENTIFIER")==0) return k->children[0]->value;
            return 0;
        }
        if (d_strcmp(k->value,"COMPLEX")==0 && k->nchildren > 1 &&
            k->children[0] && d_strcmp(k->children[0]->type,"MEMBER_ACCESS")==0 &&
            k->children[0]->value && d_strcmp(k->children[0]->value,"cmp_to_key")==0 &&
            k->children[1] && d_strcmp(k->children[1]->type,"IDENTIFIER")==0)
            return k->children[1]->value;
        return 0;
    }
    /* ── functools bookkeeping ────────────────────────────────────────────
     * There are no first-class function values in this backend: a C function
     * cannot be stored in a variable and a call cannot take a function
     * pointer.  `partial` therefore records the pieces of the binding at
     * parse time and every later call through the bound name expands to the
     * full call, which is what the C call would have been anyway.  The
     * registries below are keyed by text, so the flat stores carry their own
     * string compare/copy helpers. */
    static int py_str_at_eq(const char* arr, int base, const char* v) {
        int j = 0;
        while (1) {
            char a = arr[base + j];
            char b = v[j];
            if (a != b) return 0;
            if (a == 0) return 1;
            j++;
        }
    }
    static void py_str_at_set(char* arr, int base, const char* v, int cap) {
        int j = 0;
        while (j < cap - 1 && v[j]) { arr[base + j] = v[j]; j++; }
        arr[base + j] = 0;
    }
    static int py_dec_int(const char* s) {
        int v = 0, i = 0, neg = 0;
        if (!s) return 0;
        if (s[0] == '-') { neg = 1; i = 1; }
        while (s[i] >= 48 && s[i] <= 57) { v = v * 10 + (s[i] - 48); i++; }
        return neg ? 0 - v : v;
    }
    static int py_int_of(const IRNode* n) {
        if (!n || d_strcmp(n->type,"CONSTANT")!=0) return -1;
        return py_dec_int(n->value);
    }
    /* "123" as a C string, for the CONSTANT operands the lowerings build */
    static char py_i1[16]; static char py_i2[16];
    static char py_i3[16]; static char py_i4[16];
    static void py_itoa(int v, char* out) {
        char tmp[16]; int d = 0, neg = 0, z = 0;
        if (v < 0) { neg = 1; v = 0 - v; }
        if (v == 0) { tmp[0] = 48; d = 1; }
        while (v > 0) { tmp[d] = (char)(48 + (v - (v / 10) * 10)); d++; v = v / 10; }
        if (neg) { out[0] = '-'; z = 1; }
        while (d > 0) { d--; out[z] = tmp[d]; z++; }
        out[z] = 0;
    }
    static int py_islot;
    static const char* py_int_const(int v) {
        int s = py_islot % 4;
        py_islot = py_islot + 1;
        if (s == 0) { py_itoa(v, py_i1); return py_i1; }
        if (s == 1) { py_itoa(v, py_i2); return py_i2; }
        if (s == 2) { py_itoa(v, py_i3); return py_i3; }
        py_itoa(v, py_i4);
        return py_i4;
    }
    /* partial: NAME -> (target function, leading arguments) */
    static int py_partial_n;
    static char py_partial_vars[256*64];
    static char py_partial_fns[256*128];
    static int py_partial_nb[256];
    static const IRNode* py_partial_args[2048];
    static int py_partial_idx(const char* v) {
        int i = 0;
        while (i < py_partial_n) { if (py_str_at_eq(py_partial_vars, i*64, v)) return i; i++; }
        return -1;
    }
    static const char* py_partial_fn_of(const char* v) {
        int i = py_partial_idx(v);
        if (i < 0) return NULL;
        return py_partial_fns + i * 128;
    }
    static int py_partial_nbound(const char* v) {
        int i = py_partial_idx(v);
        return i < 0 ? 0 : py_partial_nb[i];
    }
    static const IRNode* py_partial_bound(const char* v, int j) {
        int i = py_partial_idx(v);
        if (i < 0 || j < 0 || j >= py_partial_nb[i]) return NULL;
        return py_partial_args[i*8 + j];
    }
    static void py_partial_bind(const char* v, const char* fn, IRNode** kids, int nk) {
        int i = py_partial_idx(v);
        if (i < 0) {
            if (py_partial_n >= 256) return;
            i = py_partial_n;
            py_str_at_set(py_partial_vars, i*64, v, 64);
            py_partial_n = py_partial_n + 1;
        }
        py_str_at_set(py_partial_fns, i*128, fn, 128);
        py_partial_nb[i] = 0;
        int j = 1;   /* kids[0] is the target function's name, not a bound arg */
        while (j < nk && py_partial_nb[i] < 8) {
            py_partial_args[i*8 + py_partial_nb[i]] = ir_clone(kids[j]);
            py_partial_nb[i] = py_partial_nb[i] + 1;
            j++;
        }
    }
    /* lru_cache: NAME -> memo slot in the runtime tables */
    static int py_lru_n;
    static char py_lru_fns[16*64];
    static int py_lru_max[16];
    static int py_lru_pending;
    static int py_lru_pend_max;
    static int py_lru_applied[16];
    static int py_lru_index(const char* nm) {
        int i = 0;
        while (i < py_lru_n) { if (py_str_at_eq(py_lru_fns, i*64, nm)) return i; i++; }
        return -1;
    }
    static int py_lru_register(const char* nm, int mx) {
        int i = py_lru_index(nm);
        if (i >= 0) return i;
        if (py_lru_n >= 16) return -1;
        i = py_lru_n;
        py_str_at_set(py_lru_fns, i*64, nm, 64);
        py_lru_max[i] = mx;
        py_lru_n = py_lru_n + 1;
        return i;
    }
    static int py_lru_is(const char* dn) {
        if (!dn) return 0;
        if (d_strcmp(dn,"lru_cache")==0) return 1;
        if (d_strcmp(dn,"functools.lru_cache")==0) return 1;
        /* any dotted alias ending in `.lru_cache` */
        int i = 0, at = -1;
        while (dn[i]) { if (dn[i] == '.') at = i; i++; }
        if (at < 0) return 0;
        int j = 0;
        const char* sfx = "lru_cache";
        while (sfx[j]) { if (dn[at + 1 + j] != sfx[j]) return 0; j++; }
        return dn[at + 1 + j] == 0;
    }
    /* `info = fib.cache_info()`: the four counters are copied into globals so
     * a later cache_clear() cannot rewrite the snapshot (26_functools 17). */
    static int py_snap_n;
    static char py_snap_vars[256*64];
    static int py_snap_of(const char* nm) {
        int i = 0;
        while (i < py_snap_n) { if (py_str_at_eq(py_snap_vars, i*64, nm)) return i; i++; }
        return -1;
    }
    static void py_snap_add(const char* nm) {
        if (py_snap_of(nm) >= 0) return;
        if (py_snap_n >= 256) return;
        py_str_at_set(py_snap_vars, py_snap_n*64, nm, 64);
        py_snap_n = py_snap_n + 1;
    }
    static char py_snap_buf[160];
    static const char* py_snap_name(const char* nm, const char* field) {
        if (!nm || !field) return NULL;
        if (py_snap_of(nm) < 0) return NULL;
        int z = 0, j = 0;
        const char* pre = "_lru_";
        while (pre[j]) { py_snap_buf[z] = pre[j]; z++; j++; }
        j = 0;
        while (nm[j] && z < 100) { py_snap_buf[z] = nm[j]; z++; j++; }
        py_snap_buf[z] = '_'; z++;
        j = 0;
        while (field[j] && z < 150) { py_snap_buf[z] = field[j]; z++; j++; }
        py_snap_buf[z] = 0;
        return py_snap_buf;
    }
    static const char* py_snap_field(const IRNode* base, const char* field) {
        if (!base || d_strcmp(base->type,"IDENTIFIER")!=0) return NULL;
        return py_snap_name(base->value, field);
    }
    /* `@lru_cache(maxsize=N) def f(...)`: probe the memo table on entry, return
     * the stored value on a hit, store it again on every return.  The key is
     * built from the first parameters (up to three); the slot comes from the
     * parse-time registry.  Emitted inline because the table is data-only --
     * a runtime helper cannot be handed `f` to call. */
    static void cg_lru_key_args(IRNode* call, IRNode* body, int slot) {
        int p = 0;
        while (p < 3) {
            IRNode* k = NULL;
            if (body && p < body->nchildren) {
                IRNode* pd = body->children[p];
                if (pd && d_strcmp(pd->type,"PARAM_DECL")==0)
                    k = ir_new("IDENTIFIER", pd->value, "ANY");
            }
            if (k) ir_add_child(call, k);
            else ir_add_child(call, ir_new("CONSTANT", "0", "INT"));
            p++;
        }
    }
    static void cg_lru_fix_returns(IRNode* n, int slot, IRNode* params) {
        if (!n) return;
        if (d_strcmp(n->type,"RETURN")==0 && n->nchildren > 0) {
            IRNode* sc = ir_new("CALL", "drygon_lru_store_i", "ANY");
            ir_add_child(sc, ir_new("CONSTANT", py_int_const(slot), "INT"));
            cg_lru_key_args(sc, params, slot);
            ir_add_child(sc, n->children[0]);
            n->children[0] = sc;
            return;
        }
        int i = 0;
        while (i < n->nchildren) { cg_lru_fix_returns(n->children[i], slot, params); i++; }
    }
    static void cg_lru_apply(IRNode* D) {
        int slot = py_lru_index(D->value);
        if (slot < 0) return;
        if (py_lru_applied[slot]) return;
        py_lru_applied[slot] = 1;
        IRNode* params = D->children[0];
        IRNode* body = D->children[1];
        if (!params || !body) return;
        cg_lru_fix_returns(body, slot, params);
        IRNode* fc = ir_new("CALL", "drygon_lru_find", "ANY");
        ir_add_child(fc, ir_new("CONSTANT", py_int_const(slot), "INT"));
        cg_lru_key_args(fc, params, slot);
        IRNode* gc2 = ir_new("CALL", "drygon_lru_get_i", "ANY");
        ir_add_child(gc2, ir_new("CONSTANT", py_int_const(slot), "INT"));
        IRNode* ret = ir_new("RETURN", "", "ANY");
        ir_add_child(ret, gc2);
        IRNode* tb = ir_new("BLOCK", "", "ANY");
        ir_add_child(tb, ret);
        IRNode* iff = ir_new("IF", "", "ANY");
        ir_add_child(iff, fc);
        ir_add_child(iff, tb);
        if (d_strcmp(body->type,"BLOCK")==0 && body->nchildren < IR_MAX_CHILDREN) {
            /* prepend: shift the existing statements up by one */
            int n = body->nchildren;
            int i = n;
            while (i > 0) { body->children[i] = body->children[i-1]; i--; }
            body->children[0] = iff;
            body->nchildren = n + 1;
            return;
        }
        IRNode* nb = ir_new("BLOCK", "", "ANY");
        ir_add_child(nb, iff);
        ir_add_child(nb, body);
        D->children[1] = nb;
    }
    static IRNode* parse_postfix(PyParser* p, IRNode* node) {
        if (!node) return NULL;
        while (1) {
            if (pk(p)->kind == TOK_LPAREN) {
                advance(p);
                if (d_strcmp(node->type, "IDENTIFIER")==0) {
                    IRNode* call = ir_new("CALL", node->value, "ANY");
                    parse_arg_list(p, call, TOK_RPAREN);
                    /* `p(x)` where `p = partial(f, a, b)`: expand to
                     * `f(a, b, x)`.  Keywords among the bound arguments keep
                     * their place after the new positional ones, which is the
                     * order python itself would pass them in. */
                    const char* pfn = py_partial_fn_of(node->value);
                    int pnb = py_partial_nbound(node->value);
