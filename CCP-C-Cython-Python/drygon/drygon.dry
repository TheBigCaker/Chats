        cg_indent(g);
        cg_put(g, dst); cg_put(g, sarr); cg_put(g, "[_tj + 1] = _tk;\n");
        cg_indent(g);
        cg_put(g, dst); cg_put(g, "_lx[_tj + 1] = _tl;\n");
        { int _rki = 0;
          const char* rk[4];
          rk[0] = "_k0"; rk[1] = "_k1"; rk[2] = "_s0"; rk[3] = "_s1";
          while (_rki < 4) {
            if (!(d_strcmp(rk[_rki], sarr) == 0)) {
              cg_indent(g); cg_put(g, dst); cg_put(g, rk[_rki]); cg_put(g, "[_tj + 1] = _tc");
              cg_put_int(g, _rki); cg_put(g, ";\n");
            }
            _rki++;
          } }
