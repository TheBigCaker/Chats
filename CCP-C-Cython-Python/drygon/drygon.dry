                else if (a && d_strcmp(a->type,"MEMBER_ACCESS")==0 && a->nchildren>0 &&
                         a->value && cg_lf_recv_field(a->children[0], a->value)) {
                    /* `len(<recv>.listfield)`: a counted list field stores its
