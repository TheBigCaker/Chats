    while (p[i]) { total = total + d_strlen(p[i]); i = i + 1; }
    char* out = sys_mmap(0, total + 64, 3, 34, -1, 0);
    if (!out) return 0;
    int pos = 0;
    i = 0;
    while (p[i]) {
        char* s = p[i];
        int j = 0;
        while (s[j]) { out[pos] = s[j]; pos = pos + 1; j = j + 1; }
        i = i + 1;
    }
    out[pos] = 0;
    return out;
}

static char* dc_read_file(char* path) {
    int fd = sys_openat(-100, path, 0, 0);
    if (fd < 0) return 0;
    long sz = sys_lseek(fd, 0, 2);
    if (sz < 0) { sys_close(fd); return 0; }
    sys_lseek(fd, 0, 0);
    char* buf = sys_mmap(0, sz + 2, 3, 34, -1, 0);
    if (!buf) { sys_close(fd); return 0; }
    long r = sys_read(fd, buf, sz);
    sys_close(fd);
    if (r < 0) return 0;
    buf[r] = 0;
    return buf;
}

static char* dc_get_inline_header(char* name) {
    if (d_strcmp(name, "stdio.h") == 0) {
        return "#ifndef _STDIO_H\n#define _STDIO_H 1\ntypedef struct __FILE FILE;\n#define stdin _dg_stdin()\n#define stdout _dg_stdout()\n#define stderr _dg_stderr()\n#define EOF (-1)\n#define SEEK_SET 0\n#define SEEK_CUR 1\n#define SEEK_END 2\nFILE *fopen(const char *path, const char *mode);\nFILE *fdopen(int fd, const char *mode);\nFILE *freopen(const char *path, const char *mode, FILE *stream);\nint fclose(FILE *stream);\nsize_t fread(void *ptr, size_t size, size_t nmemb, FILE *stream);\nsize_t fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream);\nvoid clearerr(FILE *stream);\nstatic inline int fseek(FILE *stream, long offset, int whence) {\n    int fd = *(int*)stream;\n    if (stream) { clearerr(stream); }\n    return (int)_raw_syscall(62, fd, offset, whence, 0, 0, 0);\n}\nstatic inline long ftell(FILE *stream) {\n    int fd = *(int*)stream;\n    return _raw_syscall(62, fd, 0, 1, 0, 0, 0);\n}\nstatic inline void rewind(FILE *stream) {\n    fseek(stream, 0, 0);\n}\nint fgetc(FILE *stream);\nchar *fgets(char *s, int size, FILE *stream);\nstatic inline int fputc(int c, FILE *stream) {\n    unsigned char _c = (unsigned char)c;\n    if (fwrite(&_c, 1, 1, stream) == 1) return (int)_c;\n    return -1;\n}\nint fputs(const char *s, FILE *stream);\nint getc(FILE *stream);\nint getchar(void);\nint putc(int c, FILE *stream);\nint putchar(int c);\nint puts(const char *s);\nint ungetc(int c, FILE *stream);\nint printf(const char *format, ...);\nint fprintf(FILE *stream, const char *format, ...);\nint sprintf(char *str, const char *format, ...);\nint snprintf(char *str, size_t size, const char *format, ...);\nint fflush(FILE *stream);\nint feof(FILE *stream);\nint ferror(FILE *stream);\nvoid clearerr(FILE *stream);\nstatic inline int remove(const char *pathname) {\n    return unlink(pathname);\n}\nint rename(const char *oldpath, const char *newpath);\nvoid perror(const char *s);\n#endif\n";
    }
    if (d_strcmp(name, "stdlib.h") == 0) {
        return "#ifndef _STDLIB_H\n#define _STDLIB_H 1\n#define NULL ((void*)0)\n#define EXIT_SUCCESS 0\n#define EXIT_FAILURE 1\ntypedef unsigned long size_t;\nvoid *malloc(size_t size);\nvoid free(void *ptr);\nvoid *calloc(size_t nmemb, size_t size);\nvoid *realloc(void *ptr, size_t size);\nvoid exit(int status);\nint atoi(const char *nptr);\nlong atol(const char *nptr);\ndouble atof(const char *nptr);\nlong strtol(const char *nptr, char **endptr, int base);\nunsigned long strtoul(const char *nptr, char **endptr, int base);\ndouble strtod(const char *nptr, char **endptr);\nint abs(int j);\nlong labs(long j);\nint rand(void);\nvoid srand(unsigned int seed);\nvoid *bsearch(const void *key, const void *base, size_t nmemb, size_t size, int (*compar)(const void *, const void *));\nvoid qsort(void *base, size_t nmemb, size_t size, int (*compar)(const void *, const void *));\n#endif\n";
    }
    if (d_strcmp(name, "string.h") == 0) {
        return "#ifndef _STRING_H\n#define _STRING_H 1\ntypedef unsigned long size_t;\nvoid *memcpy(void *dest, const void *src, size_t n);\nvoid *memmove(void *dest, const void *src, size_t n);\nvoid *memset(void *s, int c, size_t n);\nint memcmp(const void *s1, const void *s2, size_t n);\nvoid *memchr(const void *s, int c, size_t n);\nsize_t strlen(const char *s);\nchar *strcpy(char *dest, const char *src);\nchar *strncpy(char *dest, const char *src, size_t n);\nchar *strcat(char *dest, const char *src);\nchar *strncat(char *dest, const char *src, size_t n);\nint strcmp(const char *s1, const char *s2);\nint strncmp(const char *s1, const char *s2, size_t n);\nchar *strchr(const char *s, int c);\nchar *strrchr(const char *s, int c);\nchar *strstr(const char *haystack, const char *needle);\nchar *strtok(char *str, const char *delim);\n#endif\n";
    }
    if (d_strcmp(name, "stddef.h") == 0) {
        return "#ifndef _STDDEF_H\n#define _STDDEF_H 1\ntypedef unsigned long size_t;\ntypedef long ptrdiff_t;\n#define NULL ((void*)0)\n#endif\n";
    }
    if (d_strcmp(name, "stdbool.h") == 0) {
        return "#ifndef _STDBOOL_H\n#define _STDBOOL_H 1\n#define bool _Bool\n#define true 1\n#define false 0\n#define __bool_true_false_are_defined 1\n#endif\n";
    }
    if (d_strcmp(name, "stdint.h") == 0) {
        return "#ifndef _STDINT_H\n#define _STDINT_H 1\ntypedef signed char int8_t;\ntypedef unsigned char uint8_t;\ntypedef short int16_t;\ntypedef unsigned short uint16_t;\ntypedef int int32_t;\ntypedef unsigned int uint32_t;\ntypedef long int64_t;\ntypedef unsigned long uint64_t;\ntypedef long intptr_t;\ntypedef unsigned long uintptr_t;\n#define INT8_MAX 127\n#define INT16_MAX 32767\n#define INT32_MAX 2147483647\n#define INT64_MAX 9223372036854775807L\n#define UINT8_MAX 255\n#define UINT16_MAX 65535\n#define UINT32_MAX 4294967295U\n#define UINT64_MAX 18446744073709551615UL\n#define SIZE_MAX 18446744073709551615UL\n#endif\n";
    }
    if (d_strcmp(name, "stdarg.h") == 0) {
        /* va_start/va_arg/va_end are COMPILER BUILTINS in comp_call: va_start
         * seeds the cursor from c->va_base_off (the entry sp the prologue parks
         * every argument slot under) and va_arg loads then advances by
         * roundup8(sizeof(T)).  Defining them as macros here would shadow those
         * builtins with text that cannot reproduce the cursor semantics, so the
         * header only supplies the type. */
        return "#ifndef _STDARG_H\n#define _STDARG_H 1\ntypedef char *va_list;\n#endif\n";
    }
    if (d_strcmp(name, "limits.h") == 0) {
        return "#ifndef _LIMITS_H\n#define _LIMITS_H 1\n#define CHAR_BIT 8\n#define CHAR_MIN (-128)\n#define CHAR_MAX 127\n#define SCHAR_MIN (-128)\n#define SCHAR_MAX 127\n#define UCHAR_MAX 255\n#define SHRT_MIN (-32768)\n#define SHRT_MAX 32767\n#define USHRT_MAX 65535\n#define INT_MIN (-2147483647 - 1)\n#define INT_MAX 2147483647\n#define UINT_MAX 4294967295U\n#define LONG_MIN (-9223372036854775807L - 1)\n#define LONG_MAX 9223372036854775807L\n#define ULONG_MAX 18446744073709551615UL\n#endif\n";
    }
    if (d_strcmp(name, "ctype.h") == 0) {
        return "#ifndef _CTYPE_H\n#define _CTYPE_H 1\nint isalnum(int c);\nint isalpha(int c);\nint isblank(int c);\nint iscntrl(int c);\nint isdigit(int c);\nint isgraph(int c);\nint islower(int c);\nint isprint(int c);\nint ispunct(int c);\nint isspace(int c);\nint isupper(int c);\nint isxdigit(int c);\nint tolower(int c);\nint toupper(int c);\n#endif\n";
    }
    if (d_strcmp(name, "math.h") == 0) {
        return "#ifndef _MATH_H\n#define _MATH_H 1\ndouble sqrt(double x);\ndouble fabs(double x);\ndouble floor(double x);\ndouble ceil(double x);\ndouble fmod(double x, double y);\ndouble pow(double x, double y);\ndouble sin(double x);\ndouble cos(double x);\ndouble tan(double x);\ndouble exp(double x);\ndouble log(double x);\ndouble log10(double x);\ndouble atan2(double y, double x);\ndouble fmax(double x, double y);\ndouble fmin(double x, double y);\nint abs(int n);\n#define M_PI 3.14159265358979323846\n#endif\n";
    }
    return 0;
}

static char* dc_expand_includes(char* src, int depth) {
    if (depth > 8) return src;
    int slen = d_strlen(src);
    int cap = slen + 4194304;
    char* out = sys_mmap(0, cap, 3, 34, -1, 0);
    if (!out) return 0;
    int n = 0;
    int i = 0;
    int pp_ok = 1;
    while (i <= slen) {
        char c = src[i];
        if (c == 0) { out[n] = 0; return out; }
        if (c == '#' && pp_ok && depth < 8 && src[i + 1] == 'i' && src[i + 2] == 'n' && src[i + 3] == 'c' && src[i + 4] == 'l' && src[i + 5] == 'u' && src[i + 6] == 'd' && src[i + 7] == 'e') {
            int j = i + 8;
            while (j < slen && (src[j] == ' ' || src[j] == '\t')) j = j + 1;
            char q = src[j];
            if (q == '"' || q == '<') {
                char term = '"';
                if (q == '<') term = '>';
                j = j + 1;
                int k = j;
                while (k < slen && src[k] != term && src[k] != '\n') k = k + 1;
                if (k < slen && src[k] == term) {
                    int plen = k - j;
                    if (plen > 0 && plen < 440) {
                        char pbuf[512];
                        int z = 0;
                        while (z < plen) { pbuf[z] = src[j + z]; z = z + 1; }
                        pbuf[plen] = 0;
                        /* Check inline headers first */
                        char* text = dc_get_inline_header(pbuf);
                        if (!text) text = dc_read_file(pbuf);
                        if (!text) {
                            char* dprefix = "/data/data/com.termux/files/home/CCP-C-Cython-Python/drygon/";
                            char pbuf2[512];
                            int dz = 0;
                            while (dprefix[dz]) { pbuf2[dz] = dprefix[dz]; dz = dz + 1; }
                            int pz = 0;
                            while (pbuf[pz]) { pbuf2[dz] = pbuf[pz]; dz = dz + 1; pz = pz + 1; }
                            pbuf2[dz] = 0;
                            text = dc_read_file(pbuf2);
                        }
                        if (text) {
                            char* expanded = dc_expand_includes(text, depth + 1);
                            if (!expanded) expanded = text;
                            int elen = d_strlen(expanded);
                            z = 0;
                            while (z < elen) { out[n] = expanded[z]; n = n + 1; z = z + 1; }
                            if (elen > 0 && out[n - 1] != '\n') { out[n] = '\n'; n = n + 1; }
                            i = k + 1;
                            while (i < slen && src[i] != '\n') i = i + 1;
                            pp_ok = 1;
                            continue;
                        }
                        d_puts("include: cannot open ");
                        d_puts(pbuf);
                        sys_exit(1);
                    }
                }
            }
        }
        out[n] = c;
        n = n + 1;
        if (c == '\n') pp_ok = 1;
        else if (c != ' ' && c != '\t') pp_ok = 0;
        i = i + 1;
    }
    out[n] = 0;
    return out;
}

