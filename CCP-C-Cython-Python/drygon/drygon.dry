    }
    static PyValue py_call2(PyValue self, const char* name, PyValue a0, PyValue a1) {
        PyValue a[2]; a[0] = a0; a[1] = a1; return py_method_call(self, name, 2, a);
    }
    static PyValue py_call3(PyValue self, const char* name, PyValue a0, PyValue a1, PyValue a2) {
        PyValue a[3]; a[0] = a0; a[1] = a1; a[2] = a2;
