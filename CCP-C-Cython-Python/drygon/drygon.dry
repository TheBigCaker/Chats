    }
    static double pyv_as_f(PyValue v) {
        if (v.kind == PYV_INT) return (double)v.u.i;
        if (v.kind == PYV_FLOAT) return v.u.f;
        if (v.kind == PYV_BOOL) return (double)v.u.b;
        return 0.0;
    }
    static PyValue py_add(PyValue a, PyValue b) {
        if (a.kind == PYV_INT && b.kind == PYV_INT) return pyv_int(a.u.i + b.u.i);
        if ((a.kind == PYV_INT || a.kind == PYV_FLOAT) && (b.kind == PYV_INT || b.kind == PYV_FLOAT))
            return pyv_float(pyv_as_f(a) + pyv_as_f(b));
        if (a.kind == PYV_STR && b.kind == PYV_STR) return pyv_str(py_str_concat(a.u.s, b.u.s));
        if (a.kind == PYV_LIST && b.kind == PYV_LIST) {
            PyList* r = py_list_new();
            long long i;
            for (i = 0; i < a.u.l->len; i++) py_list_append(r, a.u.l->items[i]);
            for (i = 0; i < b.u.l->len; i++) py_list_append(r, b.u.l->items[i]);
            return pyv_list(r);
        }
        return pyv_none();
    }
    static PyValue py_sub(PyValue a, PyValue b) {
        if (a.kind == PYV_INT && b.kind == PYV_INT) return pyv_int(a.u.i - b.u.i);
        if ((a.kind == PYV_INT || a.kind == PYV_FLOAT) && (b.kind == PYV_INT || b.kind == PYV_FLOAT))
            return pyv_float(pyv_as_f(a) - pyv_as_f(b));
        return pyv_none();
    }
    static PyValue py_mul(PyValue a, PyValue b) {
        if (a.kind == PYV_INT && b.kind == PYV_INT) return pyv_int(a.u.i * b.u.i);
        if ((a.kind == PYV_INT || a.kind == PYV_FLOAT) && (b.kind == PYV_INT || b.kind == PYV_FLOAT))
            return pyv_float(pyv_as_f(a) * pyv_as_f(b));
        if (a.kind == PYV_INT && b.kind == PYV_STR) return pyv_str(py_str_repeat(b.u.s, a.u.i));
        if (a.kind == PYV_STR && b.kind == PYV_INT) return pyv_str(py_str_repeat(b.u.s, a.u.i));
