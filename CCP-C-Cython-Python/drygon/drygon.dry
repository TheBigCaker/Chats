                    }
                    if (!ft && cg_cur_base_class) {
                        int bi = 0;
                        while (bi < cg_cls_n - 1) {
                            if (d_strcmp(cg_cls_names[bi], cg_cur_base_class) == 0 && cg_cls_body[bi]) {
                                ft = cg_cls_ftype(cg_cls_body[bi], cfn + fi2*64);
