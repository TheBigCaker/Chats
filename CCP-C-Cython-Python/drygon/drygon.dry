    p[1353] = "static char* drygon_pp_[3];\n";
    p[1354] = "char** drygon_partition(char* s, char* sep, int is_r) { int n = drygon_slen(s); int m = drygon_slen(sep); int at = -1; int i = 0; if (m > 0) { if (is_r) { for (i = n - m; i >= 0; i--) { int k = 0; while (k < m && s[i+k] == sep[k]) k = k + 1; if (k == m) { at = i; break; } } } else { for (i = 0; i + m <= n; i++) { int k = 0; while (k < m && s[i+k] == sep[k]) k = k + 1; if (k == m) { at = i; break; } } } } if (at < 0) { drygon_pp_[0] = s; drygon_pp_[1] = \"\"; drygon_pp_[2] = \"\"; if (is_r) { drygon_pp_[0] = \"\"; drygon_pp_[2] = s; } return drygon_pp_; } drygon_pp_[0] = drygon_substr(s, 0, at); drygon_pp_[1] = drygon_substr(s, at, at + m); drygon_pp_[2] = drygon_substr(s, at + m, n); return drygon_pp_; }\n";
    p[1355] = "int drygon_pp_eq(char** pp, char* a, char* b, char* c) { return drygon_streq(pp[0], a) && drygon_streq(pp[1], b) && drygon_streq(pp[2], c); }\n";
    p[1356] = "static char** drygon_slines_[1024];\n";
    p[1357] = "static int drygon_nlines_;\n";
    p[1358] = "char** drygon_splitlines(char* s) { int n = 0; int start = 0; int i = 0; drygon_nlines_ = 0; while (1) { char c = s[i]; if (c == 10 || c == 13 || c == 0) { if (i > start || c == 0 ? (i > start) : 0) { } if (i > start) { if (drygon_nlines_ < 1024) { drygon_slines_[drygon_nlines_] = drygon_substr(s, start, i); drygon_nlines_ = drygon_nlines_ + 1; } } if (c == 13 && s[i+1] == 10) i = i + 1; start = i + 1; if (c == 0) break; } i = i + 1; } return drygon_slines_; }\n";
    p[1359] = "int drygon_lines_match(char* s, char* e0, char* e1, char* e2, char* e3, char* e4, char* e5, int nb) { char* exp[6]; exp[0] = e0; exp[1] = e1; exp[2] = e2; exp[3] = e3; exp[4] = e4; exp[5] = e5; char** a = drygon_splitlines(s); int na = drygon_nlines_; if (na != nb) return 0; int i; for (i = 0; i < na; i++) { if (!drygon_streq(a[i], exp[i])) return 0; } return 1; }\n";
    p[1363] = "static char drygon_concat_buf_[16384];\nstatic char* drygon_concat(char* a, char* b) { int i = 0; int j = 0; while (a[i] && i < 8000) { drygon_concat_buf_[i] = a[i]; i = i + 1; } while (b[j] && i < 16000) { drygon_concat_buf_[i] = b[j]; i = i + 1; j = j + 1; } drygon_concat_buf_[i] = 0; return drygon_concat_buf_; }\n";
    p[1364] = "static int drygon_ccat_i_[512]; static int drygon_ccat_n_; static int* drygon_ccat_i(int* a, int na, int* b, int nb) { int i; drygon_ccat_n_ = na + nb; for (i = 0; i < na; i++) drygon_ccat_i_[i] = a[i]; for (i = 0; i < nb; i++) drygon_ccat_i_[na + i] = b[i]; return drygon_ccat_i_; }\n";
    p[1365] = "double drygon_atof(char* s) { int i = 0; int neg = 0; double v = 0.0; double f = 0.1; if (!s) return 0.0; if (s[0] == 45) { neg = 1; i = 1; } while (s[i] >= 48 && s[i] <= 57) { v = v * 10.0 + (double)(s[i] - 48); i = i + 1; } if (s[i] == 46) { i = i + 1; while (s[i] >= 48 && s[i] <= 57) { v = v + (double)(s[i] - 48) * f; f = f * 0.1; i = i + 1; } } if (s[i] == 101 || s[i] == 69) { int en = 0; int es = 1; int e = 0; i = i + 1; if (s[i] == 43) i = i + 1; else if (s[i] == 45) { es = -1; i = i + 1; } while (s[i] >= 48 && s[i] <= 57) { e = e * 10 + (s[i] - 48); i = i + 1; } en = e * es; while (en > 0) { v = v * 10.0; en = en - 1; } while (en < 0) { v = v / 10.0; en = en + 1; } } if (neg) v = 0.0 - v; return v; }\n";
    p[1366] = "static char drygon_istr_buf_[4096]; static char* drygon_istr(int* v, int n) { int i = 0; int p = 0; drygon_istr_buf_[p] = 91; p = p + 1; while (i < n) { if (i > 0) { drygon_istr_buf_[p] = 44; p = p + 1; drygon_istr_buf_[p] = 32; p = p + 1; } { char* q = itoa10(v[i]); int k = 0; while (q[k] && p < 4000) { drygon_istr_buf_[p] = q[k]; p = p + 1; k = k + 1; } } i = i + 1; } drygon_istr_buf_[p] = 93; p = p + 1; drygon_istr_buf_[p] = 0; return drygon_istr_buf_; }\n";
    p[1367] = "long drygon_lidx(long i, long n) { if (i < 0 || i >= n) { py_raise_str(\"IndexError\", \"list index out of range\"); return 0; } return i; }\n";
    p[1368] = "int drygon_int_ck(char* s) { int i = 0; int neg = 0; if (!s || !s[0]) { py_raise_str(\"ValueError\", \"invalid literal for int()\"); return 0; } if (s[0] == 45 || s[0] == 43) i = 1; if (s[i] < 48 || s[i] > 57) { py_raise_str(\"ValueError\", \"invalid literal for int()\"); return 0; } while (s[i]) { if (s[i] < 48 || s[i] > 57) { py_raise_str(\"ValueError\", \"invalid literal for int()\"); return 0; } i = i + 1; } if (neg) return 0; return drygon_atoi(s); }\n";
