        else cg_put(g, " > _tk");
        cg_put(g, ") {\n");
        g->indent++;
        cg_indent(g);
        cg_put(g, dst); cg_put(g, sarr); cg_put(g, "[_tj + 1] = "); cg_put(g, dst);
        cg_put(g, sarr); cg_put(g, "[_tj];\n");
        cg_indent(g);
        cg_put(g, dst); cg_put(g, "_lx[_tj + 1] = "); cg_put(g, dst); cg_put(g, "_lx[_tj];\n");
