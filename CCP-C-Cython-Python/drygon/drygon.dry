                }
            }
            if (v && d_strcmp(v->type,"BLOCK")==0 && d_strcmp(v->value,"TUPLE")==0 &&
                a->children[1] && a->children[1]->nchildren > 0) {
                const IRNode* sq = a->children[1];
                int is_enum_seq = 0;
                if (d_strcmp(sq->type,"CALL")==0 && sq->value &&
                    d_strcmp(sq->value,"enumerate")==0) {
                    is_enum_seq = 1;
                    sq = sq->children[0];
                }
                if (cg_is_list_node(sq)) {
                    int j = 0;
                    while (j < v->nchildren && j < 2) {
                        const IRNode* vn = v->children[j];
                        if (vn && d_strcmp(vn->type,"IDENTIFIER")==0) {
                            int got = 0;
                            if (is_enum_seq) {
                                if (j == 1 && cg_node_is_str_static(sq->children[0])) got = 1;
                            } else {
                                int k = 0;
                                while (k < sq->nchildren && !got) {
                                    const IRNode* el = sq->children[k];
                                    if (el && d_strcmp(el->type,"BLOCK")==0 &&
                                        d_strcmp(el->value,"TUPLE")==0 &&
                                        j < el->nchildren &&
                                        cg_node_is_str_static(el->children[j])) got = 1;
                                    k++;
                                }
                            }
                            if (got) cg_note_str(vn->value);
                        }
                        j++;
                    }
                }
            }
        }
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* l = a->children[0];
            const IRNode* r = a->children[1];
            if (l && d_strcmp(l->type,"IDENTIFIER")==0 && l->value && r) {
                if (cg_node_is_str_static(r) || cg_is_strlist_node(r) || cg_mrs_call(r)) cg_note_str(l->value);
                else cg_forget_str(l->value);
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_static_str(a->children[i]); i++; }
    }
    /* A function body is typed in its own scope.  Python lets a function read a
     * module global, so the module's string names stay visible -- but a
     * parameter or a local assignment shadows them.  Without the pop below the
     * module-level `for n in names:` left `n` marked as a string, which made
     * `fib`'s int parameter read as text: `fib(n-1) + fib(n-2)` became a
     * str_concat() of two pointers and the first call segfaulted. */
    static char cg_str_snap[8][16384];
    static int cg_str_snap_n[8];
    static int cg_str_depth;
    static void cg_str_push(void) {
        if (cg_str_depth >= 0 && cg_str_depth < 8) {
            int b = 0;
            while (b < 16384) { cg_str_snap[cg_str_depth][b] = cg_str_vars[b]; b++; }
            cg_str_snap_n[cg_str_depth] = cg_nstr_vars;
        }
        cg_str_depth = cg_str_depth + 1;
    }
    static void cg_str_pop(void) {
        cg_str_depth = cg_str_depth - 1;
        if (cg_str_depth >= 0 && cg_str_depth < 8) {
            int b = 0;
            while (b < 16384) { cg_str_vars[b] = cg_str_snap[cg_str_depth][b]; b++; }
            cg_nstr_vars = cg_str_snap_n[cg_str_depth];
        }
        if (cg_str_depth < 0) cg_str_depth = 0;
    }
    /* Shadow the enclosing scope with one function's own names: its parameters
     * as its base signature types them, then every local the syntax binds. */
    static void cg_scope_enter_m(const IRNode* fd, int mask) {
        cg_str_push();
        const IRNode* pr = fd->nchildren > 0 ? fd->children[0] : NULL;
        int p = 0;
        while (pr && p < pr->nchildren) {
            const char* pn = pr->children[p]->value;
            if (pn && pn[0]) {
                if (mask & (1 << p)) cg_note_str(pn);
                else cg_forget_str(pn);
            }
            p++;
        }
        if (fd->nchildren > 1) cg_scan_static_str(fd->children[1]);
    }
    static void cg_scope_enter(const IRNode* fd) { cg_scope_enter_m(fd, cg_fn_base_mask(fd->value)); }
    static void cg_scope_exit(void) { cg_str_pop(); }
    static void cg_put_nm(CGen* g, const char* buf, int base) {
        int j = 0;
        while (j < 63) {
            char ch = buf[base + j];
            if (!ch) break;
            char s[2]; s[0] = ch; s[1] = 0;
            cg_put(g, s);
            j++;
        }
    }
    static int cg_dict_slot(const char* name) { return cg_dict_index(name); }
    /* A list with a runtime element count: `xs = [1, 2]` gets `<t> xs[64]` plus
     * `xs_n`, a split list already has `xs_n`, and a list parameter receives its
     * count as the extra trailing argument.  Only these can be mutated. */
    static int cg_is_dyn_list(const char* nm) {
        if (!nm || !nm[0]) return 0;
        if (cg_list_index(nm) >= 0) return 1;
        if (cg_sl_index(nm) >= 0) return 1;
        if (cg_is_lparam(nm)) return 1;
        return 0;
    }
    static int cg_dyn_type(const char* nm) {
        if (cg_list_index(nm) >= 0) return cg_list_flags_at(nm);
        if (cg_sl_index(nm) >= 0) return 2;
        if (cg_is_lparam(nm)) return cg_lparam_type(nm);
        return 0;
    }
    /* ── string lists produced by `s.split(sep)` ──────────────────────────
     * Python's split returns a list of strings.  Backed by a file-scope
     * `char* name[64]` array plus a runtime element count in `name_n`. */
    static char cg_sl_names[4096];
    static int cg_nsl_vars;
    static int cg_sl_index(const char* name) {
        int i = 0;
        while (i < cg_nsl_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_sl_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    static void cg_note_strlist(const char* name) {
        if (!name || !name[0]) return;
        /* the list registry has to learn the element type too: the call-site
         * scan runs before anything is emitted and reads cg_list_is_str, so a
         * string list whose flag is still unset gets force-typed as int there
         * and the emit-time note redeclares the literal array as `int` */
        int li = cg_list_index(name);
        if (li >= 0) cg_list_flags[li] = 2;
        else {
            /* The name is not in the list registry yet: the append scan can run
             * before the `x = []` note that registers it, and without an entry
             * the flag above is a no-op, so the declaration stayed `int x[64]`
             * while an element was a `char*` (a crash in the membership test).
             * Register it here as a string list. */
            cg_note_list(name, 64, 2);
            li = cg_list_index(name);
            if (li >= 0) cg_list_flags[li] = 2;
        }
        if (cg_sl_index(name) >= 0) return;
        if (cg_nsl_vars >= 64) return;
        int base = cg_nsl_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_sl_names[base + j] = name[j]; j++; }
        cg_sl_names[base + j] = 0;
        cg_nsl_vars = cg_nsl_vars + 1;
    }
    static int cg_sl_cap(const char* name) { return cg_sl_index(name) >= 0 ? 64 : -1; }
    /* `attrs = dir(obj)` binds the name to a list of STRINGS: register it before
     * any declaration or `"x" in attrs` test is emitted (12_classes 43/44). */
    static void cg_dir_reg(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1 &&
            a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
            a->children[1] && d_strcmp(a->children[1]->type,"CALL")==0 &&
            a->children[1]->value && d_strcmp(a->children[1]->value,"dir")==0) {
            cg_note_strlist(a->children[0]->value);
        }
        if (d_strcmp(a->type,"CLASS_DEF")==0 || d_strcmp(a->type,"FUNCTION_DEF")==0) return;
        int i = 0;
        while (i < a->nchildren) { cg_dir_reg(a->children[i]); i++; }
    }
    /* literal-backing element count of the strlist name at slot i (or -1) */
    static int cg_sl_size_n(int i) {
        char nm[64];
        int j = 0;
        while (j < 63) {
            char ch = cg_sl_names[i*64 + j];
            nm[j] = ch;
            if (!ch) break;
            j++;
        }
        nm[63] = 0;
        return cg_list_size(nm);
    }
    /* `v[i]` on a split list is a string (unlike `s[i]` on a string, a char). */
    static int cg_is_strlist_node(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"ARRAY_ACCESS")!=0) return 0;
        if (a->nchildren<1) return 0;
        const IRNode* b = a->children[0];
        if (!b || d_strcmp(b->type,"IDENTIFIER")!=0) return 0;
        return cg_sl_index(b->value) >= 0;
    }
    /* ── list slices ──────────────────────────────────────────────────────
     * `xs[a:b]` on a python list is a *new* list, not a string: the elements
     * selected by the (clamped, possibly negative) bounds are copied into a
     * file-scope backing array with its own runtime element count, so the
     * result can be printed, iterated, indexed and passed on like any other
     * list.  One backing array per slice site; the copy runs immediately
     * before the statement that contains the slice. */
    static const IRNode* cg_slnode[64];
    static int cg_slnode_et[64];
    static int cg_nslnode;
    static int cg_slx_index(const IRNode* n) {
        int i = 0;
        while (i < cg_nslnode) { if (cg_slnode[i] == n) return i; i++; }
        return -1;
    }
    static void cg_sl_put_name(CGen* g, int k) {
        cg_put(g, "_dysq");
        cg_put_int(g, k);
    }
    /* "_dysqK" as a C string: the name tables are keyed by text. */
    static char cg_sl_nbuf[16];
    static const char* cg_sl_name_of(int k) {
        int len = 0;
        cg_sl_nbuf[len] = 95; len++;
        cg_sl_nbuf[len] = 100; len++;
        cg_sl_nbuf[len] = 121; len++;
        cg_sl_nbuf[len] = 115; len++;
        cg_sl_nbuf[len] = 113; len++;
        if (k >= 10) { cg_sl_nbuf[len] = (char)(48 + (k / 10)); len++; }
        cg_sl_nbuf[len] = (char)(48 + (k % 10)); len++;
        cg_sl_nbuf[len] = 0;
        return cg_sl_nbuf;
    }
    /* True when `n` is `sorted(xs)` over a known python list.  Its result is
     * a fresh list built by the same statement-temp machinery as a slice, so
     * every site below treats the two identically. */
    /* element type of the list a slice/sorted node reads from: 0 int,
     * 1 double, 2 char*.  A base may itself be a slice temp or another
     * sorted() temp, in which case its registered element type wins. */
    static int cg_sl_base_et(const IRNode* n) {
        const IRNode* b = (n && n->nchildren > 0) ? n->children[0] : 0;
        if (!b) return 0;
        /* a static string source (sorted("hello")) is a list of char* */
        if (d_strcmp(b->type,"CONSTANT")==0 &&
            (d_strcmp(b->data_type,"STR")==0 || d_strcmp(b->data_type,"FSTR")==0)) return 2;
        if (d_strcmp(b->type,"IDENTIFIER")==0) {
            if (cg_list_is_trow(b->value)) return 3;
            /* Use the post-prescan (final declaration) element type so that
             * the slice function stride matches the variable's C declaration.
             * Without this, a variable that is int[] mid-program but char*[]
             * at the end gets drygon_lslice_i on a char*[] source → wrong stride. */
            int pf = cg_list_flags_prescan_at(b->value);
            if (pf > 0) return pf;
            return cg_dyn_type(b->value);
        }
        int k = cg_slx_index(b);
        if (k >= 0) return cg_slnode_et[k];
        if (d_strcmp(b->type,"SLICE")==0 || d_strcmp(b->type,"CALL")==0) return cg_sl_base_et(b);
        if (d_strcmp(b->type,"BLOCK")==0 && (d_strcmp(b->value,"LIST")==0||d_strcmp(b->value,"TUPLE")==0)) {
            int ci = 0;
            int t2 = 0;
            while (ci < b->nchildren) {
                /* a tuple literal row makes the list a tuple-row list: rows
                 * sort by a key element and print from their compile-time
                 * reprs, never from the int backing array */
                if (b->children[ci] && d_strcmp(b->children[ci]->type,"BLOCK")==0 &&
                    d_strcmp(b->children[ci]->value,"TUPLE")==0) return 3;
                if (cg_node_is_str_static(b->children[ci])) return 2;
                if (cg_is_float_node(b->children[ci])) t2 = 1;
                ci = ci + 1;
            }
            return t2;
        }
        return 0;
    }
    static int cg_sl_base_cap(const IRNode* n) {
        const IRNode* b = (n && n->nchildren > 0) ? n->children[0] : 0;
        if (!b || d_strcmp(b->type,"IDENTIFIER")!=0) return 64;
        return cg_list_size(b->value);
    }
    static int cg_sl_islice(const IRNode* n);
    /* `sorted(d)` over a dict: a python list of the dict's keys. */
    static int cg_sl_isdictsorted(const IRNode* n) {
        if (!n || d_strcmp(n->type,"CALL")!=0) return 0;
        if (d_strcmp(n->value,"sorted")!=0 && d_strcmp(n->value,"sorted_r")!=0) return 0;
        if (n->nchildren != 1) return 0;
        const IRNode* b = n->children[0];
        if (!b) return 0;
        if (d_strcmp(b->type,"IDENTIFIER")==0) return cg_is_dict(b->value);
        /* `sorted(d.keys())` / `sorted(d.values())`: same temp machinery, the
         * source being the dict's own parallel arrays. */
        if (d_strcmp(b->type,"CALL")==0 && d_strcmp(b->value,"COMPLEX")==0 &&
            cg_mcx_recv(b) && cg_mcx_meth(b)) {
            const IRNode* rc = cg_mcx_recv(b);
            if (!rc->value || d_strcmp(rc->type,"IDENTIFIER")!=0) return 0;
            if (!cg_is_dict(rc->value)) return 0;
            return d_strcmp(cg_mcx_meth(b),"keys")==0 || d_strcmp(cg_mcx_meth(b),"values")==0;
        }
        return 0;
    }
    static int cg_sl_issorted(const IRNode* n) {
        if (!n || d_strcmp(n->type,"CALL")!=0) return 0;
        int isr = d_strcmp(n->value,"sorted_r")==0;
        /* reversed(xs) needs the same statement temp as sorted(xs): a copy of
         * the source that is then reversed in place by drygon_lrev_*. */
        int isv = d_strcmp(n->value,"reversed")==0;
        /* `sorted(xs, key=cmp_to_key(f))`: same statement temp, sorted by the
         * comparator f instead of the natural order */
        int isk2 = d_strcmp(n->value,"sorted_cmpk")==0;
        if (d_strcmp(n->value,"sorted")!=0 && !isr && !isv && !isk2) return 0;
        if (isv) { if (n->nchildren != 1) return 0; }
        else if (isk2) { if (n->nchildren != 2) return 0; }
        else if (n->nchildren != 1 && n->nchildren != 2) return 0;
        const IRNode* b = n->children[0];
        if (!b) return 0;
        /* sorted("hello") is a python list of the string's characters */
        if (d_strcmp(b->type,"CONSTANT")==0 &&
            (d_strcmp(b->data_type,"STR")==0 || d_strcmp(b->data_type,"FSTR")==0)) return 1;
        if (d_strcmp(b->type,"IDENTIFIER")!=0) return cg_is_list_node(b) ? 1 : cg_sl_islice(b);
        /* reversed(dict) yields the keys in insert order, which this temp does
         * not model: keep it out of the slice machinery so the failure stays a
         * per-check trap instead of breaking the generated C. */
        if (isv && cg_is_dict(b->value)) return 0;
        return cg_is_dyn_list(b->value);
    }
    /* True when `n` is a slice of, or sorted() over, a known python list
     * (rather than a string, which keeps its `drygon_substr` lowering). */
    static int cg_sl_islice(const IRNode* n) {
        if (!n) return 0;
        if (d_strcmp(n->type,"CALL")==0) return cg_sl_issorted(n) || cg_sl_isdictsorted(n);
        if (d_strcmp(n->type,"SLICE")!=0) return 0;
        if (n->nchildren < 1 || !n->children[0]) return 0;
        const IRNode* b = n->children[0];
        if (d_strcmp(b->type,"IDENTIFIER")!=0) return cg_sl_islice(b);
        return cg_is_dyn_list(b->value);
    }
    static const IRNode* cg_eval_tuple_expr(const IRNode* n) {
        if (!n) return 0;
        if (cg_is_list_node(n)) return n;
        if (d_strcmp(n->type, "BINARY_OP") == 0 && n->nchildren >= 2) {
            if (d_strcmp(n->value, "+") == 0) {
                const IRNode* el1 = cg_eval_tuple_expr(n->children[0]);
                const IRNode* el2 = cg_eval_tuple_expr(n->children[1]);
                if (el1 && el2 && cg_is_list_node(el1) && cg_is_list_node(el2)) {
                    IRNode* res = ir_new("BLOCK", el1->value, el1->data_type);
                    int k = 0;
                    while (k < el1->nchildren) {
                        ir_add_child(res, (IRNode*)el1->children[k]);
                        k++;
                    }
                    k = 0;
                    while (k < el2->nchildren) {
                        ir_add_child(res, (IRNode*)el2->children[k]);
                        k++;
                    }
                    return res;
                }
            } else if (d_strcmp(n->value, "*") == 0) {
                const IRNode* el1 = cg_eval_tuple_expr(n->children[0]);
                const IRNode* el2 = cg_eval_tuple_expr(n->children[1]);
                const IRNode* tup = (el1 && cg_is_list_node(el1)) ? el1 : ((el2 && cg_is_list_node(el2)) ? el2 : 0);
                const IRNode* cnt_node = (tup == el1) ? el2 : el1;
                if (tup && cnt_node && d_strcmp(cnt_node->type, "CONSTANT") == 0) {
                    int rep = 0;
                    int si = 0;
                    const char* cv = cnt_node->value;
                    while (cv && cv[si] >= '0' && cv[si] <= '9') {
                        rep = rep * 10 + (cv[si] - '0');
                        si++;
                    }
                    IRNode* res = ir_new("BLOCK", tup->value, tup->data_type);
                    int r = 0;
                    while (r < rep) {
                        int k = 0;
                        while (k < tup->nchildren) {
                            ir_add_child(res, (IRNode*)tup->children[k]);
                            k++;
                        }
                        r++;
                    }
                    return res;
                }
            }
        }
        /* `list("abc")` / `tuple("abc")`: expand the string literal into the
         * sequence of its one-character strings so `==`/`!=` compare it as a
         * list and not as a CALL node whose children are call arguments
         * (13_builtins check 42, `list("abc") == ["a","b","c"]`). */
        if (d_strcmp(n->type, "CALL") == 0 && n->value &&
            (d_strcmp(n->value, "list") == 0 || d_strcmp(n->value, "tuple") == 0) &&
            n->nchildren > 0 && n->children[0] &&
            d_strcmp(n->children[0]->type, "CONSTANT") == 0 &&
            cg_node_is_str_static(n->children[0])) {
            const char* sv = n->children[0]->value;
            int slen = (int)d_strlen(sv);
            if (slen >= 2 && (sv[0] == '\'' || sv[0] == '"') &&
                (sv[slen-1] == '\'' || sv[slen-1] == '"')) { sv++; slen -= 2; }
            IRNode* sres = ir_new("BLOCK", "LIST", "char*");
            int sk = 0;
            while (sk < slen) {
                char lit[4];
                lit[0] = '"'; lit[1] = sv[sk]; lit[2] = '"'; lit[3] = 0;
                ir_add_child(sres, ir_new("CONSTANT", lit, "STR"));
                sk++;
            }
            return sres;
        }
        /* `list([1,2,3])`, `list((1,2,3))`, `list({1,2})`: the wrapper is a
         * no-op, so evaluate straight to the literal sequence -- leaving the
         * CALL made `list((1,2,3)) == [1,2,3]` compare a 1-argument call
         * against a 3-element literal and fold to a constant 0
         * (13_builtins check 43). */
        if (d_strcmp(n->type, "CALL") == 0 && n->value &&
            (d_strcmp(n->value, "list") == 0 || d_strcmp(n->value, "tuple") == 0) &&
            n->nchildren > 0 && cg_is_list_node(n->children[0])) {
            const IRNode* inner = cg_eval_tuple_expr(n->children[0]);
            if (cg_is_list_node(inner)) return inner;
        }
        return n;
    }
    static int cg_tuple_cmp(const IRNode* a, const IRNode* b) {
        int i = 0;
        int min_len = a->nchildren < b->nchildren ? a->nchildren : b->nchildren;
        while (i < min_len) {
            long va = 0;
            long vb = 0;
            if (a->children[i] && a->children[i]->value) {
                int neg = 0; int si = 0; const char* v = a->children[i]->value;
                if (v[0] == '-') { neg = 1; si = 1; }
                while (v[si] >= '0' && v[si] <= '9') { va = va * 10 + (v[si] - '0'); si++; }
                if (neg) va = 0 - va;
            }
            if (b->children[i] && b->children[i]->value) {
                int neg = 0; int si = 0; const char* v = b->children[i]->value;
                if (v[0] == '-') { neg = 1; si = 1; }
                while (v[si] >= '0' && v[si] <= '9') { vb = vb * 10 + (v[si] - '0'); si++; }
                if (neg) vb = 0 - vb;
            }
            if (va < vb) return -1;
            if (va > vb) return 1;
            i++;
        }
        if (a->nchildren < b->nchildren) return -1;
        if (a->nchildren > b->nchildren) return 1;
        return 0;
    }
    static int cg_is_list_like(const IRNode* a) {
        if (!a) return 0;
        /* `list(x)` / `tuple(x)` yield a sequence, so `len()` must use the
         * element count and not the string length (drygon_slen on an int array
         * returned garbage). */
        if (d_strcmp(a->type,"CALL")==0 && a->value &&
            (d_strcmp(a->value,"list")==0 || d_strcmp(a->value,"tuple")==0)) {
            /* `list(reversed(xs))` is still the slice temp the source call was
             * lowered into: reporting a plain literal made `== [..]` compare
             * child counts and fold to a constant 0 (13_builtins check 76). */
            if (a->nchildren == 1 && cg_sl_islice(a->children[0])) return 3;
            return 1;
        }
        const IRNode* ea = cg_eval_tuple_expr(a);
        if (cg_is_list_node(ea)) return 1;
        if (d_strcmp(a->type,"IDENTIFIER")==0 && cg_is_dyn_list(a->value)) return 2;
        if (d_strcmp(a->type,"MEMBER_ACCESS")==0 && a->value &&
            a->nchildren>0 && a->children[0] &&
            cg_lf_recv_field(a->children[0], a->value)) return 1;
        if (cg_sl_islice(a)) return 3;
        return 0;
    }
    static int cg_sl_add(const IRNode* n, int et) {
        int i = cg_slx_index(n);
        if (i >= 0) return i;
        if (cg_nslnode >= 64) return -1;
        cg_slnode[cg_nslnode] = n;
        cg_slnode_et[cg_nslnode] = et;
        /* registering the backing array with the list table gives the whole
         * pipeline (declaration, print, iteration, indexing) one name to work
         * with, exactly like a list literal or a split() result */
        int cap = cg_sl_base_cap(n);
        if (cap < 64) cap = 64;
        cg_note_list(cg_sl_name_of(cg_nslnode), cap, et == 3 ? 0 : et);
        if (et == 3) {
            cg_note_lx(cg_sl_name_of(cg_nslnode));
            cg_note_trow(cg_sl_name_of(cg_nslnode));
            /* the temp carries the same key tables as the tuple-row source it
             * was sorted from */
            const IRNode* b = (n && n->nchildren > 0) ? n->children[0] : 0;
            const char* sn = (b && d_strcmp(b->type,"IDENTIFIER")==0) ? b->value : "";
            int bits = sn[0] ? cg_list_kybits(sn) : 0;
            cg_list_kyf[cg_list_index(cg_sl_name_of(cg_nslnode))] = bits;
        }
        cg_nslnode = cg_nslnode + 1;
        return cg_nslnode - 1;
    }
    /* "_dysqK"/"_dylitK" as a writable buffer, for name-table lookups */
    static void cg_lit_name_buf(int k, char* out) {
        int len = 0;
        out[len] = 95; len++;
        out[len] = 100; len++;
        out[len] = 121; len++;
        out[len] = 108; len++;
        out[len] = 105; len++;
        out[len] = 116; len++;
        if (k >= 10) { out[len] = (char)(48 + (k / 10)); len++; }
        out[len] = (char)(48 + (k % 10)); len++;
        out[len] = 0;
    }
    /* Resolve the tuple-row source name for sorted()/slicing: a plain list
     * name, a slice/sorted temp, or the literal temp a tuple-row list
     * literal lowers into.  Returns 0 when the source cannot be resolved. */
    static int cg_trow_src_name(const IRNode* b, char* out) {
        out[0] = 0;
        if (!b) return 0;
        if (d_strcmp(b->type,"IDENTIFIER")==0) {
            int z = 0;
            while (b->value[z] && z < 63) { out[z] = b->value[z]; z++; }
            out[z] = 0;
            return 1;
        }
        if (cg_is_list_node(b)) {
            int lk = cg_lit_index(b);
            if (lk < 0) lk = cg_lit_add(b);
            if (lk < 0) return 0;
            cg_lit_name_buf(lk, out);
            return 1;
        }
        int k = cg_slx_index(b);
        if (k >= 0) {
            const char* tp = cg_sl_name_of(k);
            int z = 0;
            while (tp[z] && z < 63) { out[z] = tp[z]; z++; }
            out[z] = 0;
            return 1;
        }
        return 0;
    }
    /* The key element index a `sorted(X, key=lambda t: t[K])` call sorts by:
     * the lambda body's ARRAY_ACCESS constant child.  -1 when there is no
     * key (python sorts by the row's first element). */
    static int cg_sorted_key_index(const IRNode* n) {
        if (!n || n->nchildren < 2) return -1;
        const IRNode* kw = n->children[1];
        if (!kw || d_strcmp(kw->type,"KWARG")!=0 || d_strcmp(kw->value,"key")!=0 ||
            kw->nchildren < 1) return -1;
        const IRNode* body = kw->children[0];
        while (body) {
            if (d_strcmp(body->type,"ARRAY_ACCESS")==0 && body->nchildren > 1 &&
                body->children[1] && d_strcmp(body->children[1]->type,"CONSTANT")==0) {
                const char* v = body->children[1]->value;
                if (v && v[0] >= '0' && v[0] <= '9') return v[0] - '0';
                return -1;
            }
            if (body->nchildren > 0) body = body->children[body->nchildren - 1];
            else break;
        }
        return -1;
    }
    /* The element index of a `key=lambda t: t[K]` kwarg: the lambda body's
     * constant subscript.  -1 when the key is not a constant index. */
    static int cg_kwarg_key_index(const IRNode* kw) {
        if (!kw || kw->nchildren < 1) return -1;
        const IRNode* body = kw->children[0];
        while (body) {
            if (d_strcmp(body->type,"ARRAY_ACCESS")==0 && body->nchildren > 1 &&
                body->children[1] && d_strcmp(body->children[1]->type,"CONSTANT")==0) {
                const char* v = body->children[1]->value;
                if (v && v[0] >= '0' && v[0] <= '9' && v[1] == 0) return v[0] - '0';
                return -1;
            }
            if (body->nchildren > 0) body = body->children[body->nchildren - 1];
            else break;
        }
        return -1;
    }
    /* sorted() over a tuple-row list (or a slice of one): rows are not
