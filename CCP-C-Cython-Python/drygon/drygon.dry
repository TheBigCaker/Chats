                    cg_put(g, "((void)"); cg_gen_expr(g, a->children[0]); cg_put(g, ", ");
                    cg_put(g, cg_fn_ret_strlist(a->children[0]->value) ? "drygon_rls_n)" : "drygon_rl_n)");
                }
                else if (a && d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren==2 &&
