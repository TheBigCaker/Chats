                        d_strncpy(cg_cvar_cls[qi], cn, 31); cg_cvar_cls[qi][31] = 0;
                        found = 1; break;
                    }
                    qi++;
                  }
                  if (!found && cg_cvar_n < 512) {
                    d_strncpy(cg_cvar_names[cg_cvar_n], alhs->value, 31); cg_cvar_names[cg_cvar_n][31] = 0;
                    d_strncpy(cg_cvar_cls[cg_cvar_n], cn, 31); cg_cvar_cls[cg_cvar_n][31] = 0;
                    cg_cvar_n++;
