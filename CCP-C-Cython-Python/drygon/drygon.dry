                cg_put_int(g, lr); cg_put(g, "]; ");
                cg_put(g, alhs->value); cg_put(g, "_n = "); cg_put(g, alhs->value);
                cg_put(g, "_n + 1; _lq"); cg_put_int(g, lr);
                cg_put(g, " = _lq"); cg_put_int(g, lr); cg_put(g, " + 1; }\n");
                cg_indent(g);
                return;
            }
            /* `lines = s.splitlines()`: the destination is a char* ARRAY, so
