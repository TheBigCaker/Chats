    return 0;
}
static void cg_note_list(const char* name, int n, int isf);
/* ---- native memoryview / bytearray / array.array (53_memoryview, 30 checks) ----
 * A view is an `int` handle into the prelude's dmv table (see the `dmv` block in
 * dc_runtime_prelude): the slot names a byte buffer plus an offset, a count, an
 * itemsize and a format character.  These helpers recognise a view expression,
 * remember which names hold one, and are the hooks that turn the python view
 * operations into dmv_* calls. */
static char cg_mv_nm[2048];
static int cg_mv_kv[32];
static int cg_nmv;
static int cg_mv_lookup(const char* name) {
    if (!name) return -1;
    int i = 0;
    while (i < cg_nmv) {
        int base = i * 64;
        int j = 0;
        int eq = 1;
        while (1) {
            int ca = cg_mv_nm[base + j];
            int cb = name[j];
            if (ca != cb) { eq = 0; break; }
            if (ca == 0) break;
            j++;
        }
        if (eq) return i;
        i++;
    }
    return -1;
}
static void cg_mv_note(const char* name, int k) {
    if (!name || !name[0]) return;
    if (cg_mv_lookup(name) >= 0) return;
    if (cg_nmv >= 32) return;
    int base = cg_nmv * 64;
    int j = 0;
    while (j < 63 && name[j]) { cg_mv_nm[base + j] = name[j]; j++; }
    cg_mv_nm[base + j] = 0;
    cg_mv_kv[cg_nmv] = k;
    cg_nmv = cg_nmv + 1;
}
/* the method name of a `recv.meth(...)` call, else 0 */
static const char* cg_mv_meth(const IRNode* n) {
    if (!n) return 0;
    if (d_strcmp(n->type,"CALL") != 0) return 0;
    if (!n->value || d_strcmp(n->value,"COMPLEX") != 0) return 0;
    if (n->nchildren <= 0 || !n->children[0]) return 0;
    const IRNode* t = n->children[0];
    if (d_strcmp(t->type,"MEMBER_ACCESS") != 0) return 0;
    if (t->nchildren <= 0 || !t->children[0]) return 0;
    return t->value;
}
/* the receiver node of a `recv.meth(...)` call */
static const IRNode* cg_mv_recv(const IRNode* n) { return n->children[0]->children[0]; }
/* 0 none, 1 memoryview, 2 bytearray, 3 array.array */
static int cg_mv_kind_expr(const IRNode* n) {
    if (!n) return 0;
    if (d_strcmp(n->type,"IDENTIFIER") == 0) {
        int k = cg_mv_lookup(n->value);
        if (k >= 0) return cg_mv_kv[k];
        return 0;
    }
    if (d_strcmp(n->type,"SLICE") == 0 && n->nchildren > 0) return cg_mv_kind_expr(n->children[0]);
    if (d_strcmp(n->type,"CALL") != 0 || !n->value) return 0;
    if (d_strcmp(n->value,"memoryview") == 0 && n->nchildren > 0)
        return cg_mv_kind_expr(n->children[0]) == 2 ? 2 : 1;
    if (d_strcmp(n->value,"bytearray") == 0) return 2;
    if (d_strcmp(n->value,"COMPLEX") == 0) {
        const char* m = cg_mv_meth(n);
        if (!m) return 0;
        if (d_strcmp(m,"cast") == 0) return cg_mv_kind_expr(cg_mv_recv(n)) > 0 ? 1 : 0;
        if (d_strcmp(m,"array") == 0) {
            const IRNode* r = cg_mv_recv(n);
            if (r && d_strcmp(r->type,"IDENTIFIER") == 0 && d_strcmp(r->value,"array") == 0) return 3;
        }
    }
    return 0;
}
/* `v.tobytes()` on a view, and `v.format`, both yield a string */
static int cg_mv_isstrofs(const IRNode* a) {
    if (!a) return 0;
    if (d_strcmp(a->type,"MEMBER_ACCESS") == 0 && a->value &&
        d_strcmp(a->value,"format") == 0 && a->nchildren > 0)
        return cg_mv_kind_expr(a->children[0]) > 0;
    const char* m = cg_mv_meth(a);
    if (m && d_strcmp(m,"tobytes") == 0) return cg_mv_kind_expr(cg_mv_recv(a)) > 0;
    return 0;
}
/* `v.tolist()`: the receiver node, else 0 */
static const IRNode* cg_mv_tolist_recv(const IRNode* a) {
    if (!a) return 0;
    const char* m = cg_mv_meth(a);
    if (m && d_strcmp(m,"tolist") == 0) {
        const IRNode* r = cg_mv_recv(a);
        if (cg_mv_kind_expr(r) > 0) return r;
    }
    return 0;
}
/* a slice of a view is another view, not a string */
static int cg_mv_isviewslice(const IRNode* a) {
    if (!a) return 0;
    if (d_strcmp(a->type,"SLICE") != 0 || a->nchildren <= 0) return 0;
    return cg_mv_kind_expr(a->children[0]) > 0;
}
/* `v.shape` / `v.strides` are int sequences */
static int cg_mv_isshapeof(const IRNode* a) {
    if (!a) return 0;
    if (d_strcmp(a->type,"MEMBER_ACCESS") != 0 || !a->value || a->nchildren <= 0) return 0;
    if (d_strcmp(a->value,"shape") != 0 && d_strcmp(a->value,"strides") != 0) return 0;
    return cg_mv_kind_expr(a->children[0]) > 0;
}
/* pre-pass: remember every name that ends up holding a view, and register a
 * backing array for `lst = v.tolist()`.  The backing-array declarations are
 * emitted before the function bodies, so the list has to be known here rather
 * than at statement-emission time. */
static void cg_mv_scan(const IRNode* n) {
    if (!n) return;
    if (d_strcmp(n->type,"ASSIGN") == 0 && n->nchildren > 1) {
        const IRNode* lhs = n->children[0];
        const IRNode* rhs = n->children[1];
        if (lhs && d_strcmp(lhs->type,"IDENTIFIER") == 0) {
            const IRNode* tr = cg_mv_tolist_recv(rhs);
            if (tr) {
                cg_note_list(lhs->value, 64, 0);
                cg_forget_str(lhs->value);
            } else {
                int k = cg_mv_kind_expr(rhs);
                if (k > 0) { cg_mv_note(lhs->value, k); cg_forget_str(lhs->value); }
            }
        }
    }
    int i = 0;
    while (i < n->nchildren) { cg_mv_scan(n->children[i]); i++; }
}
/* a typecode literal such as 'd' / "f" / b'f' names a float array */
static int cg_mv_flt1(const char* s) {
    if (!s) return 0;
    int i = 0;
    while (s[i] == 39 || s[i] == 34 || s[i] == 98) i++;
    if (s[i] == 100 || s[i] == 102) return 1;
    return 0;
}
static int cg_mv_fmtf(const IRNode* n) {
    if (!n) return 0;
    if (d_strcmp(n->type,"CONSTANT") == 0) return cg_mv_flt1(n->value);
    if (d_strcmp(n->type,"SLICE") == 0 && n->nchildren > 0) return cg_mv_fmtf(n->children[0]);
    if (d_strcmp(n->type,"CALL") != 0 || !n->value) return 0;
    if (d_strcmp(n->value,"memoryview") == 0 && n->nchildren > 0)
        return cg_mv_fmtf(n->children[0]);
    if (n->nchildren > 1 && n->children[1]) return cg_mv_fmtf(n->children[1]);
    return 0;
}
/* a 1-element tuple literal such as `(5,)` */
static int cg_mv_istuple(const IRNode* a) {
    if (!a) return 0;
    if (d_strcmp(a->type,"BLOCK") != 0 || !a->value) return 0;
    return d_strcmp(a->value,"TUPLE") == 0;
}
/* a list / tuple literal holding no strings */
static int cg_mv_isintblock(const IRNode* a) {
    if (!a) return 0;
    if (d_strcmp(a->type,"BLOCK") != 0 || !a->value) return 0;
    if (d_strcmp(a->value,"LIST") != 0 && d_strcmp(a->value,"TUPLE") != 0) return 0;
    if (a->nchildren <= 0) return 0;
