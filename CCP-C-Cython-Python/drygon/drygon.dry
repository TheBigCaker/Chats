    /* ── per-function signature facts ──────────────────────────────────────
     * A python function carries no types.  Two properties are recovered from
     * the program text before anything is generated:
     *   * a function that returns a string returns `char*`;
     *   * a parameter that is handed a string by any call site (and is not
     *     used arithmetically) is declared `char*` so the body can index,
     *     measure and print it. */
    static char cg_prog_fns[16384];
    static int cg_prog_nparams[256];
