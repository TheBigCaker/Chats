 * native path helpers.  `obj.name` on a class instance must NOT match --
 * the field read has to keep using the instance layout. */
static int cg_path_strrecv(const IRNode* r) {
    if (!r) return 0;
    if (d_strcmp(r->type,"CONSTANT")==0)
        return d_strcmp(r->data_type,"STR")==0 || d_strcmp(r->data_type,"FSTR")==0;
    if (d_strcmp(r->type,"CALL")==0 && cg_native_strfn(r->value)) return 1;
    if (d_strcmp(r->type,"IDENTIFIER")==0) {
        int i = 0;
        while (i < cg_nstr_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_str_vars[base + j];
                int cb = r->value[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    if (d_strcmp(r->type,"ARRAY_ACCESS")==0) {
        if (cg_is_strlist_node(r)) return 1;
        if (r->nchildren>0 && r->children[0] &&
            d_strcmp(r->children[0]->type,"IDENTIFIER")==0) {
            const char* bn = r->children[0]->value;
            if (cg_list_size(bn) >= 0 && cg_list_is_str(bn)) return 1;
            if (cg_is_lparam(bn) && cg_lparam_type(bn) == 2) return 1;
        }
        return 0;
    }
