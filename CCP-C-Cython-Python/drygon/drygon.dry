                    int slen = tot - pfx - sfx;
                    if (slen < 0) slen = 0;
                    int k = 0;
                    while (k < pfx) {
                        if (k > 0) cg_indent(g);
                        cg_gen_expr(g, alhs->children[k]);
                        cg_put(g, " = ");
                        cg_gen_expr(g, arhs->children[k]);
                        cg_put(g, ";\n");
                        k++;
                    }
                    int sj = 0;
                    while (sj < slen) {
                        if (k > 0 || sj > 0) cg_indent(g);
                        cg_put(g, sname); cg_put(g, "["); cg_put_int(g, sj); cg_put(g, "] = ");
                        cg_gen_expr(g, arhs->children[pfx + sj]);
                        cg_put(g, ";\n");
                        sj++;
                    }
                    if (k > 0 || sj > 0) cg_indent(g);
                    cg_put(g, sname); cg_put(g, "_n = "); cg_put_int(g, slen); cg_put(g, ";\n");
                    int sk = 0;
                    while (sk < sfx) {
                        cg_indent(g);
                        cg_gen_expr(g, alhs->children[star_idx + 1 + sk]);
                        cg_put(g, " = ");
                        cg_gen_expr(g, arhs->children[tot - sfx + sk]);
                        cg_put(g, ";\n");
                        sk++;
                    }
