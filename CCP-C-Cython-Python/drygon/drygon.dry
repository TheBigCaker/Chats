                int cnf = 0;
                if (cg_cur_base_class) {
                    int bi = 0;
                    while (bi < cg_cls_n - 1) {
                        if (d_strcmp(cg_cls_names[bi], cg_cur_base_class) == 0) {
                            const IRNode* bbody = cg_cls_body[bi];
                            if (bbody) {
                                int bmi = 0;
                                while (bmi < bbody->nchildren) {
                                    const IRNode* bmc = bbody->children[bmi];
                                    if (d_strcmp(bmc->type,"FUNCTION_DEF")==0 && bmc->nchildren>1)
                                        cg_cls_collect(bmc->children[1], cfn, &cnf, 32);
                                    bmi++;
