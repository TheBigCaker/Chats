    d_strcpy(p+pos, "void* signal(int sig, void* h) { long sa[32]; long old[32]; int i=0; while(i<32){sa[i]=0;i++;} i=0; while(i<32){old[i]=0;i++;} if (dg_tp == 0) { dg_tp = dg_mktop(); } sa[0]=(long)h; sa[1]=0x04000000; sa[2]=dg_tp; sa[3]=0; long r=_raw_syscall(134, sig, (long)sa, (long)old, 8, 0, 0); if (r == 0) { return (void*)old[0]; } return (void*)-1; }\n"); pos += d_strlen(p+pos);
