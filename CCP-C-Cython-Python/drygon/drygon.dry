    /* hex()/oct()/bin()/format() builtins */
    p[1470] = "static char _drad[80];\nstatic char* drygon_radix(long long v, int base, char* pre) {\nchar t[80];\nint n = 0;\nint p = 0;\nint neg = 0;\nif (v < 0) { neg = 1; v = 0 - v; }\nif (v == 0) { t[n] = 48; n = n + 1; }\n";
    p[1471] = "while (v > 0) { int d = (int)(v % base); t[n] = d < 10 ? (char)(48 + d) : (char)(87 + d); n = n + 1; v = v / base; }\nif (neg) { _drad[p] = 45; p = p + 1; }\n";
    p[1472] = "int i = 0;\nwhile (pre[i]) { _drad[p] = pre[i]; p = p + 1; i = i + 1; }\nwhile (n > 0) { n = n - 1; _drad[p] = t[n]; p = p + 1; }\n_drad[p] = 0;\nreturn _drad;\n}\n";
    p[1473] = "char* drygon_hex(long long v) { return drygon_radix(v, 16, \"0x\"); }\nchar* drygon_oct(long long v) { return drygon_radix(v, 8, \"0o\"); }\nchar* drygon_bin(long long v) { return drygon_radix(v, 2, \"0b\"); }\n";
    p[1474] = "char* drygon_format(long long v, char* spec) {\nif (!spec) return itoa10(v);\nint i = 0;\nint zero = 0;\nint width = 0;\nchar ty = 100;\nwhile (spec[i]) {\nchar c = spec[i];\nif (c >= 48 && c <= 57) { if (i == 0 && c == 48) zero = 1; else width = width * 10 + (c - 48); }\nelse if (c == 120 || c == 111 || c == 98) ty = c;\ni = i + 1;\n}\nchar* base;\nif (ty == 120) base = drygon_radix(v, 16, \"\");\nelse if (ty == 98) base = drygon_radix(v, 2, \"\");\n";
    p[1475] = "else if (ty == 111) base = drygon_radix(v, 8, \"\");\nelse base = itoa10(v);\nif (zero && width > (int)drygon_slen(base)) {\nstatic char _dpz[80];\nint p = 0;\nint k = 0;\nif (base[0] == 45) { _dpz[p] = 45; p = p + 1; k = 1; }\nwhile (p < width - (int)drygon_slen(base) + k) { _dpz[p] = 48; p = p + 1; }\nwhile (base[k]) { _dpz[p] = base[k]; p = p + 1; k = k + 1; }\n_dpz[p] = 0;\nreturn _dpz;\n}\nreturn base;\n}\n";
    p[1476] = "static char _dfmt[80];\nchar* drygon_fmt_f(double v, char* spec) {\nint prec = 2;\nint i = 1;\nif (spec && spec[0] == 46) { prec = 0; while (spec[i] >= 48 && spec[i] <= 57) { prec = prec * 10 + (spec[i] - 48); i = i + 1; } }\n";
    p[1477] = "if (prec > 9) prec = 9;\nint neg = 0;\nif (v < 0.0) { neg = 1; v = 0.0 - v; }\ndouble sc = 1.0;\nfor (int k = 0; k < prec; k++) sc = sc * 10.0;\nlong long nn = (long long)(v * sc + 0.5);\nlong long scn = (long long)sc;\n";
    p[1478] = "long long ip = scn > 0 ? nn / scn : nn;\nlong long fp = scn > 0 ? nn % scn : 0;\nint p = 0;\nif (neg) { _dfmt[p] = 45; p = p + 1; }\nchar t[40];\nint tn = 0;\nif (ip == 0) { t[tn] = 48; tn = tn + 1; }\n";
    p[1479] = "while (ip > 0) { t[tn] = (char)(48 + ip % 10); tn = tn + 1; ip = ip / 10; }\nwhile (tn > 0) { tn = tn - 1; _dfmt[p] = t[tn]; p = p + 1; }\nif (prec > 0) { _dfmt[p] = 46; p = p + 1; }\n";
    p[1480] = "char f[16];\nfor (int k = prec - 1; k >= 0; k--) { f[k] = (char)(48 + fp % 10); fp = fp / 10; }\nfor (int k = 0; k < prec; k++) { _dfmt[p] = f[k]; p = p + 1; }\n_dfmt[p] = 0;\nreturn _dfmt;\n}\n";
    p[1481] = "static char _dmnmx[2];\nchar* drygon_minstr(char* s, int n) {\nint i = 1;\nchar b = s[0];\nwhile (i < n) { if (s[i] < b) b = s[i]; i = i + 1; }\n_dmnmx[0] = b; _dmnmx[1] = 0;\nreturn _dmnmx;\n}\n";
