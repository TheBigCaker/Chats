                cg_lf_recv_field(alhs->children[0], alhs->value)) {
                const IRNode* lrecv = alhs->children[0];
                const char* lfx = alhs->value;
                const char* lfcls = cg_lf_recv_cls(lrecv);
                int lfstr = (lfcls && lfcls[0] && cg_lf_kind(lfcls, lfx) == 2);
                cg_indent(g);
