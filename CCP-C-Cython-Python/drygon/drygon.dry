     * nothing at the use site, so `static INLINE int f()`, `int f(int x UNUSED)`
     * and `EMPTY 5` all have to read as though the name were not written. */
    while (pp_no_skip == 0 && l->tok.kind == T_IDENT && fm_empty_macro(l->tok.text)) lex_next(l);
    l->has_tok = 1;
}
static DcToken* lex_cur(Lexer* l) {
    lex_peek(l);
    return &l->tok;
}
static void lex_advance(Lexer* l) {
    if (l->has_tok) {
        if (l->tok.kind == T_LBRACE) l->brace_depth = l->brace_depth + 1;
        else if (l->tok.kind == T_RBRACE) l->brace_depth = l->brace_depth - 1;
    }
    l->has_tok = 0;
}
static int lex_is(Lexer* l, int k) {
    DcToken* t = lex_cur(l);
    return t->kind == k;
}
static int lex_kind(Lexer* l) {
    DcToken* t = lex_cur(l);
    return t->kind;
}
/* Consume exactly one token.  `lex_advance` only clears the cached-token flag,
 * so calling it twice in a row -- with no peek in between -- consumes nothing
 * the second time: the next token has never been materialised.  Any place that
 * walks several tokens (declarators in particular) has to peek before each
 * advance, which is what this does. */
static void lex_consume(Lexer* l) {
    lex_cur(l);
    lex_advance(l);
}
static void lex_skip_recover(Lexer* l) {
    /* After a syntax error, resync at a statement boundary so one run can
     * report every front-end error instead of only the first.
     * Depth-aware: inside a block, stop *before* the `}` that would close the
     * block we are in (the enclosing comp_block / comp_function then terminates
     * normally), so one bad statement cannot swallow the rest of the file. At
     * file scope, skip past the end of the failed body instead. */
    int bd0 = l->brace_depth;
    int par = 0;
    while (1) {
        int k = lex_kind(l);
        if (k == T_EOF) return;
        if (k == T_RBRACE) {
            if (l->brace_depth > bd0) {
                lex_advance(l);
                if (l->brace_depth <= bd0) return;
                continue;
            }
            if (bd0 > 0) return;    /* our own block's closer: leave it */
            lex_advance(l);
            return;                 /* file scope: the failed body just closed */
        }
        if (k == T_SEMI && par <= 0 && l->brace_depth <= bd0) { lex_advance(l); return; }
        if (k == T_LPAREN || k == T_LBRACKET) par = par + 1;
        else if (k == T_RPAREN || k == T_RBRACKET) par = par - 1;
        lex_advance(l);
    }
}
static int lex_expect(Lexer* l, int k) {
    DcToken* t = lex_cur(l);
    if (t->kind != k) {
        d_puts("direct_compiler: expected kind=");
        d_putdec(k);
        d_puts(" got kind=");
        d_putdec(t->kind);
        d_puts(" text='");
        d_puts(t->text);
        d_puts("' line=");
        d_putdec(t->line);
        d_puts(" pos=");
        d_putdec(l->pos);
        d_puts(" snip=");
        {
            int a = l->pos - 60; int b = l->pos + 20; int q;
            if (a < 0) a = 0;
            q = a;
            while (q < b && l->src[q]) {
                if (l->src[q] == 10) d_putc(124); else d_putc(l->src[q]);
                q++;
            }
        }
        d_putc(10);
        if (l->rec) {
            l->errs = l->errs + 1;
            if (l->errs > 400) { d_puts("direct_compiler: too many errors\n"); sys_exit(2); }
            lex_skip_recover(l);
            return 0;
        }
        sys_exit(1);
    }
    lex_advance(l);
    return 1;
}

static long lex_num(Lexer* l) {
    DcToken* t = lex_cur(l);
    return t->num;
}
static char* lex_text(Lexer* l) {
    DcToken* t = lex_cur(l);
    if (t->big) return t->big;
    return t->text;
}

/* Collect one or more adjacent string literals into a heap buffer and return it
 * with *plen set to the total decoded length (NUL-terminated).  The seven
 * hand-written copies of this loop each ran through a `char sbuf[512]` with a
 * hard 500-byte limit, so every string initializer -- and every prelude slot --
 * was silently cut at 500 chars.  Heap + explicit length removes the cap.
 * IMPORTANT: copy the first literal BEFORE the lookahead, because
 * `lex_cur()`/`lex_advance()` re-lex into the lexer's single cached token and a
 * pointer at that token's storage is destroyed by the search for adjacent
 * literals.  Returns NULL on allocation failure (caller falls back). */
static char* lex_cat_str(Lexer* l, int* plen) {
    const char* first = lex_text(l);
    int fl = 0;
    while (first[fl]) fl = fl + 1;
    char* buf = (char*)d_alloc((size_t)(fl + 65536));
    if (!buf) return 0;
    d_memcpy(buf, first, fl);
    buf[fl] = 0;
    int sl = fl;
    lex_advance(l);
    while (lex_is(l, T_STR)) {
        const char* tt = lex_text(l);
        int k2 = 0;
        while (tt[k2]) k2 = k2 + 1;
        char* nb = (char*)d_alloc((size_t)(sl + k2 + 65536));
        if (!nb) break;
        d_memcpy(nb, buf, sl);
        buf = nb;
        d_memcpy(buf + sl, tt, k2);
        sl = sl + k2;
        buf[sl] = 0;
        lex_advance(l);
    }
    *plen = sl;
    return buf;
}
static int lex_line(Lexer* l) {
    DcToken* t = lex_cur(l);
    return t->line;
}

/* ------ Compiler state ------------------------------------------------------------------------------------------------------------------------------------------------------------------------ */
static int g_data_start = 0;
/* global variable table: allocated in the output data section */
static char gvar_names_buf[65536];
static int gvar_sizes[1024];
/* scalar initializer value for globals declared `T g = CONST;` */
static int gvar_init[1024];
static int gvar_has_init[1024];
static int gvar_elems[1024];
/* Declared as `unsigned ...` at file scope: a 4/2/1-byte read must zero-extend
 * (ldr w) rather than sign-extend, or 0xFFFFFFFF reads back as -1. */
static int gvar_uns[1024];
/* 1 when the global was declared `double`/`float`: such a global holds an
 * IEEE-754 value, loaded into/stored from d0 rather than x0. */
static int gvar_is_float[1024];
/* 1 when the global is a pointer to a floating point type (`double* p`), so
 * that `p[i]` loads a double rather than an integer. */
static int gvar_pfloat[1024];
/* 1 when the global was declared with subscripts: such a name decays to its
 * address in an rvalue context instead of loading the first element. */
static int gvar_is_array[1024];
/* ------ Function-local `static` objects ------------------------------------
 * A `static` at statement scope has static storage duration, so it cannot live
 * on the frame: it is registered as a global under an internal label built
 * from lstat_seq (the '~' prefix cannot occur in a C identifier, so the label
 * can never collide with a real global, and the sequence number keeps two
 * functions' same-named statics apart).  The source name is aliased to that
 * global for the duration of the enclosing function, so every existing global
 * read/write path resolves it through comp_find_gvar without changes.  Before
 * this, the storage class was simply dropped and the object became an ordinary
 * stack local, so `static int n = 0; n = n + 1;` restarted at 0 on every call.
 * lstat_n is the alias count (64 aliases max) and is reset by comp_function. */
static char lstat_names_buf[64 * 64];
static int lstat_gvar[64];
static int lstat_n;
static int lstat_seq;
/* ------ Function signatures ------------------------------------------------
 * Which functions return a `double` and which of their parameters are
 * `double`, so that a call site can pass and receive IEEE-754 values in the
 * floating point registers instead of truncating them into x0..x7. */
static char fn_names_buf[65536];
static int fn_ret_float[1024];
static int fn_ret_f32[1024];
static int fn_nparams[1024];
/* Returns-POINTER tracking: 1 when the function returns a pointer, plus the
 * byte size of the pointee's element (1/2/4/8; pointer-to-pointer is 8, a
 * pointer to an aggregate is the struct size).  comp_primary needs this to
 * start a postfix chain on a call result in pointer mode with the right
 * subscript stride: `f()[0]` on a `char*`-returning f used to load the first
 * 8 bytes of the returned buffer as a pointer (extra deref), crashing on any
 * initializer string.  0 = not a pointer (or unknown). */
static int fn_ret_ptr[1024];
static int fn_ret_pelem[1024];
static char fn_pf_zeros[8];
/* Byte size of an aggregate returned by value (0 = not an aggregate). AAPCS64
 * returns one <=16 bytes in x0..x1, so a call site must repack those registers
 * into a destination object. */
static int fn_ret_agg[1024];
/* Name of the hidden slot the call site parks a returned aggregate in. Reusing
 * one name makes comp_add_var_sized hand back the same slot, so no new local
 * is appended per call -- which is what corrupted the frame when the name was
 * generated from the live variable count. */
static char g_agg_ret_name[32];
/* initialised once at startup, not per compile: a per-compiler reset would
 * leave the name empty and silently alias an unrelated variable */
static int g_agg_ret_init;
static char fn_pfloat[1024 * 8];
static int g_cur_fn_ret_agg;   /* size if this function returns an aggregate */
static int g_pending_ret_agg;  /* size handed to comp_function by the caller */
static int nfnsig;
static int g_cur_fn_ret_float; /* return type of the function being compiled */
/* Aggregate table slot (slot+1) of each global's element type, so that
 * `g.member`, `g[i].member` and `p->member` on a global resolve their field
 * layout. 0 means "not an aggregate". */
static int gvar_eslots[1024];
/* Row stride (bytes) for a multi-dim global `T[A][B]...`: B*...*esz. 0 = flat. */
static int gvar_rowsz[1024];
/* file-scope initializer bytes per gvar (little-endian packed); the data
 * section emitter overlays these over the zero-fill. */
static char gvar_init_pool[1048576];
static int gvar_init_off[1024];   /* base offset into the pool for this gvar */
static int gvar_init_len[1024];   /* bytes actually initialized */
static int gvar_init_used;        /* pool cursor */
/* string-pointer initializers (const char* fields): the data word pair is
 * backfilled with the string's absolute address after patch resolution */
static int ginit_str_gv[8192];
static int ginit_str_off[8192];
static int ginit_str_id[8192];
/* byte offset of a backfilled pointer within its data word (0/4), so a pointer
 * member that is not 8-byte aligned is spliced in rather than overwriting the
 * neighbouring field */
static int ginit_str_sub[8192];
/* `&global` in an initializer: the target is an object, not a string, so the
 * entry carries the global's NAME here (ginit_amp[pi] = 1) and the resolve pass
 * builds its gvar_label. */
static int ginit_amp[8192];
static char ginit_amp_buf[8192 * 64];
/* For a global whose initializer is a string, the string id to materialise
 * PC-relatively when that global is READ (-1 = none).  Storing the address in
 * the data word only works for the .ros blob; an ET_DYN .elf loads at a
 * non-zero base, so the address has to be built with adrp/add at the use site. */
static int gvar_addr_str[1024];
static int ginit_str_w[8192];
static int ginit_str_n;
/* File-scope function-pointer initializers: `int (*gp)(int) = fn;` records the
 * function name so the data word can be backfilled with its address once the
 * label table is complete. */
static int ginit_fn_gv[1024];
static int ginit_fn_off[1024];
static char ginit_fn_name_buf[1024 * 64];
static int ginit_fn_n = 0;
static int ngvars;
typedef struct Compiler {
    Code code;
    /* per-function: var name -> stack offset */
    char var_names_buf[1024*64];
    int var_offsets[1024];
    int nvars;
    int frame_size;
    /* per-function: var is float (double) */
    int var_is_float[1024];
    /* var is array (decays to pointer) */
    int var_is_array[1024];
    /* pointee byte size for pointer vars (0 = unknown/char, 4 = int, 8 = long/double, 2 = short) */
    int var_pointee[1024];
    /* the pointee/element of this pointer is a floating point type, so
     * `p[i]` / `*p` must load into d0 instead of x0 (double* p, double xs[]) */
    int var_pfloat[1024];
    /* expression result is in d0 (float) rather than x0 */
    int expr_is_float;
    /* suppress the comma-operator level (declarator lists, argument lists) */
    int no_comma;
    /* store width hint: set by an integer cast in the RHS of `*p = v;` */
    int cast_sz_hint;
    /* pointee size of the most recent pointer cast, so that a postfix chain
     * applied to a parenthesised cast expression (`((float*)p)[i]`) uses the
     * right element stride. 0 = unknown. */
    int ptr_hint;
    /* 1 when the expression just compiled left an ADDRESS in x0 that a
     * following `.member` / `->member` should chain off (an aggregate-returning
     * call).  A plain variable base resolves through the frame-slot tables
     * instead, so this stays 0 for it. */
    int chain_from_value;
    /* offset of the first saved variadic register slot (0 = not variadic) */
    int va_base_off;
    int va_dbl_off;
    int va_dbl_idx;
    /* pending compound-assignment operator (0 = plain assignment) */
    int cmp_op;
    /* description of the last primary when it was an assignable lvalue:
     * used to store back the result of a postfix ++/--. */
    int lval_ok;
    int lval_base_off;
    int lval_moff;
    int lval_w;
    /* prologue sub sp placeholder index + return epilogue add sp indices */
    int frame_sub_idx;
    int ret_add_idx[1024];
    int nret_add;
    /* function name -> code label (for calls) */
    char fn_names_buf[256*64];
    int nfns;
    /* loop stack for break/continue */
    int loop_break[64];
    int loop_cont[64];
    int nloops;
    int loop_ids[64];
    int loop_counter;
    /* string literals */
    int str_ids[256];
    int nstrs;
    /* unique label counter for if/else/loops */
    int lbl_counter;
    /* ------ Typedef-name --- resolved-type table ---------------------------------------------------------------------------------------------------
     * For C99 self-compilation we must track that `typedef struct Foo Foo;`
     * lets the user write `Foo x;` as if Foo were a primitive type. We
     * record the *kind* (TK_STRUCT/TK_UNION/TK_ENUM/scalar) and the byte
     * size so codegen knows how much stack to allocate when one of these
     * names appears in a local declaration. */
    char td_names_buf[32768];
    int td_kinds[512];    /* 0 = scalar/int, 1 = struct, 2 = union, 3 = enum, 4 = pointer, 5 = void */
    int td_sizes[512];    /* byte size of the type (for stack alloc) */
    int td_offsets[512];  /* for struct fields: when a struct-typed local is allocated, this is its base offset */
    int td_unsigned[512]; /* 1 when the alias is an unsigned integer type */
    int td_slots[512];    /* struct/union slot+1 for an aggregate alias (0 = n/a) */
    int td_n;
    /* ------ Struct/union field-offset table ---------------------------------------------------------------------------------------------------------------
     * Indexed by struct name. fields[] is a flat list of (name, offset, size)
     * triples terminated by an entry whose name[0]==0. Used for lowering
     * `s.field` reads/writes to `ldr/str [xs, #offset]`. */
    char su_names_buf[16384];
    int su_kind[256];     /* 1 = struct, 2 = union */
    char su_fields_buf[2097152];  /* up to 128 fields per aggregate */
    int su_field_off_buf[256*128];
    int su_field_size_buf[256*128];
    int su_nfields[256];
    int su_size[256];
    int su_align[256];
    int su_n;
    /* ------ Switch tracking: case label patching --------------------------------------------------------------------------------------------- */
    int switch_depth;            /* number of nested switches */
    int switch_ncase[16];
    char switch_break_lbl_buf[1024]; /* break jumps here */
    /* Loop nesting in effect when each switch was entered.  `break` belongs to
     * the innermost enclosing switch *or* loop, so the switch owns the break
     * only when no loop was opened after it (see the T_BREAK arm). */
    int switch_nloops[16];
    /* ------ Labels for goto --------------------------------------------------------------------------------------------------------------------------------------------------------------- */
    char lbl_defined_buf[32768];
    int lbl_defined_idx[512];
    int lbl_ndefined;
    /* pending goto: a b instruction that needs patching when label resolves */
    char lbl_pending_buf[4096];
    int lbl_pending_idx[64];
    int lbl_npending;
    /* ------ Enum constants ------------------------------------------------------------------------------------------------------------------------------------------------------------------ */
    char enum_names_buf[8192];
    int enum_values[128];
    int enum_n;
    /* ------ Goto label resolution --------------------------------------------------------------------------------------------------------------------------------------------- */
    /* Stack of `goto label;` statement indices, paired with their target name,
     * resolved when label definition is reached. */
    char goto_pending_buf[4096];
    int goto_pending_idx[64];
    int goto_npending;
    /* ------ Per-field element sizes (for `p->f[i]` scaling) ------------------------
     * For a pointer or array field: the byte size of the pointed-to / element
     * type, plus the struct slot of that element type (-1 when unknown). Both
     * tables are indexed exactly like su_field_off_buf. */
    int su_field_elem_buf[256*128];
    int su_field_eslot_buf[256*128];
    /* struct slot of the local's pointee / array element type, stored as
     * slot+1 so that 0 keeps meaning "unknown" */
    int var_eslot[1024];
    /* Element size recorded before the variable existed. A declaration parses
     * its type (`long* p`) before it registers the name, so the pointee set
     * for a not-yet-known name is stashed here and applied by the next
     * comp_add_var_sized; dropping it silently degraded `p[i]` to a 1-byte
     * stride. */
    char pend_var_name[64];
    int pend_var_pointee;
    int pend_var_pfloat;
    int pend_var_has;
    /* True multi-dim strides, appended last so the hand-baked offsets in
     * comp_known_off stay valid. rowsz = bytes of one row of a `T[A][B]...`
     * object (product of every dimension after the first, times the element
     * size); 0 = not multi-dim. sizes = the declared object bytes (what
     * sizeof reports). su_field_rowsz mirrors it for aggregate members. */
    int var_rowsz[1024];
    int var_sizes[1024];
    int su_field_rowsz_buf[256*128];
    /* Declared scalar width, appended last so the hand-baked offsets in
     * comp_known_off stay valid. +w = signed scalar of w bytes, -w = unsigned,
     * 0 = pointer/array/aggregate/unknown (64-bit loads keep working for
     * those). A 1-byte scalar slot can be written through a pointer
     * (sys_read(&ch, 1)), leaving bytes 1..7 stale, so its reads must be
     * byte-width rather than the plain 64-bit slot load. */
    int var_ssz[1024];
    /* Set while compiling the operand of `&`: the postfix chain hanging off a
     * parenthesised base must yield the member/element ADDRESS, so the load
     * comp_primary would normally emit is suppressed. `&((T*)0)->m` used to
     * dereference address 0 (bus error); this makes it the compile-time offset
     * idiom _OFF_OF relies on. Appended last so comp_known_off stays valid. */
    int addr_of;
    /* Set while the sub-lexer is parsing a macro expansion. The expanded text
     * lives in the single shared fm_expbuf, so a macro name encountered inside
     * another expansion must not start a second expansion -- that would
     * overwrite the text still being parsed. Nested calls are already expanded
     * textually by fm_nest before the parse, so nothing is lost. */
    int in_macro;
    /* pointee stride of the lvalue recorded by the last primary/member chain
     * (0 = not a pointer): a pointer lvalue incremented by postfix ++/-- must
     * step by sizeof(*p), not 1 byte. */
    int lval_stride;
} Compiler;

/* Generate a unique label like "L_else_skip_42" into buf. */
static void comp_unique_label(Compiler* c, char* prefix, char* buf) {
    int n = c->lbl_counter;
    c->lbl_counter = c->lbl_counter + 1;
    int i = 0;
    buf[i] = 76; i = i + 1;
    buf[i] = 95; i = i + 1;
    while (*prefix) {
        buf[i] = *prefix;
        i = i + 1;
        prefix = prefix + 1;
    }
    buf[i] = 95; i = i + 1;
    if (n == 0) {
        buf[i] = 48;
        i = i + 1;
    } else {
        char tmp[16];
        int ti = 0;
        int n2 = n;
        while (n2) {
            tmp[ti] = 48 + (n2 % 10);
            ti = ti + 1;
            n2 = n2 / 10;
        }
        { int k = 0; while (k < ti) { buf[i] = tmp[ti - 1 - k]; i = i + 1; k++; } }
    }
    buf[i] = 0;
}

static int comp_find_gvar(char* name) {
    int i = 0;
    while (i < ngvars) {
        if (d_strcmp(gvar_names_buf + i * 64, name) == 0) return i;
        i = i + 1;
    }
    /* Function-local `static`: the object is registered in gvar_names_buf under
     * a mangled label, so the source name only lives in the alias table.  The
     * scan is backwards so an inner block shadows an outer same-named static. */
    i = lstat_n - 1;
    while (i >= 0) {
        if (d_strcmp(lstat_names_buf + i * 64, name) == 0) return lstat_gvar[i];
        i = i - 1;
    }
    return -1;
}
static void gvar_label(char* out, char* name) {
    out[0] = 103; out[1] = 118; out[2] = 97; out[3] = 114; out[4] = 95;
    int i = 0;
    int p = 5;
    while (name[i] != 0 && p < 70) {
        out[p] = name[i];
        p = p + 1;
        i = i + 1;
    }
    out[p] = 0;
}
static void comp_gvar_addr(Compiler* c, char* name) {
    char gvl[80];
    /* A function-local `static` is only known by an alias, so the label has to
     * come from the global table entry rather than from the source name. */
    int gai = comp_find_gvar(name);
    char* nm = (gai >= 0) ? (gvar_names_buf + gai * 64) : name;
    gvar_label(gvl, nm);
    int idx = c->code.nwords;
    code_emit(&c->code, a_adrp(0, 0));
    code_emit(&c->code, a_addi(0, 0, 0));
    code_patch(&c->code, idx, gvl, 3, 0, 0);
}
static void comp_gvar_addr_reg(Compiler* c, char* name, int reg) {
    char gvl[80];
    int gai = comp_find_gvar(name);
    char* nm = (gai >= 0) ? (gvar_names_buf + gai * 64) : name;
    gvar_label(gvl, nm);
    int idx = c->code.nwords;
    code_emit(&c->code, a_adrp(reg, 0));
    code_emit(&c->code, a_addi(reg, reg, 0));
    code_patch(&c->code, idx, gvl, 3, 0, reg);
}
static int comp_find_var(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_offsets[i]; i--; }
    return -1;
}
/* Apply an element size that was recorded before the variable was registered
 * (see pend_var_name). Called from every comp_add_var_sized, so that the
 * declared pointee/stride survives the declaration's own ordering. */
static void comp_var_flush_pending(Compiler* c, char* name) {
    if (c->pend_var_has == 0) return;
    if (d_strcmp(c->pend_var_name, name) != 0) return;
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            c->var_pointee[i] = c->pend_var_pointee;
            c->var_pfloat[i] = c->pend_var_pfloat;
            c->pend_var_has = 0;
            return;
        }
        i--;
    }
    c->pend_var_has = 0;
}
static int comp_add_var_sized(Compiler* c, char* name, int is_float, int size) {
    int vidx = -1;
    {
        int i = c->nvars - 1;
        while (i >= 0) {
            if (d_strcmp(c->var_names_buf + i*64, name) == 0) { vidx = i; break; }
            i--;
        }
    }
    if (vidx >= 0) {
        if (d_strcmp(name, g_agg_ret_name) == 0) {
            comp_var_flush_pending(c, name);
            return c->var_offsets[vidx];
        }
        if (size == 0 && c->var_is_array[vidx] == 0 && c->var_is_float[vidx] == is_float) {
            comp_var_flush_pending(c, name);
            return c->var_offsets[vidx];
        }
    }
    /* Frame layout: [sp]=saved x29, [sp+8]=saved x30, locals start at +16. */
    int alloc_size = 8;
    if (size > 0) alloc_size = size;
    /* Keep slots 8-byte aligned: a_ldr_x/a_str_x scale their immediate by 8,
     * so a misaligned offset would silently round the address. */
    alloc_size = ((alloc_size + 7) / 8) * 8;
    /* The variable owns the region [16+frame_size, 16+frame_size+alloc_size),
     * so its offset is the LOW end of that region. Placing it at the high end
     * (`+ alloc_size`) only lines up for 8-byte slots; a wider local (a
     * typedef'd struct, an array) then overlapped the next variable, and the
     * next local's initialisation clobbered the aggregate's first members. */
    int off2 = 16 + c->frame_size;
    c->frame_size = c->frame_size + alloc_size;
    /* var_names_buf holds 1024 entries; past that the copy would land on
     * c->nvars and turn the var lookups into a runaway table walk. */
    if (c->nvars < 1024) {
        char* dest = c->var_names_buf + c->nvars*64;
        d_strncpy(dest, name, 63);
        dest[63] = 0;
        c->var_offsets[c->nvars] = off2;
        c->var_is_float[c->nvars] = is_float;
        c->var_is_array[c->nvars] = 0;
        c->var_pfloat[c->nvars] = 0;
        c->var_ssz[c->nvars] = 0;
        c->var_sizes[c->nvars] = (size > 0) ? size : 0;
        c->var_rowsz[c->nvars] = 0;
        c->var_eslot[c->nvars] = 0;
        c->var_pointee[c->nvars] = 0;
        if (size > 0) c->var_is_array[c->nvars] = 1;
        c->nvars = c->nvars + 1;
    }
    comp_var_flush_pending(c, name);
    return off2;
}
static int comp_add_var_typed(Compiler* c, char* name, int is_float) {
    return comp_add_var_sized(c, name, is_float, 0);
}
static int comp_add_var(Compiler* c, char* name) {
    return comp_add_var_typed(c, name, 0);
}
/* Newest registration wins: `comp_find_var` walks backwards, so the frame slot
 * a read resolves to is the last one declared for that name.  A forward walk
 * here could return an *older* `double x` while the read used a newer `int x`,
 * and the assignment would then store IEEE-754 bits in an integer slot. */
static int comp_var_is_float(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_is_float[i]; i--; }
    return 0;
}
/* Forward-walk set: matches comp_set_var_ssz's convention (only the FIRST
 * registration of a name in the current scope is updated), and pairs with the
 * backwards read above because both hit the newest registration for a fresh
 * name; a shadowed older one is intentionally untouched. */
static void comp_set_var_is_float(Compiler* c, char* name, int v) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_is_float[i] = v; return; }
        i--;
    }
}
/* Element stride of the pointer primary the parser just compiled: 0 when the
 * value is not a pointer.  Consumed by `ptr + n` in comp_addsub. */
static int g_ptr_elem_cur = 0;
/* Unsignedness of the primary just compiled.  `u > 0` with an unsigned operand
 * must use the unsigned condition codes (hi/ls), otherwise 0xFFFFFFFF reads as
 * -1 and compares less than zero. */
static int g_uns_cur = 0;
/* 1 when x0 currently holds a value whose C type is a 32-bit integer (the
 * signedness lives in g_uns_cur). Compare codegen must reduce such operands
 * to 32 bits first, or computed 64-bit results (`1 << 31`) fail to equal the
 * sign-extended int32 the expression is typed as. 0 = 64-bit / unknown. */
static int g_int_cur = 0;
static int g_last_call_f32 = 0;
/* Pointer objects are marked in var_eslot as 1000000 + stride.  var_eslot is a
 * pre-existing per-slot table read through the compiler's hand-baked member
 * offset, so no new global has to be introduced (a new global shifts the data
 * section and the second self-host round stops working). */
static void comp_mark_ptr_stride(Compiler* c, char* name, int elem) {
    if (elem <= 0) elem = 1;
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            c->var_eslot[i] = 1000000 + elem;
            return;
        }
        i--;
    }
}
/* Encode a struct slot into an existing pointer-stride marker so that
 * `p->member` can resolve the aggregate type without comp_field_meta_any
 * (which fails when multiple aggregates share a field name). */
static void comp_mark_ptr_slot(Compiler* c, char* name, int tslot) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            if (c->var_eslot[i] >= 1000000) {
                int elem = (c->var_eslot[i] - 1000000) % 65536;
                c->var_eslot[i] = 1000000 + (tslot + 1) * 65536 + elem;
            }
            return;
        }
        i--;
    }
}
static int comp_ptr_stride(Compiler* c, char* name) {
    int i = c->nvars - 1;
    if (i < 0) {
        /* A file-scope pointer global: `char* gt; gt[i]`.  This table was only
         * consulted for LOCALS, so the stride was 0 and `gt[1]` read the wrong
         * address -- `while (gt[n])` saw a terminator at n==1 and stopped.
         * gvar_elems holds the pointee size for a pointer global. */
        int gi = comp_find_gvar(name);
        if (gi >= 0 && gvar_elems[gi] > 0 && gvar_elems[gi] < gvar_sizes[gi]) return gvar_elems[gi];
        return 0;
    }
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            if (c->var_eslot[i] >= 1000000) return (c->var_eslot[i] - 1000000) % 65536;
            if (c->var_is_array[i] && c->var_pointee[i] > 0) return c->var_pointee[i];
            return 0;
        }
        i--;
    }
    int gj = comp_find_gvar(name);
    if (gj >= 0 && gvar_elems[gj] > 0 && gvar_elems[gj] < gvar_sizes[gj]) return gvar_elems[gj];
    return 0;
}
/* Unsigned locals are marked by making var_ssz negative (var_ssz is the signed
 * byte size, so a negative value is otherwise meaningless, and it is an existing
 * per-slot table -- a new global would shift the data section and break the
 * second self-host round, as comp_mark_ptr_stride above notes). */
static void comp_mark_uns(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            int s = c->var_ssz[i];
            if (s == 0) s = 4;
            if (s > 0) c->var_ssz[i] = 0 - s;
            return;
        }
        i--;
    }
}
static int comp_is_uns(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_ssz[i] < 0;
        i--;
    }
    return 0;
}
/* A function pointer is marked with pointee == -8.  Dereferencing it must not
 * load (`(*fp)(x)` calls fp, it does not read memory), so comp_unary's `*` path
 * tests for the marker and leaves the value in x0. */
static void comp_mark_fnptr(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            c->var_pointee[i] = -8;
            return;
        }
        i--;
    }
}
/* Pointer-to-array marker: `int (*parr)[N]` encodes the innermost element
 * size as -(elem) - 100, so a deref can tell it apart from a fnptr (-8) and
 * stride a following `[i]` by the encoded element instead of the stale
 * ptr_hint an unrelated cast may have left behind. */
static void comp_mark_ptr_arr(Compiler* c, char* name, int elem) {
    if (elem < 1) elem = 1;
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) {
            c->var_pointee[i] = -(elem) - 100;
            return;
        }
        i--;
    }
}
static int comp_var_is_array(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_is_array[i]; i--; }
    return 0;
}
/* True when `name` is an object-like macro with an integer body, i.e. recorded
 * in the def_names table that ALSO answers `#if` and array dimensions.  `&`
 * consults it so an operator written on a macro name keeps its macro meaning:
 * the preprocessor substitutes such a name before the parser runs, so a macro
 * wins over a variable that happens to share the spelling. */
static int comp_def_is_macro(char* name) {
    int i = 0;
    while (i < ndefs) {
        if (d_strcmp(def_names_buf + i * 64, name) == 0) return 1;
        i = i + 1;
    }
    return 0;
}
static void comp_set_var_pointee(Compiler* c, char* name, int size) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_pointee[i] = size; return; } i--; }
    /* Not registered yet: keep it for the registration that follows. */
    /* comp_set_var_pfloat may have run first for the same name; in that case
     * its flag must survive, since the pending stash only holds one name. */
    if (!(c->pend_var_has != 0 && d_strcmp(c->pend_var_name, name) == 0)) c->pend_var_pfloat = 0;
    d_strncpy(c->pend_var_name, name, 63);
    c->pend_var_name[63] = 0;
    c->pend_var_pointee = size;
    c->pend_var_has = 1;
}
static int comp_var_pointee(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_pointee[i]; i--; }
    return 0;
}
/* Declared scalar width of a local: +w signed, -w unsigned, 0 = not a plain
 * scalar (or width unknown). Scalars always register before any read, so no
 * pending stash is needed here. Newest registration wins. */
static void comp_set_var_ssz(Compiler* c, char* name, int sz) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_ssz[i] = sz; return; } i--; }
}
static int comp_var_ssz(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_ssz[i]; i--; }
    return 0;
}
/* `double* p` / `double p[]` / `const double* p`: the element read through
 * the pointer is an IEEE-754 value, so `p[i]` and `*p` must produce d0 (and
 * set expr_is_float) instead of a sign-extended x0. Without this a float list
 * passed to a function -- the generated C spells the parameter `double* xs`
 * -- loaded the raw bits as an integer, so the values were nonsense and a
 * `mul` stride of 8 on the wrong base segfaulted. */
static void comp_set_var_pfloat(Compiler* c, char* name, int v) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_pfloat[i] = v; return; }
        i--;
    }
    /* Not registered yet: kept for the registration that follows, without
     * disturbing the pointee size stashed by comp_set_var_pointee. */
    d_strncpy(c->pend_var_name, name, 63);
    c->pend_var_name[63] = 0;
    c->pend_var_pfloat = v;
    c->pend_var_has = 1;
}
static int comp_var_pfloat(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_pfloat[i]; i--; }
    return 0;
}
/* Multi-dim array stride support: locals keep the row stride and the declared
 * object size; globals mirror them in gvar_rowsz/gvar_sizes. */
static void comp_set_var_rowsz(Compiler* c, char* name, int rowsz) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_rowsz[i] = rowsz; return; } i--; }
}
static int comp_var_rowsz(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_rowsz[i]; i--; }
    return 0;
}
static void comp_set_var_size(Compiler* c, char* name, int size) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_sizes[i] = size; return; } i--; }
}
static int comp_var_size(Compiler* c, char* name) {
    int i = c->nvars - 1;
    while (i >= 0) { if (d_strcmp(c->var_names_buf + i*64, name) == 0) return c->var_sizes[i]; i--; }
    return 0;
}
static int comp_gvar_rowsz(char* name) {
    int gi = comp_find_gvar(name);
    if (gi >= 0 && gi < ngvars) return gvar_rowsz[gi];
    return 0;
}
/* Row stride of a chain base: local first, then global. */
static int comp_base_rowsz(Compiler* c, char* name) {
    int r = comp_var_rowsz(c, name);
    if (r > 0) return r;
    return comp_gvar_rowsz(name);
}
static void comp_set_var_eslot(Compiler* c, char* name, int slot) {
    int i = c->nvars - 1;
    while (i >= 0) {
        if (d_strcmp(c->var_names_buf + i*64, name) == 0) { c->var_eslot[i] = slot + 1; return; }
        i--;
    }
}
/* True when sz describes an aggregate small enough to copy byte-by-byte.
 * The upper bound keeps the unrolled copy from exploding on giant structs
 * (drygon's `Code` is 16 MB and only ever lives on the heap). */
static int comp_is_agg(int sz) {
    if (sz > 8 && sz <= 65536) return 1;
    return 0;
}
static void comp_add_fn(Compiler* c, char* name) {
    { int i = 0; while (i < c->nfns) { if (d_strcmp(c->fn_names_buf + i*64, name) == 0) return; i++; } }
    /* fn_names_buf holds 256 entries: without this bound the copy at index 256
     * lands on c->nfns itself and the counter becomes a garbage name prefix,
     * which turns every later lookup into a runaway table walk. */
    if (c->nfns >= 256) return;
    char* dest = c->fn_names_buf + c->nfns*64;
    d_strncpy(dest, name, 63);
    dest[63] = 0;
    c->nfns = c->nfns + 1;
}

/* ------ Function signature table ----------------------------------------------------------------------------
 * Float parameters and float return values have to be visible at the call
 * site: a double goes in a d-register, not in x0..x7, and its return value
 * arrives in d0.  `int f(double x)` cannot be reconstructed from the callee
 * alone once an argument is a literal, so every definition records its
 * signature here and comp_call consults it. */
static void fn_sig_add(char* name, int ret_float, int np, char* pf, int ret_ptr, int pelem, int ret_f32) {
    if (nfnsig >= 1024) return;
    d_strncpy(fn_names_buf + nfnsig*64, name, 63);
    fn_names_buf[nfnsig*64 + 63] = 0;
    fn_ret_float[nfnsig] = ret_float;
    fn_ret_f32[nfnsig] = ret_f32;
    fn_nparams[nfnsig] = np;
    fn_ret_agg[nfnsig] = g_pending_ret_agg;
    fn_ret_ptr[nfnsig] = ret_ptr;
    fn_ret_pelem[nfnsig] = pelem;
    { int i = 0; while (i < 8) { fn_pfloat[nfnsig*8 + i] = pf[i]; i++; } }
    nfnsig = nfnsig + 1;
}
static int fn_sig_find(char* name) {
    int i = 0;
    int last = -1;
    while (i < nfnsig) { if (d_strcmp(fn_names_buf + i*64, name) == 0) last = i; i++; }
    return last;
}
/* 1 = parameter `idx` of `name` is a double passed in a d-register. */
static int fn_param_is_float(char* name, int idx) {
    int s = fn_sig_find(name);
    if (s < 0) return 0;
    if (idx < 0 || idx > 7) return 0;
    return fn_pfloat[s*8 + idx];
}
static char fn_pagg[1024 * 8];
static void fn_sig_set_pagg(char* name, char* pagg) {
    int s = fn_sig_find(name);
    if (s >= 0) {
        int i = 0; while (i < 8) { fn_pagg[s*8 + i] = pagg[i]; i++; }
    }
}
static int fn_param_agg_size(char* name, int idx) {
    int s = fn_sig_find(name);
    if (s < 0) return 0;
    if (idx < 0 || idx > 7) return 0;
    return (unsigned char)fn_pagg[s*8 + idx];
}
static int fn_ret_is_float(char* name) {
    int s = fn_sig_find(name);
    if (s < 0) return 0;
    return fn_ret_float[s];
}
static int fn_ret_is_f32(char* name) {
    int s = fn_sig_find(name);
    if (s < 0) return 0;
    return fn_ret_f32[s];
}

/* ------ Expression compiler --------------------------------------------------------------------------------------------------------------------------------------------------------- */
/* Emits code that evaluates an expression into register x0. */
static int comp_find_typedef(Compiler* c, char* name);
static int comp_find_struct(Compiler* c, char* name);
static int comp_find_enum_const(Compiler* c, char* name);
static int comp_field_offset(Compiler* c, int slot, char* field);
static int comp_field_index(Compiler* c, int slot, char* field);
static int comp_field_offset_any(Compiler* c, char* field, int* pslot, int* psize);
static int comp_field_meta(Compiler* c, int slot, char* field, int* pw, int* pelem, int* peslot, int* puns, int* pptr, int* prowsz, int* pflt);
static int comp_field_meta_any(Compiler* c, char* field, int* pslot, int* pw, int* pelem, int* peslot, int* puns, int* pptr, int* prowsz, int* pflt);
static void dc_gi_begin(int gv);
static void dc_gi_store(int gv, int off, long v, int width);
static void dc_gi_skip_item(Compiler* c, Lexer* l);
static void dc_gi_scalar(Compiler* c, Lexer* l, int gv, int off, int width);
static void dc_gi_strbytes(Compiler* c, Lexer* l, int gv, int off, int cap);
static void dc_gi_array(Compiler* c, Lexer* l, int gv, int off, int esz, int slot);
static void dc_gi_struct(Compiler* c, Lexer* l, int gv, int off, int slot);
static int comp_known_off(char* name, int* pis_ptr, int* pis_scalar);
static int comp_var_struct_slot(Compiler* c, char* vname);
static int comp_var_scale(Compiler* c, char* vname);
static void comp_chain_addr(Compiler* c, Lexer* l, int x0_is_obj, int slot, int w0, int elem0, int lval_base_off,
                            int* pw, int* pelem, int* pslot, int* puns, int* pflt);
/* x0_is_obj: 0 = x0 holds a plain value that is not yet the chain base;
 * 1 = x0 is the address of the slot holding the base; 2 = x0 already holds
 * the base address itself (the `((T*)p)->m` / `((T*)p)[i]` form). */
static void comp_expr(Compiler* c, Lexer* l);
/* Constant-expression evaluator used for every array bound in the language
 * (struct member bounds, `sizeof(T[n])`, local/parameter dimensions). Defined
 * next to the struct parser below; declared here because the sizeof path
 * appears earlier in the file. */
static long ce_expr(Compiler* c, Lexer* l, int* ok);
static int ce_dims(Compiler* c, Lexer* l, int* dims, int max);
static void comp_call(Compiler* c, Lexer* l, char* fname);
static void comp_unary(Compiler* c, Lexer* l);
static void comp_assign(Compiler* c, Lexer* l, char* name);
static void comp_assign_typed(Compiler* c, Lexer* l, char* name, int is_float, int ssz_hint, int is_decl);
static void comp_skip_group(Lexer* l);
/* `static <scalar|pointer> name [= const];` at statement scope: registers the
 * object as a global with an internal label and aliases the source name to it.
 * Returns 1 when it consumed the declaration (leaving the lexer on the `;`),
 * 0 when the shape is not supported and the caller must fall back to the old
 * `drop the storage class and declare a local` behaviour. */
static int lstat_decl(Compiler* c, Lexer* l);

/* ------ Function-like macro expansion -------------------------------------
 * `#define SQ(x) ((x)*(x))` is recorded in the fm_* tables by the top-level
 * `#define` handler.  A use site is expanded textually: the arguments are
 * captured as source text, the body has each parameter name replaced, and the
 * substituted text is lexed by a private sub-lexer and compiled in place.
 *
 * All scratch lives in file-scope buffers on purpose: drygon's own backend
 * mis-compiles a function whose local frame exceeds ~1KB (found by bisect:
 * 1KB of locals is fine, 1.2KB corrupts the emitted binary), so nothing large
 * may sit on the stack here.
 *
 * Each nesting level is handled by expanding nested calls inside fm_build,
 * which works on text (like a real preprocessor) instead of keeping several
 * lexers live: this backend mis-compiles indirection through a global pointer,
 * so every buffer here is a plain named array and nothing large sits on the
 * stack. */
static char fm_args_buf[8 * 512];
static int fm_alens[8];
static char fm_expbuf[2048];
static char fm_outbuf[2048];
static char fm_nestbuf[2048];
/* `#param` and `a##b` rewrite the body before/after substitution, so each pass
 * needs scratch of its own: fm_outbuf is live inside the substitution loop and
 * fm_nestbuf holds the caller's inner expansion while fm_subst runs. */
static char fm_strz_buf[4096];
static char fm_paste_buf[2048];
static Lexer fm_slx;
#define FM_NEST_MAX 8
/* One text plane per fm_nest level, holding a bare object-like macro's body
 * while it is rescanned: that rescan recurses into fm_nest, which needs a
 * plane of its own for whatever it finds there (`#define A B` + `#define B 1`). */
static char fm_obuf[(FM_NEST_MAX + 2) * 2112];
/* Nesting level of the macro sub-lexer currently in use: 0 while the parser is
 * reading the real source, N while it is reading level N-1's expansion copy.
 * A nested call expands out of fm_expbuf -- the very text the enclosing level
 * is still reading -- and re-seeds fm_slx underneath it, so every level keeps
 * its own copy of its text plus a slot for the sub-lexer position it has to
 * come back to.  Without this `SQ(SQ(2))` lost the tail of the outer body. */
#define FM_LVL_MAX 10
static char fm_lvl_buf[11 * 2112];
static int fm_sv_pos[11];
static int fm_sv_line[11];
static int fm_sv_bd[11];
static int fm_nsub;
/* Arguments rewritten by argument pre-expansion.  fm_nest() -- and the
 * expansion it drives -- splits the *nested* call's arguments into
 * fm_args_buf/fm_alens, so pre-expanding in place there would destroy the
 * outer call's arguments underneath it.  Each pre-expansion level therefore
 * gets its own argument plane; beyond the last one the rewrite is skipped
 * (leaving the argument unexpanded is harmless, corrupting it is not). */
#define FM_PRE_MAX 4
static char fm_parg_buf[FM_PRE_MAX * 8 * 512];
static int fm_palens[FM_PRE_MAX * 8];
/* Per-level parking space for the body fm_subst is part way through, see
 * fm_subst: the argument pre-expansion runs the nested expander while one of
 * those buffers may be the destination. */
static char fm_svbuf[FM_PRE_MAX * 2112];
static int fm_predepth;
/* 1 when the source had whitespace between the token just consumed and the one
 * about to be captured -- so argument text keeps the author's spacing instead
 * of gaining a space per token, which `#s` used to reveal. */
static int fm_gap;
static int fm_find(char* name);
static int fm_argtoken(Lexer* l, int ai);
static void fm_argint(int ai, long v);
static int fm_int_text(long v, char* out);
static int fm_splice_name(char* dst, int dlen, int q, int e, char* txt, int tl);
static int fm_param_pasted(int fmi, int pi);
static void fm_pre_args(int fmi, int nparams, int nargs, int* plens, char* pargs);
static int fm_capture(Lexer* l, int fmi);
static int fm_subst(int fmi, int nparams, int* plens, char* pargs, char* dst, int dcap);
static int fm_stringize(int fmi, int nparams, int* plens, char* pargs, int en, char* dst);
static int fm_paste(int en, char* dst);
static int fm_nest(char* dst, int dlen, int depth);
static int comp_def_macro_val(char* name);
static int comp_def_is_int_macro(char* name);
static void fm_sublex(Lexer* l);
static int fm_stmt_try(Compiler* c, Lexer* l);
static void fm_expand_expr(Compiler* c, Lexer* l, int fmi, int na);

/* index of the function-like macro called `name`, or -1 */
static int fm_find(char* name) {
    int q = 0;
    while (q < fm_n) {
        if (d_strcmp(fm_names_buf + q * 64, name) == 0) return q;
        q = q + 1;
    }
    return -1;
}

/* True when `name` is an object-like macro with an empty body, i.e. a name the
 * preprocessor deletes wherever it appears. */
static int fm_empty_macro(char* name) {
    int fmi = fm_find(name);
    if (fmi < 0) return 0;
    if (fm_nparams[fmi] != 0) return 0;
    if (fm_body_len[fmi] != 0) return 0;
    return 1;
}

/* Decimal spelling of `v` into `out` (NUL-terminated); returns its length. */
static int fm_int_text(long v, char* out) {
    char tmp[24];
    int n = 0;
    long av = v;
    if (av < 0) av = 0 - av;
    if (av == 0) { tmp[n] = 48; n = n + 1; }
    while (av > 0) { tmp[n] = 48 + (int)(av % 10); n = n + 1; av = av / 10; }
    if (v < 0) { tmp[n] = 45; n = n + 1; }
    int z = 0;
    while (n > 0) { n = n - 1; out[z] = tmp[n]; z = z + 1; }
    out[z] = 0;
    return z;
}

/* Append the decimal spelling of `v` to argument `ai`.  Used for the literals
 * whose source spelling the lexer does not preserve (a character literal keeps
 * its value in the token's 8-byte slot and leaves "0" in the text). */
static void fm_argint(int ai, long v) {
    int ao = ai * 512;
    char nb[24];
    int nl = fm_int_text(v, nb);
    int z = 0;
    while (z < nl && fm_alens[ai] < 508) {
        fm_args_buf[ao + fm_alens[ai]] = nb[z];
        fm_alens[ai] = fm_alens[ai] + 1;
        z = z + 1;
    }
}

/* Append the current token's source spelling(s) to arg `ai`.  Operator tokens
 * carry no text, so their spelling is written explicitly; identifiers come from
 * the token text, while string and character/number literals have to be
 * re-spelled because the lexer hands them over decoded.  Returns 1 when the
 * token was consumed, 0 when the caller must handle it (comma / paren). */
static int fm_argtoken(Lexer* l, int ai) {
    int ao = ai * 512;
    int tk = lex_kind(l);
    if (tk == T_IDENT) {
        char* tt = lex_text(l);
        int z = 0;
        while (tt[z] && fm_alens[ai] < 508) {
            fm_args_buf[ao + fm_alens[ai]] = tt[z];
            fm_alens[ai] = fm_alens[ai] + 1;
            z = z + 1;
        }
    } else if (tk == T_STR) {
        /* The lexer decodes `"a\nb"` and drops the quotes, so re-quote and
         * re-escape: `#define P(s) puts(s)` + `P("hi")` used to substitute the
         * bare word `hi` and only fail at run time. */
        char* st = lex_text(l);
        int z = 0;
        if (fm_alens[ai] < 508) { fm_args_buf[ao + fm_alens[ai]] = 34; fm_alens[ai] = fm_alens[ai] + 1; }
        while (st[z] && fm_alens[ai] < 506) {
            int ch = st[z];
            if (ch == 92 || ch == 34) {
                fm_args_buf[ao + fm_alens[ai]] = 92; fm_alens[ai] = fm_alens[ai] + 1;
                fm_args_buf[ao + fm_alens[ai]] = ch; fm_alens[ai] = fm_alens[ai] + 1;
            } else if (ch == 10) {
                fm_args_buf[ao + fm_alens[ai]] = 92; fm_alens[ai] = fm_alens[ai] + 1;
                fm_args_buf[ao + fm_alens[ai]] = 110; fm_alens[ai] = fm_alens[ai] + 1;
            } else if (ch == 9) {
                fm_args_buf[ao + fm_alens[ai]] = 92; fm_alens[ai] = fm_alens[ai] + 1;
                fm_args_buf[ao + fm_alens[ai]] = 116; fm_alens[ai] = fm_alens[ai] + 1;
            } else if (ch == 13) {
                fm_args_buf[ao + fm_alens[ai]] = 92; fm_alens[ai] = fm_alens[ai] + 1;
                fm_args_buf[ao + fm_alens[ai]] = 114; fm_alens[ai] = fm_alens[ai] + 1;
            } else {
                fm_args_buf[ao + fm_alens[ai]] = ch; fm_alens[ai] = fm_alens[ai] + 1;
            }
            z = z + 1;
        }
        if (fm_alens[ai] < 508) { fm_args_buf[ao + fm_alens[ai]] = 34; fm_alens[ai] = fm_alens[ai] + 1; }
    } else if (tk == T_NUM) {
        char* tt = lex_text(l);
        int z = 0;
        if (tt[0] == 70) z = 1;            /* float literal: skip the 'F' marker */
        if (tt[0] == 48 && tt[1] == 0) {
            /* A character literal has no spelling in its token text (it is
             * just "0", with the value in the 8-byte slot): copy the source
             * form instead, so `#s` yields `'a'` as gcc does while a value
             * context still evaluates to 97 once the body is re-lexed.  A
             * plain `0` has no quote before `pos` and takes the old path. */
            if (l->pos > 0 && l->src[l->pos - 1] == 39) {
                int e2 = l->pos;
                int s2 = e2 - 1;
                while (s2 > 0) {
                    s2 = s2 - 1;
                    if (l->src[s2] == 39) {
                        /* an escaped quote (`'\''`) belongs to the literal */
                        int nb = 0;
                        int kb = s2 - 1;
                        while (kb >= 0 && l->src[kb] == 92) { nb = nb + 1; kb = kb - 1; }
                        if (nb % 2 == 0) break;
                    }
                }
                while (s2 < e2 && fm_alens[ai] < 508) {
                    fm_args_buf[ao + fm_alens[ai]] = l->src[s2];
                    fm_alens[ai] = fm_alens[ai] + 1;
                    s2 = s2 + 1;
                }
            } else {
                /* value lives in the token's 8-byte slot; the text just says
                 * "0" -- `'a'` must reach the body as 97. */
                void* vp = (char*)lex_cur(l) + 2056;
                long* lp = vp;
                long lv = *lp;
                if (lv != 0) fm_argint(ai, lv);
                else { fm_args_buf[ao + fm_alens[ai]] = 48; fm_alens[ai] = fm_alens[ai] + 1; }
            }
        } else {
            while (tt[z] && fm_alens[ai] < 508) {
                fm_args_buf[ao + fm_alens[ai]] = tt[z];
                fm_alens[ai] = fm_alens[ai] + 1;
                z = z + 1;
            }
        }
    } else if (tk == T_PLUS) { fm_args_buf[ao + fm_alens[ai]] = 43; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_MINUS) { fm_args_buf[ao + fm_alens[ai]] = 45; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_STAR) { fm_args_buf[ao + fm_alens[ai]] = 42; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_SLASH) { fm_args_buf[ao + fm_alens[ai]] = 47; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_PERCENT) { fm_args_buf[ao + fm_alens[ai]] = 37; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_LPAREN) { fm_args_buf[ao + fm_alens[ai]] = 40; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_RPAREN) { fm_args_buf[ao + fm_alens[ai]] = 41; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_COMMA) { fm_args_buf[ao + fm_alens[ai]] = 44; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_LBRACKET) { fm_args_buf[ao + fm_alens[ai]] = 91; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_RBRACKET) { fm_args_buf[ao + fm_alens[ai]] = 93; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_LBRACE) { fm_args_buf[ao + fm_alens[ai]] = 123; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_RBRACE) { fm_args_buf[ao + fm_alens[ai]] = 125; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_AMP) { fm_args_buf[ao + fm_alens[ai]] = 38; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_PIPE) { fm_args_buf[ao + fm_alens[ai]] = 124; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_CARET) { fm_args_buf[ao + fm_alens[ai]] = 94; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_TILDE) { fm_args_buf[ao + fm_alens[ai]] = 126; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_NOT) { fm_args_buf[ao + fm_alens[ai]] = 33; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_QUESTION) { fm_args_buf[ao + fm_alens[ai]] = 63; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_COLON) { fm_args_buf[ao + fm_alens[ai]] = 58; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_SEMI) { fm_args_buf[ao + fm_alens[ai]] = 59; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_DOT) { fm_args_buf[ao + fm_alens[ai]] = 46; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_ASSIGN) { fm_args_buf[ao + fm_alens[ai]] = 61; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_EQ) { fm_args_buf[ao + fm_alens[ai]] = 61; fm_args_buf[ao + fm_alens[ai] + 1] = 61; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_NE) { fm_args_buf[ao + fm_alens[ai]] = 33; fm_args_buf[ao + fm_alens[ai] + 1] = 61; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_LE) { fm_args_buf[ao + fm_alens[ai]] = 60; fm_args_buf[ao + fm_alens[ai] + 1] = 61; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_GE) { fm_args_buf[ao + fm_alens[ai]] = 62; fm_args_buf[ao + fm_alens[ai] + 1] = 61; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_LT) { fm_args_buf[ao + fm_alens[ai]] = 60; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_GT) { fm_args_buf[ao + fm_alens[ai]] = 62; fm_alens[ai] = fm_alens[ai] + 1; }
    else if (tk == T_ANDAND) { fm_args_buf[ao + fm_alens[ai]] = 38; fm_args_buf[ao + fm_alens[ai] + 1] = 38; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_OROR) { fm_args_buf[ao + fm_alens[ai]] = 124; fm_args_buf[ao + fm_alens[ai] + 1] = 124; fm_alens[ai] = fm_alens[ai] + 2; }
    /* The lexer spells `&&` T_AND and `||` T_OR (lex_next 38/124 dispatch),
     * NOT T_ANDAND/T_OROR; those kinds hit the catch-all below, whose
     * lex_text() is empty for punctuation, so the token vanished from the
     * captured argument and `#define m(e) ((e)?0:1)` + `m(1 && 1)` collapsed
     * to `((1 1)`.  Capture both spellings explicitly. */
    else if (tk == T_AND) { fm_args_buf[ao + fm_alens[ai]] = 38; fm_args_buf[ao + fm_alens[ai] + 1] = 38; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_OR) { fm_args_buf[ao + fm_alens[ai]] = 124; fm_args_buf[ao + fm_alens[ai] + 1] = 124; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_INC) { fm_args_buf[ao + fm_alens[ai]] = 43; fm_args_buf[ao + fm_alens[ai] + 1] = 43; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_DEC) { fm_args_buf[ao + fm_alens[ai]] = 45; fm_args_buf[ao + fm_alens[ai] + 1] = 45; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_ARROW) { fm_args_buf[ao + fm_alens[ai]] = 45; fm_args_buf[ao + fm_alens[ai] + 1] = 62; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_PLUSEQ) { fm_args_buf[ao + fm_alens[ai]] = 43; fm_args_buf[ao + fm_alens[ai] + 1] = 61; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_MINUSEQ) { fm_args_buf[ao + fm_alens[ai]] = 45; fm_args_buf[ao + fm_alens[ai] + 1] = 61; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_LSHIFT) { fm_args_buf[ao + fm_alens[ai]] = 60; fm_args_buf[ao + fm_alens[ai] + 1] = 60; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_RSHIFT) { fm_args_buf[ao + fm_alens[ai]] = 62; fm_args_buf[ao + fm_alens[ai] + 1] = 62; fm_alens[ai] = fm_alens[ai] + 2; }
    else if (tk == T_ARROW) { fm_args_buf[ao + fm_alens[ai]] = 45; fm_args_buf[ao + fm_alens[ai] + 1] = 62; fm_alens[ai] = fm_alens[ai] + 2; }
    /* Keywords are perfectly ordinary macro arguments -- `va_arg(ap, int)`,
     * `sizeof(long)`, `(char)`, ... -- but the table above only covers
     * punctuation, so a keyword used as an argument fell into the `else return
     * 0` branch and its text was never captured: the substitution then dropped
     * the argument entirely and the body collapsed to `(*(*)(ap))`.  Copy the
     * token's own spelling for every keyword rather than enumerating types. */
    else if (tk > T_EOF && tk < T_UNKNOWN) {
        char* kt = lex_text(l);
        int z2 = 0;
        while (kt[z2] && fm_alens[ai] < 508) {
            fm_args_buf[ao + fm_alens[ai]] = kt[z2];
            fm_alens[ai] = fm_alens[ai] + 1;
            z2 = z2 + 1;
        }
    }
    else return 0;
    return 1;
}

/* Capture the `( a, b, ... )` argument list.  The caller must already have
 * consumed the macro name and sit on the '('.  Returns the argument count and
 * fills fm_alens. */
/* 1 when the next source character after the token just consumed is a blank.
 * `lex_next` leaves `pos` pointing right behind the token, whitespace is
 * skipped when the following token is materialised, so sampling here sees the
 * gap the author wrote.  A generated buffer has no author: the spaces around a
 * token are the ones the expander emitted, which is what we want too. */
static int fm_src_ws(Lexer* l) {
    char* s = l->src;
    if (s == 0) return 1;
    int c = s[l->pos];
    if (c == 32 || c == 9 || c == 10 || c == 13) return 1;
    return 0;
}
static int fm_capture(Lexer* l, int fmi) {
    int z = 0;
    while (z < 8) { fm_alens[z] = 0; z = z + 1; }
    /* Argument tokens are captured as written: `#s` must show the spelling of
     * `STR(UNUSED)`, and an empty object-like macro is deleted only where the
     * substituted body is re-lexed, not out of the raw argument. */
    int sv_noskip = pp_no_skip;
    pp_no_skip = 1;
    if (!lex_is(l, T_LPAREN)) { pp_no_skip = sv_noskip; return -1; }
    lex_advance(l);            /* '(' */
    int nargs = 0;
    int depth = 1;
    int gap = 0;
    while (!lex_is(l, T_EOF) && depth > 0) {
        if (lex_is(l, T_LPAREN)) depth = depth + 1;
        else if (lex_is(l, T_RPAREN)) {
            depth = depth - 1;
            if (depth == 0) { lex_advance(l); break; }
        }
        if (depth == 1 && lex_is(l, T_COMMA) && nargs < fm_nparams[fmi]) {
            lex_advance(l);
            nargs = nargs + 1;
            gap = 0;
            continue;
        }
        /* A blank is emitted only where the source had one: `a+b` must
         * stringize as "a+b", `a b` as "a b". */
        int pre = fm_alens[nargs];
        if (fm_argtoken(l, nargs) && gap && pre > 0) {
            int ao = nargs * 512;
            int z = fm_alens[nargs];
            if (z < 508) {
                while (z > pre) { fm_args_buf[ao + z] = fm_args_buf[ao + z - 1]; z = z - 1; }
                fm_args_buf[ao + pre] = 32;
                fm_alens[nargs] = fm_alens[nargs] + 1;
            }
        }
        lex_advance(l);
        gap = fm_src_ws(l);
    }
    if (nargs < 8) nargs = nargs + 1;
    pp_no_skip = sv_noskip;
    return nargs;
}

/* Substitute parameters into a body text, writing the result to `dst`.
 * `plens[i]`/`pargs` describe each parameter's replacement text.  Returns the
 * length written (excluding the NUL). */
/* `#param` -> the parameter's argument text as a string literal.  The argument
 * is *not* macro-expanded, so this runs on the raw body before substitution.
 * Anything that is not `#` + a parameter name (a `##` paste operator, a lone
 * `#`, a body string literal) is copied through untouched. */
static int fm_stringize(int fmi, int nparams, int* plens, char* pargs, int en, char* dst) {
    if (en > 2000) en = 2000;
    int q = 0;
    int on = 0;
    while (q < en) {
        if (dst[q] == 34) {
            /* a string literal in the body: copy it verbatim */
            fm_strz_buf[on] = dst[q]; on = on + 1; q = q + 1;
            while (q < en && dst[q] != 34) { fm_strz_buf[on] = dst[q]; on = on + 1; q = q + 1; }
            if (q < en) { fm_strz_buf[on] = dst[q]; on = on + 1; q = q + 1; }
            continue;
        }
        if (dst[q] != 35) { fm_strz_buf[on] = dst[q]; on = on + 1; q = q + 1; continue; }
        if (q + 1 < en && dst[q + 1] == 35) {
            /* `##`: leave it for fm_paste, which runs after substitution */
            fm_strz_buf[on] = 35; on = on + 1;
            fm_strz_buf[on] = 35; on = on + 1;
            q = q + 2;
            continue;
        }
        int s = q + 1;
        while (s < en && (dst[s] == 32 || dst[s] == 9)) s = s + 1;
        int e = s;
        while (e < en && ((dst[e] >= 48 && dst[e] <= 57) || (dst[e] >= 65 && dst[e] <= 90) ||
                          (dst[e] >= 97 && dst[e] <= 122) || dst[e] == 95)) e = e + 1;
        int pi = -1;
        { int z = 0;
          while (z < nparams) {
              char* nm = fm_params_buf + (fmi * 8 + z) * 64;
              int nl = d_strlen(nm);
              if (nl > 0 && nl == (e - s)) {
                  int k = 0;
                  while (k < nl && dst[s + k] == nm[k]) k = k + 1;
                  if (k == nl) { pi = z; break; }
              }
              z = z + 1;
          } }
        if (pi < 0) { fm_strz_buf[on] = dst[q]; on = on + 1; q = q + 1; continue; }
        { int alen = plens[pi];
          char* ap = pargs + pi * 512;
          int aq = 0;
          /* the capture puts a space in front of every argument token; a
           * stringized argument must not carry it */
          while (aq < alen && (ap[aq] == 32 || ap[aq] == 9)) aq = aq + 1;
          fm_strz_buf[on] = 34; on = on + 1;
          while (aq < alen) {
              if (ap[aq] == 92 || ap[aq] == 34) { fm_strz_buf[on] = 92; on = on + 1; }
              fm_strz_buf[on] = ap[aq]; on = on + 1;
              aq = aq + 1;
          }
          fm_strz_buf[on] = 34; on = on + 1; }
        q = e;
    }
    { int z = 0; while (z < on) { dst[z] = fm_strz_buf[z]; z = z + 1; } }
    dst[on] = 0;
    return on;
}

/* `tok ## tok` -> `tokTOK`: drop the operator together with the whitespace on
 * both sides so the two tokens become one.  Runs on the substituted body, so
 * the operands are the argument texts.  A paste that produces an identifier now
 * used as a parameter can still be rescanned by fm_nest. */
static int fm_paste(int en, char* dst) {
    if (en > 2000) en = 2000;
    int q = 0;
    int on = 0;
    while (q < en) {
        if (dst[q] == 35 && (q + 1) < en && dst[q + 1] == 35) {
            while (on > 0 && (fm_paste_buf[on - 1] == 32 || fm_paste_buf[on - 1] == 9)) on = on - 1;
            q = q + 2;
            while (q < en && (dst[q] == 32 || dst[q] == 9)) q = q + 1;
            continue;
        }
        fm_paste_buf[on] = dst[q]; on = on + 1; q = q + 1;
    }
    { int z = 0; while (z < on) { dst[z] = fm_paste_buf[z]; z = z + 1; } }
    dst[on] = 0;
    return on;
}

static int fm_subst(int fmi, int nparams, int* plens, char* pargs, char* dst, int dcap) {
    char* body = fm_body_buf + fmi * 512;
    int en = 0;
    while (en < fm_body_len[fmi] && en < dcap - 1) { dst[en] = body[en]; en = en + 1; }
    dst[en] = 0;
    en = fm_stringize(fmi, nparams, plens, pargs, en, dst);
    /* Pre-expanding an argument runs the nested expander, which works in
     * fm_nestbuf/fm_outbuf -- and `dst` *is* fm_nestbuf when fm_nest calls
     * this for a nested call.  Park the stringized body (per nesting level,
     * so a deeper call cannot overwrite this level's copy) while that runs. */
    { char* sv = fm_svbuf + fm_predepth * 2112;
      int z = 0;
      while (z <= en && z < 2100) { sv[z] = dst[z]; z = z + 1; }
      fm_pre_args(fmi, nparams, nparams, plens, pargs);
      z = 0;
      while (z <= en && z < 2100) { dst[z] = sv[z]; z = z + 1; }
    }
    int pi = 0;
    while (pi < nparams) {
        char* pname = fm_params_buf + (fmi * 8 + pi) * 64;
        int plen = d_strlen(pname);
        if (plen > 0) {
            int on = 0;
            int q = 0;
            char* argp = pargs + pi * 512;
            int alen = plens[pi];
            while (q < en && on < dcap - 1) {
                /* identifier-boundary match: the parameter name must not be
                 * part of a longer identifier */
                int k = 0;
                if (dst[q] == pname[0]) {
                    k = 1;
                    while (k < plen && (q + k) < en && dst[q + k] == pname[k]) k = k + 1;
                }
                int before = (q == 0) || !((dst[q - 1] >= 48 && dst[q - 1] <= 57) ||
                                           (dst[q - 1] >= 65 && dst[q - 1] <= 90) ||
                                           (dst[q - 1] >= 97 && dst[q - 1] <= 122) ||
                                           dst[q - 1] == 95);
                int after = (q + plen) >= en || !((dst[q + plen] >= 48 && dst[q + plen] <= 57) ||
                                                  (dst[q + plen] >= 65 && dst[q + plen] <= 90) ||
                                                  (dst[q + plen] >= 97 && dst[q + plen] <= 122) ||
                                                  dst[q + plen] == 95);
                if (k == plen && before && after) {
                    int z = 0;
                    while (z < alen && on < dcap - 1) {
                        fm_outbuf[on] = argp[z];
                        on = on + 1;
                        z = z + 1;
                    }
                    q = q + plen;
                    continue;
                }
                fm_outbuf[on] = dst[q];
                on = on + 1;
                q = q + 1;
            }
            fm_outbuf[on] = 0;
            { int z = 0; while (z <= on && z < 2048) { dst[z] = fm_outbuf[z]; z = z + 1; } }
            en = on;
        }
        pi = pi + 1;
    }
    en = fm_paste(en, dst);
    return en;
}

/* Replace the identifier spanning dst[q,e) with `tl` bytes of `txt`; returns
 * the new length of `dst`.  Used when a bare object-like macro name has to be
 * substituted by its body (or by its recorded integer value). */
static int fm_splice_name(char* dst, int dlen, int q, int e, char* txt, int tl) {
    int on = 0;
    int z = 0;
    while (z < q && on < 2000) { fm_outbuf[on] = dst[z]; on = on + 1; z = z + 1; }
    z = 0;
    while (z < tl && on < 2000) { fm_outbuf[on] = txt[z]; on = on + 1; z = z + 1; }
    z = e;
    while (z < dlen && on < 2000) { fm_outbuf[on] = dst[z]; on = on + 1; z = z + 1; }
    fm_outbuf[on] = 0;
    { int zz = 0; while (zz <= on && zz < 2048) { dst[zz] = fm_outbuf[zz]; zz = zz + 1; } }
    return on;
}

/* True when parameter `pi` of macro `fmi` is an operand of `#` or `##` in the
 * body, in which case its argument must NOT be macro-expanded first (C99
 * 6.10.3.1).  Whitespace around the operator is skipped. */
static int fm_param_pasted(int fmi, int pi) {
    char* pname = fm_params_buf + (fmi * 8 + pi) * 64;
    int plen = d_strlen(pname);
    char* body = fm_body_buf + fmi * 512;
    int bl = fm_body_len[fmi];
    if (plen == 0) return 1;
    int q = 0;
    while (q + plen <= bl) {
        int k = 0;
        if (body[q] == pname[0]) {
            k = 1;
            while (k < plen && body[q + k] == pname[k]) k = k + 1;
        }
        int before = (q == 0) || !((body[q - 1] >= 48 && body[q - 1] <= 57) ||
                                   (body[q - 1] >= 65 && body[q - 1] <= 90) ||
                                   (body[q - 1] >= 97 && body[q - 1] <= 122) ||
                                   body[q - 1] == 95);
        int after = (q + plen) >= bl || !((body[q + plen] >= 48 && body[q + plen] <= 57) ||
                                          (body[q + plen] >= 65 && body[q + plen] <= 90) ||
                                          (body[q + plen] >= 97 && body[q + plen] <= 122) ||
                                          body[q + plen] == 95);
        if (k == plen && before && after) {
            int b2 = q - 1;
            while (b2 >= 0 && (body[b2] == 32 || body[b2] == 9)) b2 = b2 - 1;
            if (b2 >= 0 && body[b2] == 35) return 1;      /* `#x` or `x##` */
            int f2 = q + plen;
            while (f2 < bl && (body[f2] == 32 || body[f2] == 9)) f2 = f2 + 1;
            if (f2 < bl && body[f2] == 35) return 1;      /* `##x` */
        }
        q = q + 1;
    }
    return 0;
}

/* Macro-expand every argument that is not an operand of `#`/`##`, in place.
 * `plens`/`pargs` are the caller's argument arrays; the work happens in a
 * private plane so the nested expansion cannot clobber them. */
static void fm_pre_args(int fmi, int nparams, int nargs, int* plens, char* pargs) {
    int d = fm_predepth;
    if (d >= FM_PRE_MAX) return;
    fm_predepth = d + 1;
    char* ab = fm_parg_buf + d * (8 * 512);
    int* al = fm_palens + d * 8;
    int i = 0;
    while (i < nparams && i < nargs) {
        int z = 0;
        int alen = plens[i];
        if (alen > 508) alen = 508;
        while (z < alen) { ab[i * 512 + z] = pargs[i * 512 + z]; z = z + 1; }
        ab[i * 512 + z] = 0;
        al[i] = z;
        i = i + 1;
    }
    i = 0;
    while (i < nparams && i < nargs) {
        if (al[i] > 0 && al[i] < 508 && !fm_param_pasted(fmi, i)) {
            int nl = fm_nest(ab + i * 512, al[i], FM_NEST_MAX);
            if (nl > 507) nl = 507;
            ab[i * 512 + nl] = 0;
            al[i] = nl;
        }
        i = i + 1;
    }
    i = 0;
    while (i < nparams && i < nargs) {
        int z = 0;
        while (z < al[i]) { pargs[i * 512 + z] = ab[i * 512 + z]; z = z + 1; }
        pargs[i * 512 + z] = 0;
        plens[i] = z;
        i = i + 1;
    }
    fm_predepth = d;
}

/* Expand any nested macro calls in `dst` (a freshly substituted body) in
 * place.  A body that names another macro (`#define CUBE(y) SQ(y)*y`) has to
 * expand recursively, exactly like the preprocessor; doing it on the text
 * keeps every buffer a plain named array and the frames small.  Bounded by
 * `depth` so a self-referential macro terminates. */
static int fm_nest(char* dst, int dlen, int depth) {
    if (depth <= 0) return dlen;
    int q = 0;
    while (q < dlen) {
        if (dst[q] == 34 || dst[q] == 39) {
            /* A string or character literal: its contents are never expanded,
             * so `#define STR(s) #s` + `STR(N)` stays the two characters "N". */
            char quot = dst[q];
            q = q + 1;
            while (q < dlen && dst[q] != quot) {
                if (dst[q] == 92 && (q + 1) < dlen) q = q + 1;
                q = q + 1;
            }
            if (q < dlen) q = q + 1;
            continue;
        }
        if ((dst[q] >= 97 && dst[q] <= 122) || (dst[q] >= 65 && dst[q] <= 90) || dst[q] == 95) {
            int e = q;
            while (e < dlen && ((dst[e] >= 97 && dst[e] <= 122) || (dst[e] >= 65 && dst[e] <= 90) ||
                                (dst[e] >= 48 && dst[e] <= 57) || dst[e] == 95)) e = e + 1;
            char nm[64];
            int nl = e - q;
            if (nl > 63) nl = 63;
            { int z = 0; while (z < nl) { nm[z] = dst[q + z]; z = z + 1; } }
            nm[nl] = 0;
            int fmi2 = fm_find(nm);
            /* A bare object-like macro (`#define B A`, `#define PT ((T*)0)`)
             * inside a body or an argument expands to its own text, which is
             * then rescanned.  A function-like name used without its `(` is
             * left alone, exactly as the preprocessor leaves it. */
            if (fmi2 >= 0 && fm_nparams[fmi2] == 0) {
                char* ob = fm_obuf + (FM_NEST_MAX + 1 - depth) * 2112;
                int bl2 = fm_body_len[fmi2];
                if (bl2 > 2020) bl2 = 2020;
                { int z = 0; while (z < bl2) { ob[z] = (fm_body_buf + fmi2 * 512)[z]; z = z + 1; } }
                ob[bl2] = 0;
                int il2 = fm_nest(ob, bl2, depth - 1);
                dlen = fm_splice_name(dst, dlen, q, e, ob, il2);
                q = q + il2;
                continue;
            }
            /* Object-like macro the recorder kept only in the integer table
             * (`#define N 5` whose body did not fit in the fm_* tables): a
             * body that pastes or stringizes it still has to see the number. */
            if (fmi2 < 0 && comp_def_is_int_macro(nm)) {
                char nb[24];
                int nl2 = fm_int_text(comp_def_macro_val(nm), nb);
                dlen = fm_splice_name(dst, dlen, q, e, nb, nl2);
                q = q + nl2;
                continue;
            }
            if (fmi2 < 0 || e >= dlen || dst[e] != 40) { q = e; continue; }
            /* NAME( ... ): find the matching ')' and split the arguments on
             * top-level commas, textually */
            int aclose = e + 1;
            int dep2 = 1;
            while (aclose < dlen && dep2 > 0) {
                if (dst[aclose] == 40) dep2 = dep2 + 1;
                else if (dst[aclose] == 41) dep2 = dep2 - 1;
                if (dep2 == 0) break;
                aclose = aclose + 1;
            }
            if (dep2 != 0) { q = e; continue; }
            /* split [e+1, aclose) into at most 8 argument texts */
            int nsub = 0;
            { int z = 0; while (z < 8) { fm_alens[z] = 0; z = z + 1; } }
            { int p2 = e + 1;
              int d3 = 0;
              while (p2 < aclose) {
                  if (dst[p2] == 40 || dst[p2] == 91 || dst[p2] == 123) d3 = d3 + 1;
                  else if (dst[p2] == 41 || dst[p2] == 93 || dst[p2] == 125) d3 = d3 - 1;
                  if (dst[p2] == 44 && d3 == 0 && nsub < fm_nparams[fmi2]) {
                      nsub = nsub + 1;
                  } else if (fm_alens[nsub] < 508) {
                      fm_args_buf[nsub * 512 + fm_alens[nsub]] = dst[p2];
                      fm_alens[nsub] = fm_alens[nsub] + 1;
                  }
                  p2 = p2 + 1;
              } }
            if (nsub < 8) nsub = nsub + 1;
            /* expand the inner call into fm_nestbuf */
            int ilen = fm_subst(fmi2, fm_nparams[fmi2], fm_alens, fm_args_buf, fm_nestbuf, 2048);
            ilen = fm_nest(fm_nestbuf, ilen, depth - 1);
            /* splice: text before the name + expansion + text after ')'.
             * `q` advances past the whole call so the tail is not rescanned
             * (rescanning it would re-expand the same nested call forever).
             * The tail is re-scanned by an inner recursion limited in depth. */
            { int on = 0;
              int z = 0;
              while (z < q && on < 2000) { fm_outbuf[on] = dst[z]; on = on + 1; z = z + 1; }
              z = 0;
              while (z < ilen && on < 2000) { fm_outbuf[on] = fm_nestbuf[z]; on = on + 1; z = z + 1; }
              z = aclose + 1;
              while (z < dlen && on < 2000) { fm_outbuf[on] = dst[z]; on = on + 1; z = z + 1; }
              fm_outbuf[on] = 0;
              { int zz = 0; while (zz <= on && zz < 2048) { dst[zz] = fm_outbuf[zz]; zz = zz + 1; } }
              dlen = on;
            }
            /* continue after the expansion (the tail is already copied) */
            q = q + ilen;
            continue;
        }
        q = q + 1;
    }
    return dlen;
}

/* Substitute the captured arguments into the macro body, leaving the expanded
 * text (NUL-terminated) in fm_expbuf.  Returns its length. */
static int fm_build(int fmi, int nargs) {
    char* body = fm_body_buf + fmi * 512;
    int en = 0;
    while (en < fm_body_len[fmi] && en < 2000) { fm_expbuf[en] = body[en]; en = en + 1; }
    fm_expbuf[en] = 0;
    en = fm_stringize(fmi, fm_nparams[fmi], fm_alens, fm_args_buf, en, fm_expbuf);
    /* arguments that are not operands of `#`/`##` are expanded before they are
     * substituted, so `XCAT(PFX,7)` with `#define XCAT(a,b) CAT(a,b)` pastes
     * the *expanded* `PFX` while a direct `CAT(PFX,7)` keeps its spelling */
    fm_pre_args(fmi, fm_nparams[fmi], nargs, fm_alens, fm_args_buf);
    int pi = 0;
    while (pi < fm_nparams[fmi]) {
        char* pname = fm_params_buf + (fmi * 8 + pi) * 64;
        int plen = d_strlen(pname);
        if (plen > 0 && pi < nargs) {
            int on = 0;
            int q = 0;
            while (q < en && on < 2000) {
                /* identifier-boundary match: the parameter name must not be
                 * part of a longer identifier */
                int k = 0;
                if (fm_expbuf[q] == pname[0]) {
                    k = 1;
                    while (k < plen && (q + k) < en && fm_expbuf[q + k] == pname[k]) k = k + 1;
                }
                int before = (q == 0) || !((fm_expbuf[q - 1] >= 48 && fm_expbuf[q - 1] <= 57) ||
                                           (fm_expbuf[q - 1] >= 65 && fm_expbuf[q - 1] <= 90) ||
                                           (fm_expbuf[q - 1] >= 97 && fm_expbuf[q - 1] <= 122) ||
                                           fm_expbuf[q - 1] == 95);
                int after = (q + plen) >= en || !((fm_expbuf[q + plen] >= 48 && fm_expbuf[q + plen] <= 57) ||
                                                  (fm_expbuf[q + plen] >= 65 && fm_expbuf[q + plen] <= 90) ||
                                                  (fm_expbuf[q + plen] >= 97 && fm_expbuf[q + plen] <= 122) ||
                                                  fm_expbuf[q + plen] == 95);
                if (k == plen && before && after) {
                    int ao = pi * 512;
                    int z = 0;
                    while (z < fm_alens[pi] && on < 2000) {
                        fm_outbuf[on] = fm_args_buf[ao + z];
                        on = on + 1;
                        z = z + 1;
                    }
                    q = q + plen;
                    continue;
                }
                if (on < 2000) { fm_outbuf[on] = fm_expbuf[q]; on = on + 1; }
                q = q + 1;
            }
            fm_outbuf[on] = 0;
            { int z = 0; while (z <= on && z < 2048) { fm_expbuf[z] = fm_outbuf[z]; z = z + 1; } }
            en = on;
        }
        pi = pi + 1;
    }
    /* nested macro calls in the substituted body (`CUBE(2)` -> `SQ(2)*2`
     * -> `((2)*(2))*2`) expand here, on the text */
    en = fm_paste(en, fm_expbuf);
    en = fm_nest(fm_expbuf, en, FM_NEST_MAX);
    return en;
}
/* Seed the private sub-lexer on the expanded text. */
static void fm_sublex(Lexer* l) {
    /* Take a copy: fm_expbuf is where the *next* nested expansion will be
     * built, and the enclosing level is still reading its own text. */
    int lv = fm_nsub;
    if (lv > FM_LVL_MAX) lv = FM_LVL_MAX;
    { char* b = fm_lvl_buf + lv * 2112;
      int z = 0;
      while (z < 2110 && fm_expbuf[z]) { b[z] = fm_expbuf[z]; z = z + 1; }
      b[z] = 0;
      fm_slx.src = b; }
    fm_slx.pos = 0;
    fm_slx.lex_line = l->lex_line;
    fm_slx.has_tok = 0;
    fm_slx.rec = 0;
    fm_slx.errs = 0;
    fm_slx.brace_depth = 0;
    fm_slx.pp_sp = 0;
    fm_slx.pp_emit = 1;
    { int z = 0; while (z < 16) { fm_slx.pp_taken[z] = 0; z = z + 1; } }
}
static void comp_call_ptr(Compiler* c, Lexer* l);

static void comp_load_imm(Code* code, int rd, int value) {
    /* `int` is a 64-bit quantity in this backend (every arithmetic and
     * comparison opcode is the X form), so the full 64-bit value must be
     * materialised.  Wrapping negatives to 0xFFFFFFFF made a stored -1 read
     * back as +4294967295, which flipped every `x >= 0` sentinel test.
     * emit_mov64 also fixes the float-literal path (see comp_primary). */
    emit_mov64(code, rd, value);
}

/* add <rd>, <rn>, #off for a frame/aggregate offset.  a_addi masks its
 * immediate with %4096, so an offset past the 12-bit range has to be
 * materialised into the scratch register x15 first (x15 is unused by this
 * backend; baccyn's i_add_imm does the same).  Without this the address form
 * of a local (`&x`, `x[i]`, `x->f`) disagreed with the direct slot form
 * (`ldr x0, [x29, #off]`, which is correct up to 32760), so any function with
 * a frame >= 4096 bytes read the wrong slot — the stage-2 self-host crash. */
static void comp_add_off(Compiler* c, int rd, int rn, int off) {
    if (off >= 0 && off <= 4095) {
        code_emit(&c->code, a_addi(rd, rn, off));
        return;
    }
    comp_load_imm(&c->code, 15, off);
    code_emit(&c->code, a_add(rd, rn, 15));
}

/* Direct frame-slot access against x29 for an arbitrary offset.  The
 * single-instruction load/store forms scale their imm12 by the access size,
 * so they only reach 4095 (byte), 8190 (half), 16380 (word) and 32760
 * (dword/double); a larger offset has to be folded into x15 first.  The
 * array-initializer path (`char name[64] = {0};` in a function that already
 * has >= 4096 bytes of locals) otherwise stored into a wrapped slot. */
static void comp_str_slot_w(Compiler* c, int rt, int off, int width) {
    /* A scaled 64/32-bit store can only encode an offset that is a multiple of
     * its own width -- a_str_x divides by 8 and a_str_w by 4, so an unaligned
     * byte offset silently truncates and the store lands on the wrong member.
     * A struct member is only guaranteed to sit at its natural alignment when
     * the aggregate itself is aligned, which a stack slot is not obliged to be,
     * so check the real limit and fall back to an explicit add otherwise. */
    int scal = (width == 8) ? 8 : ((width == 4) ? 4 : ((width == 2) ? 2 : 1));
    if (off >= 0 && off % scal == 0 && off / scal <= 4095) {
        if (width == 1) code_emit(&c->code, a_strb(rt, 29, off));
        else if (width == 2) code_emit(&c->code, a_strh(rt, 29, off));
        else if (width == 4) code_emit(&c->code, a_str_w(rt, 29, off));
        else code_emit(&c->code, a_str_x(rt, 29, off));
        return;
    }
    comp_add_off(c, 15, 29, off);
    if (width == 1) code_emit(&c->code, a_strb(rt, 15, 0));
    else if (width == 2) code_emit(&c->code, a_strh(rt, 15, 0));
    else if (width == 4) code_emit(&c->code, a_str_w(rt, 15, 0));
    else code_emit(&c->code, a_str_x(rt, 15, 0));
}

static void comp_str_slot(Compiler* c, int rt, int off) {
    comp_str_slot_w(c, rt, off, 8);
}

static void comp_str_slot_d(Compiler* c, int rt, int off) {
    if (off >= 0 && off <= 32760) { code_emit(&c->code, a_str_d(rt, 29, off)); return; }
    comp_add_off(c, 15, 29, off);
    code_emit(&c->code, a_str_d(rt, 15, 0));
}

static void comp_str_slot_s(Compiler* c, int rt, int off) {
    if (off >= 0 && off <= 16380) { code_emit(&c->code, a_str_s(rt, 29, off)); return; }
    comp_add_off(c, 15, 29, off);
    code_emit(&c->code, a_str_s(rt, 15, 0));
}

static void comp_ldr_slot(Compiler* c, int rt, int off) {
    if (off >= 0 && off <= 32760) { code_emit(&c->code, a_ldr_x(rt, 29, off)); return; }
    comp_add_off(c, 15, 29, off);
    code_emit(&c->code, a_ldr_x(rt, 15, 0));
}

static void comp_ldr_slot_d(Compiler* c, int rt, int off) {
    if (off >= 0 && off <= 32760) { code_emit(&c->code, a_ldr_d(rt, 29, off)); return; }
    comp_add_off(c, 15, 29, off);
    code_emit(&c->code, a_ldr_d(rt, 15, 0));
}

/* Width-aware frame-slot load, mirroring comp_str_slot_w. Signed byte/half
 * loads use the unscaled-imm9 forms (direct range -256..255), unsigned byte
 * and half use the scaled-imm12 forms; anything else folds into x15 first.
 * Width 0 / 4 / 8 is not handled here: int/long slot loads keep the plain
 * 64-bit form, whose upper bytes are always maintained by the 64-bit stores
 * the rest of the backend emits. */
static void comp_ldr_slot_w(Compiler* c, int rt, int off, int width, int is_uns) {
    int direct = 0;
    if (off >= 0 && width == 1 && is_uns && off <= 4095) direct = 1;
    if (off >= 0 && width == 1 && !is_uns && off <= 255) direct = 1;
    if (off >= 0 && width == 2 && is_uns && off <= 8190) direct = 1;
    if (off >= 0 && width == 2 && !is_uns && off <= 255) direct = 1;
    /* 4-byte: the only form is a zero-extending `ldr w` (there is no signed
     * word load here -- sign extension is a separate `sxtw`).  Without this
     * case a width of 4 fell through to the width != 1 branch below, which
     * emits a HALFWORD load, so a 4-byte unsigned read returned only the low
     * 16 bits. */
    if (off >= 0 && width == 4 && off <= 16380 && (off % 4) == 0) {
        code_emit(&c->code, a_ldr_w(rt, 29, off));
        return;
    }
    if (direct) {
        if (width == 1) code_emit(&c->code, is_uns ? a_ldrb(rt, 29, off) : a_ldrsb(rt, 29, off));
        else code_emit(&c->code, is_uns ? a_ldrh(rt, 29, off) : a_ldrsh(rt, 29, off));
        return;
    }
    comp_add_off(c, 15, 29, off);
    if (width == 1) code_emit(&c->code, is_uns ? a_ldrb(rt, 15, 0) : a_ldrsb(rt, 15, 0));
    else if (width == 4) code_emit(&c->code, a_ldr_w(rt, 15, 0));
    else code_emit(&c->code, is_uns ? a_ldrh(rt, 15, 0) : a_ldrsh(rt, 15, 0));
}

/* ------ outgoing-argument marshalling (AAPCS64) -------------------------------------- */
/* Sp-relative dword access for an arbitrary offset.  x14 is not used by this
 * backend at all, so it can hold a folded offset for the (unlikely but
 * possible) case of an argument area past the imm12*8 range. */
static void comp_emit_ldr_sp(Compiler* c, int rt, int off) {
    if (off >= 0 && off <= 32760) { code_emit(&c->code, a_ldr_x(rt, 31, off)); return; }
    comp_load_imm(&c->code, 14, off);
    code_emit(&c->code, a_add(14, 31, 14));
    code_emit(&c->code, a_ldr_x(rt, 14, 0));
}
static void comp_emit_str_sp(Compiler* c, int rt, int off) {
    if (off >= 0 && off <= 32760) { code_emit(&c->code, a_str_x(rt, 31, off)); return; }
    comp_load_imm(&c->code, 14, off);
    code_emit(&c->code, a_add(14, 31, 14));
    code_emit(&c->code, a_str_x(rt, 14, 0));
}
static void comp_emit_sp_add(Compiler* c, int n) {
    if (n <= 0) return;
    if (n <= 4095) { code_emit(&c->code, a_addi(31, 31, n)); return; }
    comp_load_imm(&c->code, 14, n);
    code_emit(&c->code, a_add(31, 31, 14));
}
static void comp_emit_sp_sub(Compiler* c, int n) {
    if (n <= 0) return;
    if (n <= 4095) { code_emit(&c->code, a_subi(31, 31, n)); return; }
    comp_load_imm(&c->code, 14, n);
    code_emit(&c->code, a_sub(31, 31, 14));
}

/* Bytes of sp needed for the arguments that do not fit in the integer
 * registers: 8 bytes each, rounded up to keep sp 16-byte aligned at the call.
 * Args are pushed as 16-byte slots, so at most half of them can be stack
 * arguments and the area is always smaller than the pushed block. */
static int comp_arg_stack_area(int nargs, int firstreg) {
    int regargs = 8 - firstreg;
    if (regargs < 0) regargs = 0;
    if (regargs > nargs) regargs = nargs;
    int nstk = nargs - regargs;
    if (nstk <= 0) return 0;
    return ((8 * nstk) + 15) / 16 * 16;
}

/* Move the pushed argument slots into x(firstreg).. and the outgoing stack
 * area.  On entry the slot for argument i sits at [sp + 16*(nargs-1-i)].
 * After the stack area has been carved out below sp, the register arguments
 * are loaded from those slots and the stack arguments are copied deepest
 * -first into the area (which lies entirely below every source slot, so the
 * copy can never disturb a slot that is still to be read).  sp is left
 * lowered by the area; the caller emits comp_emit_arg_free() after the call.
 * x14 and x16 are scratch here; x9 (the parked format string) is untouched. */
static void comp_emit_arg_pops(Compiler* c, int nargs, int firstreg) {
    if (nargs <= 0) return;
    int regargs = 8 - firstreg;
    if (regargs < 0) regargs = 0;
    if (regargs > nargs) regargs = nargs;
    int nstk = nargs - regargs;
    int area = 0;
    if (nstk > 0) area = ((8 * nstk) + 15) / 16 * 16;
    if (area > 0) {
        comp_emit_sp_sub(c, area);
        int j = nstk - 1;
        while (j >= 0) {
            comp_emit_ldr_sp(c, 16, area + 16 * (nstk - 1 - j));
            comp_emit_str_sp(c, 16, 8 * j);
            j--;
        }
    }
    int i = firstreg;
    while (i < firstreg + regargs) {
        comp_emit_ldr_sp(c, i, area + 16 * (nargs - 1 - (i - firstreg)));
        i++;
    }
}

/* Release the slots pushed by the argument loop plus the outgoing stack area. */
static void comp_emit_arg_free(Compiler* c, int nargs, int firstreg) {
    comp_emit_sp_add(c, 16 * nargs + comp_arg_stack_area(nargs, firstreg));
}

static void comp_push_x0(Compiler* c);
static void comp_pop_x1(Compiler* c);
static void comp_pop_x2(Compiler* c);

/* Copy `sz` bytes from the address in x0 to the address in x1.
 * Unrolled: 8-byte chunks while they fit, then single bytes for the tail.
 * The base registers are advanced as we go so every access uses a zero
 * offset; the imm12 forms would otherwise wrap for a struct past 4095 bytes.
 * Clobbers x2 and the base registers. */
static void comp_emit_struct_copy(Compiler* c, int sz) {
    int k = 0;
    while (k + 8 <= sz) {
        code_emit(&c->code, a_ldr_x(2, 0, 0));
        code_emit(&c->code, a_str_x(2, 1, 0));
        k = k + 8;
        if (k < sz) {
            code_emit(&c->code, a_addi(0, 0, 8));
            code_emit(&c->code, a_addi(1, 1, 8));
        }
    }
    int t = 0;
    while (k + t < sz) {
        code_emit(&c->code, a_ldrb(2, 0, t));
        code_emit(&c->code, a_strb(2, 1, t));
        t = t + 1;
    }
}

/* Hidden frame slot that parks an aggregate handed back by a call.  A result of
 * 16 bytes or less arrives in x0..x1 (see comp_call) and shares the single
 * `_dyaggret` slot; a wider object is copied in by the caller and needs a slot
 * of its own size.  Sizing the shared slot for whichever call is compiled first
 * would cap every later, larger one, so those get a size-tagged name
 * (_dyaggret36, ...) and are reused by every call of the same width. */
static int comp_agg_ret_slot(Compiler* c, int sz) {
    if (sz <= 16) return comp_add_var_sized(c, g_agg_ret_name, 0, 16);
    char nm[64];
    d_strncpy(nm, g_agg_ret_name, 63);
    nm[63] = 0;
    {
        int k = d_strlen(nm);
        char dg[16];
        int di = 0;
        int n = sz;
        while (n > 0 && di < 15) { dg[di] = (char)(48 + n % 10); di = di + 1; n = n / 10; }
        if (di == 0) { dg[di] = '0'; di = di + 1; }
        while (di > 0 && k < 62) { di = di - 1; nm[k] = dg[di]; k = k + 1; }
        nm[k] = 0;
    }
    {
        int have = comp_find_var(c, nm);
        if (have >= 0) return have;
    }
    return comp_add_var_sized(c, nm, 0, sz);
}

/* Zero `sz` bytes at the address in x0 (used by `X x = {0};`). Same
 * offset-zeroing trick as comp_emit_struct_copy. Clobbers x0. */
static void comp_emit_zero(Compiler* c, int sz) {
    int k = 0;
    while (k + 8 <= sz) {
        code_emit(&c->code, a_str_x(31, 0, 0));
        k = k + 8;
        if (k < sz) code_emit(&c->code, a_addi(0, 0, 8));
    }
    int t = 0;
    while (k + t < sz) {
        code_emit(&c->code, a_strb(31, 0, t));
        t = t + 1;
    }
}

/* Postfix chain hanging off an expanded macro base: x0 already holds the
 * expanded value.  For the pointer/offset idioms (`P->f` with `#define P
 * ((T*)0)`) that value IS the address of the object, so the chain starts in
 * x0-is-the-address mode (2), and the final member is loaded -- unless `&`
 * asked for its address (`&P->f`, the _OFF_OF idiom), in which case the
 * address that comp_chain_addr left in x0 stays there. */
static void comp_macro_chain(Compiler* c, Lexer* l) {
    int celem = c->ptr_hint;
    if (celem < 0) celem = 0 - celem;
    if (celem <= 0) celem = 8;
    int cw = 0;
    int cu = 0;
    int ce = 1;
    int cs = -1;
    int cf = 0;
    comp_chain_addr(c, l, 2, -1, 8, celem, 0, -1, &cw, &ce, &cs, &cu, &cf);
    if (c->addr_of) {
        /* the caller asked for the address, which is already in x0 */
    } else if (cw == 8) code_emit(&c->code, a_ldr_x(0, 0, 0));
    else if (cw == 4) {
        if (cu) code_emit(&c->code, a_ldr_w(0, 0, 0));
        else code_emit(&c->code, a_ldrsw(0, 0, 0));
    } else if (cw == 2) {
        if (cu) code_emit(&c->code, a_ldrh(0, 0, 0));
        else code_emit(&c->code, a_ldrsh(0, 0, 0));
    } else if (cw == 1) {
        if (cu) code_emit(&c->code, a_ldrb(0, 0, 0));
        else code_emit(&c->code, a_ldrsb(0, 0, 0));
    }
    c->expr_is_float = 0;
}

/* Compile a function-like/object-like macro expansion in place of the call the
 * outer lexer `l` just consumed: fm_build() left the substituted text in
 * fm_expbuf, so seed the private sub-lexer on it and parse it as an
 * expression, then let a postfix chain (`P(T)->m`) hang off the result.
 *
 * `fm_nsub` counts the sub-lexer levels that are live.  When `l` *is* that
 * sub-lexer (a call nested inside another expansion -- `SQ(SQ(2))`), the text
 * it is reading and its own cursor have to survive: fm_build overwrites
 * fm_expbuf and fm_sublex re-seeds fm_slx underneath us, so this level's
 * cursor is parked in fm_sv_pos/fm_sv_line and fm_sublex has copied the text
 * into fm_lvl_buf.  Without that the outer body was truncated at the point the
 * inner call ended. */
static void fm_expand_expr(Compiler* c, Lexer* l, int fmi, int na) {
    int nested = 0;
    if (fm_nsub > 0) {
        nested = 1;
        fm_sv_pos[fm_nsub - 1] = fm_slx.pos;
        fm_sv_line[fm_nsub - 1] = fm_slx.lex_line;
        fm_sv_bd[fm_nsub - 1] = fm_slx.brace_depth;
    }
    fm_build(fmi, na);
    fm_sublex(l);
    if (fm_nsub < FM_LVL_MAX) fm_nsub = fm_nsub + 1;
    c->in_macro = c->in_macro + 1;
    comp_expr(c, &fm_slx);
    c->in_macro = c->in_macro - 1;
    if (fm_nsub > 0) fm_nsub = fm_nsub - 1;
    if (nested) {
        fm_slx.src = fm_lvl_buf + (fm_nsub - 1) * 2112;
        fm_slx.pos = fm_sv_pos[fm_nsub - 1];
        fm_slx.lex_line = fm_sv_line[fm_nsub - 1];
        fm_slx.brace_depth = fm_sv_bd[fm_nsub - 1];
        fm_slx.has_tok = 0;
    }
    if (lex_is(l, T_ARROW) || lex_is(l, T_DOT) || lex_is(l, T_LBRACKET)) {
        /* A chain can hang off an expanded call-like macro too:
         * `&P(T)->m` with `#define P(t) ((t*)0)` -- the expansion returns the
         * base address, so the chain runs on it. */
        comp_macro_chain(c, l);
    }
}

/* Value recorded for an integer object-like macro (`#define N 65536`,
 * `#define MAP_FAILED ((void*)-1)`), or 0 when the name is not one. */
static int comp_def_macro_val(char* name) {
    int di = 0;
    int dv = 0;
    while (di < ndefs) {
        if (d_strcmp(def_names_buf + di * 64, name) == 0) dv = def_values[di];
        di = di + 1;
    }
    return dv;
}

/* True only when `name`'s recorded value is the macro's actual body, i.e. the
 * body is a plain integer literal.  Textual bodies are left alone: the value
 * recorded for them is whatever number the recorder saw first. */
static int comp_def_is_int_macro(char* name) {
    int di = 0;
    int ok = 0;
    while (di < ndefs) {
        if (d_strcmp(def_names_buf + di * 64, name) == 0) ok = def_isint[di];
        di = di + 1;
    }
    return ok;
}

/* Parse a primary expression: literals, identifiers, calls, casts,
 * parenthesised groups and compound literals. Leaves the value in x0. */
static void comp_primary(Compiler* c, Lexer* l) {
    DcToken* t = lex_cur(l);
    c->lval_ok = 0;
    c->chain_from_value = 0;
    g_ptr_elem_cur = 0;
    g_uns_cur = 0;
    g_int_cur = 0;
    if (t->kind == T_NUM) {
        char* t_cp2 = t;
        char t_char0 = *(t_cp2 + 4);
        if (t_char0 == 70) {
            /* float literal: load full 64-bit double bit pattern into x0, move to d0 */
            {
                /* Read the literal's 8 bytes back *raw*. Going through a
                 * `double` local made the compiler emit an int->double
                 * conversion (`scvtf d0, x0`), which does not preserve the
                 * bit pattern: `1.5` came back as `(double)(int64_t)bits`. */
                char* t_cp = t;
                void* t_vp = t_cp + 2056;
                int64_t* ip = t_vp;
                int64_t u_i = *ip;
                /* A double's low half is frequently negative as a 32-bit int,
                 * so the pattern must be treated as an unsigned 64-bit value:
                 * emit_mov64 materialises all four halves directly. */
                emit_mov64(&c->code, 0, u_i);
            }
            code_emit(&c->code, a_fmov_d_x(0, 0));
            c->expr_is_float = 1;
        } else {
            /* Integer literal: read the full 64-bit value back from the same
             * 8-byte slot the float path reads its raw double from. Values
             * wider than 32 bits (4503599627370496, 0xFFFFFFFF, ...) used to
             * arrive truncated and silently became 0. */
            char* t_cp3 = t;
            void* t_vp3 = t_cp3 + 2056;
            long* t_ip3 = t_vp3;
            long u_i3 = *t_ip3;
            if (u_i3 >= -2147483648 && u_i3 <= 2147483647) comp_load_imm(&c->code, 0, (int)u_i3);
            else emit_mov64(&c->code, 0, u_i3);
            c->expr_is_float = 0;
            /* A `u`/`U` suffixed literal is unsigned: the lexer appended 'U'
             * after the digits. */
            { int tl3 = d_strlen(t->text);
              int tis_u = (tl3 > 0 && t->text[tl3 - 1] == 85);
              /* The 64-bit value is stored wrapped as a signed long, so a
               * huge unsigned literal reads back negative and must be
               * judged in the unsigned domain: 18446744073709551615ULL
               * reads as -1, which wrongly satisfied the signed int32
               * check and made add/compare paths truncate it (UXTW). */
              if (tis_u) {
                  g_uns_cur = 1;
                  g_int_cur = (u_i3 >= 0 && u_i3 <= 4294967295) ? 1 : 0;
              } else {
                  g_int_cur = (u_i3 >= -2147483648 && u_i3 <= 2147483647) ? 1 : 0;
              } }
        }
        lex_advance(l);
    } else if (t->kind == T_STR) {
        /* Adjacent string literals concatenate at translation time ("a" "b").
         * Lengths come from t->pad (decoded byte count) so embedded NULs
         * survive ("ab\0cd" is 6 bytes; strlen stops at 2). */
        /* A literal that did not fit the token's inline 2048 bytes lives in
         * t->big; reading t->text unconditionally (through a 2100-byte stack
         * buffer) silently cut it back to ~2047 chars, which is what kept the
         * 33 KB runtime prelude from ever reaching a generated program. */
        /* The join buffer must be HEAP, and the first literal must be COPIED
         * into it before any lookahead: `lex_cur()` re-lexes into the lexer's
         * single cached token, so a pointer at `t->text`/`t->big` is destroyed
         * by the very `while (lex_is(l, T_STR))` that is looking for adjacent
         * literals.  The old fixed 2100-byte stack buffer survived that but
         * silently cut every literal at 2099 chars; this keeps the survival
         * property without the cap. */
        int sl = t->pad;
        const char* fcol = (t->big != 0) ? t->big : t->text;
        if (sl <= 0) sl = d_strlen(fcol);
        char* jbuf = (char*)d_alloc((size_t)(sl + 65536));
        char* scol = jbuf ? jbuf : (char*)fcol;
        if (jbuf) { d_memcpy(jbuf, fcol, sl); jbuf[sl] = 0; }
        lex_advance(l);
        while (lex_is(l, T_STR)) {
            const char* kcol = (lex_cur(l)->big != 0) ? lex_cur(l)->big : lex_cur(l)->text;
            int klen = lex_cur(l)->pad;
            if (klen <= 0) klen = d_strlen(kcol);
            if (jbuf) {
                char* nb = (char*)d_alloc((size_t)(sl + klen + 65536));
                if (nb) { d_memcpy(nb, jbuf, sl); jbuf = nb; scol = jbuf; }
                if (scol == jbuf) { d_memcpy(jbuf + sl, kcol, klen); sl = sl + klen; jbuf[sl] = 0; }
            }
            lex_advance(l);
        }
        int id = intern_string(scol, sl);
        /* adrp/add x0, str_id (patched later) */
        int idx = c->code.nwords;
        code_emit(&c->code, a_adrp(0, 0));
        code_emit(&c->code, a_addi(0, 0, 0));
        char lbl[32];
        /* label name: str_<id> */
        lbl[0] = 115; lbl[1] = 116; lbl[2] = 114; lbl[3] = 95;
        /* convert id to decimal */
        int id2 = id; char tmp[16]; int ti = 0;
        if (id2 == 0) {
            tmp[ti] = 48;
            ti = ti + 1;
        }
        while (id2) {
            tmp[ti] = 48 + (id2 % 10);
            ti = ti + 1;
            id2 = id2 / 10;
        }
        { int k = 0; while (k < ti) { lbl[4 + k] = tmp[ti - 1 - k]; k++; } }
        lbl[4 + ti] = 0;
        code_patch(&c->code, idx, lbl, 3, 0, 0);
        /* A string literal is a pointer, never a float. Without this reset a
         * preceding double expression left the flag set, and the enclosing
         * assignment converted the address with `fcvtzu x0, d0` -- `char* r =
         * "abc";` after `double v = 2.25;` stored 2 instead of the address. */
        c->expr_is_float = 0;
        /* Allow postfix subscripts and member access on string literals:
         * `&"hello"[2]`, `"abc".some_use`.  x0 holds the address, which is
         * the object base; element size is 1 (char). */
        if (lex_is(l, T_LBRACKET) || lex_is(l, T_DOT) || lex_is(l, T_ARROW)) {
            int cw = 0; int ce = 1; int cs = -1; int cu = 0; int cf = 0;
            comp_chain_addr(c, l, 2, -1, 8, 1, 0, -1, &cw, &ce, &cs, &cu, &cf);
            if (cw > 0) { /* a load happened, w is the element width */ }
        }
    } else if (t->kind == T_LSTR) {
        /* Wide string literal L"abc": each element is a 4-byte wchar_t.
         * Expand the decoded chars to 4 bytes each, append three zero bytes,
         * and intern with len = 4n+3 so the pool stores 4n+4 bytes (element
         * n then reads back as four zero bytes, the wide terminator). */
        int n2 = t->pad;
        if (n2 < 0 || n2 > 500) n2 = 0;
        char wbuf[2200];
        int wi = 0;
        int wj = 0;
        while (wj < n2) {
            wbuf[wi] = t->text[wj];
            wbuf[wi + 1] = 0;
            wbuf[wi + 2] = 0;
            wbuf[wi + 3] = 0;
            wi = wi + 4;
            wj = wj + 1;
        }
        wbuf[wi] = 0;
        wbuf[wi + 1] = 0;
        wbuf[wi + 2] = 0;
        lex_advance(l);
        int id = intern_string(wbuf, wi + 3);
        /* adrp/add x0, str_id (patched later) */
        int idx = c->code.nwords;
        code_emit(&c->code, a_adrp(0, 0));
        code_emit(&c->code, a_addi(0, 0, 0));
        char lbl[32];
        lbl[0] = 115; lbl[1] = 116; lbl[2] = 114; lbl[3] = 95;
        int id2 = id; char tmp[16]; int ti = 0;
        if (id2 == 0) {
            tmp[ti] = 48;
            ti = ti + 1;
        }
        while (id2) {
            tmp[ti] = 48 + (id2 % 10);
            ti = ti + 1;
            id2 = id2 / 10;
        }
        { int k = 0; while (k < ti) { lbl[4 + k] = tmp[ti - 1 - k]; k++; } }
        lbl[4 + ti] = 0;
        code_patch(&c->code, idx, lbl, 3, 0, 0);
        c->expr_is_float = 0;
        /* subscripts stride 4 bytes: ws[1] is the next element */
        if (lex_is(l, T_LBRACKET) || lex_is(l, T_DOT) || lex_is(l, T_ARROW)) {
            int cw = 0; int ce = 4; int cs = -1; int cu = 0; int cf = 0;
            comp_chain_addr(c, l, 2, -1, 8, 4, 0, -1, &cw, &ce, &cs, &cu, &cf);
            if (cw > 0) { /* a load happened, w is the element width */ }
        }
    } else if (t->kind == T_IDENT) {
        char varname[64];
        d_memcpy(varname, t->text, 64);
        lex_advance(l);
        int base_is_var = 0;
        int base_var_off = -1;
        if (lex_is(l, T_LPAREN) && fm_find(varname) >= 0) {
            /* function-like macro in an expression: expand and compile the
             * substituted body in place of the call. */
            int fmi = fm_find(varname);
            int na = fm_capture(l, fmi);
            if (na >= 0) {
                fm_expand_expr(c, l, fmi, na);
                return;
            }
        }
        /* Object-like macro whose body is not a plain integer (`#define
         * MAX_SRC_BYTES (8*1024*1024)`, `#define FOO ((void*)8)`).  The
         * recorder files those in the fm_* tables with zero parameters, so a
         * bare name expands here exactly like a call without arguments.
         * Without this the name fell through to the integer table, which had
         * recorded the first number it saw -- 8 and 0 respectively. */
        if (!lex_is(l, T_LPAREN) && c->in_macro == 0) {
            int fmo = fm_find(varname);
            if (fmo >= 0 && fm_nparams[fmo] == 0) {
                /* An object-like macro with an empty body never reaches here:
                 * lex_peek drops the name from the token stream. */
                fm_expand_expr(c, l, fmo, 0);
                return;
            }
            /* Object-like macro that the recorder kept only in the integer
             * table (`#define P ((T*)0)` -- the body is a cast, so the first
             * number it saw became the recorded value).  There is no fm_* body
             * to expand, so seed x0 with that value and let a postfix chain
             * run on it: `P->f`, `P->f[i]`. */
            if (fmo < 0 && comp_def_is_macro(varname) &&
                comp_find_var(c, varname) < 0 && comp_find_gvar(varname) < 0 &&
                (lex_is(l, T_ARROW) || lex_is(l, T_DOT) || lex_is(l, T_LBRACKET))) {
                comp_load_imm(&c->code, 0, comp_def_macro_val(varname));
                comp_macro_chain(c, l);
                return;
            }
        }
        if (lex_is(l, T_LPAREN)) {
            /* function call in expression */
            comp_call(c, l, varname);
            if (lex_is(l, T_ARROW) || lex_is(l, T_DOT) || lex_is(l, T_LBRACKET)) {
                /* Member/subscript on the call result (`lex_cur(l)->text[i]`).
                 * x0 already holds the returned value, which is a pointer for
                 * `->`/`[`, so the chain starts in pointer (non-object) mode. */
                int ch_w = 0;
                int ch_e2 = 1;
                int ch_s2 = -1;
                int ch_u = 0;
                int cwf = 0;
                /* An aggregate-returning call leaves the object's ADDRESS in x0,
                 * so `.member` / `->member` must chain off it as an address
                 * (x0_is_obj = 2).  For an ordinary call the result is a value
                 * and the old mode (0) applies -- using 2 there made
                 * `f()->m` deref the return value as a pointer. */
                int x0mode = c->chain_from_value ? 2 : 0;
                c->chain_from_value = 0;
                int ch_elem0 = 1;
                if (x0mode == 0) {
                    /* A call returning a POINTER leaves the pointer VALUE in
                     * x0: the chain must start in pointer mode (2), not
                     * slot-address mode (0 -- which made the chain load the
                     * first 8 bytes of the buffer as a pointer: the
                     * `lex_text(l)[0]` startup crash).  The pointee's element
                     * size gives the subscript stride (`char*` → 1). */
                    int fs6 = fn_sig_find(varname);
                    if (fs6 >= 0 && fn_ret_ptr[fs6]) {
                        x0mode = 2;
                        ch_elem0 = fn_ret_pelem[fs6] > 0 ? fn_ret_pelem[fs6] : 8;
                    }
                }
                comp_chain_addr(c, l, x0mode, -1, 8, ch_elem0, 0, -1, &ch_w, &ch_e2, &ch_s2, &ch_u, &cwf);
                if (ch_w == 8) code_emit(&c->code, a_ldr_x(0, 0, 0));
                else if (ch_w == 4) {
                    if (ch_u) code_emit(&c->code, a_ldr_w(0, 0, 0));
                    else code_emit(&c->code, a_ldrsw(0, 0, 0));
                } else if (ch_w == 2) {
                    if (ch_u) code_emit(&c->code, a_ldrh(0, 0, 0));
                    else code_emit(&c->code, a_ldrsh(0, 0, 0));
                } else if (ch_w == 1) {
                    if (ch_u) code_emit(&c->code, a_ldrb(0, 0, 0));
                    else code_emit(&c->code, a_ldrsb(0, 0, 0));
                }
                c->expr_is_float = 0;
            }
        } else if (lex_is(l, T_ARROW) || lex_is(l, T_DOT) || lex_is(l, T_LBRACKET)) {
            /* Lvalue chain (`a[i]`, `p->f`, `c->code.words[i]`). Seed x0 with
             * the address of the base object, then let comp_chain_addr walk
             * the members/subscripts and report the final lvalue's width. */
            int off = comp_find_var(c, varname);
            int ch_slot = comp_var_struct_slot(c, varname);
            int ch_elem = comp_var_scale(c, varname);
            int ch_lval_off = -1;
