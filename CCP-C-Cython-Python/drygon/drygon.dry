    p[1340] = "char* drygon_ftoa_prec(long bits, int nd) { double v = drygon_dfrombits((unsigned long)bits); long scale = 1; int i; for (i = 0; i < nd; i++) scale = scale * 10; double r = v * (double)scale; long ip = (long)r; double fr = r - (double)ip; if (fr >= 0.5) ip = ip + 1; if (fr <= -0.5) ip = ip - 1; int neg = 0; if (ip < 0) { neg = 1; ip = 0 - ip; } char tmp[64]; int tn = 0; if (ip == 0) tmp[tn++] = 48; while (ip > 0) { tmp[tn++] = (char)(48 + (ip % 10)); ip = ip / 10; } while (tn < nd + 1) tmp[tn++] = 48; int o = 0; if (neg) drygon_fbuf[o++] = 45; while (tn > nd) drygon_fbuf[o++] = tmp[--tn]; if (nd > 0) drygon_fbuf[o++] = 46; while (tn > 0) drygon_fbuf[o++] = tmp[--tn]; drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1341] = "char* drygon_pad(char* s, int width, int align) { int n = 0; while (s[n]) n = n + 1; if (n >= width) return s; int pad = width - n; int o = 0; int i; if (align == 0) { for (i = 0; i < pad; i++) drygon_fbuf[o++] = 32; for (i = 0; i < n; i++) drygon_fbuf[o++] = s[i]; } else if (align == 1) { for (i = 0; i < n; i++) drygon_fbuf[o++] = s[i]; for (i = 0; i < pad; i++) drygon_fbuf[o++] = 32; } else { int l = pad / 2; int r2 = pad - l; for (i = 0; i < l; i++) drygon_fbuf[o++] = 32; for (i = 0; i < n; i++) drygon_fbuf[o++] = s[i]; for (i = 0; i < r2; i++) drygon_fbuf[o++] = 32; } drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1342] = "char* drygon_itobase(long v, int base, int upper) { char d[64]; int n = 0; int neg = 0; unsigned long u; if (v < 0) { neg = 1; u = (unsigned long)(0 - v); } else u = (unsigned long)v; if (u == 0) d[n++] = 48; while (u > 0) { long dig = (long)(u % (unsigned long)base); d[n++] = (char)(dig < 10 ? (48 + dig) : ((upper ? 65 : 97) + (dig - 10))); u = u / (unsigned long)base; } int o = 0; int i; if (neg) drygon_fbuf[o++] = 45; while (n > 0) drygon_fbuf[o++] = d[--n]; drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1343] = "char* drygon_itox(long v, int upper) { char d[32]; int n = 0; int neg = 0; unsigned long u; if (v < 0) { neg = 1; u = (unsigned long)(0 - v); } else u = (unsigned long)v; if (u == 0) d[n++] = 48; while (u > 0) { long dig = (long)(u % 16); d[n++] = (char)(dig < 10 ? (48 + dig) : ((upper ? 65 : 97) + (dig - 10))); u = u / 16; } int o = 0; int i; if (neg) drygon_fbuf[o++] = 45; while (n > 0) drygon_fbuf[o++] = d[--n]; drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1344] = "char* drygon_zeropad(char* s, int width) { char cp[128]; int n = 0; while (s[n] && n < 127) { cp[n] = s[n]; n = n + 1; } cp[n] = 0; if (n >= width) { int q; for (q = 0; q <= n; q++) drygon_fbuf[q] = cp[q]; return drygon_fbuf; } int pad = width - n; int o = 0; int i; int start = 0; if (n > 0 && cp[0] == 45) { drygon_fbuf[o++] = 45; start = 1; } for (i = 0; i < pad; i++) drygon_fbuf[o++] = 48; for (i = start; i < n; i++) drygon_fbuf[o++] = cp[i]; drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1345] = "char* drygon_repr_str(char* s) { int o = 0; int i = 0; drygon_fbuf[o++] = 39; while (s[i]) { drygon_fbuf[o++] = s[i]; i++; } drygon_fbuf[o++] = 39; drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1346] = "double drygon_strtod(char* s) { int i = 0; int neg = 0; double v = 0.0; double fr = 0.0; double sc = 1.0; while (s[i] == 32) i = i + 1; if (s[i] == 45) { neg = 1; i = i + 1; } while (s[i] >= 48 && s[i] <= 57) { v = v * 10.0 + (double)(s[i] - 48); i = i + 1; } if (s[i] == 46) { i = i + 1; while (s[i] >= 48 && s[i] <= 57) { fr = fr * 10.0 + (double)(s[i] - 48); sc = sc * 10.0; i = i + 1; } } v = v + fr / sc; if (neg) v = 0.0 - v; return v; }\n";
    p[1347] = "long drygon_strtol(char* s) { long v = 0; int i = 0; int neg = 0; while (s[i] == 32) i = i + 1; if (s[i] == 45) { neg = 1; i = i + 1; } if (s[i] == 48 && (s[i+1] == 120 || s[i+1] == 88)) { i = i + 2; while (1) { char c = s[i]; long d; if (c >= 48 && c <= 57) d = c - 48; else if (c >= 97 && c <= 102) d = c - 97 + 10; else if (c >= 65 && c <= 70) d = c - 65 + 10; else break; v = v * 16 + d; i = i + 1; } } else { while (s[i] >= 48 && s[i] <= 57) { v = v * 10 + (s[i] - 48); i = i + 1; } } if (neg) v = 0 - v; return v; }\n";
    p[1348] = "char* drygon_ftoa_prec_d(double v, int nd) { long scale = 1; int i; for (i = 0; i < nd; i++) scale = scale * 10; double r = v * (double)scale; long ip = (long)r; double fr = r - (double)ip; if (fr >= 0.5) ip = ip + 1; if (fr <= -0.5) ip = ip - 1; int neg = 0; if (ip < 0) { neg = 1; ip = 0 - ip; } char tmp[64]; int tn = 0; if (ip == 0) tmp[tn++] = 48; while (ip > 0) { tmp[tn++] = (char)(48 + (ip % 10)); ip = ip / 10; } while (tn < nd + 1) tmp[tn++] = 48; int o = 0; if (neg) drygon_fbuf[o++] = 45; while (tn > nd) drygon_fbuf[o++] = tmp[--tn]; if (nd > 0) drygon_fbuf[o++] = 46; while (tn > 0) drygon_fbuf[o++] = tmp[--tn]; drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1349] = "char* drygon_padf(char* s, int width, int align, int fill) { int n = 0; while (s[n]) n = n + 1; if (n >= width) return s; int pad = width - n; int o = 0; int i; if (align == 0) { for (i = 0; i < pad; i++) drygon_fbuf[o++] = fill; for (i = 0; i < n; i++) drygon_fbuf[o++] = s[i]; } else if (align == 1) { for (i = 0; i < n; i++) drygon_fbuf[o++] = s[i]; for (i = 0; i < pad; i++) drygon_fbuf[o++] = fill; } else { int l = pad / 2; int r2 = pad - l; for (i = 0; i < l; i++) drygon_fbuf[o++] = fill; for (i = 0; i < n; i++) drygon_fbuf[o++] = s[i]; for (i = 0; i < r2; i++) drygon_fbuf[o++] = fill; } drygon_fbuf[o] = 0; return drygon_fbuf; }\n";
    p[1350] = "char drygon_mttab[256];\n";
    p[1351] = "char* drygon_maketrans3(char* from, char* to, char* del) { int i; for (i = 0; i < 256; i++) drygon_mttab[i] = (char)i; int j = 0; while (from[j] && to[j]) { drygon_mttab[(unsigned char)from[j]] = to[j]; j = j + 1; } if (del) { int k = 0; while (del[k]) { drygon_mttab[(unsigned char)del[k]] = 0; k = k + 1; } } return drygon_mttab; }\n";
