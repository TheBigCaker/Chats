/* expressions that produce a `char*`: a live child's captured output, the
 * module's stdio flags stay numeric. */
static int cg_sp_is_strexpr(const IRNode* a) {
    if (!a) return 0;
    if (d_strcmp(a->type,"CALL")==0 && a->nchildren > 0 && a->children[0]) {
        const IRNode* cal = a->children[0];
        if (d_strcmp(cal->type,"MEMBER_ACCESS")==0 && cal->nchildren > 0 && cal->children[0] &&
            d_strcmp(cal->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(cal->children[0]->value,"subprocess")==0 &&
            cal->value && d_strcmp(cal->value,"check_output")==0) return 1;
    }
    if (d_strcmp(a->type,"MEMBER_ACCESS")==0 && a->nchildren > 0 && a->children[0] &&
        d_strcmp(a->children[0]->type,"IDENTIFIER")==0) {
        const char* rn = a->children[0]->value;
        if (d_strcmp(rn,"sys")==0 && a->value && d_strcmp(a->value,"executable")==0) return 1;
        if (cg_sp_is_obj(rn) && a->value &&
            (d_strcmp(a->value,"stdout")==0 || d_strcmp(a->value,"stderr")==0)) return 1;
    }
    return 0;
}
/* subprocess.PIPE -> 1, subprocess.DEVNULL -> 2, inherited -> 0 */
static int cg_sp_fdmode(const IRNode* v) {
    if (!v) return 0;
    if (d_strcmp(v->type,"MEMBER_ACCESS")==0 && v->nchildren > 0 && v->children[0] &&
        d_strcmp(v->children[0]->type,"IDENTIFIER")==0 &&
        d_strcmp(v->children[0]->value,"subprocess")==0 && v->value) {
        if (d_strcmp(v->value,"PIPE")==0) return 1;
        if (d_strcmp(v->value,"DEVNULL")==0) return 2;
    }
    return 0;
}
/* `timeout=0.1` -> 100000 microseconds (a literal is folded here) */
static int cg_sp_tmo_us(const IRNode* v) {
    if (!v || d_strcmp(v->type,"CONSTANT") != 0 || !v->value) return 0;
    const char* s = v->value;
    int i = 0;
    long ip = 0;
    long us = 0;
    while (s[i] >= 48 && s[i] <= 57) { ip = ip * 10 + (s[i] - 48); i++; }
    us = ip * 1000000;
    if (s[i] == 46) {
        int d = 0;
        long f = 0;
        i++;
        while (s[i] >= 48 && s[i] <= 57 && d < 6) { f = f * 10 + (s[i] - 48); d++; i++; }
        while (d < 6) { f = f * 10; d++; }
