/* emit `arg[idx]`, reading a literal element directly (indexing a compound
 * literal in place miscompiles here) */
static void cg_ig_emit_elem(CGen* g, const IRNode* arg, int idx) {
    if (arg && cg_is_list_node(arg) && idx >= 0 && idx < arg->nchildren) {
        cg_gen_expr(g, arg->children[idx]);
        return;
    }
    cg_gen_expr(g, arg);
    cg_put(g, "[");
    cg_put_int(g, idx);
    cg_put(g, "]");
