                    cg_put(g, " = ");
                    cg_gen_expr(g, arhs);
                    cg_put(g, ";\n");
                    return;
                }
            }
            /* Unpack single-child block RHS (e.g. `(1, 2, 3)`, `[1, 2, 3]`, `t`, `d[0]`) */
            if (alhs && arhs && cg_is_list_node(alhs) &&
                d_strcmp(arhs->type, "BLOCK") == 0 && arhs->nchildren == 1) {
                arhs = arhs->children[0];
            }
            int star_idx = -1;
            if (alhs && cg_is_list_node(alhs)) {
                int si = 0;
                while (si < alhs->nchildren) {
                    if (alhs->children[si] && d_strcmp(alhs->children[si]->data_type, "STAR") == 0) {
                        star_idx = si;
                        break;
