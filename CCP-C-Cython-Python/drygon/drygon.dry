             * A class whose `__iter__` merely returns `self` is the ordinary
             * iterator protocol instead: `__next__` hands out the values until
             * StopIteration, so drive that directly. */
            const char* itc = it->value;
            const char* itm = cg_cls_find_m(itc, "__iter__");
            const char* itx = cg_cls_find_m(itc, "__next__");
            char itn[32];
            char ivb[32]; char ivn[32]; char ivt[32]; char ivg[32];
            /* base 1000: the `_gcs<n>` class-scratch namespace only ever holds
             * indices < 128, so an iterator instance can never be given the
             * name of a class' scratch object. */
            cg_scratch_name(1000 + cg_it_serial, itn);
            cg_it_serial = cg_it_serial + 1;
            cg_put(g, "{\n"); g->indent++;
            cg_indent(g);
            cg_put(g, itc); cg_put(g, " "); cg_put(g, itn); cg_put(g, ";\n");
            cg_lf_zero_ctor(g, itc, itn, ".");
            cg_indent(g);
            cg_emit_init(g, itc, it, itn); cg_put(g, ";\n");
            if (itx) {
                cg_iter_names(cg_it_serial, ivb, ivn, ivt, ivg, ivg);
                cg_it_serial = cg_it_serial + 1;
                cg_iter_fill(g, itx, itn, ivb, ivn, ivt);
                cg_indent(g);
                cg_put(g, "int "); cg_put(g, v->value); cg_put(g, "; int ");
                cg_put(g, ivg); cg_put(g, " = 0;\n");
                g->indent++;
                cg_indent(g);
                cg_put(g, "while ("); cg_put(g, ivg); cg_put(g, " < ");
                cg_put(g, ivn); cg_put(g, ") { ");
                cg_put(g, v->value); cg_put(g, " = ");
                cg_put(g, ivb); cg_put(g, "["); cg_put(g, ivg); cg_put(g, "];\n");
                if (body) cg_gen_block(g, body);
                cg_indent(g);
                cg_put(g, ivg); cg_put(g, " = "); cg_put(g, ivg);
                cg_put(g, " + 1; }\n");
                g->indent--;
                cg_indent(g);
                cg_put(g, "}\n");
