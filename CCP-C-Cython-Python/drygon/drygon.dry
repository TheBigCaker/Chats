    p[1426] = "char* drygon_zfill(char* s, int w) {\nint n = drygon_slen(s);\nif (n >= w) return s;\nint st = 0;\nif (n > 0 && (s[0] == 45 || s[0] == 43)) st = 1;\nchar* r = drygon_alloc(w + 1);\nint i = 0;\n";
    p[1427] = "while (i < st) { r[i] = s[i]; i = i + 1; }\nint pad = w - n;\nint j = 0;\nwhile (j < pad) { r[i] = 48; i = i + 1; j = j + 1; }\nint k = st;\n";
    p[1428] = "while (k < n) { r[i] = s[k]; i = i + 1; k = k + 1; }\nr[w] = 0;\nreturn r;\n}\n";
