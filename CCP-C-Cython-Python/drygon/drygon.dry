    p[1382] = "int i = 0;\nif (an != bn) return 0;\nwhile (i < an) {\nint j = 0;\nint f = 0;\nwhile (j < bn) { if (drygon_strord(bk[j], ak[i]) == 0) { f = 1; if (bv[j] != av[i]) return 0; break; } j = j + 1; }\n";
    p[1383] = "if (f == 0) return 0;\ni = i + 1;\n}\nreturn 1;\n}\n";
