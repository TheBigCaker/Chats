                 d_strcmp(mn,"strip")==0 || d_strcmp(mn,"lstrip")==0 ||
                 d_strcmp(mn,"rstrip")==0 || d_strcmp(mn,"upper")==0 ||
                 d_strcmp(mn,"lower")==0 || d_strcmp(mn,"replace")==0 ||
                 d_strcmp(mn,"join")==0 || d_strcmp(mn,"decode")==0 ||
                 d_strcmp(mn,"format")==0 || d_strcmp(mn,"title")==0 ||
                 d_strcmp(mn,"capitalize")==0 || d_strcmp(mn,"swapcase")==0 ||
                 d_strcmp(mn,"zfill")==0 || d_strcmp(mn,"ljust")==0 ||
                 d_strcmp(mn,"rjust")==0 || d_strcmp(mn,"center")==0 ||
                 d_strcmp(mn,"expandtabs")==0 || d_strcmp(mn,"translate")==0 ||
                 d_strcmp(mn,"read_text")==0 || d_strcmp(mn,"removeprefix")==0 ||
                 d_strcmp(mn,"removesuffix")==0))
