                                cg_gen_expr(g, n->children[i + 1]);
                            }
                            cg_put(g, ")");
                            return;
                        }
                    }
                    if (d_strcmp(target->type,"MEMBER_ACCESS")==0) {
                        /* `sys.exit(N)` -> the prelude's raw exit syscall. */
                        if (target->nchildren>0 && d_strcmp(target->children[0]->value,"sys")==0 &&
                            d_strcmp(target->value,"exit")==0) {
                            cg_put(g, "sys_exit(");
                            if (n->nchildren>1) cg_gen_expr(g, n->children[1]);
                            else cg_put(g, "0");
                            cg_put(g, ")");
                            return;
                        }
                        /* `os.path.exists(p)` -> the prelude's native stat
                         * probe.  Emitted verbatim the permissive front end
                         * still accepted `os.path.exists(x)` and the PROGRAM
                         * died with SIGSEGV there. */
                        if (target->nchildren>0 && target->children[0] &&
                            d_strcmp(target->value,"exists")==0 &&
                            d_strcmp(target->children[0]->type,"MEMBER_ACCESS")==0 &&
                            d_strcmp(target->children[0]->value,"path")==0) {
                            cg_put(g, "drygon_fs_exists(");
                            if (n->nchildren>1) cg_gen_expr(g, n->children[1]);
                            else cg_put(g, "0");
                            cg_put(g, ")");
                            return;
                        }
                        /* `os.remove(p)` / `os.unlink(p)` */
                        if (target->nchildren>0 && target->children[0] &&
                            d_strcmp(target->children[0]->value,"os")==0 &&
                            (d_strcmp(target->value,"remove")==0 ||
                             d_strcmp(target->value,"unlink")==0)) {
                            cg_put(g, "drygon_fs_unlink(");
                            if (n->nchildren>1) cg_gen_expr(g, n->children[1]);
                            else cg_put(g, "0");
                            cg_put(g, ")");
                            return;
                        }
                        /* `sys.stdout.flush()` (and stderr): emitted verbatim it
                         * was `sys.stdout.flush();`, which is not C -- the front
                         * end still compiled it -- into a member call through an
                         * unresolved target -- so the PROGRAM died with SIGSEGV
                         * right there.  `fflush(0)` is the prelude's no-op
                         * stream flush (the runtime flushes its output buffer at
                         * exit), so the call is safe and has the right shape. */
                        if (target->nchildren>0 && target->children[0] &&
                            d_strcmp(target->value,"flush")==0 &&
                            d_strcmp(target->children[0]->type,"MEMBER_ACCESS")==0 &&
                            (d_strcmp(target->children[0]->value,"stdout")==0 ||
                             d_strcmp(target->children[0]->value,"stderr")==0)) {
                            cg_put(g, "fflush(0)");
                            return;
                        }
                        if (target->nchildren>0 && (d_strcmp(target->children[0]->value, "torch")==0 || d_strcmp(target->children[0]->value, "nn")==0)) {
                            cg_put(g, target->value);
                        } else if (target->nchildren>0 && d_strcmp(target->children[0]->value, "str")==0 &&
                                   d_strcmp(target->value, "maketrans")==0) {
                            /* `str.maketrans(a, b)`: build a real 256-byte table
                             * (it was emitted as `0`, and `translate` then
                             * dereferenced null). */
                            /* `str.maketrans(a, b[, delete])`: the third
                             * argument DELETES characters (their slot maps to
                             * 0), so dropping it left `deletechars` untranslated
                             * and `translate` returned the input with the delete
                             * set still present. */
                            /* Every argument must EXIST before it is emitted: a
                             * missing one left a dangling `, )` in the call,
                             * which is not valid C and took the WHOLE FILE's
                             * compile down (`str.maketrans({...})` has one
                             * argument).  The dict form's table cannot be built
                             * with a `({ ... })` statement expression -- drygon's
                             * own C front end rejects that -- so it falls back to
                             * an identity table here rather than failing the
                             * build. */
                            if (n->nchildren>3 && n->children[1] && n->children[2] && n->children[3]) {
                                cg_put(g, "drygon_maketrans3(");
                                cg_gen_expr(g, n->children[1]);
                                cg_put(g, ", ");
                                cg_gen_expr(g, n->children[2]);
                                cg_put(g, ", ");
                                cg_gen_expr(g, n->children[3]);
                                cg_put(g, ")");
                            } else if (n->nchildren>2 && n->children[1] && n->children[2]) {
                                cg_put(g, "drygon_maketrans(");
                                cg_gen_expr(g, n->children[1]);
                                cg_put(g, ", ");
                                cg_gen_expr(g, n->children[2]);
                                cg_put(g, ")");
                            } else {
                                cg_put(g, "drygon_maketrans(\"\", \"\")");
                            }
                            return;
                        } else if (target->nchildren>0 && d_strcmp(target->children[0]->value, "operator")==0) {
                            /* operator.<fn>(a, b) -> the C operator.  The call was
                             * emitted VERBATIM, so the program called a function
                             * that does not exist and segfaulted. */
                            const char* of = target->value;
                            const IRNode* o0 = n->nchildren>1 ? n->children[1] : NULL;
                            const IRNode* o1 = n->nchildren>2 ? n->children[2] : NULL;
                            int obin = 0;
                            const char* oop = 0;
                            if (d_strcmp(of,"add")==0) { oop = "+"; obin = 1; }
                            else if (d_strcmp(of,"sub")==0) { oop = "-"; obin = 1; }
                            else if (d_strcmp(of,"mul")==0) { oop = "*"; obin = 1; }
                            else if (d_strcmp(of,"truediv")==0) {
                                /* python's `/` is TRUE division: `operator.truediv(10, 4)`
                                 * is 2.5, so at least one operand must be promoted
                                 * to double (C's integer `/` gave 2). */
                                cg_put(g, "(((double)("); cg_gen_expr(g, o0);
                                cg_put(g, ")) / ((double)("); cg_gen_expr(g, o1);
                                cg_put(g, ")))");
                                return;
                            }
                            else if (d_strcmp(of,"mod")==0) { oop = "%"; obin = 1; }
                            else if (d_strcmp(of,"floordiv")==0) {
                                cg_put(g, "(((long)("); cg_gen_expr(g, o0); cg_put(g, ")) / ((long)(");
                                cg_gen_expr(g, o1); cg_put(g, ")))");
                                return;
                            }
                            else if (d_strcmp(of,"pow")==0) {
                                cg_put(g, "(long)drygon_m_pow((double)(");
                                cg_gen_expr(g, o0); cg_put(g, "), (double)(");
                                cg_gen_expr(g, o1); cg_put(g, "))");
                                return;
