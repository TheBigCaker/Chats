    p[1508] = "char* drygon_dd_make(int n) {\n";
    p[1509] = "long long* h = (long long*)drygon_alloc(48);\nchar** k = (char**)drygon_alloc((n + 1) * 8);\nchar** v = (char**)drygon_alloc((n + 1) * 8);\nint i = 0;\n";
