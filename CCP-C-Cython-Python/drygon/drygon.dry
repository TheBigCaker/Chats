                        cg_put(g, "(");
                        cg_clsptr_reset();
                        cg_alias_reset();
                        cg_cur_cls_i = ci;
                        int mflc = (ci >= 0 && cg_cls_nmeth[ci] > 0) ?
                                   (int)cg_cls_mflags[ci*48 + (cg_cls_nmeth[ci]-1)] : 0;
