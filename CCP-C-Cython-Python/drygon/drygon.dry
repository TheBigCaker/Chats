                if (!suppress) dp = va_arg(ap, char*);
                d_sc_skipsp(&s);
                while (*s && !d_sc_space(*s) && (width <= 0 || n < width)) {
                    if (dp) {
                        if (len == 3) { int* wp = (int*)dp; wp[n] = (int)*s; }
                        else dp[n] = *s;
                    }
                    s = s + 1; n = n + 1;
                }
                ok = (n > 0);
                if (ok && !suppress) {
                    assigned = assigned + 1;
                    if (len == 3) { int* wp = (int*)dp; wp[n] = 0; }
