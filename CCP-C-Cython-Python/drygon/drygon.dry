                }
                int mi2 = 0;
                while (mi2 < body->nchildren) {
                    const IRNode* mc = body->children[mi2];
                    if (d_strcmp(mc->type,"FUNCTION_DEF")==0 && mc->nchildren>1)
                        cg_cls_collect(mc->children[1], cfn, &cnf, 32);
                    mi2++;
                }
