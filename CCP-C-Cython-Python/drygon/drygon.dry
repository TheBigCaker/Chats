         * = 0 (50_csv). */
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 && a->children[0]) {
            const IRNode* db = a->children[0];
            if (db && d_strcmp(db->type,"IDENTIFIER")==0 && cg_drla_on(db->value) >= 0) return 1;
            if (db && d_strcmp(db->type,"ARRAY_ACCESS")==0 && db->nchildren>0 &&
                db->children[0] &&
