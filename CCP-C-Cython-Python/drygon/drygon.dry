    /* dict equality helpers: `a == b` for two dicts used to be emitted as a
     * bare C `(a == b)` over two names that do not exist in C, so the program
     * trapped (13_builtins check 46, 11_functions check 11).  One helper per
     * key/value type combination, following the drygon_dget_* naming. */
    p[1375] = "int drygon_deq_ii(int* ak, int* av, int an, int* bk, int* bv, int bn) {\n";
    p[1376] = "int i = 0;\nif (an != bn) return 0;\nwhile (i < an) {\nint j = 0;\nint f = 0;\nwhile (j < bn) { if (bk[j] == ak[i]) { f = 1; if (bv[j] != av[i]) return 0; break; } j = j + 1; }\n";
    p[1377] = "if (f == 0) return 0;\ni = i + 1;\n}\nreturn 1;\n}\n";
    p[1378] = "int drygon_deq_is(int* ak, char** av, int an, int* bk, char** bv, int bn) {\n";
    p[1379] = "int i = 0;\nif (an != bn) return 0;\nwhile (i < an) {\nint j = 0;\nint f = 0;\nwhile (j < bn) { if (bk[j] == ak[i]) { f = 1; if (drygon_strord(bv[j], av[i]) != 0) return 0; break; } j = j + 1; }\n";
    p[1380] = "if (f == 0) return 0;\ni = i + 1;\n}\nreturn 1;\n}\n";
