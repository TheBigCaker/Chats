                    while (ifi < cg_if_fn) {
                        if (d_strcmp(cg_if_fcls + ifi*64, cg_cls_names[cg_cls_n - 1]) == 0) {
                            int jj = 0;
                            int dup = 0;
                            while (jj < cnf) {
                                if (d_strcmp(cfn + jj*64, cg_if_fname + ifi*64) == 0) { dup = 1; break; }
                                jj++;
