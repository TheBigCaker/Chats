                         * the body referenced an undeclared identifier and the
                         * program trapped on an unresolved symbol.  Register the
                         * name as a list parameter (`*args`) or a dict (`**kw`)
                         * so the body can at least read it as a sequence. */
                        int dstar = (d_strcmp(pk(p)->text,"**")==0);
                        advance(p);
                        if (pk(p)->kind == TOK_NAME || pk(p)->kind == TOK_IDENT) {
                            char vname[128]; d_strncpy(vname, pk(p)->text, 127); vname[127]='\0';
                            advance(p);
                            IRNode* vp = ir_new("PARAM_DECL", vname, dstar ? "DICT" : "VARGS");
                            ir_add_child(params, vp);
                        }
                    }
                    if (pk(p)->kind == TOK_COMMA) advance(p);
                    else break;
                }
                if (pk(p)->kind == TOK_RPAREN) advance(p);
            }
            ir_add_child(fn, params);
            /* return annotation -> type */
            char ret_type[64] = "VOID";
            if (pk(p)->kind == TOK_ARROW) {
                advance(p);
                if (pk(p)->kind == TOK_NAME) {
                    d_strncpy(ret_type, pk(p)->text, 63); ret_type[63] = '\0';
                    advance(p);
                }
                int depth = 0;
                while (pk(p)->kind != TOK_EOF) {
                    if (pk(p)->kind == TOK_LBRACK || pk(p)->kind == TOK_LPAREN) depth++;
                    else if (pk(p)->kind == TOK_RBRACK || pk(p)->kind == TOK_RPAREN) {
                        if (depth > 0) depth--;
                    } else if (depth == 0 && pk(p)->kind == TOK_COLON) {
                        break;
                    }
                    advance(p);
                }
            }
            d_strncpy(fn->data_type, ret_type, 15); fn->data_type[15] = '\0';
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* body = ir_new("BLOCK", "", "ANY");
            parse_suite(p, body);
            ir_add_child(fn, body);
            return fn;
        }
        /* global/nonlocal: the names live at module scope */
        if (is_kw(p,"global") || is_kw(p,"nonlocal")) {
            /* `nonlocal` binds the ENCLOSING function's cell, not a module
             * name: the scope passes must keep renaming it together with the
             * outer function so the pair still shares one variable. */
            int isnl = is_kw(p,"nonlocal");
            advance(p);
            IRNode* gd = ir_new("GLOBAL_DECL", "", isnl ? "NONLOCAL" : "ANY");
            while (pk(p)->kind == TOK_NAME) {
                ir_add_child(gd, ir_new("IDENTIFIER", pk(p)->text, "ANY"));
                advance(p);
                if (pk(p)->kind == TOK_COMMA) { advance(p); continue; }
                break;
            }
            return gd;
        }
        /* class Name(Base): */
        if (is_kw(p,"class")) {
            advance(p);
            char cname[128]; d_strncpy(cname, pk(p)->text, 127); cname[127]='\0';
            advance(p);
            char bname[128]; bname[0] = '\0';
            if (pk(p)->kind == TOK_LPAREN) {
                advance(p);
                if (pk(p)->kind != TOK_RPAREN && pk(p)->kind != TOK_EOF) {
                    d_strncpy(bname, pk(p)->text, 127); bname[127] = '\0';
                    advance(p);
                }
                /* Python allows several bases (`class C(A, B)`): keep them all
                 * comma-separated so codegen can look a method up in every base.
                 * Keyword arguments (`metaclass=ABCMeta`) are skipped. */
                while (pk(p)->kind != TOK_RPAREN && pk(p)->kind != TOK_EOF) {
                    if (pk(p)->kind == TOK_NAME && pk2(p)->kind == TOK_EQ) {
                        advance(p); advance(p);
                        int kwd = 0;
                        while (pk(p)->kind != TOK_EOF) {
                            if (pk(p)->kind == TOK_LPAREN || pk(p)->kind == TOK_LBRACK || pk(p)->kind == TOK_LBRACE) { kwd++; advance(p); continue; }
                            if (pk(p)->kind == TOK_RPAREN || pk(p)->kind == TOK_RBRACK || pk(p)->kind == TOK_RBRACE) { if (kwd == 0) break; kwd--; advance(p); continue; }
                            if (kwd == 0 && pk(p)->kind == TOK_COMMA) break;
                            advance(p);
                        }
                        if (kwd == 0 && pk(p)->kind == TOK_COMMA) advance(p);
                        continue;
                    }
                    if (pk(p)->kind == TOK_NAME &&
                        (pk2(p)->kind == TOK_COMMA || pk2(p)->kind == TOK_RPAREN)) {
                        int bl = d_strlen(bname);
                        if (bl == 0) {
                            d_strncpy(bname, pk(p)->text, 127); bname[127] = '\0';
                        } else if (bl + d_strlen(pk(p)->text) + 1 < 127) {
                            bname[bl] = ',';
                            d_strncpy(bname + bl + 1, pk(p)->text, 126 - bl);
                            bname[127] = '\0';
                        }
                    }
                    advance(p);
                }
                if (pk(p)->kind==TOK_RPAREN) advance(p);
            }
            IRNode* cls = ir_new("CLASS_DEF", cname, bname[0] ? bname : "ANY");
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* body = ir_new("BLOCK", "", "ANY");
            parse_suite(p, body);
            ir_add_child(cls, body);
            return cls;
        }
        /* match expr: case pat: ... */
        if (is_kw(p,"match")) {
            advance(p);
            IRNode* mval = parse_expr(p);
            if (pk(p)->kind == TOK_COLON) advance(p);
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
            if (pk(p)->kind == TOK_INDENT) advance(p);
            IRNode* root_if = NULL;
            IRNode* cur_if = NULL;
            while (pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_DEDENT) {
                while (pk(p)->kind == TOK_NEWLINE) advance(p);
                if (pk(p)->kind == TOK_EOF || pk(p)->kind == TOK_DEDENT) break;
                if (is_kw(p,"case")) {
                    advance(p);
                    int is_wild = (pk(p)->kind == TOK_NAME && d_strcmp(pk(p)->text, "_") == 0);
                    IRNode* pat = parse_expr(p);
                    /* `case pat if cond:` — the guard is evaluated only once the
                     * pattern matched, and a failed guard falls through to the
                     * next case, so it has to join the arm's condition rather
                     * than wrap its body.  Dropping it made `case n if n > 0`
                     * match everything (36_match checks 25-27). */
                    IRNode* guard = NULL;
                    if (is_kw(p,"if")) {
                        advance(p);
                        guard = parse_expr(p);
                    }
                    /* `case n if n > 0:` binds `n` to the subject, but the
                     * binding only reaches the arm BODY, so the guard read an
                     * unbound name and emitted `if ((n > 0)) { n = x; ... }`
                     * (36_match checks 25-27).  The subject is a plain variable
                     * in every such guard, so rewrite the captured name to the
                     * subject inside the guard. */
                    if (guard && mval && d_strcmp(mval->type,"IDENTIFIER")==0 &&
                        py_pat_plain_name(pat) && d_strcmp(pat->value, mval->value)!=0)
                        cg_ident_rename(guard, pat->value, mval->value);
                    if (pk(p)->kind == TOK_COLON) advance(p);
                    IRNode* cbody = ir_new("BLOCK", "", "ANY");
                    parse_suite(p, cbody);
                    IRNode* ccond = py_pat_type_cond(pat, mval);
                    if (!ccond) ccond = py_pat_or_cond(pat, mval, cbody);
                    if (!ccond) ccond = py_pat_class_cond(pat, mval, cbody);
                    if (!ccond) ccond = py_pat_map_cond(pat, mval, cbody);
                    py_pat_star_cond = NULL;
                    if (py_pat_capture(pat, mval, cbody)) is_wild = 1;
                    if (!ccond && py_pat_star_cond) ccond = py_pat_star_cond;
                    IRNode* cond = NULL;
                    if (ccond) {
                        cond = ccond;
                    } else if (!is_wild) {
                        cond = ir_new("BINARY_OP", "==", "BOOL");
                        ir_add_child(cond, mval);
                        ir_add_child(cond, pat);
                    }
                    if (guard) {
                        if (cond) {
                            IRNode* an = ir_new("BINARY_OP", "and", "ANY");
                            ir_add_child(an, cond);
                            ir_add_child(an, guard);
                            cond = an;
                        } else cond = guard;
                    }
                    if (!cond) {
                        if (cur_if) {
                            IRNode* eb = ir_new("ELSE_BLOCK", "", "ANY");
                            ir_add_child(eb, cbody);
                            ir_add_child(cur_if, eb);
                        } else {
                            root_if = cbody;
                        }
                    } else {
                        IRNode* ifn = ir_new("IF", cur_if ? "ELIF" : "", "ANY");
                        ir_add_child(ifn, cond);
                        ir_add_child(ifn, cbody);
                        if (!root_if) {
                            root_if = ifn;
                            cur_if = ifn;
                        } else {
                            /* The nested case must sit inside a BLOCK, exactly
                             * like the `elif` chain builds it.  Adding the IF
                             * as the ELSE_BLOCK's direct child made
                             * cg_gen_block iterate the IF's own children as
                             * statements: a 3-case `match` emitted
                             * `/* BINARY_OP *\/` and lost the `case _` arm. */
                            IRNode* eb = ir_new("ELSE_BLOCK", "", "ANY");
                            IRNode* ebb = ir_new("BLOCK", "", "ANY");
                            ir_add_child(ebb, ifn);
                            ir_add_child(eb, ebb);
                            ir_add_child(cur_if, eb);
                            cur_if = ifn;
                        }
                    }
                } else {
                    advance(p);
                }
            }
            if (pk(p)->kind == TOK_DEDENT) advance(p);
            return root_if ? root_if : ir_new("PASS", "", "ANY");
        }
        /* if / elif / else */
        if (is_kw(p,"if")||is_kw(p,"elif")) {
            int is_elif = is_kw(p,"elif");
            advance(p);
            IRNode* cond = parse_expr(p);
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* ifn = ir_new("IF", is_elif ? "ELIF" : "", "ANY");
            if (cond) ir_add_child(ifn, cond);
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
            IRNode* body = ir_new("BLOCK", "", "ANY");
            if (pk(p)->kind == TOK_INDENT) {
                advance(p);
                parse_block(p, body);
            } else {
                IRNode* s = py_comp_stmt(parse_stmt(p));
                if (s) ir_add_child(body, s);
            }
            ir_add_child(ifn, body);
            /* else: / elif: */
            if (is_kw(p,"else")) {
                advance(p);
                if (pk(p)->kind == TOK_COLON) advance(p);
                while (pk(p)->kind == TOK_NEWLINE) advance(p);
                IRNode* else_block = ir_new("ELSE_BLOCK", "", "ANY");
                IRNode* else_body = ir_new("BLOCK", "", "ANY");
                if (pk(p)->kind == TOK_INDENT) {
                    advance(p);
                    parse_block(p, else_body);
                } else {
                    IRNode* s2 = py_comp_stmt(parse_stmt(p));
                    if (s2) ir_add_child(else_body, s2);
                }
                ir_add_child(else_block, else_body);
                ir_add_child(ifn, else_block);
            } else if (is_kw(p,"elif")) {
                /* elif becomes else { if (cond) { ... } } chain.
                 * ELSE_BLOCK->BLOCK->IF to match the same shape as a
                 * regular `else:` branch so cg_gen_block works. */
                IRNode* elif_node = parse_stmt(p);
                if (elif_node) {
                    IRNode* eb = ir_new("ELSE_BLOCK", "", "ANY");
                    IRNode* eb_body = ir_new("BLOCK", "", "ANY");
                    ir_add_child(eb_body, elif_node);
                    ir_add_child(eb, eb_body);
                    ir_add_child(ifn, eb);
                }
            }
            return ifn;
        }
        /* while cond: */
        if (is_kw(p,"while")) {
            advance(p);
            IRNode* cond = parse_expr(p);
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* w = ir_new("WHILE", "", "ANY");
            if (cond) ir_add_child(w, cond);
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
            if (pk(p)->kind == TOK_INDENT) advance(p);
            IRNode* body = ir_new("BLOCK", "", "ANY");
            parse_block(p, body);
            ir_add_child(w, body);
            /* `while ... else:` -- the else body runs only when the loop ends
             * WITHOUT a break.  It used to go unconsumed and was then parsed as
             * a SEPARATE top-level statement, so it always executed (a `break`
             * did not skip it). */
            if (is_kw(p,"else")) {
                advance(p);
                if (pk(p)->kind == TOK_COLON) advance(p);
                while (pk(p)->kind == TOK_NEWLINE) advance(p);
                IRNode* eb = ir_new("ELSE_BLOCK", "", "ANY");
                IRNode* ebody = ir_new("BLOCK", "", "ANY");
                if (pk(p)->kind == TOK_INDENT) { advance(p); parse_block(p, ebody); }
                else { IRNode* s3 = py_comp_stmt(parse_stmt(p)); if (s3) ir_add_child(ebody, s3); }
                ir_add_child(eb, ebody);
                ir_add_child(w, eb);
            }
            return w;
        }
        /* with EXPR [as NAME]: -- a context manager */
        if (is_kw(p,"with")) {
            advance(p);
            IRNode* wexpr = parse_expr(p);
            char wasname[64]; wasname[0] = 0;
            /* `as` is a TOK_NAME, not a registered keyword -- checking only
             * is_kw() left the clause unconsumed, so the body parsed `as` as an
             * expression and emitted a bare `as;` plus an unresolved `r`
             * (47_contextlib, 60_comprehensive). */
            if (is_kw(p,"as") || (pk(p)->kind == TOK_NAME && d_strcmp(pk(p)->text,"as")==0)) {
                advance(p);
                if (pk(p)->kind == TOK_NAME) { d_strncpy(wasname, pk(p)->text, 63); wasname[63]=0; advance(p); }
            }
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* w = ir_new("WITH", "", wasname[0] ? wasname : "ANY");
            if (wexpr) ir_add_child(w, wexpr);
            IRNode* wbody = ir_new("BLOCK", "", "ANY");
            parse_suite(p, wbody);
            ir_add_child(w, wbody);
            return w;
        }
        /* for x in range(...): */
        if (is_kw(p,"for")) {
            advance(p);
            char var[128]; var[0]='\0';
            IRNode* tgt = NULL;
            if (pk(p)->kind == TOK_NAME) {
                d_strncpy(var, pk(p)->text, 127); var[127]='\0';
                advance(p);
                tgt = ir_new("IDENTIFIER", var, "ANY");
                if (pk(p)->kind == TOK_COMMA) {
                    /* `for x, y in pairs:` — the target is a tuple, destructured
                     * per element by the codegen */
                    IRNode* tup = ir_new("BLOCK","TUPLE","ANY");
                    ir_add_child(tup, tgt);
                    while (pk(p)->kind == TOK_COMMA) {
                        advance(p);
                        if (pk(p)->kind != TOK_NAME) break;
                        ir_add_child(tup, ir_new("IDENTIFIER", pk(p)->text, "ANY"));
                        advance(p);
                    }
                    tgt = tup;
                    var[0] = '\0';
                }
            } else {
                /* a target that is not a plain name: consume the token so the
                 * parse cannot spin (and never dereference a token without
                 * text, which used to fault) */
                advance(p);
            }
            if (is_kw(p,"in")) advance(p);
            IRNode* iter = parse_expr(p);
            if (pk(p)->kind == TOK_COLON) advance(p);
            IRNode* f = ir_new("FOR", "", "ANY");
            /* detect range() → canonical 3-clause */
            if (var[0] && iter && iter->type[0]=='C' && d_strcmp(iter->type,"CALL")==0 && d_strcmp(iter->value,"range")==0) {
                /* python leaves the LAST value of the range in the loop variable,
                 * a C `for (i = 0; i < n; i++)` leaves the bound.  The C emitter
                 * compensates, so it has to tell a range loop from a C-style one
                 * parsed out of .dry/java source (identical IR shape). */
                d_strcpy(f->data_type, "RANGE");
                IRNode* init = ir_new("ASSIGN", "=", "ANY");
                ir_add_child(init, ir_new("IDENTIFIER", var, "INT"));
                IRNode* start = iter->nchildren>1 ? iter->children[0] : ir_new("CONSTANT","0","INT");
                ir_add_child(init, start);
                ir_add_child(f, init);
                /* a negative constant step counts down (range(10,0,-2)) */
                IRNode* stepv = iter->nchildren>2 ? iter->children[2] : NULL;
                int negstep = 0;
                if (stepv) {
                    if (d_strcmp(stepv->type,"CONSTANT")==0 && stepv->value[0]==45) negstep = 1;
                    else if (d_strcmp(stepv->type,"UNARY_OP")==0 && d_strcmp(stepv->value,"-")==0) negstep = 1;
                }
                IRNode* cond = ir_new("BINARY_OP", negstep ? ">" : "<", "ANY");
                ir_add_child(cond, ir_new("IDENTIFIER", var, "INT"));
                IRNode* end = iter->nchildren>1 ? iter->children[1] : iter->children[0];
                ir_add_child(cond, end);
                ir_add_child(f, cond);
                IRNode* nxt = ir_new("ASSIGN", "=", "ANY");
                ir_add_child(nxt, ir_new("IDENTIFIER", var, "INT"));
                IRNode* add = ir_new("BINARY_OP", "+", "ANY");
                ir_add_child(add, ir_new("IDENTIFIER", var, "INT"));
                IRNode* step = iter->nchildren>2 ? iter->children[2] : ir_new("CONSTANT","1","INT");
                ir_add_child(add, step);
                ir_add_child(nxt, add);
                ir_add_child(f, nxt);
            } else {
                /* iterator loop */
                ir_add_child(f, tgt ? tgt : ir_new("IDENTIFIER", var, "ANY"));
                if (iter) ir_add_child(f, iter);
            }
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
            if (pk(p)->kind == TOK_INDENT) advance(p);
            IRNode* body = ir_new("BLOCK", "", "ANY");
            parse_block(p, body);
            ir_add_child(f, body);
            /* `for ... else:` -- same skip-on-break semantics as the while form. */
            if (is_kw(p,"else")) {
                advance(p);
                if (pk(p)->kind == TOK_COLON) advance(p);
                while (pk(p)->kind == TOK_NEWLINE) advance(p);
                IRNode* eb = ir_new("ELSE_BLOCK", "", "ANY");
                IRNode* ebody = ir_new("BLOCK", "", "ANY");
                if (pk(p)->kind == TOK_INDENT) { advance(p); parse_block(p, ebody); }
                else { IRNode* s4 = py_comp_stmt(parse_stmt(p)); if (s4) ir_add_child(ebody, s4); }
                ir_add_child(eb, ebody);
                ir_add_child(f, eb);
            }
            return f;
        }
        /* return expr */
        if (is_kw(p,"return")) {
            advance(p);
            IRNode* r = ir_new("RETURN", "", "ANY");
            if (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_DEDENT) {
                IRNode* e = parse_expr(p);
                if (e && pk(p)->kind == TOK_COMMA) {
                    /* `return a, b` (no parens) — fold the comma list into a
                     * tuple block so it takes the same multi-value return path
                     * as the parenthesized form */
                    IRNode* tup = ir_new("BLOCK","TUPLE","ANY");
                    ir_add_child(tup, e);
                    while (pk(p)->kind == TOK_COMMA) {
                        advance(p);
                        if (pk(p)->kind == TOK_NEWLINE || pk(p)->kind == TOK_EOF || pk(p)->kind == TOK_DEDENT) break;
                        IRNode* x = parse_expr(p);
                        if (x) ir_add_child(tup, x);
                    }
                    e = tup;
                }
                if (e) ir_add_child(r, e);
            }
            return r;
        }
        /* raise [expr] — pending-flag exception runtime */
        if (is_kw(p,"raise")) {
            advance(p);
            IRNode* r = ir_new("RAISE","","ANY");
            if (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_DEDENT) {
                IRNode* e = parse_expr(p);
                if (e) ir_add_child(r, e);
            }
            return r;
        }
        /* break / continue / pass */
        if (is_kw(p,"break")) { advance(p); return ir_new("BREAK","","ANY"); }
        /* assert expr[, expr] — AssertionError when the condition is false */
        if (is_kw(p,"assert")) {
            advance(p);
            IRNode* r = ir_new("ASSERT","","ANY");
            if (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF && pk(p)->kind != TOK_DEDENT) {
                IRNode* e = parse_expr(p);
                if (e) ir_add_child(r, e);
            }
            if (pk(p)->kind == TOK_COMMA) {
                advance(p);
                IRNode* m = parse_expr(p);
                if (m) ir_add_child(r, m);
            }
            return r;
        }
        if (is_kw(p,"continue")) { advance(p); return ir_new("CONTINUE","","ANY"); }
        if (is_kw(p,"pass")) { advance(p); return ir_new("PASS","","ANY"); }
        if (is_kw(p,"del")) {
            advance(p);
            IRNode* r = ir_new("DEL","","ANY");
            IRNode* e = parse_expr(p);
            if (e) ir_add_child(r, e);
            return r;
        }
        /* import / from */
        if (is_kw(p,"import")) {
            advance(p);
            if (pk(p)->kind == TOK_NAME) {
                char mname[128];
                d_strncpy(mname, pk(p)->text, 127); mname[127] = 0;
                while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) advance(p);
                IRNode* mod = load_py_module(mname);
                if (mod) return mod;
                /* An UNKNOWN module raises ImportError so a
                 * `try/except ImportError` can catch it (16_exceptions 29);
                 * a known stdlib name stays a benign no-op. */
                if (!cg_is_stdlib_module(mname))
                    return ir_new("IMPORT_MISSING", mname, "ANY");
            } else {
                while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) advance(p);
            }
            return ir_new("IMPORT","","ANY");
        }
        if (is_kw(p,"from")) {
            advance(p);
            while (pk(p)->kind == TOK_DOT) advance(p);
            if (pk(p)->kind == TOK_NAME) {
                char mname[128];
                d_strncpy(mname, pk(p)->text, 127); mname[127] = 0;
                while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) advance(p);
                IRNode* mod = load_py_module(mname);
                if (mod) return mod;
            } else {
                while (pk(p)->kind != TOK_NEWLINE && pk(p)->kind != TOK_EOF) advance(p);
            }
            return ir_new("IMPORT","","ANY");
        }
        /* try / except / finally */
        if (is_kw(p,"try")) {
            advance(p);
            if (pk(p)->kind == TOK_COLON) advance(p);
            while (pk(p)->kind == TOK_NEWLINE) advance(p);
            if (pk(p)->kind == TOK_INDENT) advance(p);
            IRNode* tr = ir_new("TRY","","ANY");
            IRNode* body = ir_new("BLOCK","","ANY");
            parse_block(p, body);
            ir_add_child(tr, body);
            while (is_kw(p,"except")||is_kw(p,"finally")) {
                int isfin = is_kw(p,"finally");
                advance(p);
                char extype[64]; extype[0]=0;
                char asname[64]; asname[0]=0;
                if (pk(p)->kind == TOK_LPAREN) {
                    /* `except (ImportError, ModuleNotFoundError):` -- a TUPLE of
                     * types.  Previously the parenthesised form was skipped, so
                     * the clause lost its type entirely and never matched. */
                    advance(p);
                    int _el = 0;
                    while (pk(p)->kind != TOK_RPAREN && pk(p)->kind != TOK_EOF) {
                        if (pk(p)->kind == TOK_NAME) {
                            if (_el > 0 && _el < 62) { extype[_el] = 44; _el++; }
                            int _ec = 0;
                            while (_ec < 20 && pk(p)->text[_ec] && _el < 62) {
                                extype[_el] = pk(p)->text[_ec]; _el++; _ec++;
                            }
                            extype[_el] = 0;
                        }
                        advance(p);
                    }
                    if (pk(p)->kind == TOK_RPAREN) advance(p);
                } else if (pk(p)->kind == TOK_NAME) {
                    d_strncpy(extype, pk(p)->text, 63); extype[63]=0; advance(p);
                    /* `except module.Exc:` -- only the class NAME is matched
                     * (`pyx_is` compares class names), and leaving the dotted
                     * tail unconsumed made the whole clause unparseable
                     * (49_subprocess). */
                    while (pk(p)->kind == TOK_DOT) {
                        advance(p);
                        if (pk(p)->kind != TOK_NAME) break;
                        d_strncpy(extype, pk(p)->text, 63); extype[63]=0;
                        advance(p);
                    }
                }
                if (is_kw(p,"as") || (pk(p)->kind == TOK_NAME && d_strcmp(pk(p)->text, "as")==0)) {
                    advance(p);
                    if (pk(p)->kind == TOK_NAME) { d_strncpy(asname, pk(p)->text, 63); asname[63]=0; advance(p); }
                }
                if (pk(p)->kind == TOK_COLON) advance(p);
                while (pk(p)->kind == TOK_NEWLINE) advance(p);
                if (pk(p)->kind == TOK_INDENT) advance(p);
                IRNode* h = ir_new("BLOCK", isfin ? "FINALLY" : extype, asname[0] ? asname : "ANY");
                parse_block(p, h);
                ir_add_child(tr, h);
            }
            return tr;
        }
        /* assignment: target = expr  (or annotated: target: type = expr) */
        int save = p->ts->pos;
        int start_star = 0;
        if (t->kind == TOK_OP && d_strcmp(t->text, "*") == 0 && pk2(p)->kind == TOK_NAME) {
            advance(p);
            t = pk(p);
            start_star = 1;
        }
        if (t->kind == TOK_NAME) {
            char lhs[128]; d_strncpy(lhs, t->text, 127); lhs[127]='\0';
            advance(p);
            /* build the target node (handles self->name, obj.attr, arr[i]) */
            IRNode* target = ir_new("IDENTIFIER", lhs, start_star ? "STAR" : "ANY");
            while (pk(p)->kind == TOK_LBRACK || pk(p)->kind == TOK_DOT) {
                if (pk(p)->kind == TOK_LBRACK) {
                    advance(p);
                    IRNode* acc = ir_new("ARRAY_ACCESS","","ANY");
                    ir_add_child(acc, target);
                    IRNode* idx = parse_expr(p);
                    if (idx) ir_add_child(acc, idx);
                    if (pk(p)->kind==TOK_RBRACK) advance(p);
                    target = acc;
                } else {
                    advance(p);
                    if (pk(p)->kind==TOK_NAME) {
                        IRNode* ma = ir_new("MEMBER_ACCESS", pk(p)->text, ".");
                        ir_add_child(ma, target);
                        advance(p);
                        target = ma;
                    }
                }
            }
            /* lambda assignment: `f = lambda x: e` becomes a named fn */
            if (pk(p)->kind == TOK_EQ &&
                p->ts->pos + 1 < p->ts->n &&
                p->ts->toks[p->ts->pos + 1].kind == TOK_KEYWORD &&
                d_strcmp(p->ts->toks[p->ts->pos + 1].text,"lambda")==0 &&
                d_strcmp(target->type,"IDENTIFIER")==0) {
