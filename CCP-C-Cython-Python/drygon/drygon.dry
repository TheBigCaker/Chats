                    if (crc) {
                        const char* ct2 = cg_temp_recv_cls(crc);
                        if (ct2) {
                            int cmt2 = cg_cls_mret_find(ct2, a->children[0]->value, 0);
                            if (cmt2 >= 0) return cmt2 == 2;
                        }
                    }
                    return cg_is_str_method_ret(a->children[0]->value);
