                        cg_sw_serial = cg_sw_serial + 1;
                        int xr = cg_sw_serial;
                        cg_indent(g);
                        cg_put(g, "{ int _xk"); cg_put_int(g, xr);
                        cg_put(g, " = 0; while (_xk"); cg_put_int(g, xr);
                        cg_put(g, " < "); cg_put(g, lfsc); cg_put(g, " && _xk"); cg_put_int(g, xr);
                        cg_put(g, " < 64) { ");
                        cg_lf_put(g, lrecv, lfx); cg_put(g, "[");
                        cg_lf_put(g, lrecv, lfx); cg_put(g, "_n] = ");
                        cg_gen_expr(g, arhs); cg_put(g, "[_xk"); cg_put_int(g, xr); cg_put(g, "]; ");
                        cg_lf_put(g, lrecv, lfx); cg_put(g, "_n = ");
                        cg_lf_put(g, lrecv, lfx); cg_put(g, "_n + 1; _xk");
