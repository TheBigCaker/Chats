    /* Fast vectorized exp(x) via the 2^(x*log2e) bit-trick + degree-6
     * polynomial. Relative error ~1e-3, fine for silu/gelu/softmax where
     * the softmax normalization cancels absolute error. */
    #ifdef __ARM_NEON
    static inline float32x4_t vexpq_f32_approx(float32x4_t x) {
        float32x4_t a = vmulq_f32(x, vdupq_n_f32(1.4426950408889634f));
        float32x4_t b = vaddq_f32(a, vdupq_n_f32(127.0f));
        b = vmaxq_f32(b, vdupq_n_f32(0.0f));
        b = vminq_f32(b, vdupq_n_f32(255.0f));
        int32x4_t i = vcvtmq_s32_f32(b);   /* floor */
        float32x4_t f = vsubq_f32(b, vcvtq_f32_s32(i));
        float32x4_t p = vdupq_n_f32(0.000154035f);   /* c6 */
        p = vmlaq_f32(vdupq_n_f32(0.0013333558f), f, p);  /* c5 + f*c6 */
        p = vmlaq_f32(vdupq_n_f32(0.0096181291f), f, p);  /* c4 + f*(...) */
        p = vmlaq_f32(vdupq_n_f32(0.055504108f), f, p);   /* c3 + f*(...) */
        p = vmlaq_f32(vdupq_n_f32(0.240226507f), f, p);   /* c2 + f*(...) */
        p = vmlaq_f32(vdupq_n_f32(0.693147180f), f, p);   /* c1 + f*(...) */
        p = vmlaq_f32(vdupq_n_f32(1.0f), f, p);           /* c0 + f*(...) */
        int32x4_t e = vshlq_n_s32(i, 23);
        return vmulq_f32(p, vreinterpretq_f32_s32(e));
    }
    #endif
    static inline void neon_silu(float *dst, const float *a, int n) {
        #ifdef __ARM_NEON
        int i = 0;
        for (; i <= n - 4; i += 4) {
            float32x4_t av = vld1q_f32(a + i);
            float32x4_t e = vexpq_f32_approx(vnegq_f32(av));
            float32x4_t den = vaddq_f32(vdupq_n_f32(1.0f), e);
            vst1q_f32(dst + i, vdivq_f32(av, den));
        }
        for (; i < n; i++) dst[i] = a[i] / (1.0f + ccp_expf(-a[i]));
        #endif
    }
    static inline void neon_gelu(float *dst, const float *a, int n) {
        #ifdef __ARM_NEON
        int i = 0;
        for (; i <= n - 4; i += 4) {
            float32x4_t av = vld1q_f32(a + i);
            float32x4_t x3 = vmulq_f32(vmulq_f32(av, av), av);
            float32x4_t inner = vmlaq_f32(av, vdupq_n_f32(0.044715f), x3);
            float32x4_t t = vmulq_f32(vdupq_n_f32(0.7978845608f), inner);
            float32x4_t e = vexpq_f32_approx(vmulq_f32(vdupq_n_f32(-2.0f), t));
            float32x4_t th = vsubq_f32(vdivq_f32(vdupq_n_f32(2.0f), vaddq_f32(vdupq_n_f32(1.0f), e)), vdupq_n_f32(1.0f));
            vst1q_f32(dst + i, vmulq_f32(vmulq_f32(vdupq_n_f32(0.5f), av), vaddq_f32(vdupq_n_f32(1.0f), th)));
        }
        for (; i < n; i++) {
            float x = a[i];
            float x3 = x * x * x;
            dst[i] = 0.5f * x * (1.0f + ccp_tanhf(0.7978845608f * (x + 0.044715f * x3)));
        }
        #endif
    }
    /* ---- NEON-vectorized reductions ----
     * Multi-accumulator reductions: 4 independent accumulators let the
     * CPU overlap 4 chains && hit memory bandwidth. Combined once at the
     * end. */
    static inline float neon_sum(const float *a, int n) {
        #ifdef __ARM_NEON
        float32x4_t a0 = vdupq_n_f32(0.0f), a1 = vdupq_n_f32(0.0f);
        float32x4_t a2 = vdupq_n_f32(0.0f), a3 = vdupq_n_f32(0.0f);
        int i = 0;
        for (; i <= n - 16; i += 16) {
            a0 = vaddq_f32(a0, vld1q_f32(a + i));
            a1 = vaddq_f32(a1, vld1q_f32(a + i + 4));
            a2 = vaddq_f32(a2, vld1q_f32(a + i + 8));
            a3 = vaddq_f32(a3, vld1q_f32(a + i + 12));
        }
        a0 = vaddq_f32(vaddq_f32(a0, a1), vaddq_f32(a2, a3));
        float s = vaddvq_f32(a0);
        for (; i < n; i++) s += a[i];
        return s;
        #endif
    }
    static inline float neon_dot(const float *a, const float *b, int n) {
        #ifdef __ARM_NEON
        float32x4_t a0 = vdupq_n_f32(0.0f), a1 = vdupq_n_f32(0.0f);
        float32x4_t a2 = vdupq_n_f32(0.0f), a3 = vdupq_n_f32(0.0f);
        int i = 0;
        for (; i <= n - 16; i += 16) {
            a0 = vmlaq_f32(a0, vld1q_f32(a + i), vld1q_f32(b + i));
            a1 = vmlaq_f32(a1, vld1q_f32(a + i + 4), vld1q_f32(b + i + 4));
            a2 = vmlaq_f32(a2, vld1q_f32(a + i + 8), vld1q_f32(b + i + 8));
            a3 = vmlaq_f32(a3, vld1q_f32(a + i + 12), vld1q_f32(b + i + 12));
        }
        a0 = vaddq_f32(vaddq_f32(a0, a1), vaddq_f32(a2, a3));
        float s = vaddvq_f32(a0);
        for (; i < n; i++) s += a[i] * b[i];
        return s;
        #endif
    }
    static inline float neon_max(const float *a, int n) {
        #ifdef __ARM_NEON
        float32x4_t a0 = vld1q_f32(a), a1 = vld1q_f32(a + 4);
        float32x4_t a2 = vld1q_f32(a + 8), a3 = vld1q_f32(a + 12);
        int i = 16;
        for (; i <= n - 16; i += 16) {
            a0 = vmaxq_f32(a0, vld1q_f32(a + i));
            a1 = vmaxq_f32(a1, vld1q_f32(a + i + 4));
            a2 = vmaxq_f32(a2, vld1q_f32(a + i + 8));
            a3 = vmaxq_f32(a3, vld1q_f32(a + i + 12));
        }
        a0 = vmaxq_f32(vmaxq_f32(a0, a1), vmaxq_f32(a2, a3));
        float v = vmaxvq_f32(a0);
        for (; i < n; i++) if (a[i] > v) v = a[i];
        return v;
        #endif
    }
    static inline float neon_min(const float *a, int n) {
        #ifdef __ARM_NEON
        float32x4_t a0 = vld1q_f32(a), a1 = vld1q_f32(a + 4);
        float32x4_t a2 = vld1q_f32(a + 8), a3 = vld1q_f32(a + 12);
        int i = 16;
        for (; i <= n - 16; i += 16) {
            a0 = vminq_f32(a0, vld1q_f32(a + i));
            a1 = vminq_f32(a1, vld1q_f32(a + i + 4));
            a2 = vminq_f32(a2, vld1q_f32(a + i + 8));
            a3 = vminq_f32(a3, vld1q_f32(a + i + 12));
        }
        a0 = vminq_f32(vminq_f32(a0, a1), vminq_f32(a2, a3));
        float v = vminvq_f32(a0);
        for (; i < n; i++) if (a[i] < v) v = a[i];
        return v;
        #endif
    }
    static inline float neon_absmax(const float *a, int n) {
        #ifdef __ARM_NEON
        float32x4_t a0 = vabsq_f32(vld1q_f32(a)), a1 = vabsq_f32(vld1q_f32(a + 4));
        float32x4_t a2 = vabsq_f32(vld1q_f32(a + 8)), a3 = vabsq_f32(vld1q_f32(a + 12));
        int i = 16;
        for (; i <= n - 16; i += 16) {
            a0 = vmaxq_f32(a0, vabsq_f32(vld1q_f32(a + i)));
            a1 = vmaxq_f32(a1, vabsq_f32(vld1q_f32(a + i + 4)));
            a2 = vmaxq_f32(a2, vabsq_f32(vld1q_f32(a + i + 8)));
            a3 = vmaxq_f32(a3, vabsq_f32(vld1q_f32(a + i + 12)));
        }
        a0 = vmaxq_f32(vmaxq_f32(a0, a1), vmaxq_f32(a2, a3));
        float v = vmaxvq_f32(a0);
        for (; i < n; i++) { float x = (a[i] < 0.0f) ? -a[i] : a[i]; if (x > v) v = x; }
        return v;
        #endif
    }
    /* Softmax phase 1: dst[i] = exp(src[i] - max); returns local sum. */
    static inline float neon_exp_sub(float *dst, const float *src, float max, int n) {
        #ifdef __ARM_NEON
        float32x4_t mv = vdupq_n_f32(max);
        float32x4_t acc = vdupq_n_f32(0.0f);
        int i = 0;
        for (; i <= n - 4; i += 4) {
            float32x4_t e = vexpq_f32_approx(vsubq_f32(vld1q_f32(src + i), mv));
            vst1q_f32(dst + i, e);
            acc = vaddq_f32(acc, e);
        }
        float s = 0.0f;
        for (; i < n; i++) { dst[i] = ccp_expf(src[i] - max); s += dst[i]; }
        float32x2_t lo = vget_low_f32(acc);
        float32x2_t hi = vget_high_f32(acc);
        lo = vadd_f32(lo, hi);
        lo = vpadd_f32(lo, lo);
        return vget_lane_f32(lo, 0) + s;
        #endif
    }
    /* Softmax phase 2: dst[i] /= s. */
    static inline void neon_div_scalar(float *dst, float s, int n) {
        #ifdef __ARM_NEON
        float32x4_t sv = vdupq_n_f32(s);
        int i = 0;
        for (; i <= n - 4; i += 4) vst1q_f32(dst + i, vdivq_f32(vld1q_f32(dst + i), sv));
        for (; i < n; i++) dst[i] /= s;
        #endif
    }
