     * module's definitions are now plain file-scope names, while `name.member`
     * compiled to a call through an unresolved target and trapped. */
    static int cg_mod_is_loaded(const char* nm) {
        int i = 0;
        if (!nm || !nm[0]) return 0;
        while (i < py_nmod_loaded) {
            if (d_strcmp(py_mod_loaded + i*64, nm) == 0) return 1;
            i++;
        }
        return 0;
    }
    /* Parse a comma-separated argument/expression list until a closing token. */
    static void parse_arg_list(PyParser* p, IRNode* call_node, TokKind close) {
        while (pk(p)->kind != close && pk(p)->kind != TOK_EOF) {
            /* `f(**kwargs)` / `f(*args)`: a leading `*`/`**` is UNPACKING, not
             * the multiply/deref operators.  Letting parse_expr see it produced
             * `drygon_pow(g(, 0)` -- unparseable C -- because `**` was lowered
             * as exponentiation and the star ate the callee. */
            if (pk(p)->kind == TOK_OP &&
                (d_strcmp(pk(p)->text,"**")==0 || d_strcmp(pk(p)->text,"*")==0)) {
                int dst = (d_strcmp(pk(p)->text,"**")==0);
                advance(p);
                IRNode* ua = parse_expr(p);
                IRNode* un = ir_new(dst ? "DSTAR_KW" : "STAR_ARG", "", "ANY");
                if (ua) ir_add_child(un, ua);
                ir_add_child(call_node, un);
                if (pk(p)->kind == TOK_COMMA) advance(p);
                else if (pk(p)->kind == TOK_NEWLINE) advance(p);
                continue;
            }
            IRNode* a = parse_expr(p);
            /* a GENERATOR EXPRESSION as the sole argument: `list(x*2 for x in
             * r)` / `sum(v for v in xs)`.  Without this the element parsed and
             * the `for` clause was left unconsumed, so the call got `(x * 2)`
             * and produced nothing (20_advanced check 3). */
            if (is_kw(p,"for") || is_kw(p,"if")) {
                IRNode* comp = py_comp_new(a, p);
                ir_add_child(call_node, comp);
                if (pk(p)->kind == TOK_COMMA) advance(p);
                continue;
            }
            /* keyword argument: `name=value` inside a call */
            if (a && d_strcmp(a->type,"IDENTIFIER")==0 && pk(p)->kind == TOK_EQ) {
                advance(p);
                IRNode* kw = ir_new("KWARG", a->value, "ANY");
                if (pk(p)->kind == TOK_KEYWORD &&
                    d_strcmp(pk(p)->text,"lambda")==0) {
                    /* `key=lambda t: t[i]` — the sort machinery only needs the
                     * body expression (an element index), so the lambda
                     * wrapper is dropped here */
                    advance(p);
                    while (pk(p)->kind == TOK_NAME) advance(p);
                    if (pk(p)->kind == TOK_COLON) advance(p);
                    IRNode* lbody = parse_expr(p);
                    if (lbody) ir_add_child(kw, lbody);
                } else {
                    IRNode* kv = parse_expr(p);
                    if (kv) ir_add_child(kw, kv);
                }
                a = kw;
            }
            if (a) ir_add_child(call_node, a);
            if (pk(p)->kind == TOK_COMMA) advance(p);
            else break;
        }
        if (pk(p)->kind == close) advance(p);
    }
    /* ── list comprehensions ──────────────────────────────────────────────
