    p[1488] = "int drygon_fm_keysame(char* a, char* s, int j, int e) {\nint q = 0;\nwhile (j + q < e) { if (a[q] != s[j + q]) return 0; q = q + 1; }\nif (a[q] != 0) return 0;\nreturn 1;\n}\n";
    /* `"...".format_map(d)`: the dict literal is materialised as a key array,
