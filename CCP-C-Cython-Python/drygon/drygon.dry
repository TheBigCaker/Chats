    static void cg_sl_copy(CGen* g, const IRNode* sl, const char* dst) {
        const IRNode* b = sl->children[0];
        int et = cg_sl_base_et(sl);
        /* A slice of a *list parameter* can alias its own temp: the recursion
         * `sum_list(lst[1:], acc + lst[0])` passes the temp itself as the next
         * `lst`, so filling the temp in place destroyed `lst[0]` before the
         * same statement read it (11_functions check 60 printed 18 for 15).
         * Such a slice gets a function LOCAL backing array shadowing the
         * file-scope temp: every invocation keeps its own storage, so the
         * callee shifts a copy of the caller's buffer instead of the buffer
         * the caller still holds a pointer into.  A plain list variable can
         * never alias a temp (both are distinct file-scope arrays), so only
         * parameters take this path. */
        if (dst && dst[0] == '_' && dst[1] == 'd' && dst[2] == 'y' && dst[3] == 's' &&
            dst[4] == 'q' && b && d_strcmp(b->type,"IDENTIFIER")==0 &&
            cg_is_lparam(b->value)) {
            cg_indent(g);
            cg_put(g, "int "); cg_put(g, dst); cg_put(g, "[64]; int ");
            cg_put(g, dst); cg_put(g, "_n;\n");
        }
        /* `sorted(xs, key=cmp_to_key(f))` carries the comparator in child 1,
         * not a slice bound: the copy must run over the whole list. */
        int isck = (d_strcmp(sl->value,"sorted_cmpk")==0);
        /* tuple rows: sorted()/slices copy per-row reprs instead of
         * materializing the rows themselves */
        if (et == 3) { cg_sl_tsort(g, sl, dst); return; }
        /* a list literal as the source: materialize its _dylit temp first and
         * copy from it; the source count is the literal's compile-time length
         * (literal temps have no runtime count variable) */
        int lk = (b && cg_is_list_node(b)) ? cg_lit_index(b) : -1;
        if (lk < 0 && b && cg_is_list_node(b)) lk = cg_lit_add(b);
        cg_indent(g);
        if (lk >= 0) cg_lit_fill_one(g, b, lk);
        if (sl->nchildren > 5) {
            cg_put(g, dst);
            cg_put(g, "_n = drygon_lslice_step_");
            cg_put(g, et == 2 ? "s" : (et == 1 ? "d" : "i"));
            cg_put(g, "(");
            cg_put(g, dst);
            cg_put(g, ", ");
            if (lk >= 0) cg_lit_put_name(g, lk);
            else cg_gen_expr(g, b);
            cg_put(g, ", ");
            if (lk >= 0) {
                int lsz = b->nchildren;
                if (lsz <= 0) lsz = 1;
                cg_put_int(g, lsz);
            } else { cg_gen_expr(g, b); cg_put(g, "_n"); }
            cg_put(g, ", ");
            cg_gen_expr(g, sl->children[1]);
            cg_put(g, ", ");
            cg_gen_expr(g, sl->children[2]);
            cg_put(g, ", ");
            cg_gen_expr(g, sl->children[3]);
            cg_put(g, ", ");
            cg_gen_expr(g, sl->children[4]);
            cg_put(g, ", ");
            cg_gen_expr(g, sl->children[5]);
            cg_put(g, ");\n");
        } else {
            int sstr = (et == 2 && b && d_strcmp(b->type,"CONSTANT")==0 &&
                        (d_strcmp(b->data_type,"STR")==0 || d_strcmp(b->data_type,"FSTR")==0));
            if (sstr) {
                /* `sorted("hello")` / a slice of a string constant: there is no
                 * runtime array to copy from, so build the char* source array
                 * from the literal (13_builtins check 74). */
                const char* sv = b->value;
                int slen = (int)d_strlen(sv);
                if (slen >= 2 && (sv[0]=='\'' || sv[0]=='"') &&
                    (sv[slen-1]=='\'' || sv[slen-1]=='"')) { sv = sv + 1; slen = slen - 2; }
                cg_put(g, "{\n");
                cg_indent(g);
                cg_put(g, "char* _slcs");
                cg_put(g, dst);
                cg_put(g, "[");
                cg_put_int(g, slen + 1);
                cg_put(g, "];\n");
                int k = 0;
                while (k < slen) {
                    char sc[4];
                    int nsc = 0;
                    if (sv[k] == '"' || sv[k] == 92) { sc[nsc] = 92; nsc++; }
                    sc[nsc] = sv[k]; nsc++;
                    sc[nsc] = 0;
                    cg_indent(g);
                    cg_put(g, "_slcs");
                    cg_put(g, dst);
                    cg_put(g, "[");
                    cg_put_int(g, k);
                    cg_put(g, "] = \"");
                    cg_put(g, sc);
                    cg_put(g, "\";\n");
                    k++;
                }
                cg_indent(g);
                cg_put(g, dst);
                cg_put(g, "_n = drygon_lslice_s(");
                cg_put(g, dst);
                cg_put(g, ", _slcs");
                cg_put(g, dst);
                cg_put(g, ", ");
                cg_put_int(g, slen);
                cg_put(g, ", 0, 2147483647);\n");
                cg_indent(g);
                cg_put(g, "}\n");
            } else {
            cg_put(g, dst);
            cg_put(g, "_n = drygon_lslice_");
            cg_put(g, et == 2 ? "s" : (et == 1 ? "d" : "i"));
            cg_put(g, "(");
            cg_put(g, dst);
            cg_put(g, ", ");
            if (lk >= 0) cg_lit_put_name(g, lk);
            else cg_gen_expr(g, b);
            cg_put(g, ", ");
            if (lk >= 0) {
                int lsz = b->nchildren;
                if (lsz <= 0) lsz = 1;
                cg_put_int(g, lsz);
            } else { cg_gen_expr(g, b); cg_put(g, "_n"); }
            cg_put(g, ", ");
            /* a KWARG child is NOT a slice bound: emitting it put its name
             * (`key`) into the call as a bare C identifier -> UNRESOLVED: key. */
            if (sl->nchildren>1 && sl->children[1] &&
                d_strcmp(sl->children[1]->type,"KWARG")!=0 && !isck) cg_gen_expr(g, sl->children[1]);
            else cg_put(g, "0");
            cg_put(g, ", ");
            if (sl->nchildren>2 && sl->children[2] &&
                d_strcmp(sl->children[2]->type,"KWARG")!=0 && !isck) cg_gen_expr(g, sl->children[2]);
            else cg_put(g, "2147483647");
            cg_put(g, ");\n");
            }
        }
        if (cg_sl_issorted(sl)) {
            /* reversed(xs) skips the sort: the copy is reversed in place below. */
            if (d_strcmp(sl->value,"reversed")==0) {
                cg_indent(g);
                /* drygon_lrev_* is in-place and returns void: call it as a
                 * statement, never as part of an assignment to _n */
                cg_put(g, "drygon_lrev_");
                cg_put(g, et == 2 ? "str" : (et == 1 ? "dbl" : "int"));
                cg_put(g, "(");
                cg_put(g, dst);
                cg_put(g, ", ");
                cg_put(g, dst);
                cg_put(g, "_n);\n");
            } else if (d_strcmp(sl->value,"sorted_cmpk")==0 && et == 0 &&
                       sl->nchildren > 1 && sl->children[1] &&
                       d_strcmp(sl->children[1]->type,"IDENTIFIER")==0) {
            /* `sorted(xs, key=cmp_to_key(f))`: the comparator's name is known
             * right here, so emit the insertion sort inline and call it
             * directly -- no function pointer, which the C front-end cannot
             * spell (26_functools check 23). */
            cg_indent(g);
            cg_put(g, "{ int _sk = 1; while (_sk < ");
            cg_put(g, dst);
            cg_put(g, "_n) { int _sval = ");
            cg_put(g, dst);
            cg_put(g, "[_sk]; int _sj = _sk - 1; while (_sj >= 0 && ");
            cg_put(g, sl->children[1]->value);
            cg_put(g, "(");
            cg_put(g, dst);
            cg_put(g, "[_sj], _sval) > 0) { ");
            cg_put(g, dst);
            cg_put(g, "[_sj + 1] = ");
            cg_put(g, dst);
            cg_put(g, "[_sj]; _sj = _sj - 1; } ");
            cg_put(g, dst);
            cg_put(g, "[_sj + 1] = _sval; _sk = _sk + 1; } }\n");
            } else {
            cg_indent(g);
            cg_put(g, dst);
            cg_put(g, "_n = drygon_sort_");
            cg_put(g, et == 2 ? "s" : (et == 1 ? "d" : "i"));
            cg_put(g, "(");
            cg_put(g, dst);
            cg_put(g, ", ");
            cg_put(g, dst);
            cg_put(g, "_n);\n");
            if (d_strcmp(sl->value,"sorted_r")==0) {
                cg_indent(g);
                /* drygon_lrev_* is in-place and returns void: call it as a
                 * statement, never as part of an assignment to _n */
                cg_put(g, "drygon_lrev_");
                cg_put(g, et == 2 ? "str" : (et == 1 ? "dbl" : "int"));
                cg_put(g, "(");
                cg_put(g, dst);
                cg_put(g, ", ");
                cg_put(g, dst);
                cg_put(g, "_n);\n");
            }
            }
        }
    }
    /* `name = xs[a:b]` copies straight into `name`, so the result is a normal
     * python list held by that name; no slice temp is involved. */
    static int cg_sl_assign_target(const IRNode* n) {
        if (!n || d_strcmp(n->type,"ASSIGN")!=0 || n->nchildren<2) return 0;
        if (!n->children[0] || d_strcmp(n->children[0]->type,"IDENTIFIER")!=0) return 0;
        /* `xs = sorted(d)` is handled by the dict-sort path, which copies the
         * sorted keys; treating it as a slice would emit a bogus
         * `drygon_lslice_i(xs, d, d_n, 0, MAX)` and destroy the sort. */
        if (cg_sl_isdictsorted(n->children[1])) return 0;
        return cg_sl_islice(n->children[1]);
    }
    /* Fill the backing array of every list slice the statement `n` needs,
     * once, immediately before that statement. */
    /* Name of the temp holding sorted(dict) keys: the dict's own name + "_s". */
    static const char* cg_dict_sort_name(const char* dn) {
        static char dsn[64];
        int i = 0;
        while (dn[i] && i < 40) { dsn[i] = dn[i]; i = i + 1; }
        dsn[i] = 95; i = i + 1; dsn[i] = 115; i = i + 1; dsn[i] = 0;
        return dsn;
    }
    /* Emit the key-copy + insertion sort for `sorted(dict)`.  This MUST run at
     * statement level (via cg_sl_fill): an expression-context sort would emit
     * declarations and loops inside a printf argument list and the generated C
     * would not parse. */
    static int cg_dict_sort_emit(CGen* g, const IRNode* n) {
        if (!n || d_strcmp(n->type,"CALL")!=0) return 0;
        int rev = d_strcmp(n->value,"sorted_r")==0;
        if (d_strcmp(n->value,"sorted")!=0 && !rev) return 0;
        if (n->nchildren != 1) return 0;
        const IRNode* b = n->children[0];
        if (!b) return 0;
        /* The source is either the dict itself or one of its views: `sorted(d)`
         * yields the keys, `sorted(d.keys())` the same and `sorted(d.values())`
         * the values, so the copy reads whichever parallel array applies. */
        char dnm[64];
        int dsel = 0;
        int dkf2 = 0;
        int dkf3 = 0;
        dnm[0] = 0;
        if (d_strcmp(b->type,"IDENTIFIER")==0) {
            if (!cg_is_dict(b->value)) return 0;
            int z = 0;
            while (b->value[z] && z < 63) { dnm[z] = b->value[z]; z = z + 1; }
            dnm[z] = 0;
            dkf2 = cg_dict_kf(dnm) ? 1 : 0;
        } else if (d_strcmp(b->type,"CALL")==0 && d_strcmp(b->value,"COMPLEX")==0 &&
                   cg_mcx_recv(b) && cg_mcx_meth(b)) {
            const IRNode* rc = cg_mcx_recv(b);
            if (!rc->value || d_strcmp(rc->type,"IDENTIFIER")!=0) return 0;
            if (!cg_is_dict(rc->value)) return 0;
            if (d_strcmp(cg_mcx_meth(b),"keys")==0) dsel = 1;
            else if (d_strcmp(cg_mcx_meth(b),"values")==0) dsel = 2;
            else return 0;
            int z = 0;
            while (rc->value[z] && z < 63) { dnm[z] = rc->value[z]; z = z + 1; }
            dnm[z] = 0;
            if (dsel == 1) dkf2 = cg_dict_kf(dnm) ? 1 : 0;
            else { int vf = cg_dict_vf(dnm); dkf2 = (vf == 2) ? 1 : 0; dkf3 = (vf == 1) ? 1 : 0; }
        } else return 0;
        /* the C spelling of the source array and its count */
        char sary[96];
        char scnt[96];
        {
            int z = 0;
            while (dnm[z] && z < 77) { sary[z] = dnm[z]; z = z + 1; }
            sary[z] = 95; z = z + 1;
            if (dsel == 2) { sary[z] = 118; z = z + 1; }
            else { sary[z] = 107; z = z + 1; }
            sary[z] = 0;
            z = 0;
            while (dnm[z] && z < 77) { scnt[z] = dnm[z]; z = z + 1; }
            scnt[z] = 95; z++;
            scnt[z] = 110; z++;
            scnt[z] = 0;
        }
        /* Idempotent: the temp for this exact call site is registered once, and
         * the copy/sort body must not be re-emitted on every prepass visit (it
         * was, so the generated C redeclared `_dysq0` inside main). */
        if (cg_slx_index(n) >= 0) return 1;
        int k = cg_sl_add(n, dkf2 ? 2 : (dkf3 ? 1 : 0));
        if (k < 0) return 0;
        if (dkf2) cg_note_strlist(cg_sl_name_of(k));
        char tn[64];
        { const char* tp = cg_sl_name_of(k); int z = 0; while (tp[z] && z < 63) { tn[z] = tp[z]; z = z + 1; } tn[z] = 0; }
        if (1) {
            /* The backing array and its count are declared at FILE scope by the
             * slice-temp declaration loop (cg_sl_add registered the name); only
             * the fill runs at statement level.  Declaring `_dysqK` here put a
             * second declaration inside main and broke the generated C. */
            cg_indent(g);
            cg_put(g, "int _dsk = 0; while (_dsk < "); cg_put(g, scnt); cg_put(g, ") { ");
            cg_put(g, tn); cg_put(g, "[_dsk] = "); cg_put(g, sary); cg_put(g, "[_dsk]; _dsk = _dsk + 1; }\n");
            cg_indent(g);
            cg_put(g, tn); cg_put(g, "_n = "); cg_put(g, scnt); cg_put(g, ";\n");
            cg_indent(g);
            cg_put(g, "int "); cg_put(g, tn); cg_put(g, "_i = 1; while ("); cg_put(g, tn); cg_put(g, "_i < "); cg_put(g, tn); cg_put(g, "_n) {\n");
            g->indent++;
            cg_indent(g);
            cg_put(g, dkf2 ? "char* _dskey = " : (dkf3 ? "double _dskey = " : "int _dskey = "));
            cg_put(g, tn); cg_put(g, "["); cg_put(g, tn); cg_put(g, "_i];\n");
            cg_indent(g);
            cg_put(g, "int _dsj = "); cg_put(g, tn); cg_put(g, "_i - 1;\n");
            cg_indent(g);
            cg_put(g, "while (_dsj >= 0 && (");
            if (dkf2) cg_put(g, "drygon_strcmp2(");
            cg_put(g, tn); cg_put(g, "[_dsj]");
            if (dkf2) cg_put(g, rev ? ", _dskey) < 0" : ", _dskey) > 0");
            else cg_put(g, rev ? " < _dskey" : " > _dskey");
            cg_put(g, ")) { "); cg_put(g, tn); cg_put(g, "[_dsj + 1] = "); cg_put(g, tn); cg_put(g, "[_dsj]; _dsj = _dsj - 1; }\n");
            cg_indent(g);
            cg_put(g, tn); cg_put(g, "[_dsj + 1] = _dskey;\n");
            cg_indent(g);
            cg_put(g, tn); cg_put(g, "_i = "); cg_put(g, tn); cg_put(g, "_i + 1;\n");
            g->indent--;
            cg_indent(g); cg_put(g, "}\n");
            cg_indent(g);
            cg_put(g, tn); cg_put(g, "_n = "); cg_put(g, scnt); cg_put(g, ";\n");
            if (dkf2) cg_note_strlist(tn);
            else cg_note_list(tn, 64, dkf3 ? 1 : 0);
            cg_sl_add(n, dkf2 ? 2 : (dkf3 ? 1 : 0));
        }
        return 1;
    }
    /* the statement prepasses (cg_lit_emit + the gen_node fill) visit the
     * same slice/sort nodes several times; each emitted target is recorded so
     * its copy block (and the header registration that goes with it) happens
     * exactly once */
    static const IRNode* cg_sl_filled[128];
    static int cg_sl_filled_n;
    static int cg_sl_filled_seen(const IRNode* n) {
        int i = 0;
        while (i < cg_sl_filled_n) { if (cg_sl_filled[i] == n) return 1; i++; }
        return 0;
    }
    /* `d = sorted(objs, key=operator.attrgetter("a"))` where objs is an OBJECT
     * list: the element slots are sentinels, so the sort copies every COLUMN
     * into d's own arrays and insertion-sorts d by the key column, permuting
     * all columns together.  Must run at statement level (via cg_sl_fill):
     * declarations and loops cannot appear inside a printf argument list. */
    static int cg_obj_sort_emit(CGen* g, const IRNode* n) {
        if (!n || d_strcmp(n->type,"ASSIGN")!=0 || n->nchildren<2) return 0;
        const IRNode* lhs = n->children[0];
        const IRNode* rhs = n->children[1];
        if (!lhs || d_strcmp(lhs->type,"IDENTIFIER")!=0) return 0;
        int di = cg_ob_reg_sort(lhs, rhs);
        if (di < 0) return 0;
        if (cg_sl_filled_seen(n)) return 1;
        cg_sl_filled[cg_sl_filled_n] = n;
        cg_sl_filled_n = cg_sl_filled_n + 1;
        const char* sn = rhs->children[0]->value;
        const char* dn = lhs->value;
        int sxs = cg_ob_lookup(sn);
        if (sxs < 0) sxs = di;
        int ncx = cg_ob_lncol[di];
        int ki = cg_ob_sort_key_col(rhs, dn);
        char nmk[16];
        char nmi[16];
        char nmj[16];
        char nmt[16];
        if (ki < 0) ki = 0;
        int sr = cg_ob_srl;
        cg_ob_srl = cg_ob_srl + 1;
        cg_ob_tmp(nmk, "_ob", sr, 107);
        cg_ob_tmp(nmi, "_ob", sr, 105);
        cg_ob_tmp(nmj, "_ob", sr, 106);
        cg_ob_tmp(nmt, "_ob", sr, 116);
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, nmk); cg_put(g, " = 0; while ("); cg_put(g, nmk);
        cg_put(g, " < "); cg_put(g, sn); cg_put(g, "_n) { ");
        int c = 0;
        while (c < ncx) {
            cg_put(g, cg_ob_lcn[di*8 + c]);
            cg_put(g, "["); cg_put(g, nmk); cg_put(g, "] = ");
            cg_put(g, cg_ob_lcn[sxs*8 + c]);
            cg_put(g, "["); cg_put(g, nmk); cg_put(g, "]; ");
            c++;
        }
        cg_put(g, nmk); cg_put(g, " = "); cg_put(g, nmk); cg_put(g, " + 1; }\n");
        cg_indent(g);
        cg_put(g, dn); cg_put(g, "_n = "); cg_put(g, sn); cg_put(g, "_n;\n");
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, nmj); cg_put(g, " = 0; while ("); cg_put(g, nmj);
        cg_put(g, " + 1 < "); cg_put(g, dn); cg_put(g, "_n) {\n");
        g->indent = g->indent + 1;
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, nmi); cg_put(g, " = "); cg_put(g, nmj); cg_put(g, " + 1;\n");
        cg_indent(g);
        cg_put(g, "while ("); cg_put(g, nmi); cg_put(g, " > 0 && ");
        if (cg_ob_lkind[di*8 + ki] == 2) {
            cg_put(g, "drygon_strcmp2(");
            cg_put(g, cg_ob_lcn[di*8 + ki]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, " - 1], ");
            cg_put(g, cg_ob_lcn[di*8 + ki]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, "]) > 0");
        } else {
            cg_put(g, cg_ob_lcn[di*8 + ki]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, " - 1] > ");
            cg_put(g, cg_ob_lcn[di*8 + ki]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, "]");
        }
        cg_put(g, ") {\n");
        g->indent = g->indent + 1;
        c = 0;
        while (c < ncx) {
            cg_indent(g);
            cg_put(g, cg_ob_lkind[di*8 + c] == 2 ? "char* " :
                       (cg_ob_lkind[di*8 + c] == 3 ? "double " : "int "));
            cg_put(g, nmt); cg_put_int(g, c);
            cg_put(g, " = ");
            cg_put(g, cg_ob_lcn[di*8 + c]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, " - 1]; ");
            cg_put(g, cg_ob_lcn[di*8 + c]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, " - 1] = ");
            cg_put(g, cg_ob_lcn[di*8 + c]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, "]; ");
            cg_put(g, cg_ob_lcn[di*8 + c]);
            cg_put(g, "["); cg_put(g, nmi); cg_put(g, "] = ");
            cg_put(g, nmt); cg_put_int(g, c);
            cg_put(g, ";\n");
            c++;
        }
        cg_indent(g);
        cg_put(g, nmi); cg_put(g, " = "); cg_put(g, nmi); cg_put(g, " - 1;\n");
        g->indent = g->indent - 1;
        cg_indent(g); cg_put(g, "}\n");
        g->indent = g->indent - 1;
        cg_indent(g);
        cg_put(g, nmj); cg_put(g, " = "); cg_put(g, nmj); cg_put(g, " + 1; }\n");
        return 1;
    }
    /* Element type produced by `sorted(d)`, `sorted(d.keys())` and
     * `sorted(d.values())` -- needed where only the syntax node is at hand and
     * the dict's value flag has to be read through the view wrapper. */
    static int cg_dsort_et(const IRNode* n) {
        if (!n || d_strcmp(n->type,"CALL")!=0 || !n->value) return 0;
        if (d_strcmp(n->value,"sorted")!=0 && d_strcmp(n->value,"sorted_r")!=0) return 0;
        if (n->nchildren != 1) return 0;
        const IRNode* b = n->children[0];
        if (!b) return 0;
        if (d_strcmp(b->type,"IDENTIFIER")==0) return cg_dict_kf(b->value) ? 2 : 0;
        if (d_strcmp(b->type,"CALL")!=0 || d_strcmp(b->value,"COMPLEX")!=0) return 0;
        const IRNode* rc = cg_mcx_recv(b);
        if (!rc || !rc->value || d_strcmp(rc->type,"IDENTIFIER")!=0) return 0;
        if (!cg_is_dict(rc->value)) return 0;
        if (d_strcmp(cg_mcx_meth(b),"keys")==0) return cg_dict_kf(rc->value) ? 2 : 0;
        if (d_strcmp(cg_mcx_meth(b),"values")==0) {
            int vf = cg_dict_vf(rc->value);
            if (vf == 2) return 2;
            if (vf == 1) return 1;
            return 0;
        }
        return 0;
    }
    static void cg_sl_fill(CGen* g, const IRNode* n) {
        if (!n) return;
        /* a def's body is generated by its own statement walk: filling its
         * statements at the def site would emit the copies at module scope
         * (the body's locals are not module scope) and mark them seen */
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        /* `xs = sorted(d)`: fill the sort temp, then copy it into the target so
         * `xs` behaves like any other python list (len/index/print).  Without
         * the copy the statement emitted nothing and later uses of xs crashed. */
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren>1) {
            if (cg_dict_sort_emit(g, n->children[1])) {
                const IRNode* lhs = n->children[0];
                /* Emit the copy once per statement: the prepass visits a
                 * statement more than once, and an unguarded body redeclared
                 * `_dsi` inside main (invalid C). */
                if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && cg_slx_index(n->children[1]) >= 0
                    && cg_sl_index(lhs->value) < 0) {
                    int dkf3 = cg_dsort_et(n->children[1]);
                    /* Register the target as a plain string/int list with a
                     * runtime count.  NOT via cg_note_strlist: that files the
                     * name in the slice-temp table, which makes cg_pk pick the
                     * compile-time-count branch and print `slrepr(xs, 64)` --
                     * the declared capacity -- instead of `slrepr(xs, xs_n)`. */
                    cg_note_list(lhs->value, 64, dkf3 == 2 ? 2 : (dkf3 == 1 ? 1 : 0));
                    cg_indent(g);
                    cg_put(g, lhs->value); cg_put(g, "_n = 0;\n");
                    cg_indent(g);
                    cg_put(g, "int _dsi = 0; while (_dsi < "); cg_sl_put_name(g, cg_slx_index(n->children[1]));
                    cg_put(g, "_n) { "); cg_put(g, lhs->value); cg_put(g, "[_dsi] = ");
                    cg_sl_put_name(g, cg_slx_index(n->children[1]));
                    cg_put(g, "[_dsi]; _dsi = _dsi + 1; }\n");
                    cg_indent(g);
                    cg_put(g, lhs->value); cg_put(g, "_n = "); cg_sl_put_name(g, cg_slx_index(n->children[1]));
                    cg_put(g, "_n;\n");
                    /* register the target as a slice temp so print/len use its
                     * runtime count rather than the declared capacity */
                    cg_sl_add(n->children[1], dkf3);
                    return;
                }
            }
        }
        if (cg_obj_sort_emit(g, n)) return;
        if (cg_dict_sort_emit(g, n)) return;
        if (cg_sl_assign_target(n)) {
            if (cg_sl_filled_seen(n)) return;
            /* NOTE: `arr[n++] = v` on a file-scope static loses the increment
             * in the self-compiled backend; split the store and the bump. */
            cg_sl_filled[cg_sl_filled_n] = n;
            cg_sl_filled_n = cg_sl_filled_n + 1;
            const IRNode* lhs = n->children[0];
            const IRNode* sl = n->children[1];
            /* `a = b[c:d]` where the base is itself a temp: fill it first */
            if (sl && sl->nchildren > 0) cg_sl_fill(g, sl->children[0]);
            int et = cg_sl_base_et(sl);
            int cap = cg_sl_base_cap(sl);
            if (cap < 64) cap = 64;
            cg_note_list(lhs->value, cap, et);
            if (et == 2) cg_note_strlist(lhs->value);
            cg_forget_str(lhs->value);
            cg_sl_copy(g, sl, lhs->value);
            return;
        }
        /* children first: the base of a nested slice/sorted() is a temp that
         * has to be filled before the copy that reads it */
        int i = 0;
        while (i < n->nchildren) { cg_sl_fill(g, n->children[i]); i++; }
        if (cg_sl_islice(n)) {
            if (!cg_sl_filled_seen(n)) {
                cg_sl_filled[cg_sl_filled_n] = n;
                cg_sl_filled_n = cg_sl_filled_n + 1;
                int k = cg_slx_index(n);
                if (k < 0) k = cg_sl_add(n, cg_sl_base_et(n));
                if (k >= 0) cg_sl_copy(g, n, cg_sl_name_of(k));
            }
        }
    }
    /* ── rendering containers ─────────────────────────────────────────────
     * `print(x)` on a python container has to show the container, not the
     * address of its backing array.  A list literal used as a print argument
     * or as a call argument gets a file-scope backing array (`_dylitK`) that
     * is filled immediately before the statement that needs it. */
    static const IRNode* cg_lit_nodes[512];
    static int cg_lit_sizes[512];
    static int cg_lit_flags[512];
    static int cg_lit_done[512];
    /* 0 = an ordinary literal; 1/2/3 = a list of lists whose rows hold ints /
     * char* / doubles (see cg_lit_scan).  The backing array of such a temp is
     * filled flattened rather than with one compound literal per row. */
    static int cg_lit_twodk[512];
    static int cg_nlits;
    static int cg_lit_index(const IRNode* n) {
        int i = 0;
        while (i < cg_nlits) { if (cg_lit_nodes[i] == n) return i; i++; }
        return -1;
    }
    static int cg_lit_add(const IRNode* n) {
        int i = cg_lit_index(n);
        if (i >= 0) return i;
        if (cg_nlits >= 512) return -1;
        cg_lit_nodes[cg_nlits] = n;
        cg_lit_sizes[cg_nlits] = n->nchildren;
        cg_lit_flags[cg_nlits] = 0;
        cg_lit_done[cg_nlits] = 0;
        cg_nlits = cg_nlits + 1;
        return cg_nlits - 1;
    }
    static void cg_lit_put_name(CGen* g, int k) {
        cg_put(g, "_dylit");
        cg_put_int(g, k);
    }
    /* The backing-array name behind a dynamic-list expression: a plain name,
     * or the temp a list slice was lowered into. */
    static void cg_dyn_put_name(CGen* g, const IRNode* a) {
        /* `list(<slice/sorted/reversed>)` is that temp's backing array. */
        if (a && d_strcmp(a->type,"CALL")==0 && a->value && a->nchildren == 1 &&
            (d_strcmp(a->value,"list")==0 || d_strcmp(a->value,"tuple")==0) &&
            cg_sl_islice(a->children[0])) {
            cg_dyn_put_name(g, a->children[0]);
            return;
        }
        if (a && d_strcmp(a->type,"SLICE")==0) {
            int k = cg_slx_index(a);
            if (k < 0) k = 0;
            cg_sl_put_name(g, k);
            return;
        }
        if (cg_sl_issorted(a) || cg_sl_isdictsorted(a)) {
            int k = cg_slx_index(a);
            if (k < 0) k = cg_sl_add(a, cg_sl_base_et(a));
            if (k >= 0) { cg_sl_put_name(g, k); return; }
        }
        if (a) cg_put(g, a->value);
    }
    static void cg_lit_reset_done(void) {
        int i = 0;
        while (i < cg_nlits) { cg_lit_done[i] = 0; i++; }
    }
    /* Register every list literal handed to print() or to a call, so a backing
     * array can be declared for it at file scope. */
    static void cg_lit_scan(const IRNode* n, int ctx) {
        if (!n) return;
        if (ctx && cg_is_list_node(n)) {
            int k = cg_lit_add(n);
            /* A nested literal handed straight to a call (`writerows([[1,2],
             * [3,4]])`) is a list of LISTS.  Its temp has to be declared like
             * a flattened 2D list, so the row kind is recorded while the
             * syntax node is still reachable -- the fill pass and the decl
             * pass both run later and neither can see the call any more. */
            if (k >= 0 && ctx == 2) {
                int t2 = cg_arg_twod(n);
                if (t2) {
                    char nm[16];
                    cg_lit_name_buf(k, nm);
                    cg_lit_twodk[k] = t2;
                    if (cg_list_index(nm) < 0) {
                        cg_note_list(nm, n->nchildren, t2 - 1);
                        cg_note_twod_k(nm, t2 - 1);
                    }
                }
            }
        }
        int sub = 0;
        if (d_strcmp(n->type,"CALL")==0) {
            sub = 2;
            if (d_strcmp(n->value,"print")==0) sub = 1;
        }
        int i = 0;
        while (i < n->nchildren) { cg_lit_scan(n->children[i], sub); i++; }
    }
    /* Fill the backing array of one list literal (its `_dylitK` temp) exactly
     * once; used by cg_lit_emit and by the slice-temp copy path when a literal
     * is the source of a slice/sorted(). */
    static void cg_lit_fill_one(CGen* g, const IRNode* n, int k) {
        if (k < 0 || cg_lit_done[k]) return;
        cg_lit_done[k] = 1;
        if (cg_lit_twodk[k] > 0) {
            /* a list of lists handed to a call: flatten exactly like a 2D list
             * variable does, so the callee (which took `_back/_off/_ln/_n`)
             * indexes rows out of one contiguous store.  The temp name was
             * registered as a 2D list at scan time, so it already has its
             * backing array, row offsets and row lengths declared. */
            int rk = cg_lit_twodk[k] - 1;
            int row = 0;
            int base = 0;
            while (row < n->nchildren) {
                const IRNode* r = n->children[row];
                cg_indent(g); cg_lit_put_name(g, k);
                cg_put(g, "_off["); cg_put_int(g, row); cg_put(g, "] = ");
                cg_put_int(g, base); cg_put(g, ";\n");
                int cl = 0;
                while (cl < r->nchildren) {
                    cg_indent(g); cg_lit_put_name(g, k);
                    cg_put(g, "_back["); cg_put_int(g, base + cl); cg_put(g, "] = ");
                    if (rk == 1 && !cg_node_is_str_static(r->children[cl]))
                        cg_strify(g, r->children[cl]);
                    else cg_gen_expr(g, r->children[cl]);
                    cg_put(g, ";\n");
                    cl++;
                }
                cg_indent(g); cg_lit_put_name(g, k);
                cg_put(g, "_ln["); cg_put_int(g, row); cg_put(g, "] = ");
                cg_put_int(g, r->nchildren); cg_put(g, ";\n");
                base = base + r->nchildren;
                row++;
            }
            cg_indent(g); cg_lit_put_name(g, k);
            cg_put(g, "_n = "); cg_put_int(g, n->nchildren); cg_put(g, ";\n");
            return;
        }
        int want = cg_litw_get(n);
        int isf = 0;
        int i = 0;
        while (i < n->nchildren) {
            if (cg_is_float_node(n->children[i])) isf = 1;
            if (cg_node_is_str_static(n->children[i])) isf = 2;
            i++;
        }
        /* a call site that hands this literal to a typed list parameter
         * decides what the backing array has to hold */
        if (want >= 0) isf = want;
        /* tuple rows (a list of tuple literals, e.g. print(sorted([(1,"b")]))):
         * rows stay compile-time reprs plus their key tables */
        int istrow = n->nchildren > 0;
        i = 0;
        while (i < n->nchildren) {
            const IRNode* el = n->children[i];
            if (!el || d_strcmp(el->type,"BLOCK")!=0 || d_strcmp(el->value,"TUPLE")!=0) istrow = 0;
            i++;
        }
        char nm[16];
        cg_lit_name_buf(k, nm);
        if (want < 0 && istrow) {
            if (cg_list_index(nm) < 0) {
                cg_note_list(nm, n->nchildren, 0);
                cg_note_lx(nm);
                cg_note_trow(nm);
            }
            i = 0;
            while (i < n->nchildren) {
                const IRNode* el = n->children[i];
                cg_indent(g); cg_lit_put_name(g, k); cg_put(g, "[");
                cg_put_int(g, i); cg_put(g, "] = 0;\n");
                cg_indent(g); cg_lit_put_name(g, k); cg_put(g, "_lx[");
                cg_put_int(g, i); cg_put(g, "] = ");
                cg_lit_repr_emit(g, el);
                cg_put(g, ";\n");
                cg_note_row(nm, i, el);
                int j = 0;
                while (j < el->nchildren) {
                    if (j >= 2) break;
                    const IRNode* ke = el->children[j];
                    int isstr = cg_node_is_str_static(ke);
                    cg_indent(g); cg_lit_put_name(g, k);
                    cg_put(g, isstr ? (j == 0 ? "_s0[" : "_s1[") :
                                     (j == 0 ? "_k0[" : "_k1["));
                    cg_put_int(g, i); cg_put(g, "] = ");
                    if (isstr) cg_gen_expr(g, ke);
                    else cg_gen_expr(g, ke);
                    cg_put(g, ";\n");
                    if (isstr) cg_note_rowkey(nm, j == 0 ? 4 : 8);
                    else cg_note_rowkey(nm, j == 0 ? 1 : 2);
                    j++;
                }
                i++;
            }
            return;
        }
        cg_lit_flags[k] = isf;
        /* a mixed literal (str + non-str elements) also fills a per-element
         * kind byte so its repr can quote only the string elements */
        int ismix = 0;
        if (want < 0 && n->nchildren > 0) {
            int has = 0;
            i = 0;
            while (i < n->nchildren) {
                if (cg_node_is_str_static(n->children[i])) has = has | 1;
                else has = has | 2;
                i++;
            }
            ismix = (has == 3);
        }
        if (ismix) {
            if (cg_list_index(nm) < 0) {
                cg_note_list(nm, n->nchildren, 2);
                cg_note_mixed(nm);
            }
            cg_lit_flags[k] = 2;
            i = 0;
            while (i < n->nchildren) {
                const IRNode* el = n->children[i];
                int isstr = cg_node_is_str_static(el);
                cg_indent(g); cg_lit_put_name(g, k); cg_put(g, "[");
                cg_put_int(g, i); cg_put(g, "] = ");
                if (isstr) cg_gen_expr(g, el);
                else cg_strify(g, el);
                cg_put(g, ";\n");
                cg_indent(g); cg_lit_put_name(g, k); cg_put(g, "_t[");
                cg_put_int(g, i); cg_put(g, "] = ");
                cg_put_int(g, isstr ? 1 : 0);
                cg_put(g, ";\n");
                i++;
            }
            return;
        }
        i = 0;
        while (i < n->nchildren) {
            cg_indent(g); cg_lit_put_name(g, k); cg_put(g, "[");
            cg_put_int(g, i); cg_put(g, "] = ");
            if (isf == 2 && !cg_node_is_str_static(n->children[i]))
                cg_strify(g, n->children[i]);
            else cg_gen_expr(g, n->children[i]);
            cg_put(g, ";\n");
            i++;
        }
    }
    /* Fill the backing array of every list literal the statement `n` needs,
     * once, immediately before that statement.  Statement containers are not
     * descended into: each of their statements emits its own inits. */
    static void cg_lit_emit(CGen* g, const IRNode* n) {
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 || d_strcmp(n->type,"CLASS_DEF")==0) return;
        if (d_strcmp(n->type,"FOR")==0) {
            /* the iterable is evaluated before the loop header, so a slice
             * there has to be filled ahead of the loop */
            cg_sl_fill(g, n->nchildren>1 ? n->children[1] : NULL);
            return;
        }
        if (d_strcmp(n->type,"IF")==0 || d_strcmp(n->type,"WHILE")==0 ||
            d_strcmp(n->type,"TRY")==0) return;
        cg_sl_fill(g, n);
        if (cg_is_list_node(n)) {
            int k = cg_lit_index(n);
            if (k >= 0) cg_lit_fill_one(g, n, k);
        }
        int i = 0;
        while (i < n->nchildren) { cg_lit_emit(g, n->children[i]); i++; }
    }
    /* print() argument classification; anything past 3 needs a renderer rather
     * than a plain printf conversion. */
    /* Names known to hold a truth value (`b = True`, `c = x < y`). print()
     * renders those as Python's True/False rather than 1/0. */
    static char cg_bool_vars[16384];
    static int cg_nbool_vars;
    static int cg_is_bool_var(const char* name) {
        if (!name || !name[0]) return 0;
        int i = 0;
        while (i < cg_nbool_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_bool_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static void cg_note_bool(const char* name) {
        if (!name || !name[0]) return;
        if (cg_is_bool_var(name)) return;
        if (cg_nbool_vars >= 256) return;
        int base = cg_nbool_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_bool_vars[base + j] = name[j]; j++; }
        cg_bool_vars[base + j] = 0;
        cg_nbool_vars = cg_nbool_vars + 1;
    }
    static void cg_forget_bool(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nbool_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_bool_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) { cg_nbool_vars = cg_nbool_vars - 1; while (i < cg_nbool_vars) { j = 0; while (j < 64) { cg_bool_vars[i*64+j] = cg_bool_vars[(i+1)*64+j]; j++; } i++; } return; }
            i++;
        }
    }
    /* Names holding a tuple rather than a list: `t = (1, 2, 3)`.  The backing
     * array is the same, only the repr uses parentheses. */
    static char cg_tup_names[16384];
    static int cg_ntup_vars;
    static int cg_is_tuple(const char* name) {
        if (!name || !name[0]) return 0;
        int i = 0;
        while (i < cg_ntup_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_tup_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static void cg_note_tuple(const char* name) {
        if (!name || !name[0]) return;
        if (cg_is_tuple(name)) return;
        if (cg_ntup_vars >= 256) return;
        int base = cg_ntup_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_tup_names[base + j] = name[j]; j++; }
        cg_tup_names[base + j] = 0;
        cg_ntup_vars = cg_ntup_vars + 1;
    }
    static void cg_forget_tuple(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_ntup_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_tup_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) { cg_ntup_vars = cg_ntup_vars - 1; while (i < cg_ntup_vars) { j = 0; while (j < 64) { cg_tup_names[i*64+j] = cg_tup_names[(i+1)*64+j]; j++; } i++; } return; }
            i++;
        }
    }
    /* infer a method's return kind from its body (a bare `def` has no
     * python-side return annotation, and `VOID` prints `%d` for strings) */
    /* Statement-order provenance for the names a method body assigns, used by
     * cg_infer_mret.  A body that builds a string in a variable
     * (`res = ""; ...; res = res + x; return res;`) only infers as `char*`
     * when `return res` can be traced back to those assignments, and the
     * cg_note_str/cg_is_str_node pair is keyed to the function being *emitted*
     * (cg_infer_mret runs while the class is laid out, long before that), so
     * this keeps its own table.  A forgotten name is blanked in place and a
     * later re-assignment appends a fresh entry. */
    static char cg_mi_names[64 * 32];
    static int cg_mi_n;
    static int cg_mi_expr_is_str(const IRNode* a);
    static int cg_mi_find(const char* nm) {
        if (!nm) return -1;
        int i = 0;
        while (i < cg_mi_n) {
            if (cg_mi_names[i*32] && d_strcmp(cg_mi_names + i*32, nm)==0) return i;
            i++;
        }
        return -1;
    }
    static int cg_mi_is_str(const char* nm) { return cg_mi_find(nm) >= 0; }
    static void cg_mi_set(const char* nm, int is_str) {
        if (!nm || !nm[0]) return;
        int i = cg_mi_find(nm);
        if (i < 0) {
            if (cg_mi_n >= 64) return;
            i = cg_mi_n;
            d_strncpy(cg_mi_names + i*32, nm, 31);
            cg_mi_names[i*32 + 31] = 0;
            cg_mi_n = cg_mi_n + 1;
        }
        if (!is_str) cg_mi_names[i*32] = 0;
    }
    static void cg_mi_scan(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0)
                cg_mi_set(lhs->value, cg_mi_expr_is_str(a->children[1]));
        }
        int i = 0;
        while (i < a->nchildren) { cg_mi_scan(a->children[i]); i++; }
    }
    static int cg_mi_expr_is_str(const IRNode* e) {
        if (!e) return 0;
        if (d_strcmp(e->type,"CONSTANT")==0)
            return d_strcmp(e->data_type,"STR")==0 || d_strcmp(e->data_type,"FSTR")==0;
        if (d_strcmp(e->type,"IDENTIFIER")==0) return cg_mi_is_str(e->value) || cg_is_str_node(e);
        if (d_strcmp(e->type,"SLICE")==0) return 1;
        if (d_strcmp(e->type,"BINARY_OP")==0 && e->nchildren>1 &&
            (d_strcmp(e->value,"+")==0 || d_strcmp(e->value,"*")==0))
            return cg_mi_expr_is_str(e->children[0]) || cg_mi_expr_is_str(e->children[1]);
        return cg_node_is_str_static(e);
    }
    static int cg_infer_mret(const IRNode* body, CGen* g, int cap) {
        int mdt = 1; /* VOID */
        cg_mi_n = 0;
        cg_mi_scan(body);
        if (body) for (int i=0;i<body->nchildren;i++) {
            const IRNode* s = body->children[i];
            if (s && d_strcmp(s->type,"RETURN")==0 && s->nchildren>0) {
                const IRNode* e = s->children[0];
                if (d_strcmp(e->type,"CONSTANT")==0) {
                    if (d_strcmp(e->data_type,"STR")==0 || d_strcmp(e->data_type,"FSTR")==0) mdt = 2;
                    else if (d_strcmp(e->data_type,"FLOAT")==0 || d_strcmp(e->data_type,"DOUBLE")==0) mdt = 3;
                    else if (d_strcmp(e->data_type,"BOOL")==0 || d_strcmp(e->data_type,"VOID")==0) mdt = 1;
                    else mdt = 4;
                }
                else if (cg_mi_expr_is_str(e)) mdt = 2;
                else if (cg_is_str_node(e)) mdt = 2;
                else if (cg_is_float_node(e)) mdt = 3;
                else if (d_strcmp(e->data_type,"STR")==0) mdt = 2;
                else if (d_strcmp(e->data_type,"FLOAT")==0) mdt = 3;
                else mdt = 4;
                break;
            }
        }
        (void)g; (void)cap;
        return mdt;
    }
    static int cg_is_bool_node(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CONSTANT")==0) return d_strcmp(a->data_type,"BOOL")==0;
        if (d_strcmp(a->type,"IDENTIFIER")==0) return cg_is_bool_var(a->value);
        if (d_strcmp(a->type,"BINARY_OP")==0) {
            const char* op = a->value;
            if (d_strcmp(op,"==")==0||d_strcmp(op,"!=")==0||d_strcmp(op,"<")==0||
                d_strcmp(op,">")==0||d_strcmp(op,"<=")==0||d_strcmp(op,">=")==0||
                d_strcmp(op,"in")==0||d_strcmp(op,"not in")==0) return 1;
            /* `and`/`or` over bool operands yields a bool (python truth) */
            if ((d_strcmp(op,"and")==0 || d_strcmp(op,"or")==0) &&
                a->nchildren==2 && cg_is_bool_node(a->children[0]) &&
                cg_is_bool_node(a->children[1])) return 1;
            return 0;
        }
        if (d_strcmp(a->type,"UNARY_OP")==0) return d_strcmp(a->value,"not")==0;
        if (d_strcmp(a->type,"CALL")==0) {
            if (d_strcmp(a->value,"bool")==0) return 1;
            if (a->nchildren>0 && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0) {
                const char* m = a->children[0]->value;
                if (d_strcmp(m,"startswith")==0||d_strcmp(m,"endswith")==0||
                    d_strcmp(m,"isalpha")==0||d_strcmp(m,"isdigit")==0||d_strcmp(m,"isalnum")==0||
                    d_strcmp(m,"islower")==0||d_strcmp(m,"isupper")==0||d_strcmp(m,"isspace")==0||
                    d_strcmp(m,"isidentifier")==0||d_strcmp(m,"isdecimal")==0||
                    d_strcmp(m,"isnumeric")==0) return 1;
            }
        }
        return 0;
    }
    /* The class a method call is made on.  The receiver is usually a plain
     * variable, but `objs[i].m()` reaches an OBJECT list -- whose element lives
     * in the column arrays -- so the class comes from the list registry. */
    static const char* cg_call_recv_cls(const IRNode* r) {
        if (!r || r->nchildren < 1 || !r->children[0]) return (const char*)0;
        const IRNode* b = r->children[0];
        if (d_strcmp(b->type,"IDENTIFIER")==0) return cg_cvar_class(b->value);
        /* a computed receiver (`Path(".").absolute()`, `sub / "x"`): the class
         * comes from the expression itself (23_pathlib). */
        if (d_strcmp(b->type,"ARRAY_ACCESS")!=0) {
            const char* bc = cg_expr_obj_class(b);
            if (bc && bc[0]) return bc;
        }
        /* `A().m()` — a temporary receiver: the class is the constructor name */
        if (d_strcmp(b->type,"CALL")==0 && b->value && b->value[0]) {
            int ci = 0;
            while (ci < cg_cls_n) {
                if (d_strcmp(cg_cls_names[ci], b->value) == 0) return cg_cls_names[ci];
                ci++;
            }
        }
        if (d_strcmp(b->type,"ARRAY_ACCESS")==0 && b->nchildren > 1 &&
            b->children[0] && d_strcmp(b->children[0]->type,"IDENTIFIER")==0) {
            int li = cg_ob_lookup(b->children[0]->value);
            if (li >= 0) return cg_ob_lcls[li];
        }
        return (const char*)0;
    }
    static int cg_pk(const IRNode* a) {
        if (!a) return 0;
        /* a class method call prints per its registered return type */
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"COMPLEX")==0 &&
            a->nchildren>0 && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
            a->children[0]->nchildren>0) {
            const char* cv = cg_call_recv_cls(a->children[0]);
            if (cv) {
                int ci = -1;
                int i = 0;
                while (i < cg_cls_n) { if (d_strcmp(cg_cls_names[i], cv) == 0) { ci = i; break; } i++; }
                if (ci >= 0) {
                    int j = 0;
                    while (j < cg_cls_nmeth[ci]) {
                        if (d_strcmp(cg_cls_methnames[ci*48 + j], a->children[0]->value) == 0) {
                            if (cg_cls_mret[ci][j] == 2) return 1;
                            if (cg_cls_mret[ci][j] == 3) return 2;
                            /* 1 is a counted `int`; 0 means the class body
                             * never gave this method a return type, so the
                             * generic rules below get the last word.  Answering
                             * "int" for an uninferred method printed a string
                             * through `%d` (`io.StringIO.getvalue`, whose
                             * `return self.data` no earlier pass could type). */
                            if (cg_cls_mret[ci][j] == 1) return 0;
                            break;
                        }
                        j++;
                    }
                }
            }
        }
        /* a literal tuple prints with parentheses, unlike a list literal */
        if (d_strcmp(a->type,"BLOCK")==0 && d_strcmp(a->value,"TUPLE")==0 && a->nchildren>0) return 21;
        if (cg_is_list_node(a)) return 8;
        /* a slice of a list is itself a list (of ints, doubles or strings) */
        if (cg_sl_islice(a)) {
            int et = cg_sl_base_et(a);
            /* `sorted(d)` over a dict is always a list of the dict's KEYS */
            if (cg_sl_isdictsorted(a)) et = cg_dsort_et(a);
            if (et == 2) return 13;
            if (et == 1) return 12;
            if (et == 3) return 27;
            return 11;
        }
        if (d_strcmp(a->type,"IDENTIFIER")==0 && cg_is_dict(a->value)) return 19;
        if (d_strcmp(a->type,"IDENTIFIER")==0) {
            if (cg_is_lparam(a->value)) {
                int lt = cg_lparam_type(a->value);
                if (lt == 1) return 12;
                if (lt == 2) return 13;
                return 11;
            }
            if (cg_sl_index(a->value) >= 0) {
                /* a tuple of strings renders with parentheses */
                if (cg_is_tuple(a->value)) return 18;
                /* a literal-backed string list has a compile-time element count
                 * instead of the `_n` companion a split() result carries */
                if (cg_list_size(a->value) >= 0) return 14;
                return 6;
            }
            if (cg_list_size(a->value) >= 0) {
                if (cg_list_is_trow(a->value)) return 27;
                if (cg_list_is_lx(a->value)) return 28;
                if (cg_list_is_twod(a->value)) return 26;
                /* a literal-backed list has a runtime element count too, so
                 * append()/pop() can change it */
                if (cg_list_is_str(a->value)) return cg_is_tuple(a->value) ? 18 : 13;
                if (cg_list_is_float(a->value)) return cg_is_tuple(a->value) ? 17 : 12;
                return cg_is_tuple(a->value) ? 16 : 11;
            }
        }
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"COMPLEX")==0 &&
            a->nchildren>0 && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
            (d_strcmp(a->children[0]->value,"split")==0 ||
             d_strcmp(a->children[0]->value,"rsplit")==0)) return 7;
        /* print(list(range(...))) and a bare range() print arg */
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"list")==0 &&
            a->nchildren==1 && d_strcmp(a->children[0]->type,"CALL")==0 &&
            d_strcmp(a->children[0]->value,"range")==0) return 22;
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"range")==0) return 23;
        if (d_strcmp(a->type,"CALL")==0 && cg_fn_is_list(a->value)) return 20;
        /* an element of a text-row 2D list is itself a string */
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 && a->children[0] &&
            d_strcmp(a->children[0]->type,"ARRAY_ACCESS")==0 &&
            a->children[0]->nchildren>0 && a->children[0]->children[0] &&
            d_strcmp(a->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            cg_list_is_twod(a->children[0]->children[0]->value) &&
            cg_list_twod_kind(a->children[0]->children[0]->value) == 1) return 1;
        /* a string element of a string list prints as a string */
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 &&
            d_strcmp(a->children[0]->type,"IDENTIFIER")==0) {
            const char* bn = a->children[0]->value;
            if (cg_is_lparam(bn) && cg_lparam_type(bn) == 2) return 1;
            if (cg_list_is_str(bn)) return 1;
            /* an element of a homogeneous 2D list is itself a row: print
             * its repr; an element of a mixed-shape list that holds list
             * rows prints the compile-time repr stored in NAME_lx */
            if (cg_list_is_twod(bn)) return 25;
            if (cg_list_is_lx(bn)) return 24;
        }
        if (cg_is_bool_node(a)) return 15;
        if (cg_is_str_node(a)) return 1;
        if (cg_is_float_node(a)) return 2;
        if (cg_is_char_node(a)) return 3;
        return 0;
    }
    /* Emit the inner text of a python string constant as C string-literal
     * pieces (used for print's end=/sep= kwargs). */
    static void cg_put_pystr(CGen* g, const IRNode* a) {
        const char* v = a->value;
        size_t l = d_strlen(v);
        if (l>=2 && (v[0]=='\''||v[0]=='"') && (v[l-1]=='\''||v[l-1]=='"')) {
            size_t k = 1;
            while (k + 1 < l) {
                char c = v[k];
                if (c=='%') cg_put(g, "%%");
                else if (c=='"') cg_put(g, "\\\"");
                else if (c=='\\') cg_put(g, "\\\\");
                else { char s[2]={c,0}; cg_put(g, s); }
                k++;
            }
        } else {
            const char* p2 = v;
            while (*p2) { if (*p2=='%') cg_put(g,"%%"); else { char s[2]={*p2,0}; cg_put(g,s);} p2++; }
        }
    }
    static const char* cg_pk_fmt(int k) {
        if (k == 1) return "%s";
        if (k == 2) return "%s"; /* floats print python-repr style via ftoa */
        if (k == 3) return "%c";
        if (k >= 4) return "%s";
        return "%d";
    }
    /* A float list is rendered element by element inside its own block, and a
     * compound statement must not be followed by a bare `;` — the statement
     * terminator is suppressed for these prints. */
    static int cg_print_hasfl(const IRNode* n) {
        if (!n || d_strcmp(n->value,"print")!=0) return 0;
        for (int i=0;i<n->nchildren;i++) {
            const IRNode* a = n->children[i];
            int pk = cg_pk(a);
            if (pk == 5 || pk == 12 || pk == 17 || pk == 20 || pk == 22) return 1;
            if (pk == 8 || pk == 21) {
                int kk = cg_lit_index(a);
                if (kk >= 0 && cg_lit_flags[kk] == 1) return 1;
            }
        }
        return 0;
    }
    static void cg_print_arg(CGen* g, const IRNode* a, int k, int i) {
        if (k == 15) {
            cg_put(g, "(");
            cg_gen_expr(g, a);
            cg_put(g, " ? \"True\" : \"False\")");
            return;
        }
        /* float lists are rendered by an accumulator (a double array cannot be
         * handed across a call), so the value lives in the loop's temp. */
        if (k == 5) {
            cg_put(g, "_rpf");
            cg_put_int(g, i);
            return;
        }
        if (k == 12 || k == 17) {
            cg_put(g, "_rpf");
            cg_put_int(g, i);
            return;
        }
        if (k == 16) {
            cg_put(g, "drygon_itrepr(");
            cg_put(g, a->value); cg_put(g, ", "); cg_put(g, a->value); cg_put(g, "_n)");
            return;
        }
        /* list(range(...)) prints from the prepass temp; a bare range()
         * prints python's repr */
        if (k == 22) {
            cg_put(g, "drygon_ilrepr(_rpr"); cg_put_int(g, i);
            cg_put(g, ", _rpr"); cg_put_int(g, i); cg_put(g, "_n)");
            return;
        }
        if (k == 23) {
            const IRNode* r = a;
            cg_put(g, "drygon_rrepr(");
            if (r->nchildren > 1) cg_gen_expr(g, r->children[0]); else cg_put(g, "0");
            cg_put(g, ", ");
            cg_gen_expr(g, r->children[r->nchildren > 1 ? 1 : 0]);
            cg_put(g, ", ");
            if (r->nchildren > 2) cg_gen_expr(g, r->children[2]); else cg_put(g, "1");
            cg_put(g, ", ");
            if (r->nchildren > 2) cg_put(g, "1"); else cg_put(g, "0");
            cg_put(g, ")");
            return;
        }
        /* an element of a 2D list prints as the row's repr; an element of a
         * mixed-shape list prints the compile-time repr captured at assign */
        if (k == 25) {
            const char* bn = a->children[0]->value;
            cg_put(g, cg_list_twod_kind(bn) == 1 ? "drygon_slrepr_at(" : "drygon_ilrepr_at(");
            cg_put(g, bn);
            cg_put(g, "_back, ");
            cg_put(g, bn);
            cg_put(g, "_off[");
            cg_gen_expr(g, a->children[1]);
            cg_put(g, "], ");
            cg_put(g, bn);
            cg_put(g, "_ln[");
            cg_gen_expr(g, a->children[1]);
            cg_put(g, "])");
            return;
        }
        if (k == 24) {
            const char* bn = a->children[0]->value;
            cg_put(g, bn);
            cg_put(g, "_lx[");
            cg_gen_expr(g, a->children[1]);
            cg_put(g, "]");
            return;
        }
        if (k == 20) {
            cg_put(g, cg_fn_ret_strlist(a->value) ?
                      "drygon_slrepr(drygon_rls, drygon_rls_n)" :
                      "drygon_ilrepr(drygon_rl, drygon_rl_n)");
            return;
        }
        if (k == 18) {
            if (cg_list_is_mixed(a->value)) {
                cg_put(g, "drygon_tlrepr_m(");
                cg_put(g, a->value); cg_put(g, ", "); cg_put(g, a->value);
                cg_put(g, "_t, "); cg_put(g, a->value); cg_put(g, "_n)");
            } else {
                cg_put(g, "drygon_strepr(");
                cg_put(g, a->value); cg_put(g, ", "); cg_put(g, a->value); cg_put(g, "_n)");
            }
            return;
        }
        if (k == 27) {
            cg_put(g, "drygon_2lrepr_x(");
            cg_dyn_put_name(g, a);
            cg_put(g, "_lx, ");
            cg_dyn_put_name(g, a);
            cg_put(g, "_n");
            cg_put(g, ")");
            return;
        }
        if (k == 28) {
            cg_put(g, "drygon_2lrepr_m(");
            cg_dyn_put_name(g, a);
            cg_put(g, ", ");
            cg_dyn_put_name(g, a);
            cg_put(g, "_lx, ");
            cg_dyn_put_name(g, a);
            cg_put(g, "_n");
            cg_put(g, ")");
            return;
        }
        if (k == 26) {
            const char* bn = a->value;
            cg_put(g, cg_list_twod_kind(bn) == 1 ? "drygon_2lrepr_sl(" : "drygon_2lrepr(");
            cg_put(g, bn); cg_put(g, "_back, ");
            cg_put(g, bn); cg_put(g, "_off, ");
            cg_put(g, bn); cg_put(g, "_ln, ");
            cg_put(g, bn); cg_put(g, "_n");
            cg_put(g, ")");
            return;
        }
        if (k == 13 || k == 14) {
            int mx = (k == 14) && cg_list_is_mixed(a->value);
            cg_put(g, mx ? "drygon_slrepr_m(" : "drygon_slrepr(");
            cg_dyn_put_name(g, a);
            cg_put(g, ", ");
            if (mx) { cg_put(g, a->value); cg_put(g, "_t, "); }
            if (k == 13) { cg_dyn_put_name(g, a); cg_put(g, "_n"); }
            else {
                /* a MIXED list must use the RUNTIME element count, not the
                 * static prescan size -- the static size read 0 for a list
                 * built by append(), so `print(result)` showed [] while
                 * `len(result)` was correct (16_exceptions check 22). */
                cg_dyn_put_name(g, a); cg_put(g, "_n");
            }
            cg_put(g, ")");
            return;
        }
        /* a python dict renders as `{'a': 1, 'b': 2}` */
        if (k == 19) {
            int vf = cg_dict_vf(a->value);
            cg_put(g, "drygon_drepr_");
            cg_put(g, vf == 2 ? "s" : (vf == 1 ? "d" : "i"));
            cg_put(g, cg_dict_kf(a->value) ? "s(" : "i(");
            cg_put(g, a->value); cg_put(g, "_k, ");
            cg_put(g, a->value); cg_put(g, "_v, ");
            cg_put(g, a->value); cg_put(g, "_n)");
            return;
        }
        if (k == 11) {
            cg_put(g, "drygon_ilrepr(");
            cg_dyn_put_name(g, a);
            cg_put(g, ", ");
            cg_dyn_put_name(g, a); cg_put(g, "_n)");
            return;
        }
        if (k == 4) {
            cg_put(g, "drygon_ilrepr(");
            cg_gen_expr(g, a);
            cg_put(g, ", ");
            cg_put_int(g, cg_list_size(a->value));
            cg_put(g, ")");
            return;
        }
        if (k == 6) {
            cg_put(g, "drygon_slrepr(");
            cg_put(g, a->value);
            cg_put(g, ", ");
            cg_put(g, a->value);
            cg_put(g, "_n)");
            return;
        }
        if (k == 7) {
            int _prm = (a->nchildren>0 && a->children[0]->nchildren>0 &&
                        d_strcmp(a->children[0]->value,"rsplit")==0 && a->nchildren>2);
            cg_put(g, _prm ? "drygon_rsplit_repr_m(" : "drygon_split_repr(");
            cg_gen_expr(g, a->children[0]->nchildren>0 ? a->children[0]->children[0] : NULL);
            cg_put(g, ", ");
            if (a->nchildren>1) cg_gen_expr(g, a->children[1]);
            else cg_put(g, "\"\"");
            if (_prm) { cg_put(g, ", "); cg_gen_expr(g, a->children[2]); }
            cg_put(g, ")");
            return;
        }
        if (k == 21) {
            int kk = cg_lit_index(a);
            if (kk < 0) kk = 0;
            if (cg_lit_flags[kk] == 1) {
                cg_put(g, "_rpf");
                cg_put_int(g, i);
                return;
            }
            char lm[16];
            cg_lit_name_buf(kk, lm);
            if (cg_list_is_mixed(lm)) {
                cg_put(g, "drygon_tlrepr_m(");
                cg_lit_put_name(g, kk);
                cg_put(g, ", ");
                cg_lit_put_name(g, kk);
                cg_put(g, "_t, ");
                cg_put_int(g, a->nchildren);
                cg_put(g, ")");
                return;
            }
            if (cg_lit_flags[kk] == 2) {
                cg_put(g, "drygon_strepr(");
                cg_lit_put_name(g, kk);
                cg_put(g, ", ");
                cg_put_int(g, a->nchildren);
                cg_put(g, ")");
                return;
            }
            cg_put(g, "drygon_tlrepr(");
            cg_lit_put_name(g, kk);
            cg_put(g, ", ");
            cg_put_int(g, a->nchildren);
            cg_put(g, ")");
            return;
        }
        if (k == 8) {
            int kk = cg_lit_index(a);
            if (kk < 0) kk = 0;
            if (cg_lit_flags[kk] == 1) {
                cg_put(g, "_rpf");
                cg_put_int(g, i);
                return;
            }
            char lm[16];
            cg_lit_name_buf(kk, lm);
            if (cg_list_is_trow(lm)) {
                cg_lit_put_name(g, kk);
                cg_put(g, "_lx, ");
                cg_lit_put_name(g, kk);
                cg_put_int(g, a->nchildren);
                return;
            }
            if (cg_list_is_mixed(lm)) {
                cg_put(g, "drygon_slrepr_m(");
                cg_lit_put_name(g, kk);
                cg_put(g, ", ");
                cg_lit_put_name(g, kk);
                cg_put(g, "_t, ");
                cg_put_int(g, a->nchildren);
                cg_put(g, ")");
                return;
            }
            if (cg_lit_flags[kk] == 2) {
                cg_put(g, "drygon_slrepr(");
                cg_lit_put_name(g, kk);
                cg_put(g, ", ");
                cg_put_int(g, a->nchildren);
                cg_put(g, ")");
                return;
            }
            cg_put(g, "drygon_ilrepr(");
            cg_lit_put_name(g, kk);
            cg_put(g, ", ");
            cg_put_int(g, a->nchildren);
            cg_put(g, ")");
            return;
        }
        if (k == 2) {
            cg_put(g, "ftoa(drygon_dbits(");
            cg_gen_expr(g, a);
            cg_put(g, "))");
            return;
        }
        /* `ord(...)` / `chr(...)` are ints (k is the INT tag here) but must not
         * be printed as a raw C call: `ord` has no C definition and `chr`
         * returns a char*.  Handle them before the fallthrough. */
        if (a && d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"ord")==0 && a->nchildren==1) {
            const IRNode* oa = a->children[0];
            if (oa && d_strcmp(oa->type,"IDENTIFIER")==0 && cg_is_char_var(oa->value)) cg_gen_expr(g, oa);
            else if (oa && d_strcmp(oa->type,"CONSTANT")==0 && d_strcmp(oa->data_type,"STR")==0 && oa->value) {
                /* `ord("A")`: the value is known at compile time.  Indexing a
                 * string literal in the C backend yields garbage (a separate
                 * defect), so emit the code point directly. */
                const char* sv = oa->value;
                int cl = (int)d_strlen(sv);
                if (cl >= 2 && (sv[0]=='\'' || sv[0]=='"')) sv = sv + 1;
                cg_put_int(g, (unsigned char)sv[0]);
            }
            else if (cg_is_str_node(oa)) { cg_put(g, "((int)("); cg_gen_expr(g, oa); cg_put(g, "[0]))"); }
            else cg_gen_expr(g, oa);
            return;
        }
        if (a && d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"chr")==0 && a->nchildren==1) {
            cg_put(g, "drygon_char_str("); cg_gen_expr(g, a->children[0]); cg_put(g, ")");
            return;
        }
        cg_gen_expr(g, a);
    }
    static void cg_put_int(CGen* g, int v) {
        char tmp[24];
        int i = 0;
        if (v < 0) { cg_put(g, "-"); v = 0 - v; }
        if (v == 0) { cg_put(g, "0"); return; }
        while (v > 0) { tmp[i] = 48 + (v % 10); i = i + 1; v = v / 10; }
        while (i > 0) {
            char s[2];
            i = i - 1;
            s[0] = tmp[i];
            s[1] = 0;
            cg_put(g, s);
        }
    }
    /* Map python augmented assignment operators onto C ones. */
    static const char* cg_assign_op(const char* op) {
        if (!op) return "=";
        if (d_strcmp(op,"//=")==0) return "/=";
        if (d_strcmp(op,"**=")==0) return "*=";
        return op;
    }
    /* the binary operator matching an augmented assignment (`+=` -> `+`).
     * Needed wherever an augmented store has to be rewritten as an explicit
     * read-modify-write, e.g. `d[k] += 1` on a dict. */
    static const char* cg_bin_op(const char* op) {
        if (d_strcmp(op,"%=")==0) return "%";
        if (d_strcmp(op,"+=")==0) return "+";
        if (d_strcmp(op,"-=")==0) return "-";
        if (d_strcmp(op,"*=")==0) return "*";
        if (d_strcmp(op,"/=")==0) return "/";
        if (d_strcmp(op,"//=")==0) return "/";
        if (d_strcmp(op,"&=")==0) return "&";
        if (d_strcmp(op,"|=")==0) return "|";
        if (d_strcmp(op,"^=")==0) return "^";
        return "+";
    }
    static void cg_d_expr(CGen* g, const IRNode* n);
    static void cg_d_node(CGen* g, const IRNode* n, int stmt);
    static void cg_fstr_field(CGen* g, const char* s, int n);
    static void cg_fstr_lit(CGen* g, const char* s, int n);
    /* `math.<name>` → the matching runtime helper (0 when unknown). */
    /* The integer tag `type()` produces for a builtin type OBJECT named in a
     * comparison (`type(x) == int`), or -1 when the node is not one. */
    static int cg_builtin_typetag(const IRNode* a) {
        if (!a || d_strcmp(a->type,"IDENTIFIER")!=0) return -1;
        if (d_strcmp(a->value,"bool")==0) return 1;
        if (d_strcmp(a->value,"int")==0) return 2;
        if (d_strcmp(a->value,"float")==0) return 3;
        if (d_strcmp(a->value,"str")==0) return 4;
        if (d_strcmp(a->value,"list")==0) return 5;
        /* tags the type() lowering emits for the other containers */
        if (d_strcmp(a->value,"dict")==0) return 6;
        if (d_strcmp(a->value,"set")==0) return 7;
        if (d_strcmp(a->value,"tuple")==0) return 8;
        if (d_strcmp(a->value,"NoneType")==0) return 0;
        return -1;
    }
    static const char* cg_math_fn(const char* m) {
        if (!m) return 0;
        if (d_strcmp(m,"sqrt")==0) return "sqrt";
        if (d_strcmp(m,"fabs")==0) return "fabs";
        if (d_strcmp(m,"abs")==0) return "fabs";
        if (d_strcmp(m,"floor")==0) return "floor";
        if (d_strcmp(m,"ceil")==0) return "ceil";
        if (d_strcmp(m,"trunc")==0) return "trunc";
        if (d_strcmp(m,"round")==0) return "round";
        if (d_strcmp(m,"exp")==0) return "exp";
        if (d_strcmp(m,"log")==0) return "log";
        if (d_strcmp(m,"log10")==0) return "log";
        if (d_strcmp(m,"log2")==0) return "log";
        if (d_strcmp(m,"sin")==0) return "sin";
        if (d_strcmp(m,"cos")==0) return "cos";
        if (d_strcmp(m,"tan")==0) return "tan";
        if (d_strcmp(m,"asin")==0) return "asin";
        if (d_strcmp(m,"acos")==0) return "acos";
        if (d_strcmp(m,"atan")==0) return "atan";
        if (d_strcmp(m,"atan2")==0) return "atan2";
        if (d_strcmp(m,"pow")==0) return "pow";
        if (d_strcmp(m,"fmod")==0) return "fmod";
        if (d_strcmp(m,"hypot")==0) return "hypot";
        if (d_strcmp(m,"gcd")==0) return "drygon_m_gcd";
        if (d_strcmp(m,"isnan")==0) return "drygon_m_isnan";
        if (d_strcmp(m,"isinf")==0) return "drygon_m_isinf";
        if (d_strcmp(m,"isfinite")==0) return "drygon_m_isfinite";
        if (d_strcmp(m,"log1p")==0) return "drygon_m_log1p";
        if (d_strcmp(m,"expm1")==0) return "drygon_m_expm1";
        if (d_strcmp(m,"factorial")==0) return "drygon_m_factorial";
        if (d_strcmp(m,"prod")==0) return "drygon_m_prod";
        if (d_strcmp(m,"dist")==0) return "drygon_m_dist";
        if (d_strcmp(m,"comb")==0) return "drygon_m_comb";
        if (d_strcmp(m,"perm")==0) return "drygon_m_perm";
        if (d_strcmp(m,"copysign")==0) return "drygon_m_copysign";
        if (d_strcmp(m,"ldexp")==0) return "drygon_m_ldexp";
        if (d_strcmp(m,"degrees")==0) return "drygon_m_degrees";
        if (d_strcmp(m,"radians")==0) return "drygon_m_radians";
        if (d_strcmp(m,"cbrt")==0) return "drygon_m_cbrt";
        if (d_strcmp(m,"sinh")==0) return "drygon_m_sinh";
        if (d_strcmp(m,"cosh")==0) return "drygon_m_cosh";
        if (d_strcmp(m,"tanh")==0) return "drygon_m_tanh";
        if (d_strcmp(m,"asinh")==0) return "drygon_m_asinh";
        if (d_strcmp(m,"acosh")==0) return "drygon_m_acosh";
        if (d_strcmp(m,"atanh")==0) return "drygon_m_atanh";
        if (d_strcmp(m,"erf")==0) return "drygon_m_erf";
        if (d_strcmp(m,"erfc")==0) return "drygon_m_erfc";
        if (d_strcmp(m,"gamma")==0) return "drygon_m_gamma";
        if (d_strcmp(m,"lgamma")==0) return "drygon_m_lgamma";
        if (d_strcmp(m,"nextafter")==0) return "drygon_m_nextafter";
        if (d_strcmp(m,"ulp")==0) return "drygon_m_ulp";
        if (d_strcmp(m,"isqrt")==0) return "drygon_m_isqrt";
        if (d_strcmp(m,"frexp")==0) return "drygon_frexp";
        return 0;
    }
    /* Render any expression as a C string: strings pass through, doubles go
     * through ftoa, everything else through itoa10.  Used by str.format and
     * friends, where python converts every argument to text. */
    static void cg_strify(CGen* g, const IRNode* a) {
        if (!a) { cg_put(g, "\"\""); return; }
        if (cg_is_str_node(a)) { cg_gen_expr(g, a); return; }
        if (cg_is_float_node(a)) {
            cg_put(g, "ftoa(drygon_dbits("); cg_gen_expr(g, a); cg_put(g, "))");
            return;
        }
        /* A comparison / `in` / `not` / `and` / `or` is a python bool: str()
         * must render it "True"/"False", not the C 1/0 that itoa10 printed
         * (`f"{10 > 5}"` came out as "1").  Literal True/False already carry
         * the right node type. */
        if (d_strcmp(a->type,"BINARY_OP")==0) {
            const char* op = a->value;
            if (d_strcmp(op,"==")==0 || d_strcmp(op,"!=")==0 || d_strcmp(op,"<")==0 ||
                d_strcmp(op,"<=")==0 || d_strcmp(op,">")==0 || d_strcmp(op,">=")==0 ||
                d_strcmp(op,"in")==0 || d_strcmp(op,"not in")==0 || d_strcmp(op,"is")==0 ||
                d_strcmp(op,"is not")==0 || d_strcmp(op,"and")==0 || d_strcmp(op,"or")==0) {
                cg_put(g, "(("); cg_gen_expr(g, a); cg_put(g, ") ? \"True\" : \"False\")");
                return;
            }
        }
        if (d_strcmp(a->type,"UNARY_OP")==0 && d_strcmp(a->value,"not")==0) {
            cg_put(g, "(("); cg_gen_expr(g, a); cg_put(g, ") ? \"True\" : \"False\")");
            return;
        }
        cg_put(g, "itoa10("); cg_gen_expr(g, a); cg_put(g, ")");
    }
    /* ── whole-list aggregation: sum()/max()/min() ────────────────────────
     * A list is a backing array plus an element count; where that count lives
     * depends on how the list was made (compile-time for a literal, `<name>_n`
     * for a split() result or a typed list parameter). */
    static int cg_agg_case(const IRNode* a) {
        if (!a) return 0;
        if (cg_is_list_node(a)) return cg_lit_index(a) >= 0 ? 1 : 0;
        if (cg_sl_islice(a)) return 5;
        if (d_strcmp(a->type,"IDENTIFIER")!=0) return 0;
        if (cg_is_lparam(a->value)) return 2;
        if (cg_sl_index(a->value) >= 0) return cg_list_size(a->value) >= 0 ? 3 : 4;
        if (cg_list_size(a->value) >= 0) return 3;
        return 0;
    }
    /* element type: 0 int, 1 double, 2 char* */
    static int cg_agg_ctype(const IRNode* a) {
        int c = cg_agg_case(a);
        if (c == 1) return cg_lit_flags[cg_lit_index(a)];
        if (c == 2) return cg_lparam_type(a->value);
        if (c == 3) return cg_list_is_str(a->value) ? 2 : (cg_list_is_float(a->value) ? 1 : 0);
        if (c == 4) return 2;
        if (c == 5) return cg_sl_base_et(a);
        return 0;
    }
    static void cg_agg_operand(CGen* g, const IRNode* a) {
        int c = cg_agg_case(a);
        if (c == 1) {
            cg_lit_put_name(g, cg_lit_index(a));
            cg_put(g, ", ");
            cg_put_int(g, a->nchildren);
            return;
        }
        if (c == 5) {
            cg_gen_expr(g, a);
            cg_put(g, ", ");
            cg_gen_expr(g, a);
            cg_put(g, "_n");
            return;
        }
        if (c == 3) {
            cg_put(g, a->value);
            cg_put(g, ", ");
            cg_put(g, a->value);
            cg_put(g, "_n");
            return;
        }
        cg_put(g, a->value);
        cg_put(g, ", ");
        cg_put(g, a->value);
        cg_put(g, "_n");
    }
    static void cg_gen_dict_key(CGen* g, const IRNode* k) {
        const IRNode* ek = cg_eval_tuple_expr(k);
        if (cg_is_list_node(ek)) {
            cg_put(g, "(");
            int i = 0;
            while (i < ek->nchildren) {
                if (i > 0) cg_put(g, " * 1000003 + ");
                cg_gen_expr(g, ek->children[i]);
                i++;
            }
            if (ek->nchildren == 0) cg_put(g, "0");
            cg_put(g, ")");
            return;
        }
        cg_gen_expr(g, k);
    }
    static void cg_gen_cond(CGen* g, const IRNode* cond) {
        if (!cond) { cg_put(g, "1"); return; }
        /* A walrus in a condition: `while (v := expr) != 0`.  cg_gen_expr knows
         * how to emit an ASSIGN in expression position, but the plain
         * statement path here printed only the left-hand name, so the condition
         * became `while (v)` with `v` unresolved. */
        if (d_strcmp(cond->type,"ASSIGN")==0) {
            cg_put(g, "(");
            cg_gen_expr(g, cond);
            cg_put(g, ")");
            return;
        }
        if (cg_is_list_node(cond) || (cond && d_strcmp(cond->type,"BLOCK")==0 && (d_strcmp(cond->value,"DICT")==0 || d_strcmp(cond->value,"SET")==0))) {
            cg_put(g, cond->nchildren != 0 ? "1" : "0");
            return;
        }
        if (cond && d_strcmp(cond->type,"CALL")==0 && (d_strcmp(cond->value,"set")==0 || d_strcmp(cond->value,"dict")==0 || d_strcmp(cond->value,"list")==0 || d_strcmp(cond->value,"tuple")==0)) {
            cg_put(g, cond->nchildren != 0 ? "1" : "0");
            return;
        }
        if (cond && d_strcmp(cond->type,"CONSTANT")==0 && d_strcmp(cond->value,"None")==0) {
            cg_put(g, "0");
            return;
        }
        if (cond && d_strcmp(cond->type,"IDENTIFIER")==0 && cg_is_dyn_list(cond->value)) {
            cg_put(g, "("); cg_put(g, cond->value); cg_put(g, "_n != 0)");
            return;
        }
        if (cond && d_strcmp(cond->type,"IDENTIFIER")==0 && cg_is_dict(cond->value)) {
            cg_put(g, "("); cg_put(g, cond->value); cg_put(g, "_n != 0)");
            return;
        }
        if (cg_is_str_node(cond)) {
            cg_put(g, "(drygon_slen("); cg_gen_expr(g, cond); cg_put(g, ") != 0)");
            return;
        }
        cg_gen_expr(g, cond);
    }
    /* True when every argument of this call is a keyword argument and the
     * callee's parameter names are known.  Such a call can be emitted in
     * parameter order by name; a positional or mixed call cannot. */
    static int cg_call_has_kwargs(const IRNode* n, const IRNode* prog) {
        if (!n || !prog) return 0;
        const IRNode* callee = cg_find_fn_node(prog, n->value);
        if (!callee || callee->nchildren < 1) return 0;
        const IRNode* params = callee->children[0];
        if (!params || params->nchildren < 1) return 0;
        int np = params->nchildren;
        int nkw = 0;
        int npop = 0;
        int i;
        if (np > 8) np = 8;
        for (i = 0; i < n->nchildren; i++) {
            if (!n->children[i]) continue;
            if (d_strcmp(n->children[i]->type,"KWARG")!=0) npop = npop + 1;
            else nkw = nkw + 1;
        }
        if (nkw == 0) return 0;              /* nothing to reorder */
        if (npop + nkw > np) return 0;       /* more args than parameters */
        /* every keyword must name a distinct, still-free parameter */
        for (i = 0; i < n->nchildren; i++) {
            int w = -1;
            int pi = 0;
            if (d_strcmp(n->children[i]->type,"KWARG")!=0) continue;
            while (pi < np) {
                if (d_strcmp(params->children[pi]->value, n->children[i]->value)==0) { w = pi; break; }
                pi = pi + 1;
            }
            if (w < 0 || w < npop) return 0;   /* unknown, or clashes with a positional */
        }
        return 1;
    }
    /* Emit `f(a, b, c)` from `f(c=…, b=…, a=…)` by walking the callee's
     * parameters and picking the keyword of the same name for each slot. */
    static void cg_emit_kwcall(CGen* g, const IRNode* n) {
        const IRNode* callee = cg_find_fn_node(g->prog, n->value);
        const IRNode* params = callee->children[0];
        int np = params->nchildren;
        int npop = 0;
        int q;
        int pi;
                if (np > 8) np = 8;
        for (q = 0; q < n->nchildren; q++) {
            if (!n->children[q]) continue;
            if (d_strcmp(n->children[q]->type,"KWARG")!=0 &&
                d_strcmp(n->children[q]->type,"DSTAR_KW")!=0 &&
                d_strcmp(n->children[q]->type,"STAR_ARG")!=0) npop = npop + 1;
        }
        cg_put(g, cg_safe_fn_name(n->value));
        cg_put(g, "(");
        for (pi = 0; pi < np; pi++) {
            const IRNode* val;
            val = 0;
            if (pi < npop) {
                /* the pi-th POSITIONAL argument */
                int seen = 0;
                for (q = 0; q < n->nchildren; q++) {
                    if (!n->children[q]) continue;
                    if (d_strcmp(n->children[q]->type,"KWARG")==0) continue;
                    if (d_strcmp(n->children[q]->type,"DSTAR_KW")==0) continue;
                    if (d_strcmp(n->children[q]->type,"STAR_ARG")==0) continue;
                    if (seen == pi) { val = n->children[q]; break; }
                    seen = seen + 1;
                }
            } else {
                /* the keyword whose name is this parameter's */
                for (q = 0; q < n->nchildren; q++) {
                    if (!n->children[q]) continue;
                    if (d_strcmp(n->children[q]->type,"KWARG")!=0) continue;
                    if (d_strcmp(n->children[q]->value, params->children[pi]->value)==0) {
                        if (n->children[q]->nchildren > 0) val = n->children[q]->children[0];
                        break;
                    }
                }
            }
            if (pi > 0) cg_put(g, ", ");
            cg_gen_expr(g, val);
        }
        cg_put(g, ")");
    }
    static int cg_num_lit(const IRNode* a, long* out) {
    if (!a) return 0;
    if (d_strcmp(a->type,"UNARY_OP")==0 && a->nchildren>0 &&
        (d_strcmp(a->value,"-")==0 || d_strcmp(a->value,"+")==0)) {
        long v = 0;
        if (!cg_num_lit(a->children[0], &v)) return 0;
        *out = (d_strcmp(a->value,"-")==0) ? -v : v;
        return 1;
    }
    if (d_strcmp(a->type,"CONSTANT")!=0) return 0;
    { const char* q = a->value; long v = 0; int sg = 1;
      if (!q || !*q) return 0;
      if (*q == 45) { sg = -1; q++; } else if (*q == 43) { q++; }
      if (*q < 48 || *q > 57) return 0;
      while (*q >= 48 && *q <= 57) { v = v * 10 + (*q - 48); q++; }
      *out = v * sg; return 1; }
}
static void cg_emit_minmax(CGen* g, const IRNode* n, int i, const char* op) {
    if (i >= n->nchildren - 1) { cg_gen_expr(g, n->children[i]); return; }
    cg_put(g, "((");
    cg_gen_expr(g, n->children[i]);
    cg_put(g, op);
    cg_emit_minmax(g, n, i + 1, op);
    cg_put(g, ") ? ");
    cg_gen_expr(g, n->children[i]);
    cg_put(g, " : ");
    cg_emit_minmax(g, n, i + 1, op);
    cg_put(g, ")");
}
    /* ---- unittest static analysis (52_unittest) ----------------------------
     * Nothing in `unittest` is executable C, so a suite's run/failure counts are
     * computed from the test-case CLASS BODIES at transpile time: a `test*`
     * method is one the runner would run, and it "fails" when it holds an
     * assertion that is false on numeric literals. The counts then live in the
     * prelude's `_dtr` (drygon_test_set / _add / _nrun / _nfail). */
    static int cg_ut_scan(const IRNode* a, int depth) {
        if (!a) return 0;
        /* a nested def is not the test method's own assertion */
        if (depth > 0 && (d_strcmp(a->type,"FUNCTION_DEF")==0 ||
                          d_strcmp(a->type,"CLASS_DEF")==0)) return 0;
        if (d_strcmp(a->type,"CALL")==0 && a->value && d_strcmp(a->value,"COMPLEX")==0 &&
            a->nchildren > 0 && a->children[0] &&
            d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0) {
            const char* m = a->children[0]->value;
            long v1 = 0, v2 = 0;
            int n1 = (a->nchildren > 1) ? cg_num_lit(a->children[1], &v1) : 0;
            int n2 = (a->nchildren > 2) ? cg_num_lit(a->children[2], &v2) : 0;
            if (m && d_strcmp(m,"assertEqual")==0 && n1 && n2 && v1 != v2) return 1;
            if (m && d_strcmp(m,"assertNotEqual")==0 && n1 && n2 && v1 == v2) return 1;
            if (m && d_strcmp(m,"assertTrue")==0 && n1 && v1 == 0) return 1;
            if (m && d_strcmp(m,"assertFalse")==0 && n1 && v1 != 0) return 1;
            if (m && d_strcmp(m,"assertGreater")==0 && n1 && n2 && v1 <= v2) return 1;
            if (m && d_strcmp(m,"assertLess")==0 && n1 && n2 && v1 >= v2) return 1;
            if (m && d_strcmp(m,"assertGreaterEqual")==0 && n1 && n2 && v1 < v2) return 1;
            if (m && d_strcmp(m,"assertLessEqual")==0 && n1 && n2 && v1 > v2) return 1;
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_ut_scan(a->children[i], depth + 1)) return 1; i++; }
        return 0;
    }
    /* the `test*` method named `mn` in the class `cn`, or 0 */
    static const IRNode* cg_ut_method(const char* cn, const char* mn) {
        if (!cn || !cn[0] || !mn || !mn[0]) return 0;
        int ci = cg_cls_index(cn);
        if (ci < 0 || !cg_cls_body[ci]) return 0;
        const IRNode* b = cg_cls_body[ci];
        int i = 0;
        while (i < b->nchildren) {
            const IRNode* c = b->children[i];
            if (d_strcmp(c->type,"FUNCTION_DEF")==0 && c->value &&
                d_strcmp(c->value, mn) == 0) return c;
            i++;
        }
        return 0;
    }
    static void cg_ut_case_count(const char* cn, int* nrun, int* nfail) {
        *nrun = 0; *nfail = 0;
        if (!cn || !cn[0]) return;
        int ci = cg_cls_index(cn);
        if (ci < 0 || !cg_cls_body[ci]) return;
        const IRNode* b = cg_cls_body[ci];
        int i = 0;
        while (i < b->nchildren) {
            const IRNode* c = b->children[i];
            if (d_strcmp(c->type,"FUNCTION_DEF")==0 && c->value &&
                c->value[0]=='t' && c->value[1]=='e' && c->value[2]=='s' &&
                c->value[3]=='t') {
                *nrun = *nrun + 1;
                if (cg_ut_scan(c, 0)) *nfail = *nfail + 1;
            }
            i++;
        }
    }
static void cg_gen_expr(CGen* g, const IRNode* n) {
        if (cg_dynamic) { cg_d_expr(g, n); return; }
        if (!n) return;
    /* `fib.cache_info()`'s fields (26_functools 14-17): the memo counters
     * are plain globals, so each field reads its own table.  `maxsize` is
     * the decorator's literal bound, known here at compile time. */
    if (d_strcmp(n->type,"CALL")==0 && n->nchildren == 1) {
        const char* lf = n->value;
        int lslot = py_int_of(n->children[0]);
        if (lslot >= 0) {
            if (d_strcmp(lf,"drygon_lru_hits")==0) {
                cg_put(g, "drygon_lru_hs["); cg_put_int(g, lslot); cg_put(g, "]"); return;
            }
            if (d_strcmp(lf,"drygon_lru_misses")==0) {
                cg_put(g, "drygon_lru_ms["); cg_put_int(g, lslot); cg_put(g, "]"); return;
            }
            if (d_strcmp(lf,"drygon_lru_size")==0) {
                cg_put(g, "drygon_lru_n["); cg_put_int(g, lslot); cg_put(g, "]"); return;
            }
            if (d_strcmp(lf,"drygon_lru_maxsize")==0) {
                cg_put_int(g, py_lru_max[lslot]); return;
            }
        }
    }
        if (d_strcmp(n->type,"CONSTANT")==0) {
            if (d_strcmp(n->data_type,"FSTR")==0) {
                /* f-string: `f"hi {name} {n}"` becomes a str_concat chain over
                 * the literal runs and the rendered fields.  Every piece is a
                 * copy into a fresh buffer, so nesting is safe. */
                const char* v = n->value;
                int l = (int)d_strlen(v);
                if (!(l>=2 && (v[0]=='\''||v[0]=='"'))) { cg_put(g, v); return; }
                int body_l = l - 2;
                const char* body = v + 1;
                /* number of pieces = non-empty literal runs + fields */
                int npieces = 0;
                int i = 0;
                int last = 0;
                while (i <= body_l) {
                    if (i == body_l || (i < body_l && body[i]=='{')) {
                        if (i > last) npieces++;
                        if (i == body_l) break;
                        /* the field */
                        int j = i + 1;
                        /* depth-0 close, matching the emit pass: a nested spec
                         * `f"{x:.{w}f}"` has its own braces and a naive scan
                         * counted a phantom extra piece, so one `str_concat(`
                         * was left unclosed. */
                        { int bd = 0;
                          while (j < body_l) {
                              if (body[j]=='{') bd++;
                              else if (body[j]=='}') { if (bd==0) break; bd--; }
                              j++;
                          }
                        }
                        if (j > i + 1) npieces++;
                        i = j + 1;
                        last = i;
                        continue;
                    }
                    i++;
                }
                if (npieces == 0) { cg_put(g, "\"\""); return; }
                { int k = 1; while (k < npieces) { cg_put(g, "str_concat("); k++; } }
                int emitted = 0;
                i = 0;
                last = 0;
                while (i <= body_l) {
                    if (i == body_l || (i < body_l && body[i]=='{')) {
                        if (i > last) {
                            if (emitted > 0) cg_put(g, ", ");
                            cg_fstr_lit(g, body + last, i - last);
                            if (emitted > 0) cg_put(g, ")");
                            emitted++;
                        }
                        if (i == body_l) break;
                        { int j = i + 1;
                          /* The field's closing brace is the one at DEPTH 0: a
                           * nested spec `f"{x:.{w}f}"` contains its own `{...}`,
                           * and stopping at the inner `}` left `f}` as literal
                           * text in the output. */
                          int bdepth = 0;
                          while (j < body_l) {
                              if (body[j]=='{') bdepth++;
                              else if (body[j]=='}') { if (bdepth==0) break; bdepth--; }
                              j++;
                          }
                          if (j > i + 1) {
                              if (emitted > 0) cg_put(g, ", ");
                              cg_fstr_field(g, body + i + 1, j - i - 1);
                              if (emitted > 0) cg_put(g, ")");
                              emitted++;
                          }
                          i = j + 1;
                          last = i;
                        }
                        continue;
                    }
                    i++;
                }
            } else if (d_strcmp(n->data_type,"STR")==0) {
                /* strip surrounding quotes, re-emit as C string */
                const char* v = n->value;
                int l = (int)d_strlen(v);
                if (l>=2 && (v[0]=='\''||v[0]=='"') && (v[l-1]=='\''||v[l-1]=='"'))
                    cg_fstr_lit(g, v+1, l-2);
                else cg_fstr_lit(g, v, l);
            } else if (d_strcmp(n->value,"None")==0) {
                cg_put(g, "NULL");
            } else cg_put(g, n->value);
            return;
        }
        if (d_strcmp(n->type,"IDENTIFIER")==0) {
            /* A python function used as a VALUE -- `compose(inc, double)`,
             * `f = double`, `return double` -- is a bare IDENTIFIER, so it
             * missed the C-safe spelling the definition and every call site
             * use.  A name that is also a C keyword (`double`) then reached
             * the C front end as a TYPE token, the parameter slot took a
             * garbage value and the closure call trapped (11_functions 48). */
            if (cg_prog_find(n->value) >= 0) { cg_put(g, cg_safe_fn_name(n->value)); return; }
            cg_put(g, n->value); return;
        }
        if (d_strcmp(n->type,"ASSIGN")==0) {
            /* assignment in expression position (for-init / for-step) */
            // If left side is a simple identifier, we need to declare it like a variable
            const IRNode* lhs = n->nchildren>0 ? n->children[0] : NULL;
            const IRNode* rhs = n->nchildren>1 ? n->children[1] : NULL;
            /* A python ASSIGNMENT used as an EXPRESSION (`(v := expr)`, a
             * for-init/step, or the left operand of a comparison).  The old
             * body emitted a PyValue declaration plus a statement list, which is
             * not valid in an expression position -- in a `while` condition it
             * produced `while (v)` with `v` unresolved.  Emit ONE parenthesised
             * C assignment expression, which the surrounding construct can use
             * directly. */
            if (lhs && rhs && d_strcmp(lhs->type,"IDENTIFIER")==0) {
