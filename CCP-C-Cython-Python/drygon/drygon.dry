99; } }\nreturn dfsp_cat2(prefix, dfsp_dup(dfsp_namebuf)); }\nchar* drygon_fs_mkdtemp_in(char* base, char* prefix) {\nint a = 0;\nwhile (a < 500) {\nchar* nm = dfsp_randname(prefix);\nchar* full = dfsp_join_raw(base, nm);\nif (drygon_fs_mkdir(full) == 0) return full;\na = a + 1;\n}\nreturn dfsp_dup(\"\"); }\nchar* drygon_fs_mkdtemp(char* prefix) { return drygon_fs_mkdtemp_in(drygon_fs_tempdir(), prefix); }\nchar* drygon_fs_mktemp_in(char* base, char* prefix, char* suffix) {\nint a = 0;\nwhile (a < 500) {\nchar* nm = dfsp_cat2(dfsp_randname(prefix), suffix);\nchar* full = dfsp_join_raw(base, nm);\nif (drygon_fs_exists(full) == 0) return full;\na = a + 1;\n}\nreturn dfsp_dup(\"\"); }\nchar* drygon_fs_mktemp(char* prefix, char* suffix) { return drygon_fs_mktemp_in(drygon_fs_tempdir(), prefix, suffix); }\nint drygon_fs_rename(char* a, char* b) { return (int)dsp_get(38, -100, (long)a, -100, (long)b, 0, 0); }\nlong drygon_fs_mtime(char* path) { long r = drygon_fs_rawstat(path); if (r < 0) return 0; return *(long*)(dfsp_statb + 88); }\nchar* drygon_fs_which(char* nm) { return dsp_which(nm); }\nint drygon_fs_fdopen(char* path, int fl, int mode) { return (int)dsp_get(56, -100, (long)path, fl, mode, 0, 0); }\nint drygon_fs_fdclose(int fd) { return (int)dsp_get(57, fd, 0, 0, 0, 0, 0); }\nint drygon_fs_fdwrite(int fd, char* s) { return (int)dsp_get(64, fd, (long)s, dfsp_len(s), 0, 0, 0); }\nchar* drygon_fs_fdread(int fd) { return dsp_readall(fd); }\nchar* drygon_fs_readlink(char* path) {\nint r = (int)dsp_get(78, -100, (long)path, (long)dfsp_dirb, 4000, 0, 0);\nif (r <= 0) return dfsp_dup(\"\");\ndfsp_dirb[r] = 0;\nreturn dfsp_dup(dfsp_dirb); }\nint drygon_all_int(int* a, int n) { int i = 0; while (i < n) { if (a[i] == 0) return 0; i = i + 1; } return 1; }\nint drygon_any_int(int* a, int n) { int i = 0; while (i < n) { if (a[i] != 0) return 1; i = i + 1; } return 0; }\nint drygon_all_dbl(double* a, int n) { int i = 0; while (i < n) { if (a[i] == 0.0) return 0; i = i + 1; } retu