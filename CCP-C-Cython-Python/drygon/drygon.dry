                 * class -- `not isinstance("hello", Animal)`, 34_abc 10).  The
                 * permissive run-time stub still answers the unknown cases. */
                const IRNode* isn_v = n->children[0];
                const char* isn_c = 0;
                if (isn_v && d_strcmp(isn_v->type,"IDENTIFIER")==0) isn_c = cg_cvar_class(isn_v->value);
                if (isn_c && isn_c[0]) {
                    cg_put(g, cg_cls_issub(isn_c, n->children[1]->value, 0) ? "1" : "0");
                } else if (isn_v && d_strcmp(isn_v->type,"CONSTANT")==0) {
                    cg_put(g, "0");
                } else {
                    cg_put(g, "isinstance("); cg_gen_expr(g, isn_v);
                    cg_put(g, ", 0)");
                }
            } else if (d_strcmp(n->value,"len")==0 && n->nchildren==1) {
                /* len() of a known list is a compile-time constant; of a
                 * anything else it is the C string length. */
                const IRNode* a = n->children[0];
                int ls = (a && d_strcmp(a->type,"IDENTIFIER")==0) ? cg_list_size(a->value) : -1;
                /* len(instance) dispatches to the class' __len__ */
                /* native memoryview (53_memoryview): a view's length is its
                 * element count, and the 1-D shape/strides are one element. */
