    static PyValue py_pow(PyValue a, PyValue b) {
        if (a.kind == PYV_INT && b.kind == PYV_INT) {
            // Handle negative exponents
            if (b.u.i < 0) {
                // For negative integer exponents, return float result
                double base = pyv_as_f(a);
                double exp = pyv_as_f(b);
                return pyv_float(pow(base, exp));
            }
            // For non-negative integer exponents, use integer math
            long long result = 1;
            long long base = a.u.i;
            long long exp = b.u.i;
            while (exp > 0) {
                if (exp & 1) result *= base;
                base *= base;
                exp >>= 1;
            }
        }
        // Fallback to float for mixed types or non-integer exponents
        return pyv_float(pow(pyv_as_f(a), pyv_as_f(b)));
