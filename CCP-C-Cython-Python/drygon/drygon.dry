    static void cg_sl_tsort(CGen* g, const IRNode* sl, const char* dst) {
        const IRNode* b = sl->children[0];
        char src[64];
        if (!cg_trow_src_name(b, src)) return;
        int lit = (b && d_strcmp(b->type,"IDENTIFIER")!=0 && cg_is_list_node(b));
        int bits = cg_list_kybits(src);
        int isk = cg_sl_issorted(sl);
