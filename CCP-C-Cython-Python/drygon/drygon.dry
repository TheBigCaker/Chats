    /* `list(obj)` / `for x in obj` for a class that implements the iterator
     * protocol the python way: `__iter__` returns `self`, `__next__` hands out
     * the values and raises StopIteration when it is done.  The eager generator
     * path cannot serve that shape -- `__iter__` returns the instance instead of
     * filling the shared result buffer, so the buffer stayed empty and the loop
     * body never ran (20_advanced 10, 60_comprehensive 1).
     *
     * The values are gathered in a LOCAL buffer rather than `drygon_rl`:
     * that global is only declared when some function actually returns a list,
     * so a program whose only iterator is a class would write through an
     * undeclared name.
     *
     * Emits, inside the caller's block:
     *   int <vb>[512]; int <vn> = 0;
     *   while (!pyx_pendq()) { pyx_clear(); int <tv> = <cls>___next__(&<inst>);
     *       if (pyx_pendq()) { pyx_clear(); break; }
     *       <vb>[<vn>] = <tv>; <vn> = <vn> + 1; }
     * and leaves the caller to walk <vb>/<vn>.  `cls` is the class that
     * DEFINES `__next__`; the instance may be a subclass of it. */
    static void cg_iter_fill(CGen* g, const char* cls, const char* inst,
                             const char* vb, const char* vn, const char* tv) {
        cg_indent(g);
        cg_put(g, "int "); cg_put(g, vb); cg_put(g, "[512]; int ");
        cg_put(g, vn); cg_put(g, " = 0;\n");
        cg_indent(g);
        cg_put(g, "while (!pyx_pendq()) { pyx_clear(); int ");
        cg_put(g, tv); cg_put(g, " = "); cg_put(g, cls); cg_put(g, "___next__(&");
        cg_put(g, inst);
        cg_put(g, "); if (pyx_pendq()) { pyx_clear(); break; } ");
        cg_put(g, vb); cg_put(g, "["); cg_put(g, vn); cg_put(g, "] = ");
        cg_put(g, tv); cg_put(g, "; "); cg_put(g, vn);
        cg_put(g, " = "); cg_put(g, vn); cg_put(g, " + 1; }\n");
    }
    /* The five scratch names one `cg_iter_fill` site needs: the value buffer,
     * its count, the per-step temp, the walk index and (for `list(obj)`, which
     * has to copy the buffer into the target) a copy index.  Base 70000 keeps
     * them clear of the per-class scratch names (`_gcs`/`_gct`) and of the
     * iterator instance names (base 100).  Pure function of `serial` so the
     * caller owns the counter. */
    static void cg_iter_names(int serial, char* vb, char* vn, char* tv,
                              char* ix, char* ij) {
        cg_scratch_name(70000 + serial * 5, vb);
        cg_scratch_name(70001 + serial * 5, vn);
        cg_scratch_name(70002 + serial * 5, tv);
        cg_scratch_name(70003 + serial * 5, ix);
        cg_scratch_name(70004 + serial * 5, ij);
    }
    /* A struct assignment used as a SUB-expression is dropped by the C backend
     * (`(g = f(), eq(&g, &q))` compared garbage), while a statement-level one
     * works.  These helpers do the assignment in a statement and hand the
     * scratch back, so `dt.date() == d` can feed the dunder a real object. */
    static void cg_num_suffix(const char* pre, int i, char* out) {
        char dg[8];
        int k = 0;
        int n = i;
        int p = 0;
        while (pre[p]) { out[p] = pre[p]; p++; }
        if (n == 0) { dg[k] = '0'; k++; }
        while (n > 0 && k < 7) { dg[k] = (char)('0' + (n % 10)); n = n / 10; k++; }
        int j = 0;
        while (j < k) { out[p + j] = dg[k - 1 - j]; j++; }
        out[p + k] = 0;
    }
    static void cg_tmp1_name(int i, char* out) { cg_num_suffix("_gt1", i, out); }
    static void cg_tmp2_name(int i, char* out) { cg_num_suffix("_gt2", i, out); }
    /* One class' scratch storage plus its two statement-level store helpers.
     * It MUST be emitted right after that class' own typedef and therefore
     * BEFORE every method body that uses it: a file-scope object referenced
     * textually before its declaration is not resolved by the C front end, so
     * the reference became garbage and the method segfaulted (`DictReader`
     * stored a `reader()` into `self._r`, probe a5/q1). */
    static char cg_gs_done[128];
    static void cg_scratch_emit(CGen* g, int gi) {
        if (gi < 0 || gi >= cg_gs_n) return;
        if (cg_gs_done[gi]) return;
        cg_gs_done[gi] = 1;
        {
            char gsb[32];
            char gtb[32];
            char h1[32];
            char h2[32];
            cg_scratch_name(gi, gsb);
            cg_put(g, "static "); cg_put(g, cg_gs_cls[gi]);
            cg_put(g, " "); cg_put(g, gsb); cg_put(g, ";\n");
            if (gi < cg_gt_n) {
                cg_scratch2_name(gi, gtb);
                cg_put(g, "static "); cg_put(g, cg_gt_cls[gi]);
                cg_put(g, " "); cg_put(g, gtb); cg_put(g, ";\n");
            }
            /* statement-level store, so an operand that is a METHOD CALL
             * (`dt.date()`) can be handed to the dunder */
            cg_tmp1_name(gi, h1);
            cg_put(g, "static "); cg_put(g, cg_gs_cls[gi]);
            cg_put(g, "* "); cg_put(g, h1); cg_put(g, "(");
            cg_put(g, cg_gs_cls[gi]); cg_put(g, " v) { ");
            cg_put(g, gsb); cg_put(g, " = v; return &");
            cg_put(g, gsb); cg_put(g, "; }\n");
            if (gi < cg_gt_n) {
                cg_tmp2_name(gi, h2);
                cg_put(g, "static "); cg_put(g, cg_gt_cls[gi]);
                cg_put(g, "* "); cg_put(g, h2); cg_put(g, "(");
                cg_put(g, cg_gt_cls[gi]); cg_put(g, " v) { ");
                cg_put(g, gtb); cg_put(g, " = v; return &");
                cg_put(g, gtb); cg_put(g, "; }\n");
            }
        }
    }
    /* Register every class that could own a scratch instance BEFORE any body
     * is emitted, so the class emitter can declare it in the right place.
     * Same predicate the emission loop used to apply inline. */
    static int cg_scratch_need(const char* gcn) {
        if (!gcn || !gcn[0]) return 0;
        return cg_cls_find_m(gcn,"__bool__") || cg_cls_find_m(gcn,"__eq__") ||
               cg_cls_find_m(gcn,"__ne__") || cg_cls_find_m(gcn,"__lt__") ||
               cg_cls_find_m(gcn,"__le__") || cg_cls_find_m(gcn,"__ge__") ||
               cg_cls_find_m(gcn,"__call__") || cg_cls_hasm(gcn,"__init__");
    }
    static const IRNode* cg_prog_class(const IRNode* prog, const char* nm) {
        if (!prog || !nm || !nm[0]) return 0;
        int i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"CLASS_DEF")==0 && n->value && d_strcmp(n->value,nm)==0)
                return n;
            i++;
        }
        return 0;
    }
    /* Does this class need a scratch instance?  Reads the IR instead of the
     * class registry on purpose: `cg_cls_names`/`cg_cls_nmeth` are only filled
     * while classes are being EMITTED, so the registry was still empty here and
     * nothing was ever pre-registered -- every scratch declaration ended up in
     * the catch-up block after all method bodies, i.e. after its first use
     * (`static Inner _gcs0;` below `Outer___init__`), which the C front end
     * resolves to garbage and the program segfaults on. */
    static int cg_scratch_need_ir(const IRNode* prog, const IRNode* cd, int depth) {
        if (!cd || !cd->value || !cd->value[0] || cd->nchildren < 1 || depth > 4) return 0;
        const IRNode* b = cd->children[0];
        if (b) {
            int i = 0;
            while (i < b->nchildren) {
                const IRNode* m = b->children[i];
                if (d_strcmp(m->type,"FUNCTION_DEF")==0 && m->value && m->value[0] &&
                    (d_strcmp(m->value,"__init__")==0 || d_strcmp(m->value,"__bool__")==0 ||
                     d_strcmp(m->value,"__eq__")==0 || d_strcmp(m->value,"__ne__")==0 ||
                     d_strcmp(m->value,"__lt__")==0 || d_strcmp(m->value,"__le__")==0 ||
                     d_strcmp(m->value,"__ge__")==0 || d_strcmp(m->value,"__call__")==0))
                    return 1;
                i++;
            }
        }
        /* an inherited dunder counts too (`class B(A)` with no `__init__`) */
        int s = 0;
        int k = 0;
        while (cd->data_type[s] && k < 3) {
            char bb[64];
            int e = s;
            int p = 0;
            while (cd->data_type[e] && cd->data_type[e] != ',') e++;
            while (s + p < e && p < 63) { bb[p] = cd->data_type[s + p]; p++; }
            bb[p] = 0;
            if (p > 0 && d_strcmp(bb,"ANY")!=0) {
                const IRNode* bcd = cg_prog_class(prog, bb);
                if (bcd && bcd != cd && cg_scratch_need_ir(prog, bcd, depth + 1)) return 1;
            }
            if (!cd->data_type[e]) break;
            s = e + 1;
            k++;
        }
        return 0;
    }
    static void cg_scratch_pre(const IRNode* prog) {
        if (!prog) return;
        int i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"CLASS_DEF")==0 && n->value && n->value[0] &&
                cg_scratch_need_ir(prog, n, 0)) {
                cg_scratch_cls(n->value);
                cg_scratch2_cls(n->value);
            }
            i++;
        }
    }
    /* String-valued names seen so far. print() has to pick %s or %d for a bare
     * identifier and the Python IR carries no types, so remember which locals
     * were assigned a string literal. */
    static char cg_str_vars[16384]; /* up to 256 string-valued names, 64 bytes each.
                                     * Kept flat and indexed byte-wise: the direct
                                     * compiler mishandles 2-D rows as char*, pointer
                                     * variables into statics and calls nested in calls. */
    static int cg_nstr_vars;
    static void cg_note_str(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nstr_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_str_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return;
            i++;
        }
        if (cg_nstr_vars < 256) {
            int base = cg_nstr_vars * 64;
            int j = 0;
            while (name[j] && j < 63) { cg_str_vars[base + j] = name[j]; j++; }
            cg_str_vars[base + j] = 0;
            cg_nstr_vars = cg_nstr_vars + 1;
        }
    }
    /* Parameter names whose `def` default is a string literal, e.g.
     * `def __init__(self, initial_value="")`.  Python leaves such a default in
     * place when the call site omits the argument, so no call-site note is ever
     * taken and the parameter -- plus every field it is stored into -- would be
     * typed int and truncate the pointer. */
    static char cg_sd_names[16384];
    static int cg_nsd_names;
    static void cg_sd_note(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nsd_names) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_sd_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return;
            i++;
        }
        if (cg_nsd_names >= 256) return;
        int base = cg_nsd_names * 64;
        int k = 0;
        while (k < 63 && name[k]) { cg_sd_names[base + k] = name[k]; k++; }
        cg_sd_names[base + k] = 0;
        cg_nsd_names = cg_nsd_names + 1;
    }
    static int cg_is_strdef_param(const char* name) {
        if (!name || !name[0]) return 0;
        int i = 0;
        while (i < cg_nsd_names) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_sd_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static void cg_scan_str_defaults(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"PARAM_DECL")==0 && a->nchildren > 0 &&
            cg_node_is_str_static(a->children[0]))
            cg_sd_note(a->value);
        int i = 0;
        while (i < a->nchildren) { cg_scan_str_defaults(a->children[i]); i++; }
        return;
    }
    /* A parameter concatenated with a string -- `self.data = self.data + s` --
     * is a `char*`.  No call site has to pass a literal for the concat to give
     * the parameter away, so this is what types `StringIO.write`'s `s`. */
    static int cg_param_in_str_concat(const IRNode* nn, const char* nm) {
        if (!nn) return 0;
        if (d_strcmp(nn->type,"BINARY_OP")==0 && d_strcmp(nn->value,"+")==0 &&
            nn->nchildren > 1) {
            const IRNode* l = nn->children[0];
            const IRNode* r = nn->children[1];
            int lis = d_strcmp(l->type,"IDENTIFIER")==0 && d_strcmp(l->value,nm)==0;
            int ris = d_strcmp(r->type,"IDENTIFIER")==0 && d_strcmp(r->value,nm)==0;
            if (lis && !ris && cg_is_str_node(r)) return 1;
            if (ris && !lis && cg_is_str_node(l)) return 1;
        }
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_param_in_str_concat(nn->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    /* A parameter compared against a string constant (`spec == "short"`).  The
     * method parameter `Person.__format__`'s `spec` was typed `int`, so the
     * comparison tested a truncated pointer against the literal's address and
     * the custom format spec never matched (60_comprehensive check 24). */
    static int cg_param_cmp_str(const IRNode* nn, const char* nm) {
        if (!nn || !nm || !nm[0]) return 0;
        if (d_strcmp(nn->type,"BINARY_OP")==0 && nn->nchildren > 1 &&
            (d_strcmp(nn->value,"==")==0 || d_strcmp(nn->value,"!=")==0)) {
            const IRNode* l = nn->children[0];
            const IRNode* r = nn->children[1];
            int lis = d_strcmp(l->type,"IDENTIFIER")==0 && d_strcmp(l->value,nm)==0;
            int ris = d_strcmp(r->type,"IDENTIFIER")==0 && d_strcmp(r->value,nm)==0;
            if (lis && !ris && cg_is_str_node(r)) return 1;
            if (ris && !lis && cg_is_str_node(l)) return 1;
        }
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_param_cmp_str(nn->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    /* A parameter handed to one of the runtime's own string/path primitives --
     * `drygon_fread(path)`, `sys_openat(-100, path, ...)` -- is a `char*`.  The
     * syscall wrappers take a pointer, so a parameter that only ever appeared in
     * such a call was typed `int` and the path was truncated to its low word
     * (`io.File.path`, and every `_ioch_exists(path)` call behind it). */
    static int cg_pns_argi(const char* fn) {
        if (!fn) return -1;
        if (d_strcmp(fn,"drygon_fread")==0) return 0;
        if (d_strcmp(fn,"drygon_fwrite")==0) return 0;
        if (d_strcmp(fn,"drygon_strlen")==0) return 0;
        if (d_strcmp(fn,"drygon_replace")==0) return -2;
        if (d_strcmp(fn,"replace")==0) return -2;
        if (d_strcmp(fn,"drygon_str_replace")==0) return -2;
        if (d_strcmp(fn,"drygon_streq")==0) return -2;
        if (d_strcmp(fn,"drygon_strcpy")==0) return 0;
        if (d_strcmp(fn,"sys_openat")==0) return 1;
        if (d_strcmp(fn,"sys_unlinkat")==0) return 1;
        if (d_strcmp(fn,"sys_mkdirat")==0) return 1;
        if (d_strcmp(fn,"sys_newfstatat")==0) return 1;
        if (d_strcmp(fn,"sys_readlinkat")==0) return -2;
        if (d_strcmp(fn,"sys_execve")==0) return 0;
        /* native path/filesystem primitives: index of the `char*` argument
         * (-2 = any argument may carry the string) */
        if (d_strcmp(fn,"drygon_fs_mkdtemp_in")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_mktemp_in")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_mktemp")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_match")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_glob")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_rglob")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_rename")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_write")==0) return -2;
        if (d_strcmp(fn,"drygon_path_join")==0) return -2;
        if (d_strcmp(fn,"drygon_path_eq")==0) return -2;
        if (d_strcmp(fn,"drygon_path_with_suffix")==0) return -2;
        if (d_strcmp(fn,"drygon_path_with_name")==0) return -2;
        if (d_strcmp(fn,"drygon_fs_getcwd")==0) return -1;
        if (d_strcmp(fn,"drygon_fs_tempdir")==0) return -1;
        if (d_strcmp(fn,"drygon_fs_getpid")==0) return -1;
        if (d_strcmp(fn,"drygon_fs_fdread")==0) return -1;
        if (d_strcmp(fn,"drygon_fs_rawstat")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_mode")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_size")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_exists")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_isdir")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_isfile")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_islink")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_mkdir")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_mkdirp")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_rmdir")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_unlink")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_listdir")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_rmtree")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_read")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_mkdtemp")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_mtime")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_which")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_readlink")==0) return 0;
        if (d_strcmp(fn,"drygon_fs_fdopen")==0) return 0;
        if (d_strcmp(fn,"drygon_path_sub")==0) return 0;
        if (d_strcmp(fn,"drygon_path_normalize")==0) return 0;
        if (d_strcmp(fn,"drygon_path_name")==0) return 0;
        if (d_strcmp(fn,"drygon_path_parent")==0) return 0;
        if (d_strcmp(fn,"drygon_path_stem")==0) return 0;
        if (d_strcmp(fn,"drygon_path_suffix")==0) return 0;
        if (d_strcmp(fn,"drygon_path_seg")==0) return 0;
        if (d_strcmp(fn,"drygon_path_part")==0) return 0;
        if (d_strcmp(fn,"drygon_path_isabs")==0) return 0;
        if (d_strcmp(fn,"drygon_path_len")==0) return 0;
        if (d_strcmp(fn,"drygon_path_charis")==0) return 0;
        if (d_strcmp(fn,"drygon_path_nparts")==0) return 0;
        return -1;
    }
    static int cg_param_needs_str(const IRNode* nn, const char* nm) {
        if (!nn || !nm || !nm[0]) return 0;
        if (d_strcmp(nn->type,"CALL")==0) {
            /* `s.replace(...)` arrives as a call whose value is COMPLEX and
             * whose receiver carries the method name, so the primitive table
             * has to be asked about the METHOD, with the arguments starting
             * one child later. */
            const char* fn = nn->value;
            int ab = 0;
            if (fn && d_strcmp(fn,"COMPLEX")==0 && nn->nchildren>0 && nn->children[0] &&
                d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0) {
                fn = nn->children[0]->value;
                ab = 1;
            }
            int ai = cg_pns_argi(fn);
            if (ai >= 0 || ai == -2) {
                int i = 0;
                while (i < nn->nchildren) {
                    const IRNode* a = nn->children[i];
                    if (a && d_strcmp(a->type,"IDENTIFIER")==0 &&
                        d_strcmp(a->value,nm)==0 && (ai == -2 || i == ai + ab)) return 1;
                    i++;
                }
            }
        }
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_param_needs_str(nn->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    /* A parameter the body only FORWARDS to a class method whose matching
     * parameter is a string.  `StreamHandler.emit(self, levelname, message)`
     * passed both straight on to `Formatter.format`, whose parameters are
     * `char*` (they go through drygon_replace); without this the caller's
     * parameters stayed `int` and the formatted line printed the low word of
     * each pointer (51_logging). */
    static int cg_param_fwd_depth = 0;
    static int cg_param_fwd_str(const char* cls, const IRNode* nn, const char* nm) {
        if (!nn || !nm || !nm[0]) return 0;
        if (cg_param_fwd_depth > 6) return 0;
        if (d_strcmp(nn->type,"CALL")==0 && nn->nchildren>1 && nn->children[0] &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->value && nn->children[0]->value[0] &&
            nn->children[0]->nchildren>0 && nn->children[0]->children[0]) {
            const IRNode* rob = nn->children[0]->children[0];
            const char* rcls = 0;
            if (d_strcmp(rob->type,"IDENTIFIER")==0) rcls = cg_lf_recv_cls(rob);
            else if (d_strcmp(rob->type,"MEMBER_ACCESS")==0 && rob->value &&
                     rob->nchildren>0 && rob->children[0] &&
                     d_strcmp(rob->children[0]->type,"IDENTIFIER")==0 &&
                     d_strcmp(rob->children[0]->value,"self")==0) {
                /* `self.<field>.method(...)` -- the field's class comes from
                 * the object-field registry (`self.formatter = formatter`) */
                const char* of = cg_of_get(cls, rob->value);
                if (of && of[0]) rcls = of;
            }
            if (rcls && rcls[0]) {
                const char* dc = cg_cls_find_m(rcls, nn->children[0]->value);
                if (!dc || !dc[0]) dc = rcls;
                int ci = cg_cls_index(dc);
                const IRNode* cb = (ci >= 0) ? cg_cls_body[ci] : NULL;
                const IRNode* mnode = NULL;
                int k = 0;
                while (cb && k < cb->nchildren) {
                    const IRNode* m = cb->children[k];
                    if (m && d_strcmp(m->type,"FUNCTION_DEF")==0 && m->value &&
                        d_strcmp(m->value, nn->children[0]->value)==0 && m->nchildren>1) {
                        mnode = m; break;
                    }
                    k++;
                }
                if (mnode) {
                    const IRNode* ps = mnode->children[0];
                    int j = 0;
                    int ai = 1;
                    while (ai < nn->nchildren) {
                        const IRNode* a = nn->children[ai];
                        if (a && d_strcmp(a->type,"IDENTIFIER")==0 && a->value &&
                            d_strcmp(a->value, nm)==0 && ps) {
                            int seen = 0;
                            int pk = 0;
                            while (pk < ps->nchildren) {
                                const IRNode* p = ps->children[pk];
                                if (p && p->value && d_strcmp(p->value,"self")!=0) {
                                    if (seen == j) {
                                        cg_param_fwd_depth++;
                                        int hit = cg_param_needs_str(mnode->children[1], p->value) ||
                                                  cg_param_fwd_str(dc, mnode->children[1], p->value);
                                        cg_param_fwd_depth--;
                                        if (hit) return 1;
                                        break;
                                    }
                                    seen++;
                                }
                                pk++;
                            }
                        }
                        j++;
                        ai++;
                    }
                }
            }
        }
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_param_fwd_str(cls, nn->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    /* Drop a name from the string table: python allows `s = "hi"` followed by
     * `s = 42`, and a stale entry would keep printing it with %s. */
    static void cg_forget_str(const char* name) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nstr_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_str_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) {
                int last = (cg_nstr_vars - 1) * 64;
                int k = 0;
                while (k < 64) { cg_str_vars[base + k] = cg_str_vars[last + k]; k++; }
                cg_nstr_vars = cg_nstr_vars - 1;
                return;
            }
            i++;
        }
    }
    /* Parameters bound to a python list inside the function being emitted.
     * Python lists arrive as an element pointer plus a companion count, so the
     * body must learn which names carry that pair and what the elements are:
     * 0 int, 1 double, 2 char*. */
    static char cg_lp_names[2048]; /* up to 32 names, 64 bytes each */
    static int cg_lp_flag[32];
    static int cg_nlp_vars;
    static void cg_note_lparam(const char* name, int isf) {
        if (!name || !name[0]) return;
        if (cg_nlp_vars >= 32) return;
        int base = cg_nlp_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_lp_names[base + j] = name[j]; j++; }
        cg_lp_names[base + j] = 0;
        cg_lp_flag[cg_nlp_vars] = isf;
        cg_nlp_vars = cg_nlp_vars + 1;
    }
    static int cg_is_lparam(const char* name) {
        if (!name) return 0;
        int i = 0;
        while (i < cg_nlp_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_lp_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static int cg_lparam_type(const char* name) {
        if (!name) return 0;
        /* Newest note wins: a name is re-noted for every signature variant, so
         * scanning back to front yields the variant currently being emitted
         * (`xs` is a `double` list in one variant and an `int` list in the
         * next; the first-match search always returned the stale type). */
        int i = cg_nlp_vars - 1;
        while (i >= 0) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_lp_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return cg_lp_flag[i];
            i--;
        }
        return 0;
    }
    /* Is there ANY note for `name`?  `cg_lparam_type` answers 0 both for an
     * `int` list and for a name that was never noted, and a reader that treats
     * the 0 as "int list" types the field from a parameter the signature pass
     * never saw: `DictReader.__init__(self, f, fieldnames=[], ...)` is always
     * called without `fieldnames`, so the list field was declared `int` and
     * held one column name per slot truncated into the word (50_csv). */
    static int cg_lparam_known(const char* name) {
        if (!name || !name[0]) return 0;
        int i = cg_nlp_vars - 1;
        while (i >= 0) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_lp_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i--;
        }
        return 0;
    }
    static int cg_is_lparam_float(const char* name) {
        return cg_lparam_type(name) == 1;
    }
    /* Parameters bound to a `*args` COLLECTOR inside the function being emitted.
     * A collector parameter receives `int* args, int args_n` -- it has no
     * backing array of its own, so a call that forwards it (`g(*args)`) has to
     * name it explicitly; every other `*x` unpack reads a list variable's
     * elements. */
    static char cg_vp_names[2048];
    static int cg_nvp_vars;
    static void cg_note_vparam(const char* name) {
        if (!name || !name[0]) return;
        if (cg_nvp_vars >= 32) return;
        int base = cg_nvp_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_vp_names[base + j] = name[j]; j++; }
        cg_vp_names[base + j] = 0;
        cg_nvp_vars = cg_nvp_vars + 1;
    }
    static int cg_is_vparam(const char* name) {
        if (!name) return 0;
        int i = cg_nvp_vars - 1;
        while (i >= 0) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_vp_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i--;
        }
        return 0;
    }
    /* ── counted list FIELDS ────────────────────────────────────────────────
     * A field holding a python list is an inline `int f[64]` member plus a
     * runtime `f_n` count -- exactly what a script-level list uses.  The member
     * operator depends on the receiver (`self->f` for the receiver pointer,
     * `c.f` for a struct value), so every lowering goes through cg_lf_put.
     * The generic member assign used to emit `self->f = ((int[]){0})`: a
     * block-scoped compound literal that dangled as soon as the statement
     * ended, with the count never written, so `len(self.f)` read stack garbage
     * and `self.f.append(v)` went out verbatim and segfaulted. */
    static int cg_lf_kind(const char* cls, const char* f);
    static void cg_lf_sep(CGen* g, const IRNode* obj) {
        if (obj && obj->value && obj->nchildren == 0 &&
            (d_strcmp(obj->value,"self")==0 ||
             (d_strcmp(obj->type,"IDENTIFIER")==0 && cg_is_clsptr(obj->value)))) {
            cg_put(g, "->");
        } else {
            cg_put(g, ".");
        }
    }
    /* One counted list FIELD reference: `<receiver>->f` or `<receiver>.f`. */
    static void cg_lf_put(CGen* g, const IRNode* obj, const char* f) {
        cg_gen_expr(g, obj);
        cg_lf_sep(g, obj);
        cg_put(g, f);
    }
    /* The element-count text of a LIST VALUE `src`: the `<name>_n` companion of
     * a list variable, a list parameter or another counted list field.  Empty
     * for any other shape -- the destination is then CLEARED instead, which is
     * always valid C and never reads an undeclared counter. */
    static void cg_lf_src_count(CGen* g, const IRNode* src, char* out) {
        out[0] = 0;
        if (!src) return;
        if (d_strcmp(src->type,"IDENTIFIER")==0 && src->value && src->value[0]) {
            /* a parameter NAMED like a counted list field of the class being
             * emitted is the one the constructor takes a length for
             * (`__init__(self, data)` + `self.data = data`), so the companion
             * `<name>_n` parameter is in scope */
            int curlf = (cg_cur_cls_i >= 0 && cg_cur_cls_i < cg_cls_n &&
                         cg_lf_is(cg_cls_names[cg_cur_cls_i], src->value));
            if (cg_list_size(src->value) >= 0 || cg_is_lparam(src->value) ||
                cg_is_dyn_list(src->value) || curlf) {
                int j = 0;
                while (src->value[j] && j < 58) { out[j] = src->value[j]; j++; }
                out[j] = '_'; out[j+1] = 'n'; out[j+2] = 0;
            }
            return;
        }
        if (d_strcmp(src->type,"MEMBER_ACCESS")==0 && src->value && src->nchildren>0 &&
            src->children[0] && d_strcmp(src->children[0]->type,"IDENTIFIER")==0) {
            const char* rcls = cg_cvar_class(src->children[0]->value);
            if (!rcls || !rcls[0]) rcls = cg_curp_cls_of(src->children[0]->value);
            if (rcls && rcls[0] && cg_lf_is(rcls, src->value)) {
                cg_lf_put(g, src->children[0], src->value);
                cg_put(g, "_n");
            }
            return;
        }
    }
    /* Zero the element counters of every counted list field of `cls`: an
     * instance is a stack local (`C c;`), so the counters are stack garbage
     * until the constructor or the field assign writes them. */
    static void cg_lf_zero_ctor(CGen* g, const char* cls, const IRNode* target,
                                const char* sep) {
        int i = 0;
        while (i < cg_lf_n) {
            if (d_strcmp(cg_lf_cls[i], cls) == 0) {
                cg_indent(g); cg_put(g, target); cg_put(g, sep);
                cg_put(g, cg_lf_names[i]); cg_put(g, "_n = 0;\n");
            }
            i++;
        }
    }
    static int cg_is_str_node(const IRNode* a);
    static int cg_is_dd_node(const IRNode* a);
        static const char* cg_expr_obj_class(const IRNode* e);
    static int cg_mret_kind_of(const IRNode* recv, const char* meth);
    static int cg_is_list_literal(const IRNode* a);
    static int cg_list_expr_is_sl(const IRNode* a);
    /* `self.f == [a, b]` / `c.items == [a, b]`: compare the live element count
     * and then every element.  The generic path compared the inline ARRAY
     * member with a block-scoped compound literal -- two pointers -- so it
     * folded to a constant false (12_classes / 29_copy patterns). */
    static void cg_lf_eq_emit(CGen* g, const IRNode* var_node, const IRNode* lit_node) {
        if (!var_node || !lit_node || var_node->nchildren < 1) { cg_put(g, "0"); return; }
        const IRNode* rcv = var_node->children[0];
        cg_put(g, "(");
        cg_lf_put(g, rcv, var_node->value); cg_put(g, "_n == ");
        cg_put_int(g, lit_node->nchildren);
        int k = 0;
        while (k < lit_node->nchildren) {
            cg_put(g, " && ");
            if (cg_node_is_str_static(lit_node->children[k]) ||
                cg_is_str_node(lit_node->children[k])) {
                cg_put(g, "drygon_streq(");
                cg_lf_put(g, rcv, var_node->value);
                cg_put(g, "["); cg_put_int(g, k); cg_put(g, "], ");
                cg_gen_expr(g, lit_node->children[k]);
                cg_put(g, ")");
            } else {
                cg_lf_put(g, rcv, var_node->value);
                cg_put(g, "["); cg_put_int(g, k); cg_put(g, "] == ");
                cg_gen_expr(g, lit_node->children[k]);
            }
            k++;
        }
        cg_put(g, ")");
    }
    /* Emit `Cls___init__(&tgt, a1, ..., an)`, including the element count a
     * counted LIST field takes from its matching constructor argument
     * (12_classes 23/26/51). */
    static void cg_emit_init(CGen* g, const char* cls, const IRNode* args,
                             const char* tgt) {
        int cbi = cg_cls_index(cls);
        const IRNode* cbb = (cbi >= 0) ? cg_cls_body[cbi] : NULL;
        cg_put(g, cls); cg_put(g, "___init__(&"); cg_put(g, tgt);
        int ai = 0;
        while (args && ai < args->nchildren) {
            const IRNode* av = args->children[ai];
            cg_put(g, ", ");
            cg_gen_expr(g, av);
            const char* ipn = cbb ? cg_cls_init_param(cbb, ai) : (const char*)0;
            if (ipn && cg_lf_is(cls, ipn)) {
                cg_put(g, ", ");
                if (av && d_strcmp(av->type,"BLOCK")==0 &&
                    (d_strcmp(av->value,"LIST")==0 || d_strcmp(av->value,"TUPLE")==0)) {
                    cg_put_int(g, av->nchildren);
                } else if (av && d_strcmp(av->type,"IDENTIFIER")==0) {
                    /* Pass the LIVE element count (`name_n`), never the array's
                     * static CAPACITY: an omitted list default reaches here as
                     * the persistent slot `_dydfK` (capacity 1024), and handing
                     * a callee `_dydf0, 64` made `fieldnames=[], ...` start with
                     * 64 NULL elements -- `len(self.fieldnames)` was 64, the
                     * header row stayed unread and `d[NULL]` segfaulted
                     * (50_csv DictReader). */
                    if (cg_list_size(av->value) >= 0 ||
                        cg_sl_index(av->value) >= 0 || cg_is_lparam(av->value)) {
                        cg_put(g, av->value); cg_put(g, "_n");
                    } else cg_put_int(g, 0);
                } else if (av && d_strcmp(av->type,"MEMBER_ACCESS")==0 && av->value &&
                           av->nchildren>0 && av->children[0] &&
                           cg_lf_recv_field(av->children[0], av->value)) {
                    /* `Cls(o.f)`: the clone takes the source field's live
                     * element count, not a zeroed one (29_copy check 15). */
                    cg_lf_put(g, av->children[0], av->value); cg_put(g, "_n");
                } else if (av && d_strcmp(av->type,"CALL")==0 && av->nchildren>1 &&
                           av->children[0] &&
                           d_strcmp(av->children[0]->type,"MEMBER_ACCESS")==0 &&
                           av->children[0]->value &&
                           (d_strcmp(av->children[0]->value,"copy")==0 ||
                            d_strcmp(av->children[0]->value,"deepcopy")==0)) {
                    /* `Cls(copy.deepcopy(self.data, memo))` in a user
                     * `__deepcopy__`: the copy carries the source list value's
                     * element count (`memo` is unused for a list source). */
                    const IRNode* csrc = av->children[1];
                    if (csrc && d_strcmp(csrc->type,"MEMBER_ACCESS")==0 && csrc->value &&
                        csrc->nchildren>0 && csrc->children[0] &&
                        cg_lf_recv_field(csrc->children[0], csrc->value)) {
                        cg_lf_put(g, csrc->children[0], csrc->value); cg_put(g, "_n");
                    } else if (csrc && d_strcmp(csrc->type,"IDENTIFIER")==0 &&
                               (cg_list_size(csrc->value) >= 0 ||
                                cg_is_lparam(csrc->value) ||
                                cg_sl_index(csrc->value) >= 0)) {
                        cg_put(g, csrc->value); cg_put(g, "_n");
                    } else cg_put_int(g, 0);
                } else cg_put_int(g, 0);
            }
            ai++;
        }
        cg_put(g, ")");
    }
    /* A list variable's element type, forced from the call sites that hand it
     * to a typed list parameter: `xs = [1, 2]` is an int list only until some
     * site passes it where the signature says doubles. */
    static char cg_lfor_names[4096]; /* up to 64 names, 64 bytes each */
    static int cg_lfor_types[64];    /* 0 int, 1 double, 2 char* */
    static int cg_nlfor;
    static void cg_force_list(const char* name, int t) {
        if (!name || !name[0]) return;
        int i = 0;
        while (i < cg_nlfor) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_lfor_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) { cg_lfor_types[i] = t; return; }
            i++;
        }
        if (cg_nlfor >= 64) return;
        int base = cg_nlfor * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_lfor_names[base + j] = name[j]; j++; }
        cg_lfor_names[base + j] = 0;
        cg_lfor_types[cg_nlfor] = t;
        cg_nlfor = cg_nlfor + 1;
    }
    static int cg_force_list_get(const char* name) {
        if (!name) return -1;
        int i = 0;
        while (i < cg_nlfor) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_lfor_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return cg_lfor_types[i];
            i++;
        }
        return -1;
    }
    /* List literals handed to a call.  The element type has to be known before
     * the backing array is declared, and literal slots are only numbered once
     * generation starts, so the pre-pass keys the type off the syntax node. */
    static const IRNode* cg_litw_nodes[64];
    static int cg_litw_types[64]; /* 0 int, 1 double, 2 char* */
    static int cg_nlitw;
    static void cg_litw_note(const IRNode* n, int t) {
        if (!n) return;
        int i = 0;
        while (i < cg_nlitw) {
            if (cg_litw_nodes[i] == n) { cg_litw_types[i] = t; return; }
            i++;
        }
        if (cg_nlitw >= 64) return;
        cg_litw_nodes[cg_nlitw] = n;
        cg_litw_types[cg_nlitw] = t;
        cg_nlitw = cg_nlitw + 1;
    }
    static int cg_litw_get(const IRNode* n) {
        if (!n) return -1;
        int i = 0;
        while (i < cg_nlitw) { if (cg_litw_nodes[i] == n) return cg_litw_types[i]; i++; }
        return -1;
    }
    static void cg_litw_reset(void) { cg_nlitw = 0; }
    /* String methods that hand back a new string (the rest return int/bool). */
    static int cg_is_str_method_ret(const char* m) {
        if (!m) return 0;
        if (d_strcmp(m,"upper")==0) return 1;
        if (d_strcmp(m,"lower")==0) return 1;
        if (d_strcmp(m,"strip")==0) return 1;
        if (d_strcmp(m,"lstrip")==0) return 1;
        if (d_strcmp(m,"rstrip")==0) return 1;
        if (d_strcmp(m,"title")==0) return 1;
        if (d_strcmp(m,"capitalize")==0) return 1;
        if (d_strcmp(m,"casefold")==0) return 1;
        if (d_strcmp(m,"swapcase")==0) return 1;
        if (d_strcmp(m,"replace")==0) return 1;
        if (d_strcmp(m,"join")==0) return 1;
        if (d_strcmp(m,"format")==0) return 1;
        if (d_strcmp(m,"format_map")==0) return 1;
        /* string.Template.substitute/safe_substitute hand back a new string */
        if (d_strcmp(m,"substitute")==0) return 1;
        if (d_strcmp(m,"safe_substitute")==0) return 1;
        if (d_strcmp(m,"zfill")==0) return 1;
        /* stream reads hand back a string -- `f.read()` on an io.StringIO or
         * io.File receiver was typed int and truncated to its low word */
        if (d_strcmp(m,"read")==0) return 1;
        if (d_strcmp(m,"readline")==0) return 1;
        if (d_strcmp(m,"readlines")==0) return 1;
        if (d_strcmp(m,"getvalue")==0) return 1;
        if (d_strcmp(m,"decode")==0) return 1;
        if (d_strcmp(m,"read_text")==0) return 1;
        if (d_strcmp(m,"expandtabs")==0) return 1;
        if (d_strcmp(m,"removeprefix")==0) return 1;
        if (d_strcmp(m,"removesuffix")==0) return 1;
        if (d_strcmp(m,"center")==0) return 1;
        if (d_strcmp(m,"ljust")==0) return 1;
        if (d_strcmp(m,"rjust")==0) return 1;
        if (d_strcmp(m,"translate")==0) return 1;
        /* hashlib digests hand back a hex string / a byte string */
        if (d_strcmp(m,"hexdigest")==0) return 1;
        if (d_strcmp(m,"digest")==0) return 1;
        return 0;
    }
    /* ---- object-list columns / attrgetter / methodcaller registries ------------
 * These live up here rather than next to the rest of the object-list codegen
 * (which sits below `cg_gen_expr`) because `cg_is_str_node` -- defined here --
 * has to consult them to pick `drygon_streq` over a raw pointer compare. */
static char cg_ob_cn[128][32];
static const IRNode* cg_ob_cbd[128];
static int cg_ob_ncls;
static char cg_ob_lname[64][32];
static char cg_ob_lcls[64][32];
static char cg_ob_lcol[512][32];
/* C identifier emitted for each column.  It CANNOT be `<list>_<attr>`: a
 * class whose attribute is called `n` on a list called `objs` would declare
 * `int objs_n[64];` next to the element COUNT `int objs_n;` and the generated
 * C would not parse (`objs = [P(2, "b"), ...]` then `objs[0].n` was a SEGV).
 * Each column gets a positional identifier instead. */
static char cg_ob_lcn[512][32];
static int cg_ob_lkind[512];
static int cg_ob_lncol[64];
static int cg_ob_cnt;
/* `v = <mod>.<Cls>(...)` / `v = <Cls>(...)`: the class of a variable, recorded
 * during the object-list prescan so `lst.append(v)` can be treated as an
 * object-list append (columns) instead of stuffing a truncated pointer into
 * one int slot. */
static char cg_ob_vnm[128][32];
static char cg_ob_vcls[128][32];
static int cg_ob_vn;
static void cg_ob_note_var(const char* v, const char* c) {
    if (!v || !c || !v[0] || !c[0]) return;
    int i = 0;
    while (i < cg_ob_vn) { if (d_strcmp(cg_ob_vnm[i], v) == 0) return; i++; }
    if (cg_ob_vn >= 128) return;
    d_strncpy(cg_ob_vnm[cg_ob_vn], v, 31); cg_ob_vnm[cg_ob_vn][31] = 0;
    d_strncpy(cg_ob_vcls[cg_ob_vn], c, 31); cg_ob_vcls[cg_ob_vn][31] = 0;
    cg_ob_vn = cg_ob_vn + 1;
}
static const char* cg_ob_var_cls(const char* v) {
    if (!v) return 0;
    int i = 0;
    while (i < cg_ob_vn) { if (d_strcmp(cg_ob_vnm[i], v) == 0) return cg_ob_vcls[i]; i++; }
    return 0;
}
static void cg_ob_mkcn(char* out, const char* list, int k) {
    int i = 0;
    while (list[i] && i < 20) { out[i] = list[i]; i++; }
    out[i] = 95; i++;      /* _ */
    out[i] = 111; i++;     /* o */
    out[i] = 99; i++;      /* c */
    char d[12];
    int n = 0;
    if (k == 0) { d[0] = 48; n = 1; }
    while (k > 0 && n < 10) { d[n] = 48 + (k % 10); k = k / 10; n++; }
    int j = 0;
    while (j < n) { out[i] = d[n - 1 - j]; i++; j++; }
    out[i] = 0;
}
static void cg_ob_getname(int li, char* out) {
    out[0] = 95; out[1] = 111; out[2] = 98; out[3] = 103;   /* _obg */
    char d[12];
    int n = 0;
    if (li == 0) { d[0] = 48; n = 1; }
    while (li > 0 && n < 10) { d[n] = 48 + (li % 10); li = li / 10; n++; }
    int j = 0;
    while (j < n) { out[4 + j] = d[n - 1 - j]; j++; }
    out[4 + n] = 0;
}
/* `g = operator.attrgetter("a")` / `m = operator.methodcaller("upper")` */
static char cg_ag_name[8][32];
static char cg_ag_attr[8][32];
static int cg_ag_cnt;
static char cg_mc_name[8][32];
static char cg_mc_meth[8][32];
static int cg_mc_cnt;
static int cg_ob_srl;
static int cg_ob_lookup(const char* nm) {
    int i = 0;
    while (i < cg_ob_cnt) { if (d_strcmp(cg_ob_lname[i], nm) == 0) return i; i++; }
    return -1;
}
static int cg_ag_lookup(const char* nm) {
    int i = 0;
    while (i < cg_ag_cnt) { if (d_strcmp(cg_ag_name[i], nm) == 0) return i; i++; }
    return -1;
}
static int cg_mc_lookup(const char* nm) {
    int i = 0;
    while (i < cg_mc_cnt) { if (d_strcmp(cg_mc_name[i], nm) == 0) return i; i++; }
    return -1;
}
/* column index of `attr` in the object list `nm`, or -1 */
static int cg_ob_col(const char* nm, const char* attr) {
    int li = cg_ob_lookup(nm);
    if (li < 0) return -1;
    int c = 0;
    while (c < cg_ob_lncol[li]) {
        if (d_strcmp(cg_ob_lcol[li*8 + c], attr) == 0) return c;
        c++;
    }
    return -1;
}
/* `operator.methodcaller("upper")` -> its string-helper call */
static const char* cg_mc_helper(const char* m) {
    if (!m) return NULL;
    if (d_strcmp(m,"upper")==0) return "drygon_upper";
    if (d_strcmp(m,"lower")==0) return "drygon_lower";
    if (d_strcmp(m,"strip")==0) return "drygon_strip";
    if (d_strcmp(m,"lstrip")==0) return "drygon_lstrip";
    if (d_strcmp(m,"rstrip")==0) return "drygon_rstrip";
    if (d_strcmp(m,"title")==0) return "drygon_title";
    if (d_strcmp(m,"swapcase")==0) return "drygon_swapcase";
    if (d_strcmp(m,"capitalize")==0) return "drygon_capitalize";
    return NULL;
}
/* ---- subprocess: a name bound to a live child process ---------------
 * `result = subprocess.run(...)` stores a handle into the prelude's native
 * fork/execve/wait4 table, so `result.stdout`, `result.returncode` and
 * `proc.communicate()` read that handle back.  kind: 1 run, 2 Popen,
 * 3 check_output.  (49_subprocess) */
static char cg_sp_vars[64 * 64];
static int cg_sp_kindv[64];
static int cg_nsp_vars;
static int cg_sp_lookup(const char* name) {
    int i = 0;
    if (!name) return -1;
    while (i < cg_nsp_vars) { if (d_strcmp(cg_sp_vars + i * 64, name) == 0) return i; i++; }
    return -1;
}
static void cg_sp_note(const char* name, int kind) {
    int j = 0;
    if (!name) return;
    int i = cg_sp_lookup(name);
    if (i >= 0) { cg_sp_kindv[i] = kind; return; }
    if (cg_nsp_vars >= 64) return;
    i = cg_nsp_vars;
    while (name[j] && j < 63) { cg_sp_vars[i * 64 + j] = name[j]; j++; }
    cg_sp_vars[i * 64 + j] = 0;
    cg_sp_kindv[i] = kind;
    cg_nsp_vars = cg_nsp_vars + 1;
}
static int cg_sp_is_obj(const char* name) { return cg_sp_lookup(name) >= 0; }
static int cg_sp_kind_of(const char* name) {
    int i = cg_sp_lookup(name);
    if (i < 0) return 0;
    return cg_sp_kindv[i];
}
/* `x = subprocess.run/Popen/check_output(...)`: record the binding. */
static void cg_sp_scan(const IRNode* n) {
    int i = 0;
    if (!n) return;
    if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren >= 2 && n->children[0] && n->children[1]) {
        const IRNode* lhs = n->children[0];
        const IRNode* rhs = n->children[1];
        if (d_strcmp(lhs->type,"IDENTIFIER")==0 && d_strcmp(rhs->type,"CALL")==0 &&
            rhs->nchildren > 0 && rhs->children[0] &&
            d_strcmp(rhs->children[0]->type,"MEMBER_ACCESS")==0 &&
            rhs->children[0]->nchildren > 0 && rhs->children[0]->children[0] &&
            d_strcmp(rhs->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(rhs->children[0]->children[0]->value,"subprocess")==0) {
            const char* m = rhs->children[0]->value;
            int k = 0;
            if (m && d_strcmp(m,"run")==0) k = 1;
            else if (m && d_strcmp(m,"Popen")==0) k = 2;
            else if (m && d_strcmp(m,"check_output")==0) k = 3;
            if (k != 0) cg_sp_note(lhs->value, k);
        }
    }
    while (i < n->nchildren) { cg_sp_scan(n->children[i]); i++; }
