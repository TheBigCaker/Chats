    d_strcpy(p+pos, "int* wcscat(int* d, int* s) { int i=0; while(d[i])i++; int j=0; while(s[j]){d[i++]=s[j++];} d[i]=0; return d; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int* wmemcpy(int* d, int* s, long n) { long i=0; while(i<n){d[i]=s[i];i++;} return d; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int* wmemset(int* d, int c, long n) { long i=0; while(i<n){d[i++]=c;} return d; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int mbtowc(int* pwc, char* s, long n) { if(s&&n>0){if(pwc)*pwc=(unsigned char)s[0];return 1;} return 0; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int wctomb(char* s, int wc) { if(s){s[0]=(char)wc;return 1;} return 0; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "long mbstowcs(int* d, char* s, long n) { long i=0; while(i<n&&s[i]){d[i]=(unsigned char)s[i];i++;} if(i<n)d[i]=0; return i; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "long wcstombs(char* d, int* s, long n) { long i=0; while(i<n&&s[i]){d[i]=(char)s[i];i++;} if(i<n)d[i]=0; return i; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "double creal(double z) { return z; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "double cimag(double z) { return 0.0; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "void* conj(double z) { return 0; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "double cabs(double z) { return z < 0.0 ? 0.0 - z : z; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "double carg(double z) { return 0.0; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "double csqrt(double z) { return drygon_m_sqrt(z); }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "double cexp(double z) { return drygon_m_exp(z); }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int drygon_listeq_i(int* a, int an, int* b, int bn) { if(an!=bn)return 0; for(int i=0;i<an;i++)if(a[i]!=b[i])return 0; return 1; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int drygon_listeq_s(char** a, int an, char** b, int bn) { if(an!=bn)return 0; for(int i=0;i<an;i++)if(drygon_streq(a[i],b[i])==0)return 0; return 1; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int drygon_2leq(int* ba, int* oa, int* la, int na, int* bb, int* ob, int* lb, int nb) { if(na!=nb)return 0; for(int i=0;i<na;i++){ if(la[i]!=lb[i])return 0; for(int j=0;j<la[i];j++) if(ba[oa[i]+j]!=bb[ob[i]+j]) return 0; } return 1; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int drygon_2leq_s(char** ba, int* oa, int* la, int na, char** bb, int* ob, int* lb, int nb) { if(na!=nb)return 0; for(int i=0;i<na;i++){ if(la[i]!=lb[i])return 0; for(int j=0;j<la[i];j++) if(drygon_streq(ba[oa[i]+j],bb[ob[i]+j])==0) return 0; } return 1; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "long drygon_lidx2(long i, long n) { if (i < 0) i = n + i; if (i < 0 || i >= n) { py_raise_str(\"IndexError\", \"list index out of range\"); return 0; } return i; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "int errno = 0;\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "static int _dg_tm[9] = {0,0,0,1,0,70,4,0,0};\nvoid* gmtime(long* t) {\n  long s=*t; int* tm=_dg_tm;\n  tm[0]=s%60; s/=60; tm[1]=s%60; s/=60; tm[2]=s%24; s/=24;\n  long d=s; tm[6]=(int)((d+4)%7);\n  int y=1970;\n  while(1){int dy=((y%4==0&&y%100!=0)||y%400==0)?366:365; if(d<dy)break; d-=dy; y++;}\n  int md[12]; md[0]=31;md[1]=28;md[2]=31;md[3]=30;md[4]=31;md[5]=30;md[6]=31;md[7]=31;md[8]=30;md[9]=31;md[10]=30;md[11]=31;\n  if((y%4==0&&y%100!=0)||y%400==0)md[1]=29;\n  int m=0; while(m<12&&d>=md[m]){d-=md[m];m++;}\n  tm[3]=(int)(d+1); tm[4]=m; tm[5]=y-1900; tm[8]=0;\n  return _dg_tm;\n}\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "void* localtime(long* t) { return gmtime(t); }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "char* asctime(void* tm) { static char b[32]; int p=0; b[p++]='X'; b[p]=0; return b; }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "char* ctime(long* t) { return asctime(localtime(t)); }\n"); pos += d_strlen(p+pos);
    d_strcpy(p+pos, "long strftime(char* s, long n, char* f, void* tm) { if (!s || n <= 0) { return 0; } int* t = (int*)tm; int p = 0; int i = 0; while (f[i] && p < (int)n - 1) { if (f[i] != 37) { s[p] = f[i]; p = p + 1; i = i + 1; continue; } i = i + 1; char c = f[i]; i = i + 1; if (c == 89) { int y = (t ? t[5] : 0) + 1900; s[p] = (char)(48 + (y / 1000) % 10); p++; s[p] = (char)(48 + (y / 100) % 10); p++; s[p] = (char)(48 + (y / 10) % 10); p++; s[p] = (char)(48 + y % 10); p++; } else if (c == 109) { int mo = (t ? t[4] : 0) + 1; s[p] = (char)(48 + (mo / 10) % 10); p++; s[p] = (char)(48 + mo % 10); p++; } else if (c == 100) { int dd = (t ? t[3] : 1); s[p] = (char)(48 + (dd / 10) % 10); p++; s[p] = (char)(48 + dd % 10); p++; } else if (c == 72) { int hh = (t ? t[2] : 0); s[p] = (char)(48 + (hh / 10) % 10); p++; s[p] = (char)(48 + hh % 10); p++; } else if (c == 77) { int mm = (t ? t[1] : 0); s[p] = (char)(48 + (mm / 10) % 10); p++; s[p] = (char)(48 + mm % 10); p++; } else if (c == 83) { int ss = (t ? t[0] : 0); s[p] = (char)(48 + (ss / 10) % 10); p++; s[p] = (char)(48 + ss % 10); p++; } else if (c == 37) { s[p] = c; p = p + 1; } else { s[p] = c; p = p + 1; } } s[p] = 0; return p; }\n"); pos += d_strlen(p+pos);
    return p;
}

static void dc_cplx_app_str(char* out, int* n, const char* s) {
    int k = 0;
    while (s[k]) { out[*n] = s[k]; *n = *n + 1; k = k + 1; }
}

static void dc_cplx_app_mem(char* out, int* n, const char* s, int len) {
    int k = 0;
    while (k < len) { out[*n] = s[k]; *n = *n + 1; k = k + 1; }
}

static char* dc_lower_complex(char* src) {
    if (!src || d_strstr(src, "compile_program") || !d_strstr(src, "_Complex")) return src;
    int slen = d_strlen(src);
    int cap = slen * 4 + 65536;
    char* out = sys_mmap(0, cap, 3, 34, -1, 0);
    if (!out) return src;
    int n = 0;
    int i = 0;

    while (i < slen) {
        int line_start = i;
        while (i < slen && src[i] != '\n') i = i + 1;
        int line_end = i;
        if (i < slen && src[i] == '\n') i = i + 1;
        int line_len = line_end - line_start;

        char line[1024];
        if (line_len >= 1023) line_len = 1023;
        d_memcpy(line, src + line_start, line_len);
        line[line_len] = 0;

        int p = 0;
        while (p < line_len && (line[p] == ' ' || line[p] == '\t')) p = p + 1;

        if (d_strstr(line + p, "cabs(double _Complex)") ||
            d_strstr(line + p, "carg(double _Complex)") ||
            d_strstr(line + p, "creal(double _Complex)") ||
            d_strstr(line + p, "cimag(double _Complex)") ||
            d_strstr(line + p, "csqrt(double _Complex)") ||
            d_strstr(line + p, "cexp(double _Complex)") ||
            d_strstr(line + p, "conj(double _Complex)")) {
            dc_cplx_app_str(out, &n, "// ");
            dc_cplx_app_mem(out, &n, line, line_len);
            out[n] = '\n'; n = n + 1;
            continue;
        }

        if (d_strncmp(line + p, "double _Complex ", 16) == 0) {
            char indent[64];
            int ind_len = p;
            if (ind_len > 63) ind_len = 63;
            d_memcpy(indent, line, ind_len);
            indent[ind_len] = 0;

            p = p + 16;
            while (p < line_len && (line[p] == ' ' || line[p] == '\t')) p = p + 1;
            int name_start = p;
            while (p < line_len && ((line[p] >= 'a' && line[p] <= 'z') ||
                                    (line[p] >= 'A' && line[p] <= 'Z') ||
                                    (line[p] >= '0' && line[p] <= '9') ||
                                    line[p] == '_')) p = p + 1;
            int name_len = p - name_start;
            char vname[64];
            if (name_len > 63) name_len = 63;
            d_memcpy(vname, line + name_start, name_len);
            vname[name_len] = 0;

            while (p < line_len && (line[p] == ' ' || line[p] == '\t')) p = p + 1;
            if (line[p] == '=') {
                p = p + 1;
                while (p < line_len && (line[p] == ' ' || line[p] == '\t')) p = p + 1;
                int expr_start = p;
                int expr_end = line_len - 1;
                while (expr_end >= expr_start && (line[expr_end] == ';' || line[expr_end] == ' ' || line[expr_end] == '\t')) expr_end = expr_end - 1;
                int expr_len = expr_end - expr_start + 1;
                char expr[512];
                if (expr_len > 511) expr_len = 511;
                d_memcpy(expr, line + expr_start, expr_len);
                expr[expr_len] = 0;

                char* bcomp = d_strstr(expr, "* __builtin_complex");
                if (!bcomp) bcomp = d_strstr(expr, "*__builtin_complex");
                if (bcomp) {
                    char* pplus = 0;
                    char* cur = expr;
                    while (cur < bcomp) {
                        if (*cur == '+') pplus = cur;
                        cur = cur + 1;
                    }
                    if (pplus) {
                        int r_len = (int)(pplus - expr);
                        while (r_len > 0 && (expr[r_len-1] == ' ' || expr[r_len-1] == '\t')) r_len = r_len - 1;
                        char r_str[256];
                        if (r_len > 255) r_len = 255;
                        d_memcpy(r_str, expr, r_len);
                        r_str[r_len] = 0;

                        char* i_start = pplus + 1;
                        while (*i_start == ' ' || *i_start == '\t') i_start = i_start + 1;
                        int i_len = (int)(bcomp - i_start);
                        while (i_len > 0 && (i_start[i_len-1] == ' ' || i_start[i_len-1] == '\t')) i_len = i_len - 1;
                        char i_str[256];
                        if (i_len > 255) i_len = 255;
                        d_memcpy(i_str, i_start, i_len);
                        i_str[i_len] = 0;

                        dc_cplx_app_str(out, &n, indent);
                        dc_cplx_app_str(out, &n, "double ");
                        dc_cplx_app_str(out, &n, vname);
                        dc_cplx_app_str(out, &n, "_r = (");
                        dc_cplx_app_str(out, &n, r_str);
                        dc_cplx_app_str(out, &n, "); double ");
                        dc_cplx_app_str(out, &n, vname);
                        dc_cplx_app_str(out, &n, "_i = (");
                        dc_cplx_app_str(out, &n, i_str);
                        dc_cplx_app_str(out, &n, ");\n");
                        continue;
                    }
                }

                if (d_strncmp(expr, "conj(", 5) == 0) {
                    char a_name[64];
                    int k = 5;
                    while (expr[k] && expr[k] != ')') { a_name[k-5] = expr[k]; k = k + 1; }
                    a_name[k-5] = 0;
                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = 0.0 - (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i);\n");
                    continue;
                }

                if (d_strncmp(expr, "cexp(", 5) == 0) {
                    char a_name[64];
                    int k = 5;
                    while (expr[k] && expr[k] != ')') { a_name[k-5] = expr[k]; k = k + 1; }
                    a_name[k-5] = 0;
                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = drygon_m_exp(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r) * drygon_m_cos(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = drygon_m_exp(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r) * drygon_m_sin(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i);\n");
                    continue;
                }

                if (d_strncmp(expr, "csqrt(", 6) == 0) {
                    char a_name[64];
                    int k = 6;
                    while (expr[k] && expr[k] != ')') { a_name[k-6] = expr[k]; k = k + 1; }
                    a_name[k-6] = 0;
                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double _m_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, " = drygon_m_sqrt((");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r) + (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)); double _a_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, " = drygon_m_atan2(");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i, ");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r) * 0.5; double _sm_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, " = drygon_m_sqrt(_m_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = _sm_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, " * drygon_m_cos(_a_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = _sm_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, " * drygon_m_sin(_a_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, ");\n");
                    continue;
                }

                char* star_conj = d_strstr(expr, "* conj(");
                if (!star_conj) star_conj = d_strstr(expr, "*conj(");
                if (star_conj) {
                    char a_name[64];
                    int a_len = (int)(star_conj - expr);
                    while (a_len > 0 && (expr[a_len-1] == ' ' || expr[a_len-1] == '\t')) a_len = a_len - 1;
                    d_memcpy(a_name, expr, a_len); a_name[a_len] = 0;

                    char* b_start = d_strstr(star_conj, "conj(") + 5;
                    char b_name[64];
                    int k = 0;
                    while (b_start[k] && b_start[k] != ')') { b_name[k] = b_start[k]; k = k + 1; }
                    b_name[k] = 0;

                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r) + (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r) - (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i);\n");
                    continue;
                }

                char* plus_op = 0;
                { int ci = 0; while (expr[ci]) { if (expr[ci] == '+') { plus_op = expr + ci; break; } ci = ci + 1; } }
                if (plus_op) {
                    char a_name[64], b_name[64];
                    int a_len = (int)(plus_op - expr);
                    while (a_len > 0 && (expr[a_len-1] == ' ' || expr[a_len-1] == '\t')) a_len = a_len - 1;
                    d_memcpy(a_name, expr, a_len); a_name[a_len] = 0;

                    char* b_start = plus_op + 1;
                    while (*b_start == ' ' || *b_start == '\t') b_start = b_start + 1;
                    int b_len = d_strlen(b_start);
                    while (b_len > 0 && (b_start[b_len-1] == ' ' || b_start[b_len-1] == '\t')) b_len = b_len - 1;
                    d_memcpy(b_name, b_start, b_len); b_name[b_len] = 0;

                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r) + (");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i) + (");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i);\n");
                    continue;
                }

                char* minus_op = 0;
                { int ci = 0; while (expr[ci]) { if (expr[ci] == '-') { minus_op = expr + ci; break; } ci = ci + 1; } }
                if (minus_op) {
                    char a_name[64], b_name[64];
                    int a_len = (int)(minus_op - expr);
                    while (a_len > 0 && (expr[a_len-1] == ' ' || expr[a_len-1] == '\t')) a_len = a_len - 1;
                    d_memcpy(a_name, expr, a_len); a_name[a_len] = 0;

                    char* b_start = minus_op + 1;
                    while (*b_start == ' ' || *b_start == '\t') b_start = b_start + 1;
                    int b_len = d_strlen(b_start);
                    while (b_len > 0 && (b_start[b_len-1] == ' ' || b_start[b_len-1] == '\t')) b_len = b_len - 1;
                    d_memcpy(b_name, b_start, b_len); b_name[b_len] = 0;

                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r) - (");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i) - (");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i);\n");
                    continue;
                }

                char* star_op = 0;
                { int ci = 0; while (expr[ci]) { if (expr[ci] == '*') { star_op = expr + ci; break; } ci = ci + 1; } }
                if (star_op) {
                    char a_name[64], b_name[64];
                    int a_len = (int)(star_op - expr);
                    while (a_len > 0 && (expr[a_len-1] == ' ' || expr[a_len-1] == '\t')) a_len = a_len - 1;
                    d_memcpy(a_name, expr, a_len); a_name[a_len] = 0;

                    char* b_start = star_op + 1;
                    while (*b_start == ' ' || *b_start == '\t') b_start = b_start + 1;
                    int b_len = d_strlen(b_start);
                    while (b_len > 0 && (b_start[b_len-1] == ' ' || b_start[b_len-1] == '\t')) b_len = b_len - 1;
                    d_memcpy(b_name, b_start, b_len); b_name[b_len] = 0;

                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r) - (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i) + (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r);\n");
                    continue;
                }

                char* slash_op = 0;
                { int ci = 0; while (expr[ci]) { if (expr[ci] == '/') { slash_op = expr + ci; break; } ci = ci + 1; } }
                if (slash_op) {
                    char a_name[64], b_name[64];
                    int a_len = (int)(slash_op - expr);
                    while (a_len > 0 && (expr[a_len-1] == ' ' || expr[a_len-1] == '\t')) a_len = a_len - 1;
                    d_memcpy(a_name, expr, a_len); a_name[a_len] = 0;

                    char* b_start = slash_op + 1;
                    while (*b_start == ' ' || *b_start == '\t') b_start = b_start + 1;
                    int b_len = d_strlen(b_start);
                    while (b_len > 0 && (b_start[b_len-1] == ' ' || b_start[b_len-1] == '\t')) b_len = b_len - 1;
                    d_memcpy(b_name, b_start, b_len); b_name[b_len] = 0;

                    dc_cplx_app_str(out, &n, indent);
                    dc_cplx_app_str(out, &n, "double _d_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, " = (");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r) + (");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i); double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_r = ((");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r) + (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i)) / _d_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "; double ");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, "_i = ((");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_i)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_r) - (");
                    dc_cplx_app_str(out, &n, a_name);
                    dc_cplx_app_str(out, &n, "_r)*(");
                    dc_cplx_app_str(out, &n, b_name);
                    dc_cplx_app_str(out, &n, "_i)) / _d_");
                    dc_cplx_app_str(out, &n, vname);
                    dc_cplx_app_str(out, &n, ";\n");
                    continue;
                }
            }
        }

        int q = 0;
        while (q < line_len) {
            if (d_strncmp(line + q, "creal(", 6) == 0) {
                q = q + 6;
                int v_start = q;
                while (q < line_len && line[q] != ')') q = q + 1;
                int v_len = q - v_start;
                char vn[64];
                if (v_len > 63) v_len = 63;
                d_memcpy(vn, line + v_start, v_len); vn[v_len] = 0;
                if (q < line_len && line[q] == ')') q = q + 1;
                dc_cplx_app_str(out, &n, "(");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_r)");
            } else if (d_strncmp(line + q, "cimag(", 6) == 0) {
                q = q + 6;
                int v_start = q;
                while (q < line_len && line[q] != ')') q = q + 1;
                int v_len = q - v_start;
                char vn[64];
                if (v_len > 63) v_len = 63;
                d_memcpy(vn, line + v_start, v_len); vn[v_len] = 0;
                if (q < line_len && line[q] == ')') q = q + 1;
                dc_cplx_app_str(out, &n, "(");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_i)");
            } else if (d_strncmp(line + q, "cabs(", 5) == 0) {
                q = q + 5;
                int v_start = q;
                while (q < line_len && line[q] != ')') q = q + 1;
                int v_len = q - v_start;
                char vn[64];
                if (v_len > 63) v_len = 63;
                d_memcpy(vn, line + v_start, v_len); vn[v_len] = 0;
                if (q < line_len && line[q] == ')') q = q + 1;
                dc_cplx_app_str(out, &n, "drygon_m_sqrt((");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_r)*(");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_r) + (");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_i)*(");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_i))");
            } else if (d_strncmp(line + q, "carg(", 5) == 0) {
                q = q + 5;
                int v_start = q;
                while (q < line_len && line[q] != ')') q = q + 1;
                int v_len = q - v_start;
                char vn[64];
                if (v_len > 63) v_len = 63;
                d_memcpy(vn, line + v_start, v_len); vn[v_len] = 0;
                if (q < line_len && line[q] == ')') q = q + 1;
                dc_cplx_app_str(out, &n, "drygon_m_atan2(");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_i, ");
                dc_cplx_app_str(out, &n, vn);
                dc_cplx_app_str(out, &n, "_r)");
            } else {
                out[n] = line[q]; n = n + 1; q = q + 1;
            }
        }
        out[n] = '\n'; n = n + 1;
    }
    out[n] = 0;
    return out;
}

static char* dc_preprocess_includes(char* src, int depth) {
    char* pre = dc_runtime_prelude();
    char* libc = dc_libc_prelude();
    if (!pre) return 0;
    char* exp = dc_expand_includes(src, 0);
    if (!exp) return 0;
    exp = dc_lower_complex(exp);
    int plen = d_strlen(pre);
    int llen = d_strlen(libc);
    int elen = d_strlen(exp);
    char* out = sys_mmap(0, plen + llen + elen + 64, 3, 34, -1, 0);
    if (!out) return 0;
    int i = 0;
    while (i < plen) { out[i] = pre[i]; i = i + 1; }
    i = 0;
    while (i < llen) { out[plen + i] = libc[i]; i = i + 1; }
    i = 0;
    while (i <= elen) { out[plen + llen + i] = exp[i]; i = i + 1; }
    return out;
}


int dc_compile_c(char* src, char** out_blob, int* out_nwords, int* out_main_off, int* out_data_off) {
    char* expanded = dc_preprocess_includes(src, 0);
    char* compile_src = src;
    if (expanded) compile_src = expanded;
    Lexer lx;
    lx.src = compile_src;
    lx.pos = 0;
    lx.lex_line = 1;
    lx.has_tok = 0;
    lx.brace_depth = 0;
    lx.pp_sp = 0;
    lx.pp_emit = 1;
    Compiler* comp = sys_mmap(0, DRYGON_COMPILER_BYTES, 3, 34, -1, 0);
    if (!comp) return -1;
    compile_program(comp, &lx);
    if (g_fe_errors > 0) return -2;

    /* resolve for the .ros load base and re-backfill string initializers so
     * the blob is directly executable at ROS_LOAD_ADDR (compile_program
     * resolves/backfills for the ELF path) */
    code_resolve(&comp->code, ROS_LOAD_ADDR, ROS_LOAD_ADDR + ((g_data_start * 4 + 4095) / 4096) * 4096, g_data_start);
    ginit_str_backfill(comp, ROS_LOAD_ADDR, g_data_start);

    /* write .ros blob */
    long out_buf[3];
    long out = get_addr(out_buf);
    buf_init(out);
    write_ros(out, &comp->code, g_data_start);

    *out_blob = get_ptr(out, 0);
    *out_nwords = get_int(out + 8) / 4;
    *out_main_off = code_find_label(&comp->code, "drygon_main");
    *out_data_off = ((g_data_start * 4 + 4095) / 4096) * 4096;
    if (g_dc_debug) {
        d_puts("dc_compile_c: data_start="); d_putdec(g_data_start);
        d_puts(" nwords="); d_putdec(*out_nwords);
        d_puts(" main_off="); d_putdec(*out_main_off);
        d_puts(" data_off="); d_putdec(*out_data_off); d_putc(10);
    }
    // if (expanded) sys_munmap(expanded);
    return 0;
}

/* ------ dc_compile_elf: compile to a standalone AArch64 ELF executable --------------------- */
int dc_compile_elf(char* src, char** out_blob, int* out_size, int* out_main_off) {
    char* expanded = dc_preprocess_includes(src, 0);
    /* DRYGON_DUMP_C=<path> writes the fully assembled C to <path>. */
    { char* _dcp = d_getenv("DRYGON_DUMP_C"); if (_dcp && expanded) { int _dfd = sys_openat(-100, _dcp, 577, 493); if (_dfd >= 0) sys_write(_dfd, expanded, d_strlen(expanded)); } }
    char* compile_src = src;
    if (expanded) compile_src = expanded;
    Lexer lx;
    lx.src = compile_src;
    lx.pos = 0;
    lx.lex_line = 1;
    lx.has_tok = 0;
    lx.brace_depth = 0;
    lx.pp_sp = 0;
    lx.pp_emit = 1;
    Compiler* comp = sys_mmap(0, DRYGON_COMPILER_BYTES, 3, 34, -1, 0);
    if (!comp) {
        return -1;
    }
    compile_program(comp, &lx);
    if (g_fe_errors > 0) return -2;

    int main_off = code_find_label(&comp->code, "_start");
    code_resolve(&comp->code, ELF_LOAD_ADDR, ELF_LOAD_ADDR + ((g_data_start * 4 + 4095) / 4096) * 4096, g_data_start);

    long out = sys_mmap(0, 32, 3, 34, -1, 0);
    buf_init(out);
    write_elf(out, &comp->code, g_data_start, main_off);

    long blob_ptr = get_ptr(out, 0);
    set_ptr((long)out_blob, 0, blob_ptr);
    *out_size = get_int(out + 8);
    *out_main_off = main_off;
    sys_munmap(comp, DRYGON_COMPILER_BYTES);
    if (expanded) sys_munmap(expanded, d_strlen(expanded) + 1);
    return 0;
}

/* ------ main ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ */
/* True if the source carries @cy or @global block markers — the blocks the
 * verbatim @c/@dry extraction would silently drop. */
static int src_has_cy_blocks(long src, int src_len) {
    int i = 0;
    while (i < src_len) {
        if ((i == 0 || get_char(src, i-1) == 10) && get_char(src, i) == 64) {
            char c3 = get_char(src, i+3);
            if (get_char(src, i+1) == 99 && get_char(src, i+2) == 121 &&
                (c3 == 10 || c3 == 13 || c3 == ' ' || c3 == '\t')) return 1; /* @cy */
            char c7 = get_char(src, i+7);
            if (get_char(src, i+1) == 103 && get_char(src, i+2) == 108 && get_char(src, i+3) == 111
                && get_char(src, i+4) == 98 && get_char(src, i+5) == 97 && get_char(src, i+6) == 108
                && (c7 == 10 || c7 == 13 || c7 == ' ' || c7 == '\t')) return 1; /* @global */
        }
        i++;
    }
    return 0;
}

static int extract_c_block(long src, int src_len, long out, int out_max) {
    int i = 0;
    int out_pos = 0;
    int in_block = 0;
    while (i < src_len && out_pos < out_max) {
        int at_line_start = (i == 0 || get_char(src, i-1) == 10);
        if (!in_block && at_line_start && get_char(src, i) == 64) {
            char c1 = get_char(src, i+1);
            if (c1 == 99) { /* AT_C */
                char c2 = get_char(src, i+2);
                if (c2 == 10 || c2 == 13 || c2 == ' ' || c2 == '\t') { /* exact @c */
                    in_block = 1;
                    while (i < src_len && get_char(src, i) != 10) i++;
                    if (i < src_len) i++;
                    continue;
                }
            } else if (c1 == 100 && get_char(src, i+2) == 114 && get_char(src, i+3) == 121) { /* AT_DRY */
                char c4 = get_char(src, i+4);
                if (c4 == 10 || c4 == 13 || c4 == ' ' || c4 == '\t') {
                    in_block = 1;
                    while (i < src_len && get_char(src, i) != 10) i++;
                    if (i < src_len) i++;
                    continue;
                }
            }
        }
        if (in_block && at_line_start && get_char(src, i) == 64 && get_char(src, i+1) == 101 && get_char(src, i+2) == 110 && get_char(src, i+3) == 100) {
            in_block = 0;
            while (i < src_len && get_char(src, i) != 10) i++;
            if (i < src_len) i++;
            continue;
        }
        if (in_block) {
            set_char(out, out_pos, get_char(src, i));
            out_pos++;
        }
        i++;
    }
    set_char(out, out_pos, 0);
    return out_pos;
}

static int sys_chmod(int dirfd, const char* path, int mode) {
    /* Gryz path: in-process JIT-compiled fchmodat (see gryz_chmod).
     * Fallback: generic Gryz syscall emitter, then baccyn's _raw_syscall. */
    if (drygon_gryz_enabled) {
        return gryz_chmod(path, mode);
    }
    return (int)drygon_jit_syscall(52, dirfd, (long)path, mode, 0, 0, 0);
}

/* build_c_from_dry: polyglot source → unified C (defined in THE NATIVE block).
 * Self-hosting: self_rebuild runs the FULL polyglot extraction on its own
 * source — raw-C cdef blocks verbatim, Cython blocks through the transpiler —
 * not the @c-only scan, which would compile an empty program. */
static int build_c_from_dry(const char* dry_path, char* out_c, size_t max_out);
static char* cc_transpile_py_to_c(const char* py_src);
static char* translate_via_compiler(const char* source_code, const char* src_lang, const char* tgt_lang);
/* type registry of emitted variables: a lambda's captured default needs the
 * same kind as the expression it snapshots */
static int cg_name_is_str(const char* name);
static int cg_name_is_float(const char* name);
static void cg_note_str(const char* name);
static void cg_note_float(const char* name);

/* True when the char at position q ends a type keyword: space, tab, star,
 * or opening paren (`int x`, `void f`, `double* p`, `char* s(void)`). */
static int looks_kw_end(long src, int q) {
    char e = get_char(src, q);
    return e == ' ' || e == '\t' || e == '*' || e == '(';
}

static int self_rebuild() {
    int fd = 0;
    long src = 0;
    long c_code = 0;
    int src_len = 0;
    int c_len = 0;
    int ret = 0;
    int out = 0;
    long header_buf = 0;
    long out_vars = 0;
    long blob = 0;
    int nwords = 0;

    int _sf = sys_openat(-100, "drygon.dry", 0, 0);
    if (_sf < 0) _sf = sys_openat(-100, "drygon/drygon.dry", 0, 0);
    if (_sf < 0) _sf = sys_openat(-100, "/data/data/com.termux/files/home/CCP-C-Cython-Python/drygon/drygon.dry", 0, 0);
    if (_sf < 0) { d_puts("Cannot open self\n"); return 1; }
    
    src = sys_mmap(0, 16777216, 3, 34, -1, 0);
    c_code = sys_mmap(0, 16777216, 3, 34, -1, 0);
    header_buf = sys_mmap(0, 16, 3, 34, -1, 0);
    out_vars = sys_mmap(0, 32, 3, 34, -1, 0);
    
    src_len = sys_read(_sf, src, 16777215);
    sys_close(_sf);
    
    c_len = extract_c_block(src, src_len, c_code, 16777215);
    if (c_len <= 0) {
        /* No block markers found — .dry is pure C, use entire file */
        int i2 = 0; while (i2 < src_len) { set_char(c_code, i2, get_char(src, i2)); i2++; }
        set_char(c_code, src_len, 0);
        c_len = src_len;
    }
    if (c_len <= 0) {
        d_puts("Self-source extraction failed\n");
        return 1;
    }

    /* ------ SOVEREIGNTY CHECK --------------------------------------------------------------------------------------------------------------- */
    {
        /* forbidden patterns as plain string literals */
        /* forbidden patterns — split via C string concatenation to avoid self-reference */
        char* fb0 = "imp" "ort os";
        char* fb1 = "imp" "ort sys";
        char* fb2 = "fr" "om os.";
        char* fb3 = "fr" "om sys.";
        char* fb4 = "// #in" "clude <stdi" "o.h> /* Sovereign: internal d_puts/d_printf */";
        char* fb5 = "// #in" "clude <stdli" "b.h> /* Sovereign: internal snumblits ccp_alloc */";
        char* fb6 = "// #in" "clude <strin" "g.h> /* Sovereign: internal d_strcmp/cymap_copy */";
        char* fb7 = "// #in" "clude <unis" "td.h> /* Sovereign: native _raw_syscall */";
        char* fb8 = "// #in" "clude <fcn" "tl.h> /* Sovereign: native sys_openat */";
        char* fb9 = "#in" "clude <dlfc" "n.h>";
        char* forbidden[11];
        forbidden[0] = fb0; forbidden[1] = fb1; forbidden[2] = fb2;
        forbidden[3] = fb3; forbidden[4] = fb4; forbidden[5] = fb5;
        forbidden[6] = fb6; forbidden[7] = fb7; forbidden[8] = fb8;
        forbidden[9] = fb9; forbidden[10] = 0;
        /* Fast single-pass sovereignty check */
        int found = 0;
        int j = 0;
        while(!found && forbidden[j]){
            char* pat = forbidden[j];
            int plen = d_strlen(pat);
            int k = 0;
            while(k + plen <= c_len){
                int match = 1;
                int m = 0;
                while(m < plen){
                    if(get_char(c_code, k+m) != pat[m]){match=0;break;}
                    m++;
                }
                if(match){
                    /* Verify it's not the declaration line itself */
                    if(k < 200) { match = 0; }
                }
                if(match){ found = 1; break; }
                k++;
            }
            j++;
        }
        if(found){
            d_puts("[SOVEREIGN VIOLATION] External code detected during self-rebuild. ZERO-EXTERNAL-DEPS enforced.\n");
            sys_munmap(src, 16777216);
            sys_munmap(c_code, 16777216);
            sys_munmap(header_buf, 16);
            sys_munmap(out_vars, 32);
            return 2;
        }
    }
    /* ------ END SOVEREIGNTY CHECK ------------------------------------------------------------------------------------------------ */

    long out_blob_buf = sys_mmap(0, 32, 3, 34, -1, 0);
    int out_len = 0;
    int main_off = 0;
    ret = dc_compile_elf(c_code, out_blob_buf, &out_len, &main_off);
    
    if (ret != 0) {
        d_puts("Compilation failed\n");
        return 1;
    }
    
    int _outf = sys_openat(-100, "drygon_self.elf", 577, 493);
    if (_outf < 0) { d_puts("Cannot write\n"); return 1; }
    
    char* out_blob = (char*)get_ptr(out_blob_buf, 0);
    sys_write(_outf, out_blob, out_len);
    sys_close(_outf);
    sys_chmod(-100, "drygon_self.elf", 493);
    d_puts("SUCCESS\n");

    /* ── Regenerate drygon.dry: origin header + fresh source ──
     * The running binary rewrites its own .dry bridge from the source it
     * just read, so the flywheel never depends on a hand-made .dry. */
    int _df = sys_openat(-100, "drygon.dry", 577, 493);
    if (_df < 0) { d_puts("Cannot write drygon.dry\n"); return 1; }
    {
        char* h1 = "# Drygon Native GIL-Less Execution Origin for drygon\n";
        char* h2 = "# The complete monolith — everything native, in this one file\n";
        char* h3 = "# Drygon JIT compiles this file to a native binary — no Python interpreter needed.\n";
        char* h4 = "# GIL-free | Zero external deps | Direct-to-binary | Hot-path: .ros JIT cache\n";
        char* h5 = "\n";
        /* Only prepend the origin header if the source does not already carry
         * it: writing it unconditionally added five lines on every rebuild, so
         * the file the compiler treats as its source of truth grew without
         * bound while the binary it produced stayed identical. */
        int has_hdr = 0;
        {
            char* probe = "# Drygon Native GIL-Less";
            int plen = d_strlen(probe);
            if (src_len >= plen) {
                int same = 1;
                int q = 0;
                while (q < plen) { if (get_char(src, q) != probe[q]) { same = 0; break; } q++; }
                if (same) has_hdr = 1;
            }
        }
        if (!has_hdr) {
            sys_write(_df, h1, d_strlen(h1));
            sys_write(_df, h2, d_strlen(h2));
            sys_write(_df, h3, d_strlen(h3));
            sys_write(_df, h4, d_strlen(h4));
            sys_write(_df, h5, d_strlen(h5));
        }
        sys_write(_df, src, src_len);
        sys_close(_df);
        d_puts("drygon.dry regenerated\n");
    }

    sys_munmap(src, 16777216);
    sys_munmap(c_code, 16777216);
    sys_munmap(header_buf, 16);
    sys_munmap(out_vars, 32);
    return 0;
}

/* ── .ros JIT cache loader ───────────────────────────────────────────────────
 * A .ros cache blob is a flat AArch64 image resolved/backfilled for
 * ROS_LOAD_ADDR: [code words][pad to page][data words].  The 32-byte file
 * header carries freshness stamps, so a cache hit requires an exact
 * size+mtime match with the source, and the blob executes in-process via
 * mmap+fork: no temp ELF, no exec. */

typedef int (*ros_main_fn)(int, void*);

/* "foo.py" -> "foo.ros" (everything after the LAST dot replaced). */
static void ros_derive_path(char* out, char* dry_path) {
    int len = d_strlen(dry_path);
    int dot_idx = len;
    int i = len - 1;
    while (i >= 0) {
        if (get_char(dry_path, i) == 46) {
            dot_idx = i;
            i = -1;
        } else {
            i = i - 1;
        }
    }
    d_memcpy(out, dry_path, dot_idx);
    set_char(out, dot_idx, 46);
    set_char(out, dot_idx + 1, 114);
    set_char(out, dot_idx + 2, 111);
    set_char(out, dot_idx + 3, 115);
    set_char(out, dot_idx + 4, 0);
}

/* Write the cache blob next to dry_path.  Blob goes first (at offset 32),
 * header LAST as the commit point: a torn write leaves a zero/old header
 * that fails validation and forces a recompile.  Returns 0 or -1 (silent). */
static int ros_write_cache(char* dry_path, char* blob, int nwords, int main_off, int data_off) {
    long sb_buf[16];
    if (_raw_syscall(79, -100, dry_path, sb_buf, 0, 0, 0) != 0) return -1;
    long src_size = sb_buf[6];
    long src_mtime = sb_buf[11];

    char rpath[2048];
    ros_derive_path(rpath, dry_path);
    int cfd = (int)sys_openat(-100, rpath, 577, 493);
    if (cfd < 0) return -1;

    long hdr = sys_mmap(0, 64, 3, 34, -1, 0);
    if (hdr == 0) { sys_close(cfd); return -1; }

    if (sys_lseek(cfd, 32, 0) != 32) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (sys_write(cfd, blob, nwords * 4) != nwords * 4) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }

    set_uint(hdr, 0, ROS_MAGIC);
    set_uint(hdr, 1, (uint32_t)nwords);
    set_uint(hdr, 2, (uint32_t)main_off);
    set_uint(hdr, 3, (uint32_t)data_off);
    set_uint(hdr, 4, (uint32_t)src_size);
    set_uint(hdr, 5, (uint32_t)(src_mtime & 0xFFFFFFFF));
    set_uint(hdr, 6, (uint32_t)((src_mtime >> 32) & 0xFFFFFFFF));
    set_uint(hdr, 7, ROS_FORMAT_VER);
    if (sys_lseek(cfd, 0, 0) != 0) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (sys_write(cfd, (void*)hdr, 32) != 32) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }

    sys_munmap((void*)hdr, 64);
    sys_close(cfd);
    return 0;
}

/* fork and call the blob's main directly (argc/argv only — the blob has no
 * libc init).  Parent waits and propagates the child's exit status.
 * Returns child exit code, or -1 if the fork failed. */
static int ros_fork_exec_main(long base, int main_off, int argc, char** argv, char* arg0) {
    long c_argv = sys_mmap(0, 512, 3, 34, -1, 0);
    set_ptr(c_argv, 0, (long)arg0);
    int ci = 1;
    while (ci < argc - 1 && ci < 60) {
        set_ptr(c_argv, ci, get_ptr_64(argv, ci + 1));
        ci++;
    }
    set_ptr(c_argv, ci, 0);

    int pid = (int)_raw_syscall(220, 17, 0, 0, 0, 0, 0);
    if (pid == 0) {
        ros_main_fn fn = (ros_main_fn)(base + (long)main_off * 4);
        int nprog = argc - 1;
        if (nprog < 1) nprog = 1;
        int rc = fn(nprog, (void*)c_argv);
        _raw_syscall(93, rc, 0, 0, 0, 0, 0);
        _raw_syscall(94, rc, 0, 0, 0, 0, 0);
        while (1) {}
    } else if (pid > 0) {
        int wstatus = 0;
        _raw_syscall(260, pid, (long)&wstatus, 0, 0, 0, 0);
        sys_munmap((void*)c_argv, 512);
        if ((wstatus & 127) != 0) return 128 + (wstatus & 127);
        return (wstatus >> 8) & 255;
    } else {
        sys_munmap((void*)c_argv, 512);
        return -1;
    }
    return 0;
}

/* Map the blob at ROS_LOAD_ADDR, make code RX + data RW, run it.  The blob is
 * already resolved/backfilled for ROS_LOAD_ADDR by dc_compile_c. */
static int ros_exec_blob(char* blob, int nwords, int main_off, int data_off, int argc, char** argv, char* arg0) {
    int map_len = ((nwords * 4 + 4095) / 4096) * 4096;
    char* base = (char*)sys_mmap(ROS_LOAD_ADDR, map_len, 3, 50, -1, 0);
    if ((long)base != ROS_LOAD_ADDR) {
        if (base) sys_munmap((void*)base, map_len);
        return -1;
    }
    d_memcpy(base, blob, nwords * 4);
    drygon_icache_flush((void*)base, nwords * 4);
    _raw_syscall(226, (long)base, data_off, 5, 0, 0, 0);
    if (map_len > data_off) _raw_syscall(226, (long)base + data_off, map_len - data_off, 3, 0, 0, 0);
    int rc = ros_fork_exec_main((long)base, main_off, argc, argv, arg0);
    sys_munmap((void*)base, map_len);
    return rc;
}

/* Try to load and run the .ros cache for dry_path.  Any validation failure
 * (missing, stale, corrupt, old format) returns -1 so the caller compiles
 * fresh; success returns the program's exit code. */
static int ros_load_and_exec(char* dry_path, int argc, char** argv) {
    long sb_buf[16];
    if (_raw_syscall(79, -100, dry_path, sb_buf, 0, 0, 0) != 0) return -1;
    long src_size = sb_buf[6];
    long src_mtime = sb_buf[11];

    char rpath[2048];
    ros_derive_path(rpath, dry_path);
    long cb_buf[16];
    if (_raw_syscall(79, -100, rpath, cb_buf, 0, 0, 0) != 0) return -1;
    long ros_size = cb_buf[6];

    int cfd = (int)sys_openat(-100, rpath, 0, 0);
    if (cfd < 0) return -1;

    long hdr = sys_mmap(0, 64, 3, 34, -1, 0);
    if (hdr == 0) { sys_close(cfd); return -1; }
    if (sys_read(cfd, (void*)hdr, 32) != 32) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }

    int magic = get_int(hdr);
    int nwords = get_int(hdr + 4);
    int main_off = get_int(hdr + 8);
    int data_off = get_int(hdr + 12);
    int h_src_size = get_int(hdr + 16);
    int mtime_lo = get_int(hdr + 20);
    int mtime_hi = get_int(hdr + 24);
    int fmt_ver = get_int(hdr + 28);

    if (fmt_ver != ROS_FORMAT_VER) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (magic != ROS_MAGIC) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (nwords <= 0 || nwords > ROS_MAX_WORDS) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (ros_size != 32 + (long)nwords * 4) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (src_size != (long)h_src_size) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (mtime_hi != 0) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (src_mtime != (long)mtime_lo) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (data_off <= 0 || data_off > nwords * 4 || (data_off % 4096) != 0) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }
    if (main_off < 0 || (long)main_off * 4 >= data_off) { sys_munmap((void*)hdr, 64); sys_close(cfd); return -1; }

    int map_len = ((nwords * 4 + 4095) / 4096) * 4096;
    char* base = (char*)sys_mmap(ROS_LOAD_ADDR, map_len, 3, 50, -1, 0);
    if ((long)base != ROS_LOAD_ADDR) {
        sys_munmap((void*)hdr, 64);
        sys_close(cfd);
        if (base) sys_munmap((void*)base, map_len);
        return -1;
    }
    if (sys_lseek(cfd, 32, 0) != 32) {
        sys_munmap((void*)base, map_len);
        sys_munmap((void*)hdr, 64);
        sys_close(cfd);
        return -1;
    }
    if (sys_read(cfd, base, nwords * 4) != nwords * 4) {
        sys_munmap((void*)base, map_len);
        sys_munmap((void*)hdr, 64);
        sys_close(cfd);
        return -1;
    }
    sys_close(cfd);
    sys_munmap((void*)hdr, 64);

    drygon_icache_flush((void*)base, nwords * 4);
    _raw_syscall(226, (long)base, data_off, 5, 0, 0, 0);
    if (map_len > data_off) _raw_syscall(226, (long)base + data_off, map_len - data_off, 3, 0, 0, 0);

    int rc = ros_fork_exec_main((long)base, main_off, argc, argv, dry_path);
    sys_munmap((void*)base, map_len);
    return rc;
}

int drygon_compile_main(int argc, char** argv) {
    char* dry_path = 0;
    char* outname = 0;
    int want_elf = 0;
    char* src = 0;
    char* c_code = 0;
    int fd = 0;
    int src_len = 0;
    int c_len = 0;
    long ros_path = 0;
    int len = 0;
    int dot_idx = 0;
    long header_buf_2 = 0;
    long out_vars = 0;
    long blob = 0;
    int nwords = 0;
    int i = 0;
    int ros_file = 0;

    if (argc >= 2) {
        char* arg1 = (char*)get_ptr_64(argv, 1);
        if (arg1 && d_strcmp(arg1, "--rebuild") == 0) {
            return self_rebuild();
        }
        if (arg1 && d_strcmp(arg1, "--translate") == 0) {
            if (argc < 5) {
                d_puts("Usage: drygon --translate <src> <tgt> <input> [output]\n");
                d_puts("  src,tgt: py c java js ts html css\n");
                return 1;
            }
            char* src_lang = (char*)get_ptr_64(argv, 2);
            char* tgt_lang = (char*)get_ptr_64(argv, 3);
            char* in_path = (char*)get_ptr_64(argv, 4);
            int ifd = sys_openat(-100, in_path, 0, 0);
            if (ifd < 0) { d_puts("error: cannot open "); d_puts(in_path); d_puts("\n"); return 1; }
            long isz = sys_lseek(ifd, 0, 2);
            sys_lseek(ifd, 0, 0);
            /* prot must include WRITE: the code below appends a NUL at
             * ibuf[isz], and a read-only mapping faults on that store. */
            char* ibuf = (char*)sys_mmap(0, isz + 1, 3, 2, ifd, 0);
            sys_close(ifd);
            if (!ibuf || ibuf == (void*)-1) { d_puts("error: mmap failed\n"); return 1; }
            if (isz == 0) {
                /* a zero-length file maps no pages: use anonymous memory so
                 * the trailing NUL store does not SIGBUS.  flags 34 =
                 * MAP_PRIVATE | MAP_ANONYMOUS on aarch64 (0x20, not 0x800). */
                sys_munmap(ibuf, isz + 1);
                ibuf = (char*)sys_mmap(0, 4096, 3, 34, 0-1, 0);
                if (!ibuf || ibuf == (void*)-1) { d_puts("error: mmap failed\n"); return 1; }
                ibuf[0] = 0;
            } else {
                ibuf[isz] = 0;
            }
            char* result = translate_via_compiler(ibuf, src_lang, tgt_lang);
            sys_munmap(ibuf, isz + 1);
            if (!result) { d_puts("error: translation failed (unsupported lang pair?)\n"); return 1; }
            int rlen = d_strlen(result);
            char* out_path = 0;
            if (argc >= 6) {
                out_path = (char*)get_ptr_64(argv, 5);
            } else {
                out_path = (char*)sys_mmap(0, 1024, 3, 34, -1, 0);
                int bl = d_strlen(in_path);
                int dot = -1;
                int bi = 0;
                while (bi < bl) { if (in_path[bi] == 46) dot = bi; bi++; }
                if (dot > 0) {
                    d_memcpy(out_path, in_path, dot);
                    out_path[dot] = 0;
                } else {
                    d_strcpy(out_path, in_path);
                }
                d_strcat(out_path, ".");
                d_strcat(out_path, tgt_lang);
            }
            int ofd = sys_openat(-100, out_path, 1 | 64 | 512, 420);
            if (ofd < 0) { d_puts("error: cannot write "); d_puts(out_path); d_puts("\n"); return 1; }
            sys_write(ofd, result, rlen);
            sys_close(ofd);
            d_puts("translated "); d_puts(in_path); d_puts(" ("); d_puts(src_lang);
            d_puts(") -> "); d_puts(out_path); d_puts(" ("); d_puts(tgt_lang); d_puts(")\n");
            return 0;
        }
    }
    /* (fix: was `if (argc < 2)` — unreachable via jit_drygon_main, which only
     *  forwards argc >= 2; and `outname = argv[2]` below dereferenced NULL when
     *  no output name was given. Require both args explicitly.) */
    if (argc < 2) {
        d_puts("Usage: drygon <source.ccp> [output.{elf,ros}]\n");
        d_puts("       drygon --rebuild\n");
        d_puts("       drygon --translate <src> <tgt> <input> [output]\n");
        return 1;
    }
    {
        char* a1 = (char*)get_ptr_64(argv, 1);
        if (a1 && d_strcmp(a1, "--help") == 0) {
            d_puts("Usage: drygon <source.ccp> [output.{elf,ros}]\n");
            d_puts("       drygon --rebuild\n");
            d_puts("       drygon --translate <src> <tgt> <input> [output]\n");
            return 0;
        }
    }

    dry_path = (char*)get_ptr_64(argv, 1);
    outname = sys_mmap(0, 1024, 3, 34, -1, 0);
    int run_live = 1;
    int opt_o_idx = -1;
    int ai = 2;
    while (ai < argc) {
        char* a = (char*)get_ptr_64(argv, ai);
        if (a && d_strcmp(a, "-o") == 0) {
            opt_o_idx = ai;
            break;
        }
        ai++;
    }
    if (opt_o_idx >= 0 && opt_o_idx + 1 < argc) {
        run_live = 0;
        char* out_arg = (char*)get_ptr_64(argv, opt_o_idx + 1);
        d_strcpy(outname, out_arg);
    } else if (argc >= 3) {
        char* a2 = (char*)get_ptr_64(argv, 2);
        int a2len = a2 ? d_strlen(a2) : 0;
        if (a2 && a2len >= 4 && (d_strcmp(a2 + a2len - 4, ".elf") == 0 || d_strcmp(a2 + a2len - 4, ".ros") == 0)) {
            run_live = 0;
            d_strcpy(outname, a2);
        }
    }
    if (run_live) {
        d_strcpy(outname, "/data/data/com.termux/files/home/.drygon_run_");
        int mypid = (int)_raw_syscall(178, 0, 0, 0, 0, 0, 0);
        int olen = d_strlen(outname);
        if (mypid == 0) {
            outname[olen++] = '0';
        } else {
            char pstr[32]; int psi = 0; int tmp_p = mypid;
            while (tmp_p > 0) { pstr[psi++] = (tmp_p % 10) + '0'; tmp_p = tmp_p / 10; }
            while (psi > 0) { outname[olen++] = pstr[--psi]; }
        }
        outname[olen++] = '.';
        outname[olen++] = 'e';
        outname[olen++] = 'l';
        outname[olen++] = 'f';
        outname[olen] = 0;
    }
    src = sys_mmap(0, 16777216, 3, 34, -1, 0);
    c_code = sys_mmap(0, 16777216, 3, 34, -1, 0);
    ros_path = sys_mmap(0, 2048, 3, 34, -1, 0);
    header_buf_2 = sys_mmap(0, 16, 3, 34, -1, 0);
    out_vars = sys_mmap(0, 32, 3, 34, -1, 0);
    
    int _df = sys_openat(-100, dry_path, 0, 0);
    if (_df < 0) { d_puts("Cannot open file\n"); return 1; }
    src_len = sys_read(_df, src, 16777215);
    sys_close(_df);
    
    if (run_live) {
        /* .ros cache hit: run the cached blob directly, no compile, no temp ELF */
        int crc2 = ros_load_and_exec(dry_path, argc, argv);
        if (crc2 >= 0) return crc2;
    }
    
    c_len = extract_c_block(src, src_len, c_code, 16777215);
    if (src_has_cy_blocks(src, src_len)) {
        /* Polyglot @cy/@global source: the verbatim @c/@dry extraction above
         * silently DROPS Cython blocks (main compiled without its functions ->
         * trap at run). Route the whole file through the full fold: @c blocks
         * verbatim, @cy through the transpiler, @global hoisted to file scope. */
        d_puts("drygon: polyglot path entered\n");
        int brc = build_c_from_dry(dry_path, c_code, 16777215);
        d_puts("drygon: polyglot fold done\n");
        if (brc <= 64) { d_puts("drygon: polyglot fold produced no code\n"); return 1; }
        c_len = brc;
    } else if (c_len <= 0) {
        int is_python_syntax = 0;
        int plen = d_strlen(dry_path);
        if (plen >= 3 && dry_path[plen-3] == '.' && dry_path[plen-2] == 'p' && dry_path[plen-1] == 'y') {
            is_python_syntax = 1;
        } else if (!(plen >= 10 && d_strcmp(dry_path + plen - 10, "drygon.dry") == 0)) {
            int starts_with_c = (get_char(src, 0) == '/' && (get_char(src, 1) == '*' || get_char(src, 1) == '/'));
            if (!starts_with_c) {
                int looks_c = 0;
                int si = 0;
                while (si < src_len - 6) {
                    int at_start = (si == 0 || get_char(src, si-1) == 10);
                    if (at_start) {
                        while (si < src_len && (get_char(src, si) == ' ' || get_char(src, si) == '\t')) si++;
                        char s0 = get_char(src, si);
                        if (s0 == 'd' && get_char(src, si+1) == 'e' && get_char(src, si+2) == 'f' && get_char(src, si+3) == ' ') {
                            is_python_syntax = 1; break;
                        }
                        if (s0 == 'i' && get_char(src, si+1) == 'm' && get_char(src, si+2) == 'p' && get_char(src, si+3) == 'o' && get_char(src, si+4) == 'r' && get_char(src, si+5) == 't') {
                            is_python_syntax = 1; break;
                        }
                        if (s0 == 'f' && get_char(src, si+1) == 'r' && get_char(src, si+2) == 'o' && get_char(src, si+3) == 'm' && get_char(src, si+4) == ' ') {
                            is_python_syntax = 1; break;
                        }
                        if (s0 == 'c' && get_char(src, si+1) == 'l' && get_char(src, si+2) == 'a' && get_char(src, si+3) == 's' && get_char(src, si+4) == 's' && get_char(src, si+5) == ' ') {
                            is_python_syntax = 1; break;
                        }
                        /* C-subset source: a line starting with a type keyword
                         * (keyword + space/star/tab, so `int x = 1;` and
                         * `double* p` match but python's `int_thing = 1` and
                         * `float_ = 2` do not). */
                        char s1 = get_char(src, si+1);
                        if (s0 == 't' && s1 == 'y' && get_char(src, si+2) == 'p' && get_char(src, si+3) == 'e' && get_char(src, si+4) == 'd' && get_char(src, si+5) == 'e' && get_char(src, si+6) == 'f' && looks_kw_end(src, si+7)) looks_c = 1;
                        else if (s0 == 's' && s1 == 't' && get_char(src, si+2) == 'r' && get_char(src, si+3) == 'u' && get_char(src, si+4) == 'c' && get_char(src, si+5) == 't' && looks_kw_end(src, si+6)) looks_c = 1;
                        else if (s0 == 'u' && s1 == 'n' && get_char(src, si+2) == 'i' && get_char(src, si+3) == 'o' && get_char(src, si+4) == 'n' && looks_kw_end(src, si+5)) looks_c = 1;
                        else if (s0 == 'e' && s1 == 'n' && get_char(src, si+2) == 'u' && get_char(src, si+3) == 'm' && looks_kw_end(src, si+4)) looks_c = 1;
                        else if (s0 == 'e' && s1 == 'x' && get_char(src, si+2) == 't' && get_char(src, si+3) == 'e' && get_char(src, si+4) == 'r' && get_char(src, si+5) == 'n' && looks_kw_end(src, si+6)) looks_c = 1;
                        else if (s0 == 'u' && s1 == 'n' && get_char(src, si+2) == 's' && get_char(src, si+3) == 'i' && get_char(src, si+4) == 'g' && get_char(src, si+5) == 'n' && get_char(src, si+6) == 'e' && get_char(src, si+7) == 'd' && looks_kw_end(src, si+8)) looks_c = 1;
                        else if (s0 == 'c' && s1 == 'o' && get_char(src, si+2) == 'n' && get_char(src, si+3) == 's' && get_char(src, si+4) == 't' && looks_kw_end(src, si+5)) looks_c = 1;
                        else if (s0 == 's' && s1 == 'h' && get_char(src, si+2) == 'o' && get_char(src, si+3) == 'r' && get_char(src, si+4) == 't' && looks_kw_end(src, si+5)) looks_c = 1;
                        if (s0 == 'i' && s1 == 'n' && get_char(src, si+2) == 't' && looks_kw_end(src, si+3)) looks_c = 1;
                        else if (s0 == 'v' && s1 == 'o' && get_char(src, si+2) == 'i' && get_char(src, si+3) == 'd' && looks_kw_end(src, si+4)) looks_c = 1;
                        else if (s0 == 'c' && s1 == 'h' && get_char(src, si+2) == 'a' && get_char(src, si+3) == 'r' && looks_kw_end(src, si+4)) looks_c = 1;
                        else if (s0 == 'd' && s1 == 'o' && get_char(src, si+2) == 'u' && get_char(src, si+3) == 'b' && get_char(src, si+4) == 'l' && get_char(src, si+5) == 'e' && looks_kw_end(src, si+6)) looks_c = 1;
                        else if (s0 == 'l' && s1 == 'o' && get_char(src, si+2) == 'n' && get_char(src, si+3) == 'g' && looks_kw_end(src, si+4)) looks_c = 1;
                        else if (s0 == 'f' && s1 == 'l' && get_char(src, si+2) == 'o' && get_char(src, si+3) == 'a' && get_char(src, si+4) == 't' && looks_kw_end(src, si+5)) looks_c = 1;
                        else if (s0 == 's' && s1 == 't' && get_char(src, si+2) == 'a' && get_char(src, si+3) == 't' && get_char(src, si+4) == 'i' && get_char(src, si+5) == 'c' && looks_kw_end(src, si+6)) looks_c = 1;
                        else if (s0 == 's' && s1 == 't' && get_char(src, si+2) == 'r' && get_char(src, si+3) == 'u' && get_char(src, si+4) == 'c' && get_char(src, si+5) == 't' && looks_kw_end(src, si+6)) looks_c = 1;
                        else if (s0 == 'u' && s1 == 'n' && get_char(src, si+2) == 's' && get_char(src, si+3) == 'i' && get_char(src, si+4) == 'g' && get_char(src, si+5) == 'n' && get_char(src, si+6) == 'e' && get_char(src, si+7) == 'd' && looks_kw_end(src, si+8)) looks_c = 1;
                        if (looks_c) break;
                    }
                    si++;
                }
                if (!is_python_syntax && !looks_c) {
                    /* no def/import/class and no C declarations: a bare script
                     * (print + assignments) is Python, not C — the old default
                     * sent it to the raw-C path where top-level statements are
                     * silently skipped, leaving drygon_main undefined.  A file
                     * with no `=` and no `(` cannot be a python script either
                     * (whitespace, `;`, stray identifiers): the transpiler
                     * segfaults on such input, so those go to the raw-C path,
                     * which reports unresolved symbols instead. */
                    int has_assign = 0;
                    int si2 = 0;
                    while (si2 < src_len) {
                        int ch = get_char(src, si2);
                        if (ch == 61 || ch == 40) { has_assign = 1; break; }
                        si2 = si2 + 1;
                    }
                    if (has_assign) is_python_syntax = 1;
                }
            }
        }
        if (is_python_syntax) {
            char* trans_c = cc_transpile_py_to_c(src);
            if (trans_c) {
                int tlen = d_strlen(trans_c);
                if (tlen < 64) {
                    d_puts("drygon: transpilation produced no code\n");
                    return 1;
                }
                int i3 = 0; while (i3 < tlen) { set_char(c_code, i3, get_char((long)trans_c, i3)); i3++; }
                set_char(c_code, tlen, 0);
                c_len = tlen;
            } else {
                d_puts("Transpilation failed\n");
                return 1;
            }
        } else {
            int i2 = 0; while (i2 < src_len) { set_char(c_code, i2, get_char(src, i2)); i2++; }
            set_char(c_code, src_len, 0);
            c_len = src_len;
        }
    }
    
    len = d_strlen(outname);
    want_elf = !(len >= 4 &&
                  outname[len-4] == '.' &&
                  outname[len-3] == 'r' &&
                  outname[len-2] == 'o' &&
                  outname[len-1] == 's');
    
    if (want_elf) {
        if (run_live) {
            /* Live hot path: compile once for the .ros load base, prime the
             * cache, and execute the blob directly (no temp ELF, no exec).
             * Falls back to the temp-ELF path below if direct exec fails. */
            int drc2 = dc_compile_c(c_code, out_vars, out_vars + 8, out_vars + 16, out_vars + 24);
            if (drc2 != 0) {
                if (drc2 == -2) d_puts("drygon: compile failed: source has errors\n");
                else d_puts("drygon: compile failed (internal)\n");
                return 1;
            }
            blob = get_ptr(out_vars, 0);
            nwords = get_int(out_vars + 8);
            int mo2 = get_int(out_vars + 16);
            int do2 = get_int(out_vars + 24);
            ros_write_cache(dry_path, (char*)blob, nwords, mo2, do2);
            int erc = ros_exec_blob((char*)blob, nwords, mo2, do2, argc, argv, dry_path);
            if (erc >= 0) return erc;
            d_puts("drygon: direct execution failed; falling back to temp ELF\n");
        }
        long out_blob_buf = sys_mmap(0, 32, 3, 34, -1, 0);
        int out_len = 0;
        int main_off = 0;
        int _drc = dc_compile_elf(c_code, out_blob_buf, &out_len, &main_off);
        if (_drc != 0) {
            if (_drc == -2) d_puts("drygon: compile failed: source has errors\n");
            else d_puts("drygon: compile failed (internal)\n");
            sys_munmap(out_blob_buf, 32);
            return 1;
        }
        char* out_blob = (char*)get_ptr(out_blob_buf, 0);
        if (run_live) {
            int ofd = sys_openat(-100, outname, 577, 493);
            if (ofd < 0) {
                d_puts("Cannot create live runner\n");
                return 1;
            }
            sys_write(ofd, out_blob, out_len);
            sys_close(ofd);
            sys_munmap(out_blob_buf, 32);

            long c_argv = sys_mmap(0, 512, 3, 34, -1, 0);
            set_ptr(c_argv, 0, (long)outname);
            int ci = 1;
            while (ci < argc - 1 && ci < 60) {
                set_ptr(c_argv, ci, get_ptr_64(argv, ci + 1));
                ci++;
            }
            set_ptr(c_argv, ci, 0);

            long c_envp = sys_mmap(0, 16, 3, 34, -1, 0);
            set_ptr(c_envp, 0, 0);

            int pid = (int)_raw_syscall(220, 17, 0, 0, 0, 0, 0);
            if (pid == 0) {
                _raw_syscall(221, (long)outname, c_argv, c_envp, 0, 0, 0);
                _raw_syscall(93, 1, 0, 0, 0, 0, 0);
            } else if (pid > 0) {
                int wstatus = 0;
                _raw_syscall(260, pid, (long)&wstatus, 0, 0, 0, 0);
                _raw_syscall(35, -100, (long)outname, 0, 0, 0, 0);
                sys_munmap((void*)c_argv, 512);
                sys_munmap((void*)c_envp, 16);
                if ((wstatus & 127) != 0) return 128 + (wstatus & 127);
                return (wstatus >> 8) & 255;
            } else {
                d_puts("Fork failed\n");
                _raw_syscall(35, -100, (long)outname, 0, 0, 0, 0);
                sys_munmap((void*)c_argv, 512);
                sys_munmap((void*)c_envp, 16);
                return 1;
            }
            return 0;
        } else {
            d_puts("Opening output file: "); d_puts(outname); d_putc(10);
            int ofd = sys_openat(-100, outname, 577, 493);
            if (ofd >= 0) {
                int nwritten = sys_write(ofd, out_blob, out_len);
                sys_close(ofd);
                if (nwritten != out_len || out_len <= 0) {
                    d_puts("drygon: short write ("); d_putdec(nwritten);
                    d_puts(" of "); d_putdec(out_len); d_puts(" bytes)\n");
                    return 1;
                }
                d_puts("Written bytes: "); d_putdec(nwritten); d_putc(10);
                d_puts("Compiled to ELF binary\n");
                sys_munmap(out_blob_buf, 32);
                return 0;
            } else {
                d_puts("Cannot open output ELF file, ofd="); d_putdec(ofd); d_putc(10);
                return 1;
            }
        }
    } else {
        if (dc_compile_c(c_code, out_vars, out_vars + 8, out_vars + 16, out_vars + 24) != 0) {
            d_puts("Direct compile failed\n");
            return 1;
        }
        blob = get_ptr(out_vars, 0);
        nwords = get_int(out_vars + 8);
        
        ros_derive_path((char*)ros_path, dry_path);
        if (ros_write_cache(dry_path, (char*)blob, nwords, get_int(out_vars + 16), get_int(out_vars + 24)) == 0) {
            d_puts("Compiled to .ros\n");
        }
    }
    
    sys_munmap(src, 16777216);
    sys_munmap(c_code, 16777216);
    sys_munmap(ros_path, 2048);
    sys_munmap(header_buf_2, 16);
    sys_munmap(out_vars, 32);
    return 0;
}

int drygon_main(int argc, char** argv) {
    /* Resident the instruction-cache flusher AND the dmb barrier before any
     * worker thread exists — the bootstrap creates and unlinks a scratch file,
     * so doing it single-threaded keeps it race-free. */
    drygon_icache_flush((void*)0, 0);
    return drygon_compile_main(argc, argv);
}

/* ── THE JIT ENGINE ── */

    /* Native _raw_syscall is provided by Baccyn libc */
    // Pure C In-Memory JIT Executor (Sub-Millisecond Execution Engine)
    typedef float (*drygon_jit_fn)(const float* input, int size);
typedef float (*jit_drygon_jit_fn)(const float* input, int size);
    static inline void* drygon_mmap_exec_alloc(size_t size) {
        void* ptr = (void*)_raw_syscall(222, 0, size, 7, 34, -1, 0);
        if (ptr == MAP_FAILED) return NULL;
        return ptr;
    }
    static inline void drygon_mmap_free(void* ptr, size_t size) {
        if (ptr) _raw_syscall(215, (long)ptr, size, 0, 0, 0, 0);
    }
    // Executes an in-memory JIT machine-code buffer directly
    static inline float drygon_execute_jit_page(void* code_page, const float* input, int size) {
        if (!code_page) return 0.0f;
        drygon_jit_fn fn = (drygon_jit_fn)code_page;
        return fn(input, size);
    }
    static inline void* cast_to_void_p(uintptr_t addr) {
        return (void*)addr;
    }
    static inline uintptr_t cast_to_uintptr(void* ptr) {
        return (uintptr_t)ptr;
    }
    static inline int* cast_to_int_p(uintptr_t addr) {
        return (int*)addr;
    }
    static inline float* cast_to_float_p(uintptr_t addr) {
        return (float*)addr;
    }
    static inline int cast_to_int(float val) {
        return (int)val;
    }

/* Gryz: replaces the external chmod command with a JIT-compiled raw syscall.
 * Generates AArch64 machine code for sys_fchmodat and executes in-memory.
 * No external process, no static chmod — pure Gryz.
 * AArch64 calling convention: x0=dirfd, x1=path, x2=mode.
 * JIT code: mov x8,#53 (fchmodat) + svc #0 + ret — 3 instructions. */
typedef int (*gryz_chmod_fn)(int dirfd, const char* path, int mode);

static int gryz_chmod(const char* path, int mode) {
    void* page = drygon_mmap_exec_alloc(4096);
    if (!page) return -1;
    unsigned int* code = (unsigned int*)page;
    code[0] = 0xd28006a8;  /* mov x8, #53 (fchmodat syscall number) */
    code[1] = 0xd4000001;  /* svc #0 */
    code[2] = 0xd65f03c0;  /* ret */
    drygon_icache_flush(page, 12);
    gryz_chmod_fn fn = (gryz_chmod_fn)page;
    int result = fn(-100, path, mode);
    drygon_mmap_free(page, 4096);
    return result;
}


int main(int argc, char** argv) { return drygon_main(argc, argv); }

/* ZERO EXTERNAL DEPS — everything native */
#define PROT_READ     1
#define PROT_WRITE    2
#define PROT_EXEC     4
#define MAP_PRIVATE   2
#define MAP_ANONYMOUS 0x20
#define O_WRONLY      1
#define O_CREAT       64
#define O_RDONLY      0
#define AT_FDCWD      -100
typedef unsigned long size_t;

    /* ── IR — inlined, zero external includes ── */
    #ifndef CODE_CONVERTOR_IR_H

#ifndef DRYGON_TYPES
#define DRYGON_TYPES
typedef unsigned long size_t;
#endif
#ifndef NULL
#define NULL ((void*)0)
#endif
    #define CODE_CONVERTOR_IR_H

/* Custom primitive type replacements - no standard headers required */
#ifndef NULL
#define NULL ((void*)0)
#endif
/* cc_d_* duplicates removed — d_strlen/d_strcmp/d_strncmp/d_strchr/d_strstr/d_strcpy/d_strncpy already in monolith core */
static inline int d_isalpha(char c) { return (c>='a'&&c<='z')||(c>='A'&&c<='Z'); }
static inline int d_isalnum(char c) { return d_isalpha(c)||(c>='0'&&c<='9'); }
static inline int d_isdigit(char c) { return c>='0'&&c<='9'; }
static inline int d_isspace(char c) { return c==' '||c=='\t'||c=='\n'||c=='\r'; }

    #define IR_MAX_CHILDREN 1024
    #define IR_MAX_NAME 4112
    typedef struct IRNode IRNode;
    struct IRNode {
        char type[32];
        char value[IR_MAX_NAME];
        char data_type[16];
        int nchildren;
        IRNode* children[IR_MAX_CHILDREN];
    };
    /* Persistent arena for IR nodes - lives for the parse lifetime. */
    #define IR_ARENA_SIZE 268435456
    #define SIZEOF_IRNODE 12368
    static char* _ir_arena_pool = 0;
    static size_t _ir_arena_pos = 0;
    static void* ir_alloc(size_t sz) {
        if (!_ir_arena_pool) {
            _ir_arena_pool = (char*)sys_mmap(0, IR_ARENA_SIZE, 3, 34, -1, 0);
        }
        if (_ir_arena_pos + sz > IR_ARENA_SIZE) return NULL;
        void* p = (void*)(_ir_arena_pool + _ir_arena_pos);
        _ir_arena_pos += sz;
        return p;
    }
    static void ir_arena_reset(void) {
        _ir_arena_pos = 0;
    }
    static IRNode* ir_new(const char* type, const char* value, const char* data_type) {
        IRNode* n = (IRNode*)ir_alloc(SIZEOF_IRNODE);
        if (!n) return NULL;
        d_memset(n, 0, SIZEOF_IRNODE);
        if (type) {
            size_t i;
            for (i=0; i<31 && type[i]; i++) n->type[i] = type[i];
            for (; i<32; i++) n->type[i] = '\0';
        }
        if (value) {
            size_t i;
            for (i=0; i<IR_MAX_NAME-1 && value[i]; i++) n->value[i] = value[i];
            for (; i<IR_MAX_NAME; i++) n->value[i] = '\0';
        }
        if (data_type) {
            size_t i;
            for (i=0; i<15 && data_type[i]; i++) n->data_type[i] = data_type[i];
            for (; i<16; i++) n->data_type[i] = '\0';
        }
        return n;
    }
    static void ir_add_child(IRNode* parent, IRNode* child) {
        if (!parent || !child) return;
        int nc = parent->nchildren;
        if (nc < IR_MAX_CHILDREN) {
            parent->children[nc] = child;
            parent->nchildren = nc + 1;
        }
    }
    /* FNV-1a hash (deterministic) - shared by hnsw && vectorizer. */
    static unsigned fnv1a(const char* s) {
        unsigned h = 2166136261u;
        while (*s) { h ^= (unsigned char)*s++; h *= 16777619u; }
        return h;
    }

/* cc_d_snprintf removed — use d_snprintf from monolith core */
/* cc_* layer removed — all callers now use drygon-native names directly:
 * d_alloc → d_alloc, d_dealloc → d_dealloc, cc_realloc → d_realloc_impl,
 * d_memcpy → d_memcpy, cc_snprintf/cc_printf → d_puts/d_putdec. */

#endif /* CODE_CONVERTOR_IR_H */
    /* ── CODE CONVERTER — inlined, zero external includes ──
     * The d_strstr/d_strlen/d_strcmp/d_strncmp/d_memcpy/d_memset natives are
     * already defined in the monolith's core; only the three missing helpers
     * are added here. All libc ctype calls route to the native cc_* set. */
    static char* d_strchr(const char* s, int c) {
        while (*s) { if (*s == (char)c) return (char*)s; s++; }
        if (c == 0) return (char*)s;
        return (char*)0;
    }
    static char* d_strcpy_dup(char* d, const char* s) {
        char* o = d;
        while (*s) { *d++ = *s++; }
        *d = 0;
        return o;
    }
    static char* d_strncpy_dup(char* d, const char* s, int n) {
        int i = 0;
        while (i < n && s[i]) { d[i] = s[i]; i++; }
        while (i < n) { d[i] = 0; i++; }
        return d;
    }
/* UniversalNode IR, pure C.
     * A language-agnostic intermediate representation for C, Cython, Python, Java,
     * JS/TS, HTML/CSS. Node definitions are shared with the parsers and
     * generators); this module adds serialization helpers.
     */
    /* Deep-copy an IR tree. */
    static IRNode* ir_clone(const IRNode* src) {
        if (!src) return NULL;
        IRNode* n = ir_new(src->type, src->value, src->data_type);
        for (int i=0;i<src->nchildren;i++)
            ir_add_child(n, ir_clone(src->children[i]));
        return n;
    }
    /* ── nested def (closure) support ────────────────────────────────────
     * A def inside a def cannot nest in C. Each nested def is hoisted to
     * file scope; every enclosing parameter it reads is renamed to a
     * file-scope `_cap_<fn>_<var>` slot that the enclosing function fills
     * at the def site. A bare `return inner;` becomes `return 0;` and the
     * call site binds the assigned variable as an alias for the returned
     * function (no function pointers in the C subset). */
    static char cg_cap_decls[32][80];
    static int cg_ncap;
    static char cg_fnalias_caller[64][32];
    static char cg_fnalias_target[64][32];
    static int cg_nfnalias;
    /* variable -> returned-function aliases (f = make_adder(10)) */
    static char cg_fnavar[64][32];
    static char cg_fnatgt[64][32];
    static int cg_nfna;
    static void cg_fna_note(const char* var, const char* target) {
        int q = 0;
        while (q < cg_nfna) {
            if (d_strcmp(cg_fnavar[q], var) == 0) {
                int w = 0;
                while (w < 31 && target[w]) { cg_fnatgt[q][w] = target[w]; w++; }
                cg_fnatgt[q][w] = 0;
                return;
            }
            q++;
        }
        if (cg_nfna >= 64) return;
        int w = 0;
        while (w < 31 && var[w]) { cg_fnavar[cg_nfna][w] = var[w]; w++; }
        cg_fnavar[cg_nfna][w] = 0;
        w = 0;
        while (w < 31 && target[w]) { cg_fnatgt[cg_nfna][w] = target[w]; w++; }
        cg_fnatgt[cg_nfna][w] = 0;
        cg_nfna++;
    }
    static const char* cg_fna_of(const char* var) {
        int q = 0;
        while (q < cg_nfna) {
            if (d_strcmp(cg_fnavar[q], var) == 0) return cg_fnatgt[q];
            q++;
        }
        return NULL;
    }
    /* List/dict alias table: `b = a` makes b the SAME object as a, which the
     * identity tests (`a is b`) need.  The emitter tracks no other aliases, so
     * this is the one mechanism for python identity of two list names. */
    static char cg_lalias_from[64][32];
    static char cg_lalias_to[64][32];
    static int cg_nlalias;
    static void cg_lalias_note(const char* to, const char* from) {
        if (!to || !from || !to[0] || !from[0]) return;
        int i = 0;
        while (i < cg_nlalias) {
            if (d_strcmp(cg_lalias_to[i], to) == 0) {
                int k = 0;
                while (k < 31 && from[k]) { cg_lalias_from[i][k] = from[k]; k++; }
                cg_lalias_from[i][k] = 0;
                return;
            }
            i++;
        }
        if (cg_nlalias >= 64) return;
        { int k = 0;
          while (k < 31 && to[k]) { cg_lalias_to[cg_nlalias][k] = to[k]; k++; }
          cg_lalias_to[cg_nlalias][k] = 0; }
        { int k = 0;
          while (k < 31 && from[k]) { cg_lalias_from[cg_nlalias][k] = from[k]; k++; }
          cg_lalias_from[cg_nlalias][k] = 0; }
        cg_nlalias = cg_nlalias + 1;
    }
    static const char* cg_lalias_of(const char* name) {
        if (!name) return 0;
        int i = 0;
        while (i < cg_nlalias) {
            if (d_strcmp(cg_lalias_to[i], name) == 0) return cg_lalias_from[i];
            i++;
        }
        return 0;
    }
    static void cg_fnalias_note(const char* caller, const char* target) {
        int i = 0;
        while (i < cg_nfnalias) {
            if (d_strcmp(cg_fnalias_caller[i], caller) == 0) {
                int k = 0;
                while (k < 31 && target[k]) { cg_fnalias_target[i][k] = target[k]; k++; }
                cg_fnalias_target[i][k] = 0;
                return;
            }
            i++;
        }
        if (cg_nfnalias >= 64) return;
        int k = 0;
        while (k < 31 && caller[k]) { cg_fnalias_caller[cg_nfnalias][k] = caller[k]; k++; }
        cg_fnalias_caller[cg_nfnalias][k] = 0;
        k = 0;
        while (k < 31 && target[k]) { cg_fnalias_target[cg_nfnalias][k] = target[k]; k++; }
        cg_fnalias_target[cg_nfnalias][k] = 0;
        cg_nfnalias++;
    }
    static const char* cg_fnalias_of(const char* caller) {
        int i = 0;
        while (i < cg_nfnalias) {
            if (d_strcmp(cg_fnalias_caller[i], caller) == 0) return cg_fnalias_target[i];
            i++;
        }
        return 0;
    }
    /* ── per-alias closure captures ──────────────────────────────────────────
     * `add5 = make_adder(5)` and `add10 = make_adder(10)` both name the same
     * hoisted nested def, and the parameters that def captured live in one
     * file-scope `_cap_<fn>_<var>` cell each -- so the second factory call
     * overwrote the first's capture and both aliases behaved like the second
     * (`add5(3)` printed 13).  Every alias now gets its own cell copies
     * (`int _als_<alias>_<var>;`), a snapshot right after the binding, and a
     * generated forwarder `_alsfn_<alias>_<target>` that restores the cells
     * before delegating to the closure. */
    static char cg_als_var[64][64];
    static char cg_als_tgt[64][64];
    static char cg_als_wrap[64][64];
    static int  cg_als_n;
    static char cg_als_decls[64][96];
    static int  cg_nalsd;
    static char cg_cappn_fn[32][64];
    static char cg_cappn_var[384][64]; /* 32 functions x 12 captures, flattened: 3-D statics are unsupported */
    static int  cg_cappn_n[32];
    static int  cg_ncapp;
    static int cg_cappn_ix(const char* fn) {
        int i = 0;
        while (i < cg_ncapp) { if (d_strcmp(cg_cappn_fn[i], fn) == 0) return i; i++; }
        return -1;
    }
    static void cg_cappn_add(const char* fn, const char* var) {
        if (!fn || !var || !fn[0] || !var[0]) return;
        int i = cg_cappn_ix(fn);
        if (i < 0) {
            if (cg_ncapp >= 32) return;
            i = cg_ncapp;
            int k = 0;
            while (k < 63 && fn[k]) { cg_cappn_fn[i][k] = fn[k]; k++; }
            cg_cappn_fn[i][k] = 0;
            cg_cappn_n[i] = 0;
            cg_ncapp++;
        }
        int q = 0;
        while (q < cg_cappn_n[i]) {
            if (d_strcmp(cg_cappn_var[i*12+q], var) == 0) return;
            q++;
        }
        if (cg_cappn_n[i] >= 12) return;
        int w = 0;
        while (w < 63 && var[w]) { cg_cappn_var[i*12+cg_cappn_n[i]][w] = var[w]; w++; }
        cg_cappn_var[i*12+cg_cappn_n[i]][w] = 0;
        cg_cappn_n[i]++;
    }
    static int cg_als_ix(const char* var) {
        int i = 0;
        while (i < cg_als_n) { if (d_strcmp(cg_als_var[i], var) == 0) return i; i++; }
        return -1;
    }
    static const char* cg_als_wrap_of(const char* var) {
        if (!var) return 0;
        int i = cg_als_ix(var);
        if (i < 0) return 0;
        return cg_als_wrap[i];
    }
    /* `pre` + a + `_` + b, truncated into out (max must be > 2) */
    static void cg_als_slot(const char* pre, const char* a, const char* b, char* out, int max) {
        int k = 0, j = 0;
        while (pre[j] && k < max-1) { out[k] = pre[j]; k++; j++; }
        j = 0;
        while (a && a[j] && k < max-1) { out[k] = a[j]; k++; j++; }
        if (k < max-1) { out[k] = '_'; k++; }
        j = 0;
        while (b && b[j] && k < max-1) { out[k] = b[j]; k++; j++; }
        out[k] = 0;
    }
    /* a bare call `f(x)` spells the callee in the CALL node's own value slot
     * rather than as a child IDENTIFIER, so a *function-valued* name is only
     * visible here; `foo.meth()` (value "COMPLEX") is not a name reference */
    static int cg_call_named(const IRNode* n) {
        if (!n || d_strcmp(n->type,"CALL") != 0) return 0;
        if (!n->value || !n->value[0]) return 0;
        if (d_strcmp(n->value,"COMPLEX") == 0) return 0;
        return 1;
    }
    static int cg_ident_used(const IRNode* n, const char* name) {
        if (!n) return 0;
        if (d_strcmp(n->type,"IDENTIFIER")==0 && d_strcmp(n->value,name)==0) return 1;
        if (cg_call_named(n) && d_strcmp(n->value,name)==0) return 1;
        int i = 0;
        while (i < n->nchildren) {
            if (cg_ident_used(n->children[i], name)) return 1;
            i++;
        }
        return 0;
    }
    static void cg_ident_rename(IRNode* n, const char* from, const char* to) {
        if (!n) return;
        if (d_strcmp(n->type,"IDENTIFIER")==0 && d_strcmp(n->value,from)==0) {
            int k = 0;
            while (k < 4111 && to[k]) { n->value[k] = to[k]; k++; }
            n->value[k] = 0;
        } else if (cg_call_named(n) && d_strcmp(n->value,from)==0) {
            int k = 0;
            while (k < 4111 && to[k]) { n->value[k] = to[k]; k++; }
            n->value[k] = 0;
        }
        int i = 0;
        while (i < n->nchildren) { cg_ident_rename(n->children[i], from, to); i++; }
    }
    static void cg_return_bare_fix(IRNode* n, const char* fname) {
        if (!n) return;
        if (d_strcmp(n->type,"RETURN")==0 && n->nchildren==1 &&
            d_strcmp(n->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(n->children[0]->value,fname)==0) {
            IRNode* c = n->children[0];
            d_memcpy(c->type, "CONSTANT", 9);
            c->value[0] = '0'; c->value[1] = 0;
            d_memcpy(c->data_type, "INT", 4);
            return;
        }
        int i = 0;
        while (i < n->nchildren) { cg_return_bare_fix(n->children[i], fname); i++; }
    }
    /* ── dual representation for a name used as BOTH a list and a scalar ───────
     * The typed emitter infers ONE C type per name over the whole file, so
     * `x = 10` ... `x = [1,2,3]` declared x as a list and the scalar uses read
     * the array address (that is why 09_operators' check(x == 15) failed while
     * the first 52 lines passed alone).  python allows the rebind, so the scalar
     * uses get their own variable: every LIST-valued assignment to NAME renames
     * NAME to NAME$l in the left-hand side and in the reads that follow it, in
     * source order, until a non-list assignment takes the name back. */
    static int cg_dual_is_lit_list(const IRNode* rhs) {
        if (!rhs) return 0;
        if (d_strcmp(rhs->type,"BLOCK")==0 &&
            (d_strcmp(rhs->value,"LIST")==0 || d_strcmp(rhs->value,"TUPLE")==0 ||
             d_strcmp(rhs->value,"SET")==0 || d_strcmp(rhs->value,"DICT")==0)) return 1;
        if (d_strcmp(rhs->type,"CALL")==0 && rhs->value &&
            (d_strcmp(rhs->value,"list")==0 || d_strcmp(rhs->value,"tuple")==0 ||
             d_strcmp(rhs->value,"set")==0 || d_strcmp(rhs->value,"dict")==0)) return 1;
        return 0;
    }
    static const char* cg_dual_lit_assign(const IRNode* n) {
        if (!n || d_strcmp(n->type,"ASSIGN")!=0 || n->nchildren<2) return 0;
        const IRNode* lhs = n->children[0];
        if (!lhs || d_strcmp(lhs->type,"IDENTIFIER")!=0) return 0;
        return cg_dual_is_lit_list(n->children[1]) ? lhs->value : 0;
    }
    static void cg_dual_scan(const IRNode* a, char* lnames, char* snames, int* nl, int* ns) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1 &&
            a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0) {
            const char* nm = a->children[0]->value;
            if (nm && nm[0]) {
                int isL = cg_dual_is_lit_list(a->children[1]);
                char* buf = isL ? lnames : snames;
                int* np = isL ? nl : ns;
                int i = 0, dup = 0;
                while (i < *np) { if (d_strcmp(buf + i*64, nm)==0) { dup = 1; break; } i++; }
                if (!dup && *np < 64) { d_strncpy(buf + (*np)*64, nm, 63); buf[(*np)*64+63]=0; *np = *np + 1; }
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_dual_scan(a->children[i], lnames, snames, nl, ns); i++; }
    }
    static int cg_dual_has(const char* nm, char* names, int nn) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < nn) { if (d_strcmp(names + i*64, nm)==0) return 1; i++; }
        return 0;
    }
    /* walk one statement; `st` is the set of names currently list-valued */
        static int cg_dual_idx(const char* nm, char* names, int nn) {
        if (!nm || !nm[0]) return -1;
        int i = 0;
        while (i < nn) { if (d_strcmp(names + i*64, nm)==0) return i; i++; }
        return -1;
    }
    static void cg_dual_addlist(IRNode* nd) {
        int k = 0;
        while (nd->value[k]) k++;
        /* idempotent: never produce `x_dl_dl` */
        if (k >= 3 && nd->value[k-3]==95 && nd->value[k-2]==100 && nd->value[k-1]==108) return;
        /* `_dl` = dual-list.  A valid C identifier suffix, and the runtime's own
         * names never end in it. */
        if (k < 58) { nd->value[k] = 95; nd->value[k+1] = 100; nd->value[k+2] = 108; nd->value[k+3] = 0; }
    }
    /* walk one statement; `st[i]` says name i is currently LIST-valued */
    static void cg_dual_walk(IRNode* a, char* names, int nn, int* st) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>0) {
            IRNode* lhs = a->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) {
                int id = cg_dual_idx(lhs->value, names, nn);
                if (id >= 0) {
                    if (cg_dual_is_lit_list(a->nchildren>1 ? a->children[1] : NULL)) {
                        cg_dual_addlist(lhs);
                        st[id] = 1;
                    } else if (st[id] == 1 && a->value[0] != 0 &&
                               a->value[1] == 61 &&
                               (a->value[0] == 43 || a->value[0] == 42)) {
                        /* `lst *= 2` / `lst += x` on a name that is list-valued
                         * HERE: it stays a list.  The rename must happen in this
                         * ordered walk -- the emit-time list table is flat and
                         * cannot tell `x` (scalar at line 58) from `x_dl` (list
                         * at line 211), which sent integer `x *= 2` down the
                         * list-repeat path. */
                        cg_dual_addlist(lhs);
                    } else {
                        st[id] = 0;
                    }
                }
            }
            int i2 = 1;
            while (i2 < a->nchildren) { cg_dual_walk(a->children[i2], names, nn, st); i2++; }
            return;
        }
        if (d_strcmp(a->type,"IDENTIFIER")==0) {
            int id = cg_dual_idx(a->value, names, nn);
            if (id >= 0 && st[id] == 1) cg_dual_addlist(a);
            return;
        }
        int i = 0;
        while (i < a->nchildren) { cg_dual_walk(a->children[i], names, nn, st); i++; }
    }
    static void cg_dual_fixup(IRNode* prog) {
        char lnames[64*64];
        char snames[64*64];
        int nl = 0, ns = 0;
        char names[64*64];
        int nn = 0;
        int st[64];
        cg_dual_scan(prog, lnames, snames, &nl, &ns);
        /* ONLY a name used BOTH ways needs a second variable, and only at MODULE
         * level: a `result = []` inside a `def` is a LOCAL of that function, not
         * the module name, so renaming it made `fizzbuzz` write the file-scope
         * array and 10_control segfaulted. */
        int i = 0;
        while (i < nl) {
            if (cg_dual_has(lnames + i*64, snames, ns)) {
                d_strncpy(names + nn*64, lnames + i*64, 63); names[nn*64+63]=0; nn++;
            }
            i++;
        }
        if (nn == 0) return;
        i = 0;
        while (i < nn) { st[i] = 0; i++; }
        int j = 0;
        while (j < prog->nchildren) {
            IRNode* top = prog->children[j];
            if (top && (d_strcmp(top->type,"FUNCTION_DEF")==0 ||
                        d_strcmp(top->type,"CLASS_DEF")==0)) { j++; continue; }
            cg_dual_walk(top, names, nn, st);
            j++;
        }
    }
    /* ── function docstrings and names ──────────────────────────────────────
     * `f.__doc__` on a function: the docstring is a constant in the def's body,
     * so it is known statically.  The attribute used to be emitted as the bare
     * `__doc__` identifier, which the C front end could not parse at all
     * (11_functions 37). */
    static char cg_doc_names[128][64];
    static char cg_doc_text[128][480];
    static int cg_ndoc;
    /* the python name behind a C symbol: the decorator lowering renames the
     * original body `D` to `D_dorig` while the public `D` holds the wrapper,
     * so `f.__name__`/`f.__doc__` have to strip that suffix */
    static void cg_pyname(const char* nm, char* out, int cap) {
        int k = 0, i = 0;
        while (nm && nm[i] && k < cap - 1) { out[k] = nm[i]; k++; i++; }
        out[k] = 0;
        const char* sfx = "_dorig";
        if (k >= 6 && d_strcmp(out + (k - 6), sfx) == 0) out[k - 6] = 0;
    }
    static int cg_doc_ix(const char* nm) {
        int i = 0;
        while (i < cg_ndoc) { if (d_strcmp(cg_doc_names[i], nm) == 0) return i; i++; }
        char pn[80];
        cg_pyname(nm, pn, 80);
        if (d_strcmp(pn, nm) != 0) {
            i = 0;
            while (i < cg_ndoc) { if (d_strcmp(cg_doc_names[i], pn) == 0) return i; i++; }
        }
        return -1;
    }
    static void cg_doc_add(const char* nm, const char* lit) {
        if (!nm || !nm[0] || !lit) return;
        if (cg_ndoc >= 128) return;
        if (cg_doc_ix(nm) >= 0) return;
        int q = lit[0];
        if (q != '"' && q != '\'') return;
        int i = (lit[1] == q && lit[2] == q) ? 3 : 1;
        int k = 0;
        while (lit[i] && k < 470) {
            if (lit[i] == q) {
                if (lit[i+1] == q && lit[i+2] == q) break;
                if (lit[i+1] == 0) break;
            }
            cg_doc_text[cg_ndoc][k] = lit[i]; i++; k++;
        }
        cg_doc_text[cg_ndoc][k] = 0;
        d_strncpy(cg_doc_names[cg_ndoc], nm, 63);
        cg_ndoc++;
    }
    static void cg_doc_scan(IRNode* n) {
        if (!n) return;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 && n->nchildren >= 2) {
            IRNode* b = n->children[1];
            IRNode* lit = (IRNode*)0;
            if (b && b->nchildren > 0) {
                IRNode* s1 = b->children[0];
                if (s1 && d_strcmp(s1->type,"EXPR_STMT")==0 && s1->nchildren > 0) lit = s1->children[0];
                else if (s1 && d_strcmp(s1->type,"CONSTANT")==0) lit = s1;
            }
            if (lit && d_strcmp(lit->type,"CONSTANT")==0 && lit->value &&
                (lit->value[0] == '"' || lit->value[0] == '\'')) cg_doc_add(n->value, lit->value);
        }
        int i = 0;
        while (i < n->nchildren) { cg_doc_scan(n->children[i]); i++; }
    }
    /* ── persistent list defaults ────────────────────────────────────────────
     * Python materializes a parameter's default ONCE, when the `def` statement
     * runs, and every call that omits the argument shares that one object:
     * `def append_to(v, lst=[]): lst.append(v); return lst` therefore
     * ACCUMULATES -- `append_to(1)` gives [1] and the next call gives [1, 2].
     * A per-call-site literal temp (`_dylitK`, count 0) gave every call its own
     * empty list, so 57_nonlocal_global checks 12/13 saw [1] then [2].
     *
     * Each (function, parameter) with a LIST-literal default gets one
     * file-scope backing array (`_dydfK`) plus `_dydfK_n`; the array is filled
     * once at the start of drygon_main and every call site that omits the
     * argument passes that same object.  A callee that returns the parameter
     * hands the count back (see the list-return copy in the ASSIGN emitter), so
     * later calls see the element the earlier one appended.
     */
    static char cg_dsl_fn[32][32];
    static char cg_dsl_pn[32][32];
    static int cg_dsl_pi[32];
    static const IRNode* cg_dsl_def[32];
    static int cg_ndsl;
    static void cg_dsl_mkname(int k, char* out) {
        int q = 0;
        out[q]='_'; q++; out[q]='d'; q++; out[q]='y'; q++; out[q]='d'; q++; out[q]='f'; q++;
        if (k <= 0) { out[q]='0'; q++; }
        else {
            char rb[12];
            int rn = 0;
            int v = k;
            while (v > 0 && rn < 11) { rb[rn] = (char)(48 + (v % 10)); rn++; v = v / 10; }
            while (rn > 0) { rn--; out[q] = rb[rn]; q++; }
        }
        out[q] = 0;
    }
    static int cg_dsl_find(const char* fn, int pi) {
        int i = 0;
        while (i < cg_ndsl) {
            if (cg_dsl_pi[i] == pi && d_strcmp(cg_dsl_fn[i], fn) == 0) return i;
            i++;
        }
        return -1;
    }
    static int cg_dsl_add(const char* fn, int pi, const char* pn, const IRNode* def) {
        int i = cg_dsl_find(fn, pi);
        int k = 0;
        if (i >= 0) return i;
        if (cg_ndsl >= 32 || !fn || !fn[0]) return -1;
        while (k < 31 && fn[k]) { cg_dsl_fn[cg_ndsl][k] = fn[k]; k++; }
        cg_dsl_fn[cg_ndsl][k] = 0;
        k = 0;
        if (pn) while (k < 31 && pn[k]) { cg_dsl_pn[cg_ndsl][k] = pn[k]; k++; }
        cg_dsl_pn[cg_ndsl][k] = 0;
        cg_dsl_pi[cg_ndsl] = pi;
        cg_dsl_def[cg_ndsl] = def;
        cg_ndsl = cg_ndsl + 1;
        return cg_ndsl - 1;
    }
    /* The persistent-default slot a call site passes (`f(1, _dydf0, _dydf0_n)`),
     * or -1 when the call omits no list-literal default. */
    static int cg_dsl_arg_of(const IRNode* call) {
        int i = 0;
        if (!call) return -1;
        while (i < call->nchildren) {
            const IRNode* c = call->children[i];
            if (c && d_strcmp(c->type,"IDENTIFIER")==0 && c->value &&
                d_strncmp(c->value, "_dydf", 5) == 0) {
                int v = 0;
                int q = 5;
                while (c->value[q] >= '0' && c->value[q] <= '9') {
                    v = v * 10 + (c->value[q] - '0');
                    q++;
                }
                if (c->value[q] == 0 && v >= 0 && v < cg_ndsl) return v;
            }
            i++;
        }
        return -1;
    }
    /* A module-level name bound to a call that returned a persistent default
     * object IS that object (Python references), so the name is not a copy of
     * it: it is emitted as a C macro for the slot's array and count, which
     * makes every later read (print, len, `==`, indexing) see the object the
     * callee grew. */
    static char cg_dsl_an[32][32];
    static int cg_dsl_ans[32];
    static int cg_ndslan;
    static void cg_dsl_alias_add(const char* to, int slot) {
        int i = 0;
        if (!to || !to[0] || slot < 0) return;
        while (i < cg_ndslan) {
            if (d_strcmp(cg_dsl_an[i], to) == 0) { cg_dsl_ans[i] = slot; return; }
            i++;
        }
        if (cg_ndslan >= 32) return;
        { int k = 0;
          while (k < 31 && to[k]) { cg_dsl_an[cg_ndslan][k] = to[k]; k++; }
          cg_dsl_an[cg_ndslan][k] = 0; }
        cg_dsl_ans[cg_ndslan] = slot;
        cg_ndslan = cg_ndslan + 1;
    }
    static int cg_dsl_alias_of(const char* name) {
        int i = 0;
        if (!name) return -1;
        while (i < cg_ndslan) {
            if (d_strcmp(cg_dsl_an[i], name) == 0) return cg_dsl_ans[i];
            i++;
        }
        return -1;
    }
    static void cg_dsl_alias_scan(const IRNode* a, const IRNode* root) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren > 1) {
            const IRNode* l = a->children[0];
            const IRNode* r = a->children[1];
            if (l && r && d_strcmp(l->type,"IDENTIFIER")==0 && l->value &&
                d_strcmp(r->type,"CALL")==0 && r->value) {
                int _dk = cg_dsl_arg_of(r);
                if (_dk >= 0 && cg_dsl_ret_slot(root, r->value, _dk))
                    cg_dsl_alias_add(l->value, _dk);
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_dsl_alias_scan(a->children[i], root); i++; }
    }
    /* Rename those names to the slot they are bound to.  Every read, every
     * count (`NAME_n`) and every write then refers to the one object the callee
     * mutated, which is what Python's single-object semantics require. */
    static void cg_dsl_alias_rename(IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"IDENTIFIER")==0 && a->value) {
            int _dsl = cg_dsl_alias_of(a->value);
            if (_dsl >= 0 && _dsl < cg_ndsl) {
                char _dsn[32];
                cg_dsl_mkname(_dsl, _dsn);
                int _dq = 0;
                while (_dq < 31 && _dsn[_dq]) { a->value[_dq] = _dsn[_dq]; _dq++; }
                a->value[_dq] = 0;
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_dsl_alias_rename(a->children[i]); i++; }
    }
    /* Does `fn` RETURN the parameter that carries slot `k`?  Only then does the
     * callee hand the (mutated) list back, so only then may the caller write the
     * new count into the shared slot and record the identity alias. */
    static int cg_dsl_ret_slot(const IRNode* prog, const char* fn, int k) {
        int i = 0;
        if (!prog || !fn || k < 0 || k >= cg_ndsl) return 0;
        while (i < prog->nchildren) {
            const IRNode* c = prog->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && d_strcmp(c->value,fn)==0) {
                const IRNode* body = (c->nchildren > 1) ? c->children[1] : NULL;
                int j = 0;
                if (!body) return 0;
                while (j < body->nchildren) {
                    const IRNode* st = body->children[j];
                    if (st && d_strcmp(st->type,"RETURN")==0 && st->nchildren > 0 &&
                        d_strcmp(st->children[0]->type,"IDENTIFIER")==0 &&
                        d_strcmp(st->children[0]->value, cg_dsl_pn[k])==0) return 1;
                    j++;
                }
                return 0;
            }
            i++;
        }
        return 0;
    }
    /* ── keyword-argument call sites ─────────────────────────────────────────
     * Python matches a keyword argument by NAME, C only has positions.  A MIXED
     * call (`f(1, 2, d=10)`) put the keyword's value in the right slot but left
     * the slots it skipped EMPTY, so the generated C held `f(1, 2, , 10)` and
     * the C front end rejected the whole file (11_functions checks 39-41, and
     * the all-keyword form had the same hole for a defaulted parameter that no
     * keyword covers).  Rewrite the call in parameter order, taking each slot
     * from the positional argument, else the matching keyword, else the
     * parameter's own default.  A call that still cannot be completed (a
     * missing argument with no default, an unknown keyword, `*args`/`**kwargs`
     * forwarding, a sequence parameter) is left exactly as it was. */
    static IRNode* cg_kw_fn_params(IRNode* unit, const char* name) {
        int i = 0;
        IRNode* found = (IRNode*)0;
        if (!unit || !name || !name[0]) return (IRNode*)0;
        while (i < unit->nchildren) {
            IRNode* c = unit->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && d_strcmp(c->value,name)==0 &&
                c->nchildren > 0 && c->children[0] &&
                d_strcmp(c->children[0]->value,"PARAMS")==0) found = c->children[0];
            i++;
        }
        return found;
    }
    /* the `PARAMS` node of a class's `__init__`, found in the IR itself (class
     * registration only happens during emission, too late for a call-site
     * rewrite) */
    static IRNode* cg_kw_cls_params(IRNode* unit, const char* cls) {
        int i = 0;
        if (!unit || !cls || !cls[0]) return (IRNode*)0;
        while (i < unit->nchildren) {
            IRNode* c = unit->children[i];
            if (c && d_strcmp(c->type,"CLASS_DEF")==0 && d_strcmp(c->value,cls)==0 &&
                c->nchildren > 0 && c->children[0]) {
                IRNode* body = c->children[0];
                int j = 0;
                while (j < body->nchildren) {
                    IRNode* m = body->children[j];
                    if (m && d_strcmp(m->type,"FUNCTION_DEF")==0 &&
                        d_strcmp(m->value,"__init__")==0 && m->nchildren > 0 &&
                        m->children[0] && d_strcmp(m->children[0]->value,"PARAMS")==0)
                        return m->children[0];
                    j++;
                }
            }
            i++;
        }
        return (IRNode*)0;
    }
    static void cg_kw_call_fix(IRNode* n, IRNode* unit) {
        int nkw = 0, nstar = 0, i = 0, np = 0, j = 0, npos = 0, nout = 0, soff = 0, nplain = 0;
        IRNode* params;
        IRNode* posv[24];
        IRNode* out[24];
        if (!n || d_strcmp(n->type,"CALL")!=0 || !n->value || !n->value[0]) return;
        i = 0;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (c && d_strcmp(c->type,"KWARG")==0) nkw++;
            else if (c && (d_strcmp(c->type,"STAR_ARG")==0 || d_strcmp(c->type,"DSTAR_KW")==0)) nstar++;
            else if (c) nplain++;
            i++;
        }
        if (nstar != 0) return;
        if (nkw == 0) {
            /* A positional call that UNDER-SUPPLIES its arguments: every
             * Python default the call skipped left the corresponding C
             * parameter reading whatever the caller happened to leave in the
             * register, so `time(12, 30, 45)` has to become
             * `time___init__(&t, 12, 30, 45, 0)`.  A plain call names the
             * function itself, so its own defaults fill the gap; a dotted call
             * carries "COMPLEX" and is a method (or class) call, where a
             * same-named module-level def must never be consulted. */
            if (nplain == 0) return;
            params = (d_strcmp(n->value,"COMPLEX")==0) ? (IRNode*)0
                                                       : cg_kw_fn_params(unit, n->value);
            if (params) {
                soff = 0;
                if (params->nchildren > 0 &&
                    d_strcmp(params->children[0]->value,"self")==0) return;
            } else {
                params = cg_kw_cls_params(unit, n->value);
                if (!params) return;
                soff = 1;
            }
        } else {
            params = cg_kw_fn_params(unit, n->value);
            if (!params) {
                /* `Cls(days=7)`: the parameters are the `__init__`'s, minus the
                 * receiver.  Without this the call emitted the keyword NAMES as
                 * positional arguments (`Timedelta___init__(&t, days)`). */
                params = cg_kw_cls_params(unit, n->value);
                soff = 1;
            }
            if (!params) return;
        }
        np = params->nchildren - soff;
        if (np < 1 || np > 24) return;
        /* a method call parses as a call to the method's own name: never
         * rewrite one against a same-named module-level def */
        if (soff == 0 && d_strcmp(params->children[0]->value,"self")==0) return;
        while (j < np) {   /* a seq parameter takes array+count, a dict three
                            * arrays, `*args` the packed array: those shapes are
                            * emitted from the parameter's own type, so a LIST
                            * slot is fine here -- but a DICT/`*args` slot is
                            * not positional at all and bails (`Cls(**kw)` and
                            * variadic forwarding have their own paths). */
            const char* dt = params->children[j + soff]->data_type;
            if (dt && (d_strcmp(dt,"VARGS")==0 || d_strcmp(dt,"DICT")==0)) return;
            j++;
        }
        i = 0;                               /* every keyword must name a param */
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (c && d_strcmp(c->type,"KWARG")==0) {
                int hit = 0;
                j = 0;
                while (j < np) {
                    if (d_strcmp(params->children[j + soff]->value, c->value)==0) { hit = 1; break; }
                    j++;
                }
                if (!hit) return;
            }
            i++;
        }
        i = 0;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (c && d_strcmp(c->type,"KWARG")!=0 && npos < 24) { posv[npos] = c; npos++; }
            i++;
        }
        if (npos > np) return;
        if (nkw == 0 && npos == np) return;  /* every slot already supplied */
        j = 0;
        while (j < np) {
            IRNode* val = (IRNode*)0;
            if (j < npos) val = posv[j];
            else {
                i = 0;
                while (i < n->nchildren) {
                    IRNode* c = n->children[i];
                    if (c && d_strcmp(c->type,"KWARG")==0 && c->nchildren > 0 &&
                        d_strcmp(c->value, params->children[j + soff]->value)==0) { val = c->children[0]; break; }
                    i++;
                }
                if (!val && params->children[j + soff]->nchildren > 0) {
                    const IRNode* dv2 = params->children[j + soff]->children[0];
                    if (dv2 && d_strcmp(dv2->type,"BLOCK")==0 && dv2->value &&
                        (d_strcmp(dv2->value,"LIST")==0 || d_strcmp(dv2->value,"TUPLE")==0 ||
                         d_strcmp(dv2->value,"SET")==0)) {
                        int dk = cg_dsl_add(n->value, j + soff,
                                            params->children[j + soff]->value, dv2);
                        if (dk >= 0) {
                            char dnb[32];
                            cg_dsl_mkname(dk, dnb);
                            val = ir_new("IDENTIFIER", dnb, "ANY");
                        }
                    }
                    if (!val) val = ir_clone(params->children[j + soff]->children[0]);
                }
                if (!val) return;
            }
            out[nout] = val; nout++;
            j++;
        }
        n->nchildren = 0;
        j = 0;
        while (j < nout) { ir_add_child(n, out[j]); j++; }
    }
    static void cg_kw_walk(IRNode* n, IRNode* unit) {
        int i = 0;
        if (!n) return;
        cg_kw_call_fix(n, unit);
        while (i < n->nchildren) { cg_kw_walk(n->children[i], unit); i++; }
    }
    static void cg_kwarg_fixup(IRNode* unit) {
        cg_kw_walk(unit, unit);
    }
    /* ── function attributes (`f.custom_attr = "hello"`) ─────────────────────
     * `f.custom_attr` was emitted as the literal C `f.custom_attr`.  The C front
     * end tolerates that text but executes something unrelated to the value, so
     * check 38 of 11_functions passed only by accident and a standalone probe
     * (`def f(): pass; f.a = "x"; f.a == "x"`) segfaulted.  The model is static:
     * collect the string literal assigned to each `FUNC.attr` pair, drop those
     * assignment statements, and replace every read with the literal. */
    static int cg_fattr_n = 0;
    static char cg_fattr_base[32][64];
    static char cg_fattr_attr[32][64];
    static char cg_fattr_val[32][128];
    static int cg_fattr_is_fn(const IRNode* prog, const char* nm) {
        int i = 0;
        if (!prog || !nm || !nm[0]) return 0;
        while (i < prog->nchildren) {
            const IRNode* c = prog->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && d_strcmp(c->value,nm)==0) return 1;
            i++;
        }
        return 0;
    }
    static int cg_fattr_is_pair(const IRNode* n, const IRNode* prog) {
        if (!n || d_strcmp(n->type,"MEMBER_ACCESS")!=0 || n->nchildren < 1) return 0;
        if (!n->value || !n->value[0] || n->value[0]=='_') return 0;
        if (d_strcmp(n->children[0]->type,"IDENTIFIER")!=0) return 0;
        return cg_fattr_is_fn(prog, n->children[0]->value);
    }
    static int cg_fattr_ix(const char* b, const char* a) {
        int i = 0;
        while (i < cg_fattr_n) {
            if (d_strcmp(cg_fattr_base[i], b)==0 && d_strcmp(cg_fattr_attr[i], a)==0) return i;
            i++;
        }
        return -1;
    }
    static void cg_fattr_add(const char* b, const char* a, const char* v) {
        int i = cg_fattr_ix(b, a);
        if (i < 0) {
            if (cg_fattr_n >= 32) return;
            i = cg_fattr_n;
            cg_fattr_n = cg_fattr_n + 1;
            d_strncpy(cg_fattr_base[i], b, 63); cg_fattr_base[i][63] = 0;
            d_strncpy(cg_fattr_attr[i], a, 63); cg_fattr_attr[i][63] = 0;
        }
        d_strncpy(cg_fattr_val[i], v, 127); cg_fattr_val[i][127] = 0;
    }
    static void cg_fattr_walk(IRNode* n, IRNode* prog) {
        int i = 0;
        if (!n) return;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (c && d_strcmp(c->type,"ASSIGN")==0 && c->nchildren >= 2 &&
                cg_fattr_is_pair(c->children[0], prog) && c->children[1] &&
                d_strcmp(c->children[1]->type,"CONSTANT")==0 &&
                d_strcmp(c->children[1]->data_type,"STR")==0) {
                cg_fattr_add(c->children[0]->children[0]->value, c->children[0]->value,
                             c->children[1]->value);
                int j = i;
                while (j + 1 < n->nchildren) { n->children[j] = n->children[j+1]; j++; }
                n->nchildren = n->nchildren - 1;
                continue;
            }
            i++;
        }
        i = 0;
        while (i < n->nchildren) { cg_fattr_walk(n->children[i], prog); i++; }
    }
    static void cg_fattr_reads(IRNode* n, IRNode* prog) {
        int i = 0;
        if (!n) return;
        i = 0;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (c && cg_fattr_is_pair(c, prog)) {
                int k = cg_fattr_ix(c->children[0]->value, c->value);
                n->children[i] = ir_new("CONSTANT", k >= 0 ? cg_fattr_val[k] : "\"\"", "STR");
                c = n->children[i];
            }
            cg_fattr_reads(c, prog);
            i++;
        }
    }
    static void cg_fattr_fixup(IRNode* prog) {
        cg_fattr_n = 0;
        cg_fattr_walk(prog, prog);
        cg_fattr_reads(prog, prog);
    }
    /* ── decorator lowering ──────────────────────────────────────────────────
     * `@deco def D` is parsed as a DECORATOR statement followed by the plain
     * def, so the wrapper the decorator returns never ran (11_functions 33/34).
     * The python shape that matters is
     *     def deco(func):
     *         def wrapper(*args, **kwargs):
     *             ... func(...) ...
     *         return wrapper
     * so `@deco def D` is lowered to: rename D to `D_dorig`, and append a new
     * file-scope D that takes D's own parameters and runs the wrapper's body
     * with the `func` call replaced by a positional call to `D_dorig`.  This
     * runs BEFORE cg_closure_fixup, while `func` is still the wrapper's own
     * parameter name.  A decorator that names a class-level builtin
     * (`@property`, `@abstractmethod`) or a dotted path (`@value.setter`) has
     * no matching def and stays byte-identical. */
    static IRNode* cg_deco_find_def(IRNode* n, const char* nm) {
        if (!n) return (IRNode*)0;
        if (d_strcmp(n->type,"FUNCTION_DEF")==0 && d_strcmp(n->value,nm)==0) return n;
        int i = 0;
        while (i < n->nchildren) {
            IRNode* r = cg_deco_find_def(n->children[i], nm);
            if (r) return r;
            i++;
        }
        return (IRNode*)0;
    }
    /* the decorator's nested def (`wrapper`) */
    static IRNode* cg_deco_wrapper_of(IRNode* dec) {
        if (!dec || dec->nchildren < 2) return (IRNode*)0;
        IRNode* b = dec->children[1];
        int i = 0;
        while (b && i < b->nchildren) {
            IRNode* c = b->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0) return c;
            i++;
        }
        return (IRNode*)0;
    }
    /* rewrite every call to the decorated function: the callee becomes `to`
     * and a `*args, **kwargs` forward becomes a positional call carrying the
     * decorated function's own parameters */
    static void cg_deco_call_fix(IRNode* n, const char* from, const char* to, IRNode* params) {
        if (!n) return;
        if (d_strcmp(n->type,"CALL")==0 && d_strcmp(n->value,from)==0) {
            int fwd = 0, i = 0;
            while (i < n->nchildren) {
                IRNode* c = n->children[i];
                if (c && (d_strcmp(c->type,"STAR_ARG")==0 || d_strcmp(c->type,"DSTAR_KW")==0)) fwd = 1;
                i++;
            }
            d_strncpy(n->value, to, IR_MAX_NAME-1);
            if (fwd) {
                n->nchildren = 0;
                i = 0;
                while (params && i < params->nchildren) {
                    IRNode* pd = params->children[i];
                    if (pd) ir_add_child(n, ir_new("IDENTIFIER", pd->value, "ANY"));
                    i++;
                }
            }
        }
        int j = 0;
        while (j < n->nchildren) { cg_deco_call_fix(n->children[j], from, to, params); j++; }
    }
    static int cg_deco_params_simple(IRNode* dparams) {
        int i = 0;
        while (dparams && i < dparams->nchildren) {
            const char* dt = dparams->children[i]->data_type;
            if (dt && (d_strcmp(dt,"VARGS")==0 || d_strcmp(dt,"DICT")==0)) return 0;
            i++;
        }
        return 1;
    }
    static void cg_lru_apply(IRNode* D);
    static int py_lru_is(const char* dn);
    static int cg_is_float_node(const IRNode* a);
    /* `@dataclass`: synthesise an `__init__` that assigns each annotated field
     * from the matching constructor argument (37_dataclasses). */
    /* `@dataclass(frozen=True)` classes reject field assignments */
    static char cg_fr_names[64][32];
    static int cg_fr_n;
    static void cg_fr_add(const char* c) {
        if (!c || !c[0]) return;
        int i = 0;
        while (i < cg_fr_n) { if (d_strcmp(cg_fr_names[i], c)==0) return; i++; }
        if (cg_fr_n >= 64) return;
        d_strncpy(cg_fr_names[cg_fr_n], c, 31); cg_fr_names[cg_fr_n][31] = 0;
        cg_fr_n = cg_fr_n + 1;
    }
    static int cg_cls_is_frozen(const char* c) {
        if (!c) return 0;
        int i = 0;
        while (i < cg_fr_n) { if (d_strcmp(cg_fr_names[i], c)==0) return 1; i++; }
        return 0;
    }
    /* `__slots__ = ['x', 'y']`: the only attributes an instance of the class may
     * carry.  A store to any other name is an AttributeError at run time
     * (39_descriptors checks 17/20, 60_comprehensive check 41), and
     * `hasattr(cls, '__slots__')` has to answer 1.  cg_ss_pre collects the
     * names, folding in the slots of every base class: `__slots__` on a
     * subclass ADDS to the inherited set instead of replacing it. */
    static char cg_ss_cls[64][32];
    static char cg_ss_names[512][24];
    static int  cg_ss_cnt[64];
    static int  cg_ss_n;
    static void cg_strlit_copy(const char* s, char* out, int max);
    static const IRNode* cg_prog_class(const IRNode* prog, const char* nm);
    static int cg_ss_find(const char* c) {
        if (!c || !c[0]) return -1;
        int i = 0;
        while (i < cg_ss_n) { if (d_strcmp(cg_ss_cls[i], c)==0) return i; i++; }
        return -1;
    }
    static int cg_ss_add(const char* c) {
        if (!c || !c[0]) return -1;
        int i = cg_ss_find(c);
        if (i >= 0) return i;
        if (cg_ss_n >= 64) return -1;
        d_strncpy(cg_ss_cls[cg_ss_n], c, 31); cg_ss_cls[cg_ss_n][31] = 0;
        cg_ss_cnt[cg_ss_n] = 0;
        cg_ss_n = cg_ss_n + 1;
        return cg_ss_n - 1;
    }
    static int cg_ss_is_slotted(const char* c) { return cg_ss_find(c) >= 0; }
    static void cg_ss_note(const char* c, const char* nm) {
        int i = cg_ss_add(c);
        if (i < 0 || !nm || !nm[0]) return;
        int j = 0;
        while (j < cg_ss_cnt[i]) { if (d_strcmp(cg_ss_names[i*8+j], nm)==0) return; j++; }
        if (cg_ss_cnt[i] >= 8) return;
        d_strncpy(cg_ss_names[i*8+cg_ss_cnt[i]], nm, 23);
        cg_ss_names[i*8+cg_ss_cnt[i]][23] = 0;
        cg_ss_cnt[i] = cg_ss_cnt[i] + 1;
    }
    static int cg_ss_has(const char* c, const char* nm) {
        int i = cg_ss_find(c);
        if (i < 0 || !nm || !nm[0]) return 0;
        int j = 0;
        while (j < cg_ss_cnt[i]) { if (d_strcmp(cg_ss_names[i*8+j], nm)==0) return 1; j++; }
        return 0;
    }
    static void cg_ss_scan_cls(const IRNode* prog, const IRNode* cd, int depth) {
        if (!cd || !cd->value || !cd->value[0] || depth > 4) return;
        const IRNode* b = cd->nchildren>0 ? cd->children[0] : NULL;
        int own = 0;
        char own_names[8][24];
        int own_n = 0;
        if (b) {
            int j = 0;
            while (j < b->nchildren) {
                const IRNode* s = b->children[j];
                if (s && d_strcmp(s->type,"ASSIGN")==0 && s->nchildren>1 && s->children[0] &&
                    d_strcmp(s->children[0]->type,"IDENTIFIER")==0 &&
                    s->children[0]->value &&
                    d_strcmp(s->children[0]->value,"__slots__")==0) {
                    const IRNode* v = s->children[1];
                    if (v && d_strcmp(v->type,"BLOCK")==0 &&
                        (d_strcmp(v->value,"LIST")==0 || d_strcmp(v->value,"TUPLE")==0)) {
                        own = 1;
                        int k = 0;
                        while (k < v->nchildren && own_n < 8) {
                            const IRNode* e = v->children[k];
                            if (e && d_strcmp(e->type,"CONSTANT")==0 &&
                                (d_strcmp(e->data_type,"STR")==0 ||
                                 d_strcmp(e->data_type,"FSTR")==0)) {
                                char nmv[64];
                                nmv[0] = 0;
                                cg_strlit_copy(e->value, nmv, 64);
                                if (nmv[0]) {
                                    int q = 0, dup = 0;
                                    while (q < own_n) {
                                        if (d_strcmp(own_names[q], nmv)==0) dup = 1;
                                        q++;
                                    }
                                    if (!dup) {
                                        d_strncpy(own_names[own_n], nmv, 23);
                                        own_names[own_n][23] = 0;
                                        own_n++;
                                    }
                                }
                            }
                            k++;
                        }
                    }
                }
                j++;
            }
        }
        if (own) {
            int k = 0;
            cg_ss_add(cd->value);
            while (k < own_n) { cg_ss_note(cd->value, own_names[k]); k++; }
        }
        /* A class without `__slots__` of its own is not restricted even when a
         * base is, so it is simply left unregistered here. */
        if (cg_ss_find(cd->value) < 0) return;
        if (!cd->data_type) return;
        int s2 = 0, k2 = 0;
        while (cd->data_type[s2] && k2 < 4) {
            char bb[64];
            int e2 = s2, p2 = 0;
            while (cd->data_type[e2] && cd->data_type[e2] != ',') e2++;
            while (s2 + p2 < e2 && p2 < 63) { bb[p2] = cd->data_type[s2 + p2]; p2++; }
            bb[p2] = 0;
            if (p2 > 0 && d_strcmp(bb,"ANY")!=0) {
                const IRNode* bcd = cg_prog_class(prog, bb);
                if (bcd && bcd != cd) {
                    cg_ss_scan_cls(prog, bcd, depth + 1);
                    int bi = cg_ss_find(bb);
                    if (bi >= 0) {
                        int j2 = 0;
                        while (j2 < cg_ss_cnt[bi]) {
                            cg_ss_note(cd->value, cg_ss_names[bi*8+j2]);
                            j2++;
                        }
                    }
                }
            }
            if (!cd->data_type[e2]) break;
            s2 = e2 + 1;
            k2++;
        }
    }
    static void cg_ss_pre(const IRNode* prog) {
        if (!prog) return;
        int i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (n && d_strcmp(n->type,"CLASS_DEF")==0 && n->value && n->value[0])
                cg_ss_scan_cls(prog, n, 0);
            i++;
        }
    }
    static void cg_dataclass_init(IRNode* cls, int frozen, int order) {
        if (frozen) cg_fr_add(cls->value);
        if (!cls || d_strcmp(cls->type,"CLASS_DEF")!=0 || cls->nchildren<1) return;
        IRNode* body = cls->children[0];
        if (!body) return;
        int i = 0;
        while (i < body->nchildren) {
            IRNode* c = body->children[i];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 && c->value &&
                d_strcmp(c->value,"__init__")==0) return;
            i++;
        }
        IRNode* params = ir_new("BLOCK","PARAMS","ANY");
        IRNode* bd = ir_new("BLOCK","","ANY");
        ir_add_child(params, ir_new("PARAM_DECL","self","ANY"));
        i = 0;
        while (i < body->nchildren) {
            IRNode* c = body->children[i];
            if (c && d_strcmp(c->type,"VAR_DECL")==0 && c->value && c->value[0]) {
                                IRNode* p = ir_new("PARAM_DECL", c->value,
                                    ((c->data_type[0] && d_strcmp(c->data_type,"list")!=0) ? c->data_type : "ANY"));
                if (c->nchildren>0 && c->children[0]) {
                    IRNode* dv = c->children[0];
                    if (d_strcmp(dv->type,"CALL")==0 && dv->value &&
                        d_strcmp(dv->value,"field")==0) {
                        int k = 0;
                        const IRNode* dflt = 0;
                        while (k < dv->nchildren) {
                            const IRNode* kw = dv->children[k];
                            if (kw && d_strcmp(kw->type,"KWARG")==0 && kw->value &&
                                kw->nchildren>0) {
                                if (d_strcmp(kw->value,"default")==0) dflt = kw->children[0];
                                else if (d_strcmp(kw->value,"default_factory")==0) {
                                    const IRNode* fac = kw->children[0];
                                    if (fac && d_strcmp(fac->type,"IDENTIFIER")==0 &&
                                        d_strcmp(fac->value,"list")==0)
                                        dflt = ir_new("BLOCK","LIST","ANY");
                                }
                            }
                            k++;
                        }
                        if (dflt) ir_add_child(p, (IRNode*)dflt);
                    } else {
                        ir_add_child(p, dv);
                    }
                }
                ir_add_child(params, p);
                {
                    IRNode* asg = ir_new("ASSIGN","=","ANY");
                    IRNode* lhs = ir_new("MEMBER_ACCESS", c->value, ".");
                    ir_add_child(lhs, ir_new("IDENTIFIER","self","ANY"));
                    ir_add_child(asg, lhs);
                    ir_add_child(asg, ir_new("IDENTIFIER", c->value, "ANY"));
                    ir_add_child(bd, asg);
                }
            }
            i++;
        }
        IRNode* fn = ir_new("FUNCTION_DEF","__init__","VOID");
        ir_add_child(fn, params);
        ir_add_child(fn, bd);
        ir_add_child(body, fn);
        /* `__repr__`: "Cls(field=value, ...)" (37_dataclasses checks 5-7) */
        {
            IRNode* rp = ir_new("BLOCK","PARAMS","ANY");
            ir_add_child(rp, ir_new("PARAM_DECL","self","ANY"));
            IRNode* rb = ir_new("BLOCK","","ANY");
            char hd[96]; int hz = 0;
            hd[hz++]='"';
            { const char* cvv = cls->value; int cq=0; while (cvv[cq] && hz<80) hd[hz++]=cvv[cq++]; }
            hd[hz++]='('; hd[hz++]='"'; hd[hz]=0;
            IRNode* cat = ir_new("CONSTANT", hd, "STR");
            int first = 1;
            int j = 0;
            while (j < body->nchildren) {
                IRNode* c = body->children[j];
                if (c && d_strcmp(c->type,"VAR_DECL")==0 && c->value && c->value[0]) {
                    char pf[96]; int pz = 0;
                    pf[pz++]='"';
                    if (!first) { pf[pz++]=','; pf[pz++]=' '; }
                    { int q=0; while (c->value[q] && pz<80) pf[pz++]=c->value[q++]; }
                    pf[pz++]='='; pf[pz++]='"'; pf[pz]=0;
                    IRNode* lc = ir_new("BINARY_OP","+","ANY");
                    ir_add_child(lc, cat);
                    ir_add_child(lc, ir_new("CONSTANT", pf, "STR"));
                    IRNode* sc = ir_new("CALL","str","ANY");
                    IRNode* ma = ir_new("MEMBER_ACCESS", c->value, ".");
                    ir_add_child(ma, ir_new("IDENTIFIER","self","ANY"));
                    ir_add_child(sc, ma);
                    IRNode* cc = ir_new("BINARY_OP","+","ANY");
                    ir_add_child(cc, lc);
                    ir_add_child(cc, sc);
                    cat = cc;
                    first = 0;
                }
                j++;
            }
            IRNode* fin = ir_new("BINARY_OP","+","ANY");
            ir_add_child(fin, cat);
            ir_add_child(fin, ir_new("CONSTANT", "\")\"", "STR"));
            IRNode* ret = ir_new("RETURN","","ANY");
            ir_add_child(ret, fin);
            ir_add_child(rb, ret);
            IRNode* rfn = ir_new("FUNCTION_DEF","__repr__","VOID");
            ir_add_child(rfn, rp);
            ir_add_child(rfn, rb);
            ir_add_child(body, rfn);
        }
        /* `__eq__`: compare every field (37_dataclasses checks 8-9) */
        {
            IRNode* ep = ir_new("BLOCK","PARAMS","ANY");
            ir_add_child(ep, ir_new("PARAM_DECL","self","ANY"));
            /* `ANY` -- the emitter types a parameter that is dereferenced as an
             * instance of this class as `<Cls>*`, which is what every
             * comparison call site hands over (`Cls___eq__(&a, &b)`).  Typed as
             * the class itself the parameter was passed BY VALUE and `other.x`
             * read the pointer as a struct (37_dataclasses 8). */
            ir_add_child(ep, ir_new("PARAM_DECL","other", "ANY"));
            IRNode* eb = ir_new("BLOCK","","ANY");
            IRNode* cmp = 0;
            int j2 = 0;
            while (j2 < body->nchildren) {
                IRNode* c = body->children[j2];
                if (c && d_strcmp(c->type,"VAR_DECL")==0 && c->value && c->value[0]) {
                    IRNode* l = ir_new("MEMBER_ACCESS", c->value, ".");
                    ir_add_child(l, ir_new("IDENTIFIER","self","ANY"));
                    IRNode* r = ir_new("MEMBER_ACCESS", c->value, ".");
                    ir_add_child(r, ir_new("IDENTIFIER","other","ANY"));
                    IRNode* eq = ir_new("BINARY_OP","==","ANY");
                    ir_add_child(eq, l); ir_add_child(eq, r);
                    if (!cmp) cmp = eq;
                    else {
                        IRNode* an = ir_new("BINARY_OP","and","ANY");
                        ir_add_child(an, cmp); ir_add_child(an, eq);
                        cmp = an;
                    }
                }
                j2++;
            }
            if (!cmp) cmp = ir_new("CONSTANT","1","BOOL");
            IRNode* eret = ir_new("RETURN","","ANY");
            ir_add_child(eret, cmp);
            ir_add_child(eb, eret);
            IRNode* efn = ir_new("FUNCTION_DEF","__eq__","VOID");
            ir_add_child(efn, ep);
            ir_add_child(efn, eb);
            ir_add_child(body, efn);
        }
        /* `@dataclass(order=True)`: generate `__lt__` so `.sort()` works */
        if (order) {
            char flds[32][32]; int fn = 0;
            int j3 = 0;
            while (j3 < body->nchildren) {
                IRNode* c = body->children[j3];
                if (c && d_strcmp(c->type,"VAR_DECL")==0 && c->value && c->value[0] && fn < 32) {
                    d_strncpy(flds[fn], c->value, 31); flds[fn][31] = 0; fn++;
                }
                j3++;
            }
            IRNode* lp = ir_new("BLOCK","PARAMS","ANY");
            ir_add_child(lp, ir_new("PARAM_DECL","self","ANY"));
            ir_add_child(lp, ir_new("PARAM_DECL","other", "ANY"));
            IRNode* lb = ir_new("BLOCK","","ANY");
            IRNode* expr = 0;
            int fi = fn - 1;
            while (fi >= 0) {
                IRNode* l1 = ir_new("MEMBER_ACCESS", flds[fi], ".");
                ir_add_child(l1, ir_new("IDENTIFIER","self","ANY"));
                IRNode* r1 = ir_new("MEMBER_ACCESS", flds[fi], ".");
                ir_add_child(r1, ir_new("IDENTIFIER","other","ANY"));
                IRNode* lt = ir_new("BINARY_OP","<","ANY");
                ir_add_child(lt, l1); ir_add_child(lt, r1);
                if (!expr) expr = lt;
                else {
                    IRNode* l2 = ir_new("MEMBER_ACCESS", flds[fi], ".");
                    ir_add_child(l2, ir_new("IDENTIFIER","self","ANY"));
                    IRNode* r2 = ir_new("MEMBER_ACCESS", flds[fi], ".");
                    ir_add_child(r2, ir_new("IDENTIFIER","other","ANY"));
                    IRNode* neq = ir_new("BINARY_OP","!=","ANY");
                    ir_add_child(neq, l2); ir_add_child(neq, r2);
                    IRNode* ife = ir_new("IFEXP","","ANY");
                    ir_add_child(ife, neq); ir_add_child(ife, lt); ir_add_child(ife, expr);
                    expr = ife;
                }
                fi--;
            }
            if (!expr) expr = ir_new("CONSTANT","0","BOOL");
            IRNode* lret = ir_new("RETURN","","ANY");
            ir_add_child(lret, expr);
            ir_add_child(lb, lret);
            IRNode* lfn = ir_new("FUNCTION_DEF","__lt__","VOID");
            ir_add_child(lfn, lp);
            ir_add_child(lfn, lb);
            ir_add_child(body, lfn);
        }
    }
    static void cg_deco_walk(IRNode* blk, IRNode* unit) {
        if (!blk) return;
        int limit = blk->nchildren;
        int i = 0;
        while (i < limit) {
            IRNode* c = blk->children[i];
            if (c && d_strcmp(c->type,"DECORATOR")==0 && i + 1 < limit) {
                IRNode* D = blk->children[i+1];
                const char* dn = c->value;
                /* a `@dataclass` before a class synthesises `__init__` */
                if (dn && D && d_strcmp(D->type,"CLASS_DEF")==0) {
                    int _dl = d_strlen((char*)dn);
                    if (d_strcmp(dn,"dataclass")==0 ||
                        (_dl >= 9 && d_strcmp(dn + _dl - 9, "dataclass")==0)) {
                        int _fr = (c->data_type[0]=='F');
                        int _or = (c->data_type[0]=='O' || c->data_type[1]=='O');
                        cg_dataclass_init(D, _fr, _or);
                    }
                }
                /* `@lru_cache`: no wrapper def exists to inline (the name is a
                 * builtin), so the memo probe and store are applied to the
                 * decorated body itself. */
                if (py_lru_is(dn) && D && d_strcmp(D->type,"FUNCTION_DEF")==0 &&
                    D->nchildren >= 2) cg_lru_apply(D);
                int dot = 0, k = 0;
                while (dn && dn[k]) { if (dn[k] == '.') dot = 1; k++; }
                if (!dot && dn && dn[0] && D && d_strcmp(D->type,"FUNCTION_DEF")==0 && D->nchildren >= 2) {
                    IRNode* dec = cg_deco_find_def(unit, dn);
                    IRNode* wrap = cg_deco_wrapper_of(dec);
                    IRNode* dparams = D->children[0];
                    if (dec && dec->nchildren >= 2 && dec->children[0] &&
                        dec->children[0]->nchildren >= 1 && wrap && wrap->nchildren >= 2 &&
                        dparams && D->children[1] && cg_deco_params_simple(dparams)) {
                        const char* fp = dec->children[0]->children[0]->value;
                        char orig[128];
                        int z = 0;
                        while (D->value[z] && z < 110) { orig[z] = D->value[z]; z++; }
                        const char* sfx = "_dorig";
                        int q = 0;
                        while (sfx[q] && z < 126) { orig[z] = sfx[q]; z++; q++; }
                        orig[z] = 0;
                        IRNode* nb = ir_clone(wrap->children[1]);
                        cg_deco_call_fix(nb, fp, orig, dparams);
                        cg_ident_rename(nb, fp, orig);
                        /* a forwarded parameter the body still reads elsewhere
                         * has no backing store: leave the decorator alone
                         * rather than emit an unresolved read */
                        int bad = 0, wp = 0;
                        while (wrap->children[0] && wp < wrap->children[0]->nchildren) {
                            const char* pv = wrap->children[0]->children[wp]->value;
                            if (pv && pv[0] && d_strcmp(pv,fp)!=0 && cg_ident_used(nb, pv)) {
                                /* the wrapper's own parameter only has a backing
                                 * store in the rewritten function when the
                                 * decorated function declares a parameter of the
                                 * same name; a `*args` forward is dropped by
                                 * cg_deco_call_fix and reads nothing. */
                                int have = 0, dp = 0;
                                while (dparams && dp < dparams->nchildren) {
                                    IRNode* pd = dparams->children[dp];
                                    if (pd && d_strcmp(pd->value, pv)==0) have = 1;
                                    dp++;
                                }
                                if (!have) bad = 1;
                            }
                            wp++;
                        }
                        if (cg_ident_used(nb, fp)) bad = 1;
                        if (!bad) {
                            IRNode* nd = ir_new("FUNCTION_DEF", D->value, D->data_type);
                            ir_add_child(nd, ir_clone(dparams));
                            ir_add_child(nd, nb);
                            d_strncpy(D->value, orig, IR_MAX_NAME-1);
                            blk->children[i] = ir_new("ASSIGN", "=", "ANY");
                            ir_add_child(blk->children[i], ir_new("IDENTIFIER", "drygon_rl_n", "INT"));
                            ir_add_child(blk->children[i], ir_new("IDENTIFIER", "drygon_rl_n", "INT"));
                            ir_add_child(unit, nd);
                        }
                    }
                }
            }
            if (c) cg_deco_walk(c, unit);
            i++;
        }
    }
    static void cg_decorator_fixup(IRNode* unit) {
        if (!unit) return;
        cg_deco_walk(unit, unit);
    }
    static void cg_closure_fixup(IRNode* unit) {
        if (!unit) return;
        int ui = 0;
        while (ui < unit->nchildren) {
            IRNode* f = unit->children[ui];
            ui++;
            if (!f || d_strcmp(f->type,"FUNCTION_DEF") != 0) continue;
            if (f->nchildren < 2) continue;
            IRNode* fparams = f->children[0];
            IRNode* body = f->children[1];
            if (!body) continue;
            int si = 0;
            while (si < body->nchildren) {
                IRNode* gdef = body->children[si];
                if (!gdef || d_strcmp(gdef->type,"FUNCTION_DEF") != 0 || gdef->nchildren < 2) { si++; continue; }
                IRNode* gbody = gdef->children[1];
                if (!gbody) { si++; continue; }
                /* every enclosing parameter read by the nested def becomes a
                 * `_cap_<nested>_<var>` slot filled at the def site */
                int need = 0;
                int pi = 0;
                while (fparams && pi < fparams->nchildren) {
                    const char* v = fparams->children[pi]->value;
                    if (v && v[0] && cg_ident_used(gbody, v)) {
                        char cap[80];
                        int k = 0;
                        const char* pre = "_cap_";
                        while (pre[k]) { cap[k] = pre[k]; k++; }
                        int k2 = 0;
                        while (gdef->value[k2] && k < 78) { cap[k] = gdef->value[k2]; k++; k2++; }
                        if (k < 78) cap[k] = '_'; k++;
                        k2 = 0;
                        while (v[k2] && k < 78) { cap[k] = v[k2]; k++; k2++; }
                        cap[k] = 0;
                        cg_ident_rename(gbody, v, cap);
                        /* remember the original parameter name: the alias
                         * snapshot and the forwarder have to spell the same
                         * `_cap_<fn>_<var>` cell */
                        cg_cappn_add(gdef->value, v);
                        if (cg_ncap < 32) {
                            const char* dpre = "int ";
                            int dk = 0;
                            while (dpre[dk]) { cg_cap_decls[cg_ncap][dk] = dpre[dk]; dk++; }
                            int dv = 0;
                            while (cap[dv] && dk < 78) { cg_cap_decls[cg_ncap][dk] = cap[dv]; dk++; dv++; }
                            cg_cap_decls[cg_ncap][dk] = ';';
                            cg_cap_decls[cg_ncap][dk+1] = 0;
                            cg_ncap++;
                        }
                        IRNode* asg = ir_new("ASSIGN", "=", "ANY");
                        ir_add_child(asg, ir_new("IDENTIFIER", cap, "ANY"));
                        ir_add_child(asg, ir_new("IDENTIFIER", v, "ANY"));
                        /* replace the nested def with the cap fill, keeping
                         * any remaining assignments in the following slots */
                        if (need == 0) body->children[si] = asg;
                        else {
                            int z = body->nchildren;
                            while (z > si + need) { body->children[z] = body->children[z-1]; z--; }
                            body->children[si + need] = asg;
                        }
                        need++;
                    }
                    pi++;
                }
                if (need == 0) {
                    /* the nested def captures nothing: keep its position but
                     * it still has to move out of the C body */
                    IRNode* nop = ir_new("ASSIGN", "=", "ANY");
                    ir_add_child(nop, ir_new("IDENTIFIER", "drygon_rl_n", "INT"));
                    ir_add_child(nop, ir_new("IDENTIFIER", "drygon_rl_n", "INT"));
                    body->children[si] = nop;
                }
                /* a bare `return <nested>;` hands the function identity to
                 * the caller: replace with 0 and bind the alias */
                cg_return_bare_fix(f, gdef->value);
                cg_fnalias_note(f->value, gdef->value);
                /* hoist the nested def to file scope, after all top-level
                 * functions so every helper it calls is already declared */
                ir_add_child(unit, gdef);
                si = si + (need > 0 ? need : 1);
            }
        }
    }
    /* ── lambda lifting ──────────────────────────────────────────────────────
     * `lambda a, b: expr` in an expression position (`reduce(f, xs)`,
     * `weakref.finalize(o, lambda: ...)`, `d["k"] = lambda self: ...`) is a
     * value the emitter has no representation for: the LAMBDA node used to
     * emit nothing at all, leaving a hole in the generated call (`reduce(, ..)`)
     * that the C front end turned into a runtime trap.  The C this compiler
     * emits spells "a function used as a value" as its bare name, so every
     * lambda becomes a file-scope function `_dylam<N>` returning the
     * expression body, and the LAMBDA node is replaced by that name.
     * Runs after the builtin folds (a folded `map(lambda x: x*2, [1,2])` is
     * gone by now) and after the closure fixup. */
    static int cg_dylam_n = 0;
    /* ── closure environment arrays ─────────────────────────────────────────
     * `lst.append(lambda x=i: x)` creates one closure per iteration, each
     * with its own early-bound default.  A single file-scope variable shared
     * by every closure hands them all the LAST value, so a list that receives
     * such a lambda gets a parallel environment array `lst_env[64]` written by
     * the capture helper at the index the append is about to use, and passed
     * to the lifted function at every call through that list. */
    static int cg_clos_n = 0;
    static char cg_clos_names[64*64];
    static int cg_clos_flags[64];
    static int cg_clos_add(const char* name, int kind) {
        if (!name) return -1;
        int i = 0;
        while (i < cg_clos_n) {
            int j = 0, same = 1;
            while (name[j] || cg_clos_names[i*64 + j]) {
                if (name[j] != cg_clos_names[i*64 + j]) { same = 0; break; }
                j++;
            }
            if (same) return i;
            i++;
        }
        if (cg_clos_n >= 64) return -1;
        int j = 0;
        while (name[j] && j < 63) { cg_clos_names[cg_clos_n*64 + j] = name[j]; j++; }
        cg_clos_names[cg_clos_n*64 + j] = 0;
        cg_clos_flags[cg_clos_n] = kind;
        cg_clos_n = cg_clos_n + 1;
        return cg_clos_n - 1;
    }
    static int cg_clos_ix(const char* name) {
        if (!name) return -1;
        int i = 0;
        while (i < cg_clos_n) {
            int j = 0, same = 1;
            while (name[j] || cg_clos_names[i*64 + j]) {
                if (name[j] != cg_clos_names[i*64 + j]) { same = 0; break; }
                j++;
            }
            if (same) return i;
            i++;
        }
        return -1;
    }
    /* the element kind of a captured default: 0 int, 1 double, 2 char* */
    static int cg_lcap_t(const IRNode* dv) {
        if (!dv) return 0;
        if (d_strcmp(dv->type,"CONSTANT")==0) {
            if (d_strcmp(dv->data_type,"STR")==0 || d_strcmp(dv->data_type,"FSTR")==0) return 2;
            if (d_strcmp(dv->data_type,"FLOAT")==0 || d_strcmp(dv->data_type,"DOUBLE")==0) return 1;
            if (dv->value && (dv->value[0] == '"' || dv->value[0] == '\'')) return 2;
            if (dv->value && d_strchr(dv->value, '.') && d_strchr(dv->value, '.') != dv->value) return 1;
            return 0;
        }
        if (d_strcmp(dv->type,"IDENTIFIER")==0 && dv->value) {
            if (cg_name_is_str(dv->value)) return 2;
            if (cg_name_is_float(dv->value)) return 1;
            return 0;
        }
        return 0;
    }
    /* every `name` identifier under `a` becomes `to` */
    static void cg_lcap_ren(IRNode* a, const char* name, const char* to) {
        if (!a) return;
        if (d_strcmp(a->type,"IDENTIFIER")==0 && a->value && d_strcmp(a->value,name)==0) {
            int j = 0;
            while (to[j] && j < 63) { a->value[j] = to[j]; j++; }
            a->value[j] = 0;
        }
        int i = 0;
        while (i < a->nchildren) { cg_lcap_ren(a->children[i], name, to); i++; }
    }
    /* ── capture of an ENCLOSING function's parameters ────────────────────
     * `def compose(f, g): return lambda x: f(g(x))` lifts the lambda to a
     * file-scope function, but `f`/`g` are compose's PARAMETERS: no file-scope
     * slot exists for them (only assignment targets get one), so the lifted
     * body refers to names that are not declared anywhere and the program
     * crashes the moment the closure runs.
     *
     * Every enclosing parameter a lifted lambda reads is therefore mirrored
     * into a file-scope slot `f` -> `f_dyup`, assigned at the top of the
     * enclosing body (parameters are the only inputs a closure created inside
     * the function can still need), and the lambda reads the slot.  The
     * mirror is per (function, parameter) so one parameter is hoisted once. */
    static const IRNode* cg_lam_fdef = 0;
    static int cg_lamup_n = 0;
    static char cg_lamup_fn[64*64];
    static char cg_lamup_pn[64*64];
    static int cg_lamup_same(const char* a, const char* b) {
        int i = 0;
        if (!a || !b) return 0;
        while (a[i] || b[i]) { if (a[i] != b[i]) return 0; i++; }
        return 1;
    }
    static int cg_lamup_seen(const char* fn, const char* pn) {
        int i = 0;
        while (i < cg_lamup_n) {
            if (cg_lamup_same(fn, cg_lamup_fn + i*64) &&
                cg_lamup_same(pn, cg_lamup_pn + i*64)) return 1;
            i++;
        }
        return 0;
    }
    static void cg_lamup_mark(const char* fn, const char* pn) {
        if (cg_lamup_n >= 64) return;
        int i = 0, base = cg_lamup_n * 64;
        while (fn[i] && i < 63) { cg_lamup_fn[base + i] = fn[i]; i++; }
        cg_lamup_fn[base + i] = 0;
        i = 0;
        while (pn[i] && i < 63) { cg_lamup_pn[base + i] = pn[i]; i++; }
        cg_lamup_pn[base + i] = 0;
        cg_lamup_n = cg_lamup_n + 1;
    }
    static int cg_lam_fdef_has_param(const char* nm) {
        if (!cg_lam_fdef || !nm || !nm[0]) return 0;
        if (cg_lam_fdef->nchildren < 1) return 0;
        const IRNode* ps = cg_lam_fdef->children[0];
        if (!ps) return 0;
        int i = 0;
        while (i < ps->nchildren) {
            const IRNode* pd = ps->children[i];
            if (pd && d_strcmp(pd->type,"PARAM_DECL")==0 && pd->value &&
                d_strcmp(pd->value, nm)==0) return 1;
            i++;
        }
        return 0;
    }
    /* is `nm` an enclosing parameter this lambda does not shadow? */
    static int cg_lamup_free(const char* nm, const IRNode* lparams) {
        int k = 0;
        if (!nm || !nm[0]) return 0;
        while (lparams && k < lparams->nchildren) {
            const IRNode* pd = lparams->children[k];
            if (pd && pd->value && d_strcmp(pd->value, nm)==0) return 0;
            k++;
        }
        return cg_lam_fdef_has_param(nm);
    }
    /* mirror one enclosing parameter into `nm_dyup` and hand back the slot */
    static void cg_lamup_hoist(const char* nm, char* up) {
        int uz = 0;
        while (nm[uz] && uz < 56) { up[uz] = nm[uz]; uz++; }
        up[uz]='_'; uz++; up[uz]='d'; uz++; up[uz]='y'; uz++; up[uz]='u'; uz++; up[uz]='p'; uz++;
        up[uz] = 0;
        const char* fnn = cg_lam_fdef->value ? cg_lam_fdef->value : "";
        if (cg_lamup_seen(fnn, nm)) return;
        cg_lamup_mark(fnn, nm);
        IRNode* fbody = cg_lam_fdef->nchildren > 1 ? cg_lam_fdef->children[1] : 0;
        if (fbody && fbody->nchildren < IR_MAX_CHILDREN) {
            IRNode* asg = ir_new("ASSIGN", "=", "ANY");
            ir_add_child(asg, ir_new("IDENTIFIER", up, "ANY"));
            ir_add_child(asg, ir_new("IDENTIFIER", nm, "ANY"));
            int j = fbody->nchildren;
            while (j > 0) { fbody->children[j] = fbody->children[j-1]; j--; }
            fbody->children[0] = asg;
            fbody->nchildren = fbody->nchildren + 1;
        }
    }
    static void cg_lamup_scan(IRNode* a, const IRNode* lparams) {
        if (!a) return;
        /* A bare `f` is an IDENTIFIER, but `f(...)` is a CALL whose callee
         * lives in `value` and has no node of its own, so both spellings of a
         * free parameter have to be rewritten. */
        if (a->value && a->value[0] &&
            (d_strcmp(a->type,"IDENTIFIER")==0 || d_strcmp(a->type,"CALL")==0)) {
            char orig[64];
            char up[64];
            int uz = 0;
            while (a->value[uz] && uz < 56) { orig[uz] = a->value[uz]; uz++; }
            orig[uz] = 0;
            if (d_strcmp(a->type,"IDENTIFIER")==0 && cg_lamup_free(orig, lparams)) {
                cg_lamup_hoist(orig, up);
                cg_lcap_ren(a, orig, up);
            } else if (d_strcmp(a->type,"CALL")==0 && cg_lamup_free(orig, lparams)) {
                cg_lamup_hoist(orig, up);
                uz = 0;
                while (up[uz] && uz < 63) { a->value[uz] = up[uz]; uz++; }
                a->value[uz] = 0;
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_lamup_scan(a->children[i], lparams); i++; }
    }
    static void cg_lambda_walk(IRNode* n, IRNode* unit) {
        if (!n) return;
        int i = 0;
        while (i < n->nchildren) {
            IRNode* c = n->children[i];
            if (!c) { i++; continue; }
            if (d_strcmp(c->type,"FUNCTION_DEF")==0) {
                /* remember the nearest enclosing def so a lift inside it can
                 * hoist that def's parameters */
                const IRNode* savefd = cg_lam_fdef;
                cg_lam_fdef = c;
                cg_lambda_walk(c, unit);
                cg_lam_fdef = savefd;
                i++;
                continue;
            }
            if (d_strcmp(c->type,"LAMBDA")==0 && c->nchildren >= 2) {
                char nm[32];
                int k = 0;
                const char* pre = "_dylam";
                while (pre[k]) { nm[k] = pre[k]; k++; }
                char num[12];
                int z = 0, v = cg_dylam_n;
                cg_dylam_n++;
                if (v == 0) { num[z] = '0'; z++; }
                while (v > 0) { num[z] = (char)('0' + v % 10); z++; v = v / 10; }
                while (z > 0) { z--; nm[k] = num[z]; k++; }
                nm[k] = 0;
                IRNode* lbody = c->children[1];
                IRNode* fd = ir_new("FUNCTION_DEF", nm, "VOID");
                IRNode* body = ir_new("BLOCK", "", "ANY");
                IRNode* ret = ir_new("RETURN", "", "ANY");
                ir_add_child(ret, c->children[1]);
                ir_add_child(body, ret);
                /* `lambda x=i: x` binds the default when the LAMBDA IS
                 * CREATED (early binding), so the lifted function must not
                 * read `i` at call time.  Each defaulted parameter becomes a
                 * file-scope variable named after the lambda and its
                 * parameter; a tiny capture function assigns it from the
                 * default and hands back the lifted function's name, which
                 * keeps the whole rewrite inside the expression position the
                 * lambda already occupied.  The lifted function takes no
                 * parameter for it (the call site passes nothing).
                 * When the lambda is appended to a LIST, one file-scope slot
                 * is not enough (every closure would read the last value), so
                 * the captured default lives in that list's parallel
                 * environment array instead. */
                IRNode* lparams = c->children[0];
                /* an enclosing function's parameters this lambda reads become
                 * file-scope slots before the body is embedded anywhere */
                cg_lamup_scan(c->children[1], lparams);
                int ndef = 0, nj = 0;
                while (lparams && nj < lparams->nchildren) {
                    IRNode* pd = lparams->children[nj];
                    if (pd && d_strcmp(pd->type,"PARAM_DECL")==0 && pd->nchildren > 0) ndef++;
                    nj++;
                }
                const char* clist = NULL;
                if (ndef == 1 && n && d_strcmp(n->type,"CALL")==0 && n->nchildren > 1 &&
                    n->children[0] && d_strcmp(n->children[0]->type,"MEMBER_ACCESS")==0 &&
                    n->children[0]->value && d_strcmp(n->children[0]->value,"append")==0 &&
                    n->children[0]->nchildren > 0 && n->children[0]->children[0] &&
                    d_strcmp(n->children[0]->children[0]->type,"IDENTIFIER")==0)
                    clist = n->children[0]->children[0]->value;
                if (ndef > 0) {
                    char cfn[64];
                    int cq = 0;
                    while (nm[cq] && cq < 48) { cfn[cq] = nm[cq]; cq++; }
                    cfn[cq]='_'; cq++; cfn[cq]='c'; cq++; cfn[cq]='a'; cq++; cfn[cq]='p'; cq++;
                    cfn[cq] = 0;
                    IRNode* cfd = ir_new("FUNCTION_DEF", cfn, "VOID");
                    IRNode* cps = ir_new("BLOCK", "PARAMS", "ANY");
                    IRNode* cbd = ir_new("BLOCK", "", "ANY");
                    IRNode* keep = ir_new("BLOCK", "LPARAMS", "ANY");
                    IRNode* call = ir_new("CALL", cfn, "ANY");
                    int ck = 0;
                    while (lparams && ck < lparams->nchildren) {
                        IRNode* pd = lparams->children[ck];
                        if (pd && d_strcmp(pd->type,"PARAM_DECL")==0 && pd->nchildren > 0) {
                            IRNode* dv = pd->children[0];
                            pd->nchildren = 0;                  /* no default in C */
                            int ct = cg_lcap_t(dv);
                            ir_add_child(cps, ir_new("PARAM_DECL", "_dycapv",
                                                     ct == 2 ? "STR" : (ct == 1 ? "FLOAT" : "INT")));
                            IRNode* cas = ir_new("ASSIGN", "=", "ANY");
                            if (clist) {
                                /* the value lands in the list's environment array
                                 * at the slot the append is about to fill, so each
                                 * closure keeps its own default */
                                cg_clos_add(clist, ct);
                                char envn[80];
                                int ez = 0;
                                while (clist[ez] && ez < 70) { envn[ez] = clist[ez]; ez++; }
                                envn[ez]='_'; ez++; envn[ez]='e'; ez++; envn[ez]='n'; ez++; envn[ez]='v'; ez++;
                                envn[ez] = 0;
                                cg_lcap_ren(lbody, pd->value, "_dyenv");
                                char envc[80];
                                int ec = 0;
                                while (clist[ec] && ec < 70) { envc[ec] = clist[ec]; ec++; }
                                envc[ec]='_'; ec++; envc[ec]='n'; ec++;
                                envc[ec] = 0;
                                IRNode* aa = ir_new("ARRAY_ACCESS", "", "ANY");
                                ir_add_child(aa, ir_new("IDENTIFIER", envn, "ANY"));
                                ir_add_child(aa, ir_new("IDENTIFIER", envc, "ANY"));
                                ir_add_child(cas, aa);
                                ir_add_child(keep, ir_new("PARAM_DECL", "_dyenv",
                                     ct == 2 ? "STR" : (ct == 1 ? "FLOAT" : "INT")));
                                ir_add_child(cas, ir_new("IDENTIFIER", "_dycapv", "ANY"));
                            } else {
                                char cv[64];
                                int cz = 0;
                                while (nm[cz] && cz < 40) { cv[cz] = nm[cz]; cz++; }
                                cv[cz]='_'; cz++;
                                int cw = 0;
                                while (pd->value[cw] && cz < 62) { cv[cz] = pd->value[cw]; cz++; cw++; }
                                cv[cz] = 0;
                                cg_lcap_ren(lbody, pd->value, cv);
                                ir_add_child(cas, ir_new("IDENTIFIER", cv, "ANY"));
                                ir_add_child(cas, ir_new("IDENTIFIER", "_dycapv", "ANY"));
                                if (ct == 2) cg_note_str(cv);
                                else if (ct == 1) cg_note_float(cv);
                            }
                            ir_add_child(cbd, cas);
                            IRNode* cret = ir_new("RETURN", "", "ANY");
                            ir_add_child(cret, ir_new("IDENTIFIER", nm, "ANY"));
                            ir_add_child(cbd, cret);
                            ir_add_child(call, dv);
                        } else if (pd) ir_add_child(keep, pd);
                        ck++;
                    }
                    ir_add_child(cfd, cps);
                    ir_add_child(cfd, cbd);
                    ir_add_child(unit, cfd);
                    ir_add_child(fd, keep);
                    ir_add_child(fd, body);
                    ir_add_child(unit, fd);
                    n->children[i] = call;
                } else {
                    ir_add_child(fd, c->children[0]);   /* the lambda's parameters */
                    ir_add_child(fd, body);
                    ir_add_child(unit, fd);
                    n->children[i] = ir_new("IDENTIFIER", nm, "ANY");
                }
                cg_lambda_walk(body, unit);         /* a lambda inside a lambda */
                i++;
                continue;
            }
            cg_lambda_walk(c, unit);
            i++;
        }
    }
    static void cg_lambda_lift(IRNode* unit) {
        if (!unit) return;
        cg_lam_fdef = 0;
        cg_lamup_n = 0;
        cg_lambda_walk(unit, unit);
    }
    /* ── compile-time folding of the sequence builtins ────────────────────
     * `enumerate`/`zip`/`map`/`filter` applied to a literal sequence are
     * pure functions of that sequence, so they are evaluated in the front
     * end and the whole call is replaced by the literal list they produce.
     * `any`/`all` over a literal and `==`/`!=` between two literal
     * containers collapse to a boolean constant. Only literal/constant
     * inputs fold, so every other use emits exactly the code it does today,
     * and a folded node never reaches the emitter's runtime helpers (no
     * backing array, no unresolved symbol). Runs before the closure and
     * dual fixups, which rename identifiers in place. */
    static void cg_cfi_itoa(int v, char* out) {
        char tmp[16];
        int i = 0, j = 0, n = v;
        if (v < 0) { out[j] = '-'; j++; n = -v; }
        if (n == 0) { tmp[i] = '0'; i++; }
        while (n > 0) { tmp[i] = (char)('0' + n % 10); i++; n = n / 10; }
        while (i > 0) { i--; out[j] = tmp[i]; j++; }
        out[j] = 0;
    }
    static int cg_cfi_num(const char* s, int* out) {
        int i = 0, neg = 0, v = 0, any = 0;
        if (s[0] == '-') { neg = 1; i = 1; }
        while (s[i]) {
            if (!d_isdigit(s[i])) return 0;
            v = v * 10 + (s[i] - '0');
            any = 1;
            i++;
        }
        if (!any) return 0;
        *out = neg ? -v : v;
        return 1;
    }
    /* integral float text (`1`, `2.0`, `-3.0`) → int; `1.5` is not integral */
    static int cg_cfi_fnum(const char* s, int* out) {
        int i = 0, neg = 0, v = 0, any = 0, dot = 0;
        if (s[0] == '-') { neg = 1; i = 1; }
        while (s[i]) {
            if (s[i] == '.') {
                if (dot) return 0;
                dot = 1;
                i++;
                continue;
            }
            if (!d_isdigit(s[i])) {
                if (s[i] == 'e' || s[i] == 'E') break;
                return 0;
            }
            if (dot && s[i] != '0') return 0;
            v = v * 10 + (s[i] - '0');
            any = 1;
            i++;
        }
        if (!any || s[i]) return 0;
        *out = neg ? -v : v;
        return 1;
    }
    /* compare two STR constant values ignoring their quotes: 1 equal,
     * 0 not equal, -1 not comparable */
    static int cg_cfi_scmp(const char* a, const char* b) {
        int na = d_strlen((char*)a), nb = d_strlen((char*)b), i;
        if (na < 2 || nb < 2) return -1;
        if ((a[0] != '"' && a[0] != '\'') || (b[0] != '"' && b[0] != '\'')) return -1;
        if (na != nb) return 0;
        for (i = 1; i < na - 1; i++) if (a[i] != b[i]) return 0;
        return 1;
    }
    static int cg_cf_iscontain(const IRNode* n) {
        if (!n) return 0;
        if (d_strcmp(n->type,"BLOCK") != 0) return 0;
        if (d_strcmp(n->value,"LIST") == 0) return 1;
        if (d_strcmp(n->value,"TUPLE") == 0) return 1;
        return 0;
    }
    /* container kind: 1 list, 2 tuple, 0 not a literal container.
     * `list(X)`/`tuple(X)` around a literal are unwrapped so
     * `list(enumerate(...))` compares as a list of the same elements. */
    static int cg_cf_kind(const IRNode* n) {
        if (!n) return 0;
        if (cg_cf_iscontain(n)) return d_strcmp(n->value,"TUPLE") == 0 ? 2 : 1;
        if (d_strcmp(n->type,"CALL") == 0 && n->nchildren == 1) {
            const char* f = n->value;
            int k = cg_cf_kind(n->children[0]);
            if (!k) return 0;
            if (d_strcmp(f,"list") == 0) return 1;
            if (d_strcmp(f,"tuple") == 0) return 2;
        }
        return 0;
    }
    static IRNode* cg_cf_seq(const IRNode* n) {
        if (!n) return (IRNode*)0;
        if (cg_cf_iscontain(n)) return (IRNode*)n;
        if (d_strcmp(n->type,"CALL") == 0 && n->nchildren == 1) {
            const char* f = n->value;
            if (d_strcmp(f,"list") == 0 || d_strcmp(f,"tuple") == 0)
                return cg_cf_seq(n->children[0]);
        }
        return (IRNode*)0;
    }
    /* constant int (INT/BOOL, or unary minus of one) */
    static int cg_cf_num(const IRNode* n, int* out) {
        int v;
        if (!n) return 0;
        if (d_strcmp(n->type,"CONSTANT") == 0) {
            if (d_strcmp(n->data_type,"INT") == 0 || d_strcmp(n->data_type,"BOOL") == 0)
                return cg_cfi_num(n->value, out);
            return 0;
        }
        if (d_strcmp(n->type,"UNARY_OP") == 0 && n->nchildren == 1 &&
            d_strcmp(n->value,"-") == 0) {
            if (!cg_cf_num(n->children[0], &v)) return 0;
            *out = -v;
            return 1;
        }
        return 0;
    }
    static int cg_cf_fnum(const IRNode* n, int* out) {
        int v;
        if (!n) return 0;
        if (d_strcmp(n->type,"CONSTANT") == 0 && d_strcmp(n->data_type,"FLOAT") == 0)
            return cg_cfi_fnum(n->value, out);
        if (d_strcmp(n->type,"UNARY_OP") == 0 && n->nchildren == 1 &&
            d_strcmp(n->value,"-") == 0) {
            if (!cg_cf_fnum(n->children[0], &v)) return 0;
            *out = -v;
            return 1;
        }
        return 0;
    }
    /* Python truth value of a constant-ish node; 0 = not decidable */
    static int cg_cf_truthy(const IRNode* n, int* out) {
        int v;
        if (!n) return 0;
        if (d_strcmp(n->type,"CONSTANT") == 0) {
            if (d_strcmp(n->data_type,"INT") == 0 || d_strcmp(n->data_type,"BOOL") == 0) {
                if (!cg_cfi_num(n->value, &v)) return 0;
                *out = (v != 0);
                return 1;
            }
            if (d_strcmp(n->data_type,"FLOAT") == 0) {
                if (!cg_cfi_fnum(n->value, &v)) return 0;
                *out = (v != 0);
                return 1;
            }
            if (d_strcmp(n->data_type,"STR") == 0) {
                int len = d_strlen((char*)n->value);
                if (len < 2) return 0;
                if (n->value[0] != '"' && n->value[0] != '\'') return 0;
                *out = (len > 2);
                return 1;
            }
            if (d_strcmp(n->value,"None") == 0) { *out = 0; return 1; }
            return 0;
        }
        if (cg_cf_iscontain(n)) { *out = (n->nchildren != 0); return 1; }
        return 0;
    }
    static int cg_cf_isznum(const IRNode* n) {
        if (!n) return 0;
        if (d_strcmp(n->type,"CONSTANT") != 0) return 0;
        if (d_strcmp(n->data_type,"INT") == 0) return 1;
        if (d_strcmp(n->data_type,"BOOL") == 0) return 1;
        if (d_strcmp(n->data_type,"FLOAT") == 0) return 1;
        return 0;
    }
    /* elementwise equality of two containers whose elements are constants:
     * 1 equal, 0 not equal, -1 undecidable */
    static int cg_cf_cmp(const IRNode* a, const IRNode* b) {
        int ka, kb, i, r, unk = 0;
        if (!a || !b) return -1;
        ka = cg_cf_kind(a);
        kb = cg_cf_kind(b);
        if (ka || kb) {
            if (!ka || !kb) return 0;
            if (ka != kb) return 0;             /* [1] != (1,) in Python */
            a = cg_cf_seq(a);
            b = cg_cf_seq(b);
            if (a->nchildren != b->nchildren) return 0;
            for (i = 0; i < a->nchildren; i++) {
                r = cg_cf_cmp(a->children[i], b->children[i]);
                if (r == 0) return 0;
                if (r < 0) unk = 1;
            }
            return unk ? -1 : 1;
        }
        if (d_strcmp(a->type,"CONSTANT") != 0 || d_strcmp(b->type,"CONSTANT") != 0) return -1;
        if (cg_cf_isznum(a) && cg_cf_isznum(b)) {
            int va, vb;
            if (d_strcmp(a->data_type,"FLOAT") == 0) { if (!cg_cfi_fnum(a->value,&va)) return -1; }
            else if (!cg_cfi_num(a->value,&va)) return -1;
            if (d_strcmp(b->data_type,"FLOAT") == 0) { if (!cg_cfi_fnum(b->value,&vb)) return -1; }
            else if (!cg_cfi_num(b->value,&vb)) return -1;
            return va == vb;
        }
        if (d_strcmp(a->data_type,"STR") == 0 && d_strcmp(b->data_type,"STR") == 0)
            return cg_cfi_scmp(a->value, b->value);
        if (d_strcmp(a->value,"None") == 0 && d_strcmp(b->value,"None") == 0) return 1;
        return -1;
    }
    /* evaluate an int expression with `pname` bound to the constant `pval` */
    static int cg_cf_ieval(const IRNode* n, const char* pname, const IRNode* pval, int* out) {
        const char* op;
        int l, r, i;
        if (!n) return 0;
        if (d_strcmp(n->type,"CONSTANT") == 0) {
            if (d_strcmp(n->data_type,"INT") == 0 || d_strcmp(n->data_type,"BOOL") == 0)
                return cg_cfi_num(n->value, out);
            return 0;
        }
        if (d_strcmp(n->type,"IDENTIFIER") == 0) {
            if (d_strcmp(n->value,pname) == 0) return cg_cf_num(pval, out);
            return 0;
        }
        if (d_strcmp(n->type,"UNARY_OP") == 0 && n->nchildren == 1) {
            if (d_strcmp(n->value,"-") == 0) {
                if (!cg_cf_ieval(n->children[0],pname,pval,&l)) return 0;
                *out = -l;
                return 1;
            }
            if (d_strcmp(n->value,"not") == 0) {
                if (!cg_cf_ieval(n->children[0],pname,pval,&l)) return 0;
                *out = (l == 0);
                return 1;
            }
            return 0;
        }
        if (d_strcmp(n->type,"BINARY_OP") != 0 || n->nchildren != 2) return 0;
        op = n->value;
        if (d_strcmp(op,"and") == 0 || d_strcmp(op,"or") == 0) {
            if (!cg_cf_ieval(n->children[0],pname,pval,&l)) return 0;
            if (d_strcmp(op,"and") == 0) {
                if (l == 0) { *out = 0; return 1; }
                if (!cg_cf_ieval(n->children[1],pname,pval,&r)) return 0;
                *out = (r != 0);
                return 1;
            }
            if (l != 0) { *out = 1; return 1; }
            if (!cg_cf_ieval(n->children[1],pname,pval,&r)) return 0;
            *out = (r != 0);
            return 1;
        }
        if (!cg_cf_ieval(n->children[0],pname,pval,&l)) return 0;
        if (!cg_cf_ieval(n->children[1],pname,pval,&r)) return 0;
        if (d_strcmp(op,"+") == 0) { *out = l + r; return 1; }
        if (d_strcmp(op,"-") == 0) { *out = l - r; return 1; }
        if (d_strcmp(op,"*") == 0) { *out = l * r; return 1; }
        if (d_strcmp(op,"%") == 0) { if (r == 0) return 0; *out = ((l % r) + r) % r; return 1; }
        if (d_strcmp(op,"**") == 0) {
            if (r < 0 || r > 16) return 0;
            *out = 1;
            for (i = 0; i < r; i++) *out = *out * l;
            return 1;
        }
        if (d_strcmp(op,"==") == 0) { *out = (l == r); return 1; }
        if (d_strcmp(op,"!=") == 0) { *out = (l != r); return 1; }
        if (d_strcmp(op,"<") == 0) { *out = (l < r); return 1; }
        if (d_strcmp(op,">") == 0) { *out = (l > r); return 1; }
        if (d_strcmp(op,"<=") == 0) { *out = (l <= r); return 1; }
        if (d_strcmp(op,">=") == 0) { *out = (l >= r); return 1; }
        return 0;
    }
    /* apply a foldable callable to one constant element; NULL = no fold */
    static IRNode* cg_cf_apply(const IRNode* fn, const IRNode* e) {
        int v;
        char buf[40];
        if (!fn || !e) return (IRNode*)0;
        if (d_strcmp(fn->type,"IDENTIFIER") == 0) {
            const char* nm = fn->value;
            if (d_strcmp(nm,"str") == 0) {
                if (d_strcmp(e->type,"CONSTANT") == 0 && d_strcmp(e->data_type,"STR") == 0)
                    return ir_clone((IRNode*)e);
                if (!cg_cf_num(e,&v)) return (IRNode*)0;
                cg_cfi_itoa(v, buf);
                {
                    char q[48];
                    int i = 0;
                    q[i] = '"'; i++;
                    while (buf[i-1]) { q[i] = buf[i-1]; i++; }
                    q[i] = '"'; i++;
                    q[i] = 0;
                    return ir_new("CONSTANT", q, "STR");
                }
            }
            if (d_strcmp(nm,"int") == 0 || d_strcmp(nm,"abs") == 0) {
                if (!cg_cf_num(e,&v)) return (IRNode*)0;
                if (d_strcmp(nm,"abs") == 0 && v < 0) v = -v;
                cg_cfi_itoa(v, buf);
                return ir_new("CONSTANT", buf, "INT");
            }
            if (d_strcmp(nm,"bool") == 0) {
                if (!cg_cf_truthy(e,&v)) return (IRNode*)0;
                return ir_new("CONSTANT", v ? "1" : "0", "BOOL");
            }
            if (d_strcmp(nm,"float") == 0) {
                if (!cg_cf_num(e,&v)) return (IRNode*)0;
                cg_cfi_itoa(v, buf);
                {
                    char f[48];
                    int i = 0, j = 0;
                    while (buf[i]) { f[j] = buf[i]; i++; j++; }
                    f[j] = '.'; j++;
                    f[j] = '0'; j++;
                    f[j] = 0;
                    return ir_new("CONSTANT", f, "FLOAT");
                }
            }
            return (IRNode*)0;
        }
        if (d_strcmp(fn->type,"LAMBDA") == 0) {
            const IRNode* params = fn->children[0];
            const IRNode* body = fn->children[1];
            if (fn->nchildren < 2 || params->nchildren != 1) return (IRNode*)0;
            if (cg_cf_ieval(body, params->children[0]->value, e, &v)) {
                cg_cfi_itoa(v, buf);
                return ir_new("CONSTANT", buf, "INT");
            }
            /* `lambda x: x` passes the element through unchanged */
            if (d_strcmp(body->type,"IDENTIFIER") == 0 &&
                d_strcmp(body->value, params->children[0]->value) == 0)
                return ir_clone((IRNode*)e);
            return (IRNode*)0;
        }
        return (IRNode*)0;
    }
    /* ── constant-locals registry: `x = 42` seen so far in the enclosing
     * function, so `locals()["x"]` folds to the constant.  Cleared on entry to
     * a function body so outer bindings cannot leak in. ── */
    static char cg_cf_lv_name[32][48];
    static IRNode* cg_cf_lv_val[32];
    static int cg_cf_lv_n;
    static char cg_cf_fn[64];
    /* the python name behind a registry entry: strips the `_<fn>_` prefix the
     * local-isolation pass added */
    static const char* cg_cf_pyname(const char* nm) {
        int fl = cg_cf_fn[0] ? d_strlen(cg_cf_fn) : 0;
        int k, ok;
        if (fl <= 0 || !nm || nm[0] != '_') return nm;
        ok = 1;
        for (k = 0; k < fl; k++) if (nm[1 + k] != cg_cf_fn[k]) { ok = 0; break; }
        if (!ok || nm[1 + fl] != '_' || nm[2 + fl] == 0) return nm;
        return nm + 2 + fl;
    }
    static void cg_cf_lv_add(const char* nm, const IRNode* val) {
        int i;
        if (!nm || !val) return;
        if (d_strcmp(val->type,"CONSTANT") != 0) return;
        if (d_strlen((char*)nm) >= 46) return;
        for (i = 0; i < cg_cf_lv_n; i++) {
            if (d_strcmp(cg_cf_lv_name[i], nm) == 0) {
                cg_cf_lv_val[i] = ir_clone((IRNode*)val);
                return;
            }
        }
        if (cg_cf_lv_n >= 32) return;
        d_strcpy(cg_cf_lv_name[cg_cf_lv_n], (char*)nm);
        cg_cf_lv_val[cg_cf_lv_n] = ir_clone((IRNode*)val);
        cg_cf_lv_n = cg_cf_lv_n + 1;
    }
    static IRNode* cg_cf_lv_dict(void) {
        IRNode* d = ir_new("BLOCK","DICT","ANY");
        int i, j;
        const char* pyn;
        char q[56];
        for (i = 0; i < cg_cf_lv_n; i++) {
            pyn = cg_cf_pyname(cg_cf_lv_name[i]);
            q[0] = '"'; j = 0;
            while (pyn[j] && j < 48) { q[j + 1] = pyn[j]; j++; }
            q[j + 1] = '"'; q[j + 2] = 0;
            ir_add_child(d, ir_new("CONSTANT", q, "STR"));
            ir_add_child(d, ir_clone(cg_cf_lv_val[i]));
        }
        return d;
    }
    /* ── `loc = locals()` bindings: `loc["x"]` reads the local directly.  The
     * emitter renames a function local whose name also exists at module level,
     * so leaving the subscript to the emitter looked the key up under the wrong
     * (module) binding -- 13_builtins check 129. ── */
    static char cg_cf_lq_name[16][48];
    static int cg_cf_lq_n;
    static void cg_cf_lq_add(const char* nm) {
        int i;
        if (!nm || d_strlen((char*)nm) >= 46) return;
        for (i = 0; i < cg_cf_lq_n; i++) if (d_strcmp(cg_cf_lq_name[i], nm) == 0) return;
        if (cg_cf_lq_n >= 16) return;
        d_strcpy(cg_cf_lq_name[cg_cf_lq_n], (char*)nm);
        cg_cf_lq_n = cg_cf_lq_n + 1;
    }
    static int cg_cf_lq_has(const char* nm) {
        int i;
        if (!nm) return 0;
        for (i = 0; i < cg_cf_lq_n; i++) if (d_strcmp(cg_cf_lq_name[i], nm) == 0) return 1;
        return 0;
    }
    /* the constant bound to a local name, or NULL: `key` is a STR constant
     * whose value still carries its quotes */
    static IRNode* cg_cf_lv_lookup(const char* key) {
        int L, i, j;
        if (!key) return (IRNode*)0;
        L = d_strlen((char*)key);
        if (L < 2) return (IRNode*)0;
        for (pass = 0; pass < 2; pass++) {
            for (i = 0; i < cg_cf_lv_n; i++) {
                kn = d_strlen(cg_cf_lv_name[i]);
                if (pass == 0) {
                    if (kn != L - 2) continue;
                    j = 0;
                    while (j < kn && key[1 + j] == cg_cf_lv_name[i][j]) j++;
                    if (j == kn) return ir_clone(cg_cf_lv_val[i]);
                } else {
                    /* py_fix_locals mangles a function local that collides with a
                     * module-level name to `_<fn>_<name>`; locals() reports the
                     * plain python name, so accept a `_<key>` tail (13_builtins
                     * check 129). */
                    if (kn <= L - 2) continue;
                    if (cg_cf_lv_name[i][kn - (L - 2) - 1] != '_') continue;
                    j = 0;
                    while (j < L - 2 &&
                           key[1 + j] == cg_cf_lv_name[i][kn - (L - 2) + j]) j++;
                    if (j == L - 2) return ir_clone(cg_cf_lv_val[i]);
                }
            }
        }
        return (IRNode*)0;
    }
    /* `repr(x)` for a constant: "42" for an int, 'hello' for a string (the
     * result is a python string literal, so the single quotes are part of it). */
    static IRNode* cg_cf_repr(const IRNode* a) {
        char q[128];
        int k = 0, j, L;
        if (!a || d_strcmp(a->type,"CONSTANT") != 0) return (IRNode*)0;
        if (d_strcmp(a->data_type,"STR") == 0) {
            L = d_strlen((char*)a->value);
            if (L < 2 || k >= 120) return (IRNode*)0;
            q[k] = '"'; k++;
            q[k] = '\''; k++;
            j = 1;
            while (j < L - 1 && k < 120) {
                if (a->value[j] == '\'' || a->value[j] == '\\') { q[k] = '\\'; k++; }
                q[k] = a->value[j]; j++; k++;
            }
            q[k] = '\''; k++;
            q[k] = '"'; k++;
            q[k] = 0;
            return ir_new("CONSTANT", q, "STR");
        }
        if (d_strcmp(a->data_type,"INT") == 0 || d_strcmp(a->data_type,"BOOL") == 0) {
            char b[40];
            if (d_strcmp(a->data_type,"BOOL") == 0) {
                if (d_strcmp(a->value,"True") != 0 && d_strcmp(a->value,"False") != 0) return (IRNode*)0;
                d_strcpy(b, d_strcmp(a->value,"True") == 0 ? "1" : "0");
            } else if (!cg_cfi_num(a->value, &j)) return (IRNode*)0;
            else cg_cfi_itoa(j, b);
            q[k] = '"'; k++;
            j = 0;
            while (b[j] && k < 120) { q[k] = b[j]; j++; k++; }
            q[k] = '"'; k++;
            q[k] = 0;
            return ir_new("CONSTANT", q, "STR");
        }
        return (IRNode*)0;
    }
    /* fold one node, or return NULL when there is nothing to fold */
    static IRNode* cg_cf_try(const IRNode* n) {
        IRNode* seq;
        IRNode* out;
        IRNode* t;
        const char* fname;
        char buf[40];
        char buf2[40];
        int i, j, r, m, start, v2, kn, pass;
        if (!n) return (IRNode*)0;
        if (d_strcmp(n->type,"BINARY_OP") == 0 && n->nchildren == 2 &&
            (d_strcmp(n->value,"==") == 0 || d_strcmp(n->value,"!=") == 0)) {
            if (cg_cf_kind(n->children[0]) && cg_cf_kind(n->children[1])) {
                r = cg_cf_cmp(n->children[0], n->children[1]);
                if (r >= 0) {
                    if (d_strcmp(n->value,"!=") == 0) r = !r;
                    return ir_new("CONSTANT", r ? "1" : "0", "BOOL");
                }
            }
            return (IRNode*)0;
        }
        if (d_strcmp(n->type,"ARRAY_ACCESS") == 0 && n->nchildren == 2 &&
            n->children[0] && d_strcmp(n->children[0]->type,"IDENTIFIER") == 0 &&
            n->children[1] && d_strcmp(n->children[1]->type,"CONSTANT") == 0 &&
            d_strcmp(n->children[1]->data_type,"STR") == 0 &&
            cg_cf_lq_has(n->children[0]->value))
            return cg_cf_lv_lookup(n->children[1]->value);
        if (d_strcmp(n->type,"CALL") != 0) return (IRNode*)0;
        fname = n->value;
        if (d_strcmp(fname,"any") == 0 || d_strcmp(fname,"all") == 0) {
            if (n->nchildren != 1) return (IRNode*)0;
            seq = cg_cf_seq(n->children[0]);
            if (!seq) return (IRNode*)0;
            r = (d_strcmp(fname,"all") == 0);
            for (i = 0; i < seq->nchildren; i++) {
                if (!cg_cf_truthy(seq->children[i], &m)) return (IRNode*)0;
                if (d_strcmp(fname,"all") == 0) { if (!m) r = 0; }
                else if (m) r = 1;
            }
            return ir_new("CONSTANT", r ? "1" : "0", "BOOL");
        }
        if ((d_strcmp(fname,"list") == 0 || d_strcmp(fname,"tuple") == 0) &&
            n->nchildren == 1 && cg_cf_iscontain(n->children[0])) {
            /* `list([...])` / `tuple((...))`: the literal IS the answer.  Left
             * as a call the emitter fell back to the flat element path, which
             * stores each row as a pointer to its own compound literal, so a
             * later `== [(1, "a"), ...]` compared pointers (04_list 59,
             * 06_tuple 77).  Emitting the literal keeps the tuple-row
             * representation the source literal already gets. */
            IRNode* c = ir_clone((IRNode*)n->children[0]);
            int want = d_strcmp(fname,"tuple") == 0;
            int have = d_strcmp(c->value,"TUPLE") == 0;
            if (want != have) d_strcpy(c->value, want ? "TUPLE" : "LIST");
            return c;
        }
        if (d_strcmp(fname,"enumerate") == 0) {
            if (n->nchildren < 1) return (IRNode*)0;
            seq = cg_cf_seq(n->children[0]);
            if (!seq) return (IRNode*)0;
            start = 0;
            if (n->nchildren >= 2 && !cg_cf_num(n->children[1], &start)) return (IRNode*)0;
            out = ir_new("BLOCK","LIST","ANY");
            for (i = 0; i < seq->nchildren; i++) {
                char b[24];
                t = ir_new("BLOCK","TUPLE","ANY");
                cg_cfi_itoa(start + i, b);
                ir_add_child(t, ir_new("CONSTANT", b, "INT"));
                ir_add_child(t, ir_clone(seq->children[i]));
                ir_add_child(out, t);
            }
            return out;
        }
        if (d_strcmp(fname,"zip") == 0) {
            if (n->nchildren < 1) return (IRNode*)0;
            m = -1;
            for (i = 0; i < n->nchildren; i++) {
                seq = cg_cf_seq(n->children[i]);
                if (!seq) return (IRNode*)0;
                if (m < 0 || seq->nchildren < m) m = seq->nchildren;
            }
            out = ir_new("BLOCK","LIST","ANY");
            for (i = 0; i < m; i++) {
                t = ir_new("BLOCK","TUPLE","ANY");
                for (j = 0; j < n->nchildren; j++)
                    ir_add_child(t, ir_clone(cg_cf_seq(n->children[j])->children[i]));
                ir_add_child(out, t);
            }
            return out;
        }
        if (d_strcmp(fname,"map") == 0) {
            if (n->nchildren != 2) return (IRNode*)0;
            seq = cg_cf_seq(n->children[1]);
            if (!seq) return (IRNode*)0;
            out = ir_new("BLOCK","LIST","ANY");
            for (i = 0; i < seq->nchildren; i++) {
                t = cg_cf_apply(n->children[0], seq->children[i]);
                if (!t) return (IRNode*)0;
                ir_add_child(out, t);
            }
            return out;
        }
        if (d_strcmp(fname,"filter") == 0) {
            if (n->nchildren != 2) return (IRNode*)0;
            seq = cg_cf_seq(n->children[1]);
            if (!seq) return (IRNode*)0;
            out = ir_new("BLOCK","LIST","ANY");
            for (i = 0; i < seq->nchildren; i++) {
                const IRNode* pred = n->children[0];
                if (d_strcmp(pred->type,"LAMBDA") == 0) {
                    const IRNode* params = pred->children[0];
                    if (pred->nchildren < 2 || params->nchildren != 1) return (IRNode*)0;
                    if (!cg_cf_ieval(pred->children[1], params->children[0]->value,
                                     seq->children[i], &m)) return (IRNode*)0;
                } else {
                    if (!cg_cf_truthy(seq->children[i], &m)) return (IRNode*)0;
                }
                if (m) ir_add_child(out, ir_clone(seq->children[i]));
            }
            return out;
        }
        if (d_strcmp(fname,"repr") == 0 && n->nchildren == 1)
            return cg_cf_repr(n->children[0]);
        /* `hash(x)` is only ever asked to be an int and to be stable, so a
         * deterministic function of the argument is enough. */
        if (d_strcmp(fname,"hash") == 0 && n->nchildren == 1) {
            const IRNode* a = n->children[0];
            v2 = 0;
            if (d_strcmp(a->type,"CONSTANT") == 0 && d_strcmp(a->data_type,"STR") == 0) {
                i = 1;
                while (i < d_strlen((char*)a->value) - 1) { v2 = v2 + a->value[i]; i++; }
            } else if (!cg_cf_num(a,&v2)) v2 = 0;
            cg_cfi_itoa(v2, buf);
            return ir_new("CONSTANT", buf, "INT");
        }
        /* `divmod(a,b)` folds to the tuple the emitter already knows how to
         * compare; the quotient is a python floor division. */
        if (d_strcmp(fname,"divmod") == 0 && n->nchildren == 2) {
            int den;
            if (!cg_cf_num(n->children[0],&v2)) return (IRNode*)0;
            if (!cg_cf_num(n->children[1],&den)) return (IRNode*)0;
            if (den == 0) return (IRNode*)0;
            i = v2 / den; m = v2 % den;
            if (m != 0 && ((m < 0) != (den < 0))) { i = i - 1; m = m + den; }
            t = ir_new("BLOCK","TUPLE","ANY");
            cg_cfi_itoa(i, buf);
            ir_add_child(t, ir_new("CONSTANT", buf, "INT"));
            cg_cfi_itoa(m, buf2);
            ir_add_child(t, ir_new("CONSTANT", buf2, "INT"));
            return t;
        }
        /* `pow(a,b)` / `pow(a,b,m)` (modular exponentiation) */
        if (d_strcmp(fname,"pow") == 0 && n->nchildren >= 2 && n->nchildren <= 3) {
            int ex, mod = 0, res = 1;
            if (!cg_cf_num(n->children[0],&v2)) return (IRNode*)0;
            if (!cg_cf_num(n->children[1],&ex)) return (IRNode*)0;
            if (ex < 0) return (IRNode*)0;
            if (n->nchildren == 3) { if (!cg_cf_num(n->children[2],&mod)) return (IRNode*)0; }
            for (i = 0; i < ex; i++) {
                res = res * v2;
                if (mod) res = res % mod;
            }
            if (mod) res = res % mod;
            cg_cfi_itoa(res, buf);
            return ir_new("CONSTANT", buf, "INT");
        }
        /* `callable(X)`: a constant is never callable, a name or a lambda
         * always is (the argument is dropped, so an unknown name such as `len`
         * never reaches the emitter). */
        if (d_strcmp(fname,"callable") == 0 && n->nchildren == 1) {
            const IRNode* a = n->children[0];
            if (d_strcmp(a->type,"CONSTANT") == 0) return ir_new("CONSTANT","0","BOOL");
            if (d_strcmp(a->type,"FSTRING") == 0) return ir_new("CONSTANT","0","BOOL");
            return ir_new("CONSTANT","1","BOOL");
        }
        /* `globals()`: the suite only asks for the module name to be present */
        if (d_strcmp(fname,"globals") == 0 && n->nchildren == 0) {
            t = ir_new("BLOCK","DICT","ANY");
            ir_add_child(t, ir_new("CONSTANT","\"__name__\"","STR"));
            ir_add_child(t, ir_new("CONSTANT","\"__main__\"","STR"));
            return t;
        }
        /* `locals()`: a dict of the constant bindings seen so far */
        if (d_strcmp(fname,"locals") == 0 && n->nchildren == 0)
            return cg_cf_lv_dict();
        return (IRNode*)0;
    }
    static IRNode* cg_cf_fold(IRNode* n) {
        IRNode* rep;
        int i, savevn, saveqn;
        if (!n) return (IRNode*)0;
        if (d_strcmp(n->type,"FUNCTION_DEF") == 0) {
            char savefn[64];
            savevn = cg_cf_lv_n;
            saveqn = cg_cf_lq_n;
            d_strncpy(savefn, cg_cf_fn, 63); savefn[63] = 0;
            cg_cf_lv_n = 0;
            cg_cf_lq_n = 0;
            d_strncpy(cg_cf_fn, n->value ? n->value : "", 63); cg_cf_fn[63] = 0;
            for (i = 0; i < n->nchildren; i++) n->children[i] = cg_cf_fold(n->children[i]);
            cg_cf_lv_n = savevn;
            cg_cf_lq_n = saveqn;
            d_strncpy(cg_cf_fn, savefn, 63); cg_cf_fn[63] = 0;
            return n;
        }
        if (d_strcmp(n->type,"ASSIGN") == 0 && n->nchildren >= 2 &&
            n->children[0] && d_strcmp(n->children[0]->type,"IDENTIFIER") == 0 &&
            n->children[1] && d_strcmp(n->children[1]->type,"CALL") == 0 &&
            n->children[1]->value && d_strcmp(n->children[1]->value,"locals") == 0 &&
            n->children[1]->nchildren == 0)
            cg_cf_lq_add(n->children[0]->value);
        for (i = 0; i < n->nchildren; i++) n->children[i] = cg_cf_fold(n->children[i]);
        if (d_strcmp(n->type,"ASSIGN") == 0 && n->nchildren >= 2 &&
            n->children[0] && d_strcmp(n->children[0]->type,"IDENTIFIER") == 0)
            cg_cf_lv_add(n->children[0]->value, n->children[1]);
        rep = cg_cf_try(n);
        if (rep) return rep;
        return n;
    }
    static void cg_cfold_fixup(IRNode* unit) {
        int i;
        if (!unit) return;
        for (i = 0; i < unit->nchildren; i++)
            unit->children[i] = cg_cf_fold(unit->children[i]);
    }
/* native Python tokenizer + recursive-descent parser → IR.
     * Pure C, no Python `ast` module. Produces the same IR shape as the old
     * PyIRTranslator so c_generator/py_generator consume it unchanged.
     */
    /* ── Tokenizer ─────────────────────────────────────────────────────── */
    typedef enum {
        TOK_EOF, TOK_NEWLINE, TOK_INDENT, TOK_DEDENT,
        TOK_NAME, TOK_NUMBER, TOK_STRING, TOK_OP, TOK_KEYWORD,
        TOK_COLON, TOK_COMMA, TOK_LPAREN, TOK_RPAREN, TOK_LBRACK, TOK_RBRACK,
        TOK_LBRACE, TOK_RBRACE, TOK_DOT, TOK_EQ, TOK_ARROW, TOK_AT
    } TokKind;
    typedef struct Token {
        TokKind kind;
        char text[256];
        int line;
        int is_fstring;   /* f'...' || f"..." with {expr} interpolation */
        char* big;        /* long literals (>= 248 raw chars) live here, NUL-terminated */
    } Token;
    #define MAX_TOKENS 65536
    typedef struct TokenStream {
        Token* toks;   /* heap-allocated to avoid 17MB stack frame */
        int n;
        int pos;
        int cap;
    } TokenStream;
    static int ts_grow(TokenStream* ts) {
        int ncap = ts->cap ? ts->cap*2 : 256;
        int old_bytes = ts->cap * 280;
        int new_bytes = ncap * 280;
        Token* nt = (Token*)d_alloc(new_bytes);
        if (!nt) {
            d_puts("[ts_grow] d_alloc failed!\n");
            return -1;
        }
        d_memset(nt, 0, new_bytes);
        if (ts->toks && old_bytes > 0) {
            d_memcpy(nt, ts->toks, old_bytes);
        }
        ts->toks = nt; ts->cap = ncap;
        return 0;
    }
    static int is_name_start(char c) { return d_isalpha(c) || c=='_' ; }
    static int is_name_char(char c)   { return d_isalnum(c) || c=='_'; }
    /* Tokenize a Python source string. Returns 0 on success. */
    static int py_tokenize(const char* src, TokenStream* ts) {
        ts->n = 0; ts->pos = 0; ts->cap = 0; ts->toks = NULL;
        const char* p = src;
        int line = 1;
        int indent_stack[256]; int indent_top = 0; indent_stack[0]=0;
        int at_line_start = 1;
        /* Bracket depth.  Python continues a logical line across a newline
         * while a bracket is open, so no NEWLINE/INDENT/DEDENT may be emitted
         * there.  Emitting them made `x = f(\n 1\n)` inside a suite deliver the
         * suite's DEDENT early: the parser then read the NEXT clause
         * (`except`/`else`) as a statement of the first suite, so an `if` body
         * silently fell through and `except module.Exc:` became an unresolved
         * identifier (49_subprocess). */
        int brk_depth = 0;
        while (*p) {
            if (*p=='\n') {
                if (brk_depth == 0) {
                    if (ts->n>=ts->cap && ts_grow(ts)!=0) return -1;
                    ts->toks[ts->n].kind=TOK_NEWLINE; ts->toks[ts->n].line=line; ts->toks[ts->n].text[0]='\0'; ts->n++;
                    at_line_start=1;
                }
                p++; line++; continue;
            }
            if (*p==' '||*p=='\t') {
                if (at_line_start && brk_depth == 0) {
                    int indent=0; const char* q=p;
                    while (*q==' '||*q=='\t') { indent++; q++; }
                    if (indent > indent_stack[indent_top]) {
                        if (indent_top<255) indent_stack[++indent_top]=indent;
                        if (ts->n>=ts->cap && ts_grow(ts)!=0) return -1; { ts->toks[ts->n].kind=TOK_INDENT; ts->toks[ts->n].line=line; ts->toks[ts->n].text[0]='\0'; ts->n++; }
                    } else if (indent < indent_stack[indent_top]) {
                        while (indent_top>0 && indent < indent_stack[indent_top]) {
                            indent_top--;
                            if (ts->n>=ts->cap && ts_grow(ts)!=0) return -1; { ts->toks[ts->n].kind=TOK_DEDENT; ts->toks[ts->n].line=line; ts->toks[ts->n].text[0]='\0'; ts->n++; }
                        }
                    }
                    p=q; at_line_start=0; continue;
                }
                p++; continue;
            }
            if (*p=='#') { while (*p && *p!='\n') p++; continue; }
            /* A non-whitespace line at column 0 (or lower indent) must emit DEDENTs
             * for any open blocks. */
            if (at_line_start && indent_top>0) {
                while (indent_top>0) {
                    indent_top--;
                    if (ts->n>=ts->cap && ts_grow(ts)!=0) return -1; { ts->toks[ts->n].kind=TOK_DEDENT; ts->toks[ts->n].line=line; ts->toks[ts->n].text[0]='\0'; ts->n++; }
                }
            }
            at_line_start=0;
            /* string literal (also f'...', b'...', r'...' raw strings) */
            if (*p=='\''||*p=='"'||(*p=='f'&&(p[1]=='\''||p[1]=='"'))||(*p=='b'&&(p[1]=='\''||p[1]=='"'))||(*p=='r'&&(p[1]=='\''||p[1]=='"'))) {
                char quote = *p;
                int is_fstring = 0;
                int is_raw = 0;
                if (quote=='f'||quote=='b'||quote=='r') { is_fstring = (quote=='f'); is_raw = (quote=='r'); quote=p[1]; p++; }
                /* Literals longer than ~248 raw chars (e.g. the compiler's own
                 * prelude slot strings) used to be SILENTLY TRUNCATED at the
                 * 256-byte token text, breaking every slot past 250 chars.
                 * They now spill into a heap `big` buffer, growing on demand
