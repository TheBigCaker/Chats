            for (i = 0; i < n; i++)
                if (a.u.s->data[i] != b.u.s->data[i]) return a.u.s->data[i] < b.u.s->data[i];
            return a.u.s->len < b.u.s->len;
        }
        return pyv_as_f(a) < pyv_as_f(b);
