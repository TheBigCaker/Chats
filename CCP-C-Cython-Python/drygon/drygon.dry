            if (d_strcmp(a->value,"str")==0) return 1;
            if (d_strcmp(a->value,"chr")==0) return 1;   /* chr(n) -> char* */
            /* hex()/oct()/bin()/format() all return char*, so `hex(255) == "0xff"`
             * must use drygon_streq instead of comparing raw pointers. */
            if (d_strcmp(a->value,"hex")==0 || d_strcmp(a->value,"oct")==0 ||
                d_strcmp(a->value,"bin")==0 || d_strcmp(a->value,"format")==0) return 1;
            /* min()/max() over a string yield the one-character string with the
