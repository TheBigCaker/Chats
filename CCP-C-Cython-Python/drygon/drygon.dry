     * (11_functions checks 42/43). */
    static char cg_prog_rshape[2048];
    static char cg_prog_vretstr[256];  /* ...and returns a string            */
    static int cg_prog_masks[1024];    /* 256 functions x 4 signatures       */
    static int cg_prog_nmask[256];
    static char cg_prog_maskret[1024];
    /* Python floats carry no type, so a site that hands a float to a plain
     * parameter gets a body of its own: bit p says parameter p of that
     * variant is a `double`, and `cg_prog_maskfret` says the body's `return`
     * is floating (the C twin has to return double, not int). */
    static int cg_prog_fmask[1024];
    static char cg_prog_maskfret[1024];
    /* The inferred (base) signature can itself take a `double` list, in which
     * case `return xs[0]` is a floating return of the base body. */
    static char cg_prog_basefret[256];
    /* 256 functions x up to 8 parameters: bit p is set when parameter p of
     * that function is bound to a python list at some call site.  A python
     * list crosses a call as an element pointer plus a companion count. */
    static int cg_prog_lmask[256];
    /* Element type of parameter p, 2 bits each: 0 int, 1 double, 2 char*.
     * Python carries no types, so the type is recovered by a fixpoint over the
     * call sites: the first site to mention a list decides, and a site that
     * disagrees gets its own body (see the signature variants below). */
    static int cg_prog_ltype[256];
    static int cg_prog_ldec[256];  /* bit p: parameter p's type is decided */
    static int cg_prog_lprev[256]; /* the previous iteration's types */
    static int cg_prog_ldprev[256]; /* ...and decided bits */
    static int cg_prog_lmprev[256]; /* ...and list masks */
    /* Call site -> signature, recorded by the pre-pass.  The emission pass has
     * to spell out exactly the mask the pre-pass registered a body for, and
     * the argument tables have grown richer by then, so the mask is looked up
     * rather than recomputed. */
    static const IRNode* cg_call_lnodes[2048];
    static int cg_call_lkeys[2048];
    static int cg_call_lfm[2048];   /* ...and the float-bitmask of that site */
    static int cg_ncall_lkeys;
    static void cg_call_note(const IRNode* n, int mask) {
        int i = 0;
        while (i < cg_ncall_lkeys) {
            if (cg_call_lnodes[i] == n) { cg_call_lkeys[i] = mask; return; }
            i++;
        }
        if (cg_ncall_lkeys >= 2048) return;
        cg_call_lnodes[cg_ncall_lkeys] = n;
        cg_call_lkeys[cg_ncall_lkeys] = mask;
        cg_ncall_lkeys = cg_ncall_lkeys + 1;
    }
    static void cg_call_note_fm(const IRNode* n, int fm) {
        int i = 0;
        while (i < cg_ncall_lkeys) {
            if (cg_call_lnodes[i] == n) { cg_call_lfm[i] = fm; return; }
            i++;
        }
    }
    static int cg_call_fmask(const IRNode* n) {
        if (!n) return 0;
        int i = 0;
        while (i < cg_ncall_lkeys) { if (cg_call_lnodes[i] == n) return cg_call_lfm[i]; i++; }
        return 0;
    }
    static int cg_call_find(const IRNode* n) {
        if (!n) return -1;
        int i = 0;
        while (i < cg_ncall_lkeys) { if (cg_call_lnodes[i] == n) return cg_call_lkeys[i]; i++; }
        return -1;
    }
    static int cg_nprog_fns;
    static int cg_prog_find(const char* name) {
        if (!name) return -1;
        int i = 0;
        while (i < cg_nprog_fns) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_prog_fns[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    static int cg_prog_add(const char* name) {
        int e = cg_prog_find(name);
        if (e >= 0) return e;
        if (cg_nprog_fns >= 256) return -1;
        int base = cg_nprog_fns * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_prog_fns[base + j] = name[j]; j++; }
        cg_prog_fns[base + j] = 0;
        cg_prog_retstr[cg_nprog_fns] = 0;
        cg_prog_retlist[cg_nprog_fns] = 0;
        cg_prog_retsls[cg_nprog_fns] = 0;
        cg_prog_retdict[cg_nprog_fns] = 0;
        cg_prog_retdictvf[cg_nprog_fns] = 0;
        cg_prog_retdictkf[cg_nprog_fns] = 0;
        { int z = 0; while (z < 8) { cg_prog_rshape[cg_nprog_fns * 8 + z] = 0; z++; } }
        cg_prog_nparams[cg_nprog_fns] = 0;
        cg_prog_variant[cg_nprog_fns] = 0;
        cg_prog_vretstr[cg_nprog_fns] = 0;
        cg_prog_nmask[cg_nprog_fns] = 0;
        { int z = 0; while (z < 8) { cg_prog_pstr[cg_nprog_fns * 8 + z] = 0; z++; } }
        { int z = 0; while (z < 256) { cg_prog_pcls[cg_nprog_fns * 256 + z] = 0; z++; } }
        cg_nprog_fns = cg_nprog_fns + 1;
        return cg_nprog_fns - 1;
    }
    static void cg_note_pcls(int fi, int p, const char* cls) {
        if (fi < 0 || p < 0 || p >= 8 || !cls || !cls[0]) return;
        d_strncpy(cg_prog_pcls + fi * 256 + p * 32, cls, 31);
        cg_prog_pcls[fi * 256 + p * 32 + 31] = 0;
    }
    static const char* cg_param_cls(int fi, int p) {
        if (fi < 0 || p < 0 || p >= 8) return 0;
        if (!cg_prog_pcls[fi * 256 + p * 32]) return 0;
        return cg_prog_pcls + fi * 256 + p * 32;
    }
    /* Variables that hold an instance of a class.  The live table (`cg_cvar_*`)
     * is only filled while statements are generated, so it cannot type a
     * parameter whose signature is emitted before the body that assigns it. */
    static char cg_ov_names[16384];
    static char cg_ov_cls[16384];
    static int cg_ov_n;
    static void cg_ov_note(const char* nm, const char* cls) {
        if (!nm || !nm[0] || !cls || !cls[0]) return;
        int i = 0;
        while (i < cg_ov_n) {
            if (d_strcmp(cg_ov_names + i*32, nm)==0) {
                d_strncpy(cg_ov_cls + i*32, cls, 31);
                cg_ov_cls[i*32 + 31] = 0;
                return;
            }
            i++;
        }
        if (cg_ov_n >= 512) return;
        d_strncpy(cg_ov_names + cg_ov_n*32, nm, 31);
        cg_ov_names[cg_ov_n*32 + 31] = 0;
        d_strncpy(cg_ov_cls + cg_ov_n*32, cls, 31);
        cg_ov_cls[cg_ov_n*32 + 31] = 0;
        cg_ov_n = cg_ov_n + 1;
    }
    static const char* cg_ov_class(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_ov_n) {
            if (d_strcmp(cg_ov_names + i*32, nm)==0) return cg_ov_cls + i*32;
            i++;
        }
        return 0;
    }
    /* The OBJECT parameters of the function being generated.  `cg_clsptr_names`
     * only remembers that a name dereferences through `->`; a method call on
     * such a parameter also needs to know WHICH class it is
     * (`def f(p): return p.get()`). */
    static char cg_curp_names[2048];
    static char cg_curp_cls[2048];
    static int cg_ncurp;
    static void cg_curp_reset(void) { cg_ncurp = 0; }
    static void cg_note_curp(const char* nm, const char* cls) {
        if (!nm || !nm[0] || !cls || !cls[0] || cg_ncurp >= 64) return;
        d_strncpy(cg_curp_names + cg_ncurp*32, nm, 31);
        cg_curp_names[cg_ncurp*32 + 31] = 0;
        d_strncpy(cg_curp_cls + cg_ncurp*32, cls, 31);
        cg_curp_cls[cg_ncurp*32 + 31] = 0;
        cg_ncurp = cg_ncurp + 1;
    }
    static const char* cg_curp_cls_of(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_ncurp) {
            if (d_strcmp(cg_curp_names + i*32, nm)==0) return cg_curp_cls + i*32;
            i++;
        }
        return 0;
    }
    static int cg_fn_is_str(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_retstr[i];
    }
    /* a `*args`/`**kwargs` function is never a plain list producer: its
     * "result" is the tuple of collected parameters, and copying the collected
     * parameters into the shared list buffer corrupted the call (11_functions
     * check 42/43, `def f(*args, **kwargs): return (args, kwargs)`). */
    static const IRNode* cg_cur_prog_for_var;
    static int cg_fn_is_variadic(const char* name) {
        const IRNode* fn = cg_cur_prog_for_var ? cg_find_fn_node(cg_cur_prog_for_var, name) : NULL;
        const IRNode* pr = (fn && fn->nchildren > 0) ? fn->children[0] : NULL;
        int i = 0;
        if (!pr) return 0;
        while (i < pr->nchildren) {
            if (d_strcmp(pr->children[i]->data_type,"VARGS")==0) return 1;
            i++;
        }
        return 0;
    }
    static int cg_fn_is_list(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_retlist[i];
    }
    /* True when `name` hands back a list of strings.  The returned sequence
     * travels through the shared result buffer, and a list of `char*` cannot
     * ride in the int one (`drygon_rl`), so callers and the return emitter have
     * to agree on which buffer it is. */
    static int cg_fn_ret_strlist(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_retsls[i];
    }
    static int cg_fn_ret_dict(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_retdict[i];
    }
    static int cg_fn_ret_dict_vf(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_retdictvf[i];
    }
    static int cg_fn_ret_dict_kf(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_retdictkf[i];
    }
    /* How many leading POSITIONAL parameters precede the `*args` of `name`.
     * `def g(a, b, *rest)` has two: the caller passes those normally and packs
     * everything from there on into the varargs array.  -1 means the shape is
     * NOT packable -- no varargs at all, or a `**kwargs` (or anything else)
     * after them, whose own signature slot the rewritten call could not fill. */
    /* A parameter the prepass registered as a dict -- the subject of a MAPPING
     * pattern, or a `**kwargs` collector -- is handed over as its key array,
     * value array and entry count instead of a scalar.  A `**kwargs` parameter
     * used to keep the scalar treatment, which made the body read `kwargs_n`
     * out of nowhere and forced every call site to be lowered as an
     * assignment (11_functions checks 42/43). */
    static int cg_is_dict_param(const IRNode* p) {
        if (!p || !p->value || !p->value[0]) return 0;
        if (p->data_type && d_strcmp(p->data_type,"DICT")==0) return 1;
        return cg_is_dict(p->value);
    }
    static const char* cg_fn_param_dname_in(const IRNode* prog, const char* fname, int idx) {
        const IRNode* fn = prog ? cg_find_fn_node(prog, fname) : NULL;
        if (!fn || fn->nchildren < 1) return NULL;
        const IRNode* ps = fn->children[0];
        if (!ps || idx < 0 || idx >= ps->nchildren) return NULL;
        const IRNode* p = ps->children[idx];
        if (!cg_is_dict_param(p)) return NULL;
        return p->value;
    }
    static const char* cg_fn_param_dname(const char* fname, int idx) {
        return cg_fn_param_dname_in(cg_cur_prog_for_var, fname, idx);
    }
    /* `match_mapping({"key": 42})`: a dict LITERAL handed to a dict parameter.
     * A dict cannot be built inside an argument list -- the call needs the key
     * array and the value array, and drygon's compound literals
     * (`(char*[]){"key"}`) load their elements with the wrong width, so the
     * callee saw a null key and trapped (36_match check 23).  The literal is
     * hoisted into a temp dict variable just before the statement holding the
     * call, which is exactly the lowering `d = {"key": 42}` already produces. */
    static const IRNode* cg_hoist_prog;
    static int cg_hoist_n;
    static void cg_hoist_name(int k, char* out) {
        d_strcpy(out, "_dycallD");
        char tmp[16];
        int n = 0;
        if (k == 0) { tmp[n] = '0'; n++; }
        while (k > 0) { tmp[n] = '0' + (k % 10); n++; k = k / 10; }
        int len = 0;
        while (out[len]) len++;
        while (n > 0) { n--; out[len] = tmp[n]; len++; }
        out[len] = 0;
    }
    /* Register a hoisted literal exactly like `lhs = {DICT literal}` does. */
    static void cg_hoist_note(const char* nm, const IRNode* lit) {
        int kf = 0;
        int vf = 0;
        int k = 0;
        while (k + 1 < lit->nchildren) {
            if (cg_node_is_str_static(lit->children[k])) kf = 1;
            int v = cg_dict_vflag(lit->children[k+1]);
            if (v > vf) vf = v;
            k = k + 2;
        }
        cg_note_dict(nm, vf, kf);
    }
    /* ── dict parameters of METHODS ─────────────────────────────────────────
     * `DictWriter.writerow(rowdict)` reads its parameter with a RUNTIME key
     * (`rowdict[k]`), which no rule in cg_scan_dict_names can classify, so the
     * parameter stayed a scalar `int` and `rowdict[k]` indexed a raw word:
     * `50_csv` check 14 trapped.  A dict LITERAL handed to a method proves the
     * parameter is a dict, so the call is registered here (by method and
     * argument position) and the parameter name joins the dict table, which is
     * what gives the signature its key/value arrays. */
    static char cg_mpd_meth[64 * 32];
    static char cg_mpd_pname[64 * 32];
    static char cg_mpd_cls[64 * 32];
    static int  cg_mpd_pos[64];
    static int  cg_mpd_n;
    static void cg_mpd_note(const char* cls, const char* meth, int pos, const char* pname) {
        if (!meth || !meth[0] || !pname || !pname[0] || pos < 0) return;
        int i = 0;
        while (i < cg_mpd_n) {
            if (cg_mpd_pos[i] == pos && d_strcmp(cg_mpd_meth + i*32, meth) == 0 &&
                d_strcmp(cg_mpd_cls + i*32, cls ? cls : "") == 0) return;
            i++;
        }
        if (cg_mpd_n >= 64) return;
        d_strncpy(cg_mpd_meth + cg_mpd_n*32, meth, 31);
        cg_mpd_meth[cg_mpd_n*32 + 31] = 0;
        d_strncpy(cg_mpd_pname + cg_mpd_n*32, pname, 31);
        cg_mpd_pname[cg_mpd_n*32 + 31] = 0;
        d_strncpy(cg_mpd_cls + cg_mpd_n*32, cls ? cls : "", 31);
        cg_mpd_cls[cg_mpd_n*32 + 31] = 0;
        cg_mpd_pos[cg_mpd_n] = pos;
        cg_mpd_n = cg_mpd_n + 1;
    }
    /* `writer.writerow` and `DictWriter.writerow` both take a parameter called
     * `rowdict`, but only the DictWriter one receives a dict, so the key has to
     * carry the class that defines the method -- a name-only key turned the
     * list parameter of `writer.writerow` into a dict triple as well. */
    static const char* cg_mpd_get(const char* cls, const char* meth, int pos) {
        if (!meth || pos < 0) return (const char*)0;
        int i = 0;
        while (i < cg_mpd_n) {
            if (cg_mpd_pos[i] == pos && d_strcmp(cg_mpd_meth + i*32, meth) == 0 &&
                d_strcmp(cg_mpd_cls + i*32, cls ? cls : "") == 0)
                return cg_mpd_pname + i*32;
            i++;
        }
        if (cls && cls[0]) {
            const char* d = cg_cls_find_m(cls, meth);
            if (d && d[0] && d_strcmp(d, cls) != 0) return cg_mpd_get(d, meth, pos);
        }
        return (const char*)0;
    }
    /* The parameter node that method `meth` receives at ARGUMENT position `pos`
     * (parameters carry `self` first, so the node is `pos + 1`), searched over
     * every class body: the class registry is only filled while the structs are
     * emitted, which is after this pass. */
    static const IRNode* cg_meth_param_node(const IRNode* prog, const char* cls, const char* meth, int pos) {
        if (!prog || !meth || !meth[0] || pos < 0) return NULL;
        int i = 0;
        while (i < prog->nchildren) {
            const IRNode* c = prog->children[i];
            if (c && d_strcmp(c->type,"CLASS_DEF")==0 && cls && cls[0] &&
                (!c->value || d_strcmp(c->value, cls)!=0)) { i++; continue; }
            if (c && d_strcmp(c->type,"CLASS_DEF")==0 && c->nchildren > 0 && c->children[0] &&
                d_strcmp(c->children[0]->type,"BLOCK")==0) {
                const IRNode* b = c->children[0];
                int k = 0;
                while (k < b->nchildren) {
                    const IRNode* m = b->children[k];
                    if (m && d_strcmp(m->type,"FUNCTION_DEF")==0 && m->value &&
                        d_strcmp(m->value, meth)==0 && m->nchildren > 0 && m->children[0]) {
                        const IRNode* ps = m->children[0];
                        if (pos + 1 < ps->nchildren) {
                            const IRNode* pn = ps->children[pos + 1];
                            if (pn && d_strcmp(pn->type,"PARAM_DECL")==0 && pn->value &&
                                pn->value[0] &&
                                (!pn->data_type ||
                                 (d_strcmp(pn->data_type,"LIST")!=0 &&
                                  d_strcmp(pn->data_type,"VARGS")!=0 &&
                                  d_strcmp(pn->data_type,"DICT")!=0)))
                                return pn;
                        }
                    }
                    k++;
                }
            }
            i++;
        }
        return NULL;
    }
    static IRNode* cg_hoist_prog;
    static const char* cg_hoist_cls;
    static void cg_hoist_dict_args(IRNode* a, IRNode* owner, int idx) {
        if (!a) return;
        if (d_strcmp(a->type,"FUNCTION_DEF")==0) {
            if (a->nchildren > 1 && a->children[1] &&
                d_strcmp(a->children[1]->type,"BLOCK")==0) {
                IRNode* b = a->children[1];
                int i = 0;
                while (i < b->nchildren) { cg_hoist_dict_args(b->children[i], b, i); i++; }
            }
            return;
        }
        if (d_strcmp(a->type,"CLASS_DEF")==0) {
            /* a class body is `children[0]`; the method walk needs it so a call
             * inside a method can be attributed to its class, and so dict
             * literals written inside methods are hoisted too */
            const char* save_cls = cg_hoist_cls;
            if (a->value && a->value[0]) cg_hoist_cls = a->value;
            if (a->nchildren > 0 && a->children[0] &&
                d_strcmp(a->children[0]->type,"BLOCK")==0) {
                IRNode* b = a->children[0];
                int i = 0;
                while (i < b->nchildren) { cg_hoist_dict_args(b->children[i], b, i); i++; }
            }
            cg_hoist_cls = save_cls;
            return;
        }
        if (d_strcmp(a->type,"IF")==0 || d_strcmp(a->type,"FOR")==0 ||
            d_strcmp(a->type,"WHILE")==0 || d_strcmp(a->type,"TRY")==0) {
            int j = 0;
            while (j < a->nchildren) {
                IRNode* c = a->children[j];
                if (c && d_strcmp(c->type,"BLOCK")==0) {
                    int k = 0;
                    while (k < c->nchildren) { cg_hoist_dict_args(c->children[k], c, k); k++; }
                } else {
                    cg_hoist_dict_args(c, owner, idx);
                }
                j++;
            }
            return;
        }
        if (d_strcmp(a->type,"CALL")==0 && a->value && a->value[0]) {
            const char* cn = cg_als_wrap_of(a->value);
            if (!cn) cn = cg_fna_of(a->value);
            if (!cn) cn = a->value;
            /* an instance method call: `recv.m(args)` is a COMPLEX call whose
             * first child is the MEMBER_ACCESS holding the method name, so the
             * callee's parameters are found through the class bodies instead of
             * the top-level function table. */
            const char* mname = NULL;
            const char* mcls = NULL;
            if (d_strcmp(a->value,"COMPLEX")==0 && a->nchildren > 0 &&
                a->children[0] && d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
                a->children[0]->value && a->children[0]->value[0]) {
                mname = a->children[0]->value;
                const char* bn = (a->children[0]->nchildren > 0 && a->children[0]->children[0] &&
                                  d_strcmp(a->children[0]->children[0]->type,"IDENTIFIER")==0) ?
                                 a->children[0]->children[0]->value : (const char*)0;
                if (bn && cg_hoist_cls && cg_hoist_cls[0] && d_strcmp(bn,"self")==0)
                    mcls = cg_hoist_cls;
                if (!mcls && bn) mcls = cg_cvar_class(bn);
                if (!mcls && bn && cg_is_class_scan(bn)) mcls = bn;
                if (!mcls && bn) mcls = cg_ov_class(bn);
                if (!mcls && cg_hoist_cls && cg_hoist_cls[0]) mcls = cg_hoist_cls;
            }
            int i = 0;
            while (i < a->nchildren) {
                IRNode* c = a->children[i];
                if (c && owner && idx >= 0 && d_strcmp(c->type,"BLOCK")==0 &&
                    d_strcmp(c->value,"DICT")==0 &&
                    owner->nchildren < IR_MAX_CHILDREN) {
                    const char* _hp = NULL;
                    if (mname) {
                        int mpos = i - 1;
                        if (mpos < 0) { i++; continue; }
                        /* EVERY literal at this position is noted, not just the
                         * first one: `cg_note_dict` only ever RAISES a recorded
                         * kind, so the parameter's key/value types become the
                         * union over its call sites.  Noting only the first
                         * literal left `DictWriter.writerow`'s `rowdict` typed
                         * `int*` from its int-valued call site, and 50_csv's
                         * string-valued check 29 then read pointers through an
                         * int array (it printed `604668`). */
                        {
                            const IRNode* _pn = cg_meth_param_node(cg_hoist_prog, mcls, mname, mpos);
                            if (_pn && _pn->value) {
                                cg_hoist_note(_pn->value, c);
                                if (!cg_mpd_get(mcls, mname, mpos))
                                    cg_mpd_note(mcls, mname, mpos, _pn->value);
                            }
                        }
                        if (!cg_mpd_get(mcls, mname, mpos)) { i++; continue; }
                        _hp = cg_mpd_get(mcls, mname, mpos);
                    } else {
                    /* A dict LITERAL handed to a parameter proves that the
                     * parameter is a dict, even when the callee never reads it
                     * with a literal key (`DictWriter.writerow(rowdict)` does
                     * `rowdict[k]` with a runtime key, which no rule in
                     * cg_scan_dict_names can see).  Register the parameter
                     * here so its signature carries the key/value arrays and
                     * the call site hands them over. */
                    if (!cg_fn_param_dname_in(cg_hoist_prog, cn, i)) {
                        const IRNode* _fn = cg_find_fn_node(cg_hoist_prog, cn);
                        const IRNode* _ps = (_fn && _fn->nchildren > 0) ? _fn->children[0] : NULL;
                        const IRNode* _pn = (_ps && i < _ps->nchildren) ? _ps->children[i] : NULL;
                        if (_pn && _pn->value && _pn->value[0] &&
                            d_strcmp(_pn->type,"PARAM_DECL")==0 &&
                            (!_pn->data_type || (d_strcmp(_pn->data_type,"LIST")!=0 &&
                                                 d_strcmp(_pn->data_type,"VARGS")!=0 &&
                                                 d_strcmp(_pn->data_type,"DICT")!=0)))
                            cg_hoist_note(_pn->value, c);
                    }
                    if (!cg_fn_param_dname_in(cg_hoist_prog, cn, i)) {
                        i++;
                        continue;
                    }
                    _hp = cg_fn_param_dname_in(cg_hoist_prog, cn, i);
                    }
                    char nm[32];
                    cg_hoist_name(cg_hoist_n, nm);
                    cg_hoist_n = cg_hoist_n + 1;
                    IRNode* asg = ir_new("ASSIGN", "=", "ANY");
                    ir_add_child(asg, ir_new("IDENTIFIER", nm, "ANY"));
                    ir_add_child(asg, c);
                    int z = owner->nchildren;
                    while (z > idx) { owner->children[z] = owner->children[z-1]; z--; }
                    owner->children[idx] = asg;
                    owner->nchildren = owner->nchildren + 1;
                    idx = idx + 1;
                    a->children[i] = ir_new("IDENTIFIER", nm, "ANY");
                    cg_hoist_note(nm, c);
                    cg_dht_note(nm, _hp);
                }
                i++;
            }
        }
        int j = 0;
        while (j < a->nchildren) { cg_hoist_dict_args(a->children[j], owner, idx); j++; }
    }
    /* A hoisted dict literal is handed to exactly ONE parameter, so the temp's
     * key/value kinds have to follow that parameter's final kinds.  The link is
     * recorded while hoisting and applied after the whole pass, because the
     * parameter's kinds are the union over every call site and a later call site
     * may raise them after the temp was registered (50_csv check 29: the int
     * call site registered `rowdict` first, the string one came later). */
    static char cg_dht_temp[64 * 32];
    static char cg_dht_param[64 * 32];
    static int  cg_dht_n;
    static void cg_dht_note(const char* temp, const char* param) {
        if (!temp || !temp[0] || !param || !param[0]) return;
        if (cg_dht_n >= 64) return;
        d_strncpy(cg_dht_temp + cg_dht_n*32, temp, 31);
        cg_dht_temp[cg_dht_n*32 + 31] = 0;
        d_strncpy(cg_dht_param + cg_dht_n*32, param, 31);
        cg_dht_param[cg_dht_n*32 + 31] = 0;
        cg_dht_n = cg_dht_n + 1;
    }
    static void cg_dht_unify(void) {
        int i = 0;
        while (i < cg_dht_n) {
            const char* t = cg_dht_temp + i*32;
            const char* pn = cg_dht_param + i*32;
            cg_note_dict(t, cg_dict_vf(pn), cg_dict_kf(pn));
            i++;
        }
    }
    static void cg_hoist_dict_args_prog(IRNode* prog) {
        if (!prog) return;
        cg_hoist_prog = prog;
        cg_hoist_n = 0;
        int i = 0;
        while (i < prog->nchildren) { cg_hoist_dict_args(prog->children[i], prog, i); i++; }
        cg_dht_unify();
    }
    /* `f(a=1, b=2)` where `f` declares `**kwargs`: the keywords have to arrive
     * as a dict, and a dict cannot be built inside an argument list (see
     * cg_hoist_dict_args).  Hoist them into a temp dict variable inserted just
     * before the statement holding the call and leave a DSTAR_KW marker whose
     * value is "KW" (a real `f(**d)` has a DICT child instead), which the call
     * emitter recognizes (11_functions checks 42/43). */
    static IRNode* cg_hoist_kw_prog;
    static int cg_hoist_kwn;
    static void cg_hoist_kw_name(int k, char* out) {
        d_strcpy(out, "_dykw");
        char tmp[16];
        int n = 0;
        if (k == 0) { tmp[n] = '0'; n++; }
        while (k > 0) { tmp[n] = '0' + (k % 10); n++; k = k / 10; }
        int len = 0;
        while (out[len]) len++;
        while (n > 0) { n--; out[len] = tmp[n]; len++; }
        out[len] = 0;
    }
    static void cg_hoist_kw_dicts(IRNode* a, IRNode* owner, int idx) {
        if (!a) return;
        if (d_strcmp(a->type,"FUNCTION_DEF")==0 || d_strcmp(a->type,"CLASS_DEF")==0) {
            if (a->nchildren > 1 && a->children[1] &&
                d_strcmp(a->children[1]->type,"BLOCK")==0) {
                IRNode* b = a->children[1];
                int i = 0;
                while (i < b->nchildren) { cg_hoist_kw_dicts(b->children[i], b, i); i++; }
            }
            return;
        }
        if (d_strcmp(a->type,"IF")==0 || d_strcmp(a->type,"FOR")==0 ||
            d_strcmp(a->type,"WHILE")==0 || d_strcmp(a->type,"TRY")==0) {
            int j = 0;
            while (j < a->nchildren) {
                IRNode* c = a->children[j];
                if (c && d_strcmp(c->type,"BLOCK")==0) {
                    int k = 0;
                    while (k < c->nchildren) { cg_hoist_kw_dicts(c->children[k], c, k); k++; }
                } else {
                    cg_hoist_kw_dicts(c, owner, idx);
                }
                j++;
            }
            return;
        }
        if (d_strcmp(a->type,"CALL")==0 && a->value && a->value[0]) {
            const char* cn = cg_als_wrap_of(a->value);
            if (!cn) cn = cg_fna_of(a->value);
            if (!cn) cn = a->value;
            int haskw = 0;
            int realds = 0;
            int nc = 0;
            while (nc < a->nchildren) {
                const IRNode* c = a->children[nc];
                if (c && d_strcmp(c->type,"KWARG")==0) haskw = 1;
                if (c && d_strcmp(c->type,"DSTAR_KW")==0) realds = 1;
                nc++;
            }
            if (haskw && !realds && cg_fn_has_kwargs(cn)) {
                const char* kwp = NULL;
                const IRNode* fn = cg_hoist_kw_prog ? cg_find_fn_node(cg_hoist_kw_prog, cn) : NULL;
                const IRNode* pr = (fn && fn->nchildren > 0) ? fn->children[0] : NULL;
                int pi = 0;
                while (pr && pi < pr->nchildren) {
                    if (pr->children[pi]->data_type &&
                        d_strcmp(pr->children[pi]->data_type,"DICT")==0)
                        kwp = pr->children[pi]->value;
                    pi++;
                }
                if (kwp && owner && idx >= 0 && owner->nchildren < IR_MAX_CHILDREN) {
                    IRNode* lit = ir_new("BLOCK","DICT","ANY");
                    int i = 0;
                    while (i < a->nchildren) {
                        const IRNode* c = a->children[i];
                        if (c && d_strcmp(c->type,"KWARG")==0 && c->value && c->nchildren>0) {
                            char kb[192];
                            int z = 0;
                            int q = 0;
                            kb[z] = '"'; z++;
                            while (c->value[q] && z < 180) { kb[z] = c->value[q]; z++; q++; }
                            kb[z] = '"'; z++;
                            kb[z] = 0;
                            ir_add_child(lit, ir_new("CONSTANT", kb, "STR"));
                            ir_add_child(lit, c->children[0]);
                        }
                        i++;
                    }
                    char nm[64];
                    cg_hoist_kw_name(cg_hoist_kwn, nm);
                    cg_hoist_kwn = cg_hoist_kwn + 1;
                    IRNode* asg = ir_new("ASSIGN", "=", "ANY");
                    ir_add_child(asg, ir_new("IDENTIFIER", nm, "ANY"));
                    ir_add_child(asg, lit);
                    int z = owner->nchildren;
                    while (z > idx) { owner->children[z] = owner->children[z-1]; z--; }
                    owner->children[idx] = asg;
                    owner->nchildren = owner->nchildren + 1;
                    idx = idx + 1;
                    cg_note_dict(nm, cg_dict_vf(kwp), cg_dict_kf(kwp));
                    IRNode* mark = ir_new("DSTAR_KW", "KW", "ANY");
                    ir_add_child(mark, ir_new("IDENTIFIER", nm, "ANY"));
                    int j = 0;
                    int out = 0;
                    while (j < a->nchildren) {
                        IRNode* c = a->children[j];
                        if (c && d_strcmp(c->type,"KWARG")==0) { j++; continue; }
                        a->children[out] = c;
                        out++;
                        j++;
                    }
                    a->children[out] = mark;
                    out++;
                    a->nchildren = out;
                }
            }
        }
        int j = 0;
        while (j < a->nchildren) { cg_hoist_kw_dicts(a->children[j], owner, idx); j++; }
    }
    static void cg_hoist_kw_dicts_prog(IRNode* prog) {
        if (!prog) return;
        cg_hoist_kw_prog = prog;
        cg_hoist_kwn = 0;
        int i = 0;
        while (i < prog->nchildren) { cg_hoist_kw_dicts(prog->children[i], prog, i); i++; }
    }
    /* `a, k = f(...)` where `f` returns `(args, kwargs)`: the targets hold a
     * list and a dict, so they need the same declarations a list/dict variable
     * gets -- and declarations are emitted after this pre-pass, never during
     * statement emission (11_functions checks 42/43). */
    static void cg_scan_ret_unpack(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren > 1 &&
            cg_is_list_node(a->children[0]) && a->children[1]) {
            /* a call returning a tuple arrives wrapped in a one-child BLOCK
             * (`a, k = f(...)` -> BLOCK(TUPLE){CALL f}); the emission pass
             * unwraps it the same way, so the pre-pass has to as well or the
             * targets never register as list/dict storage */
            const IRNode* rhs = a->children[1];
            if (d_strcmp(rhs->type,"BLOCK")==0 && rhs->nchildren == 1) rhs = rhs->children[0];
        if (rhs && d_strcmp(rhs->type,"CALL")==0 && rhs->value) {
            int fi = cg_prog_find(rhs->value);
            if (fi >= 0) {
                const IRNode* lhs = a->children[0];
                int k = 0;
                while (k < lhs->nchildren && k < 8) {
                    const IRNode* t = lhs->children[k];
                    int sh = cg_prog_rshape[fi * 8 + k];
                    if (t && d_strcmp(t->type,"IDENTIFIER")==0) {
                        if (sh >= 4) cg_note_dict(t->value, (sh - 4) / 2, (sh - 4) % 2);
                        else if (sh == 1 || sh == 2) cg_note_list(t->value, 64, 0);
                    }
                    k++;
                }
            }
        }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_ret_unpack(a->children[i]); i++; }
    }
    static int cg_fn_vararg_fixed(const char* name) {
        const IRNode* fn = cg_cur_prog_for_var ? cg_find_fn_node(cg_cur_prog_for_var, name) : NULL;
        const IRNode* pr = (fn && fn->nchildren > 0) ? fn->children[0] : NULL;
        int n = 0;
        if (!pr) return -1;
        while (n < pr->nchildren) {
            if (d_strcmp(pr->children[n]->data_type,"VARGS")==0 ||
                d_strcmp(pr->children[n]->data_type,"LIST")==0) break;
            n++;
        }
        if (n >= pr->nchildren) return -1;
        if (n + 1 != pr->nchildren) return -1;
        return n;
    }
    /* How many POSITIONAL parameters a plain (non-collector) function declares,
     * or -1 when the shape has a collector (or no signature at all) and so
     * cannot be fed positionally from a runtime argument array. */
    static int cg_fn_nfixed(const char* name) {
        const IRNode* fn = cg_cur_prog_for_var ? cg_find_fn_node(cg_cur_prog_for_var, name) : NULL;
        const IRNode* pr = (fn && fn->nchildren > 0) ? fn->children[0] : NULL;
        if (!name || !pr || pr->nchildren < 1) return -1;
        int n = 0;
        while (n < pr->nchildren) {
            const char* dt = pr->children[n]->data_type;
            if (!dt) return -1;
            if (d_strcmp(dt,"VARGS")==0 || d_strcmp(dt,"DICT")==0 ||
                d_strcmp(dt,"LIST")==0) return -1;
            n++;
        }
        return n;
    }
    /* How a `*args` / `**kwargs` collector receives its trailing arguments: the
     * number of leading positional parameters, or -1 when `name` is not a
     * collector.  `*hasAr` reports a `*args` (handed over as an array plus its
     * count), `*hasKw` a `**kwargs` (handed over as key array, value array and
     * entry count).  `def sum_all(*args)` -> 0 with hasAr; `def f(a, *args)`
     * -> 1; `def f(**kw)` -> 0 with hasKw; `def f(a, **kw)` -> 1 with hasKw;
     * `def f(*args, **kw)` -> 0 with both.  `def f(a, b=1, *args)` is -1: the
     * fixed parameters' defaults have to be applied before the arguments can be
     * packed, which the caller does not do. */
    static int cg_fn_collect_shape(const char* name, int* hasAr, int* hasKw) {
        if (hasAr) *hasAr = 0;
        if (hasKw) *hasKw = 0;
        const IRNode* fn = cg_cur_prog_for_var ? cg_find_fn_node(cg_cur_prog_for_var, name) : NULL;
        const IRNode* pr = (fn && fn->nchildren > 0) ? fn->children[0] : NULL;
        if (!name || !pr || pr->nchildren < 1) return -1;
        int last = pr->nchildren - 1;
        int kwok = (d_strcmp(pr->children[last]->data_type,"DICT")==0);
        int va = -1;
        int n = 0;
        while (n < pr->nchildren) {
            const char* dt = pr->children[n]->data_type;
            if (dt && d_strcmp(dt,"VARGS")==0) {
                if (va >= 0) return -1;
                va = n;
            } else if (dt && d_strcmp(dt,"DICT")==0) {
                if (n != last) return -1;
            } else if (dt && d_strcmp(dt,"LIST")==0) {
                return -1;
            }
            n++;
        }
        if (va < 0 && !kwok) return -1;
        if (va >= 0) {
            if (kwok) { if (va + 2 != pr->nchildren) return -1; }
            else { if (va + 1 != pr->nchildren) return -1; }
        }
        if (hasAr && va >= 0) *hasAr = 1;
        if (hasKw && kwok) *hasKw = 1;
        return va >= 0 ? va : last;
    }
    /* Which parameters of `name` are python lists in some signature (bitmask),
     * and the inferred element type of parameter `p` (0 int, 1 double, 2
     * char*).  A concrete signature reads both off its own mask. */
    static int cg_fn_lmask(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_lmask[i];
    }
    static int cg_fn_ltype(const char* name, int p) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return (cg_prog_ltype[i] >> (p * 2)) & 3;
    }
    static int cg_fn_param_is_str(const char* fname, int idx) {
        int i = cg_prog_find(fname);
        if (i < 0 || idx < 0 || idx > 7) return 0;
        return cg_prog_pstr[i * 8 + idx];
    }
    /* A function handed a string by any call site gets a second body; python
     * has no overloading but `h(3, 4)` and `h("ab", "cd")` are both legal and
     * must both work, so the call site picks the matching signature. */
    static int cg_fn_variant(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_variant[i];
    }
    static int cg_fn_variant_retstr(const char* name) {
        int i = cg_prog_find(name);
        if (i < 0) return 0;
        return cg_prog_vretstr[i];
    }
    static int cg_call_is_str(const IRNode* a) {
        if (!a) return 0;
        int i = 0;
        while (i < a->nchildren) { if (cg_is_str_node(a->children[i])) return 1; i++; }
        return 0;
    }
    /* ── per-signature variants ────────────────────────────────────────────
     * A call site's arguments spell out which positions hold strings and which
     * hold python lists (and of what element type); when they differ from the
     * function's inferred signature a dedicated body is emitted
     * (`name__<bitmask>`), so `h(3, 4)` and `h("ab", "cd")` can both reach C.
     *   bits 0..7    parameter i is char*
     *   bits 8..15   parameter i is a python list (pointer + count)
     *   bits 16..23  ... its elements are double
     *   bits 24..31  ... its elements are char* */
    #define CG_NMASK 4
    static int cg_mask_ltype(int mask, int p) {
        if (mask & (1 << (24 + p))) return 2;
        if (mask & (1 << (16 + p))) return 1;
        return 0;
    }
    /* the list bits of function `fi`'s inferred (base) signature */
    static int cg_lbits(int fi) {
        int m = 0;
        int k = 0;
        while (k < 8) {
            if (cg_prog_lmask[fi] & (1 << k)) {
                m = m | (1 << (8 + k));
                int t = (cg_prog_ltype[fi] >> (k * 2)) & 3;
                if (t == 1) m = m | (1 << (16 + k));
                if (t == 2) m = m | (1 << (24 + k));
            }
            k++;
        }
        return m;
    }
    static int cg_fn_base_mask(const char* name) {
        int fi = cg_prog_find(name);
        if (fi < 0) return 0;
        int m = 0;
        int k = 0;
        while (k < 8) {
            if (cg_prog_pstr[fi * 8 + k]) m = m | (1 << k);
            k++;
        }
        return m | cg_lbits(fi);
    }
    static int cg_call_mask(const IRNode* a) {
        int k = cg_call_find(a);
        if (k >= 0) return k;
        int m = 0;
        int i = 0;
        while (a && i < a->nchildren && i < 8) {
            if (cg_is_str_node(a->children[i])) m = m | (1 << i);
            i++;
        }
        return m;
    }
    static int cg_call_mask_static(const IRNode* a) {
        int m = 0;
        int i = 0;
        while (a && i < a->nchildren && i < 8) {
            if (cg_node_is_str_static(a->children[i])) m = m | (1 << i);
            i++;
        }
        return m;
    }
    /* The mask a call site needs *in the variant being emitted right now*.  The
     * pre-pass records one mask per site, derived from the base signature of the
     * enclosing function; but a variant that was handed an `int` list has to
     * call the callee's `int*` body.  `def avg(xs): return total(xs)/len(xs)`
     * therefore divided with the `double*` body of `total` and printed 0.0 for
     * an integer list.  A list argument that is an enclosing list parameter is
     * re-derived here; a mask no body was emitted for keeps the recorded one. */
    static int cg_call_mask_live(const IRNode* a) {
        int rec = cg_call_find(a);
        int m = rec >= 0 ? rec : 0;
        int live = 0;
        int i = 0;
        while (a && i < a->nchildren && i < 8) {
            const IRNode* c = a->children[i];
            if (c && d_strcmp(c->type,"IDENTIFIER")==0 && cg_is_lparam(c->value)) {
                m = m & ~(1 << (16 + i));
                m = m & ~(1 << (24 + i));
                m = m | (1 << (8 + i));
                int t = cg_lparam_type(c->value);
                if (t == 1) m = m | (1 << (16 + i));
                if (t == 2) m = m | (1 << (24 + i));
                live = 1;
            }
            i++;
        }
        if (live && a && cg_has_mask2(a->value, m, cg_call_fmask(a))) return m;
        /* The pre-pass records a site's string bits without entering the
         * enclosing function, so `def b(name): return a(name)` was recorded
         * with a mask of 0 even though `name` is a `char*`: the site then asked
         * for `a__0(int name)` and the pointer was truncated.  The string bits
         * are stable by now (the parameter pass ran to a fixpoint), so fold the
         * scoped view in before falling back to the recorded mask. */
        if (rec >= 0) {
            int sm = cg_call_mask_static(a);
            if (sm != 0 && sm == cg_fn_base_mask(a->value)) return sm;
            /* A call that omits trailing parameters is filled in with the
             * callee's own defaults; the recorded mask only saw the arguments
             * that were written, so `tempfile.mkdtemp()` asked for
             * `mkdtemp__0(int prefix)` and the materialised `"tmp"` pointer was
             * truncated to its low word (the temporary directory came out as
             * garbage and every path under it failed to exist).  Fold the
             * string bits of the omitted parameters in. */
            {
                int fi2 = cg_prog_find(a->value);
                if (fi2 >= 0) {
                    int m2 = rec;
                    int j = a ? a->nchildren : 0;
                    while (j < cg_prog_nparams[fi2] && j < 8) {
                        if (cg_prog_pstr[fi2 * 8 + j]) m2 = m2 | (1 << j);
                        j++;
                    }
                    if (m2 != rec &&
                        (m2 == cg_fn_base_mask(a->value) ||
                         cg_has_mask2(a->value, m2, cg_call_fmask(a)))) return m2;
                }
            }
            return rec;
        }
        /* A call written inside an f-string field is not part of the tree the
         * pre-pass walks: `f"{stats(xs)}"` is re-parsed when the string is
         * emitted, so its call site has no recorded mask and the list argument
         * was left out of the call (`stats(xs)` instead of `stats(xs, xs_n)`),
         * which made the callee read an uninitialised element count.  Derive
         * the mask from the arguments here and use it when a body with that
         * signature exists. */
        int d = 0;
        int i2 = 0;
        while (a && i2 < a->nchildren && i2 < 8) {
            const IRNode* c = a->children[i2];
            int lt = 0;
            if (c && d_strcmp(c->type,"IDENTIFIER")==0) {
                if (cg_is_lparam(c->value)) {
                    int t = cg_lparam_type(c->value);
                    lt = t == 2 ? 3 : (t == 1 ? 2 : 1);
                } else if (cg_sl_index(c->value) >= 0 || cg_list_size(c->value) >= 0) {
                    lt = cg_list_is_str(c->value) ? 3 : (cg_list_is_float(c->value) ? 2 : 1);
                }
            } else if (cg_sl_islice(c)) {
                int et = cg_sl_base_et(c);
                lt = et == 2 ? 3 : (et == 1 ? 2 : 1);
            } else if (cg_is_list_node(c)) {
                lt = 1;
            } else if (cg_is_str_node(c)) {
                d = d | (1 << i2);
            }
            if (lt) {
                d = d | (1 << (8 + i2));
                if (lt == 2) d = d | (1 << (16 + i2));
                if (lt == 3) d = d | (1 << (24 + i2));
            }
            i2++;
        }
        int b0 = cg_fn_base_mask(a->value);
        if (d != 0) {
            if (d == b0) return d;
            if (cg_has_mask2(a->value, d, 0)) return d;
        }
        return b0;
    }
    static void cg_note_mask(int fi, int mask) { cg_note_mask2(fi, mask, 0); }
    static void cg_note_mask2(int fi, int mask, int fm) {
        if (fi < 0) return;
        int n = cg_prog_nmask[fi];
        int j = 0;
        while (j < n) {
            if (cg_prog_masks[fi * CG_NMASK + j] == mask && cg_prog_fmask[fi * CG_NMASK + j] == fm) return;
            j++;
        }
        if (n >= CG_NMASK) return;
        cg_prog_masks[fi * CG_NMASK + n] = mask;
        cg_prog_fmask[fi * CG_NMASK + n] = fm;
        cg_prog_nmask[fi] = n + 1;
    }
    static int cg_has_mask(const char* name, int mask) {
        int fi = cg_prog_find(name);
        if (fi < 0) return 0;
        int j = 0;
        while (j < cg_prog_nmask[fi]) {
            if (cg_prog_masks[fi * CG_NMASK + j] == mask) return 1;
            j++;
        }
        return 0;
    }
    static int cg_has_mask2(const char* name, int mask, int fm) {
        int fi = cg_prog_find(name);
        if (fi < 0) return 0;
        int j = 0;
        while (j < cg_prog_nmask[fi]) {
            if (cg_prog_masks[fi * CG_NMASK + j] == mask && cg_prog_fmask[fi * CG_NMASK + j] == fm) return 1;
            j++;
        }
        return 0;
    }
    /* Does the variant body `name__<mask>_<fm>` return a double?  The call
     * site has to agree with the body, otherwise the value is read as an int. */
    static int cg_mask_fret(const char* name, int mask, int fm) {
        int fi = cg_prog_find(name);
        if (fi < 0) return 0;
        int j = 0;
        while (j < cg_prog_nmask[fi]) {
            if (cg_prog_masks[fi * CG_NMASK + j] == mask && cg_prog_fmask[fi * CG_NMASK + j] == fm)
                return cg_prog_maskfret[fi * CG_NMASK + j];
            j++;
        }
        return 0;
    }
    static int cg_call_ret_float(const IRNode* a) {
        if (!a || d_strcmp(a->type,"CALL")!=0) return 0;
        int fm = cg_call_fmask(a);
        int mk = cg_call_mask_live(a);
        if (cg_mask_fret(a->value, mk, fm)) return 1;
        if (fm == 0 && mk == cg_fn_base_mask(a->value)) {
            int fi = cg_prog_find(a->value);
            return fi >= 0 && cg_prog_basefret[fi];
        }
        return 0;
    }
    static int cg_mask_retstr(const char* name, int mask) {
        int fi = cg_prog_find(name);
        if (fi < 0) return 0;
        int j = 0;
        while (j < cg_prog_nmask[fi]) {
            if (cg_prog_masks[fi * CG_NMASK + j] == mask) return cg_prog_maskret[fi * CG_NMASK + j];
            j++;
        }
        return 0;
    }
    /* String-ness known from the syntax alone (the identifier tables are not
     * populated yet while the pre-pass runs). */
    static int cg_node_is_str_static(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CONSTANT")==0)
            return d_strcmp(a->data_type,"STR")==0 || d_strcmp(a->data_type,"FSTR")==0;
        if (d_strcmp(a->type,"SLICE")==0) return 1;
        if (d_strcmp(a->type,"BINARY_OP")==0 && a->nchildren>1 &&
            (d_strcmp(a->value,"+")==0 || d_strcmp(a->value,"*")==0))
            return cg_node_is_str_static(a->children[0]) || cg_node_is_str_static(a->children[1]);
        if (d_strcmp(a->type,"BINARY_OP")==0 && d_strcmp(a->value,"%")==0 &&
            a->nchildren>0 && cg_node_is_str_static(a->children[0])) return 1;
        if (d_strcmp(a->type,"IFEXP")==0 && a->nchildren>2)
            return cg_node_is_str_static(a->children[1]) && cg_node_is_str_static(a->children[2]);
        if (d_strcmp(a->type,"IDENTIFIER")==0) return cg_is_str_node(a);
        /* A class field that holds a `char*` (`self.restval`) and an element of
         * one (`self.fieldnames[i]`): the csv row dict is keyed by the
         * fieldnames and valued by the reader's elements, and with neither
         * shape known the store lowered to `drygon_dset_ii` -- the key was
         * truncated to an int and every lookup read address 0 (50_csv 10-13). */
        if (cg_member_is_str(a)) return 1;
        if (d_strcmp(a->type,"ARRAY_ACCESS")==0 && a->nchildren>0 && a->children[0] &&
            (cg_member_is_str(a->children[0]) ||
             (d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
              cg_list_is_str(a->children[0]->value)))) return 1;
        if (cg_is_strlist_node(a)) return 1;
        if (d_strcmp(a->type,"CALL")==0) {
            if (cg_native_strfn(a->value)) return 1;
            if (d_strcmp(a->value,"str")==0) return 1;
            if (d_strcmp(a->value,"COMPLEX")==0 && a->nchildren>0 && a->children[0] &&
                d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
                cg_is_str_method_ret(a->children[0]->value)) return 1;
            int mk = cg_call_mask_static(a);
            if (mk != cg_fn_base_mask(a->value)) return cg_mask_retstr(a->value, mk);
            return cg_fn_is_str(a->value);
        }
        return 0;
    }
    /* Numeric float-ness known from the syntax alone, used by the pre-pass to
     * decide which call sites hand a `double` to a plain parameter. */
    static int cg_node_is_flt_static(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CONSTANT")==0) return d_strcmp(a->data_type,"FLOAT")==0;
        if (d_strcmp(a->type,"BINARY_OP")==0) {
            const char* op = a->value;
            if (d_strcmp(op,"==")==0 || d_strcmp(op,"!=")==0 ||
                d_strcmp(op,"<")==0 || d_strcmp(op,">")==0 ||
                d_strcmp(op,"<=")==0 || d_strcmp(op,">=")==0 ||
                d_strcmp(op,"in")==0 || d_strcmp(op,"not in")==0 ||
                d_strcmp(op,"is")==0 || d_strcmp(op,"is not")==0) return 0;
            if (d_strcmp(op,"/")==0) return 1;
            if (a->nchildren>0 && cg_node_is_flt_static(a->children[0])) return 1;
            if (a->nchildren>1 && cg_node_is_flt_static(a->children[1])) return 1;
            return 0;
        }
        if (d_strcmp(a->type,"IFEXP")==0 && a->nchildren>2)
            return cg_node_is_flt_static(a->children[1]) && cg_node_is_flt_static(a->children[2]);
        if (d_strcmp(a->type,"UNARY_OP")==0 && a->nchildren>0) return cg_node_is_flt_static(a->children[0]);
        if (d_strcmp(a->type,"CALL")==0) {
            if (d_strcmp(a->value,"float")==0) return 1;
            return cg_fn_is_float(a->value);
        }
        return 0;
    }
    static int cg_arith_op(const char* op) {
        return d_strcmp(op,"+")==0 || d_strcmp(op,"-")==0 || d_strcmp(op,"*")==0 ||
               d_strcmp(op,"/")==0 || d_strcmp(op,"%")==0 || d_strcmp(op,"//")==0 ||
               d_strcmp(op,"**")==0;
    }
    /* Is `name` used as an arithmetic operand?  A string on the other side of
     * a `+` does not count: that is concatenation. */
    /* A local that is a string inside one function body: assigned a string
     * literal, or a parameter carrying a string default.  The arithmetic-drop
     * pass needs this because the live string table is empty before emission:
     * `field = ""` ... `field + quote` read as arithmetic and dropped the
     * `char*` from `quote` (`_csv_parse`'s quote character), so `quote[0]`
     * indexed an integer and the parser trapped on the first row. */
    static const IRNode* cg_ua_body;
    static int cg_body_str_local(const IRNode* a, const char* nm) {
        if (!a || !nm || !nm[0]) return 0;
        if (d_strcmp(a->type,"FUNCTION_DEF")==0 || d_strcmp(a->type,"CLASS_DEF")==0) return 0;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1 &&
            a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(a->children[0]->value, nm)==0 && cg_node_is_str_static(a->children[1]))
            return 1;
        if (d_strcmp(a->type,"PARAM_DECL")==0 && a->value &&
            d_strcmp(a->value, nm)==0 && a->nchildren>0 &&
            cg_node_is_str_static(a->children[0])) return 1;
        int i = 0;
        while (i < a->nchildren) { if (cg_body_str_local(a->children[i], nm)) return 1; i++; }
        return 0;
    }
    static int cg_used_arith(const IRNode* a, const char* name) {
        if (!a) return 0;
        if (d_strcmp(a->type,"BINARY_OP")==0) {
            const IRNode* l = a->nchildren>0 ? a->children[0] : NULL;
            const IRNode* r = a->nchildren>1 ? a->children[1] : NULL;
            if (cg_arith_op(a->value) && d_strcmp(a->value,"+")!=0) {
                if (l && d_strcmp(l->type,"IDENTIFIER")==0 && d_strcmp(l->value,name)==0) return 1;
                if (r && d_strcmp(r->type,"IDENTIFIER")==0 && d_strcmp(r->value,name)==0) return 1;
            }
            if (d_strcmp(a->value,"+")==0) {
                if (l && d_strcmp(l->type,"IDENTIFIER")==0 && d_strcmp(l->value,name)==0) {
                    if (!cg_node_is_str_static(r) &&
                        !(r && d_strcmp(r->type,"IDENTIFIER")==0 &&
                          (cg_is_strdef_param(r->value) ||
                           cg_body_str_local(cg_ua_body, r->value)))) return 1;
                }
                if (r && d_strcmp(r->type,"IDENTIFIER")==0 && d_strcmp(r->value,name)==0) {
                    if (!cg_node_is_str_static(l) &&
                        !(l && d_strcmp(l->type,"IDENTIFIER")==0 &&
                          (cg_is_strdef_param(l->value) ||
                           cg_body_str_local(cg_ua_body, l->value)))) return 1;
                }
            }
        }
        /* being called with the name (f(name)) or compared is not arithmetic */
        if (d_strcmp(a->type,"CALL")==0) {
            int i = 0;
            while (i < a->nchildren) {
                const IRNode* c = a->children[i];
                if (c && d_strcmp(c->type,"MEMBER_ACCESS")==0) { i++; continue; }
                if (cg_used_arith(c, name)) return 1;
                i++;
            }
            return 0;
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_used_arith(a->children[i], name)) return 1; i++; }
        return 0;
    }
    static int cg_ret_str_scan(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) {
                if (cg_node_is_str_static(a->children[1])) cg_note_str(lhs->value);
                else cg_forget_str(lhs->value);
            }
        }
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren>0) {
            if (cg_node_is_str_static(a->children[0])) return 1;
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_ret_str_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    /* The floating twin of `cg_ret_str_scan`, used for the signature variants
     * that take a `double`: the parameter tables are populated before the scan
     * so `x * 2` reads as floating when `x` is one. */
    static int cg_ret_float_scan(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && cg_is_float_node(a->children[1]))
                cg_note_float(lhs->value);
        }
        if (d_strcmp(a->type,"FOR")==0 && a->nchildren==3) {
            /* `for v in xs:` makes v a double when xs holds doubles, which is
             * what lets an accumulator (`s = s + v`) count as floating.  A
             * list parameter is read through its signature variant, not the
             * same-named module variable. */
            const IRNode* it = a->children[1];
            const IRNode* v = a->children[0];
            int ef = 0;
            if (it && d_strcmp(it->type,"IDENTIFIER")==0)
                ef = cg_is_lparam(it->value) ? cg_is_lparam_float(it->value)
                                             : cg_list_is_float(it->value);
            if (ef && v && d_strcmp(v->type,"IDENTIFIER")==0) cg_note_float(v->value);
        }
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren>0) {
            if (cg_is_float_node(a->children[0])) return 1;
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_ret_float_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    /* The list twin: a `return` of a python list literal marks the function
     * as returning the shared result buffer (an `int*` whose element count
     * travels in the companion global). */
    /* True when a body contains a `yield`: such a function BUILDS A LIST of the
     * yielded values and returns it (the eager-generator model).  The same
     * drygon_rl / _n machinery a list-returning function uses carries it out. */
    static int cg_yield_scan(const IRNode* a) {
        int i = 0;
        if (!a) return 0;
        if (d_strcmp(a->type,"YIELD")==0) return 1;
        while (i < a->nchildren) { if (cg_yield_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    static int cg_ret_list_scan(const IRNode* a) {
        if (!a) return 0;
        if (cg_yield_scan(a)) return 1;
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren>0) {
            const IRNode* rc = a->children[0];
            if (cg_is_list_node(rc)) return 1;
            /* `return list(...)` / `return tuple(...)`: the callee hands back a
             * sequence, so callers must read its element count (`f()_n`), not
             * the C string length.  Without this `len(f())` returned garbage. */
            if (d_strcmp(rc->type,"CALL")==0 && rc->value &&
                (d_strcmp(rc->value,"list")==0 || d_strcmp(rc->value,"tuple")==0)) return 1;
            if (d_strcmp(rc->type,"IDENTIFIER")==0 && cg_pyc_find(rc->value) >= 0) return 1;
            /* `return result` where `result` is an ordinary python list (how a
             * function that grows a list and hands it back is written).  Without
             * this the function stayed `int` and the caller bound the truncated
             * array pointer as an int (10_control check 37). */
            if (d_strcmp(rc->type,"IDENTIFIER")==0 && cg_list_size(rc->value) >= 0) return 1;
            /* `return xs` where xs is a LIST parameter (`def ident(xs)`): the
             * parameter holds the same array-plus-count pair a list variable
             * does, so the caller has to receive the count as well.  The
             * parameter is only known as a list while a signature scope is
             * entered, which the pre-pass arranges before the scan. */
            if (d_strcmp(rc->type,"IDENTIFIER")==0 && cg_is_lparam(rc->value)) return 1;
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_ret_list_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    static int cg_is_dict(const char* name);
    static int cg_dict_kf(const char* name);
    static int cg_dict_vf(const char* name);
    /* `return d` where `d` is a python dict: the callee publishes the triple
     * through the shared dict-result buffer, so record that shape (and the
     * key/value types the caller's own triple has to be declared with). */
    static int cg_ret_dict_scan(const IRNode* a, int* dkf, int* dvf) {
        if (!a) return 0;
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren>0) {
            const IRNode* rc = a->children[0];
            if (d_strcmp(rc->type,"IDENTIFIER")==0 && cg_is_dict(rc->value)) {
                if (dkf) *dkf = cg_dict_kf(rc->value);
                if (dvf) *dvf = cg_dict_vf(rc->value);
                return 1;
            }
        }
        int i = 0;
        while (i < a->nchildren) {
            if (cg_ret_dict_scan(a->children[i], dkf, dvf)) return 1;
            i++;
        }
        return 0;
    }
    /* A CLASS METHOD that returns a list OF STRINGS writes into `drygon_rls`,
     * which has to be declared too (StringIO.readlines, a method splitting). */
    static int cg_method_retstrlist_scan(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CLASS_DEF")==0) {
            int ci = 0;
            while (ci < a->nchildren) {
                const IRNode* b = a->children[ci];
                if (d_strcmp(b->type,"BLOCK")==0) {
                    int i = 0;
                    while (i < b->nchildren) {
                        const IRNode* m = b->children[i];
                        if (d_strcmp(m->type,"FUNCTION_DEF")==0 && m->nchildren>1 &&
                            cg_ret_strlist_of(m->children[1])) return 1;
                        i++;
                    }
                }
                ci++;
            }
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_method_retstrlist_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    static void cg_mrd_add(const char* nm, int vf, int kf);
    /* A CLASS METHOD that builds and returns a python dict publishes the triple
     * through `drygon_rdk and the rdv arrays` -- the same channel a dict-returning module
     * function uses -- so the buffer has to exist (the `any_rd` test at
     * declaration time only saw module-level defs, leaving `drygon_rdk`
     * undeclared and the method writing through an unresolved symbol: that is
     * the DictReader.__next__ SEGV).  Register each such method's shape here so
     * the call sites can bind the result, and return 1 when any exists. */
    static int cg_method_retdict_scan(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CLASS_DEF")==0) {
            int ci = 0;
            while (ci < a->nchildren) {
                const IRNode* b = a->children[ci];
                if (d_strcmp(b->type,"BLOCK")==0) {
                    int i = 0;
                    while (i < b->nchildren) {
                        const IRNode* m = b->children[i];
                        if (d_strcmp(m->type,"FUNCTION_DEF")==0 && m->nchildren>1) {
                            int _dkf = 0;
                            int _dvf = 0;
                            if (cg_ret_dict_scan(m->children[1], &_dkf, &_dvf)) {
                                cg_mrd_add(m->value, _dvf, _dkf);
                                return 1;
                            }
                        }
                        i++;
                    }
                }
                ci++;
            }
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_method_retdict_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    /* Which parameter of `pr` is `nm`, if any. */
    static int cg_pdecl_of(const IRNode* pr, const char* nm) {
        int i = 0;
        if (!pr || !nm || !nm[0]) return -1;
        while (i < pr->nchildren) {
            const IRNode* p = pr->children[i];
            if (p && p->value && d_strcmp(p->value, nm)==0) return i;
            i++;
        }
        return -1;
    }
    /* The shape of one element of a returned tuple (see cg_prog_rshape). */
    static int cg_ret_shape_elem(const IRNode* e, const IRNode* pr) {
        if (!e) return 0;
        if (d_strcmp(e->type,"BLOCK")==0 && d_strcmp(e->value,"LIST")==0) return 1;
        if (d_strcmp(e->type,"IDENTIFIER")!=0 || !e->value || !e->value[0]) return 0;
        int p = cg_pdecl_of(pr, e->value);
        if (p >= 0) {
            const char* dt = pr->children[p]->data_type;
            if (dt && d_strcmp(dt,"DICT")==0)
                return 4 + cg_dict_vf(e->value) * 2 + cg_dict_kf(e->value);
            if (dt && (d_strcmp(dt,"VARGS")==0 || d_strcmp(dt,"LIST")==0)) {
                int lt = cg_lparam_type(e->value);
                if (lt == 2) return 3;
                return lt == 1 ? 2 : 1;
            }
        }
        if (cg_is_dict(e->value))
            return 4 + cg_dict_vf(e->value) * 2 + cg_dict_kf(e->value);
        if (cg_is_lparam(e->value)) {
            int lt = cg_lparam_type(e->value);
            if (lt == 2) return 3;
            return lt == 1 ? 2 : 1;
        }
        if (cg_list_size(e->value) >= 0) return cg_list_is_str(e->value) ? 3 : 1;
        return 0;
    }
    /* Record the element shapes of a function's `return (a, b, ...)` so the
     * callers unpacking that tuple know what to declare (cg_prog_rshape). */
    static void cg_ret_shape_fill(int fi, const IRNode* body, const IRNode* pr) {
        if (fi < 0 || !body) return;
        if (d_strcmp(body->type,"RETURN")==0 && body->nchildren>0 &&
            d_strcmp(body->children[0]->type,"BLOCK")==0 &&
            d_strcmp(body->children[0]->value,"TUPLE")==0) {
            const IRNode* t = body->children[0];
            int k = 0;
            while (k < 8) {
                cg_prog_rshape[fi * 8 + k] =
                    k < t->nchildren ? cg_ret_shape_elem(t->children[k], pr) : 0;
                k++;
            }
            return;
        }
        int i = 0;
        while (i < body->nchildren) { cg_ret_shape_fill(fi, body->children[i], pr); i++; }
    }
    /* A CLASS METHOD that returns a python list is in neither cg_prog_fns nor
     * the generator scan, yet its body writes the same shared result buffer, so
     * the buffer still has to be declared (`StringIO.readlines`). */
    static int cg_method_retlist_scan(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CLASS_DEF")==0) {
            int ci = 0;
            while (ci < a->nchildren) {
                const IRNode* b = a->children[ci];
                if (d_strcmp(b->type,"BLOCK")==0) {
                    int i = 0;
                    while (i < b->nchildren) {
                        const IRNode* m = b->children[i];
                        if (d_strcmp(m->type,"FUNCTION_DEF")==0 && m->nchildren>1 &&
                            cg_ret_list_scan(m->children[1])) return 1;
                        i++;
                    }
                }
                ci++;
            }
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_method_retlist_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    /* The FUNCTION_DEF node of method `mname` in a class body. */
    static const IRNode* cg_cls_method_def(const IRNode* clsbody, const char* mname) {
        if (!clsbody || !mname) return (IRNode*)0;
        int k = 0;
        while (k < clsbody->nchildren) {
            const IRNode* c = clsbody->children[k];
            if (c && d_strcmp(c->type,"FUNCTION_DEF")==0 &&
                d_strcmp(c->value, mname)==0 && c->nchildren > 1) return c;
            k++;
        }
        return (IRNode*)0;
    }
    /* The element type of the list local `nm` as this ONE body builds it: 1 for
     * a list of strings, 0 for anything else, -1 when the body does not say.
     * The whole-program list registry is shared by every same-named local (all
     * names are hoisted to file scope), so `q.append(1)` in `nums` inherited the
     * string element type `q.append("a")` had given its own `q` in `items`, and
     * `for i in bx.nums()` bound char* where an int was needed.  The body text
     * of the function being compiled decides instead. */
    static int cg_body_list_elems3(const IRNode* body, const char* nm, const IRNode* root) {
        if (!body || !nm || !nm[0]) return -1;
        if (d_strcmp(body->type,"CALL")==0 && body->nchildren > 1 &&
            body->children[0] && d_strcmp(body->children[0]->type,"MEMBER_ACCESS")==0 &&
            body->children[0]->value && d_strcmp(body->children[0]->value,"append")==0 &&
            body->children[0]->nchildren > 0 &&
            d_strcmp(body->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(body->children[0]->children[0]->value, nm)==0) {
            const IRNode* ev = body->children[1];
            if (!ev) return -1;
            if (cg_node_is_str_static(ev)) return 1;
            if (d_strcmp(ev->type,"IDENTIFIER")==0 && ev->value &&
                (cg_list_is_str(ev->value) || cg_body_str_local(root, ev->value))) return 1;
            /* `q.append(1)`: a numeric operand settles it as a list of numbers
             * however the shared registry classified the name */
            if (d_strcmp(ev->type,"CONSTANT")==0 &&
                (d_strcmp(ev->data_type,"INT")==0 || d_strcmp(ev->data_type,"FLOAT")==0))
                return 0;
            /* `out.append(cur + self.data[i:i+1])`: csv's `reader.__next__`
             * builds every field by concatenation, and a blanket "BINARY_OP
             * means arithmetic" answer typed the list as int.  The call site
             * then compared raw `char*` pointers against string literals and
             * 50_csv failed from check 2 on.  A `+`/`*` whose operand is a
             * string -- statically, or a local this body assigned from a
             * string expression -- settles it as a list of strings. */
            if (d_strcmp(ev->type,"BINARY_OP")==0) {
                const char* bop = ev->value ? ev->value : "";
                if (d_strcmp(bop,"+")==0 || d_strcmp(bop,"*")==0) {
                    int oi = 0;
                    while (oi < ev->nchildren) {
                        const IRNode* op = ev->children[oi];
                        if (op && d_strcmp(op->type,"IDENTIFIER")==0 && op->value &&
                            (cg_list_is_str(op->value) || cg_body_str_local(root, op->value)))
                            return 1;
                        oi++;
                    }
                }
                return 0;
            }
            return -1;
        }
        if (d_strcmp(body->type,"ASSIGN")==0 && body->nchildren > 1 &&
            body->children[0] && d_strcmp(body->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(body->children[0]->value, nm)==0) {
            const IRNode* rs = body->children[1];
            if (rs && d_strcmp(rs->type,"BLOCK")==0 && rs->nchildren > 0 &&
                (d_strcmp(rs->value,"LIST")==0 || d_strcmp(rs->value,"TUPLE")==0)) {
                int j = 0;
                int all = 1;
                while (j < rs->nchildren) {
                    if (!cg_node_is_str_static(rs->children[j])) all = 0;
                    j++;
                }
                return all;
            }
        }
        int i = 0;
        while (i < body->nchildren) {
            int s = cg_body_list_elems3(body->children[i], nm, root);
            if (s >= 0) return s;
            i++;
        }
        return -1;
    }
    /* The element type of the list local `nm` as this ONE body builds it: 1 for
     * a list of strings, 0 for anything else, -1 when the body does not say.
     * The whole-program list registry is shared by every same-named local (all
     * names are hoisted to file scope), so `q.append(1)` in `nums` inherited the
     * string element type `q.append("a")` had given its own `q` in `items`, and
     * `for i in bx.nums()` bound char* where an int was needed.  The body text
     * of the function being compiled decides instead. */
    static int cg_body_list_elems(const IRNode* body, const char* nm) {
        return cg_body_list_elems3(body, nm, body);
    }
    /* True when a body returns a list OF STRINGS: `return result` where result
     * is a string list (how a function that appends text and returns the list
     * is written), or a literal of string elements.  `root` is the whole body,
     * which decides the element type of a returned local. */
    static int cg_ret_strlist_in(const IRNode* a, const IRNode* root) {
        if (!a) return 0;
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren>0) {
            const IRNode* rc = a->children[0];
            if (d_strcmp(rc->type,"IDENTIFIER")==0 && rc->value && rc->value[0]) {
                int be = cg_body_list_elems(root, rc->value);
                if (be == 1) return 1;
                if (be < 0 && cg_list_is_str(rc->value)) return 1;
            }
            /* the same for a `char**` list parameter handed straight back */
            if (d_strcmp(rc->type,"IDENTIFIER")==0 && cg_is_lparam(rc->value) &&
                cg_lparam_type(rc->value) == 2) return 1;
            if (d_strcmp(rc->type,"BLOCK")==0 && rc->nchildren>0 &&
                (d_strcmp(rc->value,"LIST")==0 || d_strcmp(rc->value,"TUPLE")==0) &&
                cg_node_is_str_static(rc->children[0])) return 1;
        }
        int i = 0;
        while (i < a->nchildren) { if (cg_ret_strlist_in(a->children[i], root)) return 1; i++; }
        return 0;
    }
    static int cg_ret_strlist_of(const IRNode* a) {
        return cg_ret_strlist_in(a, a);
    }
    /* A function body that returns a locally built list of strings is published
     * through `drygon_rls`, but the local array itself is declared from
     * `cg_list_is_str`, which cannot see a list whose elements arrived from a
     * call (`rows.append(push(...))` -- the callee's string return is only known
     * later).  Force the very names the body returns to be string lists so the
     * declaration matches the buffer they are copied into (`char* rows[64]`
     * instead of `int rows[64]`, which truncated every element pointer). */
    static void cg_mark_retlist_str(const IRNode* body) {
        if (!body) return;
        if (d_strcmp(body->type,"RETURN")==0 && body->nchildren > 0) {
            const IRNode* rc = body->children[0];
            if (rc && d_strcmp(rc->type,"IDENTIFIER")==0 && rc->value && rc->value[0]) {
                cg_note_list(rc->value, 512, 2);
                cg_note_strlist(rc->value);
            }
        }
        int i = 0;
        while (i < body->nchildren) { cg_mark_retlist_str(body->children[i]); i++; }
    }
    /* Does `body` build a python list in this local name?  Method bodies are
     * scanned for their return type BEFORE the body is emitted, so the
     * list-ness of a local (`q = []` / `q.append(...)`) is not yet in
     * `cg_list_size` when `cg_ret_list_scan` asks.  Look at the body text. */
    static int cg_body_list_local(const IRNode* body, const char* nm) {
        if (!body || !nm) return 0;
        if (d_strcmp(body->type,"ASSIGN")==0 && body->nchildren > 1 &&
            body->children[0] && d_strcmp(body->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(body->children[0]->value, nm)==0) {
            const IRNode* rs = body->children[1];
            if (rs && cg_is_list_node(rs)) return 1;
            if (rs && d_strcmp(rs->type,"CALL")==0 && rs->value &&
                (d_strcmp(rs->value,"list")==0 || d_strcmp(rs->value,"sorted")==0 ||
                 d_strcmp(rs->value,"tuple")==0)) return 1;
            if (rs && d_strcmp(rs->type,"IDENTIFIER")==0 && cg_is_dyn_list(rs->value))
                return 1;
        }
        /* `nm.append(...)` proves nm is a list as well */
        if (d_strcmp(body->type,"METHOD_CALL")==0 && body->value &&
            d_strcmp(body->value,"append")==0 && body->nchildren > 0 &&
            body->children[0] && body->children[0]->value &&
            d_strcmp(body->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(body->children[0]->value, nm)==0) return 1;
        int i = 0;
        while (i < body->nchildren) {
            if (cg_body_list_local(body->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    /* `return <name>` inside `body` where `<name>` is a list built in that same
     * body.  `cg_ret_list_scan` cannot see it (the local is not registered as a
     * list until the body is emitted), so a method that assembles a list and
     * hands it back stayed `int` and truncated the pointer. */
    static int cg_ret_name_list_scan(const IRNode* a, const IRNode* body) {
        if (!a || !body) return 0;
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren > 0) {
            const IRNode* rc = a->children[0];
            if (rc && d_strcmp(rc->type,"IDENTIFIER")==0 &&
                cg_body_list_local(body, rc->value)) return 1;
        }
        int i = 0;
        while (i < a->nchildren) {
            if (cg_ret_name_list_scan(a->children[i], body)) return 1;
            i++;
        }
        return 0;
    }
    /* Methods that build and return a python list, by BARE method name.  The
     * class emitter records them while it writes each definition; a call site
     * (`c = bx.get()`) cannot resolve `bx` to its class here (only parameters
     * are tracked), so it consults this table instead of leaving the returned
     * array pointer truncated into an int (24_collections `od.keys()`,
     * 50_csv `reader.__next__()`). */
    /* Methods that build and return a python DICT, by BARE method name, with
     * the key/value element shapes of their result.  `cg_prog_retdict` covers
     * module-level defs only, so `x = recv.m()` left the caller reading the
     * dummy `0` return word while the method had published its triple through
     * `drygon_rdk and the rdv arrays`: `len(x)` and `x["k"]` then indexed address 0.
     * `csv.DictReader.__next__` is exactly this shape (50_csv 10-13). */
    static char cg_mrd_names[64*32];
    static char cg_mrd_cls[64*32];
    static char cg_mrd_vf[64];
    static char cg_mrd_kf[64];
    static int cg_nmrd;
    static void cg_mrd_add(const char* nm, int vf, int kf) {
        if (!nm || !nm[0] || cg_nmrd >= 64) return;
        int i = 0;
        while (i < cg_nmrd) {
            if (d_strcmp(cg_mrd_names + i*32, nm)==0) return;
            i++;
        }
        d_strncpy(cg_mrd_names + cg_nmrd*32, nm, 31);
        cg_mrd_names[cg_nmrd*32 + 31] = 0;
        cg_mrd_vf[cg_nmrd] = (char)vf;
        cg_mrd_kf[cg_nmrd] = (char)kf;
        cg_mrd_cls[cg_nmrd*32] = 0;
        cg_nmrd = cg_nmrd + 1;
    }
    static void cg_mrd_addc(const char* cls, const char* nm, int vf, int kf) {
        if (!cls || !cls[0] || !nm || !nm[0] || cg_nmrd >= 64) return;
        int i = 0;
        while (i < cg_nmrd) {
            if (d_strcmp(cg_mrd_names + i*32, nm)==0 &&
                d_strcmp(cg_mrd_cls + i*32, cls)==0) return;
            i++;
        }
        d_strncpy(cg_mrd_names + cg_nmrd*32, nm, 31);
        cg_mrd_names[cg_nmrd*32 + 31] = 0;
        d_strncpy(cg_mrd_cls + cg_nmrd*32, cls, 31);
        cg_mrd_cls[cg_nmrd*32 + 31] = 0;
        cg_mrd_vf[cg_nmrd] = (char)vf;
        cg_mrd_kf[cg_nmrd] = (char)kf;
        cg_nmrd = cg_nmrd + 1;
    }
    static int cg_mrd_findc(const char* cls, const char* nm) {
        if (!cls || !cls[0] || !nm || !nm[0]) return -1;
        int i = 0;
        while (i < cg_nmrd) {
            if (d_strcmp(cg_mrd_names + i*32, nm)==0 &&
                d_strcmp(cg_mrd_cls + i*32, cls)==0) return i;
            i++;
        }
        return -1;
    }
    static int cg_mrd_find(const char* nm) {
        if (!nm || !nm[0]) return -1;
        int i = 0;
        while (i < cg_nmrd) {
            if (d_strcmp(cg_mrd_names + i*32, nm)==0) return i;
            i++;
        }
        return -1;
    }
    static char cg_mrl_names[64*32];
    static char cg_mrl_sls[64];
    static int cg_nmrl;
    static void cg_mrl_add(const char* nm, int sls) {
        if (!nm || !nm[0] || cg_nmrl >= 64) return;
        int i = 0;
        while (i < cg_nmrl) {
            if (d_strcmp(cg_mrl_names + i*32, nm)==0) return;
            i++;
        }
        d_strncpy(cg_mrl_names + cg_nmrl*32, nm, 31);
        cg_mrl_names[cg_nmrl*32 + 31] = 0;
        cg_mrl_sls[cg_nmrl] = (char)sls;
        cg_nmrl = cg_nmrl + 1;
    }
    static int cg_mrl_find(const char* nm) {
        if (!nm || !nm[0]) return -1;
        int i = 0;
        while (i < cg_nmrl) {
            if (d_strcmp(cg_mrl_names + i*32, nm)==0) return i;
            i++;
        }
        return -1;
    }
    /* The list element kind is a property of the RECEIVER CLASS, not of the
     * method name: csv.reader.__next__ hands back field strings while nearly
     * every other __next__ hands back numbers, and `CountDown.__next__` hands
     * back numbers too.  The bare table above keeps whichever class happened
     * to be scanned first and therefore mis-types the others, so remember the
     * class alongside the name. */
    static char cg_mrl_cls[64*32];
    static char cg_mrl_slsc[64];
    static int cg_nmrlc;
    static void cg_mrl_addc(const char* cls, const char* nm, int sls) {
        if (!cls || !cls[0] || !nm || !nm[0] || cg_nmrlc >= 64) return;
        int i = 0;
        while (i < cg_nmrlc) {
            if (d_strcmp(cg_mrl_cls + i*32, cls)==0 && d_strcmp(cg_mrl_names + i*32, nm)==0) {
                if (sls) cg_mrl_slsc[i] = 1;
                return;
            }
            i++;
        }
        d_strncpy(cg_mrl_cls + cg_nmrlc*32, cls, 31);
        cg_mrl_cls[cg_nmrlc*32 + 31] = 0;
        d_strncpy(cg_mrl_names + cg_nmrlc*32, nm, 31);
        cg_mrl_names[cg_nmrlc*32 + 31] = 0;
        cg_mrl_slsc[cg_nmrlc] = (char)(sls ? 1 : 0);
        cg_nmrlc = cg_nmrlc + 1;
    }
    static int cg_mrl_findc(const char* cls, const char* nm) {
        if (!cls || !cls[0] || !nm || !nm[0]) return -1;
        int i = 0;
        while (i < cg_nmrlc) {
            if (d_strcmp(cg_mrl_cls + i*32, cls)==0 && d_strcmp(cg_mrl_names + i*32, nm)==0) return i;
            i++;
        }
        return -1;
    }
    /* Methods that return a `char*`, by bare name.  Filled while each class
     * body is emitted (from the same inferred return kind the prototype uses),
     * because a call site inside another method -- `levelname = self.name_of(lv)`
     * -- cannot resolve `self` to a class at declaration time.  Without this the
     * local was declared `int` and the string pointer was truncated, so
     * `logging`'s level name reached the handler as garbage and SEGV'd. */
    static char cg_mrs_names[256*32];
    static int cg_nmrs;
    static void cg_mrs_add(const char* nm) {
        if (!nm || !nm[0] || cg_nmrs >= 256) return;
        int i = 0;
        while (i < cg_nmrs) {
            if (d_strcmp(cg_mrs_names + i*32, nm)==0) return;
            i++;
        }
        d_strncpy(cg_mrs_names + cg_nmrs*32, nm, 31);
        cg_mrs_names[cg_nmrs*32 + 31] = 0;
        cg_nmrs = cg_nmrs + 1;
    }
    static int cg_mrs_find(const char* nm) {
        if (!nm || !nm[0]) return -1;
        int i = 0;
        while (i < cg_nmrs) {
            if (d_strcmp(cg_mrs_names + i*32, nm)==0) return i;
            i++;
        }
        return -1;
    }
    /* A call that hands back a string: `self.name_of(lv)`, `obj.getvalue()`, or
     * a plain `name_of(lv)` naming one of those methods. */
    static int cg_mrs_call(const IRNode* r) {
        if (!r || d_strcmp(r->type,"CALL")!=0) return 0;
        if (d_strcmp(r->value,"COMPLEX")==0) {
            if (r->nchildren<1 || !r->children[0]) return 0;
            if (d_strcmp(r->children[0]->type,"MEMBER_ACCESS")==0)
                return cg_mrs_find(r->children[0]->value) >= 0;
            return 0;
        }
        return cg_mrs_find(r->value) >= 0;
    }
    /* `recv.m(...)`: does the method body hand back a python list?  Methods
     * never live in the `cg_prog_*` tables, so a call site could not tell that
     * `od.keys()` or `reader.__next__()` yields an array: the pointer was
     * truncated into an int (24_collections, 50_csv).  Resolve the receiver's
     * class from its declared type and inspect the method body. */
    static const char* cg_call_recv_cls(const IRNode* recv) {
        if (!recv) return "";
        if (d_strcmp(recv->type,"IDENTIFIER")==0) return cg_lf_recv_cls(recv);
        /* a computed receiver: `(sub / "deep.txt").write_text(...)`,
         * `Path(".").absolute().is_absolute()`.  Only consulted when the
         * receiver is neither a name nor an attribute chain, so the existing
         * resolutions are untouched (23_pathlib). */
        if (d_strcmp(recv->type,"MEMBER_ACCESS")!=0) {
            const char* bc = cg_expr_obj_class(recv);
            if (bc && bc[0]) return bc;
        }
        if (d_strcmp(recv->type,"MEMBER_ACCESS")==0 && recv->nchildren > 0) {
            const char* oc = cg_lf_recv_cls(recv->children[0]);
            if (!oc || !oc[0] || !recv->value) return "";
            const char* ft = cg_of_get(oc, recv->value);
            return ft ? ft : "";
        }
        return "";
    }
    /* A method reached through a receiver whose class is known resolves against
     * that class' own registration only: `self._r.__next__()` is csv.reader's
     * list-returning method, not DictReader's dict-returning one, and the bare
     * name table could not tell them apart (50_csv). */
    static int cg_mrd_lookup(const IRNode* recv, const char* m) {
        if (!m || !m[0]) return -1;
        const char* rc = cg_call_recv_cls(recv);
        int amb = (cg_mrl_find(m) >= 0);
        if (rc && rc[0]) {
            int i = cg_mrd_findc(rc, m);
            if (i >= 0) return i;
            return amb ? -1 : cg_mrd_find(m);
        }
        if (amb) return -1;
        return cg_mrd_find(m);
    }
    /* The method NAME of a call node.  A plain `f(...)` carries it in `value`;
     * `recv.m(...)` is value "COMPLEX" with the name in the MEMBER_ACCESS child
     * (50_csv: every method call site above tests the wrong slot without this). */
    static const char* cg_mcx_meth(const IRNode* call) {
        if (!call || !call->value) return 0;
        if (d_strcmp(call->value,"COMPLEX")==0 && call->nchildren > 0 && call->children[0] &&
            d_strcmp(call->children[0]->type,"MEMBER_ACCESS")==0)
            return call->children[0]->value;
        return call->value;
    }
    /* The RECEIVER node of a method call, 0 for a plain function call. */
    static const IRNode* cg_mcx_recv(const IRNode* call) {
        if (!call || !call->value || call->nchildren < 1 || !call->children[0]) return 0;
        if (d_strcmp(call->value,"COMPLEX")!=0) return 0;
        if (d_strcmp(call->children[0]->type,"MEMBER_ACCESS")!=0) return 0;
        if (call->children[0]->nchildren < 1) return 0;
        return call->children[0]->children[0];
    }
    static int cg_mcall_ret_list(const IRNode* call, int* sls) {
        if (sls) *sls = 0;
        if (!call || !call->value || call->nchildren < 1) return 0;
        const char* _mnm = cg_mcx_meth(call);
        if (!_mnm || !_mnm[0]) return 0;
        /* `d.keys()` / `d.values()` on a plain python DICT variable: the view is
         * the dict's own parallel arrays, so the call publishes a list.  The
         * generic path below only knows class methods, so `ks = d.keys()` stayed
         * a scalar and the raw call trapped (24_collections, 46_weakref). */
        {
            const IRNode* _dvrc = cg_mcx_recv(call);
            if (_dvrc && d_strcmp(_dvrc->type,"IDENTIFIER")==0 && _dvrc->value &&
                _dvrc->value[0] && cg_is_dict(_dvrc->value)) {
                if (d_strcmp(_mnm,"keys")==0) {
                    if (sls) *sls = cg_dict_kf(_dvrc->value) ? 1 : 0;
                    return 1;
                }
                if (d_strcmp(_mnm,"values")==0) {
                    if (sls) *sls = (cg_dict_vf(_dvrc->value) == 2) ? 1 : 0;
                    return 1;
                }
                return 0;
            }
        }
        /* a dict-returning method publishes a triple through the shared dict
         * buffer, never an element array (DictReader.__next__) */
        const char* _mrc = cg_call_recv_cls(cg_mcx_recv(call));
        if (_mrc && _mrc[0]) {
            if (cg_mrd_findc(_mrc, _mnm) >= 0) return 0;
            if (cg_mrl_find(_mnm) < 0) return 0;
        } else {
            int _amb = (cg_mrl_find(_mnm) >= 0);
            if (!_amb && cg_mrd_find(_mnm) >= 0) return 0;
        }
        int mi = cg_mrl_find(_mnm);
        if (mi < 0) return 0;
        if (sls) {
            int mc = (_mrc && _mrc[0]) ? cg_mrl_findc(_mrc, _mnm) : -1;
            *sls = (mc >= 0) ? (cg_mrl_slsc[mc] ? 1 : 0) : cg_mrl_sls[mi];
        }
        return 1;
    }
    /* Does a call NODE hand back a python list, and does it hold strings?
     * `f()` is answered from the program tables, `recv.m()` -- including
     * `self._r.__next__()`, whose receiver is an instance FIELD and therefore
     * has no variable class -- from the method registry.  Both callers that
     * type a destination from a call result need the same two answers, so they
     * share these instead of testing `value` against "COMPLEX" each time. */
    static int cg_call_yields_list(const IRNode* call) {
        if (!call || !call->type || !call->value) return 0;
        if (d_strcmp(call->type,"CALL")!=0) return 0;
        if (d_strcmp(call->value,"COMPLEX")==0) {
            int yls = 0;
            return cg_mcall_ret_list(call, &yls);
        }
        return cg_fn_is_list(call->value);
    }
    static int cg_call_yields_strlist(const IRNode* call) {
        if (!call || !call->type || !call->value) return 0;
        if (d_strcmp(call->type,"CALL")!=0) return 0;
        if (d_strcmp(call->value,"COMPLEX")==0) {
            int yls = 0;
            cg_mcall_ret_list(call, &yls);
            return yls;
        }
        return cg_fn_ret_strlist(call->value);
    }
    /* --- the shape of a method's return value, known from the SOURCE -------
     * `cg_mrl_*` / `cg_mrd_*` are filled while a class body is EMITTED, which
     * is far too late for the pre-passes that type variables: `self.fieldnames
     * = self._r.__next__()` stayed an `int` array and `r = self._r.__next__()`
     * an `int` list, so the csv row dict `d[self.fieldnames[i]] = r[i]` lowered
     * to `drygon_dset_ii` and every `rows[0]["name"]` read something that was
     * never a `char*` (50_csv checks 10-13).  Walking the class bodies here,
     * before the list and dict passes, publishes the same shapes from the
     * source so those passes can finally see them. */
    static const IRNode* cg_cls_body_of(const IRNode* a) {
        if (!a) return NULL;
        if (a->nchildren>1 && a->children[a->nchildren-1] &&
            d_strcmp(a->children[a->nchildren-1]->type,"BLOCK")==0)
            return a->children[a->nchildren-1];
        int i = 0;
        while (i < a->nchildren) {
            if (a->children[i] && d_strcmp(a->children[i]->type,"BLOCK")==0) return a->children[i];
            i++;
        }
        return NULL;
    }
    static void cg_scan_meth_shapes(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0) {
            const IRNode* body = cg_cls_body_of(a);
            if (body) {
                int i = 0;
                while (i < body->nchildren) {
                    const IRNode* m = body->children[i];
                    if (m && d_strcmp(m->type,"FUNCTION_DEF")==0 && m->value) {
                        const IRNode* mb = cg_cls_body_of(m);
                        int dkf = 0;
                        int dvf = 0;
                        int isdict = mb && cg_ret_dict_scan(mb, &dkf, &dvf);
                        if (isdict) {
                            cg_mrd_add(m->value, dvf, dkf);
                            cg_mrd_addc(a->value, m->value, dvf, dkf);
                        } else if (mb && (cg_ret_list_scan(mb) || cg_ret_name_list_scan(mb, mb))) {
                            int _sls = cg_ret_strlist_of(mb) ? 1 : 0;
                            cg_mrl_add(m->value, _sls);
                            cg_mrl_addc(a->value, m->value, _sls);
                        }
                    }
                    i++;
                }
                /* a class nested in the body registers its methods too */
                cg_scan_meth_shapes(body);
            }
            return;
        }
        int j = 0;
        while (j < a->nchildren) { cg_scan_meth_shapes(a->children[j]); j++; }
    }
    /* Fields that hold a `char*` (`self.fieldnames`, `self.restval`), and the
     * elements of such a field: the row dict is keyed by `self.fieldnames[i]`,
     * so both have to be known before the dict pass types it. */
    static char cg_sfld_names[256*32];
    static int  cg_nsfld;
    static int cg_is_str_field(const char* f) {
        if (!f || !f[0]) return 0;
        int i = 0;
        while (i < cg_nsfld) {
            if (d_strcmp(cg_sfld_names + i*32, f)==0) return 1;
            i++;
        }
        return 0;
    }
    static void cg_sfld_note(const char* f) {
        if (!f || !f[0] || cg_nsfld >= 256 || cg_is_str_field(f)) return;
        d_strncpy(cg_sfld_names + cg_nsfld*32, f, 31);
        cg_sfld_names[cg_nsfld*32 + 31] = 0;
        cg_nsfld = cg_nsfld + 1;
    }
    static int cg_member_is_str(const IRNode* n) {
        if (!n || !n->value) return 0;
        if (d_strcmp(n->type,"MEMBER_ACCESS")!=0) return 0;
        return cg_is_str_field(n->value);
    }
    /* Candidate field names of the class body being inspected: every
     * `self.f = ...`.  A right-hand side that is definitely a string -- a
     * literal, a `""`-defaulted parameter, a slice, a native string call, or a
     * method handing back a list of strings (`self.fieldnames =
     * self._r.__next__()`) -- makes the field itself a `char*`. */
    static int cg_sf_str_rhs(const IRNode* r) {
        if (!r) return 0;
        if (cg_node_is_str_static(r)) return 1;
        if (cg_is_str_call_node(r)) return 1;
        if (d_strcmp(r->data_type,"STR")==0 || d_strcmp(r->data_type,"FSTR")==0) return 1;
        if (d_strcmp(r->type,"IDENTIFIER")==0 && cg_is_strdef_param(r->value)) return 1;
        return 0;
    }
    static void cg_sf_walk(const IRNode* body) {
        if (!body) return;
        if (d_strcmp(body->type,"CLASS_DEF")==0) return;
        if (d_strcmp(body->type,"ASSIGN")==0 && body->nchildren>1 && body->children[0] &&
            d_strcmp(body->children[0]->type,"MEMBER_ACCESS")==0 &&
            body->children[0]->nchildren>0 && body->children[0]->children[0] &&
            d_strcmp(body->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(body->children[0]->children[0]->value,"self")==0) {
            if (cg_sf_str_rhs(body->children[1])) cg_sfld_note(body->children[0]->value);
        }
        int i = 0;
        while (i < body->nchildren) { cg_sf_walk(body->children[i]); i++; }
    }
    static void cg_scan_str_fields(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0) {
            const IRNode* cb = cg_cls_body_of(a);
            if (cb) {
                cg_sf_walk(cb);
                cg_scan_str_fields(cb);
            }
            return;
        }
        int j = 0;
        while (j < a->nchildren) { cg_scan_str_fields(a->children[j]); j++; }
    }
    /* True when a body contains `return <expr>`.  A bare `def` carries no
     * return annotation, so the emitter used to declare every such function
     * `void` even though the body yields a value: callers then read whatever
     * garbage happened to be in x0.  String/list/float returns have their own
     * scans; this is the int fallback. */
    static int cg_ret_value_scan(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"RETURN")==0 && a->nchildren>0) return 1;
        int i = 0;
        while (i < a->nchildren) { if (cg_ret_value_scan(a->children[i])) return 1; i++; }
        return 0;
    }
    /* Class names, collected BEFORE anything is emitted: the emission-time
     * registry (`cg_cls_names`) is only filled while class bodies are
     * generated, which happens after the call-site scan that types the
     * parameters. */
    static char cg_scls_names[4096];
    static int cg_scls_n;
    static void cg_scls_note(const char* nm) {
        if (!nm || !nm[0]) return;
        int i = 0;
        while (i < cg_scls_n) {
            if (d_strcmp(cg_scls_names + i*32, nm)==0) return;
            i++;
        }
        if (cg_scls_n >= 128) return;
        d_strncpy(cg_scls_names + cg_scls_n*32, nm, 31);
        cg_scls_names[cg_scls_n*32 + 31] = 0;
        cg_scls_n = cg_scls_n + 1;
    }
    static int cg_is_class_scan(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_scls_n) {
            if (d_strcmp(cg_scls_names + i*32, nm)==0) return 1;
            i++;
        }
        return 0;
    }
    static void cg_scan_cls_names(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0) cg_scls_note(a->value);
        int i = 0;
        while (i < a->nchildren) { cg_scan_cls_names(a->children[i]); i++; }
    }
    /* Class names that define an `__init__`, collected before anything is
     * emitted: a method whose whole body is `return Other(...)` hands back
     * that struct by value, and the check has to work even when Other is
     * emitted after the method's own class (`datetime.date()` -> `date`). */
    static char cg_sinit_names[4096];
    static int cg_sinit_n;
    static void cg_sinit_note(const char* nm) {
        if (!nm || !nm[0]) return;
        int i = 0;
        while (i < cg_sinit_n) {
            if (d_strcmp(cg_sinit_names + i*32, nm)==0) return;
            i++;
        }
        if (cg_sinit_n >= 128) return;
        d_strncpy(cg_sinit_names + cg_sinit_n*32, nm, 31);
        cg_sinit_names[cg_sinit_n*32 + 31] = 0;
        cg_sinit_n = cg_sinit_n + 1;
    }
    static int cg_cls_hasinit_scan(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_sinit_n) {
            if (d_strcmp(cg_sinit_names + i*32, nm)==0) return 1;
            i++;
        }
        return 0;
    }
    static void cg_scan_init_names(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->nchildren>0 && a->children[0]) {
            const IRNode* body = a->children[0];
            int bi = 0;
            while (bi < body->nchildren) {
                const IRNode* m = body->children[bi];
                if (m && d_strcmp(m->type,"FUNCTION_DEF")==0 &&
                    d_strcmp(m->value,"__init__")==0) { cg_sinit_note(a->value); break; }
                bi++;
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_init_names(a->children[i]); i++; }
    }
    static const char* cg_mret_cls(const char* cls, const char* meth);
    /* Which class an expression hands back, for the rich-comparison lowering.
     * 0 = not an instance, 1 = a NAME of one, 2 = a constructor call,
     * 3 = a method call whose method returns a struct by value
     * (`dt.date()` -> `date`, 28_datetime). */
    static int cg_cmp_operand(const IRNode* e, const char** cls) {
        *cls = (const char*)0;
        if (!e) return 0;
        if (d_strcmp(e->type,"IDENTIFIER")==0) {
            const char* c = cg_cvar_class(e->value);
            if (c && c[0]) { *cls = c; return 1; }
            return 0;
        }
        /* `p.parent` / `p.with_suffix(".md")` where the class method hands back
         * an instance of a class: the read is a method call, so it lowers like
         * one and the comparison can find `__eq__` on the returned class
         * (23_pathlib `p4.parent == Path("/a/b")`). */
        if (d_strcmp(e->type,"MEMBER_ACCESS")==0) {
            const char* rc = 0;
            if (e->nchildren > 0 && e->children[0]) rc = cg_expr_obj_class(e->children[0]);
            if (!rc || !rc[0]) return 0;
            const char* mc = cg_mret_cls(rc, e->value);
            if (mc && mc[0]) { *cls = mc; return 3; }
            return 0;
        }
        if (d_strcmp(e->type,"CALL")!=0) return 0;
        if (e->value && e->value[0] && cg_is_class_scan(e->value)) {
            *cls = e->value;
            return 2;
        }
        if (e->value && d_strcmp(e->value,"COMPLEX")==0 && e->nchildren>0 &&
            e->children[0] && d_strcmp(e->children[0]->type,"MEMBER_ACCESS")==0) {
            const IRNode* mb = e->children[0];
            if (mb->nchildren<1 || !mb->children[0]) return 0;
            const IRNode* base = mb->children[0];
            if (d_strcmp(base->type,"IDENTIFIER")!=0) return 0;
            const char* ocls = cg_is_class_scan(base->value) ? base->value
                                                             : cg_cvar_class(base->value);
            if (!ocls || !ocls[0]) return 0;
            int ci = cg_cls_index(cg_cls_find_m(ocls, mb->value)
                                  ? cg_cls_find_m(ocls, mb->value) : ocls);
            if (ci < 0) return 0;
            int j = 0;
            while (j < cg_cls_nmeth[ci]) {
                if (d_strcmp(cg_cls_methnames[ci*48 + j], mb->value)==0) {
                    if (cg_cls_mret[ci][j] == 4) {
                        const char* rcl = cg_cls_mret_cls[ci*48 + j];
                        if (rcl && rcl[0]) { *cls = rcl; return 3; }
                    }
                    return 0;
                }
                j++;
            }
        }
        return 0;
    }
    /* The class returned by method `meth` of `cls`, when it returns an object of
     * a named class (`Path.with_suffix -> Path`).  `cg_cls_mret == 4` is the
     * "returns an instance of class X" marker the class emitter records. */
    static const char* cg_mret_cls(const char* cls, const char* meth) {
        if (!cls || !cls[0] || !meth || !meth[0]) return 0;
        const char* m = cg_cls_find_m(cls, meth);
        if (!m) return 0;
        int ci = cg_cls_index(m);
        if (ci < 0) return 0;
        int j = 0;
        while (j < cg_cls_nmeth[ci]) {
            if (d_strcmp(cg_cls_methnames[ci*48 + j], meth)==0) {
                if (cg_cls_mret[ci][j] == 4) {
                    const char* rcl = cg_cls_mret_cls[ci*48 + j];
                    if (rcl && rcl[0]) return rcl;
                }
                return 0;
            }
            j++;
        }
        return 0;
    }
    /* The class of an EXPRESSION that yields an instance, if it is knowable
     * without flow analysis: a name already known to hold an instance, a class
     * constructor, a method call whose return class is recorded, or an operator
     * that a class implements (`base / "sub"`).  pathlib chains all four
     * (`sub = Path(d) / "sub"; sub.mkdir()`), and an unknown receiver made the
     * method call go through an integer and trap. */
    static const char* cg_expr_obj_class(const IRNode* e) {
        if (!e) return 0;
        if (d_strcmp(e->type,"IDENTIFIER")==0) {
            const char* c = cg_ov_class(e->value);
            if (c && c[0]) return c;
            c = cg_cvar_class(e->value);
            if (c && c[0]) return c;
            return 0;
        }
        if (d_strcmp(e->type,"CALL")==0) {
            if (e->value && e->value[0] && d_strcmp(e->value,"COMPLEX")!=0 &&
                cg_is_class_scan(e->value)) return e->value;
            /* `p.m(args)` is CALL("COMPLEX", [MEMBER_ACCESS(m, [base]), args..]) */
            if (e->value && d_strcmp(e->value,"COMPLEX")==0 && e->nchildren>0 &&
                e->children[0] && d_strcmp(e->children[0]->type,"MEMBER_ACCESS")==0) {
                const IRNode* mb = e->children[0];
                if (mb->nchildren<1 || !mb->children[0]) return 0;
                const char* base = cg_expr_obj_class(mb->children[0]);
                if (!base || !base[0]) return 0;
                return cg_mret_cls(base, mb->value);
            }
            return 0;
        }
        if (d_strcmp(e->type,"BINARY_OP")==0 && e->nchildren>=2 && e->value) {
            const char* dm = 0;
            if (d_strcmp(e->value,"/")==0) dm = "__truediv__";
            else if (d_strcmp(e->value,"+")==0) dm = "__add__";
            else if (d_strcmp(e->value,"-")==0) dm = "__sub__";
            else if (d_strcmp(e->value,"*")==0) dm = "__mul__";
            else if (d_strcmp(e->value,"%")==0) dm = "__mod__";
            if (!dm) return 0;
            const char* lc = cg_expr_obj_class(e->children[0]);
            if (!lc || !lc[0]) return 0;
            return cg_mret_cls(lc, dm);
        }
        return 0;
    }
    /* The recorded return kind of `recv.meth`: 1 void/bool, 2 string,
     * 3 double, 4 int or instance.  -1 when neither the receiver's class nor
     * the method is knowable.  `@property` getters are registered exactly like
     * plain methods, so `obj.name` answers here too -- which is how a property
     * read becomes the getter call and gets typed as a string. */
    static int cg_mret_kind_of(const IRNode* recv, const char* meth) {
        if (!meth || !meth[0]) return -1;
        const char* rc = cg_expr_obj_class(recv);
        if (!rc || !rc[0]) return -1;
        const char* m = cg_cls_find_m(rc, meth);
        if (!m) return -1;
        int ci = cg_cls_index(m);
        if (ci < 0) return -1;
        int j = 0;
        while (j < cg_cls_nmeth[ci]) {
            if (d_strcmp(cg_cls_methnames[ci*48 + j], meth)==0) return cg_cls_mret[ci][j];
            j++;
        }
        return -1;
    }
    /* A list or tuple literal (`[a, b]` / `(a, b)`), as the parser builds it. */
    static int cg_is_list_literal(const IRNode* a) {
        return a && d_strcmp(a->type,"BLOCK")==0 && a->value &&
               (d_strcmp(a->value,"LIST")==0 || d_strcmp(a->value,"TUPLE")==0);
    }
    /* An expression that hands back a list of STRINGS: a str-list-returning
     * method call, or a `@property` getter whose body was recorded as building
     * one (`p.parts`, `p.suffixes` in pathlib).  Both publish their elements in
     * the shared str-list buffer, so `x == [..]` has to compare elementwise
     * instead of comparing two addresses. */
    static int cg_list_expr_is_sl(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CALL")==0) {
            int sls = 0;
            return cg_mcall_ret_list(a, &sls) && sls == 1;
        }
        if (d_strcmp(a->type,"MEMBER_ACCESS")==0 && a->value) {
            int mi = cg_mrl_find(a->value);
            return mi >= 0 && cg_mrl_sls[mi] == 1;
        }
        return 0;
    }
    /* `x = Cls(...)`, and `y = x` where x is already known to be an instance. */
    static void cg_scan_objvars(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1 &&
            a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0) {
            const IRNode* rhs = a->children[1];
            if (rhs && d_strcmp(rhs->type,"CALL")==0 && rhs->value && rhs->value[0] &&
                d_strcmp(rhs->value,"COMPLEX")!=0 && cg_is_class_scan(rhs->value))
                cg_ov_note(a->children[0]->value, rhs->value);
            else if (rhs && d_strcmp(rhs->type,"IDENTIFIER")==0) {
                const char* ac = cg_ov_class(rhs->value);
                if (ac) cg_ov_note(a->children[0]->value, ac);
            }
            else {
                /* A name bound to the RESULT of a method call or of an operator
                 * a class defines is an instance of the RETURN class, not an
                 * opaque value. */
                const char* oc = cg_expr_obj_class(rhs);
                if (oc && oc[0]) cg_ov_note(a->children[0]->value, oc);
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_objvars(a->children[i]); i++; }
    }
    /* Mark every parameter that a call site fills with a string. */
    static void cg_scan_calls(const IRNode* a, const char* fname, int fi) {
        if (!a) return;
        /* a call inside a function body is typed with that function's names */
        if (d_strcmp(a->type,"FUNCTION_DEF")==0) {
            cg_scope_enter(a);
            int ic = 0;
            while (ic < a->nchildren) { cg_scan_calls(a->children[ic], fname, fi); ic++; }
            cg_scope_exit();
            return;
        }
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,fname)==0) {
            int i = 0;
            int mk = 0;
            while (i < a->nchildren && i < 8) {
                    /* An argument that is a python OBJECT makes the parameter a
                     * `Cls*`: `f(Point(0, 0))`, `f(mod.Point(...))`, `f(p)`.  It
                     * is never a `char*`, so the string note is skipped. */
                    const char* ioc = cg_arg_obj_class(a->children[i]);
                    if (ioc) cg_note_pcls(fi, i, ioc);
                    /* A list argument is a pointer plus a count, never a char* */
                    else if ((cg_node_is_str_static(a->children[i]) &&
                         !cg_static_is_listnode(a->children[i])) ||
                        (a->children[i] &&
                         d_strcmp(a->children[i]->type,"IDENTIFIER")==0 &&
                         cg_is_strdef_param(a->children[i]->value))) {
                        if (!cg_prog_pstr[fi * 8 + i]) cg_pstr_changed = 1;
                        cg_prog_pstr[fi * 8 + i] = 1;
                        cg_prog_variant[fi] = 1;
                        mk = mk | (1 << i);
                    }
                    i++;
                }
            if (cg_call_find(a) < 0) cg_note_mask(fi, mk);
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_calls(a->children[i], fname, fi); i++; }
    }

    /* A subclass constructor that hands its base a string literal --
     * `super().__init__("Circle")` -- makes the inherited parameter a `char*`.
     * Methods are not registered as program functions, so nothing else types
     * them: `Shape.__init__(Shape* self, int name)` stored a truncated pointer
     * and `"Shape: " + self.name` concatenated garbage (12_classes check 14).
     * Remember `class` -> parameter position for the class emitting pass. */
    static char cg_cps_cls[4096]; /* 64 classes x 64 bytes */
    static char cg_cps_meth[4096];
    static int cg_cps_pos[64];
    static int cg_ncps;
    /* Keyed by METHOD as well as class: the position was previously counted
     * across the whole class, so `Cls("x")` marked slot 0 and every method of
     * Cls whose first parameter is not a string got `char*` -- P.__truediv__
     * took a `char* o` and `o.s` read the instance struct as a string. */
    static void cg_cps_note(const char* cls, const char* meth, int pos) {
        if (!cls || !cls[0] || !meth || !meth[0]) return;
        int i = 0;
        while (i < cg_ncps) {
            if (cg_cps_pos[i] == pos && d_strcmp(cg_cps_cls + i*64, cls) == 0 &&
                d_strcmp(cg_cps_meth + i*64, meth) == 0) return;
            i++;
        }
        if (cg_ncps < 64) {
            d_strncpy(cg_cps_cls + cg_ncps*64, cls, 63);
            cg_cps_cls[cg_ncps*64 + 63] = 0;
            d_strncpy(cg_cps_meth + cg_ncps*64, meth, 63);
            cg_cps_meth[cg_ncps*64 + 63] = 0;
            cg_cps_pos[cg_ncps] = pos;
            cg_ncps = cg_ncps + 1;
        }
    }
    static int cg_cps_has(const char* cls, const char* meth, int pos) {
        int i = 0;
        while (i < cg_ncps) {
            if (cg_cps_pos[i] == pos && d_strcmp(cg_cps_cls + i*64, cls) == 0 &&
                d_strcmp(cg_cps_meth + i*64, meth) == 0) return 1;
            i++;
        }
        return 0;
    }
    /* ── object arguments ───────────────────────────────────────────────────
     * A parameter filled with an OBJECT (`reader.__init__(self, f, ...)` reached
     * as `csv.reader(io.StringIO(data))`) stayed `int`; the method body then did
     * `f.read()` on an integer and called through it, so every csv/io/pathlib
     * entry point trapped the moment it touched the object.  The class of such
     * an argument is recorded per (class, method, position) alongside the string
     * note and used to declare the parameter `Cls*`. */
    static char cg_cps_obj[64*32];
    static void cg_cps_note_obj(const char* cls, const char* meth, int pos, const char* argcls) {
        if (!cls || !cls[0] || !meth || !meth[0] || !argcls || !argcls[0]) return;
        cg_cps_note(cls, meth, pos);
        int i = 0;
        while (i < cg_ncps) {
            if (cg_cps_pos[i] == pos && d_strcmp(cg_cps_cls + i*64, cls) == 0 &&
                d_strcmp(cg_cps_meth + i*64, meth) == 0) {
                d_strncpy(cg_cps_obj + i*32, argcls, 31);
                cg_cps_obj[i*32 + 31] = 0;
                return;
            }
            i++;
        }
    }
    static const char* cg_cps_obj_get(const char* cls, const char* meth, int pos) {
        int i = 0;
        while (i < cg_ncps) {
            if (cg_cps_pos[i] == pos && d_strcmp(cg_cps_cls + i*64, cls) == 0 &&
                d_strcmp(cg_cps_meth + i*64, meth) == 0) {
                if (cg_cps_obj[i*32]) return cg_cps_obj + i*32;
                return (const char*)0;
            }
            i++;
        }
        return (const char*)0;
    }
    /* The class held by an argument expression: an object built right there
     * (`Cls(...)`, `mod.Cls(...)`) or a variable already known to hold one. */
    static const char* cg_arg_obj_class(const IRNode* v) {
        if (!v) return (const char*)0;
        if (d_strcmp(v->type,"CALL")==0) {
            if (v->value && v->value[0] && d_strcmp(v->value,"COMPLEX")!=0 &&
                cg_is_class_scan(v->value)) return v->value;
            if (v->value && d_strcmp(v->value,"COMPLEX")==0 && v->nchildren > 0 &&
                v->children[0] &&
                d_strcmp(v->children[0]->type,"MEMBER_ACCESS")==0 &&
                v->children[0]->value && cg_is_class_scan(v->children[0]->value))
                return v->children[0]->value;
            return (const char*)0;
        }
        if (d_strcmp(v->type,"IDENTIFIER")==0 && v->value) {
            const char* c = cg_ov_class(v->value);
            if (!c) c = cg_cvar_class(v->value);
            return c;
        }
        return (const char*)0;
    }
    static void cg_scan_super_args(const IRNode* a, const char* base) {
        if (!a) return;
        if (d_strcmp(a->type,"CALL")==0 && a->nchildren>1 &&
            d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
            d_strcmp(a->children[0]->value,"__init__")==0 &&
            a->children[0]->nchildren>0 &&
            d_strcmp(a->children[0]->children[0]->type,"CALL")==0 &&
            d_strcmp(a->children[0]->children[0]->value,"super")==0) {
            int j = 1;
            while (j < a->nchildren && j < 9) {
                if (cg_node_is_str_static(a->children[j]) && !cg_static_is_listnode(a->children[j]))
                    cg_cps_note(base, "__init__", j - 1);
                j++;
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_super_args(a->children[i], base); i++; }
    }
    static void cg_scan_super_init(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->value && a->value[0] &&
            a->data_type[0] && d_strcmp(a->data_type,"ANY") != 0) {
            /* `super().__init__(...)` always targets the primary base (MRO) */
            int _sbp = 0;
            while (a->data_type[_sbp] && a->data_type[_sbp] != ',' && _sbp < 63) {
                cg_base_buf[_sbp] = a->data_type[_sbp];
                _sbp++;
            }
            cg_base_buf[_sbp] = 0;
            const IRNode* sbi = a->nchildren>0 ? a->children[0] : NULL;
            if (sbi) {
                int i = 0;
                while (i < sbi->nchildren) {
                    const IRNode* sm2 = sbi->children[i];
                    if (d_strcmp(sm2->type,"FUNCTION_DEF")==0 && sm2->value &&
                        d_strcmp(sm2->value,"__init__")==0 && sm2->nchildren>1)
                        cg_scan_super_args(sm2->children[1], cg_base_buf);
                    i++;
                }
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_super_init(a->children[i]); i++; }
    }

    /* A string literal handed to a CONSTRUCTOR makes the matching `__init__`
     * parameter a `char*`.  Without this the field inferred from it
     * (`self.s = s`) was an int and so was the parameter, so `Cls("x").s`
     * printed the string pointer as a decimal number.  Keyed by class name in
     * the same table `super().__init__("x")` fills. */
    static void cg_scan_init_args(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CALL")==0 && a->value && a->value[0]) {
            const char* icls = (const char*)0;
            int ab = 0;
            if (d_strcmp(a->value,"COMPLEX")!=0 && cg_is_class_scan(a->value)) icls = a->value;
            else if (d_strcmp(a->value,"COMPLEX")==0 && a->nchildren>0 &&
                     a->children[0] &&
                     d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
                     a->children[0]->value && cg_is_class_scan(a->children[0]->value)) {
                icls = a->children[0]->value;
                ab = 1;
            }
            if (icls) {
                int j = ab;
                while (j < a->nchildren && j < 8 + ab) {
                    const char* oc = cg_arg_obj_class(a->children[j]);
                    if (oc) { cg_cps_note_obj(icls, "__init__", j - ab, oc); }
                    else if (cg_node_is_str_static(a->children[j]) &&
                             !cg_static_is_listnode(a->children[j]))
                        cg_cps_note(icls, "__init__", j - ab);
                    j++;
                }
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_init_args(a->children[i]); i++; }
    }

    /* String arguments at METHOD call sites -- `b.write("a,b\n")` -- recorded
     * per (class, method, position).  `cg_scan_calls` does this for plain
     * functions; without the same treatment for methods the callee parameter
     * stayed `int` and the body did pointer arithmetic on a char*
     * (`self.data + s`). */
    static char cg_mps_cls[4096];
    static char cg_mps_meth[4096];
    static int  cg_mps_pos[128];
    static int  cg_mps_n;
    static void cg_mps_note(const char* cls, const char* meth, int pos) {
        if (!cls || !cls[0] || !meth || !meth[0]) return;
        int i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mps_meth + i*32, meth) == 0) return;
            i++;
        }
        if (cg_mps_n < 128) {
            d_strncpy(cg_mps_cls + cg_mps_n*32, cls, 31); cg_mps_cls[cg_mps_n*32 + 31] = 0;
            d_strncpy(cg_mps_meth + cg_mps_n*32, meth, 31); cg_mps_meth[cg_mps_n*32 + 31] = 0;
            cg_mps_pos[cg_mps_n] = pos;
            cg_mps_n = cg_mps_n + 1;
        }
    }
    static int cg_mps_has(const char* cls, const char* meth, int pos) {
        int i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mps_meth + i*32, meth) == 0) return 1;
            i++;
        }
        return 0;
    }
    static char cg_mps_obj[128*32];
    static void cg_mps_note_obj(const char* cls, const char* meth, int pos, const char* argcls) {
        if (!cls || !cls[0] || !meth || !meth[0] || !argcls || !argcls[0]) return;
        cg_mps_note(cls, meth, pos);
        int i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mps_meth + i*32, meth) == 0) {
                d_strncpy(cg_mps_obj + i*32, argcls, 31);
                cg_mps_obj[i*32 + 31] = 0;
                return;
            }
            i++;
        }
    }
    static const char* cg_mps_obj_get(const char* cls, const char* meth, int pos) {
        int i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mps_meth + i*32, meth) == 0) {
                if (cg_mps_obj[i*32]) return cg_mps_obj + i*32;
                return (const char*)0;
            }
            i++;
        }
        return (const char*)0;
    }
    /* Class methods are not in the `cg_prog_*` tables -- `cg_prog_add` only
     * walks module-level FUNCTION_DEFs -- so a method parameter that receives a
     * python list stayed an int-width pointer with no element count: `len(row)`
     * fell back to `drygon_bytes_len(row)` and returned garbage, and `row[i]`
     * read a truncated pointer (csv.writer.writerow).  The list parameters of
     * every method are recovered from its call sites instead, the way
     * `cg_scan_ltypes` does it for module functions: `cg_mps_lk` holds the
     * element kind of each (class, method, position), 0 meaning "not a list".
     * The table stays small -- the backend rejects a program whose code words
     * overflow. */
    static char cg_mps_lk[128];
    static int cg_mps_lk_note(const char* cls, const char* meth, int pos, int kind) {
        if (!cls || !cls[0] || !meth || !meth[0]) return 0;
        int i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mps_meth + i*32, meth) == 0) {
                /* the first call site to name a list settles the element type */
                if (cg_mps_lk[i]) return 0;
                cg_mps_lk[i] = (char)(kind + 1);
                return 1;
            }
            i++;
        }
        if (cg_mps_n < 128) {
            cg_mps_note(cls, meth, pos);
            cg_mps_lk[cg_mps_n - 1] = (char)(kind + 1);
            return 1;
        }
        return 0;
    }
    static int cg_mps_lk_get(const char* cls, const char* meth, int pos) {
        int i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mps_meth + i*32, meth) == 0)
                return cg_mps_lk[i];
            i++;
        }
        /* The receiver's class can be unknown at both ends (scan and
         * emission); method names carry the signature, so fall back to the
         * position when the (class, method) key was never recorded. */
        i = 0;
        while (i < cg_mps_n) {
            if (cg_mps_pos[i] == pos && d_strcmp(cg_mps_meth + i*32, meth) == 0) return cg_mps_lk[i];
            i++;
        }
        return 0;
    }

    /* An ARGUMENT that is a python LIST OF LISTS.  Returns 0 for an ordinary
     * argument, else rowkind + 1 (1 int rows, 2 char* rows, 3 double rows).
     * A nested literal (`[[1, 2], [3, 4]]`) is structural; a name only counts
     * when the scan already flattened it into `_back/_off/_ln/_n`.  Without
     * this the nested literal degenerated into one compound literal per row
     * (`_dylit0[0] = ((int[]){1,2})`), which dangles with the enclosing
     * statement -- `writer.writerows([[1,2],[3,4]])` walked freed storage. */
    static int cg_arg_twod(const IRNode* a) {
        if (!a) return 0;
        if (cg_is_list_node(a) && a->nchildren > 0) {
            int i = 0;
            while (i < a->nchildren) {
                if (!cg_is_list_node(a->children[i])) break;
                i++;
            }
            if (i == a->nchildren) {
                /* The rows of such a literal travel on as text: every consumer
                 * of a nested argument reaches the cells through `str()` (the
                 * csv writer formats them), so the row kind is char* and the
                 * fill quotes nothing -- it stringifies the cells. */
                return 2;
            }
        }
        if (d_strcmp(a->type,"IDENTIFIER")==0 && a->value && a->value[0] &&
            cg_list_is_twod(a->value))
            return cg_list_twod_kind(a->value) + 1;
        return 0;
    }
    /* ── list-of-lists PARAMETERS ───────────────────────────────────────────
     * `writer.writerows([[1, 2], [3, 4]])` hands the callee a flattened 2D
     * list, and the body forwards a ROW of it (`self.writerow(rows[i])`) to a
     * 1D list parameter.  Whether `rows` is 2D is only settled once the call
     * site has been scanned, so the parameter names are refined a round at a
     * time: a round sees the previous round's names (cg_t2_prev) and the scan
     * is repeated until the set of 2D parameters stops growing. */
    static char cg_t2_names[64][32];
    static int cg_t2_kinds[64]; /* 0 int rows, 1 char* rows, 2 double rows */
    static int cg_t2_n;
    static char cg_t2_prev[64][32];
    static int cg_t2_pkinds[64];
    static int cg_t2_nprev;
    static void cg_t2_reset(void) { cg_t2_n = 0; }
    static void cg_t2_snapshot(void) {
        int i = 0;
        while (i < cg_t2_n && i < 64) {
            d_strncpy(cg_t2_prev[i], cg_t2_names[i], 31);
            cg_t2_prev[i][31] = 0;
            cg_t2_pkinds[i] = cg_t2_kinds[i];
            i++;
        }
        cg_t2_nprev = i;
    }
    static void cg_t2_note(const char* nm, int rk) {
        if (!nm || !nm[0]) return;
        int i = 0;
        while (i < cg_t2_n) {
            if (d_strcmp(cg_t2_names[i], nm) == 0) { cg_t2_kinds[i] = rk; return; }
            i++;
        }
        if (cg_t2_n >= 64) return;
        d_strncpy(cg_t2_names[cg_t2_n], nm, 31);
        cg_t2_names[cg_t2_n][31] = 0;
        cg_t2_kinds[cg_t2_n] = rk;
        cg_t2_n = cg_t2_n + 1;
    }
    /* the row kind of a parameter the previous round proved to be 2D, or -1 */
    static int cg_t2_prev_kind(const char* nm) {
        if (!nm || !nm[0]) return -1;
        int i = 0;
        while (i < cg_t2_nprev) {
            if (d_strcmp(cg_t2_prev[i], nm) == 0) return cg_t2_pkinds[i];
            i++;
        }
        return -1;
    }
    /* (class, method, position) -> parameter name, filled by a source walk
     * before the classes are emitted.  `cg_cls_mparam` reads the class bodies
     * through the emission-time registries, which are still empty while the
     * call-site scans run: the 2D row kind of an argument was noted against an
     * unknown parameter name, so the callee's own `rows[i]` handed on to
     * another list parameter stayed a scalar pointer and three empty rows were
     * written (50_csv check 26). */
    static char cg_mpn_cls[256*32];
    static char cg_mpn_meth[256*32];
    static char cg_mpn_pn[256*32];
    static int cg_mpn_pos[256];
    static int cg_mpn_n;
    static void cg_mpn_note(const char* cls, const char* meth, int pos, const char* pn) {
        if (!cls || !cls[0] || !meth || !meth[0] || !pn || !pn[0]) return;
        int i = 0;
        while (i < cg_mpn_n) {
            if (cg_mpn_pos[i] == pos &&
                d_strcmp(cg_mpn_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mpn_meth + i*32, meth) == 0) return;
            i++;
        }
        if (cg_mpn_n >= 256) return;
        d_strncpy(cg_mpn_cls + cg_mpn_n*32, cls, 31); cg_mpn_cls[cg_mpn_n*32+31] = 0;
        d_strncpy(cg_mpn_meth + cg_mpn_n*32, meth, 31); cg_mpn_meth[cg_mpn_n*32+31] = 0;
        d_strncpy(cg_mpn_pn + cg_mpn_n*32, pn, 31); cg_mpn_pn[cg_mpn_n*32+31] = 0;
        cg_mpn_pos[cg_mpn_n] = pos;
        cg_mpn_n++;
    }
    static const char* cg_mpn_get(const char* cls, const char* meth, int pos) {
        if (!cls || !cls[0] || !meth || !meth[0]) return (const char*)0;
        int i = 0;
        while (i < cg_mpn_n) {
            if (cg_mpn_pos[i] == pos &&
                d_strcmp(cg_mpn_cls + i*32, cls) == 0 &&
                d_strcmp(cg_mpn_meth + i*32, meth) == 0)
                return cg_mpn_pn + i*32;
            i++;
        }
        return (const char*)0;
    }
    static void cg_scan_mparam_names_c(const IRNode* n, const char* cls) {
        if (!n) return;
        if (d_strcmp(n->type,"CLASS_DEF")==0 && n->value && n->value[0]) cls = n->value;
        else if (d_strcmp(n->type,"FUNCTION_DEF")==0 && cls && n->value &&
                 n->value[0] && n->nchildren > 0 && n->children[0]) {
            const IRNode* ps = n->children[0];
            int seen = 0;
            int j = 0;
            while (j < ps->nchildren) {
                const IRNode* p = ps->children[j];
                if (p && p->value && p->value[0] && d_strcmp(p->value,"self") != 0) {
                    cg_mpn_note(cls, n->value, seen, p->value);
                    seen++;
                }
                j++;
            }
        }
        int i = 0;
        while (i < n->nchildren) { cg_scan_mparam_names_c(n->children[i], cls); i++; }
    }
    static void cg_scan_mparam_names(const IRNode* n) {
        cg_scan_mparam_names_c(n, (const char*)0);
    }
    /* the name of the i-th non-receiver parameter of `meth` in class `cls` */
    static const char* cg_cls_mparam_body(const char* cls, const char* meth, int i) {
        int ci = cg_cls_index(cls);
        const IRNode* body = (ci >= 0) ? cg_cls_body[ci] : NULL;
        if (!body || !meth) return (const char*)0;
        int k = 0;
        while (k < body->nchildren) {
            const IRNode* c = body->children[k];
            if (d_strcmp(c->type,"FUNCTION_DEF")==0 && c->value &&
                d_strcmp(c->value, meth) == 0 && c->nchildren > 0) {
                const IRNode* ps = c->children[0];
                if (!ps) return (const char*)0;
                int seen = 0;
                int j = 0;
                while (j < ps->nchildren) {
                    const IRNode* p = ps->children[j];
                    if (d_strcmp(p->value,"self") != 0) {
                        if (seen == i) return p->value;
                        seen++;
                    }
                    j++;
                }
                return (const char*)0;
            }
            k++;
        }
        return (const char*)0;
    }
    /* the name of the i-th non-receiver parameter of `meth` in class `cls`:
     * the emitted body when the class is already registered, else the table the
     * source walk filled before any emission happened */
    static const char* cg_cls_mparam(const char* cls, const char* meth, int i) {
        const char* pn = cg_cls_mparam_body(cls, meth, i);
        if (pn && pn[0]) return pn;
        return cg_mpn_get(cls, meth, i);
    }
    /* the list kind CODE of a row kind (0 int, 1 char*, 2 double) as
     * `cg_mps_lk_note` expects it: the note adds one, so a 1D `char**` row
     * (code 2) is stored as 3 and the emit side receives `lk - 1` again */
    static int cg_lk_of_rowkind(int rk) { return rk == 1 ? 2 : (rk == 2 ? 1 : 0); }
    /* One ARGUMENT of a method call whose parameter is a counted python list:
     * the backing array and its element count, exactly as a module function's
     * list parameter is passed.  An argument that cannot be resolved still has
     * to keep the shape of the signature, so it hands over an empty list. */
    static void cg_emit_list_arg(CGen* g, const IRNode* c, int kind) {
        if (kind >= 3) {
            /* a list of lists: the flattened backing store plus the per-row
             * offset/length tables and the row count.  The callee declares
             * the four and sees the parameter as an ordinary flattened 2D
             * list, so `nm[i]` is the row and `len(nm[i])` its length. */
            if (d_strcmp(c->type,"IDENTIFIER")==0 && c->value && c->value[0] &&
                cg_list_is_twod(c->value)) {
                cg_put(g, c->value); cg_put(g, "_back, ");
                cg_put(g, c->value); cg_put(g, "_off, ");
                cg_put(g, c->value); cg_put(g, "_ln, ");
                cg_put(g, c->value); cg_put(g, "_n");
                return;
            }
            if (cg_is_list_node(c)) {
                int kk = cg_lit_index(c);
                if (kk < 0) kk = cg_lit_add(c);
                if (kk >= 0) {
                    cg_lit_put_name(g, kk); cg_put(g, "_back, ");
                    cg_lit_put_name(g, kk); cg_put(g, "_off, ");
                    cg_lit_put_name(g, kk); cg_put(g, "_ln, ");
                    cg_lit_put_name(g, kk); cg_put(g, "_n");
                    return;
                }
            }
            cg_put(g, kind == 4 ? "(char**)0, (int*)0, (int*)0, 0" :
                       (kind == 5 ? "(double*)0, (int*)0, (int*)0, 0"
                                  : "(int*)0, (int*)0, (int*)0, 0"));
            return;
        }
        if (d_strcmp(c->type,"IDENTIFIER")==0 && c->value && c->value[0]) {
            if (cg_is_lparam(c->value) || cg_list_size(c->value) >= 0 ||
                cg_sl_index(c->value) >= 0) {
                cg_put(g, c->value); cg_put(g, ", ");
                cg_put(g, c->value); cg_put(g, "_n");
                return;
            }
        } else if (d_strcmp(c->type,"ARRAY_ACCESS")==0 && c->nchildren == 2 &&
                   c->children[0] && d_strcmp(c->children[0]->type,"IDENTIFIER")==0 &&
                   cg_list_is_twod(c->children[0]->value)) {
            /* one ROW of a flattened 2D list handed to a 1D list parameter:
             * a row is a slice of the backing store, so hand over its address
             * together with the recorded row length.  `writerows` forwards
             * every row to `writerow` this way; the argument used to fall
             * through to the empty-list sentinel and the callee walked a null
             * pointer (50_csv check 7). */
            const char* bn = c->children[0]->value;
            cg_put(g, kind == 2 ? "(char**)(" : (kind == 1 ? "(double*)(" : "(int*)("));
            cg_put(g, bn); cg_put(g, "_back + ");
            cg_put(g, bn); cg_put(g, "_off["); cg_gen_expr(g, c->children[1]);
            cg_put(g, "])");
            cg_put(g, ", ");
            cg_put(g, bn); cg_put(g, "_ln["); cg_gen_expr(g, c->children[1]);
            cg_put(g, "]");
            return;
        } else if (d_strcmp(c->type,"MEMBER_ACCESS")==0) {
            /* `self._w.writerow(self.fieldnames)`: a counted list FIELD of the
             * receiving instance handed to a list parameter.  Only names and
             * literals were recognised, so the argument lowered to the empty
             * sentinel -- the header row was written as an empty line and
             * check 14 saw no `x,y` (50_csv). */
            const IRNode* _rc = c->children[0];
            const char* _rcls = (_rc && d_strcmp(_rc->type,"IDENTIFIER")==0)
                                ? cg_cvar_class(_rc->value) : (const char*)0;
            if (!_rcls || !_rcls[0]) {
                if (_rc && d_strcmp(_rc->value,"self")==0 &&
                    cg_cur_cls_i >= 0 && cg_cur_cls_i < cg_cls_n)
                    _rcls = cg_cls_names[cg_cur_cls_i];
                else if (_rc) _rcls = cg_curp_cls_of(_rc->value);
            }
            if (_rc && _rcls && _rcls[0] && cg_lf_is(_rcls, c->value)) {
                /* `self.writerow(self.fieldnames)`: the field's inline array plus
                 * its live element count.  `cg_lf_src_count` cannot be used for
                 * the count -- it EMITS the counter into `g` instead of writing
                 * it into the buffer. */
                cg_gen_expr(g, c); cg_put(g, ", ");
                cg_lf_put(g, _rc, c->value); cg_put(g, "_n");
                return;
            }
            cg_put(g, kind == 2 ? "(char**)0, 0" :
                       (kind == 1 ? "(double*)0, 0" : "(int*)0, 0"));
            return;
        } else if (cg_sl_islice(c)) {
            cg_gen_expr(g, c); cg_put(g, ", ");
            cg_gen_expr(g, c); cg_put(g, "_n");
            return;
        } else if (cg_is_list_node(c)) {
            int kk = cg_lit_index(c);
            if (kk < 0) kk = cg_lit_add(c);
            if (kk >= 0) {
                cg_lit_put_name(g, kk);
                cg_put(g, ", "); cg_put_int(g, c->nchildren);
                return;
            }
        }
        cg_put(g, kind == 2 ? "(char**)0, 0" :
                   (kind == 1 ? "(double*)0, 0" : "(int*)0, 0"));
    }
    /* One ARGUMENT of a call, when the callee's parameter is a python OBJECT
     * of another class.  `reader.__init__(self, f)` stores the instance and
     * then calls through it, so a bare `x` passed the struct by value and a
     * constructor expression (`csv.reader(io.StringIO(d))`) passed the `1`
     * sentinel; the parameter was garbage either way.  Emits `&x`, or the
     * instance itself when the argument is already a `<Cls>*` parameter, or
     * materialises `Cls(...)` into the class's scratch instance.  Returns 1
     * when it emitted the argument. */
    static int cg_emit_obj_arg(CGen* g, const char* cls, const char* meth,
                               int pos, const IRNode* av) {
        if (!cls || !meth || !av) return 0;
        const char* oc = cg_cps_obj_get(cls, meth, pos);
        if (!oc) oc = cg_mps_obj_get(cls, meth, pos);
        if (!oc || !oc[0]) return 0;
        if (d_strcmp(av->type,"CALL")==0 && av->value &&
            d_strcmp(av->value,oc)==0 && cg_cls_hasm(oc,"__init__")) {
            int osc = cg_scratch_find(oc);
            if (osc < 0) return 0;
            char osb[32];
            cg_scratch_name(osc, osb);
            cg_put(g, "(");
            cg_emit_init(g, oc, av, osb);
            cg_put(g, ", &"); cg_put(g, osb);
            cg_put(g, ")");
            return 1;
        }
        if (d_strcmp(av->type,"IDENTIFIER")==0 && av->value && av->value[0]) {
            if (cg_is_clsptr(av->value)) cg_put(g, av->value);
            else { cg_put(g, "&"); cg_put(g, av->value); }
            return 1;
        }
        return 0;
    }
    /* The enclosing class of every call site, threaded through the walk.  `self`
     * is never a registered variable, so a receiver of `self` resolved to no
     * class at all -- and that is exactly the receiver of a call inside a method
     * body, the one case that matters.  `self.eq(P(1))` therefore left the
     * parameter table empty and the argument was emitted as the `((void*)1)`
     * sentinel (probe a5 segfaulted in `P_eq`).  The table is keyed by the class
     * that DEFINES the method, which is what the emission side looks up. */
    /* The parameter node of the method whose body is being walked, so that an
     * argument that is one of ITS parameters inherits the class that parameter
     * already holds.  `def __init__(self, f): self._r = reader(f)` is the csv
     * case: `f` is only known to be a `StringIO` because the caller passed one,
     * and without the lookup `reader.__init__` never got an object parameter,
     * so its `f.read()` stayed a method call on an int and the process died
     * inside the constructor (probe p5 segfaulted). */
    static void cg_scan_meth_args_ctx(const IRNode* a, const char* curcls,
                                      const char* curmeth, const IRNode* parnode) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->value && a->value[0]) {
            int ci = 0;
            while (ci < a->nchildren) {
                cg_scan_meth_args_ctx(a->children[ci], a->value, curmeth, parnode);
                ci++;
            }
            return;
        }
        if (d_strcmp(a->type,"FUNCTION_DEF")==0) {
            curmeth = a->value;
            parnode = a->nchildren > 0 ? a->children[0] : (IRNode*)0;
        }
        if (d_strcmp(a->type,"CALL")==0) {
            /* `dc` = the class that DEFINES the called method, `methn` = the
             * method name, `ab` = 1 when child 0 is the `x.method` receiver
             * (so the arguments start at child 1) and 0 for a bare
             * `Cls(...)`/`reader(...)`, whose child 0 is already the first
             * argument. */
            const char* dc = (const char*)0;
            const char* methn = (const char*)0;
            int ab = 0;
            if (d_strcmp(a->value,"COMPLEX")==0 &&
                a->nchildren>0 && a->children[0] &&
                d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
                a->children[0]->nchildren>0 && a->children[0]->children[0] &&
                d_strcmp(a->children[0]->children[0]->type,"IDENTIFIER")==0) {
                const char* bn = a->children[0]->children[0]->value;
                const char* cv = 0;
                if (curcls && curcls[0] && d_strcmp(bn,"self")==0) cv = curcls;
                if (!cv) cv = cg_cvar_class(bn);
                if (!cv && cg_is_class_scan(bn)) cv = bn;
                if (!cv) cv = cg_ov_class(bn);
                if (cv) {
                    methn = a->children[0]->value;
                    dc = cg_cls_find_m(cv, methn);
                    if (!dc) dc = cv;
                    ab = 1;
                }
            }
            else if (a->value && a->value[0] && d_strcmp(a->value,"COMPLEX")!=0 &&
                     cg_is_class_scan(a->value)) {
                /* `reader(f)` inside another class's method: the class is named
                 * directly, so its `__init__` is the callee. */
                dc = a->value;
                methn = "__init__";
                ab = 0;
            }
            if (dc && methn) {
                int j = ab;
                while (j < a->nchildren && j < 9) {
                    const char* oc = cg_arg_obj_class(a->children[j]);
                    if (!oc && curcls && curcls[0] && curmeth && curmeth[0] &&
                        parnode && a->children[j] &&
                        d_strcmp(a->children[j]->type,"IDENTIFIER")==0 &&
                        a->children[j]->value) {
                        /* the argument is one of the enclosing method's own
                         * parameters: it holds whatever class the parameter
                         * table already recorded for it (`self` is not a C
                         * parameter, so it does not count towards the index). */
                        int pk = 0;
                        int ppos = 0;
                        while (pk < parnode->nchildren) {
                            if (parnode->children[pk] && parnode->children[pk]->value) {
                                if (d_strcmp(parnode->children[pk]->value,"self")==0) {
                                    pk++;
                                    continue;
                                }
                                if (d_strcmp(parnode->children[pk]->value,
                                             a->children[j]->value)==0) {
                                    oc = cg_cps_obj_get(curcls, curmeth, ppos);
                                    break;
                                }
                            }
                            ppos++;
                            pk++;
                        }
                    }
                    if (oc) cg_mps_note_obj(dc, methn, j - ab, oc);
                    else if (cg_node_is_str_static(a->children[j]) &&
                             !cg_static_is_listnode(a->children[j]))
                        cg_mps_note(dc, methn, j - ab);
                    j++;
                }
            }
        }
        int i = 0;
        while (i < a->nchildren) {
            cg_scan_meth_args_ctx(a->children[i], curcls, curmeth, parnode);
            i++;
        }
    }
    static void cg_scan_meth_args(const IRNode* a) {
        cg_scan_meth_args_ctx(a, (const char*)0, (const char*)0, (IRNode*)0);
    }

    static int cg_scan_float(const IRNode* a) {
        if (!a) return 0;
        if (d_strcmp(a->type,"CONSTANT")==0) return d_strcmp(a->data_type,"FLOAT")==0;
        if (d_strcmp(a->type,"BINARY_OP")==0 && d_strcmp(a->value,"/")==0) return 1;
        if (d_strcmp(a->type,"CALL")==0) return cg_fn_is_float(a->value);
        int i = 0;
        while (i < a->nchildren) { if (cg_scan_float(a->children[i])) return 1; i++; }
        return 0;
    }
    /* The type of an attribute value: 1 int, 2 char*, 3 double. */
    static int cg_if_rhs_type(const IRNode* r) {
        if (!r) return 1;
        if (d_strcmp(r->type,"CONSTANT")==0) {
            if (d_strcmp(r->data_type,"STR")==0 || d_strcmp(r->data_type,"FSTR")==0) return 2;
            if (d_strcmp(r->data_type,"FLOAT")==0) return 3;
            return 1;
        }
        if (cg_node_is_str_static(r)) return 2;
        if (cg_scan_float(r)) return 3;
        return 1;
    }
    /* Record every instance attribute the module body creates: `x = Cls()`
     * fixes x's class, `x.f = v` and `setattr(x,"f",v)` add a field.  Runs
     * before any code is generated, so the class struct can carry those fields
     * and the three attribute builtins can be resolved statically. */
    static void cg_if_scan(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* l = a->children[0];
            const IRNode* r = a->children[1];
            if (l && r && d_strcmp(l->type,"IDENTIFIER")==0 &&
                d_strcmp(r->type,"CALL")==0 && d_strcmp(r->value,"COMPLEX")!=0 &&
                r->value && cg_if_is_cls(r->value)) {
                cg_if_note_var(l->value, r->value);
            }
            if (l && d_strcmp(l->type,"MEMBER_ACCESS")==0 && l->nchildren>0 &&
                d_strcmp(l->children[0]->type,"IDENTIFIER")==0) {
                const char* vc = cg_if_var_cls(l->children[0]->value);
                if (!vc) vc = cg_cvar_class(l->children[0]->value);
                if (vc) cg_if_note_field(vc, l->value, cg_if_rhs_type(r));
            }
        }
        if (d_strcmp(a->type,"CALL")==0 && a->value && d_strcmp(a->value,"setattr")==0 &&
            a->nchildren>2 && a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0) {
            const char* vc = cg_if_var_cls(a->children[0]->value);
            if (!vc) vc = cg_cvar_class(a->children[0]->value);
            char f2[64]; f2[0] = 0;
            if (a->children[1] && d_strcmp(a->children[1]->type,"CONSTANT")==0)
                cg_strlit_copy(a->children[1]->value, f2, 64);
            if (vc && f2[0]) cg_if_note_field(vc, f2, cg_if_rhs_type(a->children[2]));
        }
        if (d_strcmp(a->type,"CLASS_DEF")==0 || d_strcmp(a->type,"FUNCTION_DEF")==0) return;
        int i = 0;
        while (i < a->nchildren) { cg_if_scan(a->children[i]); i++; }
    }
    static int cg_if_cls_has_field(const char* cls, const char* f) {
        if (!cls || !cls[0] || !f || !f[0]) return 0;
        int ci = cg_cls_index(cls);
        if (ci < 0) return cg_if_field_ftype(cls, f) != 0;
        const IRNode* body = cg_cls_body[ci];
        if (body) {
            char fn2[2048];
            int nf2 = 0;
            int i = 0;
            while (i < body->nchildren) {
                const IRNode* c = body->children[i];
                if (d_strcmp(c->type,"FUNCTION_DEF")==0) {
                    if (d_strcmp(c->value, f)==0) return 1;
                    if (c->nchildren>1) cg_cls_collect(c->children[1], fn2, &nf2, 32);
                } else if (d_strcmp(c->type,"ASSIGN")==0 && c->nchildren>0 &&
                           d_strcmp(c->children[0]->type,"IDENTIFIER")==0 &&
                           d_strcmp(c->children[0]->value, f)==0) {
                    return 1;
                }
                i++;
            }
            i = 0;
            while (i < nf2) { if (d_strcmp(fn2 + i*64, f)==0) return 1; i++; }
        }
        int bk = 0;
        while (bk < cg_cls_nab[ci]) {
            if (cg_if_cls_has_field(cg_cls_ab + (ci*4 + bk)*64, f)) return 1;
            bk++;
        }
        return cg_if_field_ftype(cls, f) != 0;
    }
    static void cg_dir_add(char* out, int* n, int max, const char* nm) {
        if (!nm || !nm[0] || *n >= max) return;
        int i = 0;
        while (i < *n) { if (d_strcmp(out + i*64, nm)==0) return; i++; }
        d_strncpy(out + (*n)*64, nm, 63); out[(*n)*64 + 63] = 0;
        *n = *n + 1;
    }
    /* python `dir(obj)`: the attribute NAMES of the object's class. */
    static void cg_dir_fill(const char* cls, char* out, int* n, int max, int depth) {
        if (!cls || !cls[0] || depth > 4) return;
        int ci = cg_cls_index(cls);
        if (ci < 0) return;
        const IRNode* body = cg_cls_body[ci];
        if (body) {
            char fn2[2048];
            int nf2 = 0;
            int i = 0;
            while (i < body->nchildren) {
                const IRNode* c = body->children[i];
                if (d_strcmp(c->type,"FUNCTION_DEF")==0) {
                    cg_dir_add(out, n, max, c->value);
                    if (c->nchildren>1) cg_cls_collect(c->children[1], fn2, &nf2, 32);
                } else if (d_strcmp(c->type,"ASSIGN")==0 && c->nchildren>0 &&
                           d_strcmp(c->children[0]->type,"IDENTIFIER")==0) {
                    cg_dir_add(out, n, max, c->children[0]->value);
                }
                i++;
            }
            i = 0;
            while (i < nf2) { cg_dir_add(out, n, max, fn2 + i*64); i++; }
        }
        int bk = 0;
        while (bk < cg_cls_nab[ci]) {
            cg_dir_fill(cg_cls_ab + (ci*4 + bk)*64, out, n, max, depth + 1);
            bk++;
        }
        int fi = 0;
        while (fi < cg_if_fn) {
            if (d_strcmp(cg_if_fcls + fi*64, cls)==0) cg_dir_add(out, n, max, cg_if_fname + fi*64);
            fi++;
        }
    }
    /* A node that is a python list known from the syntax alone: a list literal,
     * a name that already carries a list of known size, or a split() result. */
    static int cg_static_is_listnode(const IRNode* a) {
        if (!a) return 0;
        if (cg_is_list_node(a)) return 1;
        if (d_strcmp(a->type,"IDENTIFIER")!=0) return 0;
        if (cg_list_size(a->value) >= 0) return 1;
        if (cg_sl_index(a->value) >= 0) return 1;
        return 0;
    }
    static int cg_in_params(const IRNode* ofn, const char* name) {
        const IRNode* pr = (ofn && ofn->nchildren>0) ? ofn->children[0] : NULL;
        int p = 0;
        while (pr && p < pr->nchildren && p < 8) {
            if (d_strcmp(pr->children[p]->value, name)==0) return 1;
            p++;
        }
        return 0;
    }
    /* Element type of an argument that is a python list: 0 not a list, 1 int,
     * 2 double, 3 char*.  `ofn` is the function the argument sits in, because
     * a list parameter forwards its element type to whatever it is passed to. */
    static int cg_larg_type(const IRNode* c, int ofi, const IRNode* ofn) {
        if (!c) return 0;
        if (cg_is_list_node(c)) {
            int f = 0;
            int s = 0;
            int k = 0;
            while (k < c->nchildren) {
                if (cg_scan_float(c->children[k])) f = 1;
                else if (cg_node_is_str_static(c->children[k])) s = 1;
                k++;
            }
            if (s) return 3;
            if (f) return 2;
            return 1;
        }
        /* `lst[1:]` where `lst` is a *list parameter* of the enclosing
         * function: the parameter's element type is only known from the
         * refinement pass, so the previous snapshot decides.  Falling through
         * left the slice typed as a string, which made `return sum_list(lst[1:],
         * ...)` call a `char*` variant of the callee and print 3 for 15
         * (11_functions check 60). */
        if (d_strcmp(c->type,"SLICE")==0 && c->nchildren > 0 && c->children[0] &&
            d_strcmp(c->children[0]->type,"IDENTIFIER")==0 && ofi >= 0 && ofn &&
            cg_in_params(ofn, c->children[0]->value)) {
            const IRNode* pr0 = ofn->children[0];
            int p0 = 0;
            while (p0 < pr0->nchildren && p0 < 8) {
                if (d_strcmp(pr0->children[p0]->value, c->children[0]->value)==0) {
                    if ((cg_prog_lmprev[ofi] & (1 << p0)) && (cg_prog_ldprev[ofi] & (1 << p0)))
                        return ((cg_prog_lprev[ofi] >> (p0 * 2)) & 3) + 1;
                    break;
                }
                p0++;
            }
        }
        if (cg_sl_islice(c)) {
            int et = cg_sl_base_et(c);
            if (et == 2) return 3;
            if (et == 1) return 2;
            return 1;
        }
        if (d_strcmp(c->type,"IDENTIFIER")!=0) return 0;
        if (cg_in_params(ofn, c->value)) {
            if (ofi < 0) return 0;
            const IRNode* pr = ofn->children[0];
            int p = 0;
            while (p < pr->nchildren && p < 8) {
                if (d_strcmp(pr->children[p]->value, c->value)==0) {
                    /* the element type of a parameter is the one settled on by
                     * the previous refinement pass */
                    if (!(cg_prog_lmprev[ofi] & (1 << p))) return 0;
                    if (!(cg_prog_ldprev[ofi] & (1 << p))) return 0;
                    return ((cg_prog_lprev[ofi] >> (p * 2)) & 3) + 1;
                }
                p++;
            }
            return 0;
        }
        int f2 = cg_force_list_get(c->value);
        if (f2 >= 0) return f2 + 1;
        if (cg_sl_index(c->value) >= 0) return 3;
        if (cg_list_size(c->value) >= 0) {
            if (cg_list_is_str(c->value)) return 3;
            return cg_list_is_float(c->value) ? 2 : 1;
        }
        return 0;
    }
    /* One refinement pass over the whole program: every list argument hands its
     * element type to the parameter it fills, and the first call site to name a
     * list for a parameter settles that parameter's inferred type.  The pass
     * runs until the types stop moving, so a list forwarded through several
     * functions ends up consistently typed. */
    static void cg_scan_ltypes(const IRNode* a, int ofi, const IRNode* ofn) {
        if (!a) return;
        int cur = ofi;
        const IRNode* curf = ofn;
        if (d_strcmp(a->type,"FUNCTION_DEF")==0) {
            cur = cg_prog_find(a->value);
            curf = a;
            /* the body is typed in its own scope, never the module's */
            cg_scope_enter(a);
            int ic = 0;
            while (ic < a->nchildren) { cg_scan_ltypes(a->children[ic], cur, curf); ic++; }
            cg_scope_exit();
            return;
        } else if (d_strcmp(a->type,"LAMBDA")==0) {
            cur = -1;
            curf = NULL;
        }
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"print")!=0) {
            int fi = cg_prog_find(a->value);
            if (fi >= 0 && fi != cur) {
                int i = 0;
                while (i < a->nchildren && i < 8) {
                    const IRNode* c = a->children[i];
                    int lt = cg_larg_type(c, cur, curf);
                    if (lt) {
                        cg_prog_lmask[fi] = cg_prog_lmask[fi] | (1 << i);
                        /* an element type, not a string: `char*` elements are
                         * strings held in an array, not a scalar char* */
                        if (cg_node_is_str_static(c)) {
                            cg_prog_pstr[fi * 8 + i] = 0;
                        }
                        if (!(cg_prog_ldec[fi] & (1 << i))) {
                            cg_prog_ldec[fi] = cg_prog_ldec[fi] | (1 << i);
                            int t = lt - 1;
                            cg_prog_ltype[fi] =
                                (cg_prog_ltype[fi] & ~(3 << (i * 2))) | (t << (i * 2));
                        }
                        /* the argument itself keeps its own element type: a
                         * literal gets the backing array it needs, a list
                         * variable is declared with it */
                        if (cg_is_list_node(c)) cg_litw_note(c, lt - 1);
                        else if (d_strcmp(c->type,"IDENTIFIER")==0 &&
                                 !cg_in_params(curf, c->value)) {
                            if (cg_static_is_listnode(c)) cg_force_list(c->value, lt - 1);
                        }
                    }
                    i++;
                }
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_ltypes(a->children[i], cur, curf); i++; }
    }
    static void cg_ltypes_snapshot(void) {
        int i = 0;
        while (i < 256) {
            cg_prog_lprev[i] = cg_prog_ltype[i];
            cg_prog_ldprev[i] = cg_prog_ldec[i];
            cg_prog_lmprev[i] = cg_prog_lmask[i];
            i++;
        }
    }
    /* `phase` 0 settles the element kind of every method list parameter from the
     * call sites; `phase` 1 walks again and gives each literal argument the
     * backing array its settled parameter needs (`writer.writerow([1, 2, 3])`
     * into a `char**` row has to become "1", "2", "3"). */
    static void cg_scan_meth_listargs(const IRNode* a, const char* curcls, int phase) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->value && a->value[0]) curcls = a->value;
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"COMPLEX")==0 &&
            a->nchildren>0 && a->children[0] &&
            d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
            a->children[0]->nchildren>0 && a->children[0]->children[0] &&
            d_strcmp(a->children[0]->children[0]->type,"IDENTIFIER")==0) {
            const char* rn = a->children[0]->children[0]->value;
            const char* cv = cg_cvar_class(rn);
            /* `self.helper(row)` inside a method: the enclosing class is the
             * receiver's class */
            if (!cv && curcls && d_strcmp(rn,"self")==0) cv = curcls;
            if (!cv && cg_is_class_scan(rn)) cv = rn;
            if (!cv) cv = cg_ov_class(rn);
            /* `Mod.Class(target=f, args=(42,))`: a CONSTRUCTOR call.  Its list
             * parameters belong to `__init__` of that class, not to a method
             * named after the class, so note them under `__init__` (the key
             * the signature pass looks up). */
            const char* _meth = a->children[0]->value;
            const char* _ctorcls = cg_is_class_scan(_meth) ? _meth : 0;
            /* a value returned by a module function (`writer = csv.writer(f)`)
             * has no recorded class yet: key the note under the class that
             * declares the method, so `cg_mps_lk_get` can find it */
            const char* m_any = cg_cls_find_m_any(_ctorcls ? "__init__" : _meth);
            if (_ctorcls || cv || m_any) {
                const char* m_cls;
                if (_ctorcls) { m_cls = _ctorcls; _meth = "__init__"; }
                else {
                    m_cls = cv ? cg_cls_find_m(cv, _meth) : 0;
                    if (!m_cls) m_cls = cv ? cv : m_any;
                }
                int j = 1;
                while (j < a->nchildren && j < 9) {
                    /* `Cls(target=f, args=(42,))`: a keyword argument's list
                     * shape lives on its VALUE, so unwrap the KWARG first or
                     * the parameter is typed int and the pointer truncates
                     * (45_threading). */
                    const IRNode* av = a->children[j];
                    if (av && d_strcmp(av->type,"KWARG")==0 && av->nchildren>0)
                        av = av->children[0];
                    if (phase) {
                        int lk = cg_mps_lk_get(m_cls, _meth, j - 1);
                        if (lk >= 4) {
                            /* a list-of-lists argument: the signature carries
                             * four parameters, so the literal temp only has to
                             * exist (its flattened fill is driven by the row
                             * kind registered below, never by an element type) */
                            if (cg_is_list_node(av) && cg_lit_index(av) < 0) cg_lit_add(av);
                        }
                        else if (lk > 0 && cg_is_list_node(av)) cg_litw_note(av, lk - 1);
                    } else {
                        int t2 = cg_arg_twod(av);
                        if (t2) {
                            cg_mps_lk_note(m_cls, _meth, j - 1, t2 + 2);
                            /* the callee's body then treats this parameter as a
                             * flattened 2D list, so remember its name: a later
                             * round has to recognise `p[i]` handed on to another
                             * list parameter (`self.writerow(rows[i])`) */
                            cg_t2_note(cg_cls_mparam(m_cls, _meth, j - 1), t2 - 1);
                        }
                        else {
                            int _prk = -1;
                            if (av && d_strcmp(av->type,"ARRAY_ACCESS")==0 &&
                                av->nchildren == 2 && av->children[0] &&
                                d_strcmp(av->children[0]->type,"IDENTIFIER")==0)
                                _prk = cg_t2_prev_kind(av->children[0]->value);
                            if (_prk >= 0) {
                                /* one ROW of a 2D parameter handed to a 1D list
                                 * parameter: the row is a slice of the flattened
                                 * store, so the callee takes the row pointer and
                                 * its length (50_csv check 7) */
                                cg_mps_lk_note(m_cls, _meth, j - 1, cg_lk_of_rowkind(_prk));
                            } else {
                                int lt = cg_larg_type(av, -1, NULL);
                                if (lt) cg_mps_lk_note(m_cls, _meth, j - 1, lt - 1);
                            }
                        }
                    }
                    j++;
                }
            }
        }
        /* `Cls(a, b)` wears a shape of its own: the CALL's `value` IS the class
         * and the children ARE the arguments (there is no MEMBER_ACCESS
         * receiver), so the arm above never saw a constructor call and
         * `DictWriter.__init__`'s `fieldnames` never got a list kind.  Its body
         * then took an `int*` while the call site handed over a `char*[]`, the
         * first `k = self.fieldnames[i]` was an int and the dict read
         * dereferenced address 1 (50_csv check 15). */
        if (d_strcmp(a->type,"CALL")==0 && a->value && a->value[0] &&
            d_strcmp(a->value,"COMPLEX")!=0 && cg_is_class_scan(a->value)) {
            int j = 0;
            while (j < a->nchildren && j < 8) {
                const IRNode* av = a->children[j];
                if (av && d_strcmp(av->type,"KWARG")==0 && av->nchildren>0)
                    av = av->children[0];
                if (phase) {
                    int lk = cg_mps_lk_get(a->value, "__init__", j);
                    if (lk >= 4) {
                        if (cg_is_list_node(av) && cg_lit_index(av) < 0) cg_lit_add(av);
                    } else if (lk > 0 && cg_is_list_node(av)) {
                        cg_litw_note(av, lk - 1);
                    }
                } else {
                    int t2 = cg_arg_twod(av);
                    if (t2) {
                        cg_mps_lk_note(a->value, "__init__", j, t2 + 2);
                    } else {
                        int lt = cg_larg_type(av, -1, NULL);
                        if (lt) cg_mps_lk_note(a->value, "__init__", j, lt - 1);
                    }
                }
                j++;
            }
        }
        int i = 0;
        while (i < a->nchildren) {
            cg_scan_meth_listargs(a->children[i], curcls, phase);
            i++;
        }
    }
    /* Register the signature every call site of `fname` needs: string
     * parameters, whose parameters take a list, and of what element type.  A
     * site whose argument types differ from the inferred signature gets a body
     * of its own. */
    static void cg_scan_list_args(const IRNode* a, const char* fname, int fi, int ofi, const IRNode* ofn) {
        if (!a) return;
        int cur = ofi;
        const IRNode* curf = ofn;
        if (d_strcmp(a->type,"FUNCTION_DEF")==0) {
            cur = cg_prog_find(a->value);
            curf = a;
        } else if (d_strcmp(a->type,"LAMBDA")==0) {
            cur = -1;
            curf = NULL;
        }
        if (d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,fname)==0) {
            int mk = 0;
            int fm = 0;
            int i = 0;
            while (i < a->nchildren && i < 8) {
                const IRNode* c = a->children[i];
                int lt = cg_larg_type(c, cur, curf);
                if (lt) {
                    cg_prog_lmask[fi] = cg_prog_lmask[fi] | (1 << i);
                    if (lt == 3) cg_prog_pstr[fi * 8 + i] = 0;
                    mk = mk | (1 << (8 + i));
                    if (lt == 2) mk = mk | (1 << (16 + i));
                    if (lt == 3) mk = mk | (1 << (24 + i));
                } else if (cg_node_is_str_static(c)) {
                    /* a *list* argument is never the scalar `char*` bit, even
                     * when the syntax alone (every SLICE, every `s.split()`
                     * call) reads as text */
                    mk = mk | (1 << i);
                } else if (!cg_fn_is_float(fname) && cg_node_is_flt_static(c)) {
                    /* a float handed to a plain parameter needs its own body,
                     * with that parameter declared `double` */
                    fm = fm | (1 << i);
                }
                i++;
            }
            cg_note_mask2(fi, mk, fm);
            cg_call_note(a, mk);
            cg_call_note_fm(a, fm);
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_list_args(a->children[i], fname, fi, cur, curf); i++; }
    }
    /* Structural equality of two literal elements (same type, value and
     * children).  A SET literal is deduplicated by python, and the emitted
     * count was the raw child count, so `{Color.RED, Color.GREEN, Color.RED}`
     * had 3 elements and `len(s) == 2` failed (48_enum 37). */
    static int cg_node_same(const IRNode* x, const IRNode* y) {
        if (!x || !y) return 0;
        if (d_strcmp(x->type,y->type)!=0) return 0;
        if (d_strcmp(x->value,y->value)!=0) return 0;
        if (x->nchildren != y->nchildren) return 0;
        int i = 0;
        while (i < x->nchildren) {
            if (!cg_node_same(x->children[i], y->children[i])) return 0;
            i++;
        }
        return 1;
    }
    static void cg_dedup_set(IRNode* lit) {
        if (!lit || d_strcmp(lit->type,"BLOCK")!=0 || d_strcmp(lit->value,"SET")!=0) return;
        int w = 0, r = 0;
        while (r < lit->nchildren) {
            IRNode* e = lit->children[r];
            int dup = 0;
            int j = 0;
            while (j < w) {
                if (cg_node_same(lit->children[j], e)) { dup = 1; break; }
                j++;
            }
            if (!dup) { lit->children[w] = e; w++; }
            r++;
        }
        lit->nchildren = w;
    }
    /* `name = [ ... ]` anywhere in the program tells the call-site scan that
     * the name holds a python list.  It is registered up front because the
     * syntax alone has to be enough: no statement has been emitted yet. */
    /* `names.append(k)` types `names` from the value of `k`.  The string
     * table is a single flat table for the whole module, so a *later* loop in
     * the same scope that reuses the name as an integer counter (`for k in
     * range(3)`) erases the evidence the enclosing `for k in d:` left behind,
     * and `names` was declared `int names[64]` while it stored `char*` (a
     * segfault in the membership test).  Carry the enclosing loop's binding
     * down the walk so the append is judged by the loop it is written in. */
    /* ── object lists: `objs = [Obj("b", 2), Obj("a", 1)]` ────────────────
     * A constructor call in EXPRESSION position has no storage of its own, so
     * the literal's element slots were only `((void*)1)` sentinels: `objs[0].name`,
     * `operator.attrgetter("name")(objs[0])` and
     * `sorted(objs, key=operator.attrgetter("name"))` all read through a bogus
     * address (55_operator_mod checks 31-33 SEGV'd).  Such a literal is kept as
     * ONE COLUMN ARRAY PER INSTANCE ATTRIBUTE (`objs_name[64]`, `objs_val[64]`),
     * filled from the constructor arguments; attribute reads go to the matching
     * column and the sort permutes every column together. */
    /* the class body declared in the source (the codegen registry is only
     * filled while classes are emitted, which is after the prescan) */
    static const IRNode* cg_ob_cbody(const char* nm) {
        int i = 0;
        while (i < cg_ob_ncls) { if (d_strcmp(cg_ob_cn[i], nm) == 0) return cg_ob_cbd[i]; i++; }
        return NULL;
    }
    /* strip the quotes off a string literal (cg_strip_q is defined later) */
    static void cg_ob_unq(const char* v, char* buf, int max) {
        int i = 0;
        int j = 0;
        if (!v) { buf[0] = 0; return; }
        while (v[i] && j < max) {
            if ((v[i] == 34 || v[i] == 39) && (i == 0 || v[i + 1] == 0)) { i = i + 1; continue; }
            buf[j] = v[i]; j = j + 1; i = i + 1;
        }
        buf[j] = 0;
    }
    /* `_ob3k`-style unique temp names: two object-list sorts in one scope would
     * otherwise redeclare the loop variables (invalid C). */
    static void cg_ob_tmp(char* out, const char* base, int k, char sfx) {
        int i = 0;
        char d[12];
        int n = 0;
        while (base[i] && i < 10) { out[i] = base[i]; i++; }
        if (k == 0) { d[0] = 48; n = 1; }
        while (k > 0 && n < 10) { d[n] = 48 + (k % 10); k = k / 10; n++; }
        int j = 0;
        while (j < n) { out[i] = d[n - 1 - j]; i++; j++; }
        out[i] = sfx; i++;
        out[i] = 0;
    }
    /* Ordered instance attributes of `cls` (its `self.<f> = ...` assignments in
     * method order), one 32-byte name per slot.  A local copy of cg_cls_collect:
     * that one ignores its cap (hard-coded 32 with a 64-byte stride). */
    static void cg_ob_collect(const IRNode* nn, char* names, int* nf, int maxf) {
        if (!nn) return;
        if (d_strcmp(nn->type,"ASSIGN")==0 && nn->nchildren>0 &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->nchildren>0 &&
            d_strcmp(nn->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,"self")==0) {
            const char* f = nn->children[0]->value;
            int j = 0;
            int dup = 0;
            while (j < *nf) { if (d_strcmp(names + j*32, f) == 0) { dup = 1; break; } j++; }
            if (!dup && *nf < maxf) {
                d_strncpy(names + (*nf)*32, f, 31);
                names[(*nf)*32 + 31] = 0;
                *nf = *nf + 1;
            }
        }
        int i = 0;
        while (i < nn->nchildren) { cg_ob_collect(nn->children[i], names, nf, maxf); i++; }
    }
    /* Scan the literal `objs = [Ctor(...), ...]`: every element must be a call
     * of the SAME declared class supplying exactly one argument per instance
     * attribute.  Fills `colbuf` (32 bytes per column), `kinds` and `cls_out`;
     * returns the column count, or -1 when it is not an object list. */
    static int cg_ob_lit_scan(const IRNode* lit, char* colbuf, int* kinds, char* cls_out) {
        cls_out[0] = 0;
        if (!lit || !cg_is_list_node(lit) || lit->nchildren < 1) return -1;
        const IRNode* e0 = lit->children[0];
        if (!e0 || d_strcmp(e0->type,"CALL")!=0 || d_strcmp(e0->value,"COMPLEX")==0) return -1;
        const IRNode* body = cg_ob_cbody(e0->value);
        if (!body) return -1;
        int ncol = 0;
        int mi = 0;
        while (mi < body->nchildren) {
            const IRNode* mc = body->children[mi];
            if (d_strcmp(mc->type,"FUNCTION_DEF")==0 && mc->nchildren>1)
                cg_ob_collect(mc->children[1], colbuf, &ncol, 8);
            mi++;
        }
        if (ncol < 1 || ncol != e0->nchildren) return -1;
        int k = 1;
        while (k < lit->nchildren) {
            const IRNode* el = lit->children[k];
            if (!el || d_strcmp(el->type,"CALL")!=0 || d_strcmp(el->value,"COMPLEX")==0) return -1;
            if (d_strcmp(el->value, e0->value) != 0) return -1;
            if (el->nchildren != ncol) return -1;
            k++;
        }
        int c = 0;
        while (c < ncol) {
            int kind = 0;
            k = 0;
            while (k < lit->nchildren) {
                const IRNode* a = lit->children[k]->children[c];
                if (cg_node_is_str_static(a)) kind = 2;
                else if (kind != 2 && cg_is_float_node(a)) kind = 3;
                k++;
            }
            kinds[c] = kind;
            c++;
        }
        k = 0;
        while (e0->value[k] && k < 31) { cls_out[k] = e0->value[k]; k++; }
        cls_out[k] = 0;
        return ncol;
    }
    /* Register (idempotently) the object list `name`; `si` >= 0 copies the
     * columns of an existing object list, otherwise they come from `colbuf`. */
    static int cg_ob_add_cols(const char* name, int si, const char* colbuf, int* kinds, int ncol, const char* cls) {
        int li = cg_ob_lookup(name);
        if (li >= 0) return li;
        if (cg_ob_cnt >= 64) return -1;
        li = cg_ob_cnt;
        cg_ob_cnt = cg_ob_cnt + 1;
        d_strncpy(cg_ob_lname[li], name, 31); cg_ob_lname[li][31] = 0;
        d_strncpy(cg_ob_lcls[li], cls, 31); cg_ob_lcls[li][31] = 0;
        int c = 0;
        if (si >= 0) {
            ncol = cg_ob_lncol[si];
            while (c < ncol) {
                d_strncpy(cg_ob_lcol[li*8 + c], cg_ob_lcol[si*8 + c], 31);
                cg_ob_lcol[li*8 + c][31] = 0;
                cg_ob_lkind[li*8 + c] = cg_ob_lkind[si*8 + c];
                cg_ob_mkcn(cg_ob_lcn[li*8 + c], name, c);
                c = c + 1;
            }
        } else {
            while (c < ncol) {
                d_strncpy(cg_ob_lcol[li*8 + c], colbuf + c*32, 31);
                cg_ob_lcol[li*8 + c][31] = 0;
                cg_ob_lkind[li*8 + c] = kinds[c];
                cg_ob_mkcn(cg_ob_lcn[li*8 + c], name, c);
                c = c + 1;
            }
        }
        cg_ob_lncol[li] = ncol;
        return li;
    }
    static int cg_ob_reg_lit(const IRNode* lit, const char* name) {
        char colbuf[256];
        int kinds[8];
        char cls[32];
        int ncol = cg_ob_lit_scan(lit, colbuf, kinds, cls);
        if (ncol < 1) return -1;
        return cg_ob_add_cols(name, -1, colbuf, kinds, ncol, cls);
    }
    /* `d = sorted(objs, key=...)` over an object list: d is an object list of
     * the same class with its own column arrays. */
    static int cg_ob_reg_sort(const IRNode* lhs, const IRNode* rhs) {
        char cb[8];
        int kk[2];
        cb[0] = 0; kk[0] = 0;
        if (!lhs || d_strcmp(lhs->type,"IDENTIFIER")!=0) return -1;
        if (!rhs || d_strcmp(rhs->type,"CALL")!=0 || !rhs->value || d_strcmp(rhs->value,"sorted")!=0)
            return -1;
        if (rhs->nchildren < 1 || !rhs->children[0]) return -1;
        if (d_strcmp(rhs->children[0]->type,"IDENTIFIER")!=0) return -1;
        int si = cg_ob_lookup(rhs->children[0]->value);
        if (si < 0) return -1;
        int di = cg_ob_lookup(lhs->value);
        if (di >= 0) return di;
        cg_note_list(lhs->value, 64, 0);
        return cg_ob_add_cols(lhs->value, si, cb, kk, 0, cg_ob_lcls[si]);
    }
    /* `objs = []` then `objs.append(Ctor(...))`: the same column model as a
     * literal, but the class and the columns come from the appended call.
     * Registering at scan time keeps the declaration pass in step. */
    static int cg_ob_reg_append(const IRNode* c, const char* name) {
        if (!c || !name || !name[0]) return -1;
        if (d_strcmp(c->type,"CALL")!=0 || !c->value || d_strcmp(c->value,"COMPLEX")!=0) return -1;
        if (c->nchildren < 2) return -1;
        const IRNode* el = c->children[1];
        if (!el) return -1;
        /* `lst.append(Ctor(...))` names the class directly; `lst.append(v)`
         * takes it from the variable-class map recorded by cg_ob_walk. */
        const char* vcls = 0;
        const IRNode* elc = 0;
        if (d_strcmp(el->type,"CALL")==0 && el->value && d_strcmp(el->value,"COMPLEX")!=0) {
            vcls = el->value;
            elc = el;
        } else if (d_strcmp(el->type,"IDENTIFIER")==0 && el->value) {
            vcls = cg_ob_var_cls(el->value);
            if (!vcls) vcls = cg_cvar_class(el->value);
            if (!vcls && cg_is_class(el->value)) vcls = el->value;
        }
        if (!vcls || !vcls[0]) return -1;
        const IRNode* body = cg_ob_cbody(vcls);
        if (!body) return -1;
        int ncol = 0;
        char colbuf[256];
        int mi = 0;
        while (mi < body->nchildren) {
            const IRNode* mc = body->children[mi];
            if (d_strcmp(mc->type,"FUNCTION_DEF")==0 && mc->nchildren>1)
                cg_ob_collect(mc->children[1], colbuf, &ncol, 8);
            mi++;
        }
        if (ncol < 1) return -1;
        if (elc && ncol != elc->nchildren) return -1;
        int kinds[8];
        int c2 = 0;
        while (c2 < ncol) {
            int kind = 0;
            if (elc) {
                const IRNode* a = elc->children[c2];
                if (cg_node_is_str_static(a) || cg_is_str_node(a)) kind = 2;
                else if (cg_is_float_node(a)) kind = 3;
            } else {
                int ft = cg_cls_ftype(body, colbuf + c2*32);
                if (ft == 2) kind = 2;
                else if (ft == 3) kind = 3;
            }
            kinds[c2] = kind;
            c2++;
        }
        char cls[32];
        int k = 0;
        while (vcls[k] && k < 31) { cls[k] = vcls[k]; k++; }
        cls[k] = 0;
        return cg_ob_add_cols(name, -1, colbuf, kinds, ncol, cls);
    }
    /* The attribute named by an `operator.attrgetter("a")` inside a sub-tree,
     * or "" when there is none. */
    static void cg_ob_key_attr(const IRNode* a, char* out, int max) {
        if (!a) return;
        if (out[0]) return;
        if (d_strcmp(a->type,"CALL")==0 && a->nchildren>1 &&
            d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
            d_strcmp(a->children[0]->value,"attrgetter")==0 &&
            cg_node_is_str_static(a->children[1])) {
            cg_ob_unq(a->children[1]->value, out, max);
            return;
        }
        int i = 0;
        while (i < a->nchildren) { cg_ob_key_attr(a->children[i], out, max); i++; }
    }
    /* The column `sorted(..., key=...)` sorts by, or -1 */
    static int cg_ob_sort_key_col(const IRNode* call, const char* dn) {
        char ab[32];
        ab[0] = 0;
        if (!call || call->nchildren < 2) return -1;
        const IRNode* kw = call->children[1];
        if (!kw || d_strcmp(kw->type,"KWARG")!=0 || !kw->value ||
            d_strcmp(kw->value,"key")!=0 || kw->nchildren < 1) return -1;
        cg_ob_key_attr(kw->children[0], ab, 30);
        if (ab[0]) return cg_ob_col(dn, ab);
        const IRNode* b = kw->children[0];
        if (b && b->type && d_strcmp(b->type,"IDENTIFIER")==0) {
            int i = 0;
            while (i < cg_ag_cnt) {
                if (d_strcmp(cg_ag_name[i], b->value) == 0) return cg_ob_col(dn, cg_ag_attr[i]);
                i++;
            }
        }
        return -1;
    }
    /* `operator.methodcaller("upper")` -> its string-helper call */
    /* C3 linearization for multiple inheritance: `class D(B, C)` must resolve
     * `super().method()` through D's MRO [D, B, C, A], not just through the
     * first base.  Precomputed before emission so a base method (`B.method`)
     * knows its `super()` target is C, not A (60_comprehensive). */
    static char cg_c3_cls[128][32];
    static char cg_c3_bas[128][256];
    static int cg_c3_n;
    static char cg_c3_sup[128][32];
    static int cg_c3_find(const char* n) {
        if (!n || !n[0]) return -1;
        int i = 0;
        while (i < cg_c3_n) { if (d_strcmp(cg_c3_cls[i], n) == 0) return i; i++; }
        return -1;
    }
    static void cg_c3_collect(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"CLASS_DEF")==0 && a->value && a->value[0] &&
            cg_c3_find(a->value) < 0 && cg_c3_n < 128) {
            d_strncpy(cg_c3_cls[cg_c3_n], a->value, 31); cg_c3_cls[cg_c3_n][31] = 0;
            d_strncpy(cg_c3_bas[cg_c3_n],
                      (a->data_type[0] && d_strcmp(a->data_type,"ANY")!=0) ? a->data_type : "", 255);
            cg_c3_bas[cg_c3_n][255] = 0;
            cg_c3_sup[cg_c3_n][0] = 0;
            cg_c3_n = cg_c3_n + 1;
        }
        int i = 0;
        while (i < a->nchildren) { cg_c3_collect(a->children[i]); i++; }
    }
    static int cg_c3_split(const char* s, char out[][32], int max) {
        int n = 0, i = 0;
        while (s && s[i] && n < max) {
            int j = 0;
            while (s[i] && s[i] != ',' && j < 31) out[n][j++] = s[i++];
            out[n][j] = 0; n++;
            if (s[i] == ',') i++;
        }
        return n;
    }
    static void cg_c3_build(const IRNode* prog) {
        cg_c3_n = 0;
        cg_c3_collect(prog);
        int i = 0;
        while (i < cg_c3_n && i < 64) {
            char bas[8][32];
            int nb = cg_c3_split(cg_c3_bas[i], bas, 8);
            if (nb > 1) {
                /* `class D(B, C)`: B's `super()` is C, C's stays its own
                 * base (A) -- enough to chain D -> B -> C -> A. */
                int k = 0;
                while (k + 1 < nb) {
                    int bi = cg_c3_find(bas[k]);
                    if (bi >= 0 && cg_c3_sup[bi][0] == 0) {
                        d_strncpy(cg_c3_sup[bi], bas[k+1], 31); cg_c3_sup[bi][31] = 0;
                    }
                    k++;
                }
            }
            i++;
        }
    }
    /* `class B(A)` whose MRO-next base is C (because of `class D(B, C)`) emits
     * `super().method()` as a call to `C_method`, but C used to be emitted AFTER
     * B: the class registry (`cg_cls_nmeth`) is only filled while classes are
     * EMITTED, so `cg_cls_hasm("C", ...)` was still empty and B's `super()`
     * came out as `((void)0)` (60_comprehensive check 8).  Emit the class
     * bodies in an order where every declared base AND every MRO-next base
     * precedes its user, so a `super()` target is always registered -- and its
     * method definition already emitted -- before the caller.  Stable Kahn over
     * the top-level class nodes only, so a program without multiple inheritance
     * keeps its exact source order. */
    static IRNode* cg_c3_node[128];
    static int cg_c3_dep[128*16];
    static int cg_c3_ndep[128];
    static int cg_c3_inslot(const int* ord, int n, int id) {
        int i = 0;
        while (i < n) { if (ord[i] == id) return 1; i++; }
        return 0;
    }
    static void cg_c3_reorder(IRNode* prog) {
        int has = 0;
        int i = 0;
        while (i < cg_c3_n) { if (cg_c3_sup[i][0]) { has = 1; break; } i++; }
        if (!has || !prog) return;
        int slot[128];
        int order[128];
        int nslot = 0;
        i = 0;
        while (i < 128) { cg_c3_ndep[i] = 0; i++; }
        i = 0;
        while (i < prog->nchildren) {
            IRNode* c = prog->children[i];
            if (c && d_strcmp(c->type,"CLASS_DEF")==0 && c->value && c->value[0] && nslot < 128) {
                int cid = cg_c3_find(c->value);
                if (cid >= 0) {
                    slot[nslot] = i; order[nslot] = cid; cg_c3_node[cid] = c; nslot = nslot + 1;
                }
            }
            i++;
        }
        int k = 0;
        while (k < nslot) {
            int v = order[k];
            const char* bs = cg_c3_bas[v];
            int p = 0;
            while (bs[p] && cg_c3_ndep[v] < 16) {
                char nb[32];
                int q = 0;
                while (bs[p] && bs[p] != ',' && q < 31) { nb[q] = bs[p]; q++; p++; }
                nb[q] = 0;
                if (bs[p] == ',') p++;
                if (nb[0]) {
                    int bid = cg_c3_find(nb);
                    if (bid >= 0 && bid != v && cg_c3_inslot(order, nslot, bid)) {
                        cg_c3_dep[v*16 + cg_c3_ndep[v]] = bid; cg_c3_ndep[v] = cg_c3_ndep[v] + 1;
                    }
                }
            }
            if (cg_c3_sup[v][0] && cg_c3_ndep[v] < 16) {
                int sid = cg_c3_find(cg_c3_sup[v]);
                if (sid >= 0 && sid != v && cg_c3_inslot(order, nslot, sid)) {
                    cg_c3_dep[v*16 + cg_c3_ndep[v]] = sid; cg_c3_ndep[v] = cg_c3_ndep[v] + 1;
                }
            }
            k++;
        }
        int placed[128];
        i = 0;
        while (i < 128) { placed[i] = 0; i++; }
        int cnt = 0;
        int guard = 0;
        while (cnt < nslot && guard < 4096) {
            int picked = -1;
            int m = 0;
            guard = guard + 1;
            while (m < nslot && picked < 0) {
                int v = order[m];
                if (!placed[v]) {
                    int ok = 1;
                    int d = 0;
                    while (d < cg_c3_ndep[v]) {
                        if (!placed[cg_c3_dep[v*16 + d]]) { ok = 0; break; }
                        d++;
                    }
                    if (ok) picked = m;
                }
                m++;
            }
            if (picked < 0) break;
            placed[order[picked]] = 1;
            if (picked != cnt) {
                int tmp = order[picked];
                int j = picked;
                while (j > cnt) { order[j] = order[j-1]; j--; }
                order[cnt] = tmp;
            }
            cnt = cnt + 1;
        }
        k = 0;
        while (k < nslot) { prog->children[slot[k]] = cg_c3_node[order[k]]; k++; }
    }
    static void cg_ob_walk(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            const IRNode* rhs = a->children[1];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) {
                if (cg_is_list_node(rhs)) cg_ob_reg_lit(rhs, lhs->value);
                cg_ob_reg_sort(lhs, rhs);
                /* `f = fields(Cls)` is a list of Field objects */
                if (rhs && d_strcmp(rhs->type,"CALL")==0 && rhs->value &&
                    d_strcmp(rhs->value,"fields")==0 && cg_ob_lookup(lhs->value) < 0) {
                    const IRNode* _fb = cg_ob_cbody("Field");
                    if (_fb) {
                        int _fnc = 0; char _fcb[256]; int _fki[8];
                        int _fmi = 0;
                        while (_fmi < _fb->nchildren) {
                            const IRNode* _fmc = _fb->children[_fmi];
                            if (d_strcmp(_fmc->type,"FUNCTION_DEF")==0 && _fmc->nchildren>1)
                                cg_ob_collect(_fmc->children[1], _fcb, &_fnc, 8);
                            _fmi++;
                        }
                        int _fc = 0;
                        while (_fc < _fnc) {
                            int _ft2 = cg_cls_ftype(_fb, _fcb + _fc*32);
                            _fki[_fc] = (_ft2 == 2) ? 2 : ((_ft2 == 3) ? 3 : 0);
                            _fc++;
                        }
                        if (_fnc > 0) {
                            cg_ob_add_cols(lhs->value, -1, _fcb, _fki, _fnc, "Field");
                            cg_note_list(lhs->value, 64, 0);
                        }
                    }
                }
                /* remember `v = <Cls>(...)` / `v = <mod>.<Cls>(...)` */
                if (rhs && d_strcmp(rhs->type,"CALL")==0 && rhs->value) {
                    if (d_strcmp(rhs->value,"COMPLEX")!=0) {
                        cg_ob_note_var(lhs->value, rhs->value);
                    } else if (rhs->nchildren>0 && rhs->children[0] &&
                               d_strcmp(rhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                               rhs->children[0]->value) {
                        cg_ob_note_var(lhs->value, rhs->children[0]->value);
                    }
                }
            }
        }
        /* `objs.append(Obj(...))` makes `objs` an object list too. */
        if (d_strcmp(a->type,"CALL")==0 && a->value && d_strcmp(a->value,"COMPLEX")==0 &&
            a->nchildren > 1 && a->children[0] &&
            d_strcmp(a->children[0]->type,"MEMBER_ACCESS")==0 &&
            a->children[0]->value && d_strcmp(a->children[0]->value,"append")==0 &&
            a->children[0]->nchildren > 0 && a->children[0]->children[0] &&
            d_strcmp(a->children[0]->children[0]->type,"IDENTIFIER")==0) {
            const char* _apn = a->children[0]->children[0]->value;
            if (cg_ob_lookup(_apn) < 0 && cg_ob_reg_append(a, _apn) >= 0)
                cg_note_list(_apn, 64, 0);
        }
        int i = 0;
        while (i < a->nchildren) { cg_ob_walk(a->children[i]); i++; }
    }
    /* `objs[i].m(...)` / `f(objs[i])`: an element only exists as columns, so
     * gather it into the class scratch object and hand out its address. */
    static void cg_ob_emit_getters(CGen* g) {
        int li = 0;
        while (li < cg_ob_cnt) {
            int gi = cg_scratch2_find(cg_ob_lcls[li]);
            if (gi >= 0) {
                char gtb[32];
                char gnm[32];
                cg_scratch2_name(gi, gtb);
                cg_ob_getname(li, gnm);
                cg_put(g, "static "); cg_put(g, cg_ob_lcls[li]); cg_put(g, "* ");
                cg_put(g, gnm); cg_put(g, "(int i) { ");
                int c = 0;
                while (c < cg_ob_lncol[li]) {
                    cg_put(g, gtb); cg_put(g, "."); cg_put(g, cg_ob_lcol[li*8 + c]);
                    cg_put(g, " = "); cg_put(g, cg_ob_lcn[li*8 + c]); cg_put(g, "[i]; ");
                    c++;
                }
                cg_put(g, "return &"); cg_put(g, gtb); cg_put(g, "; }\n");
            }
            li++;
        }
    }
    /* Register every object list in the program, BEFORE anything is emitted:
     * the column arrays are declared at file scope in the declaration pass. */
    static void cg_ob_scan(const IRNode* prog) {
        if (!prog) return;
        cg_ob_cnt = 0;
        cg_ob_vn = 0;
        cg_ag_cnt = 0;
        cg_mc_cnt = 0;
        cg_ob_srl = 0;
        cg_ob_ncls = 0;
        int i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"CLASS_DEF")==0 && n->value && n->value[0] && cg_ob_ncls < 128) {
                d_strncpy(cg_ob_cn[cg_ob_ncls], n->value, 31);
                cg_ob_cn[cg_ob_ncls][31] = 0;
                cg_ob_cbd[cg_ob_ncls] = n->nchildren>0 ? n->children[0] : NULL;
                cg_ob_ncls = cg_ob_ncls + 1;
            }
            i++;
        }
        cg_ob_walk(prog);
    }
    static void cg_scan_list_names_m(const IRNode* a, const char* fname, int fstr, const IRNode* fbody) {
        /* The enclosing function body is needed by the `x = []` / `x.append(s)`
         * pair below, and that test runs before the FUNCTION_DEF branch that
         * would otherwise set up the per-body values.  Declaring them first is
         * what makes a method-local string accumulator (`cur = ""` ...
         * `out.append(cur)`) visible: reading `nb` after its original
         * declaration point saw an uninitialised slot, so `out` stayed
         * `int out[64]` while every element was a `char*`. */
        const char* nf = fname;
        int ns = fstr;
        const IRNode* nb = fbody;
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            const IRNode* rhs = a->children[1];
            if (lhs && cg_is_list_node(lhs)) {
                int si = 0;
                while (si < lhs->nchildren) {
                    if (lhs->children[si] && d_strcmp(lhs->children[si]->data_type, "STAR") == 0) {
                        cg_note_list(lhs->children[si]->value, 64, 0);
                    }
                    si++;
                }
            }
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && cg_is_list_node(rhs)) {
                int isf = 0;
                int k = 0;
                cg_dedup_set((IRNode*)rhs);
                while (k < rhs->nchildren) { if (cg_scan_float(rhs->children[k])) isf = 1; k++; }
                cg_note_list(lhs->value, rhs->nchildren, isf);
                /* A list literal holding a string is backed by a `char*` array
                 * (see the list-assignment emitter), so the name has to be a
                 * known string list too: otherwise `names[0]` printed the
                 * address of the string and `for n in names` bound a raw
                 * pointer -- only `print(names)` looked right, because that
                 * path reads the element type off the literal itself. */
                int hs2 = 0;
                k = 0;
                while (k < rhs->nchildren) {
                    if (cg_node_is_str_static(rhs->children[k])) hs2 = 1;
                    k++;
                }
                if (hs2) cg_note_strlist(lhs->value);
                /* Object lists: `objs = [Obj("b", 2), ...]` keeps one column
                 * array per instance attribute, and `d = sorted(objs, key=...)`
                 * gets its own copy of those columns.  Registering here (not
                 * only at emission time) means the declaration pass sees them. */
                if (cg_ob_reg_lit(rhs, lhs->value) < 0 && cg_ob_lookup(lhs->value) < 0)
                    cg_ob_reg_sort(lhs, rhs);
            }
            /* `parts = s.split(sep)` builds a list of strings */
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && rhs &&
                d_strcmp(rhs->type,"CALL")==0 && d_strcmp(rhs->value,"COMPLEX")==0 &&
                rhs->nchildren>0 && d_strcmp(rhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                (d_strcmp(rhs->children[0]->value,"split")==0 ||
                 d_strcmp(rhs->children[0]->value,"rsplit")==0)) {
                cg_note_strlist(lhs->value);
            }
            /* `r = self._r.__next__()` / `rows = od.keys()`: a method whose
             * body builds a list publishes its elements through the shared
             * array -- and a list of strings through the string buffer -- so
             * the destination has to carry that element type before the dict
             * pass below types `d[self.fieldnames[i]] = r[i]` from it, and
             * before the declaration pass writes the name out. */
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && rhs &&
                d_strcmp(rhs->type,"CALL")==0 && d_strcmp(rhs->value,"COMPLEX")==0 &&
                rhs->nchildren>0 && rhs->children[0] &&
                d_strcmp(rhs->children[0]->type,"MEMBER_ACCESS")==0) {
                int sls = 0;
                if (cg_mcall_ret_list(rhs, &sls)) {
                    if (sls) cg_note_strlist(lhs->value);
                    else cg_note_list(lhs->value, 512, 0);
                } else {
                    int mdi = cg_mrd_find(rhs->children[0]->value);
                    if (mdi >= 0) cg_note_dict(lhs->value, cg_mrd_vf[mdi], cg_mrd_kf[mdi]);
                }
            }
            /* `b = a.copy()` duplicates a list; the target is a list of the
             * same element kind and needs its own backing array plus `_n`. */
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && rhs &&
                d_strcmp(rhs->type,"CALL")==0 && d_strcmp(rhs->value,"COMPLEX")==0 &&
                rhs->nchildren>0 && d_strcmp(rhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                d_strcmp(rhs->children[0]->value,"copy")==0 &&
                rhs->children[0]->nchildren>0 &&
                d_strcmp(rhs->children[0]->children[0]->type,"IDENTIFIER")==0 &&
                cg_list_index(rhs->children[0]->children[0]->value) >= 0) {
                int cf = cg_list_flags_at(rhs->children[0]->children[0]->value);
                cg_note_list(lhs->value, 64, cf);
                if (cf == 2) cg_note_strlist(lhs->value);
            }
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && rhs &&
                d_strcmp(rhs->type,"CALL")==0 &&
                (d_strcmp(rhs->value,"list")==0 || d_strcmp(rhs->value,"tuple")==0 || d_strcmp(rhs->value,"set")==0)) {
                int isf = 0;
                int is_str = 0;
                if (rhs->nchildren > 0) {
                    const IRNode* arg = rhs->children[0];
                    if (cg_is_list_node(arg)) {
                        int k = 0;
                        while (k < arg->nchildren) {
                            if (cg_scan_float(arg->children[k])) isf = 1;
                            if (cg_node_is_str_static(arg->children[k])) is_str = 1;
                            k++;
                        }
                    } else if (cg_node_is_str_static(arg)) {
                        is_str = 1;
                    }
                }
                cg_note_list(lhs->value, 64, is_str ? 2 : (isf ? 1 : 0));
                if (is_str) cg_note_strlist(lhs->value);
                if (d_strcmp(rhs->value,"tuple")==0) cg_note_tuple(lhs->value);
            }
            /* `t = astuple(obj)`: a mixed tuple assigned from the fields */
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && rhs &&
                d_strcmp(rhs->type,"CALL")==0 && rhs->value &&
                d_strcmp(rhs->value,"astuple")==0) {
                cg_note_list(lhs->value, 64, 0);
                cg_note_tuple(lhs->value);
                cg_note_mixed(lhs->value);
            }
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && rhs &&
                d_strcmp(rhs->type,"CALL")==0 && rhs->nchildren>0 &&
                rhs->children[0] && d_strcmp(rhs->children[0]->type,"MEMBER_ACCESS")==0 &&
                d_strcmp(rhs->children[0]->value,"unpack")==0) {
                cg_note_dptr(lhs->value);
            }
        }
        /* `args = e.args` (an exception binding): declare the name as a
         * FILE-SCOPE string list, because the read usually happens AFTER the
         * handler block closes.  Emitting the declaration from the assignment
         * site cannot work -- write and read are in different scopes. */
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1 &&
            a->children[0] && d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
            a->children[1] && d_strcmp(a->children[1]->type,"MEMBER_ACCESS")==0 &&
            d_strcmp(a->children[1]->value,"args")==0 &&
            a->children[1]->nchildren>0 &&
            d_strcmp(a->children[1]->children[0]->type,"IDENTIFIER")==0 &&
            cg_is_exc_var(a->children[1]->children[0]->value)) {
            cg_note_list(a->children[0]->value, 64, 2);
            cg_note_strlist(a->children[0]->value);
        }
        if (d_strcmp(a->type, "CALL") == 0 && d_strcmp(a->value, "COMPLEX") == 0 &&
            a->nchildren > 0 && d_strcmp(a->children[0]->type, "MEMBER_ACCESS") == 0 &&
            d_strcmp(a->children[0]->value, "append") == 0 && a->children[0]->nchildren > 0) {
            const IRNode* recv = a->children[0]->children[0];
            const IRNode* arg = a->nchildren > 1 ? a->children[1] : NULL;
            if (recv && d_strcmp(recv->type, "IDENTIFIER") == 0 && recv->value && arg) {
                if (cg_node_is_str_static(arg) || cg_is_str_node(arg) ||
                    (d_strcmp(arg->type, "IDENTIFIER") == 0 &&
                     (cg_name_is_str(arg->value) ||
                      /* an accumulator built from string literals inside the SAME
                       * function: `cur = ""` ... `out.append(cur)`.  The global
                       * string table is filled by the return-type scans, which
                       * only walk module-level defs, so a method local never made
                       * it there and `out` was declared `int out[64]` while its
                       * elements were `char*` (50_csv read empty rows). */
                      cg_body_str_local(nb, arg->value) ||
                      (fstr && fname && d_strcmp(arg->value, fname) == 0)))) {
                    cg_note_strlist(recv->value);
                }
                /* `rows.append((a, b))`: python stores the tuple, this backend
                 * has no tuple values, so the row lives in the parallel key
                 * arrays.  The flag has to be set here, in the pre-scan: the
                 * emitters consult it long before the body is walked and a
                 * list that is only ever built by appending has no literal
                 * whose shape could give it away. */
                if (d_strcmp(arg->type,"BLOCK")==0 &&
                    d_strcmp(arg->value,"TUPLE")==0 && arg->nchildren >= 1) {
                    cg_note_trow(recv->value);
                    int _ak = 0;
                    while (_ak < arg->nchildren && _ak < 2) {
                        if (cg_node_is_str_static(arg->children[_ak]) ||
                            cg_is_str_node(arg->children[_ak]))
                            cg_note_rowkey(recv->value, 1 << (_ak + 2));
                        else
                            cg_note_rowkey(recv->value, 1 << _ak);
                        _ak++;
                    }
                }
            }
        }
        /* a `for` over a string-valued iterable binds its target to a string
         * for the whole body; a function body is a separate scope */
        if (d_strcmp(a->type, "FUNCTION_DEF") == 0) {
            nf = NULL; ns = 0;
            nb = a->nchildren > 1 ? a->children[1] : NULL;
        }
        else if (d_strcmp(a->type, "FOR") == 0 && a->nchildren >= 2) {
            const IRNode* v = a->children[0];
            if (v && d_strcmp(v->type, "IDENTIFIER") == 0 && v->value &&
                cg_for_iter_str(a->children[1])) { nf = v->value; ns = 1; }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_list_names_m(a->children[i], nf, ns, nb); i++; }
    }
    static void cg_scan_list_names(const IRNode* a) { cg_scan_list_names_m(a, NULL, 0, NULL); }
    /* Register every float-valued function in the program, in source order so
     * that a later definition can be reached through an earlier one. */
    /* python `global name` makes the name module-scoped so it survives
     * across calls; collect them for the header */
    static char cg_gnames[512][64];
    static int cg_gn;
    static void cg_gscan_record(const char* nm) {
        if (!nm || !nm[0]) return;
        if (d_strcmp(nm, "print") == 0 || d_strcmp(nm, "len") == 0 || d_strcmp(nm, "range") == 0 ||
            d_strcmp(nm, "str") == 0 || d_strcmp(nm, "int") == 0 || d_strcmp(nm, "float") == 0 ||
            d_strcmp(nm, "bool") == 0 || d_strcmp(nm, "sys") == 0 || d_strcmp(nm, "self") == 0 ||
            d_strcmp(nm, "True") == 0 || d_strcmp(nm, "False") == 0 || d_strcmp(nm, "None") == 0 ||
            d_strcmp(nm, "NULL") == 0 || d_strcmp(nm, "check") == 0) return;
        /* the shared list-return buffer has its own declaration */
        if (d_strcmp(nm,"drygon_rl")==0 || d_strcmp(nm,"drygon_rl_n")==0) return;
        if (cg_is_dyn_list(nm) || cg_is_dict(nm) || cg_is_class(nm) || cg_prog_find(nm) >= 0 || cg_name_is_float(nm)) return;
        /* skip companion variables (_n count, _k/_v) for known list/dict vars */
        {
            int nl = d_strlen(nm);
            if (nl > 2 && nm[nl-2] == '_' && nm[nl-1] == 'n') {
                char base[64]; int bl = nl-2; if (bl > 63) bl = 63;
                d_strncpy(base, nm, bl); base[bl] = '\0';
                if (cg_is_dyn_list(base) || cg_is_dict(base)) return;
            }
            if (nl > 2 && nm[nl-2] == '_' && (nm[nl-1] == 'k' || nm[nl-1] == 'v')) {
                char base[64]; int bl = nl-2; if (bl > 63) bl = 63;
                d_strncpy(base, nm, bl); base[bl] = '\0';
                if (cg_is_dict(base)) return;
            }
        }
        int j = 0;
        while (j < cg_gn) {
            if (d_strcmp(cg_gnames[j], nm) == 0) return;
            j++;
        }
        if (cg_gn < 512) {
            d_strncpy(cg_gnames[cg_gn], nm, 63);
            cg_gnames[cg_gn][63] = 0;
            cg_gn++;
        }
    }
    static void cg_gscan_add(const IRNode* n) {
        int i;
        if (!n) return;
        if (d_strcmp(n->type,"GLOBAL_DECL")==0) {
            for (i=0;i<n->nchildren;i++) {
                cg_gscan_record(n->children[i]->value);
            }
            return;
        }
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren > 0) {
            const IRNode* lhs = n->children[0];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0) {
                cg_gscan_record(lhs->value);
                /* A local bound to a call whose method hands back a `char*`
                 * (logging's `levelname = self.name_of(lv)`) is a string, so it
                 * must be declared as one: as an `int` the pointer was truncated
                 * and the level name reached the handler as garbage.  The method
                 * table is complete by the time this runs (class bodies are
                 * emitted first). */
                if (n->nchildren > 1 && cg_mrs_call(n->children[1]))
                    cg_note_str(lhs->value);
            } else if (lhs && cg_is_list_node(lhs)) {
                for (i=0;i<lhs->nchildren;i++) {
                    if (lhs->children[i] && d_strcmp(lhs->children[i]->type,"IDENTIFIER")==0) {
                        cg_gscan_record(lhs->children[i]->value);
                    }
                }
            }
        }
        if (d_strcmp(n->type,"FOR")==0 && n->nchildren > 0) {
            const IRNode* it = n->children[0];
            if (it && d_strcmp(it->type,"IDENTIFIER")==0) {
                cg_gscan_record(it->value);
            } else if (it && cg_is_list_node(it)) {
                for (i=0;i<it->nchildren;i++) {
                    if (it->children[i] && d_strcmp(it->children[i]->type,"IDENTIFIER")==0) {
                        cg_gscan_record(it->children[i]->value);
                    }
                }
            }
        }
        for (i=0;i<n->nchildren;i++) cg_gscan_add(n->children[i]);
    }
    /* Names bound to a LIST-RETURNING call (`words = fizzbuzz(n)`): the callee
     * fills the shared result buffer and the caller copies it out, so the
     * destination must already be a declared list of the right element type
     * when the declarations are printed -- and it must be known before the
     * body is emitted, because the copy assigns straight into `x[i]`. */
    static void cg_scan_ret_calls(const IRNode* a, int depth) {
        if (!a || depth > 24) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren == 2) {
            const IRNode* lhs = a->children[0];
            const IRNode* rhs = a->children[1];
            if (lhs && rhs && d_strcmp(lhs->type,"IDENTIFIER")==0 &&
                d_strcmp(rhs->type,"CALL")==0 && rhs->value &&
                d_strcmp(rhs->value,"COMPLEX")!=0 && cg_fn_is_list(rhs->value)) {
                int ls = cg_fn_ret_strlist(rhs->value);
                cg_note_list(lhs->value, 512, ls ? 2 : 0);
                if (ls) cg_note_strlist(lhs->value);
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_ret_calls(a->children[i], depth + 1); i++; }
    }
    /* A function's own body can prove that a parameter holds a string even when
     * no call site in the program passes a literal there: `def cut(s): return
     * s[0:3]` is reached through `cut(field)` where `field` is a plain local, so
     * the call-site scan saw nothing and the parameter was emitted `int`, which
     * truncated the pointer (50_csv split helpers, 23_pathlib parts).  These
     * body shapes are unambiguous string uses. */
    static int cg_str_use_of(const IRNode* nn, const char* nm) {
        if (!nn || !nm || !nm[0]) return 0;
        if (d_strcmp(nn->type,"SLICE")==0 && nn->nchildren>0 &&
            nn->children[0] && d_strcmp(nn->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->value,nm)==0) return 1;
        if (d_strcmp(nn->type,"BINARY_OP")==0 && nn->nchildren>1 &&
            (d_strcmp(nn->value,"+")==0 || d_strcmp(nn->value,"==")==0 ||
             d_strcmp(nn->value,"!=")==0)) {
            const IRNode* l = nn->children[0];
            const IRNode* r = nn->children[1];
            int lis = l && d_strcmp(l->type,"IDENTIFIER")==0 &&
                      d_strcmp(l->value,nm)==0;
            int ris = r && d_strcmp(r->type,"IDENTIFIER")==0 &&
                      d_strcmp(r->value,nm)==0;
            if (lis && !ris && cg_node_is_str_static(r)) return 1;
            if (ris && !lis && cg_node_is_str_static(l)) return 1;
        }
        if (d_strcmp(nn->type,"CALL")==0 && d_strcmp(nn->value,"COMPLEX")==0 &&
            nn->nchildren>0 && nn->children[0] &&
            d_strcmp(nn->children[0]->type,"MEMBER_ACCESS")==0 &&
            nn->children[0]->nchildren>0 && nn->children[0]->children[0] &&
            d_strcmp(nn->children[0]->children[0]->type,"IDENTIFIER")==0 &&
            d_strcmp(nn->children[0]->children[0]->value,nm)==0 &&
            cg_is_known_str_method(nn->children[0]->value)) return 1;
        if (cg_param_needs_str(nn, nm)) return 1;
        int i = 0;
        while (i < nn->nchildren) {
            if (cg_str_use_of(nn->children[i], nm)) return 1;
            i++;
        }
        return 0;
    }
    static void cg_scan_body_str(const IRNode* prog, const char* fname, int fi) {
        int i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"FUNCTION_DEF")==0 && n->nchildren>1 &&
                d_strcmp(n->value,fname)==0) {
                const IRNode* pr = n->children[0];
                int k = 0;
                while (pr && k < pr->nchildren && k < 8) {
                    const IRNode* pk = pr->children[k];
                    if (!cg_prog_pstr[fi * 8 + k] &&
                        !(cg_lbits(fi) & (1 << k)) &&
                        d_strcmp(pk->data_type,"VARGS")!=0 &&
                        d_strcmp(pk->data_type,"LIST")!=0 &&
                        !cg_is_dict_param(pk) &&
                        cg_str_use_of(n->children[1], pk->value)) {
                        cg_prog_pstr[fi * 8 + k] = 1;
                        cg_prog_variant[fi] = 1;
                        cg_pstr_changed = 1;
                    }
                    k++;
                }
            }
            i++;
        }
    }
    static void cg_scan_program_fns(const IRNode* prog) {
        cg_nfn_float = 0;
        cg_nprog_fns = 0;
        int i = 0;
        while (i < 256) {
            cg_prog_lmask[i] = 0; cg_prog_ltype[i] = 0; cg_prog_ldec[i] = 0;
            cg_prog_lprev[i] = 0; cg_prog_ldprev[i] = 0; cg_prog_lmprev[i] = 0;
            i++;
        }
        cg_litw_reset();
        cg_nlfor = 0;
        cg_ncall_lkeys = 0;
        cg_scls_n = 0;
        cg_nsp_vars = 0;
        cg_sp_scan(prog);
        cg_scan_cls_names(prog);
        cg_sinit_n = 0;
        cg_scan_init_names(prog);
        cg_ov_n = 0;
        cg_scan_objvars(prog);
        /* What a method hands back, and which class fields hold a `char*`, has
         * to be known before the list and dict passes run: they type
         * `self.fieldnames` and `r = self._r.__next__()` from these tables, and
         * without them the csv row dict was an int->int map (50_csv 10-13).
         * The `""`-defaulted parameter names are needed for the field shapes,
         * so they move ahead of them; neither scan resets a table, so the
         * original call sites below stay where they are. */
        cg_scan_str_defaults(prog);
        cg_scan_meth_args(prog);
        cg_scan_meth_shapes(prog);
        cg_scan_str_fields(prog);
        cg_scan_list_names(prog);
        /* Which names hold a string has to be known before anything is
         * emitted: the dict pass types `d[w] = 1` from the key expression and
         * the call-site scan decides whether `f(w)` passes a `char*`.  The
         * live table is only filled while statements are emitted, so walk the
         * source shapes first, then let the dict pass see the keys they unlock
         * (a string-keyed dict makes `for k in d` a string loop). */
        cg_scan_dict_names(prog);
        cg_scan_static_str(prog);
        cg_scan_dict_names(prog);
        cg_scan_static_str(prog);
        cg_scan_dict_names(prog);
        cg_scan_list_names(prog);
        /* The list kinds of a `self.fieldnames = self._r.__next__()` field and
         * of the `r = self._r.__next__()` local are only settled by the last
         * list pass above, so a dict store `d[self.fieldnames[i]] = r[i]` was
         * typed from tables that were still empty: the csv module's
         * `DictReader.__next__` built its row with `drygon_dset_ii` and a
         * truncated key pointer.  One more round of the pair sees the final
         * list kinds. */
        cg_scan_dict_names(prog);
        cg_scan_static_str(prog);
        cg_scan_list_names(prog);
        cg_scan_dict_names(prog);
        /* the source tables are populated now: type the keys of every dict
         * comprehension whose key came out of a dictionary or a string */
        cg_compkey_resolve();
        cg_scan_maketrans(prog);
        cg_scan_template(prog);
        cg_scan_hash_objs(prog);
        cg_scan_super_init(prog);
        cg_scan_init_args(prog);
        /* Object parameters chain: `Q(s)` types `Q.__init__`'s `f`, which is
         * what types `reader.__init__`'s `f` in that body, which is what types
         * the next hop.  One pass only ever sees the classes known before it
         * started, so repeat until the table stops growing. */
        int maround = 0;
        while (maround < 4) {
            int mbefore = cg_mps_n;
            cg_scan_meth_args(prog);
            cg_scan_str_defaults(prog);
            maround++;
            if (cg_mps_n == mbefore) break;
        }
        cg_pyc_register_lists();
        cg_nmv = 0;
        cg_mv_scan(prog);
        i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"FUNCTION_DEF")==0) {
                if (n->nchildren>1 && cg_scan_float(n->children[1])) cg_note_fn_float(n->value);
                int fi = cg_prog_add(n->value);
                if (fi >= 0) {
                    const IRNode* pr = n->nchildren>0 ? n->children[0] : NULL;
                    cg_prog_nparams[fi] = pr ? pr->nchildren : 0;
                    if (n->nchildren>1) {
                        cg_scope_enter_m(n, cg_fn_base_mask(n->value));
                        cg_prog_retstr[fi] = cg_ret_str_scan(n->children[1]) ? 1 : 0;
                        cg_prog_retlist[fi] = cg_ret_list_scan(n->children[1]) ? 1 : 0;
                        cg_prog_retsls[fi] = cg_ret_strlist_of(n->children[1]) ? 1 : 0;
                        if (cg_prog_retsls[fi]) cg_mark_retlist_str(n->children[1]);
                        {
                            int _dkf = 0; int _dvf = 0;
                            cg_prog_retdict[fi] = cg_ret_dict_scan(n->children[1], &_dkf, &_dvf) ? 1 : 0;
                            cg_prog_retdictkf[fi] = _dkf;
                            cg_prog_retdictvf[fi] = _dvf;
                            if (cg_prog_retdict[fi]) cg_prog_retlist[fi] = 0;
                        }
                        cg_scope_exit();
                    }
                }
            }
            i++;
        }
        cg_scan_ret_calls(prog, 0);
        /* The element type of a list parameter is recovered by refining the
         * call-site types until they stop moving: the first site to name a list
         * settles the inferred type, a site that disagrees gets its own body. */
        int it = 0;
        while (it < 3) {
            cg_ltypes_snapshot();
            int z = 0;
            while (z < 256) {
                cg_prog_lmask[z] = 0; cg_prog_ltype[z] = 0; cg_prog_ldec[z] = 0;
                z++;
            }
            cg_scan_ltypes(prog, -1, NULL);
            it++;
        }
        cg_ltypes_snapshot();
        /* The method-parameter list shapes are refined a round at a time: a
         * round sees the 2D parameters the previous round proved (a row of one
         * of them handed to another list parameter), so repeat until the set
         * of 2D parameters stops growing. */
        int mr = 0;
        cg_scan_twod_names(prog);
        cg_scan_mparam_names(prog);
        while (mr < 4) {
            cg_t2_snapshot();
            cg_t2_reset();
            cg_scan_meth_listargs(prog, NULL, 0);
            cg_scan_meth_listargs(prog, NULL, 1);
            if (cg_t2_n == cg_t2_nprev) {
                int same = 1;
                int z = 0;
                while (z < cg_t2_n) {
                    if (d_strcmp(cg_t2_names[z], cg_t2_prev[z]) != 0) { same = 0; break; }
                    z++;
                }
                if (same) break;
            }
            mr++;
        }
        /* second pass: which parameters take a string, which take a list, and
         * of what element type?  A `char*` that only becomes known from a
         * caller further down the source has to reach the callee too (`def a(n):
         * return "x" + n` called from `def b(n): return a(n)`), so repeat until
         * the string bits stop spreading. */
        int sp_round = 0;
        while (sp_round < 4) {
            cg_pstr_changed = 0;
            i = 0;
            while (i < cg_nprog_fns) {
                char nm[64];
                int base = i * 64;
                int j = 0;
                while (j < 63 && cg_prog_fns[base + j]) { nm[j] = cg_prog_fns[base + j]; j++; }
                nm[j] = 0;
                cg_scan_list_args(prog, nm, i, -1, NULL);
                cg_scan_calls(prog, nm, i);
                cg_scan_body_str(prog, nm, i);
                i++;
            }
            if (!cg_pstr_changed) break;
            sp_round++;
        }
        /* drop parameters that the body uses arithmetically */
        i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"FUNCTION_DEF")==0 && n->nchildren>1) {
                int fi = cg_prog_find(n->value);
                const IRNode* pr = n->nchildren>0 ? n->children[0] : NULL;
                if (fi >= 0 && pr) {
                    int k = 0;
                    while (k < pr->nchildren && k < 8) {
                        if (cg_prog_pstr[fi * 8 + k] && (cg_ua_body = n->children[1],
                        cg_used_arith(n->children[1], pr->children[k]->value)))
                            cg_prog_pstr[fi * 8 + k] = 0;
                        k++;
                    }
                }
            }
            i++;
        }
        /* The inferred signature is the one every call site matching it uses
         * directly; a call site whose argument types disagree gets its own
         * body, emitted as `<name>__<mask>`.  Drop masks equal to the base. */
        i = 0;
        while (i < cg_nprog_fns) {
            char bnm[64];
            int b2 = i * 64;
            int j2 = 0;
            while (j2 < 63 && cg_prog_fns[b2 + j2]) { bnm[j2] = cg_prog_fns[b2 + j2]; j2++; }
            bnm[j2] = 0;
            int base = cg_fn_base_mask(bnm);
            int out = 0;
            int k = 0;
            while (k < cg_prog_nmask[i]) {
                int mk = cg_prog_masks[i * CG_NMASK + k];
                int mf = cg_prog_fmask[i * CG_NMASK + k];
                if (mk != base || mf != 0) {
                    cg_prog_masks[i * CG_NMASK + out] = mk;
                    cg_prog_fmask[i * CG_NMASK + out] = mf;
                    out++;
                }
                k++;
            }
            cg_prog_nmask[i] = out;
            i++;
        }
        /* Return type per signature: a `char*` parameter makes `a + b` a
         * concatenation, so `return a + b` is a string only for the signatures
         * that take strings there. */
        int rround = 0;
        while (rround < 4) {
        int rchanged = 0;
        i = 0;
        while (i < prog->nchildren) {
            const IRNode* n = prog->children[i];
            if (d_strcmp(n->type,"FUNCTION_DEF")==0 && n->nchildren>1) {
                int fi = cg_prog_find(n->value);
                const IRNode* pr = n->nchildren>0 ? n->children[0] : NULL;
                if (fi >= 0) {
                    cg_scope_enter(n);
                    { int nv = cg_ret_str_scan(n->children[1]); if (nv != cg_prog_retstr[fi]) rchanged = 1; cg_prog_retstr[fi] = nv; }
                    /* The body's `return xs` can hand back a list, but the
                     * parameter is only known to be one from its signature:
                     * note the list parameters here so the return scan sees
                     * them, then drop the notes again. */
                    int _slp0 = cg_nlp_vars;
                    int _bm0 = cg_fn_base_mask(n->value);
                    int _p0 = 0;
                    while (pr && _p0 < pr->nchildren) {
                        if (_bm0 & (1 << (8 + _p0)))
                            cg_note_lparam(pr->children[_p0]->value, cg_mask_ltype(_bm0, _p0));
                        else if (d_strcmp(pr->children[_p0]->data_type,"VARGS")==0 ||
                                 d_strcmp(pr->children[_p0]->data_type,"LIST")==0)
                            /* `def f(*args): return args` -- the varargs name is
                             * a list the emission notes as a list parameter, so
                             * the return scan has to see it too or the list
                             * result buffer is never declared. */
                            cg_note_lparam(pr->children[_p0]->value, 0);
                        _p0++;
                    }
                    cg_prog_retlist[fi] = cg_ret_list_scan(n->children[1]);
                    cg_prog_retsls[fi] = cg_ret_strlist_of(n->children[1]) ? 1 : 0;
                    if (cg_prog_retsls[fi]) cg_mark_retlist_str(n->children[1]);
                    {
                        int _dkf = 0; int _dvf = 0;
                        cg_prog_retdict[fi] = cg_ret_dict_scan(n->children[1], &_dkf, &_dvf) ? 1 : 0;
                        cg_prog_retdictkf[fi] = _dkf;
                        cg_prog_retdictvf[fi] = _dvf;
                        if (cg_prog_retdict[fi]) cg_prog_retlist[fi] = 0;
                    }
                    cg_ret_shape_fill(fi, n->children[1], pr);
                    cg_nlp_vars = _slp0;
                    cg_scope_exit();
                    /* the inferred signature may take a `double` list, so the
                     * base body's `return xs[0]` is floating too */
                    {
                        int bm = cg_fn_base_mask(n->value);
                        int sfb = cg_nfloat_vars;
                        int slb = cg_nlp_vars;
                        int flb = 0;
                        int p = 0;
                        while (pr && p < pr->nchildren) {
                            if (bm & (1 << (8 + p))) {
                                int lt = cg_mask_ltype(bm, p);
                                cg_note_lparam(pr->children[p]->value, lt);
                                if (lt == 1) flb = 1;
                            }
                            p++;
                        }
                        if (flb) cg_prog_basefret[fi] = cg_ret_float_scan(n->children[1]);
                        cg_nfloat_vars = sfb;
                        cg_nlp_vars = slb;
                    }
                    int k = 0;
                    while (k < cg_prog_nmask[fi]) {
                        int mk = cg_prog_masks[fi * CG_NMASK + k];
                        /* the signature decides which parameters are text, so
                         * each one is read in its own scope */
                        cg_scope_enter_m(n, mk);
                        cg_prog_maskret[fi * CG_NMASK + k] = cg_ret_str_scan(n->children[1]);
                        cg_scope_exit();
                        /* a variant that takes a float declares that parameter
                         * `double`, so whether its `return` is floating has to
                         * be read with the parameter known to be a double; the
                         * same holds for a `double` list parameter */
                        int mf = cg_prog_fmask[fi * CG_NMASK + k];
                        int sf = cg_nfloat_vars;
                        int sl = cg_nlp_vars;
                        int flb2 = 0;
                        int p = 0;
                        while (pr && p < pr->nchildren) {
                            if (mf & (1 << p)) cg_note_float(pr->children[p]->value);
                            if (mk & (1 << (8 + p))) {
                                int lt = cg_mask_ltype(mk, p);
                                cg_note_lparam(pr->children[p]->value, lt);
                                if (lt == 1) flb2 = 1;
                            }
                            p++;
                        }
                        /* the return type of a python function depends on the
                         * body, not on the parameter types: a variant whose
                         * body returns a float has to be declared `double`
                         * (the int-list variant of `def total(xs)` that
                         * accumulates into a float still returns a float) */
                        cg_prog_maskfret[fi * CG_NMASK + k] =
                            cg_ret_float_scan(n->children[1]);
                        cg_nfloat_vars = sf;
                        cg_nlp_vars = sl;
                        k++;
                    }
                }
            }
            i++;
        }
        if (!rchanged) break;
        rround++;
        }
        /* the all-string twin's return type is no longer tracked separately */
        i = 0;
        while (i < cg_nprog_fns) { cg_prog_vretstr[i] = 0; i++; }
        /* Emission rebuilds the string table statement by statement, so the
         * static seed is dropped here: a name reused for an int elsewhere in
         * the program must not keep printing as %s. */
        cg_nstr_vars = 0;
    }
    /* Names that hold a python list literal.  Python lists lower to C arrays
     * (`int xs[3];` at file scope, one store per element) because that is the
     * only aggregate the direct compiler can index with `xs[i]`. */
    static char cg_list_names[16384];
    static int cg_list_sizes[256];
    static int cg_list_flags[256]; /* 0 = int elements, 1 = double, 2 = char* */
    static int cg_list_flags_prescan[256]; /* saved post-prescan element types */
    static int cg_nlist_vars_prescan; /* list count at end of prescan */
    static int cg_list_mixedf[256]; /* 0 = uniform elements, 1 = mixed */
    static int cg_list_twodf[256]; /* 1 = homogeneous 2D: rows are int* */
    /* the element type of a flattened 2D list's backing row store:
     * 0 = int, 1 = char* (text rows), 2 = double.  Without this the backing
     * array was always `int`, so a string row truncated its field pointers to
     * 32 bits (`[["a","b"]]` read back as garbage addresses). */
    static int cg_list_twodk[256];
    /* `rows2 = list(reader2)` on a DictReader: a row is a DICT, so the drained
     * name cannot be a flattened int array (the value pointers truncated).
     * It carries a key array and a string value array plus per-row
     * (offset,count) pairs (50_csv checks 10-13). */
    static char cg_drl_names[64*32];
    static int cg_ndrl;
    static void cg_drl_note(const char* nm) {
        if (!nm || !nm[0] || cg_ndrl >= 64) return;
        int i = 0;
        while (i < cg_ndrl) {
            if (d_strcmp(cg_drl_names + i*32, nm)==0) return;
            i++;
        }
        d_strncpy(cg_drl_names + cg_ndrl*32, nm, 31);
        cg_drl_names[cg_ndrl*32 + 31] = 0;
        cg_ndrl = cg_ndrl + 1;
    }
    static int cg_drl_on(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_ndrl) {
            if (d_strcmp(cg_drl_names + i*32, nm)==0) return 1;
            i++;
        }
        return 0;
    }
    /* `d = rows2[i]`: a name bound to ONE dict row of a `list(DictReader)`
     * result.  The row is not a dict of its own -- it is the (key, value) run
     * the source list keeps at `_ro[i]`/`_rn[i]` -- so every `d["name"]` reads
     * through the source's flat arrays instead of the never-written `d_k/d_v`
     * triple (`d_n` was stack garbage: 50_csv check 11 segfaulted). */
    static char cg_drla_names[32][32];
    static char cg_drla_base[32][32];
    static const IRNode* cg_drla_idx[32];
    static int cg_ndrla;
    static void cg_drla_add(const char* nm, const char* bs, const IRNode* idx) {
        int i = 0;
        if (!nm || !nm[0] || !bs || !bs[0]) return;
        while (i < cg_ndrla) {
            if (d_strcmp(cg_drla_names[i], nm)==0) {
                d_strncpy(cg_drla_base[i], bs, 31); cg_drla_base[i][31] = 0;
                cg_drla_idx[i] = idx;
                return;
            }
            i++;
        }
        if (cg_ndrla >= 32) return;
        d_strncpy(cg_drla_names[cg_ndrla], nm, 31); cg_drla_names[cg_ndrla][31] = 0;
        d_strncpy(cg_drla_base[cg_ndrla], bs, 31); cg_drla_base[cg_ndrla][31] = 0;
        cg_drla_idx[cg_ndrla] = idx;
        cg_ndrla = cg_ndrla + 1;
    }
    static int cg_drla_on(const char* nm) {
        int i = 0;
        if (!nm || !nm[0]) return -1;
        while (i < cg_ndrla) {
            if (d_strcmp(cg_drla_names[i], nm)==0) return i;
            i++;
        }
        return -1;
    }
    static char* cg_drla_bname(const char* nm) {
        int i = cg_drla_on(nm);
        if (i < 0) return "";
        return cg_drla_base[i];
    }
    static const IRNode* cg_drla_inode(const char* nm) {
        int i = cg_drla_on(nm);
        if (i < 0) return (IRNode*)0;
        return cg_drla_idx[i];
    }
    static int cg_list_lxf[256]; /* 1 = some elements are list rows (repr array) */
    static int cg_nlist_vars;
    static int cg_is_list_node(const IRNode* a) {
        if (!a) return 0;
        return d_strcmp(a->type,"BLOCK")==0 && (d_strcmp(a->value,"LIST")==0 || d_strcmp(a->value,"TUPLE")==0 || d_strcmp(a->value,"SET")==0);
    }
    static void cg_note_list(const char* name, int n, int isf) {
        if (!name || !name[0]) return;
        /* a call site may already have decided the element type: passing an int
         * list where the signature says double makes it a double list */
        int fc = cg_force_list_get(name);
        if (fc >= 0) isf = fc;
        int i = 0;
        while (i < cg_nlist_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_list_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) {
                /* Do NOT let an EMPTY literal (`x = []`, flag 0) erase an
                 * element type a later scan already discovered: `keys = []`
                 * followed by `keys.append("a")` must stay a string list, or the
                 * declaration reverts to `int keys[64]` while elements are
                 * `char*`.  A non-empty note still wins, because the same name
                 * can legitimately be re-assigned a different kind of list
                 * (`t = (1,2,3)` then later `t = tuple("abc")`). */
                if (!(isf == 0 && n == 0 && cg_list_flags[i] == 2)) cg_list_flags[i] = isf;
                cg_list_sizes[i] = n;
                cg_list_mixedf[i] = 0;
                return;
            }
            i++;
        }
        if (cg_nlist_vars >= 256) return;
        int base = cg_nlist_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_list_names[base + j] = name[j]; j++; }
        cg_list_names[base + j] = 0;
        cg_list_sizes[cg_nlist_vars] = n;
        cg_list_flags[cg_nlist_vars] = isf;
        cg_list_mixedf[cg_nlist_vars] = 0;
        cg_nlist_vars = cg_nlist_vars + 1;
    }
    /* Declare and type every comprehension target the parser recorded.  The
     * element type must be known before the header is printed, so it comes
     * from the element expression alone (string-producing element -> str list,
     * float -> double list, otherwise int). */
    static void cg_pyc_register_lists(void) {
        int i = 0;
        while (i < cg_pyc_n) {
            const IRNode* el = cg_pyc_elems[i];
            int isf = 0;
            if (el) {
                if (cg_node_is_str_static(el)) isf = 2;
                else if (d_strcmp(el->type,"SLICE")==0) isf = 2;
                else if (cg_is_float_node(el)) isf = 1;
            }
            cg_note_list(cg_pyc_name(i), 64, isf);
            i++;
        }
    }
    static int cg_list_index(const char* name) {
        int i = 0;
        while (i < cg_nlist_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_list_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    /* 2D method PARAMETERS overlay the module-wide list table: a parameter's
     * row shape comes from its call sites, and the module list it collides
     * with may be a completely different shape.  50_csv has a module-level
     * `rows` (a 1D list of strings), and `writer.writerows` has a parameter
     * with the same name; the module entry kept the parameter out of the 2D
     * table, so the inner `self.writerow(rows[i])` fell through to the
     * empty-list sentinel and handed the callee a null pointer (check 7).
     * The overlay is pushed when the method's signature is emitted and
     * restored when its body is done, so it shadows the module entry for
     * exactly the span in which the parameter is visible. */
    static char cg_t2s_names[32][48];
    static int  cg_t2s_kinds[32];
    static int  cg_t2s_n = 0;
    static int  cg_t2s_find(const char* name) {
        int i = 0;
        if (!name) return -1;
        while (i < cg_t2s_n) {
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_t2s_names[i][j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    static void cg_t2s_push(const char* name, int k) {
        int i;
        if (!name || !name[0]) return;
        i = cg_t2s_find(name);
        if (i >= 0) { cg_t2s_kinds[i] = k; return; }
        if (cg_t2s_n >= 32) return;
        i = 0;
        while (i < 47 && name[i]) { cg_t2s_names[cg_t2s_n][i] = name[i]; i++; }
        cg_t2s_names[cg_t2s_n][i] = 0;
        cg_t2s_kinds[cg_t2s_n] = k;
        cg_t2s_n++;
    }
    static void cg_note_twod_k(const char* name, int k) {
        int i = cg_list_index(name);
        if (i >= 0) { cg_list_twodf[i] = 1; cg_list_twodk[i] = k; }
    }
    /* A name bound to a nested list literal (`rows = [["a","b"],["c","d"]]`)
     * is a 2D list from the moment the assignment is read, but the 2D table
     * was only filled while that assignment was EMITTED -- long after the
     * call-site scans -- so `writer.writerows(rows)` was handed a scalar
     * pointer, the callee stored one empty cell per row and the round-trip
     * compared unequal (50_csv check 26).  Registering the row kind up front
     * lets the call-site scan type the parameter exactly like a nested
     * literal already is. */
    static void cg_scan_twod_names(const IRNode* n) {
        if (!n) return;
        if (d_strcmp(n->type,"ASSIGN")==0 && n->nchildren > 1 &&
            n->children[0] && d_strcmp(n->children[0]->type,"IDENTIFIER")==0 &&
            n->children[0]->value && cg_is_list_node(n->children[1]) &&
            d_strcmp(n->children[1]->value,"LIST")==0) {
            const IRNode* r = n->children[1];
            int j = 0;
            int allrows = r->nchildren > 0;
            while (j < r->nchildren) {
                const IRNode* el = r->children[j];
                /* only LIST rows flatten into the 2D triplet; a row of TUPLEs
                 * (`pairs = [(1,"a"),(2,"b")]`, `t = ((1,2),(3,4))`) keeps its
                 * compile-time tuple repr and must not be mistaken for a 2D
                 * list of strings. */
                if (!cg_is_list_node(el) || d_strcmp(el->value,"LIST")!=0) allrows = 0;
                j++;
            }
            if (allrows) {
                /* the backing store's element type has to match the row
                 * elements: marking every nested literal as a list of STRINGS
                 * made `nested = [[1,2],[3,4]]` store an int into a char* slot
                 * and the program segfaulted (04_list, 29_copy). */
                int rk = 0;
                int allstr = 1;
                int allflt = 1;
                j = 0;
                while (j < r->nchildren) {
                    const IRNode* el = r->children[j];
                    int m = 0;
                    while (m < el->nchildren) {
                        if (!cg_node_is_str_static(el->children[m])) allstr = 0;
                        if (!cg_is_float_node(el->children[m])) allflt = 0;
                        m++;
                    }
                    j++;
                }
                if (allstr) rk = 1;
                else if (allflt) rk = 2;
                cg_t2s_push(n->children[0]->value, rk);
            }
        }
        int i = 0;
        while (i < n->nchildren) { cg_scan_twod_names(n->children[i]); i++; }
    }
    static void cg_note_twod(const char* name) { cg_note_twod_k(name, 0); }
    static int cg_list_twod_kind(const char* name) {
        int si = cg_t2s_find(name);
        if (si >= 0) return cg_t2s_kinds[si];
        int i = cg_list_index(name);
        return i >= 0 ? cg_list_twodk[i] : 0;
    }
    static void cg_note_lx(const char* name) {
        int i = cg_list_index(name);
        if (i >= 0) cg_list_lxf[i] = 1;
    }
    /* tuple-row lists: rows are tuple literals, materialized only as their
     * compile-time reprs; sorted() keys off the row elements (k0/k1 for the
     * first two int elements, s0/s1 for the first two string elements) */
    static int cg_list_trowf[256];
    /* bitmask of key tables a tuple-row list carries: bit0 k0, bit1 k1,
     * bit2 s0, bit3 s1 */
    static int cg_list_kyf[256];
    /* the row IR nodes, so a destructure `x, y = d[0]` can read the row's
     * element expressions directly */
    static const IRNode* cg_list_rowptr[16384];
    static void cg_note_trow(const char* name) {
        int i = cg_list_index(name);
        if (i >= 0) cg_list_trowf[i] = 1;
    }
    static int cg_list_is_trow(const char* name) {
        int i = cg_list_index(name);
        return i >= 0 ? cg_list_trowf[i] : 0;
    }
    static void cg_note_rowkey(const char* name, int bit) {
        int i = cg_list_index(name);
        if (i >= 0) cg_list_kyf[i] = cg_list_kyf[i] | bit;
    }
    static int cg_list_kybits(const char* name) {
        int i = cg_list_index(name);
        return i >= 0 ? cg_list_kyf[i] : 0;
    }
    static void cg_note_row(const char* name, int i, const IRNode* row) {
        int li = cg_list_index(name);
        if (li >= 0 && i >= 0 && i < 64) cg_list_rowptr[li * 64 + i] = row;
    }
    static const IRNode* cg_list_row_at(const char* name, int i) {
        int li = cg_list_index(name);
        if (li < 0 || i < 0 || i >= 64) return 0;
        return cg_list_rowptr[li * 64 + i];
    }
    static int cg_list_is_twod(const char* name) {
        if (cg_t2s_find(name) >= 0) return 1;
        int i = cg_list_index(name);
        return i >= 0 ? cg_list_twodf[i] : 0;
    }
    /* `b = copy.copy(a)` on a 2D list: python's shallow copy SHARES the inner
     * row storage, so an append through `a[0].append(v)` has to be visible
     * through `b[0]` as well.  The flattened model (one `_back` plus per-row
     * `_off`/`_ln`) has nowhere to hang that sharing, so the destination is
     * declared as POINTERS onto the source's three arrays and only its count
     * is snapshotted.  A copy must still be a distinct object for `is`
     * (29_copy check 6), so this registry stays out of cg_lalias. */
    static char cg_list_view[256][32];
    static void cg_list_view_note(const char* name, const char* src) {
        int i = cg_list_index(name);
        if (i < 0 || !src || !src[0]) return;
        { int si = cg_list_index(src);
          if (si >= 0 && cg_list_view[si][0]) src = cg_list_view[si]; }
        { int j = 0;
          while (src[j] && j < 31) { cg_list_view[i][j] = src[j]; j++; }
          cg_list_view[i][j] = 0; }
    }
    static const char* cg_list_view_src(int i) {
        if (i < 0 || i >= 256) return 0;
        return cg_list_view[i][0] ? cg_list_view[i] : 0;
    }
    /* Name lookup for the emitter: given the identifier about to be written,
     * return the name it aliases, or 0 when it is not a view. */
    static const char* cg_list_view_of(const char* name) {
        if (!name || !name[0]) return 0;
        { int i = cg_list_index(name);
          if (i < 0 || i >= 256) return 0;
          return cg_list_view[i][0] ? cg_list_view[i] : 0; }
    }
    static void cg_list_view_clear(void) {
        int i = 0;
        while (i < 256) { cg_list_view[i][0] = 0; i++; }
    }
    static int cg_list_is_lx(const char* name) {
        int i = cg_list_index(name);
        return i >= 0 ? cg_list_lxf[i] : 0;
    }
    /* compile-time python repr text for a literal row: [2, 3] */
    static void cg_lit_repr_emit(CGen* g, const IRNode* row) {
        int tp = d_strcmp(row->value,"TUPLE") == 0;
        cg_put(g, tp ? "(" : "[");
        int i = 0;
        while (i < row->nchildren) {
            if (i > 0) cg_put(g, ", ");
            const IRNode* el = row->children[i];
            if (el && d_strcmp(el->type,"CONSTANT")==0 &&
                d_strcmp(el->data_type,"STR")==0) {
                const char* v = el->value;
                int l = (int)d_strlen(v);
                cg_put(g, "'");
                int b = (l >= 2 && (v[0]=='\'' || v[0]=='"')) ? 1 : 0;
                int e = (l >= 2) ? l - 1 : l;
                int k2 = b;
                while (k2 < e) {
                    char s[2]; s[0]=v[k2]; s[1]=0;
                    cg_put(g, s);
                    k2++;
                }
                cg_put(g, "'");
            } else if (el) {
                const char* v = el->value ? el->value : "0";
                int k2 = 0;
                while (v[k2]) { char s[2]; s[0]=v[k2]; s[1]=0; cg_put(g, s); k2++; }
            }
            i++;
        }
        cg_put(g, tp ? ")" : "]");
    }
    /* names bound to `s.splitlines()` -- their count is the runtime
     * drygon_nlines_, not a C string length. */
    /* names bound by `except X as e` -- they have `<e>_arg` / `<e>_code` */
    static char cg_exc_names[32][64];
    static int cg_nexc_names = 0;
    static void cg_note_exc_name(const char* nm) {
        if (!nm || !nm[0]) return;
        int i = 0;
        while (i < cg_nexc_names) { if (d_strcmp(cg_exc_names[i], nm)==0) return; i++; }
        if (cg_nexc_names < 32) {
            d_strncpy(cg_exc_names[cg_nexc_names], nm, 63);
            cg_exc_names[cg_nexc_names][63] = 0;
            cg_nexc_names = cg_nexc_names + 1;
        }
    }
    static int cg_is_exc_var(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_nexc_names) { if (d_strcmp(cg_exc_names[i], nm)==0) return 1; i++; }
        return 0;
    }
    static char cg_lines_names[64][64];
    static int cg_nlines_names = 0;
    static void cg_note_strlist(const char* name);
    static void cg_note_lines_name(const char* nm) {
        if (!nm || !nm[0]) return;
        int i = 0;
        while (i < cg_nlines_names) {
            if (d_strcmp(cg_lines_names[i], nm) == 0) return;
            i++;
        }
        if (cg_nlines_names < 64) {
            d_strncpy(cg_lines_names[cg_nlines_names], nm, 63);
            cg_lines_names[cg_nlines_names][63] = 0;
            cg_nlines_names = cg_nlines_names + 1;
        }
        cg_note_strlist(nm);
    }
    static int cg_lines_name(const char* nm) {
        if (!nm || !nm[0]) return 0;
        int i = 0;
        while (i < cg_nlines_names) {
            if (d_strcmp(cg_lines_names[i], nm) == 0) return 1;
            i++;
        }
        return 0;
    }
    static int cg_list_size(const char* name) {
        int i = cg_list_index(name);
        if (i < 0) return -1;
        return cg_list_sizes[i];
    }
    static int cg_list_is_float(const char* name) {
        int i = cg_list_index(name);
        if (i < 0) return 0;
        return cg_list_flags[i] == 1;
    }
    static int cg_list_is_str(const char* name) {
        int i = cg_list_index(name);
        if (i < 0) return 0;
        return cg_list_flags[i] == 2;
    }
    static int cg_list_flags_at(const char* name) {
        int i = cg_list_index(name);
        if (i < 0) return 0;
        return cg_list_flags[i];
    }
    /* Returns the element type as determined by the post-prescan snapshot,
     * which reflects the LAST (and thus final-declaration) type of the var.
     * Used by cg_sl_base_et so that slice function selection matches the
     * variable declared C type (avoiding int vs char pointer stride mismatches). */
    static int cg_list_flags_prescan_at(const char* name) {
        int i = 0;
        while (i < cg_nlist_vars_prescan) {
            int base = i * 64;
            int j = 0; int eq = 1;
            while (1) {
                int ca = cg_list_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return cg_list_flags_prescan[i];
            i++;
        }
        return 0;
    }
    /* A list written with both string and non-string elements keeps its
     * element kinds in a parallel byte array so print() can quote the strings
     * and leave the numbers bare, like python. */
    static void cg_note_mixed(const char* name) {
        int i = cg_list_index(name);
        if (i < 0) return;
        cg_list_mixedf[i] = 1;
    }
    static int cg_list_is_mixed(const char* name) {
        int i = cg_list_index(name);
        if (i < 0) return 0;
        return cg_list_mixedf[i];
    }
    /* ── python dicts ─────────────────────────────────────────────────────
     * A dict literal lowers to two file-scope parallel arrays (keys and
     * values) plus a runtime count, following the list model, because a C
     * array is the only aggregate the direct compiler can index.  Element
     * types are decided by a prepass over the literal. */
    static char cg_dict_names[16384];
    static int cg_dict_vfs[256]; /* 0 int, 1 double, 2 char* */
    static int cg_dict_kfs[256]; /* 0 int, 1 char* */
    static int cg_ndict_vars;
    static char cg_das_names[64 * 64];
    static int cg_ndas;
    static int cg_dict_index(const char* name) {
        int i = 0;
        while (i < cg_ndict_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_dict_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    static int cg_is_dict(const char* name) {
        if (!name || !name[0]) return 0;
        return cg_dict_index(name) >= 0;
    }
    /* dicts built by `asdict` over a NESTED dataclass keep a heap bundle
     * (`drygon_dd_*`) in the value slot: the second subscript of
     * `d["address"]["city"]` then has a real table to index instead of walking
     * a member pointer as if it were a string (37_dataclasses check 30). */
    static int cg_das_index(const char* name) {
        int i = 0;
        while (i < cg_ndas) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_das_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    static void cg_das_add(const char* name) {
        if (!name || !name[0] || cg_ndas >= 64) return;
        if (cg_das_index(name) >= 0) return;
        int base = cg_ndas * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_das_names[base + j] = name[j]; j++; }
        cg_das_names[base + j] = 0;
        cg_ndas = cg_ndas + 1;
    }
    static int cg_das_on(const char* name) {
        if (!name || !name[0]) return 0;
        return cg_das_index(name) >= 0;
    }
    /* `d["k1"]["k2"]` on an asdict() dict whose entry is a nested bundle: the
     * read is lowered to drygon_dd_get(), so the node is a VALUE (a string),
     * never a character.  Without this the subscript chain matched
     * cg_is_char_node and `== "text"` went through drygon_chreq -- which only
     * compares ONE-character strings -- so the comparison could never hold
     * (37_dataclasses check 30). */
    static int cg_is_dd_node(const IRNode* a) {
        if (!a || d_strcmp(a->type,"ARRAY_ACCESS")!=0 || a->nchildren<1) return 0;
        const IRNode* inr = a->children[0];
        if (!inr || d_strcmp(inr->type,"ARRAY_ACCESS")!=0 || inr->nchildren<1) return 0;
        const IRNode* ib = inr->children[0];
        if (!ib || d_strcmp(ib->type,"IDENTIFIER")!=0) return 0;
        return cg_das_on(ib->value);
    }
    /* `{}` in expression position: an empty DICT literal, so `d == {}` is
     * `d_n == 0` rather than a comparison with a compound literal. */
    static int cg_dict_lit_empty(const IRNode* a) {
        if (!a || d_strcmp(a->type,"BLOCK")!=0) return 0;
        if (d_strcmp(a->value,"DICT")!=0) return 0;
        return a->nchildren == 0;
    }
    static int cg_dict_vf(const char* name) {
        int i = cg_dict_index(name);
        if (i < 0) return 0;
        return cg_dict_vfs[i];
    }
    static int cg_dict_kf(const char* name) {
        int i = cg_dict_index(name);
        if (i < 0) return 0;
        return cg_dict_kfs[i];
    }
    /* Type suffix ("is"/"ss"/"ii"/"di"/"si"/"ds") for the drygon_dget/dset/
     * ddel/dpop/dsd dict helpers: first letter is the key type, second the
     * value type. */
    static const char* cg_dict_sfx(const char* name) {
        int kf = cg_dict_kf(name);
        int vf = cg_dict_vf(name);
        if (kf) {
            if (vf == 2) return "ss";
            if (vf == 1) return "ds";
            return "is";
        }
        if (vf == 2) return "si";
        if (vf == 1) return "di";
        return "ii";
    }
    /* `a.union(b)` and friends: -1 unless both operands are list-backed sets.
     * 0 union, 1 intersection, 2 difference, 3 symmetric_difference. */
    static int cg_setop_code(const IRNode* n) {
        if (!n || d_strcmp(n->type,"CALL")!=0) return -1;
        if (d_strcmp(n->value,"COMPLEX")!=0) return -1;
        if (n->nchildren < 2) return -1;
        const IRNode* m = n->children[0];
        if (!m || d_strcmp(m->type,"MEMBER_ACCESS")!=0 || m->nchildren < 1) return -1;
        const IRNode* rcv = m->children[0];
        const IRNode* arg = n->children[1];
        if (!rcv || d_strcmp(rcv->type,"IDENTIFIER")!=0 || !rcv->value ||
            !cg_is_dyn_list(rcv->value)) return -1;
        if (!arg || d_strcmp(arg->type,"IDENTIFIER")!=0 || !arg->value ||
            !cg_is_dyn_list(arg->value)) return -1;
        if (d_strcmp(m->value,"union")==0) return 0;
        if (d_strcmp(m->value,"intersection")==0) return 1;
        if (d_strcmp(m->value,"difference")==0) return 2;
        if (d_strcmp(m->value,"symmetric_difference")==0) return 3;
        return -1;
    }
    /* `set(d.keys())` / `set(d.values())` / `set(d.items())`: returns the
     * inner `d.keys()` call so the comparison can walk the dict directly. */
    static const IRNode* cg_setview_call(const IRNode* a) {
        if (!a || d_strcmp(a->type,"CALL")!=0) return 0;
        if (d_strcmp(a->value,"set")!=0 || a->nchildren != 1) return 0;
        const IRNode* v = a->children[0];
        if (!v || d_strcmp(v->type,"CALL")!=0 || d_strcmp(v->value,"COMPLEX")!=0 || v->nchildren < 1) return 0;
        const IRNode* m = v->children[0];
        if (!m || d_strcmp(m->type,"MEMBER_ACCESS")!=0 || m->nchildren < 1) return 0;
        if (!(d_strcmp(m->value,"keys")==0 || d_strcmp(m->value,"values")==0 ||
              d_strcmp(m->value,"items")==0)) return 0;
        if (!m->children[0] || d_strcmp(m->children[0]->type,"IDENTIFIER")!=0) return 0;
        if (!cg_is_dict(m->children[0]->value)) return 0;
        return v;
    }
    /* zero-argument `set()` in expression position */
    static int cg_is_empty_set_call(const IRNode* a) {
        return (a && d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"set")==0 &&
                a->nchildren == 0);
    }
    /* emit a raw buffer as a C string literal (cg_put interprets `%`) */
    static void cg_put_cstr(CGen* g, const char* s) {
        cg_put(g, "\"");
        int i = 0;
        while (s[i]) {
            char c = s[i];
            if (c == '%') cg_put(g, "%%");
            else if (c == '"') cg_put(g, "\\\"");
            else if (c == '\\') cg_put(g, "\\\\");
            else { char _c[2]; _c[0] = c; _c[1] = 0; cg_put(g, _c); }
            i = i + 1;
        }
        cg_put(g, "\"");
    }
    /* first character of a python string literal node value (`'a'` -> a) */
    static char cg_str_char(const char* v) {
        if (!v) return 0;
        size_t l = d_strlen(v);
        if (l >= 2 && (v[0] == '\'' || v[0] == '"')) return v[1];
        return v[0];
    }
    static int cg_str_copy(const char* v, char* dst, int max) {
        int n = 0;
        if (!v) { dst[0] = 0; return 0; }
        size_t l = d_strlen(v);
        size_t k = 0;
        size_t stop = l;
        if (l >= 2 && (v[0] == '\'' || v[0] == '"')) { k = 1; stop = l - 1; }
        while (k < stop && n < max) { dst[n] = v[k]; n = n + 1; k = k + 1; }
        dst[n] = 0;
        return n;
    }
    /* `table = str.maketrans(...)`: the table is pure compile-time data, so
     * every `s.translate(table)` is rewritten to the runtime mapping call. */
    static char cg_mt_names[4096];
    static char cg_mt_from[1024];
    static char cg_mt_to[1024];
    static char cg_mt_del[1024];
    static const IRNode* cg_mt_nodes[64];
    static int cg_nmt;
    static const IRNode* cg_maketrans_node(const char* name) {
        int i = 0;
        while (i < cg_nmt) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_mt_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return cg_mt_nodes[i];
            i++;
        }
        return 0;
    }
    static void cg_note_maketrans(const char* name, const IRNode* call) {
        if (!name || !name[0] || cg_nmt >= 64) return;
        if (cg_maketrans_node(name)) return;
        int base = cg_nmt * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_mt_names[base + j] = name[j]; j++; }
        cg_mt_names[base + j] = 0;
        cg_mt_nodes[cg_nmt] = call;
        cg_nmt = cg_nmt + 1;
    }
    static int cg_is_maketrans_call(const IRNode* a) {
        if (!a || d_strcmp(a->type,"CALL")!=0) return 0;
        if (d_strcmp(a->value,"COMPLEX")!=0 || a->nchildren < 1) return 0;
        const IRNode* m = a->children[0];
        return (m && d_strcmp(m->type,"MEMBER_ACCESS")==0 && d_strcmp(m->value,"maketrans")==0);
    }
    static void cg_scan_maketrans(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            const IRNode* rhs = a->children[1];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && lhs->value &&
                cg_is_maketrans_call(rhs))
                cg_note_maketrans(lhs->value, rhs);
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_maketrans(a->children[i]); i++; }
    }
    /* fill the from/to character tables of a maketrans call */
    static void cg_mt_fill(const IRNode* call, char* from, char* to) {
        int fn = 0;
        int tn = 0;
        from[0] = 0;
        to[0] = 0;
        cg_mt_del[0] = 0;
        if (!call || call->nchildren < 2) return;
        const IRNode* a1 = call->children[1];
        if (a1 && d_strcmp(a1->type,"BLOCK")==0 && d_strcmp(a1->value,"DICT")==0) {
            int i = 0;
            while (i + 1 < a1->nchildren) {
                if (fn < 500) { from[fn] = cg_str_char(a1->children[i] ? a1->children[i]->value : 0); fn = fn + 1; }
                if (tn < 500) { to[tn] = cg_str_char(a1->children[i+1] ? a1->children[i+1]->value : 0); tn = tn + 1; }
                i = i + 2;
            }
        } else {
            fn = cg_str_copy(a1 ? a1->value : 0, from, 500);
            tn = cg_str_copy(call->nchildren > 2 && call->children[2] ? call->children[2]->value : 0, to, 500);
        }
        /* `str.maketrans(a, b, delete)`: the third argument removes the
         * characters it contains (54_string_adv check 2). */
        if (call->nchildren > 3 && call->children[3] && call->children[3]->value)
            cg_str_copy(call->children[3]->value, cg_mt_del, 500);
        from[fn] = 0;
        to[tn] = 0;
    }
    /* a call carrying `name=<truthy>` as a keyword argument */
    static int cg_kw_present(const IRNode* c, const char* kw) {
        if (!c) return 0;
        int i = 0;
        while (i < c->nchildren) {
            const IRNode* a = c->children[i];
            if (a && d_strcmp(a->type,"KWARG")==0 && a->value && d_strcmp(a->value,kw)==0) return 1;
            i++;
        }
        return 0;
    }
    /* `t = Template("...")`: the template text is pure compile-time data, so
     * `t.substitute(a=b)` / `t.safe_substitute(a=b)` are rewritten to the
     * runtime interpolator below (54_string_adv checks 19-21).  Mirrors the
     * maketrans registry. */
    static char cg_tpl_names[4096];
    static char cg_tpl_text[16384];
    static int cg_ntpl;
    static const char* cg_template_node(const char* name) {
        int i = 0;
        while (i < cg_ntpl) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_tpl_names[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return &cg_tpl_text[i * 256];
            i++;
        }
        return 0;
    }
    static void cg_note_template(const char* name, const char* text) {
        if (!name || !name[0] || !text || cg_ntpl >= 64) return;
        if (cg_template_node(name)) return;
        int base = cg_ntpl * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_tpl_names[base + j] = name[j]; j++; }
        cg_tpl_names[base + j] = 0;
        cg_str_copy(text, &cg_tpl_text[cg_ntpl * 256], 250);
        cg_ntpl = cg_ntpl + 1;
    }
    static int cg_is_template_call(const IRNode* a) {
        if (!a || d_strcmp(a->type,"CALL")!=0) return 0;
        if (!a->value || a->nchildren < 1) return 0;
        if (d_strcmp(a->value,"Template")==0) return 1;
        const IRNode* t = a->children[0];
        if (!t) return 0;
        if (d_strcmp(t->type,"IDENTIFIER")==0) return d_strcmp(t->value,"Template")==0;
        if (d_strcmp(t->type,"MEMBER_ACCESS")==0) return d_strcmp(t->value,"Template")==0;
        return 0;
    }
    static void cg_scan_template(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1) {
            const IRNode* lhs = a->children[0];
            const IRNode* rhs = a->children[1];
            if (lhs && d_strcmp(lhs->type,"IDENTIFIER")==0 && lhs->value &&
                cg_is_template_call(rhs)) {
                /* a plain call keeps its arguments from children[0] on, a
                 * method-style `string.Template(...)` from children[1]. */
                const char* txt = 0;
                if (rhs->nchildren>0 && rhs->children[0] &&
                    d_strcmp(rhs->children[0]->type,"CONSTANT")==0)
                    txt = rhs->children[0]->value;
                else if (rhs->nchildren>1 && rhs->children[1])
                    txt = rhs->children[1]->value;
                cg_note_template(lhs->value, txt);
            }
        }
        int i = 0;
        while (i < a->nchildren) { cg_scan_template(a->children[i]); i++; }
    }
    /* Names bound to a hash object (`h = hashlib.sha256()`): the accumulator
     * lives in a runtime table, so `.update(...)` and `.hexdigest()` on the
     * name have to be lowered to the table helpers instead of being dropped
     * (31_hashlib checks 11/21/22). */
    static char cg_hsh_vars[4096];
    static int cg_nhsh_vars;
    static int cg_hash_algo_name(const char* n) {
        if (!n) return 0;
        if (d_strcmp(n,"md5")==0) return 1;
        if (d_strcmp(n,"sha1")==0) return 1;
        if (d_strcmp(n,"sha224")==0) return 1;
        if (d_strcmp(n,"sha256")==0) return 1;
        if (d_strcmp(n,"sha384")==0) return 1;
        if (d_strcmp(n,"sha512")==0) return 1;
        if (d_strcmp(n,"sha3_256")==0) return 1;
        if (d_strcmp(n,"sha3_512")==0) return 1;
        if (d_strcmp(n,"blake2b")==0) return 1;
        return 0;
    }
    /* `hashlib.<algo>(data)` / `hashlib.new("algo", data)` */
    static int cg_is_hashlib_call(const IRNode* a) {
        if (!a || d_strcmp(a->type,"CALL")!=0) return 0;
        if (!a->value || d_strcmp(a->value,"COMPLEX")!=0) return 0;
        if (a->nchildren < 1) return 0;
        const IRNode* t = a->children[0];
        if (!t || d_strcmp(t->type,"MEMBER_ACCESS")!=0 || !t->value || t->nchildren < 1) return 0;
        const IRNode* o = t->children[0];
        if (!o || d_strcmp(o->type,"IDENTIFIER")!=0 || !o->value) return 0;
        if (d_strcmp(o->value,"hashlib")!=0) return 0;
        if (d_strcmp(t->value,"new")==0) return 1;
        return cg_hash_algo_name(t->value);
    }
    static int cg_hash_is_obj(const char* name) {
        if (!name) return 0;
        int i = 0;
        while (i < cg_nhsh_vars) {
            int base = i * 64;
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = cg_hsh_vars[base + j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return 1;
            i++;
        }
        return 0;
    }
    static void cg_note_hash_obj(const char* name) {
        if (!name || !name[0] || cg_nhsh_vars >= 64) return;
        if (cg_hash_is_obj(name)) return;
        int base = cg_nhsh_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_hsh_vars[base + j] = name[j]; j++; }
        cg_hsh_vars[base + j] = 0;
        cg_nhsh_vars = cg_nhsh_vars + 1;
    }
    static void cg_scan_hash_objs(const IRNode* a) {
        if (!a) return;
        if (d_strcmp(a->type,"ASSIGN")==0 && a->nchildren>1 &&
            d_strcmp(a->children[0]->type,"IDENTIFIER")==0 &&
            cg_is_hashlib_call(a->children[1]))
            cg_note_hash_obj(a->children[0]->value);
        int i = 0;
        while (i < a->nchildren) { cg_scan_hash_objs(a->children[i]); i++; }
    }
    /* the raw text of a string literal constant still carries its quotes */
    static const char* cg_strip_q(const char* v, char* buf, int max) {
        if (!v) { buf[0] = 0; return buf; }
        int l = (int)d_strlen(v);
        if (l >= 2 && (v[0] == '"' || v[0] == '\'') && (v[l-1] == '"' || v[l-1] == '\'')) {
            v = v + 1;
            l = l - 2;
        }
        if (l > max - 1) l = max - 1;
        d_strncpy(buf, v, l);
        buf[l] = 0;
        return buf;
    }
    static void cg_note_dict(const char* name, int vf, int kf) {
        if (!name || !name[0]) return;
        int i = cg_dict_index(name);
        if (i >= 0) {
            if (vf > cg_dict_vfs[i]) cg_dict_vfs[i] = vf;
            if (kf > cg_dict_kfs[i]) cg_dict_kfs[i] = kf;
            return;
        }
        if (cg_ndict_vars >= 256) return;
        int base = cg_ndict_vars * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_dict_names[base + j] = name[j]; j++; }
        cg_dict_names[base + j] = 0;
        cg_dict_vfs[cg_ndict_vars] = vf;
        cg_dict_kfs[cg_ndict_vars] = kf;
        cg_ndict_vars = cg_ndict_vars + 1;
    }
    /* ── dicts whose values are python lists ────────────────────────────────
     * `d = {'x': [1, 2]}` cannot park an element pointer in the parallel `_v`
     * array: a compound literal stored there dangles the moment the statement
     * ends.  Such a dict keeps its list values in a flattened pool (`_back`)
     * addressed by a per-entry `_off`/`_ln` row, the shape a 2-D list already
     * uses, so `d['x'].append(v)` has real storage to write.  Entries are
     * found by their literal key text. */
    static char cg_dl_names[64 * 32];
    static int cg_ndl;
    static char cg_dl_keys[64 * 64 * 24];
    static int cg_dl_kn[64];
    static int cg_dl_index(const char* nm) {
        int i = 0;
        if (!nm) return -1;
        while (i < cg_ndl) {
            if (d_strcmp(cg_dl_names + i * 32, nm) == 0) return i;
            i++;
        }
        return -1;
    }
    static int cg_dl_on(const char* nm) { return cg_dl_index(nm) >= 0; }
    static void cg_dl_note(const char* nm) {
        int i = 0;
        if (!nm || !nm[0]) return;
        if (cg_dl_on(nm)) return;
        if (cg_ndl >= 64) return;
        while (nm[i] && i < 31) { cg_dl_names[cg_ndl * 32 + i] = nm[i]; i++; }
        cg_dl_names[cg_ndl * 32 + i] = 0;
        cg_dl_kn[cg_ndl] = 0;
        cg_ndl = cg_ndl + 1;
    }
    static void cg_dl_clear(void) { cg_ndl = 0; }
    static int cg_dl_keyidx(const char* nm, const char* key) {
        int i = cg_dl_index(nm);
        int k = 0;
        if (i < 0 || !key) return -1;
        while (k < cg_dl_kn[i]) {
            if (d_strcmp(cg_dl_keys + (i * 64 + k) * 24, key) == 0) return k;
            k++;
        }
        return -1;
    }
    /* records literal key `key` as entry `cg_dl_kn` of dict `nm` */
    static int cg_dl_addkey(const char* nm, const char* key) {
        int i = cg_dl_index(nm);
        int k = 0;
        if (i < 0 || !key || !key[0]) return -1;
        k = cg_dl_keyidx(nm, key);
        if (k >= 0) return k;
        if (cg_dl_kn[i] >= 64) return -1;
        { int j = 0;
          while (key[j] && j < 23) { cg_dl_keys[(i * 64 + cg_dl_kn[i]) * 24 + j] = key[j]; j++; }
          cg_dl_keys[(i * 64 + cg_dl_kn[i]) * 24 + j] = 0; }
        cg_dl_kn[i] = cg_dl_kn[i] + 1;
        return cg_dl_kn[i] - 1;
    }
    /* is `a` a literal list/tuple of plain non-string scalars? */
    static int cg_dl_litlist(const IRNode* a) {
        int i = 0;
        if (!a || d_strcmp(a->type, "BLOCK") != 0) return 0;
        if (d_strcmp(a->value, "LIST") != 0 && d_strcmp(a->value, "TUPLE") != 0) return 0;
        while (i < a->nchildren) {
            const IRNode* e = a->children[i];
            if (!e || d_strcmp(e->type, "BLOCK") == 0) return 0;
            if (cg_node_is_str_static(e)) return 0;
            if (cg_is_float_node(e)) return 0;
            i++;
        }
        return 1;
    }
    /* `d[k]` where `d` holds lists -> the entry index, else -1.  The dict name
     * is copied into `dnm` because the caller needs it for the emission. */
    static int cg_dl_entry(const IRNode* a, char* dnm, int max) {
        char kb[24];
        const char* kn = NULL;
        int j = 0;
        dnm[0] = 0;
        if (!a || d_strcmp(a->type, "ARRAY_ACCESS") != 0 || a->nchildren < 2) return -1;
        if (!a->children[0] || d_strcmp(a->children[0]->type, "IDENTIFIER") != 0) return -1;
        if (!cg_dl_on(a->children[0]->value)) return -1;
        while (a->children[0]->value[j] && j < max - 1) { dnm[j] = a->children[0]->value[j]; j++; }
        dnm[j] = 0;
        kn = cg_strip_q(a->children[1] ? a->children[1]->value : "", kb, 23);
        return cg_dl_keyidx(dnm, kn);
    }
    /* `d[k] = [...]` where the same dict name also needs the count kept in
     * step -- used by the literal builder below. */
    static void cg_dl_emit_append_row(CGen* g, const char* dnm, int row, const IRNode* v) {
        cg_put(g, dnm); cg_put(g, "_back[");
        cg_put(g, dnm); cg_put(g, "_off[");
        cg_put_int(g, row);
        cg_put(g, "] + ");
        cg_put(g, dnm); cg_put(g, "_ln[");
        cg_put_int(g, row);
        cg_put(g, "]] = ");
        cg_gen_expr(g, v);
        cg_put(g, "; ");
        cg_put(g, dnm); cg_put(g, "_ln[");
        cg_put_int(g, row);
        cg_put(g, "] = ");
        cg_put(g, dnm); cg_put(g, "_ln[");
        cg_put_int(g, row);
        cg_put(g, "] + 1");
    }
    /* a shallow copy of a dict of lists shares the source's arrays outright:
     * every use of the copy's name is rewritten to the source name. */
    static char cg_dict_view[256 * 32];
    static void cg_dict_view_note(const char* name, const char* src) {
        int i = cg_dict_index(name);
        if (i < 0 || !src || !src[0]) return;
        { int si = cg_dict_index(src);
          if (si >= 0 && cg_dict_view[si * 32]) src = cg_dict_view + si * 32; }
        { int j = 0;
          while (src[j] && j < 31) { cg_dict_view[i * 32 + j] = src[j]; j++; }
          cg_dict_view[i * 32 + j] = 0; }
    }
    static const char* cg_dict_view_of(const char* name) {
        int i = 0;
        if (!name || !name[0]) return 0;
        i = cg_dict_index(name);
        if (i < 0 || i >= 256) return 0;
        return cg_dict_view[i * 32] ? cg_dict_view + i * 32 : 0;
    }
    static void cg_dict_view_clear(void) {
        int i = 0;
        while (i < 256) { cg_dict_view[i * 32] = 0; i++; }
    }
    /* `d[k]` / `d[k] = v` / `len(d)` / `k in d` / `for k in d` all need the
     * element types, and the prepass that finds them can see the literal. */
    static int cg_dict_vflag(const IRNode* a) {
        if (!a) return 0;
        if (cg_node_is_str_static(a)) return 2;
        if (cg_scan_float(a)) return 1;
        return 0;
    }
    /* ── `**kwargs` ─────────────────────────────────────────────────────────
     * `def collect(**kwargs):` parses its varargs parameter as a PARAM_DECL of
     * type DICT, so the name of every such function is collected here: a call
     * carrying keyword arguments then lowers to a dictionary build instead of
     * a positional call that silently dropped the keywords (11_functions checks
     * 11-12). */
    static char cg_kwfn_names[64][32];
    static int cg_kwfn_n;
    static void cg_kwfn_add(const char* nm) {
        if (!nm || !nm[0]) return;
        int i = 0;
        while (i < cg_kwfn_n) {
