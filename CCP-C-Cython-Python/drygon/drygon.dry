    /* `s.rsplit(sep, maxsplit)` splits from the RIGHT: only the last
     * `maxsplit` separators count, everything before them is one piece.
     * `drygon_split` only ever split from the left, so an rsplit call fell
     * through to a bare method expression and the target stayed an
     * uninitialised int (14_methods check 20 segfaulted). */
    p[1398] = "int drygon_rsplit(char** out, char* s, char* sep, int max, int cap) {\n";
    p[1399] = "int ls = drygon_slen(sep);\nint len = drygon_slen(s);\nint n = 0;\nint st = 0;\nint i = 0;\nint j = 0;\n";
    p[1400] = "if (max < 0) return drygon_split(out, s, sep, cap);\n";
    p[1401] = "if (ls == 0) {\nint ws[64];\nint we[64];\nint w = 0;\n";
    p[1402] = "while (j < len) {\nwhile (j < len && (s[j] == 32 || s[j] == 9)) j = j + 1;\n";
    p[1403] = "if (j >= len) break;\nif (w < 64) ws[w] = j;\n";
    p[1404] = "while (j < len && s[j] != 32 && s[j] != 9) j = j + 1;\n";
    p[1405] = "if (w < 64) { we[w] = j; w = w + 1; }\n}\n";
    p[1406] = "if (w == 0) return 0;\nint keep = 0;\nif (max >= 0 && w - max > 1) keep = w - max;\n";
    p[1407] = "if (keep > 0) { if (n < cap) { out[n] = drygon_substr(s, ws[0], we[keep - 1]); n = n + 1; } }\n";
    p[1408] = "j = keep;\nwhile (j < w) { if (n < cap) { out[n] = drygon_substr(s, ws[j], we[j]); n = n + 1; } j = j + 1; }\n";
    p[1409] = "return n;\n}\nint pos[128];\nint c = 0;\n";
    p[1410] = "while (i < len) {\nint k = 0;\nwhile (k < ls && s[i + k] == sep[k]) k = k + 1;\n";
    p[1411] = "if (k == ls) { if (c < 128) { pos[c] = i; c = c + 1; } i = i + ls; }\nelse i = i + 1;\n}\n";
    p[1412] = "int start = 0;\nif (max >= 0 && c > max) start = c - max;\nint q = start;\n";
    p[1413] = "while (q < c) { if (n < cap) { out[n] = drygon_substr(s, st, pos[q]); n = n + 1; } st = pos[q] + ls; q = q + 1; }\n";
    p[1414] = "if (n < cap) { out[n] = drygon_substr(s, st, len); n = n + 1; }\nreturn n;\n}\n";
    p[1415] = "int drygon_rsplit_len_m(char* s, char* sep, int max) { char* buf[64]; return drygon_rsplit(buf, s, sep, max, 64); }\n";
    p[1416] = "char* drygon_rsplit_at_m(char* s, char* sep, int k, int max) { char* buf[64]; int n = drygon_rsplit(buf, s, sep, max, 64); if (k < 0) k = k + n; if (k < 0 || k >= n) return s; return buf[k]; }\n";
    p[1417] = "char* drygon_rsplit_repr_m(char* s, char* sep, int max) { char* b[64]; int n = drygon_rsplit(b, s, sep, max, 64); return drygon_slrepr(b, n); }\n";
    p[1418] = "char* drygon_join_chars(char* sep, char* s) {\nint ls = drygon_slen(sep);\nint n = drygon_slen(s);\nif (n <= 0) return \"\";\nchar* r = drygon_alloc(n * (ls + 1) + 1);\nint m = 0;\nint i = 0;\n";
    p[1419] = "while (i < n) {\nif (i > 0) { int j = 0; while (j < ls) { r[m] = sep[j]; m = m + 1; j = j + 1; } }\nr[m] = s[i]; m = m + 1; i = i + 1;\n}\n";
    p[1420] = "r[m] = 0;\nreturn r;\n}\n";
    p[1421] = "char* drygon_lstrip_chars(char* s, char* ch) {\nint n = drygon_slen(s);\nint i = 0;\nwhile (i < n && strchr(ch, s[i])) i = i + 1;\nreturn drygon_substr(s, i, n);\n}\n";
    p[1422] = "char* drygon_rstrip_chars(char* s, char* ch) {\nint n = drygon_slen(s);\nint j = n;\nwhile (j > 0 && strchr(ch, s[j - 1])) j = j - 1;\nreturn drygon_substr(s, 0, j);\n}\n";
