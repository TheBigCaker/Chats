                            {
                                int mfl = 0;
                                int lb = i - 1;
                                while (lb >= 0 && d_strcmp(body->children[lb]->type,"DECORATOR")==0) {
                                    const char* dv = body->children[lb]->value;
                                    if (dv && d_strcmp(dv,"abstractmethod")==0) mfl = mfl | 1;
                                    if (dv && d_strcmp(dv,"property")==0) mfl = mfl | 2;
                                    if (dv && d_strcmp(dv,"abstractproperty")==0) mfl = mfl | 3;
                                    /* `@staticmethod` has no receiver and
                                     * `@classmethod` receives the class itself
