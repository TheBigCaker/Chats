    if (d_strcmp(n, "threading") == 0) {
        d_strncpy(dst + 0, "\"\"\"threading     a Drygon-native, single-threaded threading module.\n\nDrygon has no scheduler, so `Thread.start()` runs the target eagerly and\n`join()` returns at once; every synchronisation object is a plain flag.  A\nfunction stored in an instance field cannot be called back, so targets are\nkept in module-level lists and called by index.\n\"\"\"\n\n_count = 0\n_tid = 0\n_targets = []\n_args = []\n\n\nclass Thread:\n    def __init__(self, target=0, args=[], name=\"Thread\", daemon=False):\n        global _tid\n        _tid = _tid + 1\n        self._tid = _tid\n        self.name = name\n        self.daemon = daemon\n        self.ident = 0\n        self._alive = 0\n        self.args = args\n        # Always append so `self._tid` and `_targets_n` stay in lock-step: a\n        # lambda passed as `target=` lowers to 0 here, and skipping the append\n        # for it shifted every later thread's target by one.\n        _targets.append(target)\n        self._has = 0\n        if target != 0:\n            self._has = 1\n\n    def start(self):\n        global _count\n        _count = _count + 1\n        self.ident = _count\n        self._alive = 1\n        if self._has == 1:\n            n = len(self.args)\n            if n == 0:\n                _targets[self._tid - 1]()\n            elif n == 1:\n                _targets[self._tid - 1](self.args[0])\n            else:\n                _targets[self._tid - 1](self.args[0], self.args[1])\n        self._alive = 0\n        return 0\n\n    def run(self):\n        return self.start()\n\n    def join(self, timeout=0):\n        self._alive = 0\n        return 0\n\n    def is_alive(self):\n        return self._alive == 1\n\n    def getName(self):\n        return self.name\n\n    def setName(self, n):\n        self.name = n\n      ", 1729);
        d_strncpy(dst + 1729, "  return 0\n\n\nclass Lock:\n    def __init__(self):\n        self._locked = 0\n\n    def acquire(self, blocking=True):\n        if self._locked == 1:\n            if blocking:\n                return True\n            return False\n        self._locked = 1\n        return True\n\n    def release(self):\n        self._locked = 0\n        return 0\n\n    def locked(self):\n        return self._locked == 1\n\n    def __enter__(self):\n        self.acquire()\n        return self\n\n    def __exit__(self, a, b, c):\n        self.release()\n        return False\n\n\nclass RLock:\n    def __init__(self):\n        self._locked = 0\n        self._count = 0\n\n    def acquire(self, blocking=True):\n        self._locked = 1\n        self._count = self._count + 1\n        return True\n\n    def release(self):\n        self._count = self._count - 1\n        if self._count <= 0:\n            self._count = 0\n            self._locked = 0\n        return 0\n\n    def __enter__(self):\n        self.acquire()\n        return self\n\n    def __exit__(self, a, b, c):\n        self.release()\n        return False\n\n\nclass Event:\n    def __init__(self):\n        self._flag = 0\n\n    def is_set(self):\n        return self._flag == 1\n\n    def isSet(self):\n        return self._flag == 1\n\n    def set(self):\n        self._flag = 1\n        return 0\n\n    def clear(self):\n        self._flag = 0\n        return 0\n\n    def wait(self, timeout=0):\n        return self._flag == 1\n\n\nclass Condition:\n    def __init__(self, lock=0):\n        self._flag = 0\n\n    def acquire(self, blocking=True):\n        return True\n\n    def release(self):\n        return 0\n\n    def wait(self, timeout=0):\n        return True\n\n    def notify(self):\n        return 0\n\n    def notify_all(self):\n", 1704);
