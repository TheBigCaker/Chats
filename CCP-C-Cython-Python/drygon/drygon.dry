                     * instance was left completely uninitialized, so reading
                     * `o.name` gave stack garbage (and `streq` on it
                     * segfaulted).  Copy each default into the instance. */
                    int bi = 0;
                    while (bi < cg_cls_n) {
                        if (d_strcmp(cg_cls_names[bi], cn)==0 && cg_cls_body[bi]) {
                            const IRNode* cb = cg_cls_body[bi];
                            cg_lf_zero_ctor(g, cn, alhs->value, ".");
                            int zi = 0;
                            while (zi < cb->nchildren) {
                                const IRNode* zc = cb->children[zi];
                                if (d_strcmp(zc->type,"ASSIGN")==0 && zc->nchildren>0 &&
                                    d_strcmp(zc->children[0]->type,"IDENTIFIER")==0) {
                                    cg_indent(g);
                                    cg_put(g, alhs->value); cg_put(g, ".");
                                    cg_put(g, zc->children[0]->value); cg_put(g, " = ");
                                    if (zc->nchildren>1) cg_gen_expr(g, zc->children[1]);
