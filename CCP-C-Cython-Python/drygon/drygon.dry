                        /* `list(range(...))` is CALL list -> child CALL range */
                        if (c && d_strcmp(c->type,"CALL")==0 && d_strcmp(c->value,"list")==0 &&
                            c->nchildren>=1 && d_strcmp(c->children[0]->type,"CALL")==0 &&
                            d_strcmp(c->children[0]->value,"range")==0)
                            c = c->children[0];
                        if (c && d_strcmp(c->type,"CALL")==0 && d_strcmp(c->value,"range")==0 &&
                            c->nchildren>=1) {
                            const IRNode* rn = c;
                            long c0 = 0, c1 = 0, c2 = 1;
                            /* a CALL node's children ARE its arguments, so the
