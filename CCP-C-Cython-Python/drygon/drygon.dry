                return 0;
            }
            /* `g(x)` bound to `operator.attrgetter("a")` yields a string when
             * the object-list column it reads is a string column; every
             * `operator.methodcaller(...)` helper returns a char*.  Without
             * this the `==` compared pointers (55_operator_mod 31/34/35). */
            if (a->value && a->nchildren > 0 && cg_ag_lookup(a->value) >= 0) {
                const IRNode* _ax = a->children[0];
                if (_ax && d_strcmp(_ax->type,"ARRAY_ACCESS")==0 && _ax->nchildren>0 &&
                    _ax->children[0] && d_strcmp(_ax->children[0]->type,"IDENTIFIER")==0) {
                    int _mc = cg_ob_col(_ax->children[0]->value, cg_ag_attr[cg_ag_lookup(a->value)]);
                    if (_mc >= 0)
                        return cg_ob_lkind[cg_ob_lookup(_ax->children[0]->value)*8 + _mc] == 2;
                }
                return 0;
            }
            if (a->value && cg_mc_lookup(a->value) >= 0 &&
                cg_mc_helper(cg_mc_meth[cg_mc_lookup(a->value)])) return 1;
            int mk = cg_call_mask(a);
            if (mk != cg_fn_base_mask(a->value)) return cg_mask_retstr(a->value, mk);
            return cg_fn_is_str(a->value);
