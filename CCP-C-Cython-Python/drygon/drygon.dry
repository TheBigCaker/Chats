                        if (d_strcmp(cg_cls_methnames[fci*48 + fj],
                                     arhs->children[0]->value)==0) {
                            if (cg_cls_mret[fci][fj] == 4) is_factory = 1;
                            break;
                        }
                        fj++;
                    }
                    if (is_factory) {
                        int found = 0;
                        int qi = 0;
                        while (qi < cg_cvar_n) {
                            if (d_strcmp(cg_cvar_names[qi], alhs->value) == 0) {
                                d_strncpy(cg_cvar_cls[qi], fcn, 31);
                                cg_cvar_cls[qi][31] = 0;
                                found = 1; break;
                            }
                            qi++;
                        }
                        if (!found && cg_cvar_n < 512) {
                            d_strncpy(cg_cvar_names[cg_cvar_n], alhs->value, 31);
                            cg_cvar_names[cg_cvar_n][31] = 0;
                            d_strncpy(cg_cvar_cls[cg_cvar_n], fcn, 31);
                            cg_cvar_cls[cg_cvar_n][31] = 0;
                            cg_cvar_n++;
                        }
                        cg_put(g, fcn); cg_put(g, " "); cg_put(g, alhs->value);
                        cg_put(g, ";\n");
                        cg_indent(g);
                        cg_put(g, alhs->value); cg_put(g, " = ");
                        cg_put(g, fcn); cg_put(g, "_"); cg_put(g, arhs->children[0]->value);
                        cg_put(g, "(");
                        int fai = 1;
                        while (fai < arhs->nchildren) {
                            if (fai > 1) cg_put(g, ", ");
                            cg_gen_expr(g, arhs->children[fai]);
                            fai++;
                        }
                        cg_put(g, ");\n");
                        return;
                    }
                }
            }
            /* `attrs = dir(obj)` — bind the attribute names of obj's class into
             * the pre-registered string list (12_classes checks 43/44) */
            if (alhs && d_strcmp(alhs->type,"IDENTIFIER")==0 && arhs &&
                d_strcmp(arhs->type,"CALL")==0 && d_strcmp(arhs->value,"dir")==0) {
                char dbuf[2048];
                int dn = 0;
                const char* dcls = arhs->nchildren>0 ? cg_dir_cls_of(arhs->children[0]) : (const char*)0;
                if (dcls) cg_dir_fill(dcls, dbuf, &dn, 32, 0);
                int di = 0;
                while (di < dn) {
                    if (di > 0) cg_indent(g);
                    cg_put(g, alhs->value); cg_put(g, "[");
                    cg_put_int(g, di);
                    cg_put(g, "] = \"");
                    cg_put(g, dbuf + di*64);
                    cg_put(g, "\";\n");
                    di++;
                }
                cg_indent(g);
                cg_put(g, alhs->value); cg_put(g, "_n = ");
                cg_put_int(g, dn);
                cg_put(g, ";\n");
                return;
            }
            /* `p = P(args)` — class instantiation: declare the instance and
