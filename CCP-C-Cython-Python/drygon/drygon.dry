        if (n == 0) { dg[k] = '0'; k++; }
        while (n > 0 && k < 7) { dg[k] = (char)('0' + (n % 10)); n = n / 10; k++; }
        int j = 0;
        while (j < k) { out[4 + j] = dg[k - 1 - j]; j++; }
        out[4 + k] = 0;
    }
