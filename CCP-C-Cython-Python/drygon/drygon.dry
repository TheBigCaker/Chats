                const IRNode* a = n->children[0];
                if (a && d_strcmp(a->type,"IDENTIFIER")==0 && d_strcmp(a->value,"None")==0) cg_put(g, "0");
                else if (a && d_strcmp(a->type,"CONSTANT")==0 &&
                         d_strcmp(a->data_type,"BOOL")==0)
                    cg_put(g, "1");
                else if (cg_is_str_node(a)) cg_put(g, "4");
                else if (cg_is_float_node(a)) cg_put(g, "3");
                else if (a && d_strcmp(a->type,"BLOCK")==0 && d_strcmp(a->value,"DICT")==0) cg_put(g, "6");
                else if (a && d_strcmp(a->type,"BLOCK")==0 && d_strcmp(a->value,"SET")==0) cg_put(g, "7");
                else if (a && d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"dict")==0) cg_put(g, "6");
                else if (a && d_strcmp(a->type,"CALL")==0 && d_strcmp(a->value,"set")==0) cg_put(g, "7");
                else if (a && (d_strcmp(a->type,"TUPLE")==0 ||
                               (d_strcmp(a->type,"BLOCK")==0 && d_strcmp(a->value,"TUPLE")==0)))
