     * result is a runtime-sized array.  So the parser records it as a COMPLIST
     * node and parse_block rewrites the statement that uses it into
     *   <target>_n = 0; for (VAR in ITER) { <target>[<target>_n] = EXPR;
     *                                            <target>_n = <target>_n + 1; }
     * placed just before the original statement, which then refers to the
     * backing array by name.  Targets are noted here at parse time so the
     * codegen header can declare `<target>[64]` + `<target>_n` and the
     * existing dynamic list paths (print/len/index/iterate) apply unchanged. */
    static char cg_pyc_names[2048];
    static const IRNode* cg_pyc_elems[32];
    static int cg_pyc_n;
    static int cg_pyc_serial;
    static const char* cg_pyc_name(int i) { return cg_pyc_names + i * 64; }
    static void cg_pyc_note(const char* name, const IRNode* elem) {
        if (!name || !name[0]) return;
        if (cg_pyc_n >= 32) return;
        int base = cg_pyc_n * 64;
        int j = 0;
        while (name[j] && j < 63) { cg_pyc_names[base + j] = name[j]; j++; }
        cg_pyc_names[base + j] = 0;
        cg_pyc_elems[cg_pyc_n] = elem;
        cg_pyc_n = cg_pyc_n + 1;
    }
    static void cg_pyc_fresh(char* out) {
        int v = cg_pyc_serial;
        cg_pyc_serial = cg_pyc_serial + 1;
        out[0]='_'; out[1]='d'; out[2]='y'; out[3]='c'; out[4]='p';
        char dg[16];
        int nd = 0;
        if (v == 0) { dg[nd] = '0'; nd++; }
        while (v > 0) { dg[nd] = (char)(48 + (v - (v / 10) * 10)); nd++; v = v / 10; }
        int j = 0;
        while (j < nd) { out[5 + j] = dg[nd - 1 - j]; j++; }
        out[5 + nd] = 0;
    }
    /* every backing array carries its element count as `<name>_n` */
    static void cg_pyc_count_name(char* out, const char* name) {
        int j = 0;
        while (name[j] && j < 100) { out[j] = name[j]; j++; }
        out[j]='_'; out[j+1]='n'; out[j+2]=0;
    }
    static int cg_pyc_find(const char* name) {
        if (!name || !name[0]) return -1;
        int i = 0;
        while (i < cg_pyc_n) {
            const char* p = cg_pyc_name(i);
            int j = 0;
            int eq = 1;
            while (1) {
                int ca = p[j];
                int cb = name[j];
                if (ca != cb) { eq = 0; break; }
                if (ca == 0) break;
                j++;
            }
            if (eq) return i;
            i++;
        }
        return -1;
    }
    static int py_is_comp(const IRNode* n) {
        return n && (d_strcmp(n->type, "COMPLIST") == 0 ||
                     d_strcmp(n->type, "COMPDICT") == 0);
    }
    /* `for VAR in range(...)` rendered as the canonical three-clause loop the
     * codegen already emits for that builtin. */
    static IRNode* py_comp_range_for(const char* var, const IRNode* iter) {
        IRNode* f = ir_new("FOR", "", "ANY");
        IRNode* init = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(init, ir_new("IDENTIFIER", var, "INT"));
        ir_add_child(init, iter->nchildren > 1 ? iter->children[0] : ir_new("CONSTANT","0","INT"));
        ir_add_child(f, init);
        const IRNode* stepv = iter->nchildren > 2 ? iter->children[2] : NULL;
        int negstep = 0;
        if (stepv) {
            if (d_strcmp(stepv->type,"CONSTANT")==0 && stepv->value[0]==45) negstep = 1;
            else if (d_strcmp(stepv->type,"UNARY_OP")==0 && d_strcmp(stepv->value,"-")==0) negstep = 1;
        }
        IRNode* cond = ir_new("BINARY_OP", negstep ? ">" : "<", "ANY");
        ir_add_child(cond, ir_new("IDENTIFIER", var, "INT"));
        ir_add_child(cond, iter->nchildren > 1 ? iter->children[1] : iter->children[0]);
        ir_add_child(f, cond);
        IRNode* nxt = ir_new("ASSIGN", "=", "ANY");
        ir_add_child(nxt, ir_new("IDENTIFIER", var, "INT"));
        IRNode* add = ir_new("BINARY_OP", "+", "ANY");
        ir_add_child(add, ir_new("IDENTIFIER", var, "INT"));
        ir_add_child(add, iter->nchildren > 2 ? iter->children[2] : ir_new("CONSTANT","1","INT"));
        ir_add_child(nxt, add);
        ir_add_child(f, nxt);
