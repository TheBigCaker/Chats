    /* Python modules already spliced into the program, so that a file with two
     * `from functools import ...` lines does not emit every definition twice
     * (duplicate C functions the backend refuses). */
    static char py_mod_loaded[24*64];
    static int py_nmod_loaded;
    static IRNode* load_py_module(const char* mod_name) {
        if (!mod_name || !mod_name[0]) return NULL;
        {
            int li = 0;
            while (li < py_nmod_loaded) {
                if (d_strcmp(py_mod_loaded + li*64, mod_name) == 0) return NULL;
                li++;
            }
        }
        /* The built-in table at the top of this file IS the python side of the
         * compiler, so the module is parsed straight out of the binary's own
         * data: nothing is read from disk.  A `.py` copy of a module on file
         * would be a second source of truth that a build could silently
         * disagree with, and there is none -- a name that is not in the table
         * is either handled natively by the runtime (`import sys` is a no-op,
         * see cg_is_stdlib_module) or is not a python module at all. */
        char* isrc = (char*)sys_mmap(0, 1048576, 3, 34, -1, 0);
        int ilen = drygon_lib_copy((char*)mod_name, isrc);
        if (ilen < 0) { sys_munmap(isrc, 1048576); return NULL; }
        if (py_nmod_loaded < 24) {
            d_strncpy(py_mod_loaded + py_nmod_loaded*64, mod_name, 63);
            py_mod_loaded[py_nmod_loaded*64 + 63] = 0;
            py_nmod_loaded = py_nmod_loaded + 1;
        }
        IRNode* iir = parse_py_to_ir_c(isrc);
        sys_munmap(isrc, 1048576);
        return iir;
    }
