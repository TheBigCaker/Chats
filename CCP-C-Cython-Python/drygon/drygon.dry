                  cg_put(g, dst); cg_put(g, rk[_rki]); cg_put(g, "[_th];\n");
                  cg_indent(g); cg_put(g, dst); cg_put(g, rk[_rki]); cg_put(g, "[_th] = _td");
                  cg_put_int(g, _rki); cg_put(g, ";\n");
                }
                _rki++;
              } }
            g->indent--;
            cg_indent(g);
            cg_put(g, "_tr = _tr + 1; _th = _th - 1; }\n");
