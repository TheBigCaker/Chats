<li about="#cite_note-2" id="cite_note-2" data-mw-footnote-number="2"><span class="mw-cite-backlink" id="mwAwc"><a href="#cite_ref-2" rel="mw:referencedBy" id="mwAwg"><span class="mw-linkback-text" id="mwAwk">↑</span></a></span> <span id="mw-reference-text-cite_note-2" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt12" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAwo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://developer.arm.com/documentation/102378/0201"},"title":{"wt":"Overview"},"work":{"wt":"Learn the architecture: Understanding the Armv8.x and Armv9.x extensions"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt12" id="mwAws"><a rel="mw:ExtLink nofollow" href="https://developer.arm.com/documentation/102378/0201" class="external text" id="mwAww">"Overview"</a>. <i id="mwAw0">Learn the architecture: Understanding the Armv8.x and Armv9.x extensions</i>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Learn+the+architecture%3A+Understanding+the+Armv8.x+and+Armv9.x+extensions&amp;rft.atitle=Overview&amp;rft_id=https%3A%2F%2Fdeveloper.arm.com%2Fdocumentation%2F102378%2F0201&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAArch64" class="Z3988" about="#mwt12" id="mwAw4"></span></span></li>
<li about="#cite_note-3" id="cite_note-3" data-mw-footnote-number="3"><span class="mw-cite-backlink" id="mwAw8"><a href="#cite_ref-3" rel="mw:referencedBy" id="mwAxA"><span class="mw-linkback-text" id="mwAxE">↑</span></a></span> <span id="mw-reference-text-cite_note-3" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt15" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAxI" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://developer.arm.com/documentation/ddi0488/d/programmers-model/armv8-architecture-concepts/execution-state"},"title":{"wt":"ARM Cortex-A57 MPCore Processor Technical Reference Manual"},"publisher":{"wt":"[[Arm Ltd.]]"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt15" id="mwAxM"><a rel="mw:ExtLink nofollow" href="https://developer.arm.com/documentation/ddi0488/d/programmers-model/armv8-architecture-concepts/execution-state" class="external text" id="mwAxQ">"ARM Cortex-A57 MPCore Processor Technical Reference Manual"</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Arm_Ltd." title="Arm Ltd." class="mw-redirect" id="mwAxU">Arm Ltd.</a></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=ARM+Cortex-A57+MPCore+Processor+Technical+Reference+Manual&amp;rft.pub=Arm+Ltd.&amp;rft_id=https%3A%2F%2Fdeveloper.arm.com%2Fdocumentation%2Fddi0488%2Fd%2Fprogrammers-model%2Farmv8-architecture-concepts%2Fexecution-state&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAArch64" class="Z3988" about="#mwt15" id="mwAxY"></span></span></li>
<li about="#cite_note-4" id="cite_note-4" data-mw-footnote-number="4"><span class="mw-cite-backlink" id="mwAxc"><a href="#cite_ref-4" rel="mw:referencedBy" id="mwAxg"><span class="mw-linkback-text" id="mwAxk">↑</span></a></span> <span id="mw-reference-text-cite_note-4" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt18" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAxo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.arm.com/products/processors/cortex-a/cortex-a32-processor.php"},"title":{"wt":"Cortex-A32 Processor – ARM"},"access-date":{"wt":"18 December 2016"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt18" id="mwAxs"><a rel="mw:ExtLink nofollow" href="https://www.arm.com/products/processors/cortex-a/cortex-a32-processor.php" class="external text" id="mwAxw">"Cortex-A32 Processor – ARM"</a><span class="reference-accessdate" id="mwAx0">. Retrieved <span class="nowrap" id="mwAx4">18 December</span> 2016</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Cortex-A32+Processor+%E2%80%93+ARM&amp;rft_id=https%3A%2F%2Fwww.arm.com%2Fproducts%2Fprocessors%2Fcortex-a%2Fcortex-a32-processor.php&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAArch64" class="Z3988" about="#mwt18" id="mwAx8"></span></span></li>
