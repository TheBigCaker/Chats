/* ISA_AARCH64.inc -- AArch64 (A64) catalog, hand-written.
 *
 * Row layout:
 *   name, mnemonic, operands, len, {template bytes},
 *   {vbyte}, {vbit}, {vwid}, {vsc}, {vkind}, split_byte, split_bit, split_wid, nvars
 *
 * The template is written as ONE 32-bit base word through W(), which expands to
 * little-endian bytes. Writing a single number removes the whole class of bug that
 * hand-typed byte arrays caused: a dropped byte (csel losing bit 23) is invisible
 * in a 16-element list but impossible to miss in one hex literal.
 *
 * Bit numbering: stream bit = word bit; byte = word_bit/8, bit = word_bit%8. So the
 * standard positions are:
 *
 *   field            word bits   vbyte vbit vwid
 *   Rd / Rt            4:0          0    0    5
 *   Rn                 9:5          0    5    5
 *   Ra / Rt2          14:10         1    2    5
 *   Rm                20:16         2    0    5
 *   imm12             21:10         1    2   12
 *   imm9              20:12         1    4    9
 *   simm19            23:5          0    5   19
 *   simm26            25:0          0    0   26
 *   cond              15:12         1    4    4
 *   imm16             20:5          0    5   16
 *   hw                22:21         2    5    2
 *   N:immr:imms       22:10         1    2   13
 *   imm7 (pairs)      21:15         1    7    7
 *   immhi             23:5          0    5   19
 *   immlo             30:29         3    6    2
 *   extr lsb          15:10         1    2    6
 *
 * Branch immediates carry a BYTE offset and the field holds offset/4 (imm19/imm26)
 * or offset/8 for the pair imm7, so those rows use vsc 2 or 3.
 */
