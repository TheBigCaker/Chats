# Build output. `make` regenerates these; committing them invites a stale
# binary that does not match the source it claims to be built from.
/binast
/isadb
/blink
/cosmetic
/binui
/isamap
/probe_bin
/binast_ent
/binast_hold
/binast_norm
/binastmodel
/binastfire
/arbittest
/smmbtest
/binastrewrite
/binastfreq
/curetest
/binastbuild
/binastconv
/convtest
/binastcure

# Scratch, regenerated by the toolchain's own tests. `make clean` wipes tmp/.
/tmp/

# Commit-message scratch files. These are written to pass a long message to git
# commit -F and must never be committed; one slipped in once and had to be removed
# in a follow-up. The pattern makes that impossible.
.msg*.txt

# Scratch ELFs and patches produced while exercising the tools by hand.
/a
/b
/b2
/b3
/b2.rebuilt
/p1.patch

# Patched copies written by `binui plant` / `blink`; tests regenerate them.
/tests/*.patched

# Editor and OS noise.
*.o
*.swp
*~
.DS_Store

# binastfire refine output
*.refined

*.paged
/binastpage
/aarch64.mtx
/aarch64.names
/x86verify
/mkx86
/x86walk
/x86fixt
/x86cov
/x86td
